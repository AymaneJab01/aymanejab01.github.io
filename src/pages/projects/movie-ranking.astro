---
const movies = [
  {
    title: "Avengers: Infinity War",
    year: "2018",
    rating: "9",
    review:
      "A very solid movie in general and one of the best superheroes movie",
    genre: "Superhero",
    director: "Anthony Russo & Joe Russo",
    image: "/avgInf.jpg",
  },
  {
    title: "The Social Network",
    year: "2010",
    rating: "4.5",
    review:
      "It was a simple movie with nothing astounding",
    genre: "Drama",
    director: "David Fincher",
    image: "/socialnet.jpeg",
  },
  {
    title: "Kimetsu no Yaiba: Infinity Castle",
    year: "2025",
    rating: "9.5",
    review:
      "Amazing animation and soundtrack and the movie tells a story worth listening to",
    genre: "Anime / Action",
    director: "Haruo Sotozaki",
    image: "kny.jpeg",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Movie Ranking — Projects</title>

    <meta
      name="description"
      content="Movie ranking project featuring personal movie ratings and reviews."
    />
  </head>

  <body
    class="min-h-screen bg-transparent text-[var(--white)]"
  >

    <!-- ========================================================= -->
    <!-- TOP NAVIGATION -->
    <!-- ========================================================= -->

    <header
      class="sticky top-0 z-50
      border-b border-[var(--white-icon-tr)]
      bg-transparent backdrop-blur-xl"
    >
      <div
        class="mx-auto flex max-w-7xl
        items-center justify-between
        px-6 py-4"
      >

        <!-- Back -->
        <a
          href="/#projects"
          class="group flex items-center gap-3
          text-sm text-[var(--white-icon)]
          transition-colors duration-300
          hover:text-[var(--white)]"
        >
          <span
            class="transition-transform duration-300
            group-hover:-translate-x-1"
          >
            ←
          </span>

          <span>Projects</span>
        </a>

        <!-- Project identifier -->
        <div
          class="font-mono text-xs
          tracking-[0.2em]
          text-[var(--white-icon)]"
        >
          PROJECT 02
        </div>

      </div>
    </header>


    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <main>

      <!-- ======================================================= -->
      <!-- HERO -->
      <!-- ======================================================= -->

      <section
        class="border-b border-[var(--white-icon-tr)]"
      >
        <div
          class="mx-auto max-w-7xl
          px-6 py-16 md:py-24"
        >

          <!-- Breadcrumb -->
          <div
            class="mb-10 flex items-center gap-2
            font-mono text-xs
            text-[var(--white-icon)]"
          >
            <span>projects</span>

            <span class="opacity-40">
              /
            </span>

            <span class="text-[var(--sec)]">
              movie-ranking
            </span>
          </div>


          <!-- Page title -->
          <div class="max-w-4xl">

            <div
              class="mb-5 flex items-center gap-3"
            >
              <span
                class="h-2 w-2 rounded-full
                bg-[var(--sec)]
                shadow-[0_0_12px_var(--sec)]"
              ></span>

              <span
                class="font-mono text-xs
                uppercase tracking-[0.2em]
                text-[var(--sec)]"
              >
                Movie Ranking
              </span>
            </div>

            <h1
              class="text-4xl md:text-6xl
              lg:text-7xl
              font-medium
              tracking-tight
              text-[var(--white)]"
            >
              Movies I've watched
              <span class="text-[var(--sec)]">.</span>
            </h1>

            <p
              class="mt-6 max-w-2xl
              text-lg md:text-xl
              leading-relaxed
              text-[var(--white-icon)]"
            >
              A personal collection of movies,
              ratings and reviews.
            </p>

          </div>

        </div>
      </section>



      <!-- ======================================================= -->
      <!-- MOVIES -->
      <!-- ======================================================= -->

      <section>
        <div
          class="mx-auto max-w-7xl
          px-6 py-16 md:py-24"
        >

          <div class="space-y-20">

            {movies.map((movie, index) => (

              <article
                class="border-b
                border-[var(--white-icon-tr)]
                pb-20 last:border-b-0"
              >

                <!-- ================================================= -->
                <!-- MOVIE -->
                <!-- ================================================= -->

                <div
                  class="grid gap-12
                  lg:grid-cols-[280px_1fr]"
                >

                  <!-- ================================================= -->
                  <!-- POSTER -->
                  <!-- ================================================= -->

                  <div
                    class="mx-auto w-full max-w-[280px]
                    overflow-hidden rounded-xl
                    border border-[var(--white-icon-tr)]
                    bg-black/20
                    shadow-2xl
                    aspect-[2/3]"
                  >

                    {movie.image ? (
                      <img
                        src={movie.image}
                        alt={`${movie.title} poster`}
                        class="block w-full h-full
                        object-cover"
                      />
                    ) : (
                      <div
                        class="flex h-full w-full
                        items-center justify-center
                        bg-[#141414]/70
                        p-6 text-center"
                      >
                        <div>

                          <span
                            class="font-mono text-xs
                            uppercase tracking-[0.2em]
                            text-[var(--sec)]"
                          >
                            Poster
                          </span>

                          <p
                            class="mt-3 text-sm
                            text-[var(--white-icon)]"
                          >
                            Image coming soon
                          </p>

                        </div>
                      </div>
                    )}

                  </div>


                  <!-- ================================================= -->
                  <!-- MOVIE INFO -->
                  <!-- ================================================= -->

                  <div
                    class="flex flex-col justify-center"
                  >

                    <!-- Movie number -->
                    <div
                      class="mb-5 flex items-center gap-3"
                    >

                      <span
                        class="font-mono text-xs
                        tracking-[0.2em]
                        text-[var(--sec)]"
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span
                        class="h-px w-12
                        bg-[var(--sec)]
                        opacity-40"
                      ></span>

                      <span
                        class="text-xs uppercase
                        tracking-widest
                        text-[var(--white-icon)]"
                      >
                        Movie
                      </span>

                    </div>


                    <!-- Title -->
                    <h2
                      class="max-w-4xl
                      text-4xl md:text-5xl
                      lg:text-6xl
                      font-medium
                      tracking-tight
                      text-[var(--white)]"
                    >
                      {movie.title}
                      <span class="text-[var(--sec)]">.</span>
                    </h2>


                    <!-- Metadata -->
                    <div
                      class="mt-6 flex flex-wrap
                      items-center gap-x-5 gap-y-3
                      text-sm
                      text-[var(--white-icon)]"
                    >

                      <span>{movie.year}</span>

                      <span class="opacity-30">/</span>

                      <span>{movie.genre}</span>

                      <span class="opacity-30">/</span>

                      <span>{movie.director}</span>

                    </div>


                    <!-- Rating -->
                    <div
                      class="mt-10 flex items-end gap-4"
                    >

                      <span
                        class="font-mono text-6xl
                        md:text-7xl
                        font-medium
                        text-[var(--sec)]"
                      >
                        {movie.rating}
                      </span>

                      <span
                        class="mb-2 font-mono text-xl
                        text-[var(--white-icon)]"
                      >
                        / 10
                      </span>

                    </div>


                    <!-- Review -->
                    <blockquote
                      class="mt-8 max-w-3xl
                      border-l-2
                      border-[var(--sec)]
                      pl-5"
                    >

                      <p
                        class="text-lg md:text-xl
                        leading-relaxed
                        text-[var(--white-icon)]"
                      >
                        "{movie.review}"
                      </p>

                    </blockquote>

                  </div>

                </div>



                <!-- ================================================= -->
                <!-- DETAILS -->
                <!-- ================================================= -->

                <div
                  class="mt-16 grid gap-12
                  lg:grid-cols-[220px_1fr]"
                >

                  <!-- Sidebar -->
                  <aside class="hidden lg:block">

                    <p
                      class="mb-4 font-mono text-xs
                      uppercase tracking-[0.2em]
                      text-[var(--white-icon)]"
                    >
                      Movie
                    </p>

                    <div
                      class="border-l
                      border-[var(--white-icon-tr)]
                      pl-4"
                    >

                      <span
                        class="text-sm
                        text-[var(--sec)]"
                      >
                        {String(index + 1).padStart(2, "0")} —
                        {movie.title}
                      </span>

                    </div>

                  </aside>


                  <!-- Content -->
                  <div class="max-w-3xl">

                    <p
                      class="mb-4 font-mono text-xs
                      uppercase tracking-[0.2em]
                      text-[var(--sec)]"
                    >
                      Review
                    </p>

                    <h3
                      class="text-3xl md:text-4xl
                      font-medium
                      tracking-tight"
                    >
                      My rating
                    </h3>


                    <div
                      class="mt-8 rounded-xl
                      border
                      border-[var(--white-icon-tr)]
                      bg-[#141414]/50
                      backdrop-blur-sm
                      p-6 md:p-8"
                    >

                      <div
                        class="flex items-center
                        justify-between gap-5"
                      >

                        <span
                          class="text-lg
                          text-[var(--white)]"
                        >
                          Overall rating
                        </span>

                        <span
                          class="font-mono text-2xl
                          text-[var(--sec)]"
                        >
                          {movie.rating}/10
                        </span>

                      </div>


                      <div
                        class="mt-6 h-px
                        bg-[var(--white-icon-tr)]"
                      ></div>


                      <p
                        class="mt-6 text-lg
                        leading-8
                        text-[var(--white-icon)]"
                      >
                        {movie.review}
                      </p>

                    </div>

                  </div>

                </div>

              </article>

            ))}

          </div>

        </div>
      </section>

    </main>



    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer
      class="border-t
      border-[var(--white-icon-tr)]"
    >

      <div
        class="mx-auto max-w-7xl
        px-6 py-8
        flex flex-col sm:flex-row
        items-center justify-between
        gap-4"
      >

        <span
          class="font-mono text-xs
          text-[var(--white-icon)]"
        >
          PROJECT 02 / MOVIE RANKING
        </span>

        <a
          href="/#projects"
          class="text-sm
          text-[var(--sec)]
          transition-opacity
          hover:opacity-70"
        >
          ← Back to projects
        </a>

      </div>

    </footer>

  </body>
</html>