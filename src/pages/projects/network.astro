---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Network Protocol Simulator">
  <section class="np-page py-24 md:py-36">
    <div class="np-content max-w-6xl mx-auto px-6">

      <!-- ===================================================== -->
      <!-- BACK LINK -->
      <!-- ===================================================== -->
      <a href="/projects" class="np-back">
        <span class="np-back-arrow">&larr;</span>
        <span>Back to projects</span>
      </a>

      <!-- ===================================================== -->
      <!-- QUICK NAV -->
      <!-- ===================================================== -->
      <nav class="np-quicknav" aria-label="Section navigation">
        <a href="#overview"><span class="np-quicknav-num">00</span>Overview</a>
        <a href="#handshake"><span class="np-quicknav-num">01</span>Handshake</a>
        <a href="#loss"><span class="np-quicknav-num">02</span>Packet loss</a>
        <a href="#framing"><span class="np-quicknav-num">03</span>Framing</a>
        <a href="#reference"><span class="np-quicknav-num">04</span>Reference</a>
      </nav>

      <!-- ===================================================== -->
      <!-- HERO -->
      <!-- ===================================================== -->
      <div id="overview" class="np-hero">
        <p class="np-eyebrow">PROJECT 05 / NETWORKING</p>

        <h1 class="np-h1">
          The transport layer, made visible<span class="np-accent-dot">.</span>
        </h1>

        <p class="np-lede">
          Three simulations of what's actually happening under a socket connection:
          the TCP handshake, how TCP and UDP behave differently when packets get lost,
          and how a stream of bytes gets framed into discrete messages.
        </p>

        <p class="np-note">
          Note: this page is a client-side simulation, not a live socket server &mdash;
          a static site can't open raw TCP/UDP connections in the browser. Everything
          below models real protocol behavior, timing, and packet loss in software.
        </p>

        <div class="np-tags">
          <span class="np-tag">ASTRO</span>
          <span class="np-tag">TYPESCRIPT</span>
          <span class="np-tag">NETWORKING</span>
        </div>
      </div>

      <!-- ===================================================== -->
      <!-- TCP HANDSHAKE -->
      <!-- ===================================================== -->
      <div id="handshake" class="np-block">
        <div class="np-block-head">
          <div class="np-block-kicker">
            <span class="np-num">01</span>
            <span class="np-kicker-line" aria-hidden="true"></span>
            <span class="np-kicker-label">TCP</span>
          </div>
          <h2 class="np-h2">Three-way handshake</h2>
          <p class="np-block-desc">
            SYN, SYN-ACK, ACK &mdash; the exchange that opens every TCP connection, with
            sequence and acknowledgment numbers tracked step by step. Run it again to
            see the four-way close (FIN / ACK / FIN / ACK).
          </p>
        </div>

        <div class="np-controls">
          <button id="tcp-connect" class="np-btn np-btn-primary">Open connection</button>
          <button id="tcp-close" class="np-btn" disabled>Close connection</button>
          <span id="tcp-state" class="np-pill np-pill-status ml-auto">CLOSED</span>
        </div>

        <div class="np-lane">
          <div class="np-lane-col">
            <div class="np-node">Client</div>
          </div>
          <div id="tcp-wire" class="np-lane-wire">
            <div class="np-wire-line" aria-hidden="true"></div>
          </div>
          <div class="np-lane-col">
            <div class="np-node">Server</div>
          </div>
        </div>

        <div id="tcp-log" class="np-log"></div>
      </div>

      <!-- ===================================================== -->
      <!-- TCP vs UDP PACKET LOSS -->
      <!-- ===================================================== -->
      <div id="loss" class="np-block">
        <div class="np-block-head">
          <div class="np-block-kicker">
            <span class="np-num">02</span>
            <span class="np-kicker-line" aria-hidden="true"></span>
            <span class="np-kicker-label">TCP vs UDP</span>
          </div>
          <h2 class="np-h2">Packet loss &amp; retransmission</h2>
          <p class="np-block-desc">
            Send the same burst of packets over a lossy link with both protocols.
            TCP notices the gap and retransmits; UDP just moves on &mdash; which is
            exactly why one is used for file transfer and the other for live video.
          </p>
        </div>

        <div class="np-controls">
          <button id="loss-run" class="np-btn np-btn-primary">Send 10 packets</button>
          <label class="np-range-label ml-auto">
            Loss rate
            <input id="loss-rate" type="range" min="0" max="60" value="25" class="np-range" />
            <span id="loss-rate-value" class="np-range-value">25%</span>
          </label>
        </div>

        <div class="np-split">
          <div class="np-split-col">
            <div class="np-split-label">TCP</div>
            <div id="tcp-track" class="np-track"></div>
            <div class="np-split-stats">
              Delivered <b id="tcp-delivered" class="np-stat-ok">0</b> / 10
              &middot; Retransmits <b id="tcp-retrans" class="np-stat-warn">0</b>
            </div>
          </div>
          <div class="np-split-col">
            <div class="np-split-label">UDP</div>
            <div id="udp-track" class="np-track"></div>
            <div class="np-split-stats">
              Delivered <b id="udp-delivered" class="np-stat-ok">0</b> / 10
              &middot; Dropped <b id="udp-dropped" class="np-stat-bad">0</b>
            </div>
          </div>
        </div>
      </div>

      <!-- ===================================================== -->
      <!-- FRAMED CHAT -->
      <!-- ===================================================== -->
      <div id="framing" class="np-block">
        <div class="np-block-head">
          <div class="np-block-kicker">
            <span class="np-num">03</span>
            <span class="np-kicker-line" aria-hidden="true"></span>
            <span class="np-kicker-label">Framing</span>
          </div>
          <h2 class="np-h2">Framed client &ndash; server chat</h2>
          <p class="np-block-desc">
            TCP delivers a raw byte stream with no message boundaries, so applications
            frame their own messages. Type below and watch each message get wrapped
            with a length-prefix header before it's "sent" across the wire and
            unframed on the other side.
          </p>
        </div>

        <div class="np-controls">
          <input id="chat-input" type="text" placeholder="type a message" class="np-input flex-1 min-w-[200px]" maxlength="60" />
          <button id="chat-send" class="np-btn np-btn-primary">Send</button>
        </div>

        <div id="chat-frame-preview" class="np-frame-preview"></div>

        <div id="chat-log" class="np-chat"></div>
      </div>

      <!-- ===================================================== -->
      <!-- REFERENCE / DOCUMENTATION -->
      <!-- ===================================================== -->
      <div id="reference" class="np-block np-reference">
        <div class="np-block-head">
          <div class="np-block-kicker">
            <span class="np-num">04</span>
            <span class="np-kicker-line" aria-hidden="true"></span>
            <span class="np-kicker-label">Reference</span>
          </div>
          <h2 class="np-h2">How the transport layer actually works.</h2>
          <p class="np-block-desc">
            The simulations above show <em>that</em> something happens. This is the
            <em>why</em> &mdash; the concepts behind each demo, spelled out in plain terms.
          </p>
        </div>

        <!-- GROUP 01 -->
        <div class="np-ref-group">
          <p class="np-ref-group-label"><span class="np-num-inline">01</span>Transport layer basics</p>

          <div class="np-ref-entry">
            <p class="np-ref-term">OSI &amp; TCP/IP layers <span class="np-ref-tag">concept</span></p>
            <p>
              Networking is built in layers, each one only responsible for its own job.
              The application layer (HTTP, your chat protocol) hands data to the
              transport layer (TCP or UDP), which hands segments to the network layer
              (IP), which hands packets to the link layer (Ethernet, Wi-Fi). Every demo
              on this page lives at the transport layer: it assumes IP already knows how
              to get bytes from one machine to another, and focuses on what TCP and UDP
              do with them once they arrive.
            </p>
            <p class="np-ref-meta">Application &middot; Transport &middot; Network &middot; Link</p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Sockets &amp; ports <span class="np-ref-tag">concept</span></p>
            <p>
              An IP address gets a packet to the right machine; a port number gets it to
              the right process on that machine. A socket is the pairing of the two &mdash;
              <code>(local IP, local port, remote IP, remote port)</code> &mdash; and it's
              what a TCP connection actually identifies. That's why a server can hold
              thousands of simultaneous connections on the same port 443: each one is a
              distinct socket because the remote IP or port differs.
            </p>
            <p class="np-ref-meta">Well-known ports 0&ndash;1023 &middot; ephemeral ports assigned per connection</p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">MTU &amp; packetization <span class="np-ref-tag">concept</span></p>
            <p>
              A network link can only carry so many bytes in one frame &mdash; the maximum
              transmission unit, typically 1500 bytes on Ethernet. Anything bigger than
              that gets split into multiple packets before it's sent and reassembled on
              arrival. This is separate from message framing (below): MTU splitting
              happens transparently at the network layer, while framing is something the
              application has to do itself on top of a byte stream.
            </p>
          </div>
        </div>

        <!-- GROUP 02 -->
        <div class="np-ref-group">
          <p class="np-ref-group-label"><span class="np-num-inline">02</span>Connection lifecycle</p>

          <div class="np-ref-entry">
            <p class="np-ref-term">Three-way handshake <span class="np-ref-tag">protocol</span></p>
            <p>
              Before any data flows, both sides agree the connection is real and
              synchronize starting sequence numbers. The client sends <code>SYN</code>
              with an initial sequence number; the server replies <code>SYN-ACK</code>,
              acknowledging that number and sending its own; the client replies
              <code>ACK</code>, acknowledging the server's number. Three messages, two
              round trips &mdash; exactly what the demo above animates.
            </p>
            <ol class="np-ref-steps">
              <li>Client &rarr; server: <code>SYN seq=x</code></li>
              <li>Server &rarr; client: <code>SYN-ACK seq=y ack=x+1</code></li>
              <li>Client &rarr; server: <code>ACK ack=y+1</code></li>
            </ol>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Sequence &amp; acknowledgment numbers <span class="np-ref-tag">concept</span></p>
            <p>
              Every byte TCP sends is numbered. The sequence number in a segment is the
              position of its first byte in the stream; the acknowledgment number in a
              reply says "I've received everything up to this byte, send me what comes
              next." This is how TCP notices a gap &mdash; if bytes arrive out of order or
              go missing, the acknowledgment number simply stops advancing until the
              missing piece shows up, which is the signal that triggers retransmission.
            </p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Four-way close &amp; TIME_WAIT <span class="np-ref-tag">protocol</span></p>
            <p>
              Closing takes one more step than opening because TCP connections are
              full-duplex &mdash; each direction has to be closed independently.
              Either side can send <code>FIN</code> to say "I'm done sending"; the other
              acknowledges it and, once it's also done, sends its own <code>FIN</code>
              back. After the final <code>ACK</code>, the side that closed first holds
              the socket in <code>TIME_WAIT</code> briefly, in case that last
              acknowledgment got lost and needs to be resent.
            </p>
            <p class="np-ref-meta">FIN &middot; ACK &middot; FIN &middot; ACK &middot; TIME_WAIT</p>
          </div>
        </div>

        <!-- GROUP 03 -->
        <div class="np-ref-group">
          <p class="np-ref-group-label"><span class="np-num-inline">03</span>TCP vs UDP</p>

          <div class="np-ref-entry">
            <p class="np-ref-term">TCP: reliable, ordered delivery <span class="np-ref-tag">mechanism</span></p>
            <p>
              TCP guarantees every byte arrives, in order, exactly once &mdash; and it does
              that entirely through the sequence/acknowledgment numbers above. If an
              acknowledgment doesn't arrive within a timeout, the sender assumes the
              segment was lost and retransmits it. That's the gap between the TCP and
              UDP tracks in the demo: TCP keeps resending packet <code>N</code> until it's
              confirmed, so the delivered count always eventually reaches 10.
            </p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">UDP: unreliable, connectionless delivery <span class="np-ref-tag">mechanism</span></p>
            <p>
              UDP has no handshake, no sequence numbers, and no retransmission &mdash; it
              just fires a packet and moves on, with no confirmation it arrived. That
              sounds worse, but it's exactly what's wanted for live video or voice: a
              retransmitted frame from three seconds ago is useless, so UDP's lack of
              guarantees removes the latency retransmission would add. The application
              decides whether and how to handle loss, not the protocol.
            </p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Sliding windows &amp; congestion control <span class="np-ref-tag">concept</span></p>
            <p>
              Real TCP doesn't send one packet and wait for one acknowledgment like the
              simplified demo above &mdash; it keeps a window of unacknowledged bytes in
              flight at once, sized to use the connection efficiently without
              overwhelming the receiver or the network. That window shrinks sharply when
              loss is detected (a signal of congestion) and grows gradually when
              delivery is clean, which is what lets TCP share a link fairly with other
              connections without any central coordination.
            </p>
          </div>
        </div>

        <!-- GROUP 04 -->
        <div class="np-ref-group">
          <p class="np-ref-group-label"><span class="np-num-inline">04</span>Message framing</p>

          <div class="np-ref-entry">
            <p class="np-ref-term">Why framing is needed <span class="np-ref-tag">concept</span></p>
            <p>
              TCP delivers a stream of bytes, not a stream of messages &mdash; it makes no
              promise that one <code>send()</code> call on one side arrives as one
              <code>read()</code> on the other. Two small messages can arrive fused
              together, and one large message can arrive split across several reads.
              Anything built on raw TCP has to define its own rule for where one message
              ends and the next begins.
            </p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Length-prefix framing <span class="np-ref-tag">technique</span></p>
            <p>
              Write the message's byte length before the message itself, using a fixed
              number of bytes for the length field. The reader always knows exactly how
              many bytes to read for the length, then exactly how many more to read for
              the payload &mdash; no scanning required. That's what the chat demo above
              does: a 4-byte length header precedes every message.
            </p>
            <p class="np-ref-meta">Used by gRPC, most binary protocols &middot; O(1) to know a message's size</p>
          </div>

          <div class="np-ref-entry">
            <p class="np-ref-term">Delimiter-based framing <span class="np-ref-tag">technique</span></p>
            <p>
              Mark the end of each message with a reserved byte sequence &mdash; a newline
              for line-based protocols like HTTP headers or Redis's older protocol.
              Simpler to write and debug by eye than length-prefixing, but the reader has
              to scan every incoming byte looking for the delimiter, and the payload
              itself can never legally contain that exact sequence unless it's escaped.
            </p>
            <p class="np-ref-meta">Used by HTTP/1.1 headers, SMTP, line-oriented protocols</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* =====================================================================
     LIGHT / MINIMAL THEME
     Matches the Algorithm Visualizer project page: warm off-white
     background, near-black text, a muted olive accent, and bordered
     cards instead of neon glow. Variables are scoped to .np-page so
     nothing else on the site is affected.
     ===================================================================== */
  .np-page {
    --np-bg: #f6f4ee;
    --np-card: #fffdf9;
    --np-border: #e5e1d3;
    --np-border-strong: #cfc9b3;
    --np-text: #201f1a;
    --np-text-soft: #6f6d61;
    --np-accent: #8c8944;
    --np-accent-soft: rgba(140, 137, 68, 0.12);
    --np-green: #3f8f5f;
    --np-green-soft: rgba(63, 143, 95, 0.12);
    --np-red: #c1573f;
    --np-red-soft: rgba(193, 87, 63, 0.12);
    --np-amber: #c2903a;
    --np-amber-soft: rgba(194, 144, 58, 0.14);
    --np-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

    background: var(--np-bg);
    color: var(--np-text);
  }

  .np-content { position: relative; }

  /* ---------------------------------------------------------------- */
  /* BACK LINK + QUICK NAV                                             */
  /* ---------------------------------------------------------------- */
  .np-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--np-text-soft);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .np-back:hover { color: var(--np-accent); }
  .np-back-arrow { font-size: 1.05rem; }

  .np-quicknav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 1.75rem 0 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--np-border);
    font-family: var(--np-mono);
    font-size: 0.78rem;
  }
  .np-quicknav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--np-text-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .np-quicknav a:hover { color: var(--np-text); }
  .np-quicknav-num { color: var(--np-accent); }

  /* ---------------------------------------------------------------- */
  /* HERO                                                               */
  /* ---------------------------------------------------------------- */
  .np-hero { margin-bottom: 4rem; }

  .np-eyebrow {
    font-family: var(--np-mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--np-accent);
    margin-bottom: 1.1rem;
  }

  .np-h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--np-text);
  }
  @media (min-width: 768px) { .np-h1 { font-size: 3.5rem; } }
  .np-accent-dot { color: var(--np-accent); }

  .np-lede {
    margin-top: 1.25rem;
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--np-text-soft);
  }

  .np-note {
    margin-top: 0.85rem;
    max-width: 42rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--np-text-soft);
    opacity: 0.75;
  }

  .np-tags { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .np-tag {
    border-radius: 9999px;
    border: 1px solid var(--np-border-strong);
    background: var(--np-card);
    padding: 0.28rem 0.8rem;
    font-size: 0.68rem;
    font-family: var(--np-mono);
    letter-spacing: 0.04em;
    color: var(--np-text-soft);
  }

  /* ---------------------------------------------------------------- */
  /* BLOCK / CARD                                                       */
  /* ---------------------------------------------------------------- */
  .np-block {
    border-radius: 1rem;
    border: 1px solid var(--np-border);
    background: var(--np-card);
    padding: 1.75rem;
    margin-bottom: 2.25rem;
    box-shadow: 0 1px 2px rgba(32, 31, 26, 0.03);
  }
  @media (min-width: 768px) { .np-block { padding: 2.5rem; } }

  .np-block-head { max-width: 44rem; }

  .np-block-kicker { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .np-num {
    font-family: var(--np-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--np-accent);
  }
  .np-kicker-line { height: 1px; width: 2.5rem; background: var(--np-border-strong); }
  .np-kicker-label {
    font-family: var(--np-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--np-text-soft);
  }

  .np-h2 { font-size: 1.6rem; font-weight: 500; letter-spacing: -0.01em; color: var(--np-text); }
  @media (min-width: 768px) { .np-h2 { font-size: 1.85rem; } }

  .np-block-desc { margin-top: 0.6rem; font-size: 1rem; line-height: 1.6; color: var(--np-text-soft); }

  /* ---------------------------------------------------------------- */
  /* CONTROLS                                                           */
  /* ---------------------------------------------------------------- */
  .np-controls { margin-top: 1.6rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .ml-auto { margin-left: auto; }

  .np-btn {
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    border: 1px solid var(--np-border-strong);
    color: var(--np-text);
    font-size: 0.8rem;
    font-family: var(--np-mono);
    background: var(--np-card);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .np-btn:hover { border-color: var(--np-accent); color: var(--np-accent); }
  .np-btn-primary { border-color: var(--np-accent); color: var(--np-accent); background: var(--np-accent-soft); }
  .np-btn-primary:hover { background: var(--np-accent); color: var(--np-card); }
  .np-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .np-input {
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid var(--np-border-strong);
    background: var(--np-card);
    color: var(--np-text);
    font-size: 0.85rem;
    font-family: var(--np-mono);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .np-input:focus { border-color: var(--np-accent); box-shadow: 0 0 0 3px var(--np-accent-soft); }

  .np-range-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--np-mono);
    font-size: 0.75rem;
    color: var(--np-text-soft);
  }
  .np-range { accent-color: var(--np-accent); width: 6rem; }
  .np-range-value { font-family: var(--np-mono); color: var(--np-accent); }

  .np-pill {
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--np-border-strong);
    font-family: var(--np-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--np-text-soft);
    background: var(--np-card);
    transition: all 0.3s ease;
  }
  .np-pill-status.open { border-color: var(--np-green); color: var(--np-green); background: var(--np-green-soft); }
  .np-pill-status.closing { border-color: var(--np-amber); color: var(--np-amber); background: var(--np-amber-soft); }

  /* ---------------------------------------------------------------- */
  /* HANDSHAKE LANE                                                     */
  /* ---------------------------------------------------------------- */
  .np-lane {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--np-border);
    border-radius: 0.85rem;
    background: var(--np-bg);
    padding: 1.5rem 1rem;
    min-height: 180px;
    margin-top: 1.75rem;
  }
  .np-lane-col { display: flex; justify-content: center; }
  .np-node {
    padding: 0.5rem 1.1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--np-border-strong);
    background: var(--np-card);
    font-family: var(--np-mono);
    font-size: 0.8rem;
    color: var(--np-text);
  }
  .np-lane-wire { position: relative; width: 180px; min-height: 150px; }
  @media (min-width: 640px) { .np-lane-wire { width: 260px; } }

  .np-wire-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
    background-image: repeating-linear-gradient(
      90deg,
      var(--np-border-strong) 0px,
      var(--np-border-strong) 6px,
      transparent 6px,
      transparent 16px
    );
    background-size: 32px 2px;
    opacity: 0.7;
    animation: np-wire-flow 1.1s linear infinite;
  }
  @keyframes np-wire-flow { to { background-position: -32px 0; } }

  .np-packet {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    font-family: var(--np-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    background: var(--np-accent-soft);
    border: 1px solid var(--np-accent);
    color: var(--np-accent);
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }
  .np-packet.fin { background: var(--np-amber-soft); border-color: var(--np-amber); color: var(--np-amber); }

  .np-log {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--np-mono);
    font-size: 0.75rem;
    color: var(--np-text-soft);
    max-height: 160px;
    overflow-y: auto;
    margin-top: 1.25rem;
  }
  .np-log-line { opacity: 0; animation: np-fade-in 0.3s ease forwards; }
  .np-log-line .tag { color: var(--np-accent); }
  .np-log-line .tag.fin { color: var(--np-amber); }
  @keyframes np-fade-in {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---------------------------------------------------------------- */
  /* PACKET LOSS SPLIT VIEW                                             */
  /* ---------------------------------------------------------------- */
  .np-split { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .np-split { grid-template-columns: 1fr 1fr; } }
  .np-split-label {
    font-family: var(--np-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--np-text-soft);
    margin-bottom: 0.5rem;
  }
  .np-track {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 3rem;
    border: 1px solid var(--np-border);
    border-radius: 0.65rem;
    background: var(--np-bg);
    padding: 0.6rem;
  }
  .np-split-stats { margin-top: 0.55rem; font-family: var(--np-mono); font-size: 0.75rem; color: var(--np-text-soft); }
  .np-stat-ok { color: var(--np-green); }
  .np-stat-warn { color: var(--np-amber); }
  .np-stat-bad { color: var(--np-red); }

  .np-packet-chip {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--np-mono);
    font-size: 0.65rem;
    border: 1px solid var(--np-border-strong);
    color: var(--np-text-soft);
    background: var(--np-card);
    transition: all 0.25s ease;
  }
  .np-packet-chip.delivered { border-color: var(--np-green); color: var(--np-green); background: var(--np-green-soft); }
  .np-packet-chip.lost { border-color: var(--np-red); color: var(--np-red); background: var(--np-red-soft); text-decoration: line-through; }
  .np-packet-chip.retrans { border-color: var(--np-amber); color: var(--np-amber); background: var(--np-amber-soft); }

  /* ---------------------------------------------------------------- */
  /* FRAMED CHAT                                                        */
  /* ---------------------------------------------------------------- */
  .np-frame-preview { margin-top: 1rem; font-family: var(--np-mono); font-size: 0.72rem; color: var(--np-text-soft); min-height: 1em; }

  .np-chat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 260px;
    overflow-y: auto;
    border: 1px solid var(--np-border);
    border-radius: 0.85rem;
    background: var(--np-bg);
    padding: 1rem;
    margin-top: 1rem;
  }
  .np-chat-empty { font-size: 0.8rem; color: var(--np-text-soft); opacity: 0.6; font-family: var(--np-mono); }
  .np-chat-msg { display: flex; flex-direction: column; gap: 0.2rem; animation: np-fade-in 0.3s ease; }
  .np-chat-frame { align-self: flex-start; font-family: var(--np-mono); font-size: 0.65rem; color: var(--np-text-soft); opacity: 0.75; }
  .np-chat-bubble {
    align-self: flex-start;
    max-width: 80%;
    padding: 0.5rem 0.9rem;
    border-radius: 0.7rem;
    border: 1px solid var(--np-accent);
    background: var(--np-accent-soft);
    color: var(--np-text);
    font-size: 0.85rem;
  }

  /* ---------------------------------------------------------------- */
  /* REFERENCE / DOCUMENTATION                                          */
  /* ---------------------------------------------------------------- */
  .np-reference { margin-top: 3rem; }

  .np-ref-group { margin-top: 2.75rem; }
  .np-ref-group:first-of-type { margin-top: 2.5rem; }

  .np-ref-group-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--np-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--np-text-soft);
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--np-border);
  }
  .np-num-inline { color: var(--np-accent); }

  .np-ref-entry { border-top: 1px solid var(--np-border); padding: 1.5rem 0; }
  .np-ref-entry:first-of-type { border-top: none; }

  .np-ref-term {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--np-text);
    margin-bottom: 0.55rem;
  }
  .np-ref-tag {
    font-family: var(--np-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--np-accent);
    background: var(--np-accent-soft);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
  }

  .np-ref-entry p {
    color: var(--np-text-soft);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .np-ref-entry p + p { margin-top: 0.65rem; }

  .np-ref-steps {
    margin: 0.85rem 0 0.5rem;
    padding-left: 1.3rem;
    color: var(--np-text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .np-ref-steps li { margin-bottom: 0.3rem; }

  .np-ref-meta {
    margin-top: 0.75rem !important;
    font-family: var(--np-mono);
    font-size: 0.72rem !important;
    color: var(--np-text-soft);
    opacity: 0.8;
  }

  .np-reference code,
  .np-ref-entry code {
    font-family: var(--np-mono);
    font-size: 0.85em;
    background: var(--np-accent-soft);
    color: var(--np-text);
    padding: 0.1rem 0.4rem;
    border-radius: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .np-wire-line { animation: none; }
  }
</style>

<script>
  function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ================================================================= */
  /* TCP HANDSHAKE                                                      */
  /* ================================================================= */
  (function handshakeModule() {
    const connectBtn = document.getElementById("tcp-connect") as HTMLButtonElement;
    const closeBtn = document.getElementById("tcp-close") as HTMLButtonElement;
    const stateEl = document.getElementById("tcp-state");
    const wireEl = document.getElementById("tcp-wire");
    const logEl = document.getElementById("tcp-log");

    if (!connectBtn || !closeBtn || !stateEl || !wireEl || !logEl) return;

    let seqClient = Math.floor(Math.random() * 1000) + 1000;
    let seqServer = Math.floor(Math.random() * 1000) + 5000;

    function setState(text: string, cls?: "open" | "closing") {
      stateEl!.textContent = text;
      stateEl!.className = "np-pill np-pill-status ml-auto" + (cls ? ` ${cls}` : "");
    }

    function log(html: string) {
      const line = document.createElement("div");
      line.className = "np-log-line";
      line.innerHTML = html;
      logEl!.appendChild(line);
      logEl!.scrollTop = logEl!.scrollHeight;
    }

    function clearPackets() {
      wireEl!.querySelectorAll(".np-packet").forEach((el) => el.remove());
    }

    /**
     * Animates a packet bubble sliding across the wire using the Web
     * Animations API instead of manually toggling inline styles behind
     * a forced-reflow hack. element.animate() schedules each keyframe
     * deterministically, so the fade-in, slide, and fade-out always
     * play in order and at the intended duration regardless of how the
     * browser batches style recalculation.
     */
    async function sendPacket(label: string, fromLeft: boolean, cls = "") {
      const packet = document.createElement("div");
      packet.className = "np-packet" + (cls ? ` ${cls}` : "");
      packet.textContent = `${fromLeft ? "▸" : "◂"} ${label}`;
      wireEl!.appendChild(packet);

      const width = wireEl!.clientWidth;
      const trackHeight = wireEl!.clientHeight || 150;
      const inset = 14;

      const startX = fromLeft ? inset : width - inset;
      const endX = fromLeft ? width - inset : inset;
      const y = trackHeight * 0.25 + Math.random() * (trackHeight * 0.5);

      packet.style.top = `${y}px`;
      packet.style.left = `${startX}px`;

      const fadeIn = packet.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: reduceMotion ? 0 : 200, easing: "ease", fill: "forwards" }
      );
      await fadeIn.finished;

      const slide = packet.animate(
        [{ left: `${startX}px` }, { left: `${endX}px` }],
        { duration: reduceMotion ? 0 : 620, easing: "cubic-bezier(0.35, 0, 0.25, 1)", fill: "forwards" }
      );
      await slide.finished;
      packet.style.left = `${endX}px`;

      const fadeOut = packet.animate(
        [{ opacity: 1 }, { opacity: 0 }],
        { duration: reduceMotion ? 0 : 250, easing: "ease", fill: "forwards" }
      );
      await fadeOut.finished;

      packet.remove();
    }

    async function handshake() {
      connectBtn.disabled = true;
      clearPackets();
      logEl!.innerHTML = "";
      setState("CONNECTING");

      log(`<span class="tag">SYN</span> client &rarr; server &nbsp; seq=${seqClient}`);
      await sendPacket(`SYN seq=${seqClient}`, true);

      log(`<span class="tag">SYN-ACK</span> server &rarr; client &nbsp; seq=${seqServer} ack=${seqClient + 1}`);
      await sendPacket(`SYN-ACK seq=${seqServer} ack=${seqClient + 1}`, false);

      log(`<span class="tag">ACK</span> client &rarr; server &nbsp; ack=${seqServer + 1}`);
      await sendPacket(`ACK ack=${seqServer + 1}`, true);

      setState("ESTABLISHED", "open");
      log(`<span class="tag">Connection established.</span> Both sides can now send data.`);

      connectBtn.disabled = true;
      closeBtn.disabled = false;
    }

    async function teardown() {
      closeBtn.disabled = true;
      setState("CLOSING", "closing");

      log(`<span class="tag fin">FIN</span> client &rarr; server`);
      await sendPacket("FIN", true, "fin");

      log(`<span class="tag fin">ACK</span> server &rarr; client`);
      await sendPacket("ACK", false, "fin");

      log(`<span class="tag fin">FIN</span> server &rarr; client`);
      await sendPacket("FIN", false, "fin");

      log(`<span class="tag fin">ACK</span> client &rarr; server`);
      await sendPacket("ACK", true, "fin");

      setState("CLOSED");
      log(`<span class="tag">Connection closed.</span>`);

      seqClient = Math.floor(Math.random() * 1000) + 1000;
      seqServer = Math.floor(Math.random() * 1000) + 5000;
      connectBtn.disabled = false;
    }

    connectBtn.addEventListener("click", () => { void handshake(); });
    closeBtn.addEventListener("click", () => { void teardown(); });
  })();

  /* ================================================================= */
  /* TCP vs UDP PACKET LOSS                                             */
  /* ================================================================= */
  (function lossModule() {
    const runBtn = document.getElementById("loss-run") as HTMLButtonElement;
    const rateInput = document.getElementById("loss-rate") as HTMLInputElement;
    const rateValue = document.getElementById("loss-rate-value");
    const tcpTrack = document.getElementById("tcp-track");
    const udpTrack = document.getElementById("udp-track");
    const tcpDelivered = document.getElementById("tcp-delivered");
    const tcpRetrans = document.getElementById("tcp-retrans");
    const udpDelivered = document.getElementById("udp-delivered");
    const udpDropped = document.getElementById("udp-dropped");

    if (!runBtn || !rateInput || !rateValue || !tcpTrack || !udpTrack || !tcpDelivered || !tcpRetrans || !udpDelivered || !udpDropped) return;

    const PACKET_COUNT = 10;
    let running = false;

    rateInput.addEventListener("input", () => {
      rateValue!.textContent = `${rateInput.value}%`;
    });

    function chip(label: string, cls: string) {
      const el = document.createElement("div");
      el.className = `np-packet-chip ${cls}`;
      el.textContent = label;
      return el;
    }

    async function run() {
      if (running) return;
      running = true;
      runBtn.disabled = true;

      tcpTrack!.innerHTML = "";
      udpTrack!.innerHTML = "";
      tcpDelivered!.textContent = "0";
      tcpRetrans!.textContent = "0";
      udpDelivered!.textContent = "0";
      udpDropped!.textContent = "0";

      const lossRate = Number(rateInput.value) / 100;
      let tcpDeliveredCount = 0;
      let tcpRetransCount = 0;
      let udpDeliveredCount = 0;
      let udpDroppedCount = 0;

      // UDP: fire and forget, dropped packets are just gone
      for (let i = 1; i <= PACKET_COUNT; i++) {
        const lost = Math.random() < lossRate;
        const el = chip(String(i), "");
        udpTrack!.appendChild(el);
        await sleep(60);
        if (lost) {
          el.classList.add("lost");
          udpDroppedCount++;
          udpDropped!.textContent = String(udpDroppedCount);
        } else {
          el.classList.add("delivered");
          udpDeliveredCount++;
          udpDelivered!.textContent = String(udpDeliveredCount);
        }
      }

      // TCP: every packet eventually delivered via retransmission
      for (let i = 1; i <= PACKET_COUNT; i++) {
        let delivered = false;
        let el = chip(String(i), "");
        tcpTrack!.appendChild(el);

        while (!delivered) {
          await sleep(70);
          const lost = Math.random() < lossRate;
          if (lost) {
            el.classList.add("lost");
            tcpRetransCount++;
            tcpRetrans!.textContent = String(tcpRetransCount);
            await sleep(90);
            el = chip(`${i}\u2019`, "retrans");
            tcpTrack!.appendChild(el);
          } else {
            el.classList.add("delivered");
            delivered = true;
            tcpDeliveredCount++;
            tcpDelivered!.textContent = String(tcpDeliveredCount);
          }
        }
      }

      running = false;
      runBtn.disabled = false;
    }

    runBtn.addEventListener("click", () => { void run(); });
  })();

  /* ================================================================= */
  /* FRAMED CHAT                                                        */
  /* ================================================================= */
  (function chatModule() {
    const input = document.getElementById("chat-input") as HTMLInputElement;
    const sendBtn = document.getElementById("chat-send") as HTMLButtonElement;
    const preview = document.getElementById("chat-frame-preview");
    const log = document.getElementById("chat-log");

    if (!input || !sendBtn || !preview || !log) return;

    function updatePreview() {
      const text = input.value;
      if (!text) {
        preview!.textContent = "";
        return;
      }
      const len = new TextEncoder().encode(text).length;
      const lenHex = len.toString(16).padStart(4, "0");
      preview!.textContent = `frame: [4-byte length prefix: 0x${lenHex} (${len})] + [payload: "${text}"]`;
    }

    function renderEmpty() {
      log!.innerHTML = `<div class="np-chat-empty">No messages yet &mdash; send one to see it framed and delivered.</div>`;
    }

    async function send() {
      const text = input.value.trim();
      if (!text) return;

      const emptyState = log!.querySelector(".np-chat-empty");
      if (emptyState) emptyState.remove();

      const len = new TextEncoder().encode(text).length;
      const lenHex = len.toString(16).padStart(4, "0");

      const wrapper = document.createElement("div");
      wrapper.className = "np-chat-msg";

      const frameLine = document.createElement("div");
      frameLine.className = "np-chat-frame";
      frameLine.textContent = `sending frame \u2014 length=0x${lenHex} (${len} bytes) \u2192 unframing on receipt\u2026`;
      wrapper.appendChild(frameLine);

      log!.appendChild(wrapper);
      log!.scrollTop = log!.scrollHeight;

      input.value = "";
      preview!.textContent = "";
      sendBtn.disabled = true;

      await sleep(500);

      const bubble = document.createElement("div");
      bubble.className = "np-chat-bubble";
      bubble.textContent = text;
      wrapper.appendChild(bubble);
      log!.scrollTop = log!.scrollHeight;

      sendBtn.disabled = false;
      input.focus();
    }

    input.addEventListener("input", updatePreview);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") send();
    });
    sendBtn.addEventListener("click", () => { void send(); });

    renderEmpty();
  })();
</script>