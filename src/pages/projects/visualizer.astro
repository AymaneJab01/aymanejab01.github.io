---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Algorithm Visualizer">
  <main class="visualizer-page">
    <div class="visualizer-shell">

```
  <!-- Back -->
  <a href="/projects" class="back-link">
    <span>←</span>
    <span>Back to projects</span>
  </a>

  <!-- Hero -->
  <header class="hero">
    <div class="eyebrow">
      <span class="eyebrow-dot"></span>
      <span>PROJECT 04</span>
      <span class="eyebrow-separator">/</span>
      <span>CS FUNDAMENTALS</span>
    </div>

    <h1>
      Algorithms,
      <span>visualized.</span>
    </h1>

    <p class="hero-description">
      Interactive visualizations for sorting algorithms, hash tables,
      and graph pathfinding. Explore how classic algorithms work
      one operation at a time.
    </p>

    <div class="tech-row">
      <span>Astro</span>
      <span>TypeScript</span>
      <span>Algorithms</span>
      <span>Data Structures</span>
    </div>
  </header>

  <!-- ========================================================= -->
  <!-- SORTING                                                     -->
  <!-- ========================================================= -->

  <section class="visualizer-card" id="sorting">
    <div class="card-top">
      <div>
        <div class="section-number">01</div>
        <div class="section-label">SORTING</div>
      </div>

      <div class="complexity">
        <span>COMPLEXITY</span>
        <strong id="sort-complexity">O(n²)</strong>
      </div>
    </div>

    <div class="card-heading">
      <h2>Sorting algorithms</h2>
      <p>
        Watch values move through comparisons and swaps as different
        sorting strategies transform the same dataset.
      </p>
    </div>

    <div class="control-panel">
      <div class="control-group">
        <label for="sort-algo">Algorithm</label>
        <select id="sort-algo">
          <option value="bubble">Bubble Sort</option>
          <option value="selection">Selection Sort</option>
          <option value="insertion">Insertion Sort</option>
          <option value="merge">Merge Sort</option>
          <option value="quick" selected>Quick Sort</option>
        </select>
      </div>

      <div class="control-group speed-control">
        <label for="sort-speed">
          Speed
          <span id="sort-speed-label">60%</span>
        </label>
        <input
          id="sort-speed"
          type="range"
          min="1"
          max="100"
          value="60"
        />
      </div>

      <div class="control-actions">
        <button id="sort-run" class="control-button primary">
          Run
        </button>

        <button id="sort-shuffle" class="control-button">
          Shuffle
        </button>
      </div>
    </div>

    <div class="visual-stage sorting-stage">
      <div id="sort-stage" class="bars" aria-label="Sorting visualization"></div>
    </div>

    <div class="stats-row">
      <div class="stat">
        <span>Comparisons</span>
        <strong id="sort-comparisons">0</strong>
      </div>

      <div class="stat">
        <span>Swaps</span>
        <strong id="sort-swaps">0</strong>
      </div>

      <div class="stat status-stat">
        <span>Status</span>
        <strong id="sort-status">Ready</strong>
      </div>
    </div>

    <div class="legend">
      <span>
        <i class="legend-dot compare-dot"></i>
        Comparing
      </span>
      <span>
        <i class="legend-dot swap-dot"></i>
        Swapping
      </span>
      <span>
        <i class="legend-dot sorted-dot"></i>
        Sorted
      </span>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- HASH TABLE                                                  -->
  <!-- ========================================================= -->

  <section class="visualizer-card" id="hash-table">
    <div class="card-top">
      <div>
        <div class="section-number">02</div>
        <div class="section-label">DATA STRUCTURES</div>
      </div>

      <div class="complexity">
        <span>AVERAGE LOOKUP</span>
        <strong>O(1)</strong>
      </div>
    </div>

    <div class="card-heading">
      <h2>Hash table</h2>
      <p>
        Insert key-value pairs into an eight-bucket hash table and
        observe separate chaining when collisions occur.
      </p>
    </div>

    <div class="control-panel">
      <div class="control-group">
        <label for="hash-key">Key</label>
        <input
          id="hash-key"
          type="text"
          maxlength="16"
          placeholder="e.g. apple"
        />
      </div>

      <div class="control-group">
        <label for="hash-value">Value</label>
        <input
          id="hash-value"
          type="text"
          maxlength="16"
          placeholder="e.g. 42"
        />
      </div>

      <div class="control-actions">
        <button id="hash-insert" class="control-button primary">
          Insert
        </button>

        <button id="hash-random" class="control-button">
          Random
        </button>

        <button id="hash-clear" class="control-button">
          Clear
        </button>
      </div>
    </div>

    <div id="hash-formula" class="formula">
      Waiting for an insertion…
    </div>

    <div
      id="hash-buckets"
      class="hash-grid"
      aria-label="Hash table visualization"
    ></div>

    <div class="stats-row">
      <div class="stat">
        <span>Items</span>
        <strong id="hash-items">0</strong>
      </div>

      <div class="stat">
        <span>Load factor</span>
        <strong id="hash-load">0.00</strong>
      </div>

      <div class="stat">
        <span>Collisions</span>
        <strong id="hash-collisions">0</strong>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- PATHFINDING                                                 -->
  <!-- ========================================================= -->

  <section class="visualizer-card" id="pathfinding">
    <div class="card-top">
      <div>
        <div class="section-number">03</div>
        <div class="section-label">GRAPH SEARCH</div>
      </div>

      <div class="complexity">
        <span>GRID</span>
        <strong>24 × 12</strong>
      </div>
    </div>

    <div class="card-heading">
      <h2>Pathfinding</h2>
      <p>
        Draw obstacles and watch BFS, Dijkstra, or A* explore the grid
        before reconstructing the shortest path.
      </p>
    </div>

    <div class="control-panel">
      <div class="control-group">
        <label for="path-algo">Algorithm</label>
        <select id="path-algo">
          <option value="dijkstra">Dijkstra</option>
          <option value="astar" selected>A*</option>
          <option value="bfs">Breadth-First Search</option>
        </select>
      </div>

      <div class="control-actions">
        <button id="path-run" class="control-button primary">
          Run
        </button>

        <button id="path-walls" class="control-button">
          Random walls
        </button>

        <button id="path-clear" class="control-button">
          Clear
        </button>
      </div>

      <div class="interaction-hint">
        Click / drag to draw walls
      </div>
    </div>

    <div class="visual-stage path-stage">
      <div
        id="path-grid"
        class="path-grid"
        aria-label="Pathfinding grid"
      ></div>
    </div>

    <div class="stats-row">
      <div class="stat">
        <span>Visited</span>
        <strong id="path-visited">0</strong>
      </div>

      <div class="stat">
        <span>Path length</span>
        <strong id="path-length">—</strong>
      </div>

      <div class="stat status-stat">
        <span>Status</span>
        <strong id="path-status">Ready</strong>
      </div>
    </div>

    <div class="legend">
      <span>
        <i class="legend-dot start-dot"></i>
        Start
      </span>
      <span>
        <i class="legend-dot end-dot"></i>
        End
      </span>
      <span>
        <i class="legend-dot visited-dot"></i>
        Visited
      </span>
      <span>
        <i class="legend-dot path-dot"></i>
        Shortest path
      </span>
    </div>
  </section>

  <footer class="visualizer-footer">
    <span>ALGORITHM VISUALIZER</span>
    <span>03 INTERACTIVE MODULES</span>
  </footer>

</div>
```

  </main>
</Layout>

<style>
  /* ================================================================
     BASE
     ================================================================ */

  .visualizer-page {
    --blue: #38bdf8;
    --blue-bright: #67e8f9;
    --blue-soft: rgba(56, 189, 248, 0.12);
    --blue-border: rgba(56, 189, 248, 0.28);

    --bg: #08090b;
    --panel: rgba(13, 15, 18, 0.88);
    --panel-soft: rgba(255, 255, 255, 0.025);

    --text: #f5f7fa;
    --muted: #9ca3af;
    --dim: #6b7280;
    --border: rgba(255, 255, 255, 0.10);

    min-height: 100vh;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(56, 189, 248, 0.07),
        transparent 35rem
      ),
      var(--bg);
    color: var(--text);
  }

  .visualizer-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 110px 0 80px;
  }

  /* ================================================================
     BACK LINK
     ================================================================ */

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 70px;
    color: var(--muted);
    font: 500 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .back-link span:first-child {
    color: var(--blue);
    font-size: 17px;
    transition: transform 180ms ease;
  }

  .back-link:hover {
    color: var(--text);
  }

  .back-link:hover span:first-child {
    transform: translateX(-3px);
  }

  /* ================================================================
     HERO
     ================================================================ */

  .hero {
    max-width: 820px;
    margin-bottom: 76px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    color: var(--blue);
    font: 600 11px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.16em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.9);
  }

  .eyebrow-separator {
    color: var(--dim);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.7rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 600;
  }

  .hero h1 span {
    color: var(--blue);
  }

  .hero-description {
    max-width: 690px;
    margin: 26px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 27px;
  }

  .tech-row span {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    color: #aeb4bd;
    background: rgba(255, 255, 255, 0.025);
    font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* ================================================================
     CARDS
     ================================================================ */

  .visualizer-card {
    position: relative;
    overflow: hidden;
    margin-bottom: 22px;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.025),
        rgba(255, 255, 255, 0.008)
      ),
      var(--panel);
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.025);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .visualizer-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(56, 189, 248, 0.3),
      transparent
    );
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .visualizer-card:hover {
    border-color: rgba(56, 189, 248, 0.20);
  }

  .visualizer-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .section-number {
    color: var(--blue);
    font: 600 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.15em;
  }

  .section-label {
    margin-top: 6px;
    color: var(--dim);
    font: 600 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.14em;
  }

  .complexity {
    text-align: right;
  }

  .complexity span {
    display: block;
    color: var(--dim);
    font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
  }

  .complexity strong {
    display: block;
    margin-top: 5px;
    color: var(--blue);
    font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .card-heading {
    max-width: 700px;
    margin-top: 30px;
  }

  .card-heading h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.65rem, 4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .card-heading p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  /* ================================================================
     CONTROLS
     ================================================================ */

  .control-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    margin-top: 28px;
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 9px;
    background: rgba(0, 0, 0, 0.20);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .control-group label {
    color: var(--dim);
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  select,
  input[type="text"] {
    min-width: 155px;
    height: 36px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: 6px;
    outline: none;
    background: #0b0d10;
    color: var(--text);
    font: 12px ui-monospace, SFMono-Regular, Menlo, monospace;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  select:hover,
  input[type="text"]:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  select:focus,
  input[type="text"]:focus {
    border-color: var(--blue-border);
    box-shadow: 0 0 0 3px var(--blue-soft);
  }

  .speed-control {
    min-width: 180px;
  }

  .speed-control label {
    display: flex;
    justify-content: space-between;
  }

  .speed-control label span {
    color: var(--blue);
  }

  input[type="range"] {
    width: 180px;
    height: 36px;
    accent-color: var(--blue);
    cursor: pointer;
  }

  .control-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .control-button {
    height: 36px;
    padding: 0 13px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.025);
    color: #b9c0c9;
    font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    cursor: pointer;
    transition: all 160ms ease;
  }

  .control-button:hover {
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }

  .control-button.primary {
    border-color: rgba(56, 189, 248, 0.42);
    background: rgba(56, 189, 248, 0.09);
    color: var(--blue-bright);
  }

  .control-button.primary:hover {
    border-color: var(--blue);
    background: rgba(56, 189, 248, 0.15);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.08);
  }

  .control-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .interaction-hint {
    margin-left: auto;
    padding-bottom: 9px;
    color: var(--dim);
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* ================================================================
     VISUAL STAGES
     ================================================================ */

  .visual-stage {
    margin-top: 14px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 9px;
    background:
      radial-gradient(
        circle at 50% 100%,
        rgba(56, 189, 248, 0.035),
        transparent 50%
      ),
      #080a0d;
  }

  /* ================================================================
     SORTING
     ================================================================ */

  .sorting-stage {
    height: 300px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    width: 100%;
    height: 100%;
  }

  .bar {
    flex: 1 1 0;
    min-width: 2px;
    border-radius: 3px 3px 1px 1px;
    background: #6b7280;
    opacity: 0.6;
    transition:
      height 50ms linear,
      background 80ms ease,
      opacity 80ms ease,
      box-shadow 80ms ease;
  }

  .bar.compare {
    background: var(--blue);
    opacity: 1;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
  }

  .bar.swap {
    background: #fbbf24;
    opacity: 1;
    box-shadow: 0 0 14px rgba(251, 191, 36, 0.35);
  }

  .bar.sorted {
    background: #34d399;
    opacity: 0.85;
  }

  /* ================================================================
     HASH TABLE
     ================================================================ */

  .formula {
    min-height: 36px;
    margin-top: 12px;
    padding: 10px 12px;
    border-left: 2px solid rgba(56, 189, 248, 0.5);
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.045);
    color: #9ca3af;
    font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .hash-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }

  .hash-bucket {
    min-height: 95px;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.018);
  }

  .hash-index {
    color: var(--dim);
    font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
  }

  .hash-chain {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }

  .hash-node {
    padding: 6px 7px;
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 5px;
    background: rgba(56, 189, 248, 0.07);
    color: #d7dde5;
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    animation: node-in 180ms ease;
  }

  .hash-node.collision {
    border-color: rgba(251, 191, 36, 0.35);
    background: rgba(251, 191, 36, 0.07);
  }

  .hash-arrow {
    color: var(--dim);
    text-align: center;
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  @keyframes node-in {
    from {
      transform: translateY(4px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* ================================================================
     PATHFINDING
     ================================================================ */

  .path-grid {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 2px;
  }

  .path-cell {
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.035);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.018);
    cursor: crosshair;
    transition:
      background 90ms ease,
      border-color 90ms ease,
      transform 90ms ease;
  }

  .path-cell:hover {
    border-color: rgba(56, 189, 248, 0.25);
  }

  .path-cell.wall {
    border-color: rgba(255, 255, 255, 0.10);
    background: #252a31;
  }

  .path-cell.start {
    border-color: var(--blue);
    background: var(--blue);
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.45);
  }

  .path-cell.end {
    border-color: #fb7185;
    background: #fb7185;
    box-shadow: 0 0 15px rgba(251, 113, 133, 0.35);
  }

  .path-cell.visited {
    border-color: rgba(56, 189, 248, 0.18);
    background: rgba(56, 189, 248, 0.20);
    animation: visited-in 130ms ease;
  }

  .path-cell.path {
    border-color: #fbbf24;
    background: #fbbf24;
    box-shadow: 0 0 9px rgba(251, 191, 36, 0.3);
  }

  @keyframes visited-in {
    from {
      transform: scale(0.7);
      opacity: 0.2;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* ================================================================
     STATS / LEGEND
     ================================================================ */

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 15px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .stat span {
    color: var(--dim);
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat strong {
    color: var(--blue);
    font: 600 12px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .status-stat strong {
    color: #cbd5e1;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 17px;
    margin-top: 14px;
    color: var(--dim);
    font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
  }

  .compare-dot,
  .visited-dot {
    background: var(--blue);
  }

  .swap-dot,
  .path-dot {
    background: #fbbf24;
  }

  .sorted-dot {
    background: #34d399;
  }

  .start-dot {
    background: var(--blue);
  }

  .end-dot {
    background: #fb7185;
  }

  /* ================================================================
     FOOTER
     ================================================================ */

  .visualizer-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 55px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--dim);
    font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
  }

  /* ================================================================
     RESPONSIVE
     ================================================================ */

  @media (max-width: 700px) {
    .visualizer-shell {
      width: min(100% - 22px, 1120px);
      padding-top: 80px;
    }

    .back-link {
      margin-bottom: 50px;
    }

    .hero {
      margin-bottom: 55px;
    }

    .hero-description {
      font-size: 15px;
    }

    .visualizer-card {
      padding: 20px;
    }

    .control-panel {
      align-items: stretch;
      flex-direction: column;
    }

    .control-group,
    .speed-control {
      width: 100%;
    }

    select,
    input[type="text"],
    input[type="range"] {
      width: 100%;
    }

    .control-actions {
      width: 100%;
    }

    .control-button {
      flex: 1;
    }

    .interaction-hint {
      margin-left: 0;
      padding-bottom: 0;
    }

    .hash-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sorting-stage {
      height: 220px;
    }

    .stats-row {
      gap: 15px;
    }

    .visualizer-footer {
      flex-direction: column;
    }
  }

  @media (max-width: 420px) {
    .hash-grid {
      grid-template-columns: 1fr;
    }

    .card-top {
      flex-direction: column;
    }

    .complexity {
      text-align: left;
    }
  }
</style>

<script>
  type Point = {
    r: number;
    c: number;
  };

  const sleep = (ms: number) =>
    new Promise<void>((resolve) => setTimeout(resolve, ms));

  /* ================================================================
     SORTING VISUALIZER
     ================================================================ */

  (() => {
    const stage = document.getElementById("sort-stage");
    const algo = document.getElementById("sort-algo") as HTMLSelectElement | null;
    const runButton = document.getElementById("sort-run") as HTMLButtonElement | null;
    const shuffleButton = document.getElementById("sort-shuffle") as HTMLButtonElement | null;
    const speed = document.getElementById("sort-speed") as HTMLInputElement | null;
    const speedLabel = document.getElementById("sort-speed-label");
    const complexity = document.getElementById("sort-complexity");
    const comparisonsEl = document.getElementById("sort-comparisons");
    const swapsEl = document.getElementById("sort-swaps");
    const statusEl = document.getElementById("sort-status");

    if (
      !stage ||
      !algo ||
      !runButton ||
      !shuffleButton ||
      !speed ||
      !speedLabel ||
      !complexity ||
      !comparisonsEl ||
      !swapsEl ||
      !statusEl
    ) {
      return;
    }

    const COUNT = 42;

    let values: number[] = [];
    let bars: HTMLDivElement[] = [];
    let running = false;

    let comparisons = 0;
    let swaps = 0;

    const complexityMap: Record<string, string> = {
      bubble: "O(n²)",
      selection: "O(n²)",
      insertion: "O(n²)",
      merge: "O(n log n)",
      quick: "O(n log n)"
    };

    function delay() {
      const value = Number(speed.value);
      return Math.max(8, 210 - value * 2);
    }

    function updateSpeedLabel() {
      speedLabel.textContent = `${speed.value}%`;
    }

    function updateComplexity() {
      complexity.textContent = complexityMap[algo.value] ?? "—";
    }

    function createValues() {
      values = Array.from(
        { length: COUNT },
        () => Math.floor(Math.random() * 90) + 8
      );
    }

    function render() {
      stage.innerHTML = "";
      bars = [];

      values.forEach((value) => {
        const bar = document.createElement("div");
        bar.className = "bar";
        bar.style.height = `${value}%`;

        stage.appendChild(bar);
        bars.push(bar);
      });
    }

    function setStats() {
      comparisonsEl.textContent = String(comparisons);
      swapsEl.textContent = String(swaps);
    }

    function clearMarks() {
      bars.forEach((bar) => {
        bar.classList.remove("compare", "swap");
      });
    }

    async function highlight(
      indexes: number[],
      className: "compare" | "swap"
    ) {
      clearMarks();

      indexes.forEach((index) => {
        bars[index]?.classList.add(className);
      });

      await sleep(delay());
    }

    function updateBar(index: number) {
      const bar = bars[index];

      if (bar) {
        bar.style.height = `${values[index]}%`;
      }
    }

    function markSorted(index: number) {
      const bar = bars[index];

      if (bar) {
        bar.classList.remove("compare", "swap");
        bar.classList.add("sorted");
      }
    }

    async function bubbleSort() {
      for (let end = values.length - 1; end > 0; end--) {
        for (let i = 0; i < end; i++) {
          comparisons++;
          setStats();

          await highlight([i, i + 1], "compare");

          if (values[i] > values[i + 1]) {
            [values[i], values[i + 1]] = [values[i + 1], values[i]];

            swaps++;
            setStats();

            updateBar(i);
            updateBar(i + 1);

            await highlight([i, i + 1], "swap");
          }
        }

        markSorted(end);
      }

      markSorted(0);
    }

    async function selectionSort() {
      for (let i = 0; i < values.length; i++) {
        let minimum = i;

        for (let j = i + 1; j < values.length; j++) {
          comparisons++;
          setStats();

          await highlight([minimum, j], "compare");

          if (values[j] < values[minimum]) {
            minimum = j;
          }
        }

        if (minimum !== i) {
          [values[i], values[minimum]] = [
            values[minimum],
            values[i]
          ];

          swaps++;
          setStats();

          updateBar(i);
          updateBar(minimum);

          await highlight([i, minimum], "swap");
        }

        markSorted(i);
      }
    }

    async function insertionSort() {
      for (let i = 1; i < values.length; i++) {
        let j = i;

        while (j > 0) {
          comparisons++;
          setStats();

          await highlight([j - 1, j], "compare");

          if (values[j - 1] > values[j]) {
            [values[j - 1], values[j]] = [
              values[j],
              values[j - 1]
            ];

            swaps++;
            setStats();

            updateBar(j - 1);
            updateBar(j);

            await highlight([j - 1, j], "swap");

            j--;
          } else {
            break;
          }
        }
      }

      values.forEach((_, index) => markSorted(index));
    }

    async function mergeSort() {
      async function merge(
        left: number,
        middle: number,
        right: number
      ) {
        const first = values.slice(left, middle + 1);
        const second = values.slice(middle + 1, right + 1);

        let i = 0;
        let j = 0;
        let k = left;

        while (i < first.length && j < second.length) {
          comparisons++;
          setStats();

          await highlight(
            [left + i, middle + 1 + j],
            "compare"
          );

          if (first[i] <= second[j]) {
            values[k] = first[i];
            i++;
          } else {
            values[k] = second[j];
            j++;
          }

          updateBar(k);

          swaps++;
          setStats();

          k++;
        }

        while (i < first.length) {
          values[k] = first[i];
          updateBar(k);
          i++;
          k++;
        }

        while (j < second.length) {
          values[k] = second[j];
          updateBar(k);
          j++;
          k++;
        }
      }

      async function sort(left: number, right: number) {
        if (left >= right) return;

        const middle = Math.floor((left + right) / 2);

        await sort(left, middle);
        await sort(middle + 1, right);
        await merge(left, middle, right);
      }

      await sort(0, values.length - 1);

      values.forEach((_, index) => markSorted(index));
    }

    async function quickSort() {
      async function partition(
        left: number,
        right: number
      ): Promise<number> {
        const pivot = values[right];
        let smaller = left - 1;

        for (let j = left; j < right; j++) {
          comparisons++;
          setStats();

          await highlight([j, right], "compare");

          if (values[j] < pivot) {
            smaller++;

            [values[smaller], values[j]] = [
              values[j],
              values[smaller]
            ];

            swaps++;
            setStats();

            updateBar(smaller);
            updateBar(j);

            await highlight([smaller, j], "swap");
          }
        }

        [values[smaller + 1], values[right]] = [
          values[right],
          values[smaller + 1]
        ];

        swaps++;
        setStats();

        updateBar(smaller + 1);
        updateBar(right);

        await highlight(
          [smaller + 1, right],
          "swap"
        );

        return smaller + 1;
      }

      async function sort(left: number, right: number) {
        if (left > right) return;

        if (left === right) {
          markSorted(left);
          return;
        }

        const pivot = await partition(left, right);

        markSorted(pivot);

        await sort(left, pivot - 1);
        await sort(pivot + 1, right);
      }

      await sort(0, values.length - 1);
    }

    const algorithms: Record<
      string,
      () => Promise<void>
    > = {
      bubble: bubbleSort,
      selection: selectionSort,
      insertion: insertionSort,
      merge: mergeSort,
      quick: quickSort
    };

    async function run() {
      if (running) return;

      running = true;

      runButton.disabled = true;
      shuffleButton.disabled = true;
      algo.disabled = true;

      comparisons = 0;
      swaps = 0;

      setStats();

      bars.forEach((bar) => {
        bar.classList.remove("sorted");
      });

      statusEl.textContent = "Running…";

      try {
        await algorithms[algo.value]();

        clearMarks();

        bars.forEach((bar) => {
          bar.classList.add("sorted");
        });

        statusEl.textContent = "Complete";
      } catch {
        statusEl.textContent = "Stopped";
      }

      runButton.disabled = false;
      shuffleButton.disabled = false;
      algo.disabled = false;

      running = false;
    }

    function shuffle() {
      if (running) return;

      createValues();
      render();

      comparisons = 0;
      swaps = 0;

      setStats();
      statusEl.textContent = "Ready";
    }

    speed.addEventListener("input", updateSpeedLabel);
    algo.addEventListener("change", updateComplexity);

    runButton.addEventListener("click", run);
    shuffleButton.addEventListener("click", shuffle);

    updateSpeedLabel();
    updateComplexity();
    shuffle();
  })();

  /* ================================================================
     HASH TABLE
     ================================================================ */

  (() => {
    const bucketsEl = document.getElementById("hash-buckets");
    const keyInput = document.getElementById("hash-key") as HTMLInputElement | null;
    const valueInput = document.getElementById("hash-value") as HTMLInputElement | null;
    const insertButton = document.getElementById("hash-insert") as HTMLButtonElement | null;
    const randomButton = document.getElementById("hash-random") as HTMLButtonElement | null;
    const clearButton = document.getElementById("hash-clear") as HTMLButtonElement | null;
    const formula = document.getElementById("hash-formula");
    const itemsEl = document.getElementById("hash-items");
    const loadEl = document.getElementById("hash-load");
    const collisionsEl = document.getElementById("hash-collisions");

    if (
      !bucketsEl ||
      !keyInput ||
      !valueInput ||
      !insertButton ||
      !randomButton ||
      !clearButton ||
      !formula ||
      !itemsEl ||
      !loadEl ||
      !collisionsEl
    ) {
      return;
    }

    const BUCKETS = 8;

    type Entry = {
      key: string;
      value: string;
    };

    let table: Entry[][] = Array.from(
      { length: BUCKETS },
      () => []
    );

    let itemCount = 0;
    let collisionCount = 0;

    function hash(key: string) {
      let hashValue = 0;

      for (let i = 0; i < key.length; i++) {
        hashValue =
          (hashValue * 31 + key.charCodeAt(i)) >>> 0;
      }

      return hashValue % BUCKETS;
    }

    function render() {
      bucketsEl.innerHTML = "";

      table.forEach((chain, index) => {
        const bucket = document.createElement("div");
        bucket.className = "hash-bucket";

        const label = document.createElement("div");
        label.className = "hash-index";
        label.textContent = `bucket ${index}`;

        bucket.appendChild(label);

        const chainEl = document.createElement("div");
        chainEl.className = "hash-chain";

        chain.forEach((entry, entryIndex) => {
          const node = document.createElement("div");

          node.className =
            "hash-node" +
            (chain.length > 1 ? " collision" : "");

          node.textContent =
            `${entry.key} → ${entry.value}`;

          chainEl.appendChild(node);

          if (entryIndex < chain.length - 1) {
            const arrow = document.createElement("div");
            arrow.className = "hash-arrow";
            arrow.textContent = "↓";
            chainEl.appendChild(arrow);
          }
        });

        bucket.appendChild(chainEl);
        bucketsEl.appendChild(bucket);
      });

      itemsEl.textContent = String(itemCount);
      loadEl.textContent =
        (itemCount / BUCKETS).toFixed(2);
      collisionsEl.textContent =
        String(collisionCount);
    }

    function insert(key: string, value: string) {
      if (!key) return;

      const index = hash(key);
      const chain = table[index];

      const existing = chain.find(
        (entry) => entry.key === key
      );

      if (existing) {
        existing.value = value || existing.value;

        formula.textContent =
          `hash("${key}") = ${index} → updated existing key`;
      } else {
        if (chain.length > 0) {
          collisionCount++;
        }

        chain.push({
          key,
          value: value || "—"
        });

        itemCount++;

        formula.textContent =
          `hash("${key}") = ${index} → bucket ${index}` +
          (chain.length > 1
            ? " → collision → chained"
            : "");
      }

      render();
    }

    function randomKey() {
      const words = [
        "node",
        "heap",
        "tree",
        "graph",
        "byte",
        "stack",
        "queue",
        "hash",
        "sort",
        "edge",
        "root",
        "array"
      ];

      return (
        words[Math.floor(Math.random() * words.length)] +
        Math.floor(Math.random() * 100)
      );
    }

    insertButton.addEventListener("click", () => {
      insert(
        keyInput.value.trim(),
        valueInput.value.trim()
      );

      keyInput.value = "";
      valueInput.value = "";
      keyInput.focus();
    });

    [keyInput, valueInput].forEach((input) => {
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          insertButton.click();
        }
      });
    });

    randomButton.addEventListener("click", () => {
      insert(
        randomKey(),
        String(Math.floor(Math.random() * 1000))
      );
    });

    clearButton.addEventListener("click", () => {
      table = Array.from(
        { length: BUCKETS },
        () => []
      );

      itemCount = 0;
      collisionCount = 0;

      formula.textContent =
        "Waiting for an insertion…";

      render();
    });

    render();
  })();

  /* ================================================================
     PATHFINDING
     ================================================================ */

  (() => {
    const gridEl = document.getElementById("path-grid");
    const algoSelect = document.getElementById("path-algo") as HTMLSelectElement | null;
    const runButton = document.getElementById("path-run") as HTMLButtonElement | null;
    const wallsButton = document.getElementById("path-walls") as HTMLButtonElement | null;
    const clearButton = document.getElementById("path-clear") as HTMLButtonElement | null;
    const visitedEl = document.getElementById("path-visited");
    const lengthEl = document.getElementById("path-length");
    const statusEl = document.getElementById("path-status");

    if (
      !gridEl ||
      !algoSelect ||
      !runButton ||
      !wallsButton ||
      !clearButton ||
      !visitedEl ||
      !lengthEl ||
      !statusEl
    ) {
      return;
    }

    const ROWS = 12;
    const COLS = 24;

    type CellState =
      | "empty"
      | "wall"
      | "start"
      | "end"
      | "visited"
      | "path";

    let grid: CellState[][] = [];
    let cellElements: HTMLDivElement[][] = [];

    let start: Point = {
      r: 5,
      c: 3
    };

    let end: Point = {
      r: 5,
      c: 20
    };

    let dragMode:
      | "wall"
      | "erase"
      | "start"
      | "end"
      | null = null;

    let running = false;

    function createEmptyGrid() {
      return Array.from(
        { length: ROWS },
        () =>
          Array.from(
            { length: COLS },
            () => "empty" as CellState
          )
      );
    }

    function resetGrid() {
      grid = createEmptyGrid();

      grid[start.r][start.c] = "start";
      grid[end.r][end.c] = "end";
    }

    function render() {
      gridEl.innerHTML = "";
      cellElements = [];

      for (let r = 0; r < ROWS; r++) {
        const row: HTMLDivElement[] = [];

        for (let c = 0; c < COLS; c++) {
          const cell = document.createElement("div");

          cell.className =
            "path-cell " + grid[r][c];

          cell.dataset.row = String(r);
          cell.dataset.col = String(c);

          cell.addEventListener(
            "pointerdown",
            (event) => {
              event.preventDefault();
              handlePointerDown(r, c);
            }
          );

          cell.addEventListener(
            "pointerenter",
            () => {
              handlePointerEnter(r, c);
            }
          );

          gridEl.appendChild(cell);
          row.push(cell);
        }

        cellElements.push(row);
      }
    }

    function setCell(
      r: number,
      c: number,
      state: CellState
    ) {
      grid[r][c] = state;

      const cell = cellElements[r]?.[c];

      if (cell) {
        cell.className =
          "path-cell " + state;
      }
    }

    function handlePointerDown(
      r: number,
      c: number
    ) {
      if (running) return;

      if (grid[r][c] === "start") {
        dragMode = "start";
        return;
      }

      if (grid[r][c] === "end") {
        dragMode = "end";
        return;
      }

      if (grid[r][c] === "wall") {
        dragMode = "erase";
        setCell(r, c, "empty");
      } else {
        dragMode = "wall";
        setCell(r, c, "wall");
      }
    }

    function handlePointerEnter(
      r: number,
      c: number
    ) {
      if (running || !dragMode) return;

      if (dragMode === "wall") {
        if (
          grid[r][c] !== "start" &&
          grid[r][c] !== "end"
        ) {
          setCell(r, c, "wall");
        }

        return;
      }

      if (dragMode === "erase") {
        if (
          grid[r][c] !== "start" &&
          grid[r][c] !== "end"
        ) {
          setCell(r, c, "empty");
        }

        return;
      }

      if (dragMode === "start") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "end"
        ) {
          return;
        }

        setCell(start.r, start.c, "empty");

        start = { r, c };

        setCell(r, c, "start");

        return;
      }

      if (dragMode === "end") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "start"
        ) {
          return;
        }

        setCell(end.r, end.c, "empty");

        end = { r, c };

        setCell(r, c, "end");
      }
    }

    document.addEventListener("pointerup", () => {
      dragMode = null;
    });

    function pointKey(point: Point) {
      return `${point.r},${point.c}`;
    }

    function neighbors(point: Point) {
      const directions = [
        [-1, 0],
        [1, 0],
        [0, -1],
        [0, 1]
      ];

      const result: Point[] = [];

      for (const [dr, dc] of directions) {
        const r = point.r + dr;
        const c = point.c + dc;

        if (
          r >= 0 &&
          r < ROWS &&
          c >= 0 &&
          c < COLS &&
          grid[r][c] !== "wall"
        ) {
          result.push({ r, c });
        }
      }

      return result;
    }

    function heuristic(point: Point) {
      return (
        Math.abs(point.r - end.r) +
        Math.abs(point.c - end.c)
      );
    }

    type SearchResult = {
      order: Point[];
      cameFrom: Map<string, Point>;
      found: boolean;
    };

    async function search(
      algorithm: "bfs" | "dijkstra" | "astar"
    ): Promise<SearchResult> {
      const order: Point[] = [];
      const cameFrom = new Map<string, Point>();

      const visited = new Set<string>();

      const distances = new Map<string, number>();

      distances.set(pointKey(start), 0);

      if (algorithm === "bfs") {
        const queue: Point[] = [start];

        visited.add(pointKey(start));

        while (queue.length > 0) {
          const current = queue.shift()!;

          if (
            current.r !== start.r ||
            current.c !== start.c
          ) {
            order.push(current);
          }

          if (
            current.r === end.r &&
            current.c === end.c
          ) {
            return {
              order,
              cameFrom,
              found: true
            };
          }

          for (const next of neighbors(current)) {
            const nextKey = pointKey(next);

            if (visited.has(nextKey)) {
              continue;
            }

            visited.add(nextKey);

            cameFrom.set(nextKey, current);

            queue.push(next);
          }
        }

        return {
          order,
          cameFrom,
          found: false
        };
      }

      const open: Array<{
        point: Point;
        priority: number;
      }> = [
        {
          point: start,
          priority: 0
        }
      ];

      const closed = new Set<string>();

      while (open.length > 0) {
        open.sort(
          (a, b) => a.priority - b.priority
        );

        const currentEntry = open.shift()!;
        const current = currentEntry.point;
        const currentKey = pointKey(current);

        if (closed.has(currentKey)) {
          continue;
        }

        closed.add(currentKey);

        if (
          current.r !== start.r ||
          current.c !== start.c
        ) {
          order.push(current);
        }

        if (
          current.r === end.r &&
          current.c === end.c
        ) {
          return {
            order,
            cameFrom,
            found: true
          };
        }

        const currentDistance =
          distances.get(currentKey) ?? 0;

        for (const next of neighbors(current)) {
          const nextKey = pointKey(next);

          if (closed.has(nextKey)) {
            continue;
          }

          const newCost = currentDistance + 1;

          if (
            newCost <
            (distances.get(nextKey) ?? Infinity)
          ) {
            distances.set(nextKey, newCost);

            cameFrom.set(nextKey, current);

            const priority =
              algorithm === "astar"
                ? newCost + heuristic(next)
                : newCost;

            open.push({
              point: next,
              priority
            });
          }
        }
      }

      return {
        order,
        cameFrom,
        found: false
      };
    }

    function clearSearchVisualization() {
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (
            grid[r][c] === "visited" ||
            grid[r][c] === "path"
          ) {
            setCell(r, c, "empty");
          }
        }
      }

      setCell(start.r, start.c, "start");
      setCell(end.r, end.c, "end");
    }

    async function run() {
      if (running) return;

      running = true;

      runButton.disabled = true;
      wallsButton.disabled = true;
      clearButton.disabled = true;
      algoSelect.disabled = true;

      visitedEl.textContent = "0";
      lengthEl.textContent = "—";
      statusEl.textContent = "Searching…";

      clearSearchVisualization();

      const algorithm =
        algoSelect.value as
          | "bfs"
          | "dijkstra"
          | "astar";

      const result = await search(algorithm);

      for (
        let index = 0;
        index < result.order.length;
        index++
      ) {
        const point = result.order[index];

        if (
          grid[point.r][point.c] === "empty"
        ) {
          setCell(
            point.r,
            point.c,
            "visited"
          );
        }

        visitedEl.textContent =
          String(index + 1);

        await sleep(12);
      }

      if (!result.found) {
        statusEl.textContent = "No path found";

        running = false;

        runButton.disabled = false;
        wallsButton.disabled = false;
        clearButton.disabled = false;
        algoSelect.disabled = false;

        return;
      }

      const path: Point[] = [];

      let current: Point = {
        r: end.r,
        c: end.c
      };

      while (
        current.r !== start.r ||
        current.c !== start.c
      ) {
        path.push(current);

        const previous =
          result.cameFrom.get(
            pointKey(current)
          );

        if (!previous) {
          break;
        }

        current = previous;
      }

      path.reverse();

      for (const point of path) {
        if (
          point.r !== end.r ||
          point.c !== end.c
        ) {
          setCell(
            point.r,
            point.c,
            "path"
          );
        }

        await sleep(24);
      }

      lengthEl.textContent =
        String(path.length);

      statusEl.textContent =
        "Path found";

      running = false;

      runButton.disabled = false;
      wallsButton.disabled = false;
      clearButton.disabled = false;
      algoSelect.disabled = false;
    }

    function randomWalls() {
      if (running) return;

      resetGrid();

      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (
            grid[r][c] === "empty" &&
            Math.random() < 0.27
          ) {
            grid[r][c] = "wall";
          }
        }
      }

      render();

      visitedEl.textContent = "0";
      lengthEl.textContent = "—";
      statusEl.textContent = "Ready";
    }

    function clear() {
      if (running) return;

      resetGrid();
      render();

      visitedEl.textContent = "0";
      lengthEl.textContent = "—";
      statusEl.textContent = "Ready";
    }

    runButton.addEventListener("click", run);
    wallsButton.addEventListener(
      "click",
      randomWalls
    );
    clearButton.addEventListener(
      "click",
      clear
    );

    resetGrid();
    render();
  })();
</script>
