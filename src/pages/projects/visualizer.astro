---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Algorithm Visualizer">
  <main class="algorithm-page">
    <canvas id="ascii-bg" class="ascii-bg" aria-hidden="true"></canvas>

    <div class="shell">
      <aside class="sidebar">
        <a href="/projects" class="back-link">
          <span>←</span>
          <span>Back to projects</span>
        </a>

        <div class="brand">
          <span class="brand-dot"></span>
          <span class="brand-name">algorithm<span class="brand-cursor">_</span></span>
        </div>
        <div class="brand-sub">visualizer / interactive reference</div>

        <nav class="doc-nav" aria-label="Sections">
          <a href="#overview"><span>00</span>Overview</a>
          <a href="#sorting"><span>01</span>Sorting</a>
          <a href="#hash-table"><span>02</span>Hash table</a>
          <a href="#pathfinding"><span>03</span>Pathfinding</a>
          <a href="#reference"><span>04</span>Reference</a>
        </nav>

        <div class="sidebar-foot">
          <div class="tech-row">
            <span>ASTRO</span>
            <span>TYPESCRIPT</span>
            <span>CANVAS</span>
          </div>
        </div>
      </aside>

      <div class="content">
        <header class="hero" id="overview">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>PROJECT 04</span>
            <span class="separator">/</span>
            <span>COMPUTER SCIENCE</span>
          </div>

          <h1>
            Algorithms,
            <span>rendered live.</span>
          </h1>

          <p class="hero-description">
            Three interactive references for how classic algorithms actually
            move through data — sorting, hashing, and pathfinding, executed
            step by step in the browser rather than narrated over a static
            diagram.
          </p>

          <div class="hero-key">
            <span><i class="key-dot compare"></i>comparing</span>
            <span><i class="key-dot swap"></i>writing</span>
            <span><i class="key-dot sorted"></i>settled</span>
          </div>
        </header>

        <section class="demo-section" id="sorting">
          <div class="section-heading">
            <div class="section-number">01</div>

            <div>
              <div class="section-label">SORTING ALGORITHMS</div>
              <h2>Watch algorithms sort data.</h2>
              <p>
                Compare five classic sorting algorithms and observe their
                comparisons and writes in real time.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar">
              <div class="control-group">
                <label for="sort-algo">Algorithm</label>
                <select id="sort-algo">
                  <option value="bubble">Bubble Sort</option>
                  <option value="selection">Selection Sort</option>
                  <option value="insertion">Insertion Sort</option>
                  <option value="merge">Merge Sort</option>
                  <option value="quick" selected>Quick Sort</option>
                </select>
              </div>

              <div class="toolbar-actions">
                <button id="sort-run" class="button primary">Run algorithm</button>
                <button id="sort-shuffle" class="button">Shuffle</button>
              </div>

              <div class="speed-control">
                <label for="sort-speed">Speed</label>
                <input id="sort-speed" type="range" min="1" max="100" value="65" />
              </div>
            </div>

            <div id="sort-info" class="algo-info">
              <div class="algo-info-head">
                <strong id="sort-algo-name">Quick Sort</strong>
                <span id="sort-algo-complexity">O(n log n) avg · O(n²) worst</span>
              </div>
              <p id="sort-algo-desc">
                Picks a pivot, partitions the array so smaller values land
                left and larger values land right, then repeats on each side.
              </p>
            </div>

            <div class="visual-stage sorting-stage">
              <div id="sort-stage" class="bars" aria-label="Sorting visualization"></div>
            </div>

            <div id="sort-narration" class="formula">
              Ready — press Run to sort 42 bars with Quick Sort.
            </div>

            <div class="metrics">
              <div><span>Comparisons</span><strong id="sort-comparisons">0</strong></div>
              <div><span>Swaps</span><strong id="sort-swaps">0</strong></div>
              <div><span>Status</span><strong id="sort-status">Ready</strong></div>
            </div>

            <div class="legend">
              <span><i class="legend-dot compare"></i>Comparing</span>
              <span><i class="legend-dot swap"></i>Swapping</span>
              <span><i class="legend-dot sorted"></i>Sorted</span>
            </div>
          </div>
        </section>

        <section class="demo-section" id="hash-table">
          <div class="section-heading">
            <div class="section-number">02</div>

            <div>
              <div class="section-label">HASH TABLE</div>
              <h2>See collision resolution.</h2>
              <p>
                Insert key-value pairs into an eight-bucket hash table and
                watch separate chaining resolve collisions.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar hash-toolbar">
              <div class="control-group">
                <label for="hash-key">Key</label>
                <input id="hash-key" class="text-input" type="text" placeholder="user" maxlength="16" />
              </div>

              <div class="control-group">
                <label for="hash-value">Value</label>
                <input id="hash-value" class="text-input" type="text" placeholder="Aymane" maxlength="16" />
              </div>

              <div class="toolbar-actions">
                <button id="hash-insert" class="button primary">Insert</button>
                <button id="hash-random" class="button">Random</button>
                <button id="hash-clear" class="button">Clear</button>
              </div>
            </div>

            <div id="hash-formula" class="formula">Ready for insertion.</div>

            <div id="hash-buckets" class="hash-grid" aria-label="Hash table buckets"></div>

            <div class="hash-footer">
              <span>Load factor</span>
              <strong id="hash-load">0.00</strong>
            </div>
          </div>
        </section>

        <section class="demo-section" id="pathfinding">
          <div class="section-heading">
            <div class="section-number">03</div>

            <div>
              <div class="section-label">PATHFINDING</div>
              <h2>Find the shortest path.</h2>
              <p>
                Draw walls on the grid and compare BFS, Dijkstra, and A*
                while watching the search happen cell by cell.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar">
              <div class="control-group">
                <label for="path-algo">Algorithm</label>
                <select id="path-algo">
                  <option value="bfs">Breadth-First Search</option>
                  <option value="dijkstra">Dijkstra</option>
                  <option value="astar" selected>A*</option>
                </select>
              </div>

              <div class="toolbar-actions">
                <button id="path-run" class="button primary">Find path</button>
                <button id="path-walls" class="button">Random walls</button>
                <button id="path-clear" class="button">Clear</button>
              </div>

              <div class="path-help">Click / drag to draw walls</div>
            </div>

            <div class="visual-stage path-stage">
              <div id="path-grid" class="path-grid" aria-label="Pathfinding grid"></div>
            </div>

            <div class="metrics">
              <div><span>Visited</span><strong id="path-visited">0</strong></div>
              <div><span>Path length</span><strong id="path-length">—</strong></div>
              <div><span>Status</span><strong id="path-status">Ready</strong></div>
            </div>

            <div class="legend">
              <span><i class="legend-dot start"></i>Start</span>
              <span><i class="legend-dot wall"></i>Wall</span>
              <span><i class="legend-dot visited"></i>Visited</span>
              <span><i class="legend-dot path"></i>Shortest path</span>
            </div>
          </div>
        </section>

        <section class="documentation" id="reference">
          <div class="section-heading">
            <div class="section-number">04</div>

            <div>
              <div class="section-label">REFERENCE</div>
              <h2>How each algorithm actually works.</h2>
              <p>
                The visualizations above show <em>that</em> something happens.
                This is the <em>why</em> — the concept behind each algorithm,
                spelled out in plain terms.
              </p>
            </div>
          </div>

          <div class="doc-group">
            <div class="doc-group-title">
              <span>01</span>
              Sorting algorithms
            </div>

            <details class="doc-item" open>
              <summary>
                <span class="doc-item-name">Big-O notation</span>
                <span class="badge">concept</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Big-O describes how an algorithm's running time grows as the
                  input gets bigger — not the exact number of steps, but the
                  <em>shape</em> of the growth curve. <code>O(n²)</code> means
                  doubling the input roughly quadruples the work;
                  <code>O(n log n)</code> means doubling the input barely
                  more than doubles it.
                </p>
                <p>
                  It matters at scale, not on 42 bars: sorting 42 items,
                  bubble sort's worst case is around 861 comparisons and
                  quick sort's average case is around 227. Sort 42,000 items
                  instead and that gap stops being academic — bubble sort's
                  <code>n²</code> term dominates completely.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Bubble Sort</span>
                <span class="badge">O(n²)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Walks the array left to right, comparing each pair of
                  neighbors and swapping them if they're out of order. One
                  full pass guarantees the largest remaining value "bubbles"
                  to its correct position at the end — so after
                  <code>k</code> passes, the last <code>k</code> items are
                  guaranteed sorted.
                </p>
                <ol class="doc-steps">
                  <li>Compare each adjacent pair, left to right.</li>
                  <li>Swap the pair if the left value is bigger.</li>
                  <li>Repeat passes until a full pass makes no swaps.</li>
                </ol>
                <p class="doc-meta">
                  Stable · in-place · rarely used outside teaching, but the
                  easiest algorithm to trace by hand.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Selection Sort</span>
                <span class="badge">O(n²)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Splits the array into a sorted section (front) and an
                  unsorted section (back). On each pass it scans the entire
                  unsorted section to find the smallest value, then swaps it
                  into the next open slot at the front.
                </p>
                <ol class="doc-steps">
                  <li>Assume the first unsorted item is the minimum.</li>
                  <li>Scan the rest, updating the minimum when a smaller value appears.</li>
                  <li>Swap the true minimum into place, then move the boundary forward.</li>
                </ol>
                <p class="doc-meta">
                  Not stable · in-place · always exactly one swap per pass,
                  which makes it cheap on writes even though comparisons
                  stay <code>O(n²)</code>.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Insertion Sort</span>
                <span class="badge">O(n²)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Builds a sorted section one value at a time. Each new value
                  is compared against its sorted neighbors and shifted left
                  until it lands in the correct spot — the same motion as
                  sorting a hand of playing cards.
                </p>
                <ol class="doc-steps">
                  <li>Take the next unsorted value.</li>
                  <li>Shift it left past every sorted value bigger than it.</li>
                  <li>Drop it into the gap that's left behind.</li>
                </ol>
                <p class="doc-meta">
                  Stable · in-place · <code>O(n)</code> best case on nearly-sorted
                  data, which is why it's often used to finish off other
                  algorithms on small sub-arrays.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Merge Sort</span>
                <span class="badge">O(n log n)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  A divide-and-conquer algorithm: split the array in half
                  recursively until each piece has one item (trivially
                  sorted), then merge pairs of sorted pieces back together by
                  repeatedly taking the smaller of the two fronts.
                </p>
                <ol class="doc-steps">
                  <li>Split the array in half, recursively, down to single items.</li>
                  <li>Merge each pair of halves, always taking the smaller front value.</li>
                  <li>Repeat merging upward until one sorted array remains.</li>
                </ol>
                <p class="doc-meta">
                  Stable · <strong>not</strong> in-place (needs <code>O(n)</code>
                  extra space for the merge step) · guaranteed
                  <code>O(n log n)</code> — no worst-case cliff like quick sort.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Quick Sort</span>
                <span class="badge">O(n log n) avg</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Also divide-and-conquer, but it partitions instead of
                  merging: pick a pivot value, rearrange the array so
                  everything smaller ends up left of it and everything
                  bigger ends up right, then recurse on each side.
                </p>
                <ol class="doc-steps">
                  <li>Choose a pivot — this demo uses the last element.</li>
                  <li>Walk the array, moving anything smaller than the pivot to the left side.</li>
                  <li>Drop the pivot into the boundary between the two sides.</li>
                  <li>Recurse into the left and right partitions independently.</li>
                </ol>
                <p class="doc-meta">
                  Not stable · in-place · fast in practice despite an
                  <code>O(n²)</code> worst case, because that worst case
                  (already-sorted input with a bad pivot choice) is rare.
                </p>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title">
              <span>02</span>
              Hash tables
            </div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Hash functions</span>
                <span class="badge">concept</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  A hash function takes a key of any size — a string, a
                  number, anything — and deterministically maps it to a
                  fixed-size number: the bucket index. The demo above walks
                  each character's code through <code>hash = hash × 31 +
                  charCode</code>, then takes the result modulo 8 so it
                  always lands inside the eight buckets.
                </p>
                <p>
                  A good hash function spreads keys evenly across buckets
                  and is fast to compute. It does <em>not</em> need to be
                  reversible — you can't recover the key from the bucket
                  index alone.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Collisions &amp; chaining</span>
                <span class="badge">O(1) avg</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Two different keys can hash to the same bucket — that's a
                  collision, and it's expected, not a bug. This table
                  resolves it with <strong>separate chaining</strong>: each
                  bucket holds a small list, and colliding keys simply get
                  appended to that bucket's chain instead of overwriting
                  each other.
                </p>
                <p>
                  Lookups still work because inserting <em>and</em> searching
                  use the same hash function — to find a key you hash it,
                  jump straight to its bucket, then scan that bucket's
                  (usually short) chain for a match.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Load factor</span>
                <span class="badge">concept</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Load factor is <code>entries ÷ buckets</code> — shown live
                  at the bottom of the table above. As it climbs past
                  roughly <code>0.7</code>, chains get longer and lookups
                  degrade from an average <code>O(1)</code> toward
                  <code>O(n)</code> in the worst case.
                </p>
                <p>
                  Real hash table implementations watch this number and
                  automatically <em>resize</em> — allocate a bigger bucket
                  array and rehash every existing key into it — once the
                  load factor crosses a threshold. This demo skips resizing
                  to keep the eight buckets visible.
                </p>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title">
              <span>03</span>
              Pathfinding
            </div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Graphs, nodes &amp; edges</span>
                <span class="badge">concept</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  The grid above is a graph in disguise: every open cell is
                  a <strong>node</strong>, and every pair of adjacent
                  open cells is connected by an <strong>edge</strong>.
                  Walls simply remove a node from the graph entirely — no
                  edges connect to it, so no search can pass through.
                </p>
                <p>
                  Every edge here has the same weight (one step), which is
                  what makes BFS behave identically to Dijkstra on this
                  particular grid. Give the edges different costs — uneven
                  terrain, diagonal moves — and BFS would stop guaranteeing
                  the shortest path while Dijkstra still would.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Breadth-First Search</span>
                <span class="badge">O(V + E)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Explores the grid in rings, one step out at a time: visit
                  every neighbor of the start, then every neighbor of
                  those, and so on. Because it expands outward evenly, the
                  first time it reaches the end cell is guaranteed to be by
                  the shortest possible path — as long as every step costs
                  the same.
                </p>
                <p>
                  Implemented with a queue (first in, first out): each cell
                  gets visited once, its unvisited neighbors get added to
                  the back of the queue, and the search always processes
                  the oldest queued cell next.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Dijkstra's algorithm</span>
                <span class="badge">O((V+E) log V)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Generalizes BFS to handle edges with different costs. It
                  always expands the unvisited cell with the
                  <strong>lowest total distance from the start</strong> so
                  far, and updates a neighbor's distance whenever a shorter
                  route to it is found. On this grid, where every step
                  costs exactly one, it visits cells in the same order as
                  BFS.
                </p>
                <p>
                  The "priority" in priority queue is doing the real work
                  here — it's the mechanism that always pulls out the
                  currently-cheapest cell to expand next.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">A* search</span>
                <span class="badge">O((V+E) log V)</span>
                <span class="doc-item-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-item-body">
                <p>
                  Dijkstra plus a hint: it prioritizes cells by <code>cost
                  so far + estimated cost to the goal</code>, using a
                  heuristic (this demo uses Manhattan distance — horizontal
                  steps plus vertical steps to the end). That estimate
                  biases the search to expand toward the goal instead of
                  spreading out equally in every direction.
                </p>
                <p>
                  Watch the visited-cell count: A* typically explores far
                  fewer cells than BFS or Dijkstra to find the same
                  shortest path, because it isn't wasting time exploring
                  away from the destination.
                </p>
              </div>
            </details>
          </div>
        </section>

        <footer class="page-footer">
          <span>ALGORITHM VISUALIZER</span>
          <a href="/projects">← Projects</a>
        </footer>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  html {
    scroll-behavior: smooth;
  }

  .algorithm-page {
    /* -- Token system ------------------------------------------------ */
    --bg: #0a0c07;
    --bg-elev: #0f1209;
    --ink: #eef0e2;
    --ink-dim: rgba(238, 240, 226, 0.5);
    --ink-faint: rgba(238, 240, 226, 0.26);
    --olive: #8f9c5c;
    --olive-bright: #c3d68f;
    --olive-deep: #5b6b34;
    --olive-line: rgba(143, 156, 92, 0.16);
    --olive-line-strong: rgba(143, 156, 92, 0.32);
    --olive-wash: rgba(143, 156, 92, 0.08);
    --gold: #d9a94a;
    --rust: #b5563a;

    --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    position: relative;
    min-height: 100vh;
    overflow-x: hidden;

    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
  }

  .ascii-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.9;
    mask-image: radial-gradient(ellipse 80% 60% at 30% 0%, black, transparent 85%);
  }

  .shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* -- Sidebar --------------------------------------------------------- */

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;

    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--olive-line);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;

    color: var(--ink-dim);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;

    transition: color 200ms ease, transform 200ms ease;
  }

  .back-link:hover {
    color: var(--olive-bright);
    transform: translateX(-3px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--olive-bright);
    box-shadow: 0 0 0 4px var(--olive-wash), 0 0 16px rgba(195, 214, 143, 0.55);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .brand-cursor {
    color: var(--olive-bright);
    animation: blink 1.1s step-end infinite;
  }

  .brand-sub {
    margin-top: -1.4rem;
    color: var(--ink-faint);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  .doc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .doc-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    padding: 0.55rem 0.6rem;
    border-radius: 6px;

    color: var(--ink-dim);
    font-size: 0.76rem;
    text-decoration: none;

    transition: color 180ms ease, background 180ms ease;
  }

  .doc-nav a span:first-child {
    color: var(--olive);
    font-size: 0.66rem;
  }

  .doc-nav a:hover {
    color: var(--ink);
    background: var(--olive-wash);
  }

