---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Algorithm Visualizer">
  <main class="algorithm-page">
    <canvas id="ascii-bg" class="ascii-bg" aria-hidden="true"></canvas>

    <div class="shell">
      <aside class="sidebar">
        <a href="/projects" class="back-link">
          <span>←</span>
          <span>Back to projects</span>
        </a>

        <div class="brand">
          <span class="brand-dot"></span>
          <span class="brand-name">algorithm<span class="brand-cursor">_</span></span>
        </div>
        <div class="brand-sub">visualizer / interactive reference</div>

        <nav class="doc-nav" aria-label="Sections">
          <a href="#overview"><span>00</span>Overview</a>
          <a href="#sorting"><span>01</span>Sorting</a>
          <a href="#hash-table"><span>02</span>Hash table</a>
          <a href="#pathfinding"><span>03</span>Pathfinding</a>
          <a href="#reference"><span>04</span>Reference</a>
        </nav>

        <div class="sidebar-foot">
          <div class="tech-row">
            <span>ASTRO</span>
            <span>TYPESCRIPT</span>
            <span>CANVAS</span>
          </div>
        </div>
      </aside>

      <div class="content">
        <header class="hero" id="overview">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>PROJECT 04</span>
            <span class="separator">/</span>
            <span>COMPUTER SCIENCE</span>
          </div>

          <h1>
            Algorithms,
            <span>rendered live.</span>
          </h1>

          <p class="hero-description">
            Three interactive references for how classic algorithms actually
            move through data — sorting, hashing, and pathfinding, executed
            step by step in the browser rather than narrated over a static
            diagram.
          </p>

          <div class="hero-key">
            <span><i class="key-dot compare"></i>comparing</span>
            <span><i class="key-dot swap"></i>writing</span>
            <span><i class="key-dot sorted"></i>settled</span>
          </div>
        </header>

        <section class="demo-section" id="sorting">
          <div class="section-heading">
            <div class="section-number">01</div>

            <div>
              <div class="section-label">SORTING ALGORITHMS</div>
              <h2>Watch algorithms sort data.</h2>
              <p>
                Compare five classic sorting algorithms and observe their
                comparisons and writes in real time.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar">
              <div class="control-group">
                <label for="sort-algo">Algorithm</label>
                <select id="sort-algo">
                  <option value="bubble">Bubble Sort</option>
                  <option value="selection">Selection Sort</option>
                  <option value="insertion">Insertion Sort</option>
                  <option value="merge">Merge Sort</option>
                  <option value="quick" selected>Quick Sort</option>
                </select>
              </div>

              <div class="toolbar-actions">
                <button id="sort-run" class="button primary">Run algorithm</button>
                <button id="sort-shuffle" class="button">Shuffle</button>
              </div>

              <div class="speed-control">
                <label for="sort-speed">Speed</label>
                <input id="sort-speed" type="range" min="1" max="100" value="65" />
              </div>
            </div>

            <div class="visual-stage sorting-stage">
              <div id="sort-stage" class="bars" aria-label="Sorting visualization"></div>
            </div>

            <div class="metrics">
              <div><span>Comparisons</span><strong id="sort-comparisons">0</strong></div>
              <div><span>Swaps</span><strong id="sort-swaps">0</strong></div>
              <div><span>Status</span><strong id="sort-status">Ready</strong></div>
            </div>

            <div class="legend">
              <span><i class="legend-dot compare"></i>Comparing</span>
              <span><i class="legend-dot swap"></i>Swapping</span>
              <span><i class="legend-dot sorted"></i>Sorted</span>
            </div>
          </div>
        </section>

        <section class="demo-section" id="hash-table">
          <div class="section-heading">
            <div class="section-number">02</div>

            <div>
              <div class="section-label">HASH TABLE</div>
              <h2>See collision resolution.</h2>
              <p>
                Insert key-value pairs into an eight-bucket hash table and
                watch separate chaining resolve collisions.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar hash-toolbar">
              <div class="control-group">
                <label for="hash-key">Key</label>
                <input id="hash-key" class="text-input" type="text" placeholder="user" maxlength="16" />
              </div>

              <div class="control-group">
                <label for="hash-value">Value</label>
                <input id="hash-value" class="text-input" type="text" placeholder="Aymane" maxlength="16" />
              </div>

              <div class="toolbar-actions">
                <button id="hash-insert" class="button primary">Insert</button>
                <button id="hash-random" class="button">Random</button>
                <button id="hash-clear" class="button">Clear</button>
              </div>
            </div>

            <div id="hash-formula" class="formula">Ready for insertion.</div>

            <div id="hash-buckets" class="hash-grid" aria-label="Hash table buckets"></div>

            <div class="hash-footer">
              <span>Load factor</span>
              <strong id="hash-load">0.00</strong>
            </div>
          </div>
        </section>

        <section class="demo-section" id="pathfinding">
          <div class="section-heading">
            <div class="section-number">03</div>

            <div>
              <div class="section-label">PATHFINDING</div>
              <h2>Find the shortest path.</h2>
              <p>
                Draw walls on the grid and compare BFS, Dijkstra, and A*
                while watching the search happen cell by cell.
              </p>
            </div>
          </div>

          <div class="demo-card">
            <div class="demo-toolbar">
              <div class="control-group">
                <label for="path-algo">Algorithm</label>
                <select id="path-algo">
                  <option value="bfs">Breadth-First Search</option>
                  <option value="dijkstra">Dijkstra</option>
                  <option value="astar" selected>A*</option>
                </select>
              </div>

              <div class="toolbar-actions">
                <button id="path-run" class="button primary">Find path</button>
                <button id="path-walls" class="button">Random walls</button>
                <button id="path-clear" class="button">Clear</button>
              </div>

              <div class="path-help">Click / drag to draw walls</div>
            </div>

            <div class="visual-stage path-stage">
              <div id="path-grid" class="path-grid" aria-label="Pathfinding grid"></div>
            </div>

            <div class="metrics">
              <div><span>Visited</span><strong id="path-visited">0</strong></div>
              <div><span>Path length</span><strong id="path-length">—</strong></div>
              <div><span>Status</span><strong id="path-status">Ready</strong></div>
            </div>

            <div class="legend">
              <span><i class="legend-dot start"></i>Start</span>
              <span><i class="legend-dot wall"></i>Wall</span>
              <span><i class="legend-dot visited"></i>Visited</span>
              <span><i class="legend-dot path"></i>Shortest path</span>
            </div>
          </div>
        </section>

        <section class="documentation" id="reference">
          <div class="section-heading">
            <div class="section-number">04</div>

            <div>
              <div class="section-label">REFERENCE</div>
              <h2>Built as an interactive reference.</h2>
              <p>
                Each visualization exposes the underlying algorithm rather
                than hiding it behind a static animation.
              </p>
            </div>
          </div>

          <div class="documentation-grid">
            <article>
              <span>01</span>
              <h3>Sorting</h3>
              <p>Bubble, selection, insertion, merge, and quick sort with live comparison and swap counters.</p>
            </article>

            <article>
              <span>02</span>
              <h3>Hashing</h3>
              <p>A simple hash function demonstrates bucket selection and separate chaining.</p>
            </article>

            <article>
              <span>03</span>
              <h3>Pathfinding</h3>
              <p>BFS, Dijkstra, and A* explore the same weighted-free grid using different search strategies.</p>
            </article>

            <article>
              <span>04</span>
              <h3>Client-side</h3>
              <p>Everything runs directly in the browser using TypeScript, DOM APIs, and Canvas.</p>
            </article>
          </div>
        </section>

        <footer class="page-footer">
          <span>ALGORITHM VISUALIZER</span>
          <a href="/projects">← Projects</a>
        </footer>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  html {
    scroll-behavior: smooth;
  }

  .algorithm-page {
    /* -- Token system ------------------------------------------------ */
    --bg: #0a0c07;
    --bg-elev: #0f1209;
    --ink: #eef0e2;
    --ink-dim: rgba(238, 240, 226, 0.5);
    --ink-faint: rgba(238, 240, 226, 0.26);
    --olive: #8f9c5c;
    --olive-bright: #c3d68f;
    --olive-deep: #5b6b34;
    --olive-line: rgba(143, 156, 92, 0.16);
    --olive-line-strong: rgba(143, 156, 92, 0.32);
    --olive-wash: rgba(143, 156, 92, 0.08);
    --gold: #d9a94a;
    --rust: #b5563a;

    --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    position: relative;
    min-height: 100vh;
    overflow-x: hidden;

    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
  }

  .ascii-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.9;
    mask-image: radial-gradient(ellipse 80% 60% at 30% 0%, black, transparent 85%);
  }

  .shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* -- Sidebar --------------------------------------------------------- */

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;

    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--olive-line);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;

    color: var(--ink-dim);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;

    transition: color 200ms ease, transform 200ms ease;
  }

  .back-link:hover {
    color: var(--olive-bright);
    transform: translateX(-3px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--olive-bright);
    box-shadow: 0 0 0 4px var(--olive-wash), 0 0 16px rgba(195, 214, 143, 0.55);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .brand-cursor {
    color: var(--olive-bright);
    animation: blink 1.1s step-end infinite;
  }

  .brand-sub {
    margin-top: -1.4rem;
    color: var(--ink-faint);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  .doc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .doc-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    padding: 0.55rem 0.6rem;
    border-radius: 6px;

    color: var(--ink-dim);
    font-size: 0.76rem;
    text-decoration: none;

    transition: color 180ms ease, background 180ms ease;
  }

  .doc-nav a span:first-child {
    color: var(--olive);
    font-size: 0.66rem;
  }

  .doc-nav a:hover {
    color: var(--ink);
    background: var(--olive-wash);
  }

  .sidebar-foot {
    margin-top: auto;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-row span {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 999px;

    color: var(--ink-faint);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    background: var(--olive-wash);
  }

  /* -- Content ----------------------------------------------------------- */

  .content {
    width: min(920px, calc(100% - 32px));
    margin: 0 auto;
    padding: 3.5rem 0 4rem;
  }

  .hero {
    max-width: 760px;
    margin-bottom: 4.5rem;
    scroll-margin-top: 2rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.4rem;

    color: var(--ink-faint);
    font-size: 0.67rem;
    letter-spacing: 0.14em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--olive-bright);
    box-shadow: 0 0 0 4px var(--olive-wash), 0 0 18px rgba(195, 214, 143, 0.6);
  }

  .separator {
    opacity: 0.3;
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.6vw, 5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .hero h1 span {
    display: block;
    background: linear-gradient(100deg, var(--ink) 0%, var(--ink) 40%, var(--olive-bright) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 620px;
    margin: 1.8rem 0 0;
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.8;
  }

  .hero-key {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 1.8rem;

    color: var(--ink-faint);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .hero-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .key-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    display: inline-block;
  }

  .key-dot.compare { background: var(--olive-bright); }
  .key-dot.swap { background: var(--gold); }
  .key-dot.sorted { background: var(--olive-deep); }

  .demo-section,
  .documentation {
    margin-bottom: 6rem;
    scroll-margin-top: 2rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  .section-number {
    padding-top: 0.25rem;
    color: var(--olive);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .section-label {
    margin-bottom: 0.6rem;
    color: var(--olive-bright);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    color: var(--ink);
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section-heading p {
    max-width: 620px;
    margin: 0.7rem 0 0;
    color: var(--ink-faint);
    line-height: 1.7;
    font-size: 0.86rem;
  }

  .demo-card {
    overflow: hidden;
    border: 1px solid var(--olive-line-strong);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--bg-elev), var(--bg));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02), 0 25px 70px rgba(0, 0, 0, 0.35);
  }

  .demo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.8rem;

    padding: 1.1rem;
    border-bottom: 1px solid var(--olive-line);
    background: rgba(0, 0, 0, 0.2);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .control-group label,
  .speed-control label {
    color: var(--ink-faint);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  select,
  .text-input {
    min-height: 36px;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 7px;
    outline: none;

    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;

    background: #0c0e08;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  select:focus,
  .text-input:focus {
    border-color: var(--olive-bright);
    box-shadow: 0 0 0 3px var(--olive-wash);
  }

  select option {
    background: #0c0e08;
  }

  .text-input {
    width: 120px;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.5rem;
  }

  .button {
    min-height: 36px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 7px;

    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;

    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;

    transition: color 200ms ease, border-color 200ms ease, background 200ms ease, transform 200ms ease;
  }

  .button:hover {
    color: var(--ink);
    border-color: var(--olive-bright);
    background: var(--olive-wash);
    transform: translateY(-1px);
  }

  .button.primary {
    color: var(--olive-bright);
    border-color: var(--olive-bright);
    background: var(--olive-wash);
  }

  .button.primary:hover {
    background: rgba(195, 214, 143, 0.16);
  }

  .button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .speed-control {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-left: auto;
  }

  .speed-control input {
    width: 110px;
    accent-color: var(--olive-bright);
  }

  .visual-stage {
    position: relative;
    padding: 1rem;
  }

  .sorting-stage {
    height: 300px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;

    width: 100%;
    height: 100%;
    padding: 1rem;

    border: 1px solid var(--olive-line);
    border-radius: 10px;
    background: linear-gradient(180deg, rgba(143, 156, 92, 0.03), transparent 60%), rgba(0, 0, 0, 0.22);
  }

  .viz-bar {
    flex: 1;
    min-width: 2px;
    border-radius: 2px 2px 0 0;
    background: rgba(238, 240, 226, 0.2);
    transition: height 50ms linear, background 100ms ease;
  }

  .viz-bar.compare {
    background: var(--olive-bright);
    box-shadow: 0 0 12px rgba(195, 214, 143, 0.4);
  }

  .viz-bar.swap {
    background: var(--gold);
    box-shadow: 0 0 12px rgba(217, 169, 74, 0.4);
  }

  .viz-bar.sorted {
    background: var(--olive-deep);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--olive-line);
  }

  .metrics > div {
    min-width: 130px;
    padding: 0.9rem 1.1rem;
    border-right: 1px solid var(--olive-line);
  }

  .metrics span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink-faint);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .metrics strong {
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.62rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    display: inline-block;
  }

  .legend-dot.compare { background: var(--olive-bright); }
  .legend-dot.swap { background: var(--gold); }
  .legend-dot.sorted { background: var(--olive-deep); }
  .legend-dot.start { background: var(--olive-bright); }
  .legend-dot.wall { background: rgba(238, 240, 226, 0.3); }
  .legend-dot.visited { background: rgba(143, 156, 92, 0.5); }
  .legend-dot.path { background: var(--gold); }

  .formula {
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: 0.75rem 1.1rem;

    color: var(--olive-bright);
    border-bottom: 1px solid var(--olive-line);
    font-size: 0.65rem;
    background: var(--olive-wash);
  }

  .hash-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 1rem;
  }

  .hash-bucket {
    min-height: 118px;
    padding: 0.7rem;
    border: 1px solid var(--olive-line);
    border-radius: 9px;
    background: rgba(0, 0, 0, 0.22);
  }

  .hash-index {
    color: var(--ink-faint);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .hash-chain {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .hash-node {
    padding: 0.45rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 6px;

    color: var(--ink-dim);
    font-size: 0.65rem;
    background: var(--olive-wash);

    animation: node-in 180ms ease;
  }

  .hash-node.collision {
    border-color: rgba(217, 169, 74, 0.4);
    background: rgba(217, 169, 74, 0.06);
  }

  .hash-arrow {
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.7rem;
  }

  .hash-footer {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.65rem;
  }

  .hash-footer strong {
    color: var(--olive-bright);
    font-weight: 500;
  }

  .path-stage {
    overflow: auto;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(28, minmax(12px, 1fr));
    gap: 2px;

    min-width: 620px;
    padding: 0.75rem;

    border: 1px solid var(--olive-line);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
  }

  .path-cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: rgba(238, 240, 226, 0.03);
    cursor: crosshair;
    transition: background 90ms ease;
  }

  .path-cell:hover {
    background: rgba(238, 240, 226, 0.1);
  }

  .path-cell.wall {
    background: rgba(238, 240, 226, 0.26);
  }

  .path-cell.start {
    background: var(--olive-bright);
    box-shadow: 0 0 14px rgba(195, 214, 143, 0.45);
  }

  .path-cell.end {
    background: var(--rust);
    box-shadow: 0 0 14px rgba(181, 86, 58, 0.4);
  }

  .path-cell.visited {
    background: rgba(143, 156, 92, 0.45);
    animation: visited-in 120ms ease;
  }

  .path-cell.path {
    background: var(--gold);
    box-shadow: 0 0 10px rgba(217, 169, 74, 0.3);
  }

  .path-help {
    margin-left: auto;
    align-self: center;
    color: var(--ink-faint);
    font-size: 0.6rem;
  }

  .documentation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;

    overflow: hidden;
    border: 1px solid var(--olive-line-strong);
    border-radius: 14px;
    background: var(--olive-line);
  }

  .documentation-grid article {
    min-height: 180px;
    padding: 1.4rem;
    background: var(--bg-elev);
    transition: background 250ms ease;
  }

  .documentation-grid article:hover {
    background: #131608;
  }

  .documentation-grid article > span {
    color: var(--olive-bright);
    font-size: 0.62rem;
  }

  .documentation-grid h3 {
    margin: 2.6rem 0 0.55rem;
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 600;
  }

  .documentation-grid p {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .page-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 1.8rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .page-footer a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .page-footer a:hover {
    color: var(--olive-bright);
  }

  @keyframes node-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes visited-in {
    from { opacity: 0.1; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (min-width: 980px) {
    .shell {
      flex-direction: row;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      width: 250px;
      flex: 0 0 250px;
      border-bottom: none;
      border-right: 1px solid var(--olive-line);
    }

    .content {
      width: min(820px, calc(100% - 64px));
      margin: 0 auto;
      padding: 4.5rem 0 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hash-grid {
      grid-template-columns: 1fr;
    }

    .demo-toolbar {
      align-items: stretch;
    }

    .toolbar-actions {
      width: 100%;
    }

    .toolbar-actions .button {
      flex: 1;
    }

    .text-input {
      width: 100%;
    }

    .control-group {
      width: 100%;
    }

    .control-group select {
      width: 100%;
    }

    .sorting-stage {
      height: 230px;
    }

    .documentation-grid {
      grid-template-columns: 1fr;
    }

    .speed-control {
      margin-left: 0;
    }
  }
</style>

<script>
  const sleep = (ms: number): Promise<void> =>
    new Promise((resolve) => setTimeout(resolve, ms));

  /* ================================================================
     ASCII / LIQUID BACKGROUND — olive-green signature effect
     ================================================================ */

  (() => {
    const canvas = document.getElementById("ascii-bg");

    if (!(canvas instanceof HTMLCanvasElement)) {
      return;
    }

    const ctx = canvas.getContext("2d");

    if (!ctx) {
      return;
    }

    // Re-bind to new consts: TS narrows `canvas`/`ctx` to non-null only
    // within this scope, and that narrowing does not carry into nested
    // function declarations below (resize/draw). Capturing the already-
    // narrowed values here keeps the compiler happy without `!` asserts.
    const canvasElement = canvas;
    const context = ctx;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const ramp = " .:-=+*#%@";
    const cell = 15;

    let cols = 0;
    let rows = 0;
    let time = 0;
    let frame = 0;

    function resize(): void {
      canvasElement.width = window.innerWidth;
      canvasElement.height = window.innerHeight;
      cols = Math.ceil(canvasElement.width / cell) + 1;
      rows = Math.ceil(canvasElement.height / cell) + 1;
    }

    function flow(x: number, y: number, t: number): number {
      const value =
        Math.sin(x * 0.16 + t) * 0.5 +
        Math.sin(y * 0.13 - t * 0.8) * 0.5 +
        Math.sin((x + y) * 0.09 + t * 1.3) * 0.4 +
        Math.sin(Math.sqrt(x * x + y * y) * 0.11 - t * 1.1) * 0.35;

      return value / 1.75;
    }

    function draw(): void {
      context.clearRect(0, 0, canvasElement.width, canvasElement.height);
      context.font = `${cell}px "JetBrains Mono", monospace`;
      context.textBaseline = "top";

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const n = flow(col, row, time);
          const level = Math.max(0, Math.min(1, (n + 1) / 2));

          if (level < 0.32) {
            continue;
          }

          const char = ramp[Math.floor(level * (ramp.length - 1))];
          const alpha = 0.03 + level * 0.15;

          context.fillStyle = `rgba(143, 156, 92, ${alpha.toFixed(3)})`;
          context.fillText(char, col * cell, row * cell);
        }
      }

      time += 0.014;
      frame = requestAnimationFrame(draw);
    }

    window.addEventListener("resize", resize);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && frame) {
        cancelAnimationFrame(frame);
      } else if (!document.hidden && !reduceMotion) {
        frame = requestAnimationFrame(draw);
      }
    });

    resize();

    if (reduceMotion) {
      draw();
      cancelAnimationFrame(frame);
    } else {
      draw();
    }
  })();

  /* ================================================================
     SORTING VISUALIZER
     ================================================================ */

  (() => {
    const stageElement = document.getElementById("sort-stage");
    const algorithmElement = document.getElementById("sort-algo");
    const runButtonElement = document.getElementById("sort-run");
    const shuffleButtonElement =
      document.getElementById("sort-shuffle");
    const speedElement = document.getElementById("sort-speed");
    const comparisonsElement =
      document.getElementById("sort-comparisons");
    const swapsElement = document.getElementById("sort-swaps");
    const statusElement = document.getElementById("sort-status");

    if (
      !(stageElement instanceof HTMLDivElement) ||
      !(algorithmElement instanceof HTMLSelectElement) ||
      !(runButtonElement instanceof HTMLButtonElement) ||
      !(shuffleButtonElement instanceof HTMLButtonElement) ||
      !(speedElement instanceof HTMLInputElement) ||
      !(comparisonsElement instanceof HTMLElement) ||
      !(swapsElement instanceof HTMLElement) ||
      !(statusElement instanceof HTMLElement)
    ) {
      return;
    }

    const stage = stageElement;
    const algorithm = algorithmElement;
    const runButton = runButtonElement;
    const shuffleButton = shuffleButtonElement;
    const speed = speedElement;
    const comparisonsOutput = comparisonsElement;
    const swapsOutput = swapsElement;
    const statusOutput = statusElement;

    const COUNT = 42;

    let values: number[] = [];
    let bars: HTMLDivElement[] = [];
    let running = false;

    let comparisons = 0;
    let swaps = 0;

    const delay = (): number =>
      Math.max(8, 220 - Number(speed.value) * 2);

    function createArray(): void {
      values = Array.from(
        { length: COUNT },
        () => Math.floor(Math.random() * 88) + 8
      );
    }

    function render(): void {
      stage.innerHTML = "";

      bars = values.map((value) => {
        const bar = document.createElement("div");

        bar.className = "viz-bar";
        bar.style.height = `${value}%`;

        stage.appendChild(bar);

        return bar;
      });
    }

    function updateMetrics(): void {
      comparisonsOutput.textContent = String(comparisons);
      swapsOutput.textContent = String(swaps);
    }

    function clearMarks(): void {
      bars.forEach((bar) => {
        bar.classList.remove("compare", "swap");
      });
    }

    function updateBar(index: number): void {
      const bar = bars[index];

      if (bar) {
        bar.style.height = `${values[index]}%`;
      }
    }

    async function highlight(
      indices: number[],
      className: "compare" | "swap"
    ): Promise<void> {
      clearMarks();

      indices.forEach((index) => {
        bars[index]?.classList.add(className);
      });

      await sleep(delay());
    }

    async function bubbleSort(): Promise<void> {
      for (let i = 0; i < values.length - 1; i++) {
        let changed = false;

        for (let j = 0; j < values.length - i - 1; j++) {
          comparisons++;
          updateMetrics();

          await highlight([j, j + 1], "compare");

          if (values[j] > values[j + 1]) {
            [values[j], values[j + 1]] = [
              values[j + 1],
              values[j],
            ];

            swaps++;
            changed = true;

            updateBar(j);
            updateBar(j + 1);
            updateMetrics();

            await highlight([j, j + 1], "swap");
          }
        }

        bars[values.length - i - 1]?.classList.add("sorted");

        if (!changed) {
          break;
        }
      }
    }

    async function selectionSort(): Promise<void> {
      for (let i = 0; i < values.length; i++) {
        let minimum = i;

        for (let j = i + 1; j < values.length; j++) {
          comparisons++;
          updateMetrics();

          await highlight([minimum, j], "compare");

          if (values[j] < values[minimum]) {
            minimum = j;
          }
        }

        if (minimum !== i) {
          [values[i], values[minimum]] = [
            values[minimum],
            values[i],
          ];

          swaps++;

          updateBar(i);
          updateBar(minimum);
          updateMetrics();

          await highlight([i, minimum], "swap");
        }

        bars[i]?.classList.add("sorted");
      }
    }

    async function insertionSort(): Promise<void> {
      for (let i = 1; i < values.length; i++) {
        let j = i;

        while (j > 0) {
          comparisons++;
          updateMetrics();

          await highlight([j - 1, j], "compare");

          if (values[j - 1] <= values[j]) {
            break;
          }

          [values[j - 1], values[j]] = [
            values[j],
            values[j - 1],
          ];

          swaps++;

          updateBar(j - 1);
          updateBar(j);
          updateMetrics();

          await highlight([j - 1, j], "swap");

          j--;
        }
      }

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });
    }

    async function mergeSort(): Promise<void> {
      async function merge(
        left: number,
        middle: number,
        right: number
      ): Promise<void> {
        const first = values.slice(left, middle + 1);
        const second = values.slice(middle + 1, right + 1);

        let i = 0;
        let j = 0;
        let position = left;

        while (i < first.length && j < second.length) {
          comparisons++;
          updateMetrics();

          await highlight(
            [left + i, middle + 1 + j],
            "compare"
          );

          if (first[i] <= second[j]) {
            values[position] = first[i];
            i++;
          } else {
            values[position] = second[j];
            j++;
          }

          updateBar(position);

          swaps++;
          updateMetrics();

          position++;
        }

        while (i < first.length) {
          values[position] = first[i];

          updateBar(position);

          i++;
          position++;
        }

        while (j < second.length) {
          values[position] = second[j];

          updateBar(position);

          j++;
          position++;
        }

        await sleep(delay());
      }

      async function sort(
        left: number,
        right: number
      ): Promise<void> {
        if (left >= right) {
          return;
        }

        const middle = Math.floor((left + right) / 2);

        await sort(left, middle);
        await sort(middle + 1, right);
        await merge(left, middle, right);
      }

      await sort(0, values.length - 1);

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });
    }

    async function quickSort(): Promise<void> {
      async function partition(
        left: number,
        right: number
      ): Promise<number> {
        const pivot = values[right];
        let index = left;

        for (let i = left; i < right; i++) {
          comparisons++;
          updateMetrics();

          await highlight([i, right], "compare");

          if (values[i] < pivot) {
            [values[index], values[i]] = [
              values[i],
              values[index],
            ];

            swaps++;

            updateBar(index);
            updateBar(i);
            updateMetrics();

            await highlight([index, i], "swap");

            index++;
          }
        }

        [values[index], values[right]] = [
          values[right],
          values[index],
        ];

        swaps++;

        updateBar(index);
        updateBar(right);
        updateMetrics();

        await highlight([index, right], "swap");

        bars[index]?.classList.add("sorted");

        return index;
      }

      async function sort(
        left: number,
        right: number
      ): Promise<void> {
        if (left >= right) {
          return;
        }

        const pivot = await partition(left, right);

        await sort(left, pivot - 1);
        await sort(pivot + 1, right);
      }

      await sort(0, values.length - 1);

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });
    }

    async function run(): Promise<void> {
      if (running) {
        return;
      }

      running = true;

      runButton.disabled = true;
      shuffleButton.disabled = true;
      algorithm.disabled = true;

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      bars.forEach((bar) => {
        bar.classList.remove("sorted");
      });

      statusOutput.textContent = "Running";

      const selected = algorithm.value;

      if (selected === "bubble") {
        await bubbleSort();
      } else if (selected === "selection") {
        await selectionSort();
      } else if (selected === "insertion") {
        await insertionSort();
      } else if (selected === "merge") {
        await mergeSort();
      } else {
        await quickSort();
      }

      clearMarks();

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });

      statusOutput.textContent = "Complete";

      running = false;

      runButton.disabled = false;
      shuffleButton.disabled = false;
      algorithm.disabled = false;
    }

    function shuffle(): void {
      if (running) {
        return;
      }

      createArray();
      render();

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      statusOutput.textContent = "Ready";
    }

    runButton.addEventListener("click", () => {
      void run();
    });

    shuffleButton.addEventListener("click", shuffle);

    shuffle();
  })();

  /* ================================================================
     HASH TABLE
     ================================================================ */

  (() => {
    const bucketsElement = document.getElementById("hash-buckets");
    const keyElement = document.getElementById("hash-key");
    const valueElement = document.getElementById("hash-value");
    const insertElement = document.getElementById("hash-insert");
    const randomElement = document.getElementById("hash-random");
    const clearElement = document.getElementById("hash-clear");
    const formulaElement = document.getElementById("hash-formula");
    const loadElement = document.getElementById("hash-load");

    if (
      !(bucketsElement instanceof HTMLDivElement) ||
      !(keyElement instanceof HTMLInputElement) ||
      !(valueElement instanceof HTMLInputElement) ||
      !(insertElement instanceof HTMLButtonElement) ||
      !(randomElement instanceof HTMLButtonElement) ||
      !(clearElement instanceof HTMLButtonElement) ||
      !(formulaElement instanceof HTMLElement) ||
      !(loadElement instanceof HTMLElement)
    ) {
      return;
    }

    const buckets = bucketsElement;
    const keyInput = keyElement;
    const valueInput = valueElement;
    const insertButton = insertElement;
    const randomButton = randomElement;
    const clearButton = clearElement;
    const formula = formulaElement;
    const load = loadElement;

    const BUCKETS = 8;

    type Entry = {
      key: string;
      value: string;
    };

    let table: Entry[][] = Array.from(
      { length: BUCKETS },
      () => []
    );

    function hash(key: string): number {
      let value = 0;

      for (let i = 0; i < key.length; i++) {
        value =
          (value * 31 + key.charCodeAt(i)) >>> 0;
      }

      return value % BUCKETS;
    }

    function render(): void {
      buckets.innerHTML = "";

      let count = 0;

      table.forEach((chain, index) => {
        count += chain.length;

        const bucket = document.createElement("div");
        bucket.className = "hash-bucket";

        const label = document.createElement("div");
        label.className = "hash-index";
        label.textContent = `bucket ${index}`;

        bucket.appendChild(label);

        const chainElement =
          document.createElement("div");

        chainElement.className = "hash-chain";

        chain.forEach((entry, entryIndex) => {
          const node = document.createElement("div");

          node.className =
            "hash-node" +
            (chain.length > 1 ? " collision" : "");

          node.textContent =
            `${entry.key} → ${entry.value}`;

          chainElement.appendChild(node);

          if (entryIndex < chain.length - 1) {
            const arrow = document.createElement("div");

            arrow.className = "hash-arrow";
            arrow.textContent = "↓";

            chainElement.appendChild(arrow);
          }
        });

        bucket.appendChild(chainElement);
        buckets.appendChild(bucket);
      });

      load.textContent =
        (count / BUCKETS).toFixed(2);
    }

    function insert(
      key: string,
      value: string
    ): void {
      if (!key) {
        return;
      }

      const index = hash(key);
      const chain = table[index];

      const existing = chain.find(
        (entry) => entry.key === key
      );

      if (existing) {
        existing.value = value || existing.value;
      } else {
        chain.push({
          key,
          value: value || "—",
        });
      }

      formula.textContent =
        `hash("${key}") → ${index} / bucket ${index}` +
        (chain.length > 1
          ? " / collision → chaining"
          : "");

      render();
    }

    function randomKey(): string {
      const words = [
        "node",
        "heap",
        "tree",
        "graph",
        "byte",
        "stack",
        "queue",
        "hash",
        "sort",
        "data",
      ];

      return (
        words[
          Math.floor(
            Math.random() * words.length
          )
        ] +
        Math.floor(Math.random() * 100)
      );
    }

    insertButton.addEventListener("click", () => {
      insert(
        keyInput.value.trim(),
        valueInput.value.trim()
      );

      keyInput.value = "";
      valueInput.value = "";

      keyInput.focus();
    });

    keyInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    valueInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    randomButton.addEventListener("click", () => {
      insert(
        randomKey(),
        String(
          Math.floor(Math.random() * 1000)
        )
      );
    });

    clearButton.addEventListener("click", () => {
      table = Array.from(
        { length: BUCKETS },
        () => []
      );

      formula.textContent =
        "Ready for insertion.";

      render();
    });

    render();
  })();

  /* ================================================================
     PATHFINDING
     ================================================================ */

  (() => {
    const gridElement = document.getElementById("path-grid");
    const algorithmElement = document.getElementById("path-algo");
    const runElement = document.getElementById("path-run");
    const wallsElement = document.getElementById("path-walls");
    const clearElement = document.getElementById("path-clear");
    const visitedElement = document.getElementById("path-visited");
    const lengthElement = document.getElementById("path-length");
    const statusElement = document.getElementById("path-status");

    if (
      !(gridElement instanceof HTMLDivElement) ||
      !(algorithmElement instanceof HTMLSelectElement) ||
      !(runElement instanceof HTMLButtonElement) ||
      !(wallsElement instanceof HTMLButtonElement) ||
      !(clearElement instanceof HTMLButtonElement) ||
      !(visitedElement instanceof HTMLElement) ||
      !(lengthElement instanceof HTMLElement) ||
      !(statusElement instanceof HTMLElement)
    ) {
      return;
    }

    const gridContainer = gridElement;
    const algorithm = algorithmElement;
    const runButton = runElement;
    const wallsButton = wallsElement;
    const clearButton = clearElement;
    const visitedOutput = visitedElement;
    const lengthOutput = lengthElement;
    const statusOutput = statusElement;

    const ROWS = 14;
    const COLS = 28;

    type Point = {
      r: number;
      c: number;
    };

    type Cell =
      | "empty"
      | "wall"
      | "start"
      | "end"
      | "visited"
      | "path";

    type SearchResult = {
      found: boolean;
      order: Point[];
      cameFrom: Map<string, Point>;
    };

    let grid: Cell[][] = [];
    let cells: HTMLDivElement[][] = [];

    let start: Point = {
      r: 7,
      c: 3,
    };

    let end: Point = {
      r: 7,
      c: 24,
    };

    let running = false;

    let dragMode:
      | "wall"
      | "erase"
      | "start"
      | "end"
      | null = null;

    function createGrid(): void {
      grid = Array.from(
        { length: ROWS },
        () =>
          Array.from(
            { length: COLS },
            () => "empty" as Cell
          )
      );

      grid[start.r][start.c] = "start";
      grid[end.r][end.c] = "end";
    }

    function cellClass(cell: Cell): string {
      return cell === "empty"
        ? "path-cell"
        : `path-cell ${cell}`;
    }

    function render(): void {
      gridContainer.innerHTML = "";
      cells = [];

      for (let r = 0; r < ROWS; r++) {
        const row: HTMLDivElement[] = [];

        for (let c = 0; c < COLS; c++) {
          const element =
            document.createElement("div");

          element.className =
            cellClass(grid[r][c]);

          element.addEventListener(
            "mousedown",
            (event) => {
              event.preventDefault();
              handleDown(r, c);
            }
          );

          element.addEventListener(
            "mouseenter",
            () => {
              handleEnter(r, c);
            }
          );

          gridContainer.appendChild(element);

          row.push(element);
        }

        cells.push(row);
      }
    }

    function setCell(
      r: number,
      c: number,
      state: Cell
    ): void {
      grid[r][c] = state;

      const element = cells[r]?.[c];

      if (element) {
        element.className =
          cellClass(state);
      }
    }

    function handleDown(
      r: number,
      c: number
    ): void {
      if (running) {
        return;
      }

      const state = grid[r][c];

      if (state === "start") {
        dragMode = "start";
        return;
      }

      if (state === "end") {
        dragMode = "end";
        return;
      }

      dragMode =
        state === "wall"
          ? "erase"
          : "wall";

      toggleWall(r, c);
    }

    function handleEnter(
      r: number,
      c: number
    ): void {
      if (running || !dragMode) {
        return;
      }

      if (dragMode === "wall") {
        toggleWall(r, c, true);
        return;
      }

      if (dragMode === "erase") {
        toggleWall(r, c, false);
        return;
      }

      if (dragMode === "start") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "end"
        ) {
          return;
        }

        setCell(
          start.r,
          start.c,
          "empty"
        );

        start = { r, c };

        setCell(r, c, "start");

        return;
      }

      if (dragMode === "end") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "start"
        ) {
          return;
        }

        setCell(
          end.r,
          end.c,
          "empty"
        );

        end = { r, c };

        setCell(r, c, "end");
      }
    }

    function toggleWall(
      r: number,
      c: number,
      force?: boolean
    ): void {
      if (
        grid[r][c] === "start" ||
        grid[r][c] === "end"
      ) {
        return;
      }

      const shouldWall =
        force === undefined
          ? grid[r][c] !== "wall"
          : force;

      setCell(
        r,
        c,
        shouldWall
          ? "wall"
          : "empty"
      );
    }

    document.addEventListener(
      "mouseup",
      () => {
        dragMode = null;
      }
    );

    function pointKey(point: Point): string {
      return `${point.r},${point.c}`;
    }

    function neighbors(
      point: Point
    ): Point[] {
      const directions: Point[] = [
        { r: -1, c: 0 },
        { r: 1, c: 0 },
        { r: 0, c: -1 },
        { r: 0, c: 1 },
      ];

      const result: Point[] = [];

      for (const direction of directions) {
        const r =
          point.r + direction.r;

        const c =
          point.c + direction.c;

        if (
          r >= 0 &&
          r < ROWS &&
          c >= 0 &&
          c < COLS &&
          grid[r][c] !== "wall"
        ) {
          result.push({ r, c });
        }
      }

      return result;
    }

    function heuristic(
      point: Point
    ): number {
      return (
        Math.abs(point.r - end.r) +
        Math.abs(point.c - end.c)
      );
    }

    function bfs(): SearchResult {
      const queue: Point[] = [start];

      const visited =
        new Set<string>([
          pointKey(start),
        ]);

      const cameFrom =
        new Map<string, Point>();

      const order: Point[] = [];

      while (queue.length > 0) {
        const current =
          queue.shift();

        if (!current) {
          break;
        }

        const currentKey =
          pointKey(current);

        if (
          currentKey !==
          pointKey(start)
        ) {
          order.push(current);
        }

        if (
          currentKey ===
          pointKey(end)
        ) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        for (
          const next of neighbors(current)
        ) {
          const nextKey =
            pointKey(next);

          if (visited.has(nextKey)) {
            continue;
          }

          visited.add(nextKey);

          cameFrom.set(
            nextKey,
            current
          );

          queue.push(next);
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    function weighted(
      mode: "dijkstra" | "astar"
    ): SearchResult {
      const open: {
        point: Point;
        priority: number;
      }[] = [
        {
          point: start,
          priority: 0,
        },
      ];

      const distances =
        new Map<string, number>();

      distances.set(
        pointKey(start),
        0
      );

      const cameFrom =
        new Map<string, Point>();

      const closed =
        new Set<string>();

      const order: Point[] = [];

      while (open.length > 0) {
        open.sort(
          (a, b) =>
            a.priority - b.priority
        );

        const currentEntry =
          open.shift();

        if (!currentEntry) {
          break;
        }

        const current =
          currentEntry.point;

        const currentKey =
          pointKey(current);

        if (closed.has(currentKey)) {
          continue;
        }

        closed.add(currentKey);

        if (
          currentKey !==
          pointKey(start)
        ) {
          order.push(current);
        }

        if (
          currentKey ===
          pointKey(end)
        ) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        const currentDistance =
          distances.get(
            currentKey
          ) ?? Infinity;

        for (
          const next of neighbors(current)
        ) {
          const nextKey =
            pointKey(next);

          if (closed.has(nextKey)) {
            continue;
          }

          const newCost =
            currentDistance + 1;

          const oldCost =
            distances.get(
              nextKey
            ) ?? Infinity;

          if (newCost < oldCost) {
            distances.set(
              nextKey,
              newCost
            );

            cameFrom.set(
              nextKey,
              current
            );

            const priority =
              mode === "astar"
                ? newCost +
                  heuristic(next)
                : newCost;

            open.push({
              point: next,
              priority,
            });
          }
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    async function animateSearch(
      order: Point[]
    ): Promise<void> {
      for (
        let i = 0;
        i < order.length;
        i++
      ) {
        const point = order[i];

        if (
          grid[point.r][point.c] ===
          "empty"
        ) {
          setCell(
            point.r,
            point.c,
            "visited"
          );
        }

        visitedOutput.textContent =
          String(i + 1);

        await sleep(7);
      }
    }

    function reconstruct(
      cameFrom: Map<string, Point>
    ): Point[] {
      const path: Point[] = [];

      let current = end;

      while (
        pointKey(current) !==
        pointKey(start)
      ) {
        path.push(current);

        const previous =
          cameFrom.get(
            pointKey(current)
          );

        if (!previous) {
          return [];
        }

        current = previous;
      }

      path.reverse();

      return path;
    }

    function resetSearchMarks(): void {
      for (
        let r = 0;
        r < ROWS;
        r++
      ) {
        for (
          let c = 0;
          c < COLS;
          c++
        ) {
          if (
            grid[r][c] === "visited" ||
            grid[r][c] === "path"
          ) {
            setCell(
              r,
              c,
              "empty"
            );
          }
        }
      }

      setCell(
        start.r,
        start.c,
        "start"
      );

      setCell(
        end.r,
        end.c,
        "end"
      );
    }

    function setControls(
      enabled: boolean
    ): void {
      runButton.disabled = !enabled;
      wallsButton.disabled = !enabled;
      clearButton.disabled = !enabled;
      algorithm.disabled = !enabled;
    }

    async function run(): Promise<void> {
      if (running) {
        return;
      }

      running = true;

      setControls(false);

      statusOutput.textContent =
        "Searching";

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      resetSearchMarks();

      const selected =
        algorithm.value;

      const result =
        selected === "bfs"
          ? bfs()
          : weighted(
              selected === "astar"
                ? "astar"
                : "dijkstra"
            );

      await animateSearch(
        result.order
      );

      if (!result.found) {
        statusOutput.textContent =
          "No path found";

        running = false;

        setControls(true);

        return;
      }

      const path =
        reconstruct(
          result.cameFrom
        );

      for (const point of path) {
        if (
          pointKey(point) !==
          pointKey(end)
        ) {
          setCell(
            point.r,
            point.c,
            "path"
          );
        }

        await sleep(18);
      }

      lengthOutput.textContent =
        String(path.length);

      statusOutput.textContent =
        "Path found";

      running = false;

      setControls(true);
    }

    function randomWalls(): void {
      if (running) {
        return;
      }

      createGrid();

      for (
        let r = 0;
        r < ROWS;
        r++
      ) {
        for (
          let c = 0;
          c < COLS;
          c++
        ) {
          if (
            grid[r][c] === "empty" &&
            Math.random() < 0.25
          ) {
            grid[r][c] = "wall";
          }
        }
      }

      grid[start.r][start.c] =
        "start";

      grid[end.r][end.c] =
        "end";

      render();

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      statusOutput.textContent =
        "Ready";
    }

    function clear(): void {
      if (running) {
        return;
      }

      createGrid();
      render();

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      statusOutput.textContent =
        "Ready";
    }

    runButton.addEventListener(
      "click",
      () => {
        void run();
      }
    );

    wallsButton.addEventListener(
      "click",
      randomWalls
    );

    clearButton.addEventListener(
      "click",
      clear
    );

    createGrid();
    render();
  })();
</script>