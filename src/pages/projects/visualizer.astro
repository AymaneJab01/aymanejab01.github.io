  const STATIC_HTML: Record<string, Record<LangCode, string>> = {
    refSectionDesc: {
      en: `The visualizations above show <em>that</em> something happens. This is the <em>why</em> — the concept behind each algorithm, spelled out in plain terms.`,
      fr: `Les visualisations ci-dessus montrent <em>que</em> quelque chose se passe. Voici le <em>pourquoi</em> — le concept derrière chaque algorithme, expliqué en termes simples.`,
      es: `Las visualizaciones de arriba muestran <em>que</em> algo sucede. Esto es el <em>por qué</em> — el concepto detrás de cada algoritmo, explicado en términos simples.`,
    },
    docBigOBody: {
      en: `<p>Big-O describes how an algorithm's running time grows as the input gets bigger — not the exact number of steps, but the <em>shape</em> of the growth curve. <code>O(n²)</code> means doubling the input roughly quadruples the work; <code>O(n log n)</code> means doubling the input barely more than doubles it.</p>
        <p>It matters at scale, not on 20 bars: sorting 20 items, bubble sort's worst case is around 190 comparisons and quick sort's average case is around 86. Sort 20,000 items instead and that gap stops being academic — bubble sort's <code>n²</code> term dominates completely.</p>`,
      fr: `<p>Le Big-O décrit la façon dont le temps d'exécution d'un algorithme croît quand l'entrée grandit — pas le nombre exact d'étapes, mais la <em>forme</em> de la courbe de croissance. <code>O(n²)</code> signifie que doubler l'entrée multiplie le travail par environ quatre ; <code>O(n log n)</code> signifie que doubler l'entrée le fait à peine plus que doubler.</p>
        <p>Cela compte à grande échelle, pas sur 20 barres : pour trier 20 éléments, le pire cas du tri à bulles est d'environ 190 comparaisons et le cas moyen du tri rapide d'environ 86. Trier 20 000 éléments à la place, et cet écart cesse d'être théorique — le terme <code>n²</code> du tri à bulles domine complètement.</p>`,
      es: `<p>La notación Big-O describe cómo crece el tiempo de ejecución de un algoritmo a medida que la entrada aumenta — no el número exacto de pasos, sino la <em>forma</em> de la curva de crecimiento. <code>O(n²)</code> significa que duplicar la entrada multiplica el trabajo aproximadamente por cuatro; <code>O(n log n)</code> significa que duplicar la entrada apenas más que la duplica.</p>
        <p>Esto importa a gran escala, no con 20 barras: al ordenar 20 elementos, el peor caso del ordenamiento de burbuja son unas 190 comparaciones y el caso promedio del ordenamiento rápido unas 86. Ordena 20.000 elementos en su lugar, y esa diferencia deja de ser académica — el término <code>n²</code> del ordenamiento de burbuja domina por completo.</p>`,
    },
    docBubbleBody: {
      en: `<p>Walks the array left to right, comparing each pair of neighbors and swapping them if they're out of order. One full pass guarantees the largest remaining value "bubbles" to its correct position at the end — so after <code>k</code> passes, the last <code>k</code> items are guaranteed sorted.</p>
        <ol class="doc-steps"><li>Compare each adjacent pair, left to right.</li><li>Swap the pair if the left value is bigger.</li><li>Repeat passes until a full pass makes no swaps.</li></ol>
        <p class="doc-meta">Stable · in-place · rarely used outside teaching, but the easiest algorithm to trace by hand.</p>`,
      fr: `<p>Parcourt le tableau de gauche à droite, comparant chaque paire de voisins et les échangeant s'ils sont dans le mauvais ordre. Un passage complet garantit que la plus grande valeur restante « remonte » à sa position finale — ainsi après <code>k</code> passages, les <code>k</code> derniers éléments sont garantis triés.</p>
        <ol class="doc-steps"><li>Comparer chaque paire adjacente, de gauche à droite.</li><li>Échanger la paire si la valeur de gauche est plus grande.</li><li>Répéter les passages jusqu'à ce qu'un passage complet ne fasse aucun échange.</li></ol>
        <p class="doc-meta">Stable · en place · rarement utilisé en dehors de l'enseignement, mais l'algorithme le plus facile à suivre à la main.</p>`,
      es: `<p>Recorre el arreglo de izquierda a derecha, comparando cada par de vecinos e intercambiándolos si están en el orden incorrecto. Una pasada completa garantiza que el mayor valor restante "burbujee" hasta su posición final — así que tras <code>k</code> pasadas, los últimos <code>k</code> elementos están garantizados como ordenados.</p>
        <ol class="doc-steps"><li>Comparar cada par adyacente, de izquierda a derecha.</li><li>Intercambiar el par si el valor de la izquierda es mayor.</li><li>Repetir pasadas hasta que una pasada completa no haga intercambios.</li></ol>
        <p class="doc-meta">Estable · en el mismo lugar · rara vez se usa fuera de la enseñanza, pero es el algoritmo más fácil de seguir a mano.</p>`,
    },
    docSelectionBody: {
      en: `<p>Splits the array into a sorted section (front) and an unsorted section (back). On each pass it scans the entire unsorted section to find the smallest value, then swaps it into the next open slot at the front.</p>
        <ol class="doc-steps"><li>Assume the first unsorted item is the minimum.</li><li>Scan the rest, updating the minimum when a smaller value appears.</li><li>Swap the true minimum into place, then move the boundary forward.</li></ol>
        <p class="doc-meta">Not stable · in-place · always exactly one swap per pass, which makes it cheap on writes even though comparisons stay <code>O(n²)</code>.</p>`,
      fr: `<p>Divise le tableau en une section triée (avant) et une section non triée (arrière). À chaque passage, il parcourt toute la section non triée pour trouver la plus petite valeur, puis l'échange dans la prochaine case libre à l'avant.</p>
        <ol class="doc-steps"><li>Supposer que le premier élément non trié est le minimum.</li><li>Parcourir le reste, en mettant à jour le minimum quand une valeur plus petite apparaît.</li><li>Échanger le vrai minimum à sa place, puis avancer la frontière.</li></ol>
        <p class="doc-meta">Non stable · en place · toujours exactement un échange par passage, ce qui le rend peu coûteux en écritures même si les comparaisons restent en <code>O(n²)</code>.</p>`,
      es: `<p>Divide el arreglo en una sección ordenada (al frente) y una sin ordenar (al final). En cada pasada recorre toda la sección sin ordenar para encontrar el valor más pequeño, y luego lo intercambia en el siguiente lugar libre al frente.</p>
        <ol class="doc-steps"><li>Suponer que el primer elemento sin ordenar es el mínimo.</li><li>Recorrer el resto, actualizando el mínimo cuando aparece un valor más pequeño.</li><li>Intercambiar el verdadero mínimo a su lugar y avanzar el límite.</li></ol>
        <p class="doc-meta">No estable · en el mismo lugar · siempre exactamente un intercambio por pasada, lo que lo hace barato en escrituras aunque las comparaciones sigan en <code>O(n²)</code>.</p>`,
    },
    docInsertionBody: {
      en: `<p>Builds a sorted section one value at a time. Each new value is compared against its sorted neighbors and shifted left until it lands in the correct spot — the same motion as sorting a hand of playing cards.</p>
        <ol class="doc-steps"><li>Take the next unsorted value.</li><li>Shift it left past every sorted value bigger than it.</li><li>Drop it into the gap that's left behind.</li></ol>
        <p class="doc-meta">Stable · in-place · <code>O(n)</code> best case on nearly-sorted data, which is why it's often used to finish off other algorithms on small sub-arrays.</p>`,
      fr: `<p>Construit une section triée une valeur à la fois. Chaque nouvelle valeur est comparée à ses voisins triés et décalée vers la gauche jusqu'à trouver sa place — le même geste que trier une main de cartes.</p>
        <ol class="doc-steps"><li>Prendre la prochaine valeur non triée.</li><li>La décaler vers la gauche au-delà de chaque valeur triée plus grande qu'elle.</li><li>La déposer dans l'espace laissé libre.</li></ol>
        <p class="doc-meta">Stable · en place · meilleur cas en <code>O(n)</code> sur des données presque triées, c'est pourquoi il est souvent utilisé pour finir d'autres algorithmes sur de petits sous-tableaux.</p>`,
      es: `<p>Construye una sección ordenada un valor a la vez. Cada nuevo valor se compara con sus vecinos ordenados y se desplaza a la izquierda hasta encontrar su lugar — el mismo movimiento que ordenar una mano de cartas.</p>
        <ol class="doc-steps"><li>Tomar el siguiente valor sin ordenar.</li><li>Desplazarlo a la izquierda pasando cada valor ordenado mayor que él.</li><li>Colocarlo en el hueco que queda libre.</li></ol>
        <p class="doc-meta">Estable · en el mismo lugar · mejor caso en <code>O(n)</code> con datos casi ordenados, por eso suele usarse para rematar otros algoritmos en subarreglos pequeños.</p>`,
    },
    docMergeBody: {
      en: `<p>A divide-and-conquer algorithm: split the array in half recursively until each piece has one item (trivially sorted), then merge pairs of sorted pieces back together by repeatedly taking the smaller of the two fronts.</p>
        <ol class="doc-steps"><li>Split the array in half, recursively, down to single items.</li><li>Merge each pair of halves, always taking the smaller front value.</li><li>Repeat merging upward until one sorted array remains.</li></ol>
        <p class="doc-meta">Stable · <strong>not</strong> in-place (needs <code>O(n)</code> extra space for the merge step) · guaranteed <code>O(n log n)</code> — no worst-case cliff like quick sort.</p>`,
      fr: `<p>Un algorithme diviser-pour-régner : diviser le tableau en deux récursivement jusqu'à ce que chaque morceau ait un seul élément (trivialement trié), puis fusionner les paires de morceaux triés en prenant à chaque fois la plus petite des deux valeurs de tête.</p>
        <ol class="doc-steps"><li>Diviser le tableau en deux, récursivement, jusqu'aux éléments seuls.</li><li>Fusionner chaque paire de moitiés, en prenant toujours la plus petite valeur de tête.</li><li>Répéter la fusion vers le haut jusqu'à obtenir un seul tableau trié.</li></ol>
        <p class="doc-meta">Stable · <strong>pas</strong> en place (nécessite un espace supplémentaire en <code>O(n)</code> pour l'étape de fusion) · garanti en <code>O(n log n)</code> — pas de pire cas catastrophique comme le tri rapide.</p>`,
      es: `<p>Un algoritmo de divide y vencerás: divide el arreglo por la mitad recursivamente hasta que cada trozo tenga un solo elemento (trivialmente ordenado), y luego fusiona pares de trozos ordenados tomando repetidamente el menor de los dos frentes.</p>
        <ol class="doc-steps"><li>Dividir el arreglo por la mitad, recursivamente, hasta elementos individuales.</li><li>Fusionar cada par de mitades, tomando siempre el valor frontal menor.</li><li>Repetir la fusión hacia arriba hasta que quede un solo arreglo ordenado.</li></ol>
        <p class="doc-meta">Estable · <strong>no</strong> en el mismo lugar (necesita espacio extra en <code>O(n)</code> para el paso de fusión) · garantizado en <code>O(n log n)</code> — sin el peor caso catastrófico del ordenamiento rápido.</p>`,
    },
    docQuickBody: {
      en: `<p>Also divide-and-conquer, but it partitions instead of merging: pick a pivot value, rearrange the array so everything smaller ends up left of it and everything bigger ends up right, then recurse on each side.</p>
        <ol class="doc-steps"><li>Choose a pivot — this demo uses the last element.</li><li>Walk the array, moving anything smaller than the pivot to the left side.</li><li>Drop the pivot into the boundary between the two sides.</li><li>Recurse into the left and right partitions independently.</li></ol>
        <p class="doc-meta">Not stable · in-place · fast in practice despite an <code>O(n²)</code> worst case, because that worst case (already-sorted input with a bad pivot choice) is rare.</p>`,
      fr: `<p>Également diviser-pour-régner, mais il partitionne au lieu de fusionner : choisir une valeur pivot, réorganiser le tableau pour que tout ce qui est plus petit se retrouve à gauche et tout ce qui est plus grand à droite, puis récurer sur chaque côté.</p>
        <ol class="doc-steps"><li>Choisir un pivot — cette démo utilise le dernier élément.</li><li>Parcourir le tableau, déplaçant à gauche tout ce qui est plus petit que le pivot.</li><li>Placer le pivot à la frontière entre les deux côtés.</li><li>Récurer indépendamment sur les partitions gauche et droite.</li></ol>
        <p class="doc-meta">Non stable · en place · rapide en pratique malgré un pire cas en <code>O(n²)</code>, car ce pire cas (entrée déjà triée avec un mauvais choix de pivot) est rare.</p>`,
      es: `<p>También divide y vencerás, pero particiona en vez de fusionar: elige un valor pivote, reorganiza el arreglo para que todo lo menor quede a su izquierda y todo lo mayor a su derecha, y luego recurre en cada lado.</p>
        <ol class="doc-steps"><li>Elegir un pivote — esta demo usa el último elemento.</li><li>Recorrer el arreglo, moviendo a la izquierda todo lo menor que el pivote.</li><li>Colocar el pivote en el límite entre los dos lados.</li><li>Recurrir de forma independiente en las particiones izquierda y derecha.</li></ol>
        <p class="doc-meta">No estable · en el mismo lugar · rápido en la práctica pese a un peor caso en <code>O(n²)</code>, porque ese peor caso (entrada ya ordenada con una mala elección de pivote) es poco frecuente.</p>`,
    },
    docHashFnBody: {
      en: `<p>A hash function takes a key of any size — a string, a number, anything — and deterministically maps it to a fixed-size number: the bucket index. The demo above walks each character's code through <code>hash = hash × 31 + charCode</code>, then takes the result modulo 8 so it always lands inside the eight buckets.</p>
        <p>A good hash function spreads keys evenly across buckets and is fast to compute. It does <em>not</em> need to be reversible — you can't recover the key from the bucket index alone.</p>`,
      fr: `<p>Une fonction de hachage prend une clé de taille quelconque — une chaîne, un nombre, n'importe quoi — et la fait correspondre de façon déterministe à un nombre de taille fixe : l'indice du compartiment. La démo ci-dessus fait passer le code de chaque caractère par <code>hash = hash × 31 + charCode</code>, puis prend le résultat modulo 8 pour qu'il tombe toujours dans l'un des huit compartiments.</p>
        <p>Une bonne fonction de hachage répartit les clés uniformément entre les compartiments et se calcule rapidement. Elle n'a <em>pas</em> besoin d'être réversible — on ne peut pas retrouver la clé à partir du seul indice du compartiment.</p>`,
      es: `<p>Una función hash toma una clave de cualquier tamaño — una cadena, un número, lo que sea — y la asigna de forma determinista a un número de tamaño fijo: el índice de la cubeta. La demo de arriba pasa el código de cada carácter por <code>hash = hash × 31 + charCode</code>, y luego toma el resultado módulo 8 para que siempre caiga en una de las ocho cubetas.</p>
        <p>Una buena función hash reparte las claves de forma uniforme entre las cubetas y es rápida de calcular. <em>No</em> necesita ser reversible — no se puede recuperar la clave solo a partir del índice de la cubeta.</p>`,
    },
    docCollisionsBody: {
      en: `<p>Two different keys can hash to the same bucket — that's a collision, and it's expected, not a bug. This table resolves it with <strong>separate chaining</strong>: each bucket holds a small list, and colliding keys simply get appended to that bucket's chain instead of overwriting each other.</p>
        <p>Lookups still work because inserting <em>and</em> searching use the same hash function — to find a key you hash it, jump straight to its bucket, then scan that bucket's (usually short) chain for a match.</p>`,
      fr: `<p>Deux clés différentes peuvent se hacher vers le même compartiment — c'est une collision, et c'est attendu, pas un bug. Cette table la résout par <strong>chaînage séparé</strong> : chaque compartiment contient une petite liste, et les clés en collision sont simplement ajoutées à la chaîne du compartiment au lieu de s'écraser mutuellement.</p>
        <p>Les recherches fonctionnent toujours car l'insertion <em>et</em> la recherche utilisent la même fonction de hachage — pour trouver une clé, on la hache, on saute directement à son compartiment, puis on parcourt la chaîne (généralement courte) de ce compartiment pour trouver une correspondance.</p>`,
      es: `<p>Dos claves distintas pueden generar el mismo hash y caer en la misma cubeta — eso es una colisión, y es esperado, no un error. Esta tabla lo resuelve con <strong>encadenamiento separado</strong>: cada cubeta contiene una pequeña lista, y las claves en colisión simplemente se añaden a la cadena de esa cubeta en lugar de sobrescribirse entre sí.</p>
        <p>Las búsquedas siguen funcionando porque insertar <em>y</em> buscar usan la misma función hash — para encontrar una clave la hasheas, saltas directamente a su cubeta y luego recorres la cadena (normalmente corta) de esa cubeta buscando una coincidencia.</p>`,
    },
    docLoadFactorBody: {
      en: `<p>Load factor is <code>entries ÷ buckets</code> — shown live at the bottom of the table above. As it climbs past roughly <code>0.7</code>, chains get longer and lookups degrade from an average <code>O(1)</code> toward <code>O(n)</code> in the worst case.</p>
        <p>Real hash table implementations watch this number and automatically <em>resize</em> — allocate a bigger bucket array and rehash every existing key into it — once the load factor crosses a threshold. This demo skips resizing to keep the eight buckets visible.</p>`,
      fr: `<p>Le facteur de charge est <code>entrées ÷ compartiments</code> — affiché en direct en bas de la table ci-dessus. Lorsqu'il dépasse environ <code>0.7</code>, les chaînes s'allongent et les recherches se dégradent d'une moyenne en <code>O(1)</code> vers <code>O(n)</code> dans le pire cas.</p>
        <p>Les vraies implémentations de tables de hachage surveillent ce nombre et <em>redimensionnent</em> automatiquement — en allouant un tableau de compartiments plus grand et en rehachant chaque clé existante — une fois qu'un seuil est franchi. Cette démo saute le redimensionnement pour garder les huit compartiments visibles.</p>`,
      es: `<p>El factor de carga es <code>entradas ÷ cubetas</code> — se muestra en vivo al final de la tabla de arriba. Cuando supera aproximadamente <code>0.7</code>, las cadenas se alargan y las búsquedas se degradan de un promedio <code>O(1)</code> hacia <code>O(n)</code> en el peor caso.</p>
        <p>Las implementaciones reales de tablas hash vigilan este número y <em>redimensionan</em> automáticamente — asignando un arreglo de cubetas más grande y rehasheando cada clave existente — una vez que el factor de carga supera un umbral. Esta demo omite el redimensionamiento para mantener visibles las ocho cubetas.</p>`,
    },
    docGraphsBody: {
      en: `<p>The grid above is a graph in disguise: every open cell is a <strong>node</strong>, and every pair of adjacent open cells is connected by an <strong>edge</strong>. Walls simply remove a node from the graph entirely — no edges connect to it, so no search can pass through.</p>
        <p>Every edge here has the same weight (one step), which is what makes BFS behave identically to Dijkstra on this particular grid. Give the edges different costs — uneven terrain, diagonal moves — and BFS would stop guaranteeing the shortest path while Dijkstra still would.</p>`,
      fr: `<p>La grille ci-dessus est un graphe déguisé : chaque case libre est un <strong>sommet</strong>, et chaque paire de cases libres adjacentes est reliée par une <strong>arête</strong>. Les murs suppriment simplement un sommet du graphe — aucune arête ne le relie, donc aucune recherche ne peut y passer.</p>
        <p>Chaque arête a ici le même poids (un pas), ce qui fait que BFS se comporte de façon identique à Dijkstra sur cette grille précise. Donnez des coûts différents aux arêtes — terrain irrégulier, déplacements diagonaux — et BFS cesserait de garantir le chemin le plus court, alors que Dijkstra continuerait.</p>`,
      es: `<p>La cuadrícula de arriba es un grafo disfrazado: cada celda libre es un <strong>nodo</strong>, y cada par de celdas libres adyacentes está conectado por una <strong>arista</strong>. Los muros simplemente eliminan un nodo del grafo por completo — ninguna arista lo conecta, así que ninguna búsqueda puede pasar por él.</p>
        <p>Aquí cada arista tiene el mismo peso (un paso), lo que hace que BFS se comporte igual que Dijkstra en esta cuadrícula en particular. Da costos distintos a las aristas — terreno desigual, movimientos diagonales — y BFS dejaría de garantizar el camino más corto, mientras que Dijkstra seguiría haciéndolo.</p>`,
    },
    docBFSBody: {
      en: `<p>Explores the grid in rings, one step out at a time: visit every neighbor of the start, then every neighbor of those, and so on. Because it expands outward evenly, the first time it reaches the end cell is guaranteed to be by the shortest possible path — as long as every step costs the same.</p>
        <p>Implemented with a queue (first in, first out): each cell gets visited once, its unvisited neighbors get added to the back of the queue, and the search always processes the oldest queued cell next.</p>`,
      fr: `<p>Explore la grille en anneaux, un pas à la fois : visiter chaque voisin du départ, puis chaque voisin de ceux-ci, et ainsi de suite. Comme elle s'étend uniformément vers l'extérieur, la première fois qu'elle atteint la case d'arrivée, c'est garanti par le chemin le plus court possible — tant que chaque pas coûte la même chose.</p>
        <p>Implémenté avec une file (premier entré, premier sorti) : chaque case est visitée une fois, ses voisins non visités sont ajoutés à la fin de la file, et la recherche traite toujours ensuite la case la plus ancienne de la file.</p>`,
      es: `<p>Explora la cuadrícula en anillos, un paso a la vez: visita cada vecino del inicio, luego cada vecino de esos, y así sucesivamente. Como se expande uniformemente hacia afuera, la primera vez que alcanza la celda final está garantizado que es por el camino más corto posible — siempre que cada paso cueste lo mismo.</p>
        <p>Se implementa con una cola (primero en entrar, primero en salir): cada celda se visita una vez, sus vecinos no visitados se añaden al final de la cola, y la búsqueda siempre procesa a continuación la celda más antigua de la cola.</p>`,
    },
    docDijkstraBody: {
      en: `<p>Generalizes BFS to handle edges with different costs. It always expands the unvisited cell with the <strong>lowest total distance from the start</strong> so far, and updates a neighbor's distance whenever a shorter route to it is found. On this grid, where every step costs exactly one, it visits cells in the same order as BFS.</p>
        <p>The "priority" in priority queue is doing the real work here — it's the mechanism that always pulls out the currently-cheapest cell to expand next.</p>`,
      fr: `<p>Généralise BFS pour gérer des arêtes de coûts différents. Il étend toujours la case non visitée ayant la <strong>plus petite distance totale depuis le départ</strong> jusqu'à présent, et met à jour la distance d'un voisin dès qu'une route plus courte est trouvée. Sur cette grille, où chaque pas coûte exactement un, il visite les cases dans le même ordre que BFS.</p>
        <p>La « priorité » de la file à priorité fait ici tout le travail — c'est le mécanisme qui extrait toujours la case actuellement la moins coûteuse à étendre ensuite.</p>`,
      es: `<p>Generaliza BFS para manejar aristas con costos distintos. Siempre expande la celda no visitada con la <strong>menor distancia total desde el inicio</strong> hasta el momento, y actualiza la distancia de un vecino cada vez que se encuentra una ruta más corta hacia él. En esta cuadrícula, donde cada paso cuesta exactamente uno, visita las celdas en el mismo orden que BFS.</p>
        <p>La "prioridad" de la cola de prioridad es la que hace el trabajo real aquí — es el mecanismo que siempre extrae la celda actualmente más barata para expandir a continuación.</p>`,
    },
    docAStarBody: {
      en: `<p>Dijkstra plus a hint: it prioritizes cells by <code>cost so far + estimated cost to the goal</code>, using a heuristic (this demo uses Manhattan distance — horizontal steps plus vertical steps to the end). That estimate biases the search to expand toward the goal instead of spreading out equally in every direction.</p>
        <p>Watch the visited-cell count: A* typically explores far fewer cells than BFS or Dijkstra to find the same shortest path, because it isn't wasting time exploring away from the destination.</p>`,
      fr: `<p>Dijkstra avec un indice en plus : il priorise les cases selon <code>coût jusqu'ici + coût estimé jusqu'à l'objectif</code>, en utilisant une heuristique (cette démo utilise la distance de Manhattan — pas horizontaux plus pas verticaux jusqu'à l'arrivée). Cette estimation oriente la recherche à s'étendre vers l'objectif plutôt qu'à se répandre également dans toutes les directions.</p>
        <p>Observez le nombre de cases visitées : A* explore généralement beaucoup moins de cases que BFS ou Dijkstra pour trouver le même chemin le plus court, car il ne perd pas de temps à explorer loin de la destination.</p>`,
      es: `<p>Dijkstra más una pista: prioriza las celdas según <code>costo hasta ahora + costo estimado hasta la meta</code>, usando una heurística (esta demo usa la distancia de Manhattan — pasos horizontales más pasos verticales hasta el final). Esa estimación orienta la búsqueda a expandirse hacia la meta en lugar de esparcirse por igual en todas direcciones.</p>
        <p>Observa el número de celdas visitadas: A* normalmente explora muchas menos celdas que BFS o Dijkstra para encontrar el mismo camino más corto, porque no pierde tiempo explorando lejos del destino.</p>`,
    },
  };

  let currentLang: LangCode = "en";

  try {
    const saved = localStorage.getItem(LANG_STORAGE_KEY);
    if (saved === "en" || saved === "fr" || saved === "es") {
      currentLang = saved;
    }
  } catch {
    // localStorage unavailable — fall back to English
  }

  function t(key: string, vars?: Record<string, string | number>): string {
    const entry = STATIC_TEXT[key];
    let str = entry ? entry[currentLang] ?? entry.en : key;

    if (vars) {
      for (const varKey in vars) {
        str = str.replace(new RegExp(`\\{${varKey}\\}`, "g"), String(vars[varKey]));
      }
    }

    return str;
  }

  function applyStaticTranslations(): void {
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n");
      if (key && STATIC_TEXT[key]) {
        element.textContent = t(key);
      }
    });

    document.querySelectorAll<HTMLElement>("[data-i18n-html]").forEach((element) => {
      const key = element.getAttribute("data-i18n-html");
      if (key && STATIC_HTML[key]) {
        element.innerHTML = STATIC_HTML[key][currentLang] ?? STATIC_HTML[key].en;
      }
    });

    document.documentElement.lang = currentLang;
  }

  function updateLangButtons(): void {
    document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((button) => {
      button.classList.toggle("active", button.dataset.lang === currentLang);
    });
  }

  const langChangeListeners: (() => void)[] = [];

  function onLangChange(listener: () => void): void {
    langChangeListeners.push(listener);
  }

  function setLanguage(lang: LangCode): void {
    if (lang === currentLang) {
      return;
    }

    currentLang = lang;

    try {
      localStorage.setItem(LANG_STORAGE_KEY, lang);
    } catch {
      // ignore storage failures
    }

    applyStaticTranslations();
    updateLangButtons();

    langChangeListeners.forEach((listener) => listener());
  }

  document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const lang = button.dataset.lang;
      if (lang === "en" || lang === "fr" || lang === "es") {
        setLanguage(lang);
      }
    });
  });

  applyStaticTranslations();
  updateLangButtons();

  /* ================================================================
     ASCII / LIQUID BACKGROUND — olive-green signature effect
     ================================================================ */

  (() => {
    const canvas = document.getElementById("ascii-bg");

    if (!(canvas instanceof HTMLCanvasElement)) {
      return;
    }

    const ctx = canvas.getContext("2d");

    if (!ctx) {
      return;
    }

    // Re-bind to new consts: TS narrows `canvas`/`ctx` to non-null only
    // within this scope, and that narrowing does not carry into nested
    // function declarations below (resize/draw). Capturing the already-
    // narrowed values here keeps the compiler happy without `!` asserts.
    const canvasElement = canvas;
    const context = ctx;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const ramp = " .:-=+*#%@";
    const cell = 15;

    let cols = 0;
    let rows = 0;
    let time = 0;
    let frame = 0;

    function resize(): void {
      canvasElement.width = window.innerWidth;
      canvasElement.height = window.innerHeight;
      cols = Math.ceil(canvasElement.width / cell) + 1;
      rows = Math.ceil(canvasElement.height / cell) + 1;
    }

    function flow(x: number, y: number, t: number): number {
      const value =
        Math.sin(x * 0.16 + t) * 0.5 +
        Math.sin(y * 0.13 - t * 0.8) * 0.5 +
        Math.sin((x + y) * 0.09 + t * 1.3) * 0.4 +
        Math.sin(Math.sqrt(x * x + y * y) * 0.11 - t * 1.1) * 0.35;

      return value / 1.75;
    }

    function draw(): void {
      context.clearRect(0, 0, canvasElement.width, canvasElement.height);
      context.font = `${cell}px "JetBrains Mono", monospace`;
      context.textBaseline = "top";

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const n = flow(col, row, time);
          const level = Math.max(0, Math.min(1, (n + 1) / 2));

          if (level < 0.32) {
            continue;
          }

          const char = ramp[Math.floor(level * (ramp.length - 1))];
          const alpha = 0.03 + level * 0.15;

          context.fillStyle = `rgba(143, 156, 92, ${alpha.toFixed(3)})`;
          context.fillText(char, col * cell, row * cell);
        }
      }

      time += 0.014;
      frame = requestAnimationFrame(draw);
    }

    window.addEventListener("resize", resize);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && frame) {
        cancelAnimationFrame(frame);
      } else if (!document.hidden && !reduceMotion) {
        frame = requestAnimationFrame(draw);
      }
    });

    resize();

    if (reduceMotion) {
      draw();
      cancelAnimationFrame(frame);
    } else {
      draw();
    }
  })();

  /* ================================================================
     SORTING VISUALIZER
     ================================================================ */

  (() => {
    const stageElement = document.getElementById("sort-stage");
    const pointerElement = document.getElementById("sort-pointers");
    const algorithmElement = document.getElementById("sort-algo");
    const runButtonElement = document.getElementById("sort-run");
    const shuffleButtonElement =
      document.getElementById("sort-shuffle");
    const speedElement = document.getElementById("sort-speed");
    const comparisonsElement =
      document.getElementById("sort-comparisons");
    const swapsElement = document.getElementById("sort-swaps");
    const statusElement = document.getElementById("sort-status");
    const narrationElement = document.getElementById("sort-narration");
    const algoNameElement = document.getElementById("sort-algo-name");
    const algoComplexityElement = document.getElementById(
      "sort-algo-complexity"
    );
    const algoDescElement = document.getElementById("sort-algo-desc");

    if (
      !(stageElement instanceof HTMLDivElement) ||
      !(pointerElement instanceof HTMLDivElement) ||
      !(algorithmElement instanceof HTMLSelectElement) ||
      !(runButtonElement instanceof HTMLButtonElement) ||
      !(shuffleButtonElement instanceof HTMLButtonElement) ||
      !(speedElement instanceof HTMLInputElement) ||
      !(comparisonsElement instanceof HTMLElement) ||
      !(swapsElement instanceof HTMLElement) ||
      !(statusElement instanceof HTMLElement) ||
      !(narrationElement instanceof HTMLElement) ||
      !(algoNameElement instanceof HTMLElement) ||
      !(algoComplexityElement instanceof HTMLElement) ||
      !(algoDescElement instanceof HTMLElement)
    ) {
      return;
    }

    const stage = stageElement;
    const pointerRow = pointerElement;
    const algorithm = algorithmElement;
    const runButton = runButtonElement;
    const shuffleButton = shuffleButtonElement;
    const speed = speedElement;
    const comparisonsOutput = comparisonsElement;
    const swapsOutput = swapsElement;
    const statusOutput = statusElement;
    const narrationOutput = narrationElement;
    const algoNameOutput = algoNameElement;
    const algoComplexityOutput = algoComplexityElement;
    const algoDescOutput = algoDescElement;

    const COUNT = 20;

    type AlgoKey =
      | "bubble"
      | "selection"
      | "insertion"
      | "merge"
      | "quick";

    const algoInfo: Record<
      AlgoKey,
      Record<LangCode, { name: string; complexity: string; desc: string }>
    > = {
      bubble: {
        en: { name: "Bubble Sort", complexity: "O(n²) avg/worst · O(n) best", desc: "Walks the array repeatedly, swapping any two neighbors that are out of order. The j / j+1 tags below the bars mark the exact pair being compared right now." },
        fr: { name: "Tri à bulles", complexity: "O(n²) moy/pire · O(n) meilleur", desc: "Parcourt le tableau à répétition, échangeant deux voisins mal ordonnés. Les étiquettes j / j+1 sous les barres marquent la paire comparée en ce moment." },
        es: { name: "Ordenamiento de burbuja", complexity: "O(n²) prom/peor · O(n) mejor", desc: "Recorre el arreglo repetidamente, intercambiando cualquier par de vecinos que esté en el orden incorrecto. Las etiquetas j / j+1 bajo las barras marcan el par que se compara en este momento." },
      },
      selection: {
        en: { name: "Selection Sort", complexity: "O(n²) in every case", desc: "Scans the unsorted remainder for the smallest value, then swaps it to the front. min marks the smallest value found so far; j is the scanning pointer checking each candidate." },
        fr: { name: "Tri par sélection", complexity: "O(n²) dans tous les cas", desc: "Parcourt le reste non trié pour trouver la plus petite valeur, puis l'échange vers l'avant. min marque la plus petite valeur trouvée jusqu'ici ; j est le pointeur qui vérifie chaque candidat." },
        es: { name: "Ordenamiento por selección", complexity: "O(n²) en todos los casos", desc: "Recorre el resto sin ordenar buscando el valor más pequeño, y lo intercambia hacia el frente. min marca el menor valor encontrado hasta ahora; j es el puntero que revisa cada candidato." },
      },
      insertion: {
        en: { name: "Insertion Sort", complexity: "O(n²) avg/worst · O(n) best", desc: "Grows a sorted section one value at a time, sliding each new value left past anything bigger than it. key follows the value being inserted as it slides into place." },
        fr: { name: "Tri par insertion", complexity: "O(n²) moy/pire · O(n) meilleur", desc: "Fait grandir une section triée une valeur à la fois, en glissant chaque nouvelle valeur vers la gauche au-delà de tout ce qui est plus grand. key suit la valeur en cours d'insertion pendant qu'elle glisse à sa place." },
        es: { name: "Ordenamiento por inserción", complexity: "O(n²) prom/peor · O(n) mejor", desc: "Hace crecer una sección ordenada un valor a la vez, deslizando cada nuevo valor a la izquierda más allá de todo lo que es mayor. key sigue al valor que se está insertando mientras se desliza a su lugar." },
      },
      merge: {
        en: { name: "Merge Sort", complexity: "O(n log n) in every case", desc: "Splits the array in half recursively, then merges pairs of sorted halves back together. Dimmed bars are outside the current merge window; L and R mark the fronts of each half being compared." },
        fr: { name: "Tri fusion", complexity: "O(n log n) dans tous les cas", desc: "Divise le tableau en deux récursivement, puis fusionne les paires de moitiés triées. Les barres atténuées sont hors de la fenêtre de fusion actuelle ; L et R marquent les têtes de chaque moitié comparée." },
        es: { name: "Ordenamiento por mezcla", complexity: "O(n log n) en todos los casos", desc: "Divide el arreglo por la mitad recursivamente, y luego fusiona pares de mitades ordenadas. Las barras atenuadas están fuera de la ventana de fusión actual; L y R marcan los frentes de cada mitad comparada." },
      },
      quick: {
        en: { name: "Quick Sort", complexity: "O(n log n) avg · O(n²) worst", desc: "Picks a pivot (shown in red) and rearranges its subarray so smaller values end up left of it and larger values end up right, then repeats on each side. i marks the boundary, j is the scanning pointer." },
        fr: { name: "Tri rapide", complexity: "O(n log n) moy · O(n²) pire", desc: "Choisit un pivot (en rouge) et réorganise son sous-tableau pour que les valeurs plus petites se retrouvent à gauche et les plus grandes à droite, puis répète sur chaque côté. i marque la frontière, j est le pointeur de balayage." },
        es: { name: "Ordenamiento rápido", complexity: "O(n log n) prom · O(n²) peor", desc: "Elige un pivote (en rojo) y reorganiza su subarreglo para que los valores menores queden a su izquierda y los mayores a su derecha, y luego repite en cada lado. i marca el límite, j es el puntero de recorrido." },
      },
    };

    const sortMsg: Record<LangCode, Record<string, string>> = {
      en: {
        bubbleCompare: "Comparing {a} and {b} — are they in order?",
        bubbleSwap: "{b} was bigger, so swap — now reads {a}, {b}",
        bubblePass: "Pass {n} done — {v} is now in its final spot.",
        selectionCompare: "Is {j} smaller than current minimum {min}?",
        selectionSwap: "Smallest remaining value is {v} — moving it to position {i}",
        insertionCompare: "Does {a} still belong left of {b}?",
        insertionSwap: "Shifting it left — now reads {a}, {b}",
        mergeCompare: "Merging halves — which comes first, {a} or {b}?",
        quickCompare: "Is {v} smaller than pivot {p}?",
        quickSwap: "Moving {v} left of the boundary — it's smaller than the pivot",
        quickPlace: "Pivot {v} is now correctly placed — everything left is smaller, everything right is bigger",
        ready: "Ready — press Run to sort {count} bars with {algo}.",
        done: "Done — {comparisons} comparisons and {swaps} swaps to fully sort {count} bars.",
      },
      fr: {
        bubbleCompare: "Comparaison de {a} et {b} — sont-ils dans l'ordre ?",
        bubbleSwap: "{b} était plus grand, donc échange — on lit maintenant {a}, {b}",
        bubblePass: "Passage {n} terminé — {v} est maintenant à sa place finale.",
        selectionCompare: "{j} est-il plus petit que le minimum actuel {min} ?",
        selectionSwap: "La plus petite valeur restante est {v} — déplacement vers la position {i}",
        insertionCompare: "{a} appartient-il toujours à gauche de {b} ?",
        insertionSwap: "Décalage vers la gauche — on lit maintenant {a}, {b}",
        mergeCompare: "Fusion des moitiés — lequel vient en premier, {a} ou {b} ?",
        quickCompare: "{v} est-il plus petit que le pivot {p} ?",
        quickSwap: "Déplacement de {v} à gauche de la frontière — il est plus petit que le pivot",
        quickPlace: "Le pivot {v} est maintenant bien placé — tout ce qui est à gauche est plus petit, tout ce qui est à droite est plus grand",
        ready: "Prêt — appuyez sur Lancer pour trier {count} barres avec {algo}.",
        done: "Terminé — {comparisons} comparaisons et {swaps} échanges pour trier complètement {count} barres.",
      },
      es: {
        bubbleCompare: "Comparando {a} y {b} — ¿están en orden?",
        bubbleSwap: "{b} era mayor, así que se intercambia — ahora se lee {a}, {b}",
        bubblePass: "Pasada {n} completada — {v} ya está en su lugar final.",
        selectionCompare: "¿Es {j} menor que el mínimo actual {min}?",
        selectionSwap: "El menor valor restante es {v} — moviéndolo a la posición {i}",
        insertionCompare: "¿Sigue {a} perteneciendo a la izquierda de {b}?",
        insertionSwap: "Desplazándolo a la izquierda — ahora se lee {a}, {b}",
        mergeCompare: "Fusionando mitades — ¿cuál va primero, {a} o {b}?",
        quickCompare: "¿Es {v} menor que el pivote {p}?",
        quickSwap: "Moviendo {v} a la izquierda del límite — es menor que el pivote",
        quickPlace: "El pivote {v} ya quedó bien colocado — todo lo de la izquierda es menor, todo lo de la derecha es mayor",
        ready: "Listo — presiona Ejecutar para ordenar {count} barras con {algo}.",
        done: "Listo — {comparisons} comparaciones y {swaps} intercambios para ordenar por completo {count} barras.",
      },
    };

    function sortT(key: string, vars?: Record<string, string | number>): string {
      let str = sortMsg[currentLang][key] ?? sortMsg.en[key];
      if (vars) {
        for (const varKey in vars) {
          str = str.replace(new RegExp(`\\{${varKey}\\}`, "g"), String(vars[varKey]));
        }
      }
      return str;
    }

    function updateAlgoInfo(): void {
      const key = algorithm.value as AlgoKey;
      const info = (algoInfo[key] ?? algoInfo.quick)[currentLang];

      algoNameOutput.textContent = info.name;
      algoComplexityOutput.textContent = info.complexity;
      algoDescOutput.textContent = info.desc;
    }

    let values: number[] = [];
    let bars: HTMLDivElement[] = [];
    let valueLabels: HTMLSpanElement[] = [];
    let pointerSlots: HTMLDivElement[] = [];
    let running = false;

    let comparisons = 0;
    let swaps = 0;

    const OLIVE = "var(--olive-bright)";
    const GOLD = "var(--gold)";
    const RUST = "var(--rust)";

    const delay = (): number =>
      Math.max(8, 260 - Number(speed.value) * 2.2);

    function createArray(): void {
      values = Array.from(
        { length: COUNT },
        () => Math.floor(Math.random() * 88) + 8
      );
    }

    function render(): void {
      stage.innerHTML = "";
      pointerRow.innerHTML = "";

      bars = [];
      valueLabels = [];
      pointerSlots = [];

      values.forEach((value) => {
        const bar = document.createElement("div");
        bar.className = "viz-bar";
        bar.style.height = `${value}%`;

        const label = document.createElement("span");
        label.className = "bar-value";
        label.textContent = String(value);
        bar.appendChild(label);

        stage.appendChild(bar);
        bars.push(bar);
        valueLabels.push(label);

        const slot = document.createElement("div");
        slot.className = "pointer-slot";
        pointerRow.appendChild(slot);
        pointerSlots.push(slot);
      });
    }

    function updateMetrics(): void {
      comparisonsOutput.textContent = String(comparisons);
      swapsOutput.textContent = String(swaps);
    }

    function clearPointers(): void {
      pointerSlots.forEach((slot) => {
        slot.textContent = "";
        slot.style.color = "transparent";
      });
    }

    function setPointer(index: number, text: string, color: string): void {
      const slot = pointerSlots[index];

      if (slot) {
        slot.textContent = text;
        slot.style.color = color;
      }
    }

    function setActiveRange(left: number, right: number): void {
      bars.forEach((bar, index) => {
        bar.classList.toggle("dim", index < left || index > right);
      });
    }

    function clearActiveRange(): void {
      bars.forEach((bar) => bar.classList.remove("dim"));
    }

    function clearMarks(): void {
      bars.forEach((bar) => {
        bar.classList.remove("compare", "swap");
      });

      clearPointers();
    }

    function updateBar(index: number): void {
      const bar = bars[index];
      const label = valueLabels[index];

      if (bar) {
        bar.style.height = `${values[index]}%`;
      }

      if (label) {
        label.textContent = String(values[index]);
      }
    }

    async function highlight(
      indices: number[],
      className: "compare" | "swap",
      note?: string
    ): Promise<void> {
      bars.forEach((bar) => bar.classList.remove("compare", "swap"));

      indices.forEach((index) => {
        bars[index]?.classList.add(className);
      });

      if (note) {
        narrationOutput.textContent = note;
      }

      await sleep(delay());
    }

    async function bubbleSort(): Promise<void> {
      for (let i = 0; i < values.length - 1; i++) {
        let changed = false;

        for (let j = 0; j < values.length - i - 1; j++) {
          comparisons++;
          updateMetrics();

          clearPointers();
          setPointer(j, "j", OLIVE);
          setPointer(j + 1, "j+1", GOLD);

          await highlight(
            [j, j + 1],
            "compare",
            sortT("bubbleCompare", { a: values[j], b: values[j + 1] })
          );

          if (values[j] > values[j + 1]) {
            [values[j], values[j + 1]] = [
              values[j + 1],
              values[j],
            ];

            swaps++;
            changed = true;

            updateBar(j);
            updateBar(j + 1);
            updateMetrics();

            clearPointers();
            setPointer(j, "j", OLIVE);
            setPointer(j + 1, "j+1", GOLD);

            await highlight(
              [j, j + 1],
              "swap",
              sortT("bubbleSwap", { a: values[j], b: values[j + 1] })
            );
          }
        }

        bars[values.length - i - 1]?.classList.add("sorted");
        narrationOutput.textContent = sortT("bubblePass", {
          n: i + 1,
          v: values[values.length - i - 1],
        });

        if (!changed) {
          break;
        }
      }

      clearPointers();
    }

    async function selectionSort(): Promise<void> {
      for (let i = 0; i < values.length; i++) {
        let minimum = i;

        for (let j = i + 1; j < values.length; j++) {
          comparisons++;
          updateMetrics();

          clearPointers();
          setPointer(minimum, "min", OLIVE);
          setPointer(j, "j", GOLD);

          await highlight(
            [minimum, j],
            "compare",
            sortT("selectionCompare", { j: values[j], min: values[minimum] })
          );

          if (values[j] < values[minimum]) {
            minimum = j;
          }
        }

        if (minimum !== i) {
          [values[i], values[minimum]] = [
            values[minimum],
            values[i],
          ];

          swaps++;

          updateBar(i);
          updateBar(minimum);
          updateMetrics();

          clearPointers();
          setPointer(i, "i", OLIVE);
          setPointer(minimum, "min", GOLD);

          await highlight(
            [i, minimum],
            "swap",
            sortT("selectionSwap", { v: values[i], i })
          );
        }

        bars[i]?.classList.add("sorted");
      }

      clearPointers();
    }

    async function insertionSort(): Promise<void> {
      for (let i = 1; i < values.length; i++) {
        let j = i;

        while (j > 0) {
          comparisons++;
          updateMetrics();

          clearPointers();
          setPointer(j, "key", GOLD);
          setPointer(j - 1, "j-1", OLIVE);

          await highlight(
            [j - 1, j],
            "compare",
            sortT("insertionCompare", { a: values[j], b: values[j - 1] })
          );

          if (values[j - 1] <= values[j]) {
            break;
          }

          [values[j - 1], values[j]] = [
            values[j],
            values[j - 1],
          ];

          swaps++;

          updateBar(j - 1);
          updateBar(j);
          updateMetrics();

          clearPointers();
          setPointer(j - 1, "key", GOLD);

          await highlight(
            [j - 1, j],
            "swap",
            sortT("insertionSwap", { a: values[j - 1], b: values[j] })
          );

          j--;
        }
      }

      clearPointers();

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });
    }

    async function mergeSort(): Promise<void> {
      async function merge(
        left: number,
        middle: number,
        right: number
      ): Promise<void> {
        setActiveRange(left, right);
        clearPointers();

        const first = values.slice(left, middle + 1);
        const second = values.slice(middle + 1, right + 1);

        let i = 0;
        let j = 0;
        let position = left;

        while (i < first.length && j < second.length) {
          comparisons++;
          updateMetrics();

          clearPointers();
          setPointer(left + i, "L", OLIVE);
          setPointer(middle + 1 + j, "R", GOLD);

          await highlight(
            [left + i, middle + 1 + j],
            "compare",
            sortT("mergeCompare", { a: first[i], b: second[j] })
          );

          if (first[i] <= second[j]) {
            values[position] = first[i];
            i++;
          } else {
            values[position] = second[j];
            j++;
          }

          updateBar(position);

          swaps++;
          updateMetrics();

          position++;
        }

        while (i < first.length) {
          values[position] = first[i];

          updateBar(position);

          i++;
          position++;
        }

        while (j < second.length) {
          values[position] = second[j];

          updateBar(position);

          j++;
          position++;
        }

        clearPointers();

        await sleep(delay());
      }

      async function sort(
        left: number,
        right: number
      ): Promise<void> {
        if (left >= right) {
          return;
        }

        const middle = Math.floor((left + right) / 2);

        await sort(left, middle);
        await sort(middle + 1, right);
        await merge(left, middle, right);
      }

      await sort(0, values.length - 1);

      clearActiveRange();
      clearPointers();

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });
    }

    async function quickSort(): Promise<void> {
      async function partition(
        left: number,
        right: number
      ): Promise<number> {
        setActiveRange(left, right);

        const pivot = values[right];
        let index = left;

        bars[right]?.classList.add("pivot");

        for (let i = left; i < right; i++) {
          comparisons++;
          updateMetrics();

          clearPointers();
          setPointer(right, "pivot", RUST);
          setPointer(index, "i", OLIVE);
          setPointer(i, "j", GOLD);

          await highlight(
            [i, right],
            "compare",
            sortT("quickCompare", { v: values[i], p: pivot })
          );

          if (values[i] < pivot) {
            [values[index], values[i]] = [
              values[i],
              values[index],
            ];

            swaps++;

            updateBar(index);
            updateBar(i);
            updateMetrics();

            clearPointers();
            setPointer(right, "pivot", RUST);
            setPointer(index, "i", OLIVE);

            await highlight(
              [index, i],
              "swap",
              sortT("quickSwap", { v: values[index] })
            );

            index++;
          }
        }

        bars[right]?.classList.remove("pivot");
        clearPointers();

        [values[index], values[right]] = [
          values[right],
          values[index],
        ];

        swaps++;

        updateBar(index);
        updateBar(right);
        updateMetrics();

        await highlight(
          [index, right],
          "swap",
          sortT("quickPlace", { v: values[index] })
        );

        bars[index]?.classList.add("sorted");

        return index;
      }

      async function sort(
        left: number,
        right: number
      ): Promise<void> {
        if (left >= right) {
          return;
        }

        const pivot = await partition(left, right);

        await sort(left, pivot - 1);
        await sort(pivot + 1, right);
      }

      await sort(0, values.length - 1);

      clearActiveRange();
      clearPointers();

      bars.forEach((bar) => {
        bar.classList.remove("pivot");
        bar.classList.add("sorted");
      });
    }

    async function run(): Promise<void> {
      if (running) {
        return;
      }

      running = true;

      runButton.disabled = true;
      shuffleButton.disabled = true;
      algorithm.disabled = true;

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      bars.forEach((bar) => {
        bar.classList.remove("sorted", "dim", "pivot");
      });

      clearPointers();

      statusOutput.textContent = "Running";

      const selected = algorithm.value;

      if (selected === "bubble") {
        await bubbleSort();
      } else if (selected === "selection") {
        await selectionSort();
      } else if (selected === "insertion") {
        await insertionSort();
      } else if (selected === "merge") {
        await mergeSort();
      } else {
        await quickSort();
      }

      clearMarks();
      clearActiveRange();

      bars.forEach((bar) => {
        bar.classList.remove("pivot");
        bar.classList.add("sorted");
      });

      statusOutput.textContent = "Complete";
      narrationOutput.textContent = sortT("done", {
        comparisons,
        swaps,
        count: COUNT,
      });

      running = false;

      runButton.disabled = false;
      shuffleButton.disabled = false;
      algorithm.disabled = false;
    }

    function shuffle(): void {
      if (running) {
        return;
      }

      createArray();
      render();

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      statusOutput.textContent = "Ready";
      narrationOutput.textContent = sortT("ready", {
        count: COUNT,
        algo: (algoInfo[algorithm.value as AlgoKey] ?? algoInfo.quick)[currentLang].name,
      });
    }

    runButton.addEventListener("click", () => {
      void run();
    });

    shuffleButton.addEventListener("click", shuffle);

    algorithm.addEventListener("change", () => {
      updateAlgoInfo();

      if (!running) {
        narrationOutput.textContent = sortT("ready", {
          count: COUNT,
          algo: (algoInfo[algorithm.value as AlgoKey] ?? algoInfo.quick)[currentLang].name,
        });
      }
    });

    onLangChange(() => {
      updateAlgoInfo();

      if (!running) {
        narrationOutput.textContent = sortT("ready", {
          count: COUNT,
          algo: (algoInfo[algorithm.value as AlgoKey] ?? algoInfo.quick)[currentLang].name,
        });
      }
    });

    updateAlgoInfo();
    shuffle();
  })();

  /* ================================================================
     HASH TABLE
     ================================================================ */

  (() => {
    const bucketsElement = document.getElementById("hash-buckets");
    const keyElement = document.getElementById("hash-key");
    const valueElement = document.getElementById("hash-value");
    const insertElement = document.getElementById("hash-insert");
    const randomElement = document.getElementById("hash-random");
    const clearElement = document.getElementById("hash-clear");
    const formulaElement = document.getElementById("hash-formula");
    const loadElement = document.getElementById("hash-load");

    if (
      !(bucketsElement instanceof HTMLDivElement) ||
      !(keyElement instanceof HTMLInputElement) ||
      !(valueElement instanceof HTMLInputElement) ||
      !(insertElement instanceof HTMLButtonElement) ||
      !(randomElement instanceof HTMLButtonElement) ||
      !(clearElement instanceof HTMLButtonElement) ||
      !(formulaElement instanceof HTMLElement) ||
      !(loadElement instanceof HTMLElement)
    ) {
      return;
    }

    const buckets = bucketsElement;
    const keyInput = keyElement;
    const valueInput = valueElement;
    const insertButton = insertElement;
    const randomButton = randomElement;
    const clearButton = clearElement;
    const formula = formulaElement;
    const load = loadElement;

    const BUCKETS = 8;

    type Entry = {
      key: string;
      value: string;
    };

    const hashMsg: Record<LangCode, { ready: string; bucket: string; insert: string; collision: string }> = {
      en: { ready: "Ready for insertion.", bucket: "bucket {n}", insert: 'hash("{key}") → {index} / bucket {index}', collision: " / collision → chaining" },
      fr: { ready: "Prêt pour l'insertion.", bucket: "compartiment {n}", insert: 'hash("{key}") → {index} / compartiment {index}', collision: " / collision → chaînage" },
      es: { ready: "Listo para insertar.", bucket: "cubeta {n}", insert: 'hash("{key}") → {index} / cubeta {index}', collision: " / colisión → encadenamiento" },
    };

    let table: Entry[][] = Array.from(
      { length: BUCKETS },
      () => []
    );

    let lastFormula: string | null = null;

    function hash(key: string): number {
      let value = 0;

      for (let i = 0; i < key.length; i++) {
        value =
          (value * 31 + key.charCodeAt(i)) >>> 0;
      }

      return value % BUCKETS;
    }

    function render(): void {
      buckets.innerHTML = "";

      let count = 0;

      table.forEach((chain, index) => {
        count += chain.length;

        const bucket = document.createElement("div");
        bucket.className = "hash-bucket";

        const label = document.createElement("div");
        label.className = "hash-index";
        label.textContent = hashMsg[currentLang].bucket.replace("{n}", String(index));

        bucket.appendChild(label);

        const chainElement =
          document.createElement("div");

        chainElement.className = "hash-chain";

        chain.forEach((entry, entryIndex) => {
          const node = document.createElement("div");

          node.className =
            "hash-node" +
            (chain.length > 1 ? " collision" : "");

          node.textContent =
            `${entry.key} → ${entry.value}`;

          chainElement.appendChild(node);

          if (entryIndex < chain.length - 1) {
            const arrow = document.createElement("div");

            arrow.className = "hash-arrow";
            arrow.textContent = "↓";

            chainElement.appendChild(arrow);
          }
        });

        bucket.appendChild(chainElement);
        buckets.appendChild(bucket);
      });

      load.textContent =
        (count / BUCKETS).toFixed(2);
    }

    function insert(
      key: string,
      value: string
    ): void {
      if (!key) {
        return;
      }

      const index = hash(key);
      const chain = table[index];

      const existing = chain.find(
        (entry) => entry.key === key
      );

      if (existing) {
        existing.value = value || existing.value;
      } else {
        chain.push({
          key,
          value: value || "—",
        });
      }

      lastFormula =
        hashMsg[currentLang].insert
          .replace(/{key}/g, key)
          .replace(/{index}/g, String(index)) +
        (chain.length > 1 ? hashMsg[currentLang].collision : "");

      formula.textContent = lastFormula;

      render();
    }

    function randomKey(): string {
      const words = [
        "node",
        "heap",
        "tree",
        "graph",
        "byte",
        "stack",
        "queue",
        "hash",
        "sort",
        "data",
      ];

      return (
        words[
          Math.floor(
            Math.random() * words.length
          )
        ] +
        Math.floor(Math.random() * 100)
      );
    }

    insertButton.addEventListener("click", () => {
      insert(
        keyInput.value.trim(),
        valueInput.value.trim()
      );

      keyInput.value = "";
      valueInput.value = "";

      keyInput.focus();
    });

    keyInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    valueInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    randomButton.addEventListener("click", () => {
      insert(
        randomKey(),
        String(
          Math.floor(Math.random() * 1000)
        )
      );
    });

    clearButton.addEventListener("click", () => {
      table = Array.from(
        { length: BUCKETS },
        () => []
      );

      lastFormula = null;
      formula.textContent = hashMsg[currentLang].ready;

      render();
    });

    onLangChange(() => {
      if (lastFormula === null) {
        formula.textContent = hashMsg[currentLang].ready;
      }
      render();
    });

    render();
  })();

  /* ================================================================
     PATHFINDING
     ================================================================ */

  (() => {
    const gridElement = document.getElementById("path-grid");
    const algorithmElement = document.getElementById("path-algo");
    const runElement = document.getElementById("path-run");
    const wallsElement = document.getElementById("path-walls");
    const clearElement = document.getElementById("path-clear");
    const visitedElement = document.getElementById("path-visited");
    const lengthElement = document.getElementById("path-length");
    const statusElement = document.getElementById("path-status");

    if (
      !(gridElement instanceof HTMLDivElement) ||
      !(algorithmElement instanceof HTMLSelectElement) ||
      !(runElement instanceof HTMLButtonElement) ||
      !(wallsElement instanceof HTMLButtonElement) ||
      !(clearElement instanceof HTMLButtonElement) ||
      !(visitedElement instanceof HTMLElement) ||
      !(lengthElement instanceof HTMLElement) ||
      !(statusElement instanceof HTMLElement)
    ) {
      return;
    }

    const gridContainer = gridElement;
    const algorithm = algorithmElement;
    const runButton = runElement;
    const wallsButton = wallsElement;
    const clearButton = clearElement;
    const visitedOutput = visitedElement;
    const lengthOutput = lengthElement;
    const statusOutput = statusElement;

    const pathMsg: Record<LangCode, { ready: string; searching: string; notFound: string; found: string }> = {
      en: { ready: "Ready", searching: "Searching", notFound: "No path found", found: "Path found" },
      fr: { ready: "Prêt", searching: "Recherche", notFound: "Aucun chemin trouvé", found: "Chemin trouvé" },
      es: { ready: "Listo", searching: "Buscando", notFound: "No se encontró camino", found: "Camino encontrado" },
    };

    let lastStatusKey: "ready" | "searching" | "notFound" | "found" = "ready";

    function setStatus(key: "ready" | "searching" | "notFound" | "found"): void {
      lastStatusKey = key;
      statusOutput.textContent = pathMsg[currentLang][key];
    }

    const ROWS = 14;
    const COLS = 28;

    type Point = {
      r: number;
      c: number;
    };

    type Cell =
      | "empty"
      | "wall"
      | "start"
      | "end"
      | "visited"
      | "path";

    type SearchResult = {
      found: boolean;
      order: Point[];
      cameFrom: Map<string, Point>;
    };

    let grid: Cell[][] = [];
    let cells: HTMLDivElement[][] = [];

    let start: Point = {
      r: 7,
      c: 3,
    };

    let end: Point = {
      r: 7,
      c: 24,
    };

    let running = false;

    let dragMode:
      | "wall"
      | "erase"
      | "start"
      | "end"
      | null = null;

    function createGrid(): void {
      grid = Array.from(
        { length: ROWS },
        () =>
          Array.from(
            { length: COLS },
            () => "empty" as Cell
          )
      );

      grid[start.r][start.c] = "start";
      grid[end.r][end.c] = "end";
    }

    function cellClass(cell: Cell): string {
      return cell === "empty"
        ? "path-cell"
        : `path-cell ${cell}`;
    }

    function render(): void {
      gridContainer.innerHTML = "";
      cells = [];

      for (let r = 0; r < ROWS; r++) {
        const row: HTMLDivElement[] = [];

        for (let c = 0; c < COLS; c++) {
          const element =
            document.createElement("div");

          element.className =
            cellClass(grid[r][c]);

          element.addEventListener(
            "mousedown",
            (event) => {
              event.preventDefault();
              handleDown(r, c);
            }
          );

          element.addEventListener(
            "mouseenter",
            () => {
              handleEnter(r, c);
            }
          );

          gridContainer.appendChild(element);

          row.push(element);
        }

        cells.push(row);
      }
    }

    function setCell(
      r: number,
      c: number,
      state: Cell
    ): void {
      grid[r][c] = state;

      const element = cells[r]?.[c];

      if (element) {
        element.className =
          cellClass(state);
      }
    }

    function handleDown(
      r: number,
      c: number
    ): void {
      if (running) {
        return;
      }

      const state = grid[r][c];

      if (state === "start") {
        dragMode = "start";
        return;
      }

      if (state === "end") {
        dragMode = "end";
        return;
      }

      dragMode =
        state === "wall"
          ? "erase"
          : "wall";

      toggleWall(r, c);
    }

    function handleEnter(
      r: number,
      c: number
    ): void {
      if (running || !dragMode) {
        return;
      }

      if (dragMode === "wall") {
        toggleWall(r, c, true);
        return;
      }

      if (dragMode === "erase") {
        toggleWall(r, c, false);
        return;
      }

      if (dragMode === "start") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "end"
        ) {
          return;
        }

        setCell(
          start.r,
          start.c,
          "empty"
        );

        start = { r, c };

        setCell(r, c, "start");

        return;
      }

      if (dragMode === "end") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "start"
        ) {
          return;
        }

        setCell(
          end.r,
          end.c,
          "empty"
        );

        end = { r, c };

        setCell(r, c, "end");
      }
    }

    function toggleWall(
      r: number,
      c: number,
      force?: boolean
    ): void {
      if (
        grid[r][c] === "start" ||
        grid[r][c] === "end"
      ) {
        return;
      }

      const shouldWall =
        force === undefined
          ? grid[r][c] !== "wall"
          : force;

      setCell(
        r,
        c,
        shouldWall
          ? "wall"
          : "empty"
      );
    }

    document.addEventListener(
      "mouseup",
      () => {
        dragMode = null;
      }
    );

    function pointKey(point: Point): string {
      return `${point.r},${point.c}`;
    }

    function neighbors(
      point: Point
    ): Point[] {
      const directions: Point[] = [
        { r: -1, c: 0 },
        { r: 1, c: 0 },
        { r: 0, c: -1 },
        { r: 0, c: 1 },
      ];

      const result: Point[] = [];

      for (const direction of directions) {
        const r =
          point.r + direction.r;

        const c =
          point.c + direction.c;

        if (
          r >= 0 &&
          r < ROWS &&
          c >= 0 &&
          c < COLS &&
          grid[r][c] !== "wall"
        ) {
          result.push({ r, c });
        }
      }

      return result;
    }

    function heuristic(
      point: Point
    ): number {
      return (
        Math.abs(point.r - end.r) +
        Math.abs(point.c - end.c)
      );
    }

    function bfs(): SearchResult {
      const queue: Point[] = [start];

      const visited =
        new Set<string>([
          pointKey(start),
        ]);

      const cameFrom =
        new Map<string, Point>();

      const order: Point[] = [];

      while (queue.length > 0) {
        const current =
          queue.shift();

        if (!current) {
          break;
        }

        const currentKey =
          pointKey(current);

        if (
          currentKey !==
          pointKey(start)
        ) {
          order.push(current);
        }

        if (
          currentKey ===
          pointKey(end)
        ) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        for (
          const next of neighbors(current)
        ) {
          const nextKey =
            pointKey(next);

          if (visited.has(nextKey)) {
            continue;
          }

          visited.add(nextKey);

          cameFrom.set(
            nextKey,
            current
          );

          queue.push(next);
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    function weighted(
      mode: "dijkstra" | "astar"
    ): SearchResult {
      const open: {
        point: Point;
        priority: number;
      }[] = [
        {
          point: start,
          priority: 0,
        },
      ];

      const distances =
        new Map<string, number>();

      distances.set(
        pointKey(start),
        0
      );

      const cameFrom =
        new Map<string, Point>();

      const closed =
        new Set<string>();

      const order: Point[] = [];

      while (open.length > 0) {
        open.sort(
          (a, b) =>
            a.priority - b.priority
        );

        const currentEntry =
          open.shift();

        if (!currentEntry) {
          break;
        }

        const current =
          currentEntry.point;

        const currentKey =
          pointKey(current);

        if (closed.has(currentKey)) {
          continue;
        }

        closed.add(currentKey);

        if (
          currentKey !==
          pointKey(start)
        ) {
          order.push(current);
        }

        if (
          currentKey ===
          pointKey(end)
        ) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        const currentDistance =
          distances.get(
            currentKey
          ) ?? Infinity;

        for (
          const next of neighbors(current)
        ) {
          const nextKey =
            pointKey(next);

          if (closed.has(nextKey)) {
            continue;
          }

          const newCost =
            currentDistance + 1;

          const oldCost =
            distances.get(
              nextKey
            ) ?? Infinity;

          if (newCost < oldCost) {
            distances.set(
              nextKey,
              newCost
            );

            cameFrom.set(
              nextKey,
              current
            );

            const priority =
              mode === "astar"
                ? newCost +
                  heuristic(next)
                : newCost;

            open.push({
              point: next,
              priority,
            });
          }
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    async function animateSearch(
      order: Point[]
    ): Promise<void> {
      for (
        let i = 0;
        i < order.length;
        i++
      ) {
        const point = order[i];

        if (
          grid[point.r][point.c] ===
          "empty"
        ) {
          setCell(
            point.r,
            point.c,
            "visited"
          );
        }

        visitedOutput.textContent =
          String(i + 1);

        await sleep(7);
      }
    }

    function reconstruct(
      cameFrom: Map<string, Point>
    ): Point[] {
      const path: Point[] = [];

      let current = end;

      while (
        pointKey(current) !==
        pointKey(start)
      ) {
        path.push(current);

        const previous =
          cameFrom.get(
            pointKey(current)
          );

        if (!previous) {
          return [];
        }

        current = previous;
      }

      path.reverse();

      return path;
    }

    function resetSearchMarks(): void {
      for (
        let r = 0;
        r < ROWS;
        r++
      ) {
        for (
          let c = 0;
          c < COLS;
          c++
        ) {
          if (
            grid[r][c] === "visited" ||
            grid[r][c] === "path"
          ) {
            setCell(
              r,
              c,
              "empty"
            );
          }
        }
      }

      setCell(
        start.r,
        start.c,
        "start"
      );

      setCell(
        end.r,
        end.c,
        "end"
      );
    }

    function setControls(
      enabled: boolean
    ): void {
      runButton.disabled = !enabled;
      wallsButton.disabled = !enabled;
      clearButton.disabled = !enabled;
      algorithm.disabled = !enabled;
    }

    async function run(): Promise<void> {
      if (running) {
        return;
      }

      running = true;

      setControls(false);

      setStatus("searching");

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      resetSearchMarks();

      const selected =
        algorithm.value;

      const result =
        selected === "bfs"
          ? bfs()
          : weighted(
              selected === "astar"
                ? "astar"
                : "dijkstra"
            );

      await animateSearch(
        result.order
      );

      if (!result.found) {
        setStatus("notFound");

        running = false;

        setControls(true);

        return;
      }

      const path =
        reconstruct(
          result.cameFrom
        );

      for (const point of path) {
        if (
          pointKey(point) !==
          pointKey(end)
        ) {
          setCell(
            point.r,
            point.c,
            "path"
          );
        }

        await sleep(18);
      }

      lengthOutput.textContent =
        String(path.length);

      setStatus("found");

      running = false;

      setControls(true);
    }

    function randomWalls(): void {
      if (running) {
        return;
      }

      createGrid();

      for (
        let r = 0;
        r < ROWS;
        r++
      ) {
        for (
          let c = 0;
          c < COLS;
          c++
        ) {
          if (
            grid[r][c] === "empty" &&
            Math.random() < 0.25
          ) {
            grid[r][c] = "wall";
          }
        }
      }

      grid[start.r][start.c] =
        "start";

      grid[end.r][end.c] =
        "end";

      render();

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      setStatus("ready");
    }

    function clear(): void {
      if (running) {
        return;
      }

      createGrid();
      render();

      visitedOutput.textContent =
        "0";

      lengthOutput.textContent =
        "—";

      setStatus("ready");
    }

    runButton.addEventListener(
      "click",
      () => {
        void run();
      }
    );

    wallsButton.addEventListener(
      "click",
      randomWalls
    );

    clearButton.addEventListener(
      "click",
      clear
    );

    onLangChange(() => {
      if (!running) {
        setStatus(lastStatusKey);
      }
    });

    createGrid();
    render();
  })();
</script>