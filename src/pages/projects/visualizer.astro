---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Algorithm Visualizer">
  <main class="algorithm-page">

```
<!-- ========================================================= -->
<!-- DOCUMENTATION HEADER                                      -->
<!-- ========================================================= -->

<div class="doc-shell">

  <aside class="doc-sidebar">
    <a href="/projects" class="back-link">
      <span>←</span>
      <span>Back to projects</span>
    </a>

    <div class="sidebar-title">
      <span class="status-dot"></span>
      <span>ALGORITHM LAB</span>
    </div>

    <nav>
      <a href="#sorting" class="nav-link active">
        <span>01</span>
        Sorting
      </a>

      <a href="#hash-table" class="nav-link">
        <span>02</span>
        Hash Table
      </a>

      <a href="#pathfinding" class="nav-link">
        <span>03</span>
        Pathfinding
      </a>
    </nav>

    <div class="sidebar-footer">
      <span>Interactive documentation</span>
      <span>Astro · TypeScript</span>
    </div>
  </aside>

  <!-- ======================================================= -->
  <!-- MAIN DOCUMENTATION                                     -->
  <!-- ======================================================= -->

  <div class="doc-content">

    <header class="doc-hero">

      <div class="eyebrow">
        <span>PROJECT 04</span>
        <span class="eyebrow-line"></span>
        <span>CS FUNDAMENTALS</span>
      </div>

      <h1>
        Algorithms<span>.</span>
      </h1>

      <p>
        Interactive visualizations for understanding how classic
        algorithms manipulate data, resolve collisions and explore
        search spaces.
      </p>

      <div class="tech-row">
        <span>Astro</span>
        <span>TypeScript</span>
        <span>Data Structures</span>
        <span>Algorithms</span>
      </div>

    </header>

    <!-- ===================================================== -->
    <!-- SORTING                                               -->
    <!-- ===================================================== -->

    <section id="sorting" class="doc-section">

      <div class="section-heading">

        <div class="section-number">01</div>

        <div>
          <div class="section-kicker">SORTING</div>

          <h2>Sorting algorithms</h2>

          <p>
            Watch algorithms compare, move and reorder values in real
            time. Select an algorithm and control the animation speed.
          </p>
        </div>

      </div>

      <div class="algorithm-panel">

        <div class="panel-toolbar">

          <div class="toolbar-left">

            <label class="control-label">
              Algorithm

              <select id="sort-algo" class="control-select">
                <option value="bubble">Bubble Sort</option>
                <option value="selection">Selection Sort</option>
                <option value="insertion">Insertion Sort</option>
                <option value="merge">Merge Sort</option>
                <option value="quick" selected>Quick Sort</option>
              </select>
            </label>

            <button id="sort-run" class="control-button primary">
              <span>▶</span>
              Run
            </button>

            <button id="sort-shuffle" class="control-button">
              Shuffle
            </button>

          </div>

          <label class="speed-control">
            <span>Speed</span>
            <input
              id="sort-speed"
              type="range"
              min="1"
              max="100"
              value="65"
            />
          </label>

        </div>

        <div class="visual-stage sorting-stage">

          <div
            id="sort-stage"
            class="sort-bars"
            aria-label="Sorting visualization"
          ></div>

        </div>

        <div class="legend">

          <span>
            <i class="legend-dot comparison"></i>
            Comparison
          </span>

          <span>
            <i class="legend-dot swap"></i>
            Swap
          </span>

          <span>
            <i class="legend-dot sorted"></i>
            Sorted
          </span>

        </div>

        <div class="stats">

          <div class="stat">
            <span>Comparisons</span>
            <strong id="sort-comparisons">0</strong>
          </div>

          <div class="stat">
            <span>Swaps</span>
            <strong id="sort-swaps">0</strong>
          </div>

          <div class="stat">
            <span>Status</span>
            <strong id="sort-status">Idle</strong>
          </div>

        </div>

      </div>

      <div class="complexity-grid">

        <div>
          <span>Bubble</span>
          <strong>O(n²)</strong>
        </div>

        <div>
          <span>Selection</span>
          <strong>O(n²)</strong>
        </div>

        <div>
          <span>Insertion</span>
          <strong>O(n²)</strong>
        </div>

        <div>
          <span>Merge</span>
          <strong>O(n log n)</strong>
        </div>

        <div>
          <span>Quick</span>
          <strong>O(n log n)</strong>
        </div>

      </div>

    </section>

    <!-- ===================================================== -->
    <!-- HASH TABLE                                            -->
    <!-- ===================================================== -->

    <section id="hash-table" class="doc-section">

      <div class="section-heading">

        <div class="section-number">02</div>

        <div>
          <div class="section-kicker">DATA STRUCTURES</div>

          <h2>Hash table</h2>

          <p>
            Insert key/value pairs into a table using a simple hash
            function. Collisions are resolved using separate chaining.
          </p>
        </div>

      </div>

      <div class="algorithm-panel">

        <div class="panel-toolbar hash-toolbar">

          <div class="hash-inputs">

            <input
              id="hash-key"
              class="control-input"
              type="text"
              maxlength="16"
              placeholder="key"
            />

            <input
              id="hash-value"
              class="control-input"
              type="text"
              maxlength="16"
              placeholder="value"
            />

            <button id="hash-insert" class="control-button primary">
              Insert
            </button>

            <button id="hash-random" class="control-button">
              Random
            </button>

            <button id="hash-clear" class="control-button">
              Clear
            </button>

          </div>

        </div>

        <div id="hash-formula" class="formula">
          Ready for insertion.
        </div>

        <div
          id="hash-buckets"
          class="hash-grid"
          aria-label="Hash table"
        ></div>

        <div class="hash-footer">

          <span>
            Load factor
            <strong id="hash-load">0.00</strong>
          </span>

          <span>
            Buckets
            <strong>8</strong>
          </span>

          <span>
            Collision strategy
            <strong>Chaining</strong>
          </span>

        </div>

      </div>

    </section>

    <!-- ===================================================== -->
    <!-- PATHFINDING                                           -->
    <!-- ===================================================== -->

    <section id="pathfinding" class="doc-section">

      <div class="section-heading">

        <div class="section-number">03</div>

        <div>
          <div class="section-kicker">GRAPH SEARCH</div>

          <h2>Pathfinding</h2>

          <p>
            Draw obstacles on the grid and watch BFS, Dijkstra or A*
            explore the search space until the shortest path is found.
          </p>
        </div>

      </div>

      <div class="algorithm-panel">

        <div class="panel-toolbar">

          <div class="toolbar-left">

            <label class="control-label">
              Algorithm

              <select id="path-algo" class="control-select">
                <option value="bfs">Breadth-First Search</option>
                <option value="dijkstra">Dijkstra</option>
                <option value="astar" selected>A*</option>
              </select>
            </label>

            <button id="path-run" class="control-button primary">
              <span>▶</span>
              Run
            </button>

            <button id="path-walls" class="control-button">
              Random walls
            </button>

            <button id="path-clear" class="control-button">
              Clear
            </button>

          </div>

        </div>

        <div class="path-instructions">
          <span><kbd>CLICK</kbd> Draw walls</span>
          <span><kbd>DRAG</kbd> Move start/end</span>
        </div>

        <div
          id="path-grid"
          class="path-grid"
          aria-label="Pathfinding grid"
        ></div>

        <div class="legend">

          <span>
            <i class="legend-dot start-dot"></i>
            Start
          </span>

          <span>
            <i class="legend-dot end-dot"></i>
            End
          </span>

          <span>
            <i class="legend-dot visited-dot"></i>
            Visited
          </span>

          <span>
            <i class="legend-dot path-dot"></i>
            Shortest path
          </span>

        </div>

        <div class="stats">

          <div class="stat">
            <span>Visited</span>
            <strong id="path-visited">0</strong>
          </div>

          <div class="stat">
            <span>Path length</span>
            <strong id="path-length">—</strong>
          </div>

          <div class="stat">
            <span>Status</span>
            <strong id="path-status">Idle</strong>
          </div>

        </div>

      </div>

    </section>

  </div>

</div>
```

  </main>
</Layout>

<style>

  /* ============================================================= */
  /* BASE                                                         */
  /* ============================================================= */

  :global(html) {
    scroll-behavior: smooth;
  }

  .algorithm-page {
    min-height: 100vh;
    color: var(--white);
    padding: 6rem 1.25rem;
    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(37, 99, 235, 0.08),
        transparent 35%
      );
  }

  .doc-shell {
    max-width: 1400px;
    margin: auto;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 5rem;
  }

  /* ============================================================= */
  /* SIDEBAR                                                       */
  /* ============================================================= */

  .doc-sidebar {
    position: sticky;
    top: 5rem;
    height: calc(100vh - 10rem);
    display: flex;
    flex-direction: column;
  }

  .back-link {
    display: inline-flex;
    gap: .5rem;
    color: var(--white-icon);
    font-size: .75rem;
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color .2s ease;
  }

  .back-link:hover {
    color: var(--sec);
  }

  .sidebar-title {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-family: monospace;
    font-size: .65rem;
    letter-spacing: .18em;
    color: var(--white-icon);
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 12px var(--sec);
  }

  .doc-sidebar nav {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--white-icon-tr);
  }

  .nav-link {
    display: flex;
    gap: 1rem;
    padding: .8rem 1rem;
    border-left: 1px solid transparent;
    margin-left: -1px;
    color: var(--white-icon);
    text-decoration: none;
    font-size: .8rem;
    transition: all .2s ease;
  }

  .nav-link span {
    font-family: monospace;
    opacity: .45;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--white);
    border-left-color: var(--sec);
    background: rgba(255,255,255,.025);
  }

  .sidebar-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: .35rem;
    font-family: monospace;
    font-size: .6rem;
    color: var(--white-icon);
    opacity: .45;
  }

  /* ============================================================= */
  /* HERO                                                          */
  /* ============================================================= */

  .doc-hero {
    padding: 3rem 0 7rem;
    max-width: 850px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: .75rem;
    font-family: monospace;
    font-size: .65rem;
    letter-spacing: .18em;
    color: var(--sec);
    margin-bottom: 1.5rem;
  }

  .eyebrow-line {
    width: 40px;
    height: 1px;
    background: var(--sec);
    opacity: .5;
  }

  .doc-hero h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: .95;
    font-weight: 500;
    letter-spacing: -.06em;
  }

  .doc-hero h1 span {
    color: var(--sec);
  }

  .doc-hero p {
    max-width: 680px;
    margin-top: 2rem;
    color: var(--white-icon);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: 2rem;
  }

  .tech-row span {
    padding: .35rem .65rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 999px;
    font-family: monospace;
    font-size: .65rem;
    color: var(--white-icon);
  }

  /* ============================================================= */
  /* SECTIONS                                                       */
  /* ============================================================= */

  .doc-section {
    scroll-margin-top: 4rem;
    margin-bottom: 9rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .section-number {
    font-family: monospace;
    font-size: .7rem;
    color: var(--sec);
    padding-top: .5rem;
  }

  .section-kicker {
    font-family: monospace;
    font-size: .65rem;
    letter-spacing: .2em;
    color: var(--white-icon);
    opacity: .6;
    margin-bottom: .6rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .section-heading p {
    max-width: 650px;
    margin-top: .75rem;
    color: var(--white-icon);
    line-height: 1.7;
  }

  /* ============================================================= */
  /* PANELS                                                         */
  /* ============================================================= */

  .algorithm-panel {
    border: 1px solid var(--white-icon-tr);
    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.012)
      );
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 30px 80px rgba(0,0,0,.2);
  }

  .panel-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem;
    border-bottom: 1px solid var(--white-icon-tr);
    background: rgba(0,0,0,.16);
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .control-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--white-icon);
    font-family: monospace;
    font-size: .65rem;
  }

  .control-select,
  .control-input {
    border: 1px solid var(--white-icon-tr);
    background: #0c0c0c;
    color: var(--white);
    border-radius: 7px;
    padding: .55rem .7rem;
    outline: none;
    font-family: monospace;
    font-size: .72rem;
  }

  .control-select:focus,
  .control-input:focus {
    border-color: var(--sec);
  }

  .control-button {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .55rem .8rem;
    border-radius: 7px;
    border: 1px solid var(--white-icon-tr);
    background: transparent;
    color: var(--white-icon);
    font-family: monospace;
    font-size: .7rem;
    cursor: pointer;
    transition: all .2s ease;
  }

  .control-button:hover {
    border-color: var(--sec);
    color: var(--white);
    background: rgba(255,255,255,.025);
  }

  .control-button.primary {
    border-color: var(--sec);
    color: var(--sec);
  }

  .control-button.primary:hover {
    background: rgba(37,99,235,.1);
    box-shadow: 0 0 20px rgba(37,99,235,.08);
  }

  .control-button:disabled {
    opacity: .35;
    pointer-events: none;
  }

  .speed-control {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-family: monospace;
    font-size: .65rem;
    color: var(--white-icon);
  }

  .speed-control input {
    width: 100px;
    accent-color: var(--sec);
  }

  /* ============================================================= */
  /* SORTING                                                       */
  /* ============================================================= */

  .visual-stage {
    padding: 1.5rem;
  }

  .sorting-stage {
    height: 350px;
  }

  .sort-bars {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    padding: 1rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 8px;
    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.02),
        rgba(0,0,0,.12)
      );
  }

  .sort-bar {
    flex: 1;
    min-width: 2px;
    border-radius: 3px 3px 1px 1px;
    background: var(--white-icon);
    opacity: .35;
    transition:
      height .06s linear,
      background .08s ease,
      opacity .08s ease,
      transform .08s ease;
  }

  .sort-bar.compare {
    background: var(--sec);
    opacity: 1;
    transform: translateY(-2px);
  }

  .sort-bar.swap {
    background: #f59e0b;
    opacity: 1;
    transform: translateY(-2px);
  }

  .sort-bar.sorted {
    background: var(--sec);
    opacity: .8;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding: 0 1.5rem 1rem;
    font-family: monospace;
    font-size: .62rem;
    color: var(--white-icon);
  }

  .legend span {
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  .legend-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--white-icon);
    opacity: .5;
  }

  .legend-dot.comparison,
  .visited-dot {
    background: var(--sec);
    opacity: 1;
  }

  .legend-dot.swap,
  .path-dot {
    background: #f59e0b;
    opacity: 1;
  }

  .legend-dot.sorted {
    background: var(--sec);
    opacity: .7;
  }

  .start-dot {
    background: var(--sec);
    opacity: 1;
  }

  .end-dot {
    background: #ef4444;
    opacity: 1;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--white-icon-tr);
  }

  .stat {
    padding: 1rem 1.5rem;
    border-right: 1px solid var(--white-icon-tr);
  }

  .stat:last-child {
    border-right: none;
  }

  .stat span {
    display: block;
    font-family: monospace;
    font-size: .6rem;
    color: var(--white-icon);
    opacity: .55;
    margin-bottom: .35rem;
  }

  .stat strong {
    font-family: monospace;
    font-size: .8rem;
    color: var(--sec);
  }

  .complexity-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-top: .75rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 8px;
    overflow: hidden;
  }

  .complexity-grid div {
    padding: .8rem;
    border-right: 1px solid var(--white-icon-tr);
  }

  .complexity-grid div:last-child {
    border-right: none;
  }

  .complexity-grid span,
  .complexity-grid strong {
    display: block;
    font-family: monospace;
    font-size: .6rem;
  }

  .complexity-grid span {
    color: var(--white-icon);
    opacity: .55;
  }

  .complexity-grid strong {
    margin-top: .3rem;
    color: var(--sec);
  }

  /* ============================================================= */
  /* HASH TABLE                                                    */
  /* ============================================================= */

  .hash-inputs {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    width: 100%;
  }

  .control-input {
    width: 130px;
  }

  .formula {
    margin: 1rem 1.5rem;
    padding: .8rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 7px;
    background: rgba(0,0,0,.15);
    font-family: monospace;
    font-size: .65rem;
    color: var(--white-icon);
    min-height: 34px;
  }

  .hash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: .75rem;
    padding: 0 1.5rem 1.5rem;
  }

  .hash-bucket {
    min-height: 120px;
    padding: .8rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 8px;
    background: rgba(0,0,0,.12);
    transition: border-color .2s ease;
  }

  .hash-bucket:hover {
    border-color: rgba(37,99,235,.4);
  }

  .bucket-label {
    font-family: monospace;
    font-size: .58rem;
    color: var(--white-icon);
    opacity: .45;
    text-transform: uppercase;
  }

  .bucket-chain {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    margin-top: .6rem;
  }

  .hash-node {
    padding: .45rem .5rem;
    border-radius: 5px;
    border: 1px solid rgba(37,99,235,.3);
    background: rgba(37,99,235,.08);
    color: var(--white);
    font-family: monospace;
    font-size: .65rem;
    animation: nodeIn .2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hash-node.collision {
    border-color: rgba(245,158,11,.5);
    background: rgba(245,158,11,.08);
  }

  .chain-arrow {
    text-align: center;
    color: var(--white-icon);
    opacity: .35;
    font-family: monospace;
    font-size: .65rem;
  }

  .hash-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--white-icon-tr);
    font-family: monospace;
    font-size: .62rem;
    color: var(--white-icon);
  }

  .hash-footer strong {
    color: var(--sec);
    margin-left: .25rem;
  }

  /* ============================================================= */
  /* PATHFINDING                                                   */
  /* ============================================================= */

  .path-instructions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding: 1rem 1.5rem 0;
    color: var(--white-icon);
    font-family: monospace;
    font-size: .6rem;
  }

  kbd {
    border: 1px solid var(--white-icon-tr);
    padding: .2rem .35rem;
    border-radius: 3px;
    font-size: .55rem;
    color: var(--white);
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(28, 1fr);
    gap: 2px;
    margin: 1rem 1.5rem 1.5rem;
    padding: .5rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 8px;
    background: rgba(0,0,0,.2);
    user-select: none;
    touch-action: none;
  }

  .path-cell {
    aspect-ratio: 1;
    min-width: 0;
    border-radius: 2px;
    background: rgba(255,255,255,.035);
    transition:
      background .1s ease,
      transform .1s ease;
    cursor: crosshair;
  }

  .path-cell:hover {
    background: rgba(255,255,255,.1);
  }

  .path-cell.wall {
    background: rgba(255,255,255,.2);
  }

  .path-cell.start {
    background: var(--sec);
    box-shadow: 0 0 14px rgba(37,99,235,.45);
  }

  .path-cell.end {
    background: #ef4444;
    box-shadow: 0 0 14px rgba(239,68,68,.35);
  }

  .path-cell.visited {
    background: rgba(37,99,235,.35);
    animation: visitedIn .15s ease;
  }

  .path-cell.path {
    background: #f59e0b;
    box-shadow: 0 0 10px rgba(245,158,11,.2);
  }

  /* ============================================================= */
  /* ANIMATIONS                                                    */
  /* ============================================================= */

  @keyframes nodeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes visitedIn {
    from {
      transform: scale(.65);
      opacity: .2;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* ============================================================= */
  /* RESPONSIVE                                                     */
  /* ============================================================= */

  @media (max-width: 1000px) {

    .doc-shell {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .doc-sidebar {
      position: relative;
      top: auto;
      height: auto;
      margin-bottom: 3rem;
    }

    .doc-sidebar nav {
      flex-direction: row;
      border-left: none;
      border-bottom: 1px solid var(--white-icon-tr);
      overflow-x: auto;
    }

    .nav-link {
      white-space: nowrap;
      border-left: none;
      border-bottom: 1px solid transparent;
      margin-left: 0;
    }

    .nav-link:hover,
    .nav-link.active {
      border-left: none;
      border-bottom-color: var(--sec);
    }

    .sidebar-footer {
      display: none;
    }

    .back-link {
      margin-bottom: 2rem;
    }

  }

  @media (max-width: 700px) {

    .algorithm-page {
      padding: 3rem 1rem;
    }

    .doc-hero {
      padding-bottom: 5rem;
    }

    .doc-section {
      margin-bottom: 6rem;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: .5rem;
    }

    .section-number {
      padding-top: 0;
    }

    .sorting-stage {
      height: 250px;
    }

    .panel-toolbar {
      align-items: flex-start;
    }

    .speed-control {
      width: 100%;
      justify-content: space-between;
    }

    .speed-control input {
      width: 160px;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stat {
      border-right: none;
      border-bottom: 1px solid var(--white-icon-tr);
    }

    .stat:last-child {
      border-bottom: none;
    }

    .complexity-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .complexity-grid div:nth-child(even) {
      border-right: none;
    }

    .hash-grid {
      grid-template-columns: repeat(2, 1fr);
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .formula {
      margin-left: 1rem;
      margin-right: 1rem;
      overflow-x: auto;
      white-space: nowrap;
    }

    .path-grid {
      grid-template-columns: repeat(20, 1fr);
      margin-left: 1rem;
      margin-right: 1rem;
    }

  }

  @media (max-width: 450px) {

    .hash-grid {
      grid-template-columns: 1fr 1fr;
    }

    .control-input {
      width: 100%;
    }

    .hash-inputs .control-button {
      flex: 1;
    }

  }

</style>

<script>

  /* ============================================================= */
  /* SHARED                                                       */
  /* ============================================================= */

  const sleep = (ms: number) =>
    new Promise<void>((resolve) => setTimeout(resolve, ms));


  /* ============================================================= */
  /* SORTING                                                       */
  /* ============================================================= */

  (() => {

    const stage = document.getElementById("sort-stage");
    const algo = document.getElementById("sort-algo") as HTMLSelectElement;
    const run = document.getElementById("sort-run") as HTMLButtonElement;
    const shuffle = document.getElementById("sort-shuffle") as HTMLButtonElement;
    const speed = document.getElementById("sort-speed") as HTMLInputElement;

    const comparisonsEl = document.getElementById("sort-comparisons");
    const swapsEl = document.getElementById("sort-swaps");
    const statusEl = document.getElementById("sort-status");

    if (
      !stage ||
      !algo ||
      !run ||
      !shuffle ||
      !speed ||
      !comparisonsEl ||
      !swapsEl ||
      !statusEl
    ) return;

    const SIZE = 42;

    let values: number[] = [];
    let bars: HTMLDivElement[] = [];
    let running = false;

    let comparisons = 0;
    let swaps = 0;

    const delay = () => {
      const value = Number(speed.value);

      return Math.max(
        8,
        210 - value * 2
      );
    };

    function generate() {

      values = Array.from(
        { length: SIZE },
        () => Math.floor(Math.random() * 90) + 10
      );

    }

    function render() {

      stage.innerHTML = "";
      bars = [];

      values.forEach((value) => {

        const bar = document.createElement("div");

        bar.className = "sort-bar";
        bar.style.height = `${value}%`;

        stage.appendChild(bar);
        bars.push(bar);

      });

    }

    function updateBar(index: number) {

      if (bars[index]) {
        bars[index].style.height =
          `${values[index]}%`;
      }

    }

    function counts() {

      comparisonsEl.textContent =
        String(comparisons);

      swapsEl.textContent =
        String(swaps);

    }

    function clearMarks() {

      bars.forEach((bar) => {

        bar.classList.remove(
          "compare",
          "swap"
        );

      });

    }

    async function compare(...indexes: number[]) {

      clearMarks();

      indexes.forEach((index) => {

        bars[index]?.classList.add("compare");

      });

      await sleep(delay());

    }

    async function swapAnimation(...indexes: number[]) {

      clearMarks();

      indexes.forEach((index) => {

        bars[index]?.classList.add("swap");

      });

      await sleep(delay());

    }

    function sorted(index: number) {

      bars[index]?.classList.remove(
        "compare",
        "swap"
      );

      bars[index]?.classList.add("sorted");

    }

    async function bubble() {

      for (
        let end = values.length - 1;
        end > 0;
        end--
      ) {

        for (
          let i = 0;
          i < end;
          i++
        ) {

          comparisons++;
          counts();

          await compare(i, i + 1);

          if (values[i] > values[i + 1]) {

            [
              values[i],
              values[i + 1]
            ] = [
              values[i + 1],
              values[i]
            ];

            swaps++;

            updateBar(i);
            updateBar(i + 1);

            counts();

            await swapAnimation(i, i + 1);

          }

        }

        sorted(end);

      }

      sorted(0);

    }

    async function selection() {

      for (
        let i = 0;
        i < values.length;
        i++
      ) {

        let min = i;

        for (
          let j = i + 1;
          j < values.length;
          j++
        ) {

          comparisons++;
          counts();

          await compare(min, j);

          if (values[j] < values[min]) {
            min = j;
          }

        }

        if (min !== i) {

          [
            values[i],
            values[min]
          ] = [
            values[min],
            values[i]
          ];

          swaps++;

          updateBar(i);
          updateBar(min);

          counts();

          await swapAnimation(i, min);

        }

        sorted(i);

      }

    }

    async function insertion() {

      for (
        let i = 1;
        i < values.length;
        i++
      ) {

        let j = i;

        while (j > 0) {

          comparisons++;
          counts();

          await compare(j - 1, j);

          if (values[j - 1] <= values[j]) {
            break;
          }

          [
            values[j - 1],
            values[j]
          ] = [
            values[j],
            values[j - 1]
          ];

          swaps++;

          updateBar(j - 1);
          updateBar(j);

          counts();

          await swapAnimation(
            j - 1,
            j
          );

          j--;

        }

      }

      bars.forEach((_, index) => sorted(index));

    }

    async function mergeSort() {

      async function merge(
        left: number,
        middle: number,
        right: number
      ) {

        const leftValues =
          values.slice(left, middle + 1);

        const rightValues =
          values.slice(middle + 1, right + 1);

        let i = 0;
        let j = 0;
        let k = left;

        while (
          i < leftValues.length &&
          j < rightValues.length
        ) {

          comparisons++;
          counts();

          await compare(
            left + i,
            middle + 1 + j
          );

          if (
            leftValues[i] <=
            rightValues[j]
          ) {

            values[k] =
              leftValues[i++];

          } else {

            values[k] =
              rightValues[j++];

          }

          updateBar(k);

          swaps++;
          counts();

          k++;

        }

        while (i < leftValues.length) {

          values[k] =
            leftValues[i++];

          updateBar(k);
          k++;

        }

        while (j < rightValues.length) {

          values[k] =
            rightValues[j++];

          updateBar(k);
          k++;

        }

      }

      async function sort(
        left: number,
        right: number
      ) {

        if (left >= right) return;

        const middle =
          Math.floor(
            (left + right) / 2
          );

        await sort(left, middle);
        await sort(middle + 1, right);

        await merge(
          left,
          middle,
          right
        );

      }

      await sort(
        0,
        values.length - 1
      );

      bars.forEach((_, index) =>
        sorted(index)
      );

    }

    async function quickSort() {

      async function partition(
        left: number,
        right: number
      ) {

        const pivot =
          values[right];

        let index = left;

        for (
          let i = left;
          i < right;
          i++
        ) {

          comparisons++;
          counts();

          await compare(i, right);

          if (values[i] < pivot) {

            [
              values[i],
              values[index]
            ] = [
              values[index],
              values[i]
            ];

            updateBar(i);
            updateBar(index);

            swaps++;
            counts();

            await swapAnimation(
              i,
              index
            );

            index++;

          }

        }

        [
          values[index],
          values[right]
        ] = [
          values[right],
          values[index]
        ];

        updateBar(index);
        updateBar(right);

        swaps++;
        counts();

        await swapAnimation(
          index,
          right
        );

        return index;

      }

      async function sort(
        left: number,
        right: number
      ) {

        if (left >= right) return;

        const pivot =
          await partition(left, right);

        sorted(pivot);

        await sort(
          left,
          pivot - 1
        );

        await sort(
          pivot + 1,
          right
        );

      }

      await sort(
        0,
        values.length - 1
      );

      bars.forEach((_, index) =>
        sorted(index)
      );

    }

    const algorithms:
      Record<string, () => Promise<void>> = {
        bubble,
        selection,
        insertion,
        merge: mergeSort,
        quick: quickSort
      };

    function setDisabled(
      disabled: boolean
    ) {

      run.disabled = disabled;
      shuffle.disabled = disabled;
      algo.disabled = disabled;

    }

    async function start() {

      if (running) return;

      running = true;

      setDisabled(true);

      comparisons = 0;
      swaps = 0;

      counts();

      bars.forEach((bar) =>
        bar.classList.remove("sorted")
      );

      statusEl.textContent =
        "Running…";

      try {

        await algorithms[algo.value]();

        clearMarks();

        bars.forEach((_, index) =>
          sorted(index)
        );

        statusEl.textContent =
          "Complete";

      } catch {

        statusEl.textContent =
          "Error";

      } finally {

        running = false;
        setDisabled(false);

      }

    }

    function reset() {

      if (running) return;

      generate();
      render();

      comparisons = 0;
      swaps = 0;

      counts();

      statusEl.textContent =
        "Idle";

    }

    run.addEventListener(
      "click",
      start
    );

    shuffle.addEventListener(
      "click",
      reset
    );

    reset();

  })();


  /* ============================================================= */
  /* HASH TABLE                                                    */
  /* ============================================================= */

  (() => {

    const bucketsEl =
      document.getElementById(
        "hash-buckets"
      );

    const keyInput =
      document.getElementById(
        "hash-key"
      ) as HTMLInputElement;

    const valueInput =
      document.getElementById(
        "hash-value"
      ) as HTMLInputElement;

    const insertBtn =
      document.getElementById(
        "hash-insert"
      ) as HTMLButtonElement;

    const randomBtn =
      document.getElementById(
        "hash-random"
      ) as HTMLButtonElement;

    const clearBtn =
      document.getElementById(
        "hash-clear"
      ) as HTMLButtonElement;

    const formulaEl =
      document.getElementById(
        "hash-formula"
      );

    const loadEl =
      document.getElementById(
        "hash-load"
      );

    if (
      !bucketsEl ||
      !keyInput ||
      !valueInput ||
      !insertBtn ||
      !randomBtn ||
      !clearBtn ||
      !formulaEl ||
      !loadEl
    ) return;

    const SIZE = 8;

    type Entry = {
      key: string;
      value: string;
    };

    let table: Entry[][] =
      Array.from(
        { length: SIZE },
        () => []
      );

    let items = 0;

    function hash(key: string) {

      let hashValue = 0;

      for (
        let i = 0;
        i < key.length;
        i++
      ) {

        hashValue =
          (
            hashValue * 31 +
            key.charCodeAt(i)
          ) >>> 0;

      }

      return hashValue % SIZE;

    }

    function render() {

      bucketsEl.innerHTML = "";

      table.forEach(
        (chain, bucketIndex) => {

          const bucket =
            document.createElement(
              "div"
            );

          bucket.className =
            "hash-bucket";

          const label =
            document.createElement(
              "div"
            );

          label.className =
            "bucket-label";

          label.textContent =
            `bucket ${bucketIndex}`;

          bucket.appendChild(label);

          const chainEl =
            document.createElement(
              "div"
            );

          chainEl.className =
            "bucket-chain";

          chain.forEach(
            (entry, index) => {

              const node =
                document.createElement(
                  "div"
                );

              node.className =
                "hash-node" +
                (
                  chain.length > 1
                    ? " collision"
                    : ""
                );

              node.textContent =
                `${entry.key} → ${entry.value}`;

              chainEl.appendChild(node);

              if (
                index <
                chain.length - 1
              ) {

                const arrow =
                  document.createElement(
                    "div"
                  );

                arrow.className =
                  "chain-arrow";

                arrow.textContent =
                  "↓";

                chainEl.appendChild(
                  arrow
                );

              }

            }
          );

          bucket.appendChild(
            chainEl
          );

          bucketsEl.appendChild(
            bucket
          );

        }
      );

      loadEl.textContent =
        (
          items / SIZE
        ).toFixed(2);

    }

    function insert(
      key: string,
      value: string
    ) {

      if (!key) {

        formulaEl.textContent =
          "Enter a key before inserting.";

        keyInput.focus();

        return;

      }

      const index = hash(key);

      const chain =
        table[index];

      const existing =
        chain.find(
          (entry) =>
            entry.key === key
        );

      const collision =
        chain.length > 0 &&
        !existing;

      if (existing) {

        existing.value =
          value || existing.value;

      } else {

        chain.push({
          key,
          value: value || "—"
        });

        items++;

      }

      formulaEl.textContent =
        `hash("${key}") = ${index} → bucket ${index}` +
        (
          collision
            ? " · collision → chained"
            : existing
              ? " · existing key updated"
              : " · inserted"
        );

      render();

    }

    insertBtn.addEventListener(
      "click",
      () => {

        insert(
          keyInput.value.trim(),
          valueInput.value.trim()
        );

        keyInput.value = "";
        valueInput.value = "";

        keyInput.focus();

      }
    );

    [
      keyInput,
      valueInput
    ].forEach((input) => {

      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Enter"
          ) {

            insertBtn.click();

          }

        }
      );

    });

    randomBtn.addEventListener(
      "click",
      () => {

        const words = [
          "node",
          "heap",
          "tree",
          "graph",
          "byte",
          "hash",
          "sort",
          "edge",
          "stack",
          "queue"
        ];

        const key =
          words[
            Math.floor(
              Math.random() *
              words.length
            )
          ] +
          Math.floor(
            Math.random() * 100
          );

        insert(
          key,
          String(
            Math.floor(
              Math.random() * 1000
            )
          )
        );

      }
    );

    clearBtn.addEventListener(
      "click",
      () => {

        table =
          Array.from(
            { length: SIZE },
            () => []
          );

        items = 0;

        formulaEl.textContent =
          "Table cleared.";

        render();

      }
    );

    render();

  })();


  /* ============================================================= */
  /* PATHFINDING                                                   */
  /* ============================================================= */

  (() => {

    const gridEl =
      document.getElementById(
        "path-grid"
      );

    const algo =
      document.getElementById(
        "path-algo"
      ) as HTMLSelectElement;

    const runBtn =
      document.getElementById(
        "path-run"
      ) as HTMLButtonElement;

    const wallsBtn =
      document.getElementById(
        "path-walls"
      ) as HTMLButtonElement;

    const clearBtn =
      document.getElementById(
        "path-clear"
      ) as HTMLButtonElement;

    const visitedEl =
      document.getElementById(
        "path-visited"
      );

    const lengthEl =
      document.getElementById(
        "path-length"
      );

    const statusEl =
      document.getElementById(
        "path-status"
      );

    if (
      !gridEl ||
      !algo ||
      !runBtn ||
      !wallsBtn ||
      !clearBtn ||
      !visitedEl ||
      !lengthEl ||
      !statusEl
    ) return;

    const ROWS = 12;
    const COLS = 28;

    type State =
      | "empty"
      | "wall"
      | "start"
      | "end"
      | "visited"
      | "path";

    type Point = {
      r: number;
      c: number;
    };

    let grid: State[][] = [];
    let cells: HTMLDivElement[][] = [];

    let start: Point = {
      r: 6,
      c: 3
    };

    let end: Point = {
      r: 6,
      c: 24
    };

    let running = false;

    let dragMode:
      | "wall"
      | "erase"
      | "start"
      | "end"
      | null = null;

    function key(
      point: Point
    ) {

      return `${point.r},${point.c}`;

    }

    function createGrid() {

      grid =
        Array.from(
          { length: ROWS },
          () =>
            Array.from(
              { length: COLS },
              () => "empty" as State
            )
        );

      grid[start.r][start.c] =
        "start";

      grid[end.r][end.c] =
        "end";

    }

    function className(
      state: State
    ) {

      return `path-cell ${state}`;

    }

    function render() {

      gridEl.innerHTML = "";
      cells = [];

      for (
        let r = 0;
        r < ROWS;
        r++
      ) {

        const row: HTMLDivElement[] =
          [];

        for (
          let c = 0;
          c < COLS;
          c++
        ) {

          const cell =
            document.createElement(
              "div"
            );

          cell.className =
            className(
              grid[r][c]
            );

          cell.addEventListener(
            "mousedown",
            (event) => {

              event.preventDefault();

              handleDown(r, c);

            }
          );

          cell.addEventListener(
            "mouseenter",
            () => {

              handleEnter(r, c);

            }
          );

          row.push(cell);

          gridEl.appendChild(
            cell
          );

        }

        cells.push(row);

      }

    }

    function setState(
      point: Point,
      state: State
    ) {

      grid[point.r][point.c] =
        state;

      cells[point.r][point.c]
        .className =
        className(state);

    }

    function handleDown(
      r: number,
      c: number
    ) {

      if (running) return;

      const state =
        grid[r][c];

      if (state === "start") {

        dragMode = "start";
        return;

      }

      if (state === "end") {

        dragMode = "end";
        return;

      }

      dragMode =
        state === "wall"
          ? "erase"
          : "wall";

      setState(
        { r, c },
        dragMode === "wall"
          ? "wall"
          : "empty"
      );

    }

    function handleEnter(
      r: number,
      c: number
    ) {

      if (
        running ||
        !dragMode
      ) return;

      const point = { r, c };

      if (
        dragMode === "wall" ||
        dragMode === "erase"
      ) {

        if (
          grid[r][c] !== "start" &&
          grid[r][c] !== "end"
        ) {

          setState(
            point,
            dragMode === "wall"
              ? "wall"
              : "empty"
          );

        }

        return;

      }

      if (
        grid[r][c] === "wall"
      ) return;

      if (
        dragMode === "start"
      ) {

        setState(
          start,
          "empty"
        );

        start = point;

        setState(
          start,
          "start"
        );

      }

      if (
        dragMode === "end"
      ) {

        setState(
          end,
          "empty"
        );

        end = point;

        setState(
          end,
          "end"
        );

      }

    }

    document.addEventListener(
      "mouseup",
      () => {

        dragMode = null;

      }
    );

    function neighbors(
      point: Point
    ) {

      const directions = [
        [-1, 0],
        [1, 0],
        [0, -1],
        [0, 1]
      ];

      const result: Point[] = [];

      for (
        const [dr, dc]
        of directions
      ) {

        const r =
          point.r + dr;

        const c =
          point.c + dc;

        if (
          r >= 0 &&
          r < ROWS &&
          c >= 0 &&
          c < COLS &&
          grid[r][c] !== "wall"
        ) {

          result.push({
            r,
            c
          });

        }

      }

      return result;

    }

    function heuristic(
      point: Point
    ) {

      return Math.abs(
        point.r - end.r
      ) +
      Math.abs(
        point.c - end.c
      );

    }

    async function bfs() {

      const queue: Point[] =
        [start];

      const visited =
        new Set<string>([
          key(start)
        ]);

      const cameFrom =
        new Map<string, Point>();

      const order: Point[] =
        [];

      while (
        queue.length
      ) {

        const current =
          queue.shift()!;

        order.push(current);

        if (
          key(current) ===
          key(end)
        ) break;

        for (
          const next
          of neighbors(current)
        ) {

          const nextKey =
            key(next);

          if (
            visited.has(nextKey)
          ) continue;

          visited.add(nextKey);

          cameFrom.set(
            nextKey,
            current
          );

          queue.push(next);

        }

      }

      return {
        order,
        cameFrom,
        found:
          visited.has(key(end))
      };

    }

    async function weighted(
      useHeuristic: boolean
    ) {

      const open = [
        {
          point: start,
          cost: 0,
          priority: 0
        }
      ];

      const distances =
        new Map<string, number>();

      const cameFrom =
        new Map<string, Point>();

      const visited =
        new Set<string>();

      const order: Point[] =
        [];

      distances.set(
        key(start),
        0
      );

      while (
        open.length
      ) {

        open.sort(
          (a, b) =>
            a.priority -
            b.priority
        );

        const current =
          open.shift()!;

        const currentKey =
          key(current.point);

        if (
          visited.has(
            currentKey
          )
        ) continue;

        visited.add(
          currentKey
        );

        order.push(
          current.point
        );

        if (
          currentKey ===
          key(end)
        ) break;

        for (
          const next
          of neighbors(
            current.point
          )
        ) {

          const nextKey =
            key(next);

          const newCost =
            current.cost + 1;

          if (
            newCost <
            (
              distances.get(
                nextKey
              ) ?? Infinity
            )
          ) {

            distances.set(
              nextKey,
              newCost
            );

            cameFrom.set(
              nextKey,
              current.point
            );

            const priority =
              newCost +
              (
                useHeuristic
                  ? heuristic(next)
                  : 0
              );

            open.push({
              point: next,
              cost: newCost,
              priority
            });

          }

        }

      }

      return {
        order,
        cameFrom,
        found:
          visited.has(
            key(end)
          )
      };

    }

    function reconstruct(
      cameFrom: Map<string, Point>
    ) {

      const path: Point[] =
        [];

      let current: Point =
        end;

      while (
        key(current) !==
        key(start)
      ) {

        path.push(current);

        const previous =
          cameFrom.get(
            key(current)
          );

        if (!previous) {
          return [];
        }

        current = previous;

      }

      path.reverse();

      return path;

    }

    async function runSearch() {

      let result;

      if (
        algo.value === "bfs"
      ) {

        result = await bfs();

      } else {

        result =
          await weighted(
            algo.value === "astar"
          );

      }

      let count = 0;

      for (
        const point
        of result.order
      ) {

        if (
          key(point) !==
          key(start) &&
          key(point) !==
          key(end) &&
          grid[point.r][point.c] ===
            "empty"
        ) {

          setState(
            point,
            "visited"
          );

        }

        count++;

        visitedEl.textContent =
          String(count);

        await sleep(9);

      }

      if (!result.found) {

        statusEl.textContent =
          "No path";

        lengthEl.textContent =
          "—";

        return;

      }

      const path =
        reconstruct(
          result.cameFrom
        );

      for (
        const point
        of path
      ) {

        if (
          key(point) !==
          key(end)
        ) {

          setState(
            point,
            "path"
          );

        }

        await sleep(22);

      }

      lengthEl.textContent =
        String(path.length);

      statusEl.textContent =
        "Path found";

    }

    function clearSearchState() {

      for (
        let r = 0;
        r < ROWS;
        r++
      ) {

        for (
          let c = 0;
          c < COLS;
          c++
        ) {

          if (
            grid[r][c] ===
              "visited" ||
            grid[r][c] ===
              "path"
          ) {

            grid[r][c] =
              "empty";

          }

        }

      }

      grid[start.r][start.c] =
        "start";

      grid[end.r][end.c] =
        "end";

      render();

    }

    async function run() {

      if (running) return;

      running = true;

      runBtn.disabled = true;
      wallsBtn.disabled = true;
      clearBtn.disabled = true;
      algo.disabled = true;

      clearSearchState();

      visitedEl.textContent =
        "0";

      lengthEl.textContent =
        "—";

      statusEl.textContent =
        "Searching…";

      try {

        await runSearch();

      } finally {

        running = false;

        runBtn.disabled = false;
        wallsBtn.disabled = false;
        clearBtn.disabled = false;
        algo.disabled = false;

      }

    }

    function randomWalls() {

      if (running) return;

      createGrid();

      for (
        let r = 0;
        r < ROWS;
        r++
      ) {

        for (
          let c = 0;
          c < COLS;
          c++
        ) {

          if (
            grid[r][c] ===
              "empty" &&
            Math.random() < .27
          ) {

            grid[r][c] =
              "wall";

          }

        }

      }

      render();

      visitedEl.textContent =
        "0";

      lengthEl.textContent =
        "—";

      statusEl.textContent =
        "Idle";

    }

    function clearAll() {

      if (running) return;

      createGrid();
      render();

      visitedEl.textContent =
        "0";

      lengthEl.textContent =
        "—";

      statusEl.textContent =
        "Idle";

    }

    runBtn.addEventListener(
      "click",
      run
    );

    wallsBtn.addEventListener(
      "click",
      randomWalls
    );

    clearBtn.addEventListener(
      "click",
      clearAll
    );

    createGrid();
    render();

  })();


  /* ============================================================= */
  /* DOCUMENTATION NAVIGATION                                     */
  /* ============================================================= */

  (() => {

    const links =
      Array.from(
        document.querySelectorAll(
          ".nav-link"
        )
      ) as HTMLAnchorElement[];

    const sections =
      links
        .map((link) =>
          document.querySelector(
            link.getAttribute(
              "href"
            ) || ""
          )
        )
        .filter(
          Boolean
        ) as HTMLElement[];

    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach(
            (entry) => {

              if (
                entry.isIntersecting
              ) {

                links.forEach(
                  (link) =>
                    link.classList.remove(
                      "active"
                    )
                );

                const active =
                  links.find(
                    (link) =>
                      link.getAttribute(
                        "href"
                      ) ===
                      `#${entry.target.id}`
                  );

                active?.classList.add(
                  "active"
                );

              }

            }
          );

        },
        {
          rootMargin:
            "-20% 0px -65% 0px"
        }
      );

    sections.forEach(
      (section) =>
        observer.observe(
          section
        )
    );

  })();

</script>
