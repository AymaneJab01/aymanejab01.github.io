---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Algorithm Visualizer">
  <main class="algorithm-page">
    <div class="page-grid"></div>

```
<div class="container">
  <!-- BACK -->
  <a href="/projects" class="back-link">
    <span>←</span>
    <span>Back to projects</span>
  </a>

  <!-- HERO -->
  <header class="hero">
    <div class="eyebrow">
      <span class="status-dot"></span>
      <span>PROJECT 04</span>
      <span class="separator">/</span>
      <span>COMPUTER SCIENCE</span>
    </div>

    <h1>
      Algorithms,
      <span>visualized.</span>
    </h1>

    <p class="hero-description">
      Interactive visualizations for sorting algorithms, hash tables,
      and pathfinding. Built to make data structures and algorithms
      easier to understand by watching them execute step by step.
    </p>

    <div class="tech-row">
      <span>ASTRO</span>
      <span>TYPESCRIPT</span>
      <span>ALGORITHMS</span>
      <span>DATA STRUCTURES</span>
    </div>
  </header>

  <!-- SECTION INDEX -->
  <nav class="section-index" aria-label="Visualizer sections">
    <a href="#sorting">
      <span>01</span>
      <span>Sorting</span>
    </a>

    <a href="#hash-table">
      <span>02</span>
      <span>Hash table</span>
    </a>

    <a href="#pathfinding">
      <span>03</span>
      <span>Pathfinding</span>
    </a>
  </nav>

  <!-- ========================================================= -->
  <!-- SORTING -->
  <!-- ========================================================= -->

  <section class="demo-section" id="sorting">
    <div class="section-heading">
      <div class="section-number">01</div>

      <div>
        <div class="section-label">SORTING ALGORITHMS</div>

        <h2>Watch algorithms sort data.</h2>

        <p>
          Compare five classic sorting algorithms and observe their
          comparisons and swaps in real time.
        </p>
      </div>
    </div>

    <div class="demo-card">
      <div class="demo-toolbar">
        <div class="control-group">
          <label for="sort-algo">Algorithm</label>

          <select id="sort-algo">
            <option value="bubble">Bubble Sort</option>
            <option value="selection">Selection Sort</option>
            <option value="insertion">Insertion Sort</option>
            <option value="merge">Merge Sort</option>
            <option value="quick" selected>Quick Sort</option>
          </select>
        </div>

        <div class="toolbar-actions">
          <button id="sort-run" class="button primary">
            Run algorithm
          </button>

          <button id="sort-shuffle" class="button">
            Shuffle
          </button>
        </div>

        <div class="speed-control">
          <label for="sort-speed">Speed</label>
          <input
            id="sort-speed"
            type="range"
            min="1"
            max="100"
            value="65"
          />
        </div>
      </div>

      <div class="visual-stage sorting-stage">
        <div id="sort-stage" class="bars" aria-label="Sorting visualization"></div>
      </div>

      <div class="metrics">
        <div>
          <span>Comparisons</span>
          <strong id="sort-comparisons">0</strong>
        </div>

        <div>
          <span>Swaps</span>
          <strong id="sort-swaps">0</strong>
        </div>

        <div>
          <span>Status</span>
          <strong id="sort-status">Ready</strong>
        </div>
      </div>

      <div class="legend">
        <span>
          <i class="legend-dot compare"></i>
          Comparing
        </span>

        <span>
          <i class="legend-dot swap"></i>
          Swapping
        </span>

        <span>
          <i class="legend-dot sorted"></i>
          Sorted
        </span>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- HASH TABLE -->
  <!-- ========================================================= -->

  <section class="demo-section" id="hash-table">
    <div class="section-heading">
      <div class="section-number">02</div>

      <div>
        <div class="section-label">HASH TABLE</div>

        <h2>See collision resolution.</h2>

        <p>
          Insert key-value pairs into an eight-bucket hash table and
          watch separate chaining resolve collisions.
        </p>
      </div>
    </div>

    <div class="demo-card">
      <div class="demo-toolbar hash-toolbar">
        <div class="control-group">
          <label for="hash-key">Key</label>
          <input
            id="hash-key"
            class="text-input"
            type="text"
            placeholder="user"
            maxlength="16"
          />
        </div>

        <div class="control-group">
          <label for="hash-value">Value</label>
          <input
            id="hash-value"
            class="text-input"
            type="text"
            placeholder="Aymane"
            maxlength="16"
          />
        </div>

        <div class="toolbar-actions">
          <button id="hash-insert" class="button primary">
            Insert
          </button>

          <button id="hash-random" class="button">
            Random
          </button>

          <button id="hash-clear" class="button">
            Clear
          </button>
        </div>
      </div>

      <div id="hash-formula" class="formula">
        Ready for insertion.
      </div>

      <div
        id="hash-buckets"
        class="hash-grid"
        aria-label="Hash table buckets"
      ></div>

      <div class="hash-footer">
        <span>Load factor</span>
        <strong id="hash-load">0.00</strong>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- PATHFINDING -->
  <!-- ========================================================= -->

  <section class="demo-section" id="pathfinding">
    <div class="section-heading">
      <div class="section-number">03</div>

      <div>
        <div class="section-label">PATHFINDING</div>

        <h2>Find the shortest path.</h2>

        <p>
          Draw walls on the grid and compare BFS, Dijkstra, and A*
          while watching the search happen cell by cell.
        </p>
      </div>
    </div>

    <div class="demo-card">
      <div class="demo-toolbar">
        <div class="control-group">
          <label for="path-algo">Algorithm</label>

          <select id="path-algo">
            <option value="bfs">Breadth-First Search</option>
            <option value="dijkstra">Dijkstra</option>
            <option value="astar" selected>A*</option>
          </select>
        </div>

        <div class="toolbar-actions">
          <button id="path-run" class="button primary">
            Find path
          </button>

          <button id="path-walls" class="button">
            Random walls
          </button>

          <button id="path-clear" class="button">
            Clear
          </button>
        </div>

        <div class="path-help">
          Click / drag to draw walls
        </div>
      </div>

      <div class="visual-stage path-stage">
        <div
          id="path-grid"
          class="path-grid"
          aria-label="Pathfinding grid"
        ></div>
      </div>

      <div class="metrics">
        <div>
          <span>Visited</span>
          <strong id="path-visited">0</strong>
        </div>

        <div>
          <span>Path length</span>
          <strong id="path-length">—</strong>
        </div>

        <div>
          <span>Status</span>
          <strong id="path-status">Ready</strong>
        </div>
      </div>

      <div class="legend">
        <span>
          <i class="legend-dot start"></i>
          Start
        </span>

        <span>
          <i class="legend-dot wall"></i>
          Wall
        </span>

        <span>
          <i class="legend-dot visited"></i>
          Visited
        </span>

        <span>
          <i class="legend-dot path"></i>
          Shortest path
        </span>
      </div>
    </div>
  </section>

  <!-- DOCUMENTATION -->
  <section class="documentation">
    <div class="section-heading">
      <div class="section-number">04</div>

      <div>
        <div class="section-label">DOCUMENTATION</div>

        <h2>Built as an interactive reference.</h2>

        <p>
          Each visualization exposes the underlying algorithm rather
          than hiding it behind a static animation.
        </p>
      </div>
    </div>

    <div class="documentation-grid">
      <article>
        <span>01</span>
        <h3>Sorting</h3>
        <p>
          Bubble, selection, insertion, merge, and quick sort with
          live comparison and swap counters.
        </p>
      </article>

      <article>
        <span>02</span>
        <h3>Hashing</h3>
        <p>
          A simple hash function demonstrates bucket selection and
          separate chaining.
        </p>
      </article>

      <article>
        <span>03</span>
        <h3>Pathfinding</h3>
        <p>
          BFS, Dijkstra, and A* explore the same weighted-free grid
          using different search strategies.
        </p>
      </article>

      <article>
        <span>04</span>
        <h3>Client-side</h3>
        <p>
          Everything runs directly in the browser using TypeScript,
          DOM APIs, and CSS.
        </p>
      </article>
    </div>
  </section>

  <footer class="page-footer">
    <span>ALGORITHM VISUALIZER</span>
    <a href="/projects">← Projects</a>
  </footer>
</div>
```

  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .algorithm-page {
    --blue: #38bdf8;
    --blue-soft: rgba(56, 189, 248, 0.14);
    --green: #4ade80;
    --amber: #f59e0b;
    --red: #fb7185;

    position: relative;
    min-height: 100vh;
    overflow: hidden;

    color: rgba(255, 255, 255, 0.92);

    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(56, 189, 248, 0.055),
        transparent 32rem
      ),
      #08090b;
  }

  .page-grid {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;

    opacity: 0.32;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 85%
    );
  }

  .container {
    position: relative;
    z-index: 1;

    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;

    padding: 7rem 0 5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    margin-bottom: 5rem;

    color: rgba(255, 255, 255, 0.45);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    text-decoration: none;

    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  .back-link:hover {
    color: var(--blue);
    transform: translateX(-3px);
  }

  .hero {
    max-width: 820px;
    margin-bottom: 4rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-bottom: 1.4rem;

    color: rgba(255, 255, 255, 0.35);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.67rem;
    letter-spacing: 0.14em;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    border-radius: 999px;

    background: var(--green);

    box-shadow:
      0 0 0 4px rgba(74, 222, 128, 0.08),
      0 0 18px rgba(74, 222, 128, 0.6);
  }

  .separator {
    opacity: 0.25;
  }

  .hero h1 {
    margin: 0;

    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .hero h1 span {
    display: block;

    background:
      linear-gradient(
        100deg,
        #ffffff 0%,
        #ffffff 45%,
        var(--blue) 100%
      );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
  }

  .hero-description {
    max-width: 680px;

    margin: 2rem 0 0;

    color: rgba(255, 255, 255, 0.5);

    font-size: 1.05rem;
    line-height: 1.8;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;

    margin-top: 2rem;
  }

  .tech-row span {
    padding: 0.45rem 0.7rem;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;

    color: rgba(255, 255, 255, 0.42);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.62rem;
    letter-spacing: 0.08em;

    background: rgba(255, 255, 255, 0.02);
  }

  .section-index {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    margin-bottom: 7rem;

    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-index a {
    display: flex;
    align-items: center;
    gap: 1rem;

    padding: 1.1rem 0;

    color: rgba(255, 255, 255, 0.42);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.7rem;
    text-decoration: none;

    transition: color 200ms ease;
  }

  .section-index a + a {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 1.5rem;
  }

  .section-index a span:first-child {
    color: var(--blue);
  }

  .section-index a:hover {
    color: white;
  }

  .demo-section,
  .documentation {
    margin-bottom: 8rem;
    scroll-margin-top: 4rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 1.5rem;

    margin-bottom: 2rem;
  }

  .section-number {
    padding-top: 0.25rem;

    color: var(--blue);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .section-label {
    margin-bottom: 0.65rem;

    color: rgba(56, 189, 248, 0.7);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;

    color: rgba(255, 255, 255, 0.92);

    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .section-heading p {
    max-width: 680px;

    margin: 0.75rem 0 0;

    color: rgba(255, 255, 255, 0.42);

    line-height: 1.7;
  }

  .demo-card {
    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;

    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(56, 189, 248, 0.045),
        transparent 28rem
      ),
      rgba(255, 255, 255, 0.018);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 25px 80px rgba(0, 0, 0, 0.2);
  }

  .demo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.8rem;

    padding: 1.2rem;

    border-bottom: 1px solid rgba(255, 255, 255, 0.07);

    background: rgba(0, 0, 0, 0.14);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .control-group label,
  .speed-control label {
    color: rgba(255, 255, 255, 0.3);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  select,
  .text-input {
    min-height: 38px;

    padding: 0.55rem 0.75rem;

    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;

    outline: none;

    color: rgba(255, 255, 255, 0.8);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.72rem;

    background: #0c0e11;

    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  select:focus,
  .text-input:focus {
    border-color: rgba(56, 189, 248, 0.55);

    box-shadow:
      0 0 0 3px rgba(56, 189, 248, 0.08);
  }

  select option {
    background: #0c0e11;
  }

  .text-input {
    width: 120px;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.5rem;
  }

  .button {
    min-height: 38px;

    padding: 0.55rem 0.85rem;

    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;

    color: rgba(255, 255, 255, 0.55);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.68rem;

    background: rgba(255, 255, 255, 0.025);

    cursor: pointer;

    transition:
      color 200ms ease,
      border-color 200ms ease,
      background 200ms ease,
      transform 200ms ease;
  }

  .button:hover {
    color: white;

    border-color: rgba(255, 255, 255, 0.22);

    background: rgba(255, 255, 255, 0.05);

    transform: translateY(-1px);
  }

  .button.primary {
    color: var(--blue);

    border-color: rgba(56, 189, 248, 0.4);

    background: rgba(56, 189, 248, 0.07);
  }

  .button.primary:hover {
    border-color: var(--blue);

    background: rgba(56, 189, 248, 0.12);
  }

  .button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .speed-control {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;

    margin-left: auto;
  }

  .speed-control input {
    width: 110px;

    accent-color: var(--blue);
  }

  .visual-stage {
    position: relative;

    padding: 1rem;
  }

  .sorting-stage {
    height: 310px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;

    width: 100%;
    height: 100%;

    padding: 1rem;

    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 12px;

    background:
      linear-gradient(
        rgba(255, 255, 255, 0.018) 1px,
        transparent 1px
      ),
      rgba(0, 0, 0, 0.18);

    background-size: 100% 25%;
  }

  .viz-bar {
    flex: 1;

    min-width: 2px;

    border-radius: 2px 2px 0 0;

    background: rgba(255, 255, 255, 0.22);

    transition:
      height 50ms linear,
      background 100ms ease,
      opacity 100ms ease;
  }

  .viz-bar.compare {
    background: var(--blue);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.35);
  }

  .viz-bar.swap {
    background: var(--amber);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.35);
  }

  .viz-bar.sorted {
    background: var(--green);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;

    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .metrics > div {
    min-width: 130px;

    padding: 1rem 1.2rem;

    border-right: 1px solid rgba(255, 255, 255, 0.07);
  }

  .metrics span {
    display: block;

    margin-bottom: 0.35rem;

    color: rgba(255, 255, 255, 0.25);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .metrics strong {
    color: rgba(255, 255, 255, 0.75);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.8rem;
    font-weight: 400;
  }

  .metrics strong:not(:last-child) {
    color: var(--blue);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;

    padding: 0.85rem 1.2rem;

    border-top: 1px solid rgba(255, 255, 255, 0.05);

    color: rgba(255, 255, 255, 0.32);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.62rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 7px;
    height: 7px;

    border-radius: 2px;

    display: inline-block;
  }

  .legend-dot.compare {
    background: var(--blue);
  }

  .legend-dot.swap {
    background: var(--amber);
  }

  .legend-dot.sorted {
    background: var(--green);
  }

  .legend-dot.start {
    background: var(--green);
  }

  .legend-dot.wall {
    background: rgba(255, 255, 255, 0.3);
  }

  .legend-dot.visited {
    background: rgba(56, 189, 248, 0.45);
  }

  .legend-dot.path {
    background: var(--amber);
  }

  .formula {
    min-height: 42px;

    display: flex;
    align-items: center;

    padding: 0.8rem 1.2rem;

    color: rgba(56, 189, 248, 0.75);

    border-bottom: 1px solid rgba(255, 255, 255, 0.05);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.65rem;

    background: rgba(56, 189, 248, 0.025);
  }

  .hash-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 0.6rem;

    padding: 1rem;
  }

  .hash-bucket {
    min-height: 120px;

    padding: 0.75rem;

    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;

    background: rgba(0, 0, 0, 0.18);
  }

  .hash-index {
    color: rgba(255, 255, 255, 0.25);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .hash-chain {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;

    margin-top: 0.7rem;
  }

  .hash-node {
    padding: 0.5rem;

    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 6px;

    color: rgba(255, 255, 255, 0.7);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.65rem;

    background: rgba(56, 189, 248, 0.045);

    animation: node-in 180ms ease;
  }

  .hash-node.collision {
    border-color: rgba(245, 158, 11, 0.35);
    background: rgba(245, 158, 11, 0.05);
  }

  .hash-arrow {
    text-align: center;

    color: rgba(255, 255, 255, 0.2);

    font-size: 0.7rem;
  }

  .hash-footer {
    display: flex;
    justify-content: space-between;

    padding: 1rem 1.2rem;

    border-top: 1px solid rgba(255, 255, 255, 0.07);

    color: rgba(255, 255, 255, 0.3);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.65rem;
  }

  .hash-footer strong {
    color: var(--blue);
    font-weight: 400;
  }

  .path-stage {
    overflow: auto;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(28, minmax(12px, 1fr));

    gap: 2px;

    min-width: 620px;

    padding: 0.75rem;

    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 12px;

    background: rgba(0, 0, 0, 0.18);
  }

  .path-cell {
    aspect-ratio: 1;

    border-radius: 2px;

    background: rgba(255, 255, 255, 0.025);

    cursor: crosshair;

    transition:
      background 90ms ease,
      transform 90ms ease;
  }

  .path-cell:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  .path-cell.wall {
    background: rgba(255, 255, 255, 0.24);
  }

  .path-cell.start {
    background: var(--green);

    box-shadow: 0 0 14px rgba(74, 222, 128, 0.4);
  }

  .path-cell.end {
    background: var(--red);

    box-shadow: 0 0 14px rgba(251, 113, 133, 0.35);
  }

  .path-cell.visited {
    background: rgba(56, 189, 248, 0.35);

    animation: visited-in 120ms ease;
  }

  .path-cell.path {
    background: var(--amber);

    box-shadow: 0 0 10px rgba(245, 158, 11, 0.25);
  }

  .path-help {
    margin-left: auto;

    align-self: center;

    color: rgba(255, 255, 255, 0.25);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.6rem;
  }

  .documentation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 1px;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;

    background: rgba(255, 255, 255, 0.08);
  }

  .documentation-grid article {
    min-height: 190px;

    padding: 1.5rem;

    background: #0a0b0d;

    transition:
      background 250ms ease,
      transform 250ms ease;
  }

  .documentation-grid article:hover {
    background: #0d1013;
  }

  .documentation-grid article > span {
    color: rgba(56, 189, 248, 0.7);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.62rem;
  }

  .documentation-grid h3 {
    margin: 3rem 0 0.6rem;

    color: rgba(255, 255, 255, 0.78);

    font-size: 1rem;
    font-weight: 500;
  }

  .documentation-grid p {
    margin: 0;

    color: rgba(255, 255, 255, 0.35);

    font-size: 0.82rem;
    line-height: 1.7;
  }

  .page-footer {
    display: flex;
    justify-content: space-between;

    padding-top: 2rem;

    border-top: 1px solid rgba(255, 255, 255, 0.08);

    color: rgba(255, 255, 255, 0.25);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .page-footer a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
  }

  .page-footer a:hover {
    color: var(--blue);
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes visited-in {
    from {
      opacity: 0.1;
      transform: scale(0.7);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 800px) {
    .container {
      padding-top: 5rem;
    }

    .section-index {
      grid-template-columns: 1fr;
    }

    .section-index a + a {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-left: 0;
    }

    .hash-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .speed-control {
      margin-left: 0;
    }

    .path-help {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 20px, 1120px);
    }

    .hero h1 {
      font-size: 3.3rem;
    }

    .section-heading {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 0.8rem;
    }

    .demo-toolbar {
      align-items: stretch;
    }

    .toolbar-actions {
      width: 100%;
    }

    .toolbar-actions .button {
      flex: 1;
    }

    .text-input {
      width: 100%;
    }

    .control-group {
      width: 100%;
    }

    .control-group select {
      width: 100%;
    }

    .sorting-stage {
      height: 230px;
    }

    .hash-grid {
      grid-template-columns: 1fr;
    }

    .documentation-grid {
      grid-template-columns: 1fr;
    }

    .metrics > div {
      flex: 1;
      min-width: 100px;
    }
  }
</style>

<script>
  const sleep = (ms: number) =>
    new Promise<void>((resolve) => setTimeout(resolve, ms));

  /* ================================================================
     SORTING VISUALIZER
     ================================================================ */

  (() => {
    const stage = document.getElementById("sort-stage");
    const algorithm = document.getElementById(
      "sort-algo"
    ) as HTMLSelectElement | null;
    const runButton = document.getElementById(
      "sort-run"
    ) as HTMLButtonElement | null;
    const shuffleButton = document.getElementById(
      "sort-shuffle"
    ) as HTMLButtonElement | null;
    const speed = document.getElementById(
      "sort-speed"
    ) as HTMLInputElement | null;
    const comparisonsElement = document.getElementById(
      "sort-comparisons"
    );
    const swapsElement = document.getElementById("sort-swaps");
    const statusElement = document.getElementById("sort-status");

    if (
      !stage ||
      !algorithm ||
      !runButton ||
      !shuffleButton ||
      !speed ||
      !comparisonsElement ||
      !swapsElement ||
      !statusElement
    ) {
      return;
    }

    const COUNT = 42;

    let values: number[] = [];
    let bars: HTMLDivElement[] = [];
    let running = false;

    let comparisons = 0;
    let swaps = 0;

    const delay = () =>
      Math.max(8, 220 - Number(speed.value) * 2);

    function createArray() {
      values = Array.from(
        { length: COUNT },
        () => Math.floor(Math.random() * 88) + 8
      );
    }

    function render() {
      stage.innerHTML = "";

      bars = values.map((value) => {
        const bar = document.createElement("div");

        bar.className = "viz-bar";
        bar.style.height = `${value}%`;

        stage.appendChild(bar);

        return bar;
      });
    }

    function updateMetrics() {
      comparisonsElement.textContent = String(comparisons);
      swapsElement.textContent = String(swaps);
    }

    function clearMarks() {
      bars.forEach((bar) => {
        bar.classList.remove("compare", "swap");
      });
    }

    function updateBar(index: number) {
      const bar = bars[index];

      if (bar) {
        bar.style.height = `${values[index]}%`;
      }
    }

    async function highlight(
      indices: number[],
      className: "compare" | "swap"
    ) {
      clearMarks();

      indices.forEach((index) => {
        bars[index]?.classList.add(className);
      });

      await sleep(delay());
    }

    async function bubbleSort() {
      for (let i = 0; i < values.length - 1; i++) {
        let changed = false;

        for (let j = 0; j < values.length - i - 1; j++) {
          comparisons++;
          updateMetrics();

          await highlight([j, j + 1], "compare");

          if (values[j] > values[j + 1]) {
            [values[j], values[j + 1]] = [
              values[j + 1],
              values[j],
            ];

            swaps++;
            changed = true;

            updateBar(j);
            updateBar(j + 1);
            updateMetrics();

            await highlight([j, j + 1], "swap");
          }
        }

        bars[values.length - i - 1]?.classList.add("sorted");

        if (!changed) break;
      }
    }

    async function selectionSort() {
      for (let i = 0; i < values.length; i++) {
        let minimum = i;

        for (let j = i + 1; j < values.length; j++) {
          comparisons++;
          updateMetrics();

          await highlight([minimum, j], "compare");

          if (values[j] < values[minimum]) {
            minimum = j;
          }
        }

        if (minimum !== i) {
          [values[i], values[minimum]] = [
            values[minimum],
            values[i],
          ];

          swaps++;

          updateBar(i);
          updateBar(minimum);
          updateMetrics();

          await highlight([i, minimum], "swap");
        }

        bars[i]?.classList.add("sorted");
      }
    }

    async function insertionSort() {
      for (let i = 1; i < values.length; i++) {
        let j = i;

        while (j > 0) {
          comparisons++;
          updateMetrics();

          await highlight([j - 1, j], "compare");

          if (values[j - 1] <= values[j]) break;

          [values[j - 1], values[j]] = [
            values[j],
            values[j - 1],
          ];

          swaps++;

          updateBar(j - 1);
          updateBar(j);
          updateMetrics();

          await highlight([j - 1, j], "swap");

          j--;
        }
      }

      bars.forEach((bar) => bar.classList.add("sorted"));
    }

    async function mergeSort() {
      async function merge(left: number, middle: number, right: number) {
        const first = values.slice(left, middle + 1);
        const second = values.slice(middle + 1, right + 1);

        let i = 0;
        let j = 0;
        let position = left;

        while (i < first.length && j < second.length) {
          comparisons++;
          updateMetrics();

          await highlight(
            [left + i, middle + 1 + j],
            "compare"
          );

          if (first[i] <= second[j]) {
            values[position] = first[i];
            i++;
          } else {
            values[position] = second[j];
            j++;
          }

          updateBar(position);

          swaps++;
          updateMetrics();

          position++;
        }

        while (i < first.length) {
          values[position] = first[i];
          updateBar(position);
          i++;
          position++;
        }

        while (j < second.length) {
          values[position] = second[j];
          updateBar(position);
          j++;
          position++;
        }

        await sleep(delay());
      }

      async function sort(left: number, right: number) {
        if (left >= right) return;

        const middle = Math.floor((left + right) / 2);

        await sort(left, middle);
        await sort(middle + 1, right);
        await merge(left, middle, right);
      }

      await sort(0, values.length - 1);

      bars.forEach((bar) => bar.classList.add("sorted"));
    }

    async function quickSort() {
      async function partition(left: number, right: number) {
        const pivot = values[right];
        let index = left;

        for (let i = left; i < right; i++) {
          comparisons++;
          updateMetrics();

          await highlight([i, right], "compare");

          if (values[i] < pivot) {
            [values[index], values[i]] = [
              values[i],
              values[index],
            ];

            swaps++;

            updateBar(index);
            updateBar(i);
            updateMetrics();

            await highlight([index, i], "swap");

            index++;
          }
        }

        [values[index], values[right]] = [
          values[right],
          values[index],
        ];

        swaps++;

        updateBar(index);
        updateBar(right);
        updateMetrics();

        await highlight([index, right], "swap");

        bars[index]?.classList.add("sorted");

        return index;
      }

      async function sort(left: number, right: number) {
        if (left >= right) return;

        const pivot = await partition(left, right);

        await sort(left, pivot - 1);
        await sort(pivot + 1, right);
      }

      await sort(0, values.length - 1);

      bars.forEach((bar) => bar.classList.add("sorted"));
    }

    async function run() {
      if (running) return;

      running = true;

      runButton.disabled = true;
      shuffleButton.disabled = true;
      algorithm.disabled = true;

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      bars.forEach((bar) => {
        bar.classList.remove("sorted");
      });

      statusElement.textContent = "Running";

      const selected = algorithm.value;

      if (selected === "bubble") {
        await bubbleSort();
      } else if (selected === "selection") {
        await selectionSort();
      } else if (selected === "insertion") {
        await insertionSort();
      } else if (selected === "merge") {
        await mergeSort();
      } else {
        await quickSort();
      }

      clearMarks();

      bars.forEach((bar) => {
        bar.classList.add("sorted");
      });

      statusElement.textContent = "Complete";

      running = false;

      runButton.disabled = false;
      shuffleButton.disabled = false;
      algorithm.disabled = false;
    }

    function shuffle() {
      if (running) return;

      createArray();
      render();

      comparisons = 0;
      swaps = 0;

      updateMetrics();

      statusElement.textContent = "Ready";
    }

    runButton.addEventListener("click", run);
    shuffleButton.addEventListener("click", shuffle);

    shuffle();
  })();

  /* ================================================================
     HASH TABLE
     ================================================================ */

  (() => {
    const bucketsElement = document.getElementById("hash-buckets");
    const keyInput = document.getElementById(
      "hash-key"
    ) as HTMLInputElement | null;
    const valueInput = document.getElementById(
      "hash-value"
    ) as HTMLInputElement | null;
    const insertButton = document.getElementById(
      "hash-insert"
    ) as HTMLButtonElement | null;
    const randomButton = document.getElementById(
      "hash-random"
    ) as HTMLButtonElement | null;
    const clearButton = document.getElementById(
      "hash-clear"
    ) as HTMLButtonElement | null;
    const formula = document.getElementById("hash-formula");
    const load = document.getElementById("hash-load");

    if (
      !bucketsElement ||
      !keyInput ||
      !valueInput ||
      !insertButton ||
      !randomButton ||
      !clearButton ||
      !formula ||
      !load
    ) {
      return;
    }

    const BUCKETS = 8;

    type Entry = {
      key: string;
      value: string;
    };

    let table: Entry[][] = Array.from(
      { length: BUCKETS },
      () => []
    );

    function hash(key: string) {
      let value = 0;

      for (let i = 0; i < key.length; i++) {
        value =
          (value * 31 + key.charCodeAt(i)) >>> 0;
      }

      return value % BUCKETS;
    }

    function render() {
      bucketsElement.innerHTML = "";

      let count = 0;

      table.forEach((chain, index) => {
        count += chain.length;

        const bucket = document.createElement("div");
        bucket.className = "hash-bucket";

        const label = document.createElement("div");
        label.className = "hash-index";
        label.textContent = `bucket ${index}`;

        bucket.appendChild(label);

        const chainElement = document.createElement("div");
        chainElement.className = "hash-chain";

        chain.forEach((entry, entryIndex) => {
          const node = document.createElement("div");

          node.className =
            "hash-node" +
            (chain.length > 1 ? " collision" : "");

          node.textContent =
            `${entry.key} → ${entry.value}`;

          chainElement.appendChild(node);

          if (entryIndex < chain.length - 1) {
            const arrow = document.createElement("div");

            arrow.className = "hash-arrow";
            arrow.textContent = "↓";

            chainElement.appendChild(arrow);
          }
        });

        bucket.appendChild(chainElement);
        bucketsElement.appendChild(bucket);
      });

      load.textContent =
        (count / BUCKETS).toFixed(2);
    }

    function insert(key: string, value: string) {
      if (!key) return;

      const index = hash(key);
      const chain = table[index];

      const existing = chain.find(
        (entry) => entry.key === key
      );

      if (existing) {
        existing.value = value || existing.value;
      } else {
        chain.push({
          key,
          value: value || "—",
        });
      }

      formula.textContent =
        `hash("${key}") → ${index}  /  bucket ${index}` +
        (chain.length > 1
          ? "  /  collision → chaining"
          : "");

      render();
    }

    function randomKey() {
      const words = [
        "node",
        "heap",
        "tree",
        "graph",
        "byte",
        "stack",
        "queue",
        "hash",
        "sort",
        "data",
      ];

      return (
        words[Math.floor(Math.random() * words.length)] +
        Math.floor(Math.random() * 100)
      );
    }

    insertButton.addEventListener("click", () => {
      insert(
        keyInput.value.trim(),
        valueInput.value.trim()
      );

      keyInput.value = "";
      valueInput.value = "";

      keyInput.focus();
    });

    keyInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    valueInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        insertButton.click();
      }
    });

    randomButton.addEventListener("click", () => {
      insert(
        randomKey(),
        String(Math.floor(Math.random() * 1000))
      );
    });

    clearButton.addEventListener("click", () => {
      table = Array.from(
        { length: BUCKETS },
        () => []
      );

      formula.textContent =
        "Ready for insertion.";

      render();
    });

    render();
  })();

  /* ================================================================
     PATHFINDING
     ================================================================ */

  (() => {
    const gridElement = document.getElementById("path-grid");
    const algorithm = document.getElementById(
      "path-algo"
    ) as HTMLSelectElement | null;
    const runButton = document.getElementById(
      "path-run"
    ) as HTMLButtonElement | null;
    const wallsButton = document.getElementById(
      "path-walls"
    ) as HTMLButtonElement | null;
    const clearButton = document.getElementById(
      "path-clear"
    ) as HTMLButtonElement | null;
    const visitedElement = document.getElementById(
      "path-visited"
    );
    const lengthElement = document.getElementById(
      "path-length"
    );
    const statusElement = document.getElementById(
      "path-status"
    );

    if (
      !gridElement ||
      !algorithm ||
      !runButton ||
      !wallsButton ||
      !clearButton ||
      !visitedElement ||
      !lengthElement ||
      !statusElement
    ) {
      return;
    }

    const ROWS = 14;
    const COLS = 28;

    type Point = {
      r: number;
      c: number;
    };

    type Cell =
      | "empty"
      | "wall"
      | "start"
      | "end"
      | "visited"
      | "path";

    let grid: Cell[][] = [];
    let cells: HTMLDivElement[][] = [];

    let start: Point = {
      r: 7,
      c: 3,
    };

    let end: Point = {
      r: 7,
      c: 24,
    };

    let running = false;

    let dragMode:
      | "wall"
      | "erase"
      | "start"
      | "end"
      | null = null;

    function createGrid() {
      grid = Array.from(
        { length: ROWS },
        () =>
          Array.from(
            { length: COLS },
            () => "empty" as Cell
          )
      );

      grid[start.r][start.c] = "start";
      grid[end.r][end.c] = "end";
    }

    function className(cell: Cell) {
      return cell === "empty"
        ? "path-cell"
        : `path-cell ${cell}`;
    }

    function render() {
      gridElement.innerHTML = "";
      cells = [];

      for (let r = 0; r < ROWS; r++) {
        const row: HTMLDivElement[] = [];

        for (let c = 0; c < COLS; c++) {
          const element = document.createElement("div");

          element.className = className(grid[r][c]);

          element.addEventListener(
            "mousedown",
            (event) => {
              event.preventDefault();
              handleDown(r, c);
            }
          );

          element.addEventListener(
            "mouseenter",
            () => handleEnter(r, c)
          );

          gridElement.appendChild(element);

          row.push(element);
        }

        cells.push(row);
      }
    }

    function setCell(r: number, c: number, state: Cell) {
      grid[r][c] = state;

      const element = cells[r]?.[c];

      if (element) {
        element.className = className(state);
      }
    }

    function handleDown(r: number, c: number) {
      if (running) return;

      const state = grid[r][c];

      if (state === "start") {
        dragMode = "start";
        return;
      }

      if (state === "end") {
        dragMode = "end";
        return;
      }

      dragMode = state === "wall" ? "erase" : "wall";

      toggleWall(r, c);
    }

    function handleEnter(r: number, c: number) {
      if (running || !dragMode) return;

      if (dragMode === "wall") {
        toggleWall(r, c, true);
        return;
      }

      if (dragMode === "erase") {
        toggleWall(r, c, false);
        return;
      }

      if (dragMode === "start") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "end"
        ) {
          return;
        }

        setCell(start.r, start.c, "empty");

        start = { r, c };

        setCell(r, c, "start");

        return;
      }

      if (dragMode === "end") {
        if (
          grid[r][c] === "wall" ||
          grid[r][c] === "start"
        ) {
          return;
        }

        setCell(end.r, end.c, "empty");

        end = { r, c };

        setCell(r, c, "end");
      }
    }

    function toggleWall(
      r: number,
      c: number,
      force?: boolean
    ) {
      if (
        grid[r][c] === "start" ||
        grid[r][c] === "end"
      ) {
        return;
      }

      const shouldWall =
        force === undefined
          ? grid[r][c] !== "wall"
          : force;

      setCell(
        r,
        c,
        shouldWall ? "wall" : "empty"
      );
    }

    document.addEventListener("mouseup", () => {
      dragMode = null;
    });

    function key(point: Point) {
      return `${point.r},${point.c}`;
    }

    function neighbors(point: Point) {
      const directions: Point[] = [
        { r: -1, c: 0 },
        { r: 1, c: 0 },
        { r: 0, c: -1 },
        { r: 0, c: 1 },
      ];

      const result: Point[] = [];

      for (const direction of directions) {
        const r = point.r + direction.r;
        const c = point.c + direction.c;

        if (
          r >= 0 &&
          r < ROWS &&
          c >= 0 &&
          c < COLS &&
          grid[r][c] !== "wall"
        ) {
          result.push({ r, c });
        }
      }

      return result;
    }

    function heuristic(point: Point) {
      return (
        Math.abs(point.r - end.r) +
        Math.abs(point.c - end.c)
      );
    }

    async function bfs() {
      const queue: Point[] = [start];

      const visited = new Set<string>([key(start)]);
      const cameFrom = new Map<string, Point>();

      const order: Point[] = [];

      while (queue.length) {
        const current = queue.shift()!;

        if (key(current) !== key(start)) {
          order.push(current);
        }

        if (key(current) === key(end)) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        for (const next of neighbors(current)) {
          const nextKey = key(next);

          if (visited.has(nextKey)) continue;

          visited.add(nextKey);
          cameFrom.set(nextKey, current);

          queue.push(next);
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    async function weighted(
      mode: "dijkstra" | "astar"
    ) {
      const open: {
        point: Point;
        priority: number;
      }[] = [
        {
          point: start,
          priority: 0,
        },
      ];

      const distances = new Map<string, number>();

      distances.set(key(start), 0);

      const cameFrom = new Map<string, Point>();
      const closed = new Set<string>();

      const order: Point[] = [];

      while (open.length) {
        open.sort(
          (a, b) => a.priority - b.priority
        );

        const currentEntry = open.shift()!;
        const current = currentEntry.point;

        const currentKey = key(current);

        if (closed.has(currentKey)) continue;

        closed.add(currentKey);

        if (currentKey !== key(start)) {
          order.push(current);
        }

        if (currentKey === key(end)) {
          return {
            found: true,
            order,
            cameFrom,
          };
        }

        const currentDistance =
          distances.get(currentKey) ?? Infinity;

        for (const next of neighbors(current)) {
          const nextKey = key(next);

          if (closed.has(nextKey)) continue;

          const newCost = currentDistance + 1;

          if (
            newCost <
            (distances.get(nextKey) ?? Infinity)
          ) {
            distances.set(nextKey, newCost);
            cameFrom.set(nextKey, current);

            const priority =
              mode === "astar"
                ? newCost + heuristic(next)
                : newCost;

            open.push({
              point: next,
              priority,
            });
          }
        }
      }

      return {
        found: false,
        order,
        cameFrom,
      };
    }

    async function animateSearch(
      order: Point[]
    ) {
      for (let i = 0; i < order.length; i++) {
        const point = order[i];

        if (grid[point.r][point.c] === "empty") {
          setCell(
            point.r,
            point.c,
            "visited"
          );
        }

        visitedElement.textContent = String(i + 1);

        await sleep(7);
      }
    }

    function reconstruct(
      cameFrom: Map<string, Point>
    ) {
      const path: Point[] = [];

      let current = end;

      while (key(current) !== key(start)) {
        path.push(current);

        const previous =
          cameFrom.get(key(current));

        if (!previous) {
          return [];
        }

        current = previous;
      }

      path.reverse();

      return path;
    }

    async function run() {
      if (running) return;

      running = true;

      runButton.disabled = true;
      wallsButton.disabled = true;
      clearButton.disabled = true;
      algorithm.disabled = true;

      statusElement.textContent = "Searching";
      visitedElement.textContent = "0";
      lengthElement.textContent = "—";

      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (
            grid[r][c] === "visited" ||
            grid[r][c] === "path"
          ) {
            setCell(r, c, "empty");
          }
        }
      }

      const selected = algorithm.value;

      const result =
        selected === "bfs"
          ? await bfs()
          : await weighted(
              selected === "astar"
                ? "astar"
                : "dijkstra"
            );

      await animateSearch(result.order);

      if (!result.found) {
        statusElement.textContent =
          "No path found";

        running = false;

        runButton.disabled = false;
        wallsButton.disabled = false;
        clearButton.disabled = false;
        algorithm.disabled = false;

        return;
      }

      const path = reconstruct(
        result.cameFrom
      );

      for (const point of path) {
        if (key(point) !== key(end)) {
          setCell(
            point.r,
            point.c,
            "path"
          );
        }

        await sleep(18);
      }

      lengthElement.textContent =
        String(path.length);

      statusElement.textContent =
        "Path found";

      running = false;

      runButton.disabled = false;
      wallsButton.disabled = false;
      clearButton.disabled = false;
      algorithm.disabled = false;
    }

    function randomWalls() {
      if (running) return;

      createGrid();

      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (
            grid[r][c] === "empty" &&
            Math.random() < 0.25
          ) {
            grid[r][c] = "wall";
          }
        }
      }

      render();

      visitedElement.textContent = "0";
      lengthElement.textContent = "—";
      statusElement.textContent = "Ready";
    }

    function clear() {
      if (running) return;

      createGrid();
      render();

      visitedElement.textContent = "0";
      lengthElement.textContent = "—";
      statusElement.textContent = "Ready";
    }

    runButton.addEventListener("click", run);
    wallsButton.addEventListener(
      "click",
      randomWalls
    );
    clearButton.addEventListener(
      "click",
      clear
    );

    createGrid();
    render();
  })();
</script>
