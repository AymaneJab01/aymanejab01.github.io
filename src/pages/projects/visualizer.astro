<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  html {
    scroll-behavior: smooth;
  }

  .algorithm-page {
    /* -- Token system ------------------------------------------------ */
    --bg: #0a0c07;
    --bg-elev: #0f1209;
    --ink: #eef0e2;
    --ink-dim: rgba(238, 240, 226, 0.5);
    --ink-faint: rgba(238, 240, 226, 0.26);
    --olive: #8f9c5c;
    --olive-bright: #c3d68f;
    --olive-deep: #5b6b34;
    --olive-line: rgba(143, 156, 92, 0.16);
    --olive-line-strong: rgba(143, 156, 92, 0.32);
    --olive-wash: rgba(143, 156, 92, 0.08);
    --gold: #d9a94a;
    --rust: #b5563a;

    --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    position: relative;
    min-height: 100vh;
    overflow-x: hidden;

    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
  }

  .ascii-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.9;
    mask-image: radial-gradient(ellipse 80% 60% at 30% 0%, black, transparent 85%);
  }

  .shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* -- Sidebar --------------------------------------------------------- */

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;

    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--olive-line);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;

    color: var(--ink-dim);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;

    transition: color 200ms ease, transform 200ms ease;
  }

  .back-link:hover {
    color: var(--olive-bright);
    transform: translateX(-3px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--olive-bright);
    box-shadow: 0 0 0 4px var(--olive-wash), 0 0 16px rgba(195, 214, 143, 0.55);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .brand-cursor {
    color: var(--olive-bright);
    animation: blink 1.1s step-end infinite;
  }

  .brand-sub {
    margin-top: -1.4rem;
    color: var(--ink-faint);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  /* -- Language switcher --------------------------------------------- */

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;

    padding: 3px;
    border: 1px solid var(--olive-line-strong);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.22);
  }

  .lang-btn {
    min-width: 34px;
    padding: 0.32rem 0.6rem;
    border: none;
    border-radius: 999px;

    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;

    background: transparent;
    cursor: pointer;

    transition: color 180ms ease, background 180ms ease;
  }

  .lang-btn:hover {
    color: var(--ink);
  }

  .lang-btn.active {
    color: var(--bg);
    background: var(--olive-bright);
    font-weight: 600;
  }

  .doc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .doc-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    padding: 0.55rem 0.6rem;
    border-radius: 6px;

    color: var(--ink-dim);
    font-size: 0.76rem;
    text-decoration: none;

    transition: color 180ms ease, background 180ms ease;
  }

  .doc-nav a span:first-child {
    color: var(--olive);
    font-size: 0.66rem;
  }

  .doc-nav a:hover {
    color: var(--ink);
    background: var(--olive-wash);
  }

  .sidebar-foot {
    margin-top: auto;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-row span {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 999px;

    color: var(--ink-faint);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    background: var(--olive-wash);
  }

  /* -- Content ----------------------------------------------------------- */

  .content {
    width: min(920px, calc(100% - 32px));
    margin: 0 auto;
    padding: 3.5rem 0 4rem;
  }

  .hero {
    max-width: 760px;
    margin-bottom: 4.5rem;
    scroll-margin-top: 2rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.4rem;

    color: var(--ink-faint);
    font-size: 0.67rem;
    letter-spacing: 0.14em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--olive-bright);
    box-shadow: 0 0 0 4px var(--olive-wash), 0 0 18px rgba(195, 214, 143, 0.6);
  }

  .separator {
    opacity: 0.3;
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.6vw, 5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .hero h1 span:last-child {
    display: block;
    background: linear-gradient(100deg, var(--ink) 0%, var(--ink) 40%, var(--olive-bright) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 620px;
    margin: 1.8rem 0 0;
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.8;
  }

  .hero-key {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 1.8rem;

    color: var(--ink-faint);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .hero-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .key-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    display: inline-block;
  }

  .key-dot.compare { background: var(--olive-bright); }
  .key-dot.swap { background: var(--gold); }
  .key-dot.pivot { background: var(--rust); }
  .key-dot.sorted { background: var(--olive-deep); }

  .demo-section,
  .documentation {
    margin-bottom: 6rem;
    scroll-margin-top: 2rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  .section-number {
    padding-top: 0.25rem;
    color: var(--olive);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .section-label {
    margin-bottom: 0.6rem;
    color: var(--olive-bright);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    color: var(--ink);
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section-heading p {
    max-width: 620px;
    margin: 0.7rem 0 0;
    color: var(--ink-faint);
    line-height: 1.7;
    font-size: 0.86rem;
  }

  .demo-card {
    overflow: hidden;
    border: 1px solid var(--olive-line-strong);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--bg-elev), var(--bg));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02), 0 25px 70px rgba(0, 0, 0, 0.35);
  }

  .demo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.8rem;

    padding: 1.1rem;
    border-bottom: 1px solid var(--olive-line);
    background: rgba(0, 0, 0, 0.2);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .control-group label,
  .speed-control label {
    color: var(--ink-faint);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  select,
  .text-input {
    min-height: 36px;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 7px;
    outline: none;

    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;

    background: #0c0e08;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  select:focus,
  .text-input:focus {
    border-color: var(--olive-bright);
    box-shadow: 0 0 0 3px var(--olive-wash);
  }

  select option {
    background: #0c0e08;
  }

  .text-input {
    width: 120px;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.5rem;
  }

  .button {
    min-height: 36px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 7px;

    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;

    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;

    transition: color 200ms ease, border-color 200ms ease, background 200ms ease, transform 200ms ease;
  }

  .button:hover {
    color: var(--ink);
    border-color: var(--olive-bright);
    background: var(--olive-wash);
    transform: translateY(-1px);
  }

  .button.primary {
    color: var(--olive-bright);
    border-color: var(--olive-bright);
    background: var(--olive-wash);
  }

  .button.primary:hover {
    background: rgba(195, 214, 143, 0.16);
  }

  .button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .speed-control {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-left: auto;
  }

  .speed-control input {
    width: 110px;
    accent-color: var(--olive-bright);
  }

  .visual-stage {
    position: relative;
    padding: 1rem;
  }

  .sorting-stage {
    height: 300px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;

    width: 100%;
    height: 100%;
    padding: 1rem;

    border: 1px solid var(--olive-line);
    border-radius: 10px;
    background: linear-gradient(180deg, rgba(143, 156, 92, 0.03), transparent 60%), rgba(0, 0, 0, 0.22);
  }

  .viz-bar {
    position: relative;
    flex: 1;
    min-width: 2px;
    border-radius: 2px 2px 0 0;
    background: rgba(238, 240, 226, 0.2);
    transition: height 50ms linear, background 100ms ease, opacity 200ms ease;
  }

  .viz-bar.compare {
    background: var(--olive-bright);
    box-shadow: 0 0 12px rgba(195, 214, 143, 0.4);
  }

  .viz-bar.swap {
    background: var(--gold);
    box-shadow: 0 0 12px rgba(217, 169, 74, 0.4);
  }

  .viz-bar.pivot {
    background: var(--rust);
    box-shadow: 0 0 12px rgba(181, 86, 58, 0.45);
  }

  .viz-bar.sorted {
    background: var(--olive-deep);
  }

  .viz-bar.dim {
    opacity: 0.28;
  }

  .bar-value {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 4px;

    color: var(--ink-faint);
    font-size: 0.58rem;
    white-space: nowrap;
    pointer-events: none;
  }

  .pointer-row {
    display: flex;
    gap: 3px;
    padding: 0.4rem 1.1rem 0;
  }

  .pointer-slot {
    flex: 1;
    min-width: 2px;
    text-align: center;

    color: transparent;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color 150ms ease;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--olive-line);
  }

  .metrics > div {
    min-width: 130px;
    padding: 0.9rem 1.1rem;
    border-right: 1px solid var(--olive-line);
  }

  .metrics span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink-faint);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .metrics strong {
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.62rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    display: inline-block;
  }

  .legend-dot.compare { background: var(--olive-bright); }
  .legend-dot.swap { background: var(--gold); }
  .legend-dot.pivot { background: var(--rust); }
  .legend-dot.sorted { background: var(--olive-deep); }
  .legend-dot.start { background: var(--olive-bright); }
  .legend-dot.wall { background: rgba(238, 240, 226, 0.3); }
  .legend-dot.visited { background: rgba(143, 156, 92, 0.5); }
  .legend-dot.path { background: var(--gold); }

  .formula {
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: 0.75rem 1.1rem;

    color: var(--olive-bright);
    border-bottom: 1px solid var(--olive-line);
    font-size: 0.65rem;
    background: var(--olive-wash);
  }

  .algo-info {
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--olive-line);
    background: var(--olive-wash);
  }

  .algo-info-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.4rem;
  }

  .algo-info-head strong {
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .algo-info-head span {
    color: var(--olive-bright);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
  }

  .algo-info p {
    margin: 0;
    max-width: 640px;
    color: var(--ink-dim);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  #sort-narration {
    color: var(--ink);
    font-size: 0.72rem;
  }

  .hash-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 1rem;
  }

  .hash-bucket {
    min-height: 118px;
    padding: 0.7rem;
    border: 1px solid var(--olive-line);
    border-radius: 9px;
    background: rgba(0, 0, 0, 0.22);
  }

  .hash-index {
    color: var(--ink-faint);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .hash-chain {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .hash-node {
    padding: 0.45rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 6px;

    color: var(--ink-dim);
    font-size: 0.65rem;
    background: var(--olive-wash);

    animation: node-in 180ms ease;
  }

  .hash-node.collision {
    border-color: rgba(217, 169, 74, 0.4);
    background: rgba(217, 169, 74, 0.06);
  }

  .hash-arrow {
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.7rem;
  }

  .hash-footer {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.65rem;
  }

  .hash-footer strong {
    color: var(--olive-bright);
    font-weight: 500;
  }

  .path-stage {
    overflow: auto;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(28, minmax(12px, 1fr));
    gap: 2px;

    min-width: 620px;
    padding: 0.75rem;

    border: 1px solid var(--olive-line);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
  }

  .path-cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: rgba(238, 240, 226, 0.03);
    cursor: crosshair;
    transition: background 90ms ease;
  }

  .path-cell:hover {
    background: rgba(238, 240, 226, 0.1);
  }

  .path-cell.wall {
    background: rgba(238, 240, 226, 0.26);
  }

  .path-cell.start {
    background: var(--olive-bright);
    box-shadow: 0 0 14px rgba(195, 214, 143, 0.45);
  }

  .path-cell.end {
    background: var(--rust);
    box-shadow: 0 0 14px rgba(181, 86, 58, 0.4);
  }

  .path-cell.visited {
    background: rgba(143, 156, 92, 0.45);
    animation: visited-in 120ms ease;
  }

  .path-cell.path {
    background: var(--gold);
    box-shadow: 0 0 10px rgba(217, 169, 74, 0.3);
  }

  .path-help {
    margin-left: auto;
    align-self: center;
    color: var(--ink-faint);
    font-size: 0.6rem;
  }

  .documentation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;

    overflow: hidden;
    border: 1px solid var(--olive-line-strong);
    border-radius: 14px;
    background: var(--olive-line);
  }

  .documentation-grid article {
    min-height: 180px;
    padding: 1.4rem;
    background: var(--bg-elev);
    transition: background 250ms ease;
  }

  .documentation-grid article:hover {
    background: #131608;
  }

  .documentation-grid article > span {
    color: var(--olive-bright);
    font-size: 0.62rem;
  }

  .documentation-grid h3 {
    margin: 2.6rem 0 0.55rem;
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 600;
  }

  .documentation-grid p {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  /* -- Documentation accordions ------------------------------------- */

  .doc-group {
    margin-top: 2.2rem;
  }

  .doc-group:first-of-type {
    margin-top: 0;
  }

  .doc-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.9rem;

    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }

  .doc-group-title span:first-child {
    color: var(--olive);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .doc-item {
    border: 1px solid var(--olive-line-strong);
    border-radius: 10px;
    background: var(--bg-elev);
  }

  .doc-item + .doc-item {
    margin-top: 0.55rem;
  }

  .doc-item summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;

    padding: 0.85rem 1rem;
    cursor: pointer;
    list-style: none;

    transition: background 180ms ease;
  }

  .doc-item summary::-webkit-details-marker {
    display: none;
  }

  .doc-item summary:hover {
    background: var(--olive-wash);
  }

  .doc-item-name {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .badge {
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 999px;

    color: var(--olive-bright);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    background: var(--olive-wash);
  }

  .doc-item-toggle {
    margin-left: auto;
    position: relative;

    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .doc-item-toggle::before,
  .doc-item-toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;

    background: var(--olive-bright);
    transform: translate(-50%, -50%);
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .doc-item-toggle::before {
    width: 14px;
    height: 1.5px;
  }

  .doc-item-toggle::after {
    width: 1.5px;
    height: 14px;
  }

  .doc-item[open] .doc-item-toggle::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .doc-item-body {
    padding: 0 1.1rem 1.1rem;
    border-top: 1px solid var(--olive-line);
  }

  .doc-item-body p {
    margin: 0.9rem 0 0;
    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .doc-item-body p:first-child {
    margin-top: 0.9rem;
  }

  .doc-item-body code {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--olive-line-strong);
    border-radius: 4px;

    color: var(--olive-bright);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--olive-wash);
  }

  .doc-steps {
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;

    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .doc-steps li + li {
    margin-top: 0.2rem;
  }

  .doc-meta {
    color: var(--ink-faint) !important;
    font-size: 0.74rem !important;
    font-style: italic;
  }

  .page-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 1.8rem;
    border-top: 1px solid var(--olive-line);
    color: var(--ink-faint);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .page-footer a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .page-footer a:hover {
    color: var(--olive-bright);
  }

  @keyframes node-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes visited-in {
    from { opacity: 0.1; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (min-width: 980px) {
    .shell {
      flex-direction: row;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      width: 250px;
      flex: 0 0 250px;
      border-bottom: none;
      border-right: 1px solid var(--olive-line);
    }

    .content {
      width: min(820px, calc(100% - 64px));
      margin: 0 auto;
      padding: 4.5rem 0 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hash-grid {
      grid-template-columns: 1fr;
