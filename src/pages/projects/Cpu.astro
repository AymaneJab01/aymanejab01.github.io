---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="CPU Simulator">
  <main class="cpu-page">
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>

    <div class="cpu-shell">
      <aside class="cpu-sidebar">
        <a href="/home" class="back-link">
          <span class="back-arrow">←</span>
          <span>Back to home</span>
        </a>

        <div class="brand">
          <span class="brand-mark"></span>
          <div>
            <div class="brand-name">cpu<span>_</span></div>
            <div class="brand-sub">architecture / interactive lab</div>
          </div>
        </div>

        <nav class="doc-nav" aria-label="CPU simulator sections">
          <a href="#overview"><span>00</span><b>Overview</b></a>
          <a href="#simulator"><span>01</span><b>Simulator</b></a>
          <a href="#architecture"><span>02</span><b>Architecture</b></a>
          <a href="#instructions"><span>03</span><b>Instruction set</b></a>
          <a href="#concepts"><span>04</span><b>Key concepts</b></a>
        </nav>

        <div class="sidebar-status">
          <div class="live-row">
            <span class="live-dot"></span>
            <span>SIMULATOR READY</span>
          </div>
          <div class="tech-row">
            <span>ASTRO</span>
            <span>TYPESCRIPT</span>
            <span>CPU</span>
          </div>
        </div>
      </aside>

      <div class="cpu-content">
        <header class="hero" id="overview">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>PROJECT 06</span>
            <span class="separator">/</span>
            <span>COMPUTER ARCHITECTURE</span>
          </div>

          <h1>
            Fetch. Decode.
            <span>Execute.</span>
          </h1>

          <p class="hero-description">
            A tiny 8-register CPU you can program directly in the browser.
            Write instructions, assemble them, then watch the program counter,
            registers, memory and fetch-decode-execute cycle change in real time.
          </p>

          <div class="hero-stats">
            <div>
              <strong>8</strong>
              <span>REGISTERS</span>
            </div>
            <div>
              <strong>32</strong>
              <span>MEMORY CELLS</span>
            </div>
            <div>
              <strong>9</strong>
              <span>INSTRUCTIONS</span>
            </div>
            <div>
              <strong>3</strong>
              <span>CPU STAGES</span>
            </div>
          </div>
        </header>

        <section class="section" id="simulator">
          <div class="section-heading">
            <div class="section-number">01</div>
            <div>
              <div class="section-label">LIVE CPU SIMULATOR</div>
              <h2>Build a program. Run the machine.</h2>
              <p>
                Edit the assembly-like program, assemble it, then step through
                each instruction or let the CPU run automatically.
              </p>
            </div>
          </div>

          <div class="simulator-card">
            <div class="simulator-topbar">
              <div>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
              </div>
              <span class="topbar-title">CPU / EMULATOR</span>
              <span class="topbar-state"><i></i> LIVE</span>
            </div>

            <div class="cpu-layout">
              <div class="panel program-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-index">A</span>
                    <span class="panel-title">Program</span>
                  </div>
                  <span class="panel-meta">ASSEMBLY</span>
                </div>

                <textarea
                  id="cpu-program"
                  class="cpu-editor"
                  spellcheck="false"
                  aria-label="CPU assembly program"
                ></textarea>

                <div class="editor-footer">
                  <select id="cpu-example" class="cpu-select" aria-label="CPU example">
                    <option value="sum">Sum 1..5</option>
                    <option value="loop">Countdown loop</option>
                    <option value="fib">Fibonacci (first 6)</option>
                  </select>
                  <button id="cpu-load-example" class="cpu-btn">Load example</button>
                </div>

                <div class="instruction-hint">
                  <span>TIP</span>
                  Use <code>;</code> for comments and labels such as <code>LOOP:</code>.
                </div>
              </div>

              <div class="panel control-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-index">B</span>
                    <span class="panel-title">Processor state</span>
                  </div>
                  <span class="panel-meta">8 × GPR</span>
                </div>

                <div id="cpu-registers" class="cpu-registers"></div>

                <div class="cycle-block">
                  <div class="mini-label">FETCH / DECODE / EXECUTE</div>
                  <div id="cpu-cycle" class="cpu-cycle">
                    <span class="cpu-cycle-step" data-step="fetch">Fetch</span>
                    <span class="cpu-cycle-arrow">→</span>
                    <span class="cpu-cycle-step" data-step="decode">Decode</span>
                    <span class="cpu-cycle-arrow">→</span>
                    <span class="cpu-cycle-step" data-step="execute">Execute</span>
                  </div>
                </div>

                <div class="control-actions">
                  <button id="cpu-assemble" class="cpu-btn cpu-btn-primary">Assemble</button>
                  <button id="cpu-step" class="cpu-btn" disabled>Step</button>
                  <button id="cpu-run" class="cpu-btn" disabled>Run</button>
                  <button id="cpu-reset" class="cpu-btn">Reset</button>
                </div>

                <div class="machine-status">
                  <div><span>PROGRAM COUNTER</span><strong id="cpu-pc">0</strong></div>
                  <div><span>STATUS</span><strong id="cpu-status">Idle</strong></div>
                </div>
              </div>
            </div>

            <div class="execution-monitor">
              <div class="execution-main">
                <div class="execution-label">
                  <span>LIVE EXECUTION</span>
                  <span id="cpu-step-count">CYCLE 0</span>
                </div>
                <div class="execution-flow">
                  <div class="execution-stage" data-execution-stage="fetch">
                    <span class="execution-stage-number">01</span>
                    <strong>FETCH</strong>
                    <small>Read instruction</small>
                  </div>
                  <div class="execution-arrow">→</div>
                  <div class="execution-stage" data-execution-stage="decode">
                    <span class="execution-stage-number">02</span>
                    <strong>DECODE</strong>
                    <small>Interpret opcode</small>
                  </div>
                  <div class="execution-arrow">→</div>
                  <div class="execution-stage" data-execution-stage="execute">
                    <span class="execution-stage-number">03</span>
                    <strong>EXECUTE</strong>
                    <small>Update CPU state</small>
                  </div>
                </div>
              </div>

              <div class="current-instruction">
                <div class="current-instruction-head">
                  <span>CURRENT INSTRUCTION</span>
                  <span id="cpu-current-address">PC 00</span>
                </div>
                <code id="cpu-current-instruction">Waiting for program...</code>
                <div class="instruction-effect" id="cpu-instruction-effect">
                  Assemble a program, then press Step to see exactly what changes.
                </div>
              </div>
            </div>

            <div class="instruction-timeline-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">E</span>
                  <span class="panel-title">Instruction timeline</span>
                </div>
                <span class="panel-meta">PC TRACKING</span>
              </div>
              <div id="cpu-timeline" class="cpu-timeline">
                <div class="timeline-empty">No instructions loaded.</div>
              </div>
            </div>

            <div class="wide-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">C</span>
                  <span class="panel-title">Memory</span>
                </div>
                <span class="panel-meta">32 CELLS</span>
              </div>
              <div id="cpu-memory" class="cpu-memory"></div>
            </div>

            <div class="wide-panel console-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">D</span>
                  <span class="panel-title">Execution console</span>
                </div>
                <span class="panel-meta">TRACE</span>
              </div>
              <div id="cpu-console" class="cpu-console"></div>
            </div>
          </div>
        </section>

        <section class="section" id="architecture">
          <div class="section-heading">
            <div class="section-number">02</div>
            <div>
              <div class="section-label">ARCHITECTURE</div>
              <h2>What is inside this CPU?</h2>
              <p>
                The simulator reduces a processor to the essential pieces:
                registers, memory, a program counter, flags and an instruction cycle.
              </p>
            </div>
          </div>

          <div class="architecture-grid">
            <article class="architecture-card featured">
              <span class="card-number">01</span>
              <div class="architecture-icon">REG</div>
              <h3>Registers</h3>
              <p>
                Eight general-purpose registers, R0 through R7, provide the
                fastest storage available to the simulated CPU.
              </p>
              <div class="card-code">R0 · R1 · R2 · ... · R7</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">02</span>
              <div class="architecture-icon">MEM</div>
              <h3>Memory</h3>
              <p>
                Thirty-two addressable memory cells hold values that programs
                can read with LOAD and write with STORE.
              </p>
              <div class="card-code">ADDRESS 00 — 31</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">03</span>
              <div class="architecture-icon">PC</div>
              <h3>Program counter</h3>
              <p>
                The PC identifies the next instruction. Sequential execution
                increments it, while jumps replace it with a label target.
              </p>
              <div class="card-code">PC → instruction[PC]</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">04</span>
              <div class="architecture-icon">ZF</div>
              <h3>Zero flag</h3>
              <p>
                CMP updates the zero flag when two operands are equal. JZ uses
                that flag to decide whether a branch should happen.
              </p>
              <div class="card-code">CMP → ZF → JZ</div>
            </article>
          </div>

          <div class="pipeline">
            <div class="pipeline-label">INSTRUCTION PIPELINE — CONCEPTUAL VIEW</div>
            <div class="pipeline-track">
              <div class="pipeline-step">
                <span>01</span>
                <strong>FETCH</strong>
                <small>Read instruction at PC</small>
              </div>
              <div class="pipeline-connector"></div>
              <div class="pipeline-step">
                <span>02</span>
                <strong>DECODE</strong>
                <small>Identify operation + operands</small>
              </div>
              <div class="pipeline-connector"></div>
              <div class="pipeline-step active">
                <span>03</span>
                <strong>EXECUTE</strong>
                <small>Change CPU state</small>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="instructions">
          <div class="section-heading">
            <div class="section-number">03</div>
            <div>
              <div class="section-label">INSTRUCTION SET</div>
              <h2>The CPU's vocabulary.</h2>
              <p>
                These nine operations are enough to demonstrate arithmetic,
                memory access, comparisons, control flow and termination.
              </p>
            </div>
          </div>

          <div class="instruction-table">
            <div class="instruction-row instruction-head">
              <span>OPCODE</span>
              <span>FORM</span>
              <span>WHAT IT DOES</span>
            </div>
            <div class="instruction-row">
              <code>MOV</code><span>R0, value</span><p>Copies an immediate value or another register into the destination.</p>
            </div>
            <div class="instruction-row">
              <code>ADD</code><span>R0, value</span><p>Adds the operand to the destination register.</p>
            </div>
            <div class="instruction-row">
              <code>SUB</code><span>R0, value</span><p>Subtracts the operand from the destination register.</p>
            </div>
            <div class="instruction-row">
              <code>LOAD</code><span>R0, addr</span><p>Reads a value from memory into a register.</p>
            </div>
            <div class="instruction-row">
              <code>STORE</code><span>value, addr</span><p>Writes a value into one of the 32 memory cells.</p>
            </div>
            <div class="instruction-row">
              <code>CMP</code><span>R0, value</span><p>Compares two operands and updates the zero flag.</p>
            </div>
            <div class="instruction-row">
              <code>JMP</code><span>LABEL</span><p>Unconditionally changes the program counter.</p>
            </div>
            <div class="instruction-row">
              <code>JZ</code><span>LABEL</span><p>Jumps only when the zero flag is set.</p>
            </div>
            <div class="instruction-row">
              <code>HALT</code><span>—</span><p>Stops execution and leaves the final machine state visible.</p>
            </div>
          </div>
        </section>

        <section class="section documentation" id="concepts">
          <div class="section-heading">
            <div class="section-number">04</div>
            <div>
              <div class="section-label">REFERENCE</div>
              <h2>Key CPU concepts, explained.</h2>
              <p>
                Use these notes alongside the simulator to connect the visual
                state changes to the underlying computer architecture ideas.
              </p>
            </div>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>01</span> The instruction cycle</div>

            <details class="doc-item" open>
              <summary>
                <span class="doc-item-name">Fetch → Decode → Execute</span>
                <span class="badge">core concept</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  The CPU repeatedly obtains the next instruction, interprets
                  what that instruction means, and performs the requested
                  operation. This simulator makes those three phases visible
                  during every step.
                </p>
                <ol>
                  <li><strong>Fetch:</strong> use the PC to locate the next instruction.</li>
                  <li><strong>Decode:</strong> identify the opcode and operands.</li>
                  <li><strong>Execute:</strong> modify registers, memory, flags or control flow.</li>
                </ol>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Program counter</span>
                <span class="badge">PC</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  The program counter stores the address or index of the next
                  instruction to execute. Normally it advances sequentially;
                  JMP and JZ replace it with a different instruction index.
                </p>
                <div class="formula-box">PC → instruction → PC + 1</div>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Registers vs memory</span>
                <span class="badge">storage</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  Registers are small, directly accessible storage locations
                  inside the CPU. Memory is a larger addressable storage area.
                  LOAD moves data from memory into a register; STORE writes it back.
                </p>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>02</span> Control flow & flags</div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">CMP and the zero flag</span>
                <span class="badge">branching</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  CMP does not need to store a result in a general-purpose
                  register. Instead, it records whether the two operands are
                  equal in the zero flag. JZ can then use that condition to
                  choose between continuing sequentially and jumping to a label.
                </p>
                <div class="formula-box">CMP A, B → ZF = (A === B) → JZ LABEL</div>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Loops</span>
                <span class="badge">control flow</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  A loop is created by combining a label, a state-changing
                  instruction, a comparison and a conditional or unconditional
                  jump. The countdown and sum examples demonstrate this pattern.
                </p>
                <ol>
                  <li>Update a register representing the loop state.</li>
                  <li>Compare it with a stopping condition.</li>
                  <li>Use JZ to leave the loop or JMP to repeat it.</li>
                </ol>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>03</span> From simulator to real CPU</div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">What this model leaves out</span>
                <span class="badge">perspective</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  This is intentionally a teaching model. A real processor adds
                  many more details: instruction encoding, control logic,
                  caches, buses, pipelining, branch prediction, interrupts,
                  privilege levels and physical hardware timing.
                </p>
                <p>
                  The simplified machine is useful because the same fundamental
                  ideas remain visible: instructions change state, the PC drives
                  control flow, registers hold working data, and memory stores
                  persistent values.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name">Why assembly matters</span>
                <span class="badge">low level</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body">
                <p>
                  Assembly exposes operations close to the processor's
                  instruction model. Instead of expressing a high-level loop
                  directly, you explicitly manipulate registers, compare values,
                  store data and change the program counter.
                </p>
              </div>
            </details>
          </div>
        </section>

        <footer class="page-footer">
          <span>CPU SIMULATOR · COMPUTER ARCHITECTURE</span>
          <a href="/home">← Home</a>
        </footer>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  html { scroll-behavior: smooth; }

  .cpu-page {
    --bg: #070b0f;
    --bg-soft: #0b1117;
    --panel: rgba(12, 19, 26, 0.88);
    --panel-2: rgba(8, 14, 20, 0.92);
    --white: #edf6f5;
    --muted: rgba(237, 246, 245, 0.58);
    --faint: rgba(237, 246, 245, 0.31);
    --line: rgba(101, 220, 198, 0.15);
    --line-strong: rgba(101, 220, 198, 0.30);
    --sec: #55e6c1;
    --blue: #62a8ff;
    --blue-soft: rgba(98, 168, 255, 0.10);
    --green-soft: rgba(85, 230, 193, 0.09);
    --amber: #f4bd62;
    --red: #ff6f76;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    color: var(--white);
    background:
      radial-gradient(circle at 75% 4%, rgba(62, 130, 255, 0.09), transparent 28rem),
      radial-gradient(circle at 20% 22%, rgba(55, 230, 193, 0.06), transparent 25rem),
      var(--bg);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .ambient-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .35;
    background-image:
      linear-gradient(rgba(85,230,193,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(85,230,193,.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  .scanline {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .035;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255,255,255,.35) 4px
    );
  }

  .cpu-shell {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100vh;
  }

  .cpu-sidebar {
    width: 252px;
    flex: 0 0 252px;
    min-height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 2.15rem;
    padding: 2rem 1.35rem;
    border-right: 1px solid var(--line);
    background: rgba(5, 10, 14, .74);
    backdrop-filter: blur(16px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    width: fit-content;
    color: var(--muted);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color .2s ease, transform .2s ease;
  }

  .back-link:hover { color: var(--sec); transform: translateX(-3px); }
  .back-arrow { font-size: 1rem; }

  .brand { display: flex; align-items: center; gap: .7rem; }
  .brand-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 0 5px var(--green-soft), 0 0 22px rgba(85,230,193,.7);
  }
  .brand-name {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }
  .brand-name span { color: var(--sec); }
  .brand-sub {
    margin-top: .18rem;
    color: var(--faint);
    font-size: .58rem;
    letter-spacing: .05em;
  }

  .doc-nav { display: flex; flex-direction: column; gap: .18rem; }
  .doc-nav a {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: .5rem;
    padding: .65rem .55rem;
    border-radius: 7px;
    color: var(--muted);
    font-size: .68rem;
    text-decoration: none;
    transition: background .18s ease, color .18s ease;
  }
  .doc-nav a span { color: var(--sec); opacity: .55; font-size: .6rem; }
  .doc-nav a b { font-weight: 400; }
  .doc-nav a:hover {
    color: var(--white);
    background: var(--green-soft);
  }

  .sidebar-status { margin-top: auto; }
  .live-row {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: .8rem;
    color: var(--sec);
    font-size: .58rem;
    letter-spacing: .1em;
  }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 10px rgba(85,230,193,.7);
  }
  .tech-row { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tech-row span {
    padding: .38rem .55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--faint);
    font-size: .53rem;
    letter-spacing: .08em;
  }

  .cpu-content {
    width: min(930px, calc(100% - 64px));
    margin: 0 auto;
    padding: 4.6rem 0 5rem;
  }

  .hero { max-width: 790px; margin-bottom: 5.5rem; scroll-margin-top: 2rem; }
  .eyebrow {
    display: flex; align-items: center; gap: .62rem;
    margin-bottom: 1.35rem;
    color: var(--faint);
    font-size: .63rem;
    letter-spacing: .15em;
  }
  .status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 0 4px var(--green-soft), 0 0 17px rgba(85,230,193,.55);
  }
  .separator { opacity: .3; }

  .hero h1 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3rem, 7vw, 5.6rem);
    line-height: .93;
    letter-spacing: -.055em;
    font-weight: 600;
  }
  .hero h1 span {
    display: block;
    background: linear-gradient(100deg, var(--white) 25%, var(--sec) 72%, var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-description {
    max-width: 690px;
    margin: 1.8rem 0 0;
    color: var(--muted);
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(8,14,20,.58);
  }
  .hero-stats div {
    padding: 1rem 1.1rem;
    border-right: 1px solid var(--line);
  }
  .hero-stats div:last-child { border-right: 0; }
  .hero-stats strong {
    display: block;
    color: var(--sec);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .hero-stats span {
    display: block;
    margin-top: .3rem;
    color: var(--faint);
    font-size: .53rem;
    letter-spacing: .08em;
  }

  .section {
    margin-bottom: 6.5rem;
    scroll-margin-top: 2rem;
  }
  .section-heading {
    display: grid;
    grid-template-columns: 44px minmax(0,1fr);
    gap: 1.1rem;
    margin-bottom: 1.8rem;
  }
  .section-number {
    padding-top: .25rem;
    color: var(--sec);
    font-size: .65rem;
    letter-spacing: .1em;
  }
  .section-label {
    margin-bottom: .55rem;
    color: var(--sec);
    font-size: .61rem;
    letter-spacing: .14em;
  }
  .section-heading h2 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.55rem, 3.3vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -.025em;
    font-weight: 600;
  }
  .section-heading p {
    max-width: 650px;
    margin: .7rem 0 0;
    color: var(--faint);
    font-family: "Space Grotesk", sans-serif;
    font-size: .88rem;
    line-height: 1.7;
  }

  .simulator-card {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 15px;
    background: linear-gradient(180deg, rgba(13,22,29,.94), rgba(6,11,16,.95));
    box-shadow: 0 28px 90px rgba(0,0,0,.35), inset 0 1px rgba(255,255,255,.025);
  }
  .simulator-topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 42px;
    padding: 0 .95rem;
    border-bottom: 1px solid var(--line);
    background: rgba(0,0,0,.2);
  }
  .terminal-dot {
    display: inline-block;
    width: 7px; height: 7px; margin-right: 4px;
    border-radius: 50%;
    background: rgba(237,246,245,.25);
  }
  .topbar-title { color: var(--faint); font-size: .55rem; letter-spacing: .12em; }
  .topbar-state { justify-self: end; color: var(--sec); font-size: .53rem; letter-spacing: .1em; }
  .topbar-state i {
    display: inline-block; width: 5px; height: 5px; margin-right: 5px;
    border-radius: 50%; background: var(--sec);
  }

  .cpu-layout {
    display: grid;
    grid-template-columns: 1.08fr .92fr;
    gap: 1px;
    background: var(--line);
  }
  .panel, .wide-panel { background: var(--panel); padding: 1.25rem; }
  .wide-panel { border-top: 1px solid var(--line); }
  .panel-heading {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: .9rem;
  }
  .panel-heading > div { display: flex; align-items: center; gap: .6rem; }
  .panel-index {
    display: inline-grid; place-items: center;
    width: 22px; height: 22px; border-radius: 5px;
    border: 1px solid var(--line-strong);
    color: var(--sec); font-size: .57rem;
  }
  .panel-title { color: var(--white); font-size: .67rem; letter-spacing: .07em; text-transform: uppercase; }
  .panel-meta { color: var(--faint); font-size: .52rem; letter-spacing: .08em; }

  .cpu-editor {
    display: block;
    width: 100%;
    min-height: 290px;
    resize: vertical;
    box-sizing: border-box;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    outline: none;
    color: #c9fff1;
    background: #050a0e;
    font: .76rem/1.75 "JetBrains Mono", monospace;
    tab-size: 2;
    caret-color: var(--sec);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .cpu-editor:focus {
    border-color: var(--sec);
    box-shadow: 0 0 0 3px var(--green-soft);
  }

  .editor-footer, .control-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .8rem; }
  .cpu-select, .cpu-btn {
    min-height: 35px;
    padding: .48rem .78rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    color: var(--muted);
    background: rgba(255,255,255,.018);
    font: .63rem "JetBrains Mono", monospace;
    cursor: pointer;
    transition: all .2s ease;
  }
  .cpu-select { background: #081017; color: var(--white); }
  .cpu-btn:hover:not(:disabled) {
    color: var(--white);
    border-color: var(--sec);
    background: var(--green-soft);
    transform: translateY(-1px);
  }
  .cpu-btn-primary { color: var(--sec); border-color: var(--sec); }
  .cpu-btn:disabled { opacity: .3; cursor: not-allowed; }
  .instruction-hint {
    margin-top: .8rem;
    color: var(--faint);
    font-size: .56rem;
    line-height: 1.6;
  }
  .instruction-hint span {
    margin-right: .45rem;
    color: var(--blue);
    letter-spacing: .08em;
  }
  .instruction-hint code, .cpu-code {
    color: var(--sec);
    padding: .08rem .28rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--green-soft);
  }

  .cpu-registers { display: grid; grid-template-columns: repeat(4, 1fr); gap: .45rem; }
  .cpu-register {
    min-height: 56px;
    padding: .5rem;
    box-sizing: border-box;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(255,255,255,.018);
    transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .cpu-register.active {
    border-color: var(--sec);
    background: var(--green-soft);
    box-shadow: 0 0 18px rgba(85,230,193,.08);
  }
  .cpu-register-label { color: var(--faint); font-size: .55rem; }
  .cpu-register-value { margin-top: .18rem; color: var(--white); font-size: .88rem; }

  .cycle-block { margin-top: 1.25rem; }
  .mini-label { margin-bottom: .55rem; color: var(--faint); font-size: .51rem; letter-spacing: .1em; }
  .cpu-cycle { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .cpu-cycle-step {
    padding: .42rem .62rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    font-size: .59rem;
    transition: all .2s ease;
  }
  .cpu-cycle-step.active {
    color: var(--sec);
    border-color: var(--sec);
    background: var(--green-soft);
    box-shadow: 0 0 16px rgba(85,230,193,.08);
  }
  .cpu-cycle-arrow { color: var(--faint); font-size: .7rem; }

  .machine-status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .machine-status div { padding-top: .75rem; }
  .machine-status div + div { padding-left: 1rem; border-left: 1px solid var(--line); }
  .machine-status span { display: block; color: var(--faint); font-size: .5rem; letter-spacing: .08em; }
  .machine-status strong { display: block; margin-top: .25rem; color: var(--sec); font-size: .72rem; font-weight: 500; }

  .cpu-memory { display: grid; grid-template-columns: repeat(8, 1fr); gap: .42rem; }
  .cpu-cell {
    min-width: 0;
    padding: .45rem .2rem;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(255,255,255,.015);
    transition: border-color .2s ease, background .2s ease;
  }
  .cpu-cell.active { border-color: var(--amber); background: rgba(244,189,98,.09); }
  .cpu-cell-addr { color: var(--faint); font-size: .48rem; }
  .cpu-cell-value { margin-top: .18rem; color: var(--white); font-size: .7rem; }

  .cpu-console {
    min-height: 72px;
    max-height: 190px;
    overflow-y: auto;
    padding: .8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #050a0e;
    color: var(--muted);
    font: .62rem/1.7 "JetBrains Mono", monospace;
  }
  .cpu-console-line { animation: cpu-fade-in .25s ease forwards; }
  .cpu-console-line.err { color: var(--red); }
  .cpu-console-line.out { color: var(--sec); }

  /* =========================================================
     CLEAR CPU EXECUTION VISUALIZER
     ========================================================= */

  .execution-monitor {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 1px;
    background: var(--line);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .execution-main,
  .current-instruction {
    min-width: 0;
    padding: 1.15rem 1.25rem;
    background: rgba(7, 14, 19, .96);
  }

  .execution-label,
  .current-instruction-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
    margin-bottom: .75rem;
    color: var(--faint);
    font-size: .51rem;
    letter-spacing: .11em;
  }

  .execution-label > span:first-child {
    color: var(--sec);
  }

  #cpu-step-count {
    color: var(--blue);
  }

  .execution-flow {
    display: flex;
    align-items: stretch;
    gap: .45rem;
  }

  .execution-stage {
    flex: 1;
    min-width: 0;
    padding: .78rem .7rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255,255,255,.015);
    opacity: .48;
    transform: scale(.98);
    transition: opacity .18s ease, border-color .18s ease,
      background .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .execution-stage.active {
    opacity: 1;
    transform: scale(1);
    border-color: var(--sec);
    background: var(--green-soft);
    box-shadow: 0 0 24px rgba(85,230,193,.12);
  }

  .execution-stage.done {
    opacity: .72;
    border-color: rgba(98,168,255,.35);
    background: var(--blue-soft);
  }

  .execution-stage-number {
    display: block;
    margin-bottom: .35rem;
    color: var(--faint);
    font-size: .47rem;
  }

  .execution-stage.active .execution-stage-number {
    color: var(--sec);
  }

  .execution-stage strong {
    display: block;
    color: var(--white);
    font-size: .62rem;
    letter-spacing: .06em;
  }

  .execution-stage small {
    display: block;
    margin-top: .3rem;
    color: var(--faint);
    font-size: .49rem;
    line-height: 1.4;
  }

  .execution-arrow {
    display: grid;
    place-items: center;
    color: var(--line-strong);
    font-size: .9rem;
  }

  .current-instruction {
    border-left: 1px solid var(--line);
  }

  .current-instruction-head {
    margin-bottom: .7rem;
  }

  #cpu-current-address {
    color: var(--amber);
  }

  #cpu-current-instruction {
    display: block;
    overflow-x: auto;
    padding: .7rem .8rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    color: var(--white);
    background: #050a0e;
    font: .75rem/1.5 "JetBrains Mono", monospace;
    white-space: pre;
  }

  .instruction-effect {
    min-height: 2.4em;
    margin-top: .6rem;
    color: var(--muted);
    font: .64rem/1.55 "Space Grotesk", sans-serif;
  }

  .instruction-effect.changed {
    color: var(--sec);
  }

  .instruction-timeline-panel {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--line);
    background: rgba(6, 12, 17, .96);
  }

  .cpu-timeline {
    display: flex;
    gap: .38rem;
    overflow-x: auto;
    padding: .1rem .05rem .45rem;
    scrollbar-width: thin;
  }

  .timeline-item {
    flex: 0 0 auto;
    min-width: 92px;
    padding: .55rem .62rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(255,255,255,.015);
    transition: border-color .18s ease, background .18s ease, transform .18s ease;
  }

  .timeline-item.active {
    border-color: var(--sec);
    background: var(--green-soft);
    transform: translateY(-2px);
    box-shadow: 0 0 18px rgba(85,230,193,.08);
  }

  .timeline-item.executed {
    border-color: rgba(98,168,255,.28);
    background: var(--blue-soft);
  }

  .timeline-pc {
    display: block;
    color: var(--faint);
    font-size: .46rem;
  }

  .timeline-op {
    display: block;
    margin-top: .25rem;
    color: var(--sec);
    font-size: .58rem;
    font-weight: 600;
  }

  .timeline-raw {
    display: block;
    max-width: 120px;
    margin-top: .25rem;
    overflow: hidden;
    color: var(--muted);
    font-size: .49rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-empty {
    width: 100%;
    padding: .65rem;
    border: 1px dashed var(--line);
    border-radius: 7px;
    color: var(--faint);
    font-size: .55rem;
    text-align: center;
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--line);
  }
  .architecture-card {
    position: relative;
    min-height: 205px;
    padding: 1.35rem;
    background: rgba(10,17,23,.94);
    transition: background .25s ease, transform .25s ease;
  }
  .architecture-card:hover { background: #0d1820; }
  .architecture-card.featured { background: linear-gradient(145deg, rgba(20,42,42,.9), rgba(9,17,23,.95)); }
  .card-number { color: var(--sec); font-size: .55rem; letter-spacing: .1em; }
  .architecture-icon {
    margin-top: 2.4rem;
    color: var(--blue);
    font-size: .62rem;
    letter-spacing: .15em;
  }
  .architecture-card h3 {
    margin: .45rem 0 .5rem;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.05rem;
  }
  .architecture-card p { margin: 0; color: var(--muted); font: .78rem/1.7 "Space Grotesk", sans-serif; }
  .card-code {
    margin-top: 1rem;
    color: var(--faint);
    font-size: .54rem;
  }

  .pipeline {
    margin-top: 1.1rem;
    padding: 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: rgba(8,14,20,.72);
  }
  .pipeline-label { margin-bottom: 1rem; color: var(--faint); font-size: .55rem; letter-spacing: .1em; }
  .pipeline-track { display: flex; align-items: stretch; }
  .pipeline-step {
    flex: 1;
    padding: 1rem;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.012);
  }
  .pipeline-step.active { border-color: var(--sec); background: var(--green-soft); }
  .pipeline-step span { color: var(--sec); font-size: .55rem; }
  .pipeline-step strong { display: block; margin-top: .45rem; font-size: .68rem; }
  .pipeline-step small { display: block; margin-top: .35rem; color: var(--faint); font-size: .54rem; line-height: 1.5; }
  .pipeline-connector { width: 28px; align-self: center; height: 1px; background: var(--line-strong); }

  .instruction-table {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--line);
  }
  .instruction-row {
    display: grid;
    grid-template-columns: 95px 150px 1fr;
    gap: 1px;
    align-items: center;
    min-height: 52px;
    padding: 0 1rem;
    background: rgba(9,16,22,.96);
    border-bottom: 1px solid var(--line);
  }
  .instruction-row:last-child { border-bottom: 0; }
  .instruction-head {
    min-height: 38px;
    color: var(--faint);
    background: rgba(0,0,0,.25);
    font-size: .5rem;
    letter-spacing: .1em;
  }
  .instruction-row code { color: var(--sec); font-size: .65rem; }
  .instruction-row span { color: var(--blue); font-size: .57rem; }
  .instruction-row p { margin: 0; color: var(--muted); font: .73rem/1.5 "Space Grotesk", sans-serif; }

  .doc-group { margin-top: 2.25rem; }
  .doc-group:first-of-type { margin-top: 0; }
  .doc-group-title {
    display: flex; align-items: baseline; gap: .65rem;
    margin-bottom: .8rem;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1rem;
    font-weight: 600;
  }
  .doc-group-title span { color: var(--sec); font: .6rem "JetBrains Mono", monospace; }

  .doc-item {
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    background: rgba(9,16,22,.9);
  }
  .doc-item + .doc-item { margin-top: .5rem; }
  .doc-item summary {
    display: flex; align-items: center; gap: .65rem;
    padding: .85rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  .doc-item summary::-webkit-details-marker { display: none; }
  .doc-item summary:hover { background: var(--green-soft); }
  .doc-item-name {
    color: var(--white);
    font-family: "Space Grotesk", sans-serif;
    font-size: .83rem;
    font-weight: 600;
  }
  .badge {
    padding: .2rem .5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--sec);
    font-size: .5rem;
    background: var(--green-soft);
  }
  .doc-toggle {
    position: relative;
    width: 14px; height: 14px; margin-left: auto;
  }
  .doc-toggle::before, .doc-toggle::after {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    background: var(--sec);
    transform: translate(-50%,-50%);
    transition: opacity .2s ease, transform .2s ease;
  }
  .doc-toggle::before { width: 14px; height: 1px; }
  .doc-toggle::after { width: 1px; height: 14px; }
  .doc-item[open] .doc-toggle::after { opacity: 0; transform: translate(-50%,-50%) rotate(90deg); }

  .doc-body {
    padding: 0 1.1rem 1.1rem;
    border-top: 1px solid var(--line);
  }
  .doc-body p, .doc-body li {
    color: var(--muted);
    font: .8rem/1.75 "Space Grotesk", sans-serif;
  }
  .doc-body p { margin: .9rem 0 0; }
  .doc-body ol { margin: .9rem 0 0; padding-left: 1.2rem; }
  .doc-body li + li { margin-top: .25rem; }
  .doc-body strong { color: var(--white); }
  .formula-box {
    margin-top: .9rem;
    padding: .7rem .85rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--sec);
    background: var(--green-soft);
    font-size: .62rem;
  }

  .page-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 1.7rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: .55rem;
    letter-spacing: .08em;
  }
  .page-footer a { color: var(--muted); text-decoration: none; }
  .page-footer a:hover { color: var(--sec); }

  @keyframes cpu-fade-in {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 980px) {
    .cpu-shell { display: block; }
    .cpu-sidebar {
      position: relative;
      width: auto;
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 1.25rem;
      gap: 1.25rem;
    }
    .doc-nav { display: grid; grid-template-columns: repeat(5, 1fr); }
    .sidebar-status { margin-top: 0; }
    .cpu-content { width: min(930px, calc(100% - 32px)); }
  }

  @media (max-width: 760px) {
    .cpu-content { padding-top: 3rem; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); }
    .hero-stats div:nth-child(2) { border-right: 0; }
    .hero-stats div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .cpu-layout { grid-template-columns: 1fr; }
    .execution-monitor { grid-template-columns: 1fr; }
    .current-instruction { border-left: 0; border-top: 1px solid var(--line); }
    .architecture-grid { grid-template-columns: 1fr; }
    .pipeline-track { display: grid; grid-template-columns: 1fr; gap: .5rem; }
    .pipeline-connector { width: 1px; height: 18px; margin-left: 1.2rem; }
    .instruction-row { grid-template-columns: 75px 105px 1fr; }
    .doc-nav { grid-template-columns: repeat(2, 1fr); }
    .cpu-memory { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 520px) {
    .cpu-content { width: min(100% - 22px, 930px); }
    .hero h1 { font-size: clamp(2.65rem, 15vw, 4.1rem); }
    .hero-description { font-size: .92rem; }
    .section-heading { grid-template-columns: 32px minmax(0,1fr); gap: .7rem; }
    .simulator-card { border-radius: 11px; }
    .panel, .wide-panel { padding: .9rem; }
    .cpu-editor { min-height: 245px; }
    .execution-flow { gap: .25rem; }
    .execution-stage { padding: .65rem .45rem; }
    .execution-stage small { display: none; }
    .cpu-registers { grid-template-columns: repeat(2, 1fr); }
    .instruction-row { grid-template-columns: 68px 92px 1fr; padding: 0 .65rem; }
    .instruction-row p { font-size: .65rem; }
    .instruction-head { font-size: .43rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: .001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .001ms !important;
    }
  }
</style>

<script>
function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  (function cpuModule() {
    const programEl = document.getElementById("cpu-program") as HTMLTextAreaElement;
    const exampleSelect = document.getElementById("cpu-example") as HTMLSelectElement;
    const loadExampleBtn = document.getElementById("cpu-load-example") as HTMLButtonElement;
    const registersEl = document.getElementById("cpu-registers");
    const cycleEl = document.getElementById("cpu-cycle");
    const assembleBtn = document.getElementById("cpu-assemble") as HTMLButtonElement;
    const stepBtn = document.getElementById("cpu-step") as HTMLButtonElement;
    const runBtn = document.getElementById("cpu-run") as HTMLButtonElement;
    const resetBtn = document.getElementById("cpu-reset") as HTMLButtonElement;
    const pcEl = document.getElementById("cpu-pc");
    const statusEl = document.getElementById("cpu-status");
    const memoryEl = document.getElementById("cpu-memory");
    const consoleEl = document.getElementById("cpu-console");
    const executionStages = document.querySelectorAll("[data-execution-stage]");
    const stepCountEl = document.getElementById("cpu-step-count");
    const currentAddressEl = document.getElementById("cpu-current-address");
    const currentInstructionEl = document.getElementById("cpu-current-instruction");
    const instructionEffectEl = document.getElementById("cpu-instruction-effect");
    const timelineEl = document.getElementById("cpu-timeline");

    if (!programEl || !exampleSelect || !loadExampleBtn || !registersEl || !cycleEl ||
        !assembleBtn || !stepBtn || !runBtn || !resetBtn || !pcEl || !statusEl ||
        !memoryEl || !consoleEl || !stepCountEl || !currentAddressEl ||
        !currentInstructionEl || !instructionEffectEl || !timelineEl) return;

    const REG_COUNT = 8;
    const MEM_SIZE = 32;

    type Instruction = { op: string; args: string[]; raw: string };

    let registers = new Array(REG_COUNT).fill(0);
    let memory = new Array(MEM_SIZE).fill(0);
    let program: Instruction[] = [];
    let pc = 0;
    let zeroFlag = false;
    let halted = true;
    let running = false;

    const examples: Record<string, string> = {
      sum: [
        "MOV R0, 0    ; sum",
        "MOV R1, 1    ; counter",
        "MOV R2, 5    ; limit",
        "LOOP:",
        "CMP R1, R2",
        "JZ END",
        "ADD R0, R1",
        "ADD R1, 1",
        "JMP LOOP",
        "END:",
        "ADD R0, R2   ; include the limit itself",
        "STORE R0, 0",
        "HALT",
      ].join("\n"),
      loop: [
        "MOV R0, 5",
        "LOOP:",
        "STORE R0, R0",
        "SUB R0, 1",
        "CMP R0, 0",
        "JZ END",
        "JMP LOOP",
        "END:",
        "HALT",
      ].join("\n"),
      fib: [
        "MOV R0, 0    ; fib(0)",
        "MOV R1, 1    ; fib(1)",
        "MOV R2, 0    ; index",
        "STORE R0, R2",
        "LOOP:",
        "ADD R2, 1",
        "CMP R2, 6",
        "JZ END",
        "MOV R3, R1",
        "ADD R1, R0",
        "MOV R0, R3",
        "STORE R1, R2",
        "JMP LOOP",
        "END:",
        "HALT",
      ].join("\n"),
    };

    function log(text: string, cls = "") {
      const line = document.createElement("div");
      line.className = "cpu-console-line" + (cls ? ` ${cls}` : "");
      line.textContent = text;
      consoleEl!.appendChild(line);
      consoleEl!.scrollTop = consoleEl!.scrollHeight;
    }

    function renderRegisters(activeIdx: number | null) {
      registersEl!.innerHTML = "";
      registers.forEach((val, i) => {
        const cell = document.createElement("div");
        cell.className = "cpu-register" + (i === activeIdx ? " active" : "");
        cell.innerHTML = `<div class="cpu-register-label">R${i}</div><div class="cpu-register-value">${val}</div>`;
        registersEl!.appendChild(cell);
      });
    }

    function renderMemory(activeAddr: number | null) {
      memoryEl!.innerHTML = "";
      memory.forEach((val, i) => {
        const cell = document.createElement("div");
        cell.className = "cpu-cell" + (i === activeAddr ? " active" : "");
        cell.innerHTML = `<div class="cpu-cell-addr">${i}</div><div class="cpu-cell-value">${val}</div>`;
        memoryEl!.appendChild(cell);
      });
    }

    function setCycleStep(step: "fetch" | "decode" | "execute" | null) {
      cycleEl!.querySelectorAll(".cpu-cycle-step").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-step") === step);
      });
    }

    let cycleNumber = 0;
    let lastPc: number | null = null;

    function setExecutionStage(stage: "fetch" | "decode" | "execute" | null) {
      executionStages.forEach((el) => {
        const elStage = el.getAttribute("data-execution-stage");
        el.classList.toggle("active", elStage === stage);
        el.classList.toggle(
          "done",
          stage !== null &&
          ["fetch", "decode", "execute"].indexOf(elStage || "") <
            ["fetch", "decode", "execute"].indexOf(stage)
        );
      });
      setCycleStep(stage);
    }

    function describeEffect(instr: Instruction): string {
      switch (instr.op) {
        case "MOV":
          return `Register ${instr.args[0]} receives ${instr.args[1]}.`;
        case "ADD":
          return `Add ${instr.args[1]} to ${instr.args[0]}.`;
        case "SUB":
          return `Subtract ${instr.args[1]} from ${instr.args[0]}.`;
        case "LOAD":
          return `Read memory[${instr.args[1]}] into ${instr.args[0]}.`;
        case "STORE":
          return `Write ${instr.args[0]} into memory[${instr.args[1]}].`;
        case "CMP":
          return `Compare ${instr.args[0]} with ${instr.args[1]} → zero flag is updated.`;
        case "JMP":
          return `Jump to label ${instr.args[0]}.`;
        case "JZ":
          return `Jump to ${instr.args[0]} only when the zero flag is set.`;
        case "HALT":
          return "Stop the processor.";
        default:
          return "Execute instruction.";
      }
    }

    function renderTimeline(activePc: number | null = null) {
      timelineEl!.innerHTML = "";

      if (!program.length) {
        const empty = document.createElement("div");
        empty.className = "timeline-empty";
        empty.textContent = "No instructions loaded.";
        timelineEl!.appendChild(empty);
        return;
      }

      program.forEach((instr, i) => {
        const item = document.createElement("div");
        item.className =
          "timeline-item" +
          (i === activePc ? " active" : "") +
          (lastPc !== null && i < lastPc ? " executed" : "");

        const pc = document.createElement("span");
        pc.className = "timeline-pc";
        pc.textContent = `PC ${String(i).padStart(2, "0")}`;

        const op = document.createElement("strong");
        op.className = "timeline-op";
        op.textContent = instr.op;

        const raw = document.createElement("span");
        raw.className = "timeline-raw";
        raw.textContent = instr.raw;

        item.append(pc, op, raw);
        timelineEl!.appendChild(item);
      });

      const active = timelineEl!.querySelector(".timeline-item.active") as HTMLElement | null;
      active?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    }

    function showCurrentInstruction(index: number | null) {
      if (index === null || !program[index]) {
        currentAddressEl!.textContent = "PC 00";
        currentInstructionEl!.textContent = "Waiting for program...";
        instructionEffectEl!.textContent =
          "Assemble a program, then press Step to see exactly what changes.";
        instructionEffectEl!.classList.remove("changed");
        renderTimeline(null);
        return;
      }

      const instr = program[index];
      currentAddressEl!.textContent = `PC ${String(index).padStart(2, "0")}`;
      currentInstructionEl!.textContent = instr.raw;
      instructionEffectEl!.textContent = describeEffect(instr);
      instructionEffectEl!.classList.add("changed");
      renderTimeline(index);
    }

    function resolveOperand(token: string): number {
      token = token.trim();
      if (token.startsWith("R") && !isNaN(Number(token.slice(1)))) {
        return registers[Number(token.slice(1))];
      }
      return Number(token);
    }

    function regIndex(token: string): number {
      return Number(token.trim().slice(1));
    }

    function assemble(source: string): { ok: boolean; error?: string } {
      const rawLines = source.split("\n").map((l) => l.split(";")[0].trim()).filter(Boolean);
      const labels: Record<string, number> = {};
      const instructions: Instruction[] = [];

      rawLines.forEach((line) => {
        if (line.endsWith(":")) {
          labels[line.slice(0, -1).trim()] = instructions.length;
        } else {
          const [op, ...rest] = line.split(/\s+/);
          const args = rest.join(" ").split(",").map((a) => a.trim()).filter(Boolean);
          instructions.push({ op: op.toUpperCase(), args, raw: line });
        }
      });

      // Resolve label references stored as strings; validated at execute time.
      (instructions as any).labels = labels;
      program = instructions;
      return { ok: true };
    }

    function resetMachine(keepProgram: boolean) {
      registers = new Array(REG_COUNT).fill(0);
      memory = new Array(MEM_SIZE).fill(0);
      pc = 0;
      zeroFlag = false;
      halted = !keepProgram ? true : halted;
      if (!keepProgram) program = [];
      renderRegisters(null);
      renderMemory(null);
      setCycleStep(null);
      pcEl!.textContent = "0";
      statusEl!.textContent = keepProgram ? "Assembled" : "Idle";
      cycleNumber = 0;
      lastPc = null;
      stepCountEl!.textContent = "CYCLE 0";
      setExecutionStage(null);
      showCurrentInstruction(keepProgram && program.length ? 0 : null);
    }

    function labelsOf(prog: Instruction[]): Record<string, number> {
      return (prog as any).labels || {};
    }

    async function step(): Promise<boolean> {
      if (halted || pc >= program.length) {
        halted = true;
        statusEl!.textContent = "Halted";
        stepBtn.disabled = true;
        runBtn.disabled = true;
        return false;
      }

      setExecutionStage("fetch");
      pcEl!.textContent = String(pc);
      showCurrentInstruction(pc);
      await sleep(300);

      const instr = program[pc];
      setExecutionStage("decode");
      log(`[${pc}] ${instr.raw}`);
      await sleep(300);

      setExecutionStage("execute");
      await sleep(300);

      const labels = labelsOf(program);
      let nextPc = pc + 1;

      try {
        switch (instr.op) {
          case "MOV": {
            const dest = regIndex(instr.args[0]);
            registers[dest] = resolveOperand(instr.args[1]);
            renderRegisters(dest);
            break;
          }
          case "ADD": {
            const dest = regIndex(instr.args[0]);
            registers[dest] += resolveOperand(instr.args[1]);
            renderRegisters(dest);
            break;
          }
          case "SUB": {
            const dest = regIndex(instr.args[0]);
            registers[dest] -= resolveOperand(instr.args[1]);
            renderRegisters(dest);
            break;
          }
          case "LOAD": {
            const dest = regIndex(instr.args[0]);
            const addr = resolveOperand(instr.args[1]);
            registers[dest] = memory[addr] ?? 0;
            renderRegisters(dest);
            renderMemory(addr);
            break;
          }
          case "STORE": {
            const val = resolveOperand(instr.args[0]);
            const addr = resolveOperand(instr.args[1]);
            if (addr >= 0 && addr < MEM_SIZE) memory[addr] = val;
            renderMemory(addr);
            log(`  memory[${addr}] = ${val}`, "out");
            break;
          }
          case "CMP": {
            const a = resolveOperand(instr.args[0]);
            const b = resolveOperand(instr.args[1]);
            zeroFlag = a === b;
            break;
          }
          case "JMP": {
            const target = labels[instr.args[0]];
            if (target === undefined) throw new Error(`unknown label ${instr.args[0]}`);
            nextPc = target;
            break;
          }
          case "JZ": {
            if (zeroFlag) {
              const target = labels[instr.args[0]];
              if (target === undefined) throw new Error(`unknown label ${instr.args[0]}`);
              nextPc = target;
            }
            break;
          }
          case "HALT": {
            halted = true;
            break;
          }
          default:
            throw new Error(`unknown instruction ${instr.op}`);
        }
      } catch (e) {
        log(`error: ${(e as Error).message}`, "err");
        halted = true;
        statusEl!.textContent = "Error";
        stepBtn.disabled = true;
        runBtn.disabled = true;
        return false;
      }

      await sleep(300);
      lastPc = pc;
      pc = nextPc;
      cycleNumber += 1;
      stepCountEl!.textContent = `CYCLE ${cycleNumber}`;

      if (halted) {
        setExecutionStage("execute");
        currentInstructionEl!.textContent = instr.raw;
        instructionEffectEl!.textContent = "HALT completed — the CPU has stopped.";
        instructionEffectEl!.classList.add("changed");
        statusEl!.textContent = "Halted";
        log("Program halted.", "out");
        stepBtn.disabled = true;
        runBtn.disabled = true;
        return false;
      }

      statusEl!.textContent = "Running";
      return true;
    }

    assembleBtn.addEventListener("click", () => {
      resetMachine(false);
      const result = assemble(programEl.value);
      if (result.ok) {
        halted = false;
        pc = 0;
        stepBtn.disabled = false;
        runBtn.disabled = false;
        consoleEl!.innerHTML = "";
        log(`Assembled ${program.length} instructions.`);
        renderRegisters(null);
        renderMemory(null);
        statusEl!.textContent = "Ready";
        cycleNumber = 0;
        lastPc = null;
        stepCountEl!.textContent = "CYCLE 0";
        setExecutionStage(null);
        showCurrentInstruction(0);
      }
    });

    stepBtn.addEventListener("click", () => { void step(); });

    runBtn.addEventListener("click", async () => {
      if (running) return;
      running = true;
      stepBtn.disabled = true;
      let alive = true;
      while (alive && !halted) {
        alive = await step();
      }
      running = false;
    });

    resetBtn.addEventListener("click", () => {
      resetMachine(false);
      consoleEl!.innerHTML = "";
      stepBtn.disabled = true;
      runBtn.disabled = true;
      setExecutionStage(null);
      showCurrentInstruction(null);
      stepCountEl!.textContent = "CYCLE 0";
    });

    loadExampleBtn.addEventListener("click", () => {
      programEl.value = examples[exampleSelect.value];
    });

    programEl.value = examples.sum;
    resetMachine(false);
  })();
</script>

