---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="CPU Simulator">
  <main class="cpu-page">
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>

    <div class="cpu-shell">
      <aside class="cpu-sidebar">
        <a href="/home" class="back-link" data-i18n="backLink">
          <span class="back-arrow">←</span>
          <span data-i18n="backLinkText">Back to home</span>
        </a>

        <div class="brand">
          <span class="brand-mark"></span>
          <div>
            <div class="brand-name">cpu<span>_</span></div>
            <div class="brand-sub" data-i18n="brandSub">architecture / interactive lab</div>
          </div>
        </div>

        <div class="lang-switch" role="group" aria-label="Language">
          <button type="button" class="lang-btn" data-lang="en">EN</button>
          <button type="button" class="lang-btn" data-lang="fr">FR</button>
          <button type="button" class="lang-btn" data-lang="es">ES</button>
        </div>

        <nav class="doc-nav" aria-label="CPU simulator sections">
          <a href="#overview"><span>00</span><b data-i18n="navOverview">Overview</b></a>
          <a href="#simulator"><span>01</span><b data-i18n="navSimulator">Simulator</b></a>
          <a href="#architecture"><span>02</span><b data-i18n="navArchitecture">Architecture</b></a>
          <a href="#instructions"><span>03</span><b data-i18n="navInstructions">Instruction set</b></a>
          <a href="#concepts"><span>04</span><b data-i18n="navConcepts">Key concepts</b></a>
        </nav>

        <div class="sidebar-status">
          <div class="live-row">
            <span class="live-dot"></span>
            <span data-i18n="simulatorReady">SIMULATOR READY</span>
          </div>
          <div class="tech-row">
            <span>ASTRO</span>
            <span>TYPESCRIPT</span>
            <span>CPU</span>
          </div>
        </div>
      </aside>

      <div class="cpu-content">
        <header class="hero" id="overview">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>PROJECT 06</span>
            <span class="separator">/</span>
            <span data-i18n="eyebrowCategory">COMPUTER ARCHITECTURE</span>
          </div>

          <h1 data-i18n-html="heroTitle">
            Fetch. Decode.
            <span>Execute.</span>
          </h1>

          <p class="hero-description" data-i18n="heroDesc">
            A tiny 8-register CPU you can program directly in the browser.
            Write instructions, assemble them, then watch the program counter,
            registers, memory and fetch-decode-execute cycle change in real time.
          </p>

          <div class="hero-stats">
            <div>
              <strong>8</strong>
              <span data-i18n="statRegisters">REGISTERS</span>
            </div>
            <div>
              <strong>32</strong>
              <span data-i18n="statMemoryCells">MEMORY CELLS</span>
            </div>
            <div>
              <strong>9</strong>
              <span data-i18n="statInstructions">INSTRUCTIONS</span>
            </div>
            <div>
              <strong>3</strong>
              <span data-i18n="statCpuStages">CPU STAGES</span>
            </div>
          </div>
        </header>

        <section class="section" id="simulator">
          <div class="section-heading">
            <div class="section-number">01</div>
            <div>
              <div class="section-label" data-i18n="simSectionLabel">LIVE CPU SIMULATOR</div>
              <h2 data-i18n="simSectionH2">Build a program. Run the machine.</h2>
              <p data-i18n="simSectionDesc">
                Edit the assembly-like program, assemble it, then step through
                each instruction or let the CPU run automatically.
              </p>
            </div>
          </div>

          <div class="simulator-card">
            <div class="simulator-topbar">
              <div>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
              </div>
              <span class="topbar-title" data-i18n="topbarTitle">CPU / EMULATOR</span>
              <span class="topbar-state"><i></i> <span data-i18n="topbarState">LIVE</span></span>
            </div>

            <div class="cpu-layout">
              <div class="panel program-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-index">A</span>
                    <span class="panel-title" data-i18n="panelAProgram">Program</span>
                  </div>
                  <span class="panel-meta" data-i18n="panelMetaAssembly">ASSEMBLY</span>
                </div>

                <textarea
                  id="cpu-program"
                  class="cpu-editor"
                  spellcheck="false"
                  aria-label="CPU assembly program"
                ></textarea>

                <div class="editor-footer">
                  <select id="cpu-example" class="cpu-select" aria-label="CPU example">
                    <option value="sum" data-i18n="exampleSum">Sum 1..5</option>
                    <option value="loop" data-i18n="exampleLoop">Countdown loop</option>
                    <option value="fib" data-i18n="exampleFib">Fibonacci (first 6)</option>
                  </select>
                  <button id="cpu-load-example" class="cpu-btn" data-i18n="btnLoadExample">Load example</button>
                </div>

                <div class="instruction-hint">
                  <span data-i18n="hintTip">TIP</span>
                  <span data-i18n-html="hintText">Use <code>;</code> for comments and labels such as <code>LOOP:</code>.</span>
                </div>
              </div>

              <div class="panel control-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-index">B</span>
                    <span class="panel-title" data-i18n="panelBState">Processor state</span>
                  </div>
                  <span class="panel-meta" data-i18n="panelMetaGpr">8 × GPR</span>
                </div>

                <div id="cpu-registers" class="cpu-registers"></div>

                <div class="cycle-block">
                  <div class="mini-label" data-i18n="cycleLabel">FETCH / DECODE / EXECUTE</div>
                  <div id="cpu-cycle" class="cpu-cycle">
                    <span class="cpu-cycle-step" data-step="fetch" data-i18n="stepFetch">Fetch</span>
                    <span class="cpu-cycle-arrow">→</span>
                    <span class="cpu-cycle-step" data-step="decode" data-i18n="stepDecode">Decode</span>
                    <span class="cpu-cycle-arrow">→</span>
                    <span class="cpu-cycle-step" data-step="execute" data-i18n="stepExecute">Execute</span>
                  </div>
                </div>

                <div class="control-actions">
                  <button id="cpu-assemble" class="cpu-btn cpu-btn-primary" data-i18n="btnAssemble">Assemble</button>
                  <button id="cpu-step" class="cpu-btn" disabled data-i18n="btnStep">Step</button>
                  <button id="cpu-run" class="cpu-btn" disabled data-i18n="btnRun">Run</button>
                  <button id="cpu-reset" class="cpu-btn" data-i18n="btnReset">Reset</button>
                </div>

                <div class="machine-status">
                  <div><span data-i18n="statusPC">PROGRAM COUNTER</span><strong id="cpu-pc">0</strong></div>
                  <div><span data-i18n="statusLabel">STATUS</span><strong id="cpu-status">Idle</strong></div>
                </div>
              </div>
            </div>

            <div class="execution-monitor">
              <div class="execution-main">
                <div class="execution-label">
                  <span data-i18n="liveExecution">LIVE EXECUTION</span>
                  <span id="cpu-step-count">CYCLE 0</span>
                </div>
                <div class="execution-flow">
                  <div class="execution-stage" data-execution-stage="fetch">
                    <span class="execution-stage-number">01</span>
                    <strong data-i18n="execStageFetchTitle">FETCH</strong>
                    <small data-i18n="execStageFetchDesc">Read instruction</small>
                  </div>
                  <div class="execution-arrow">→</div>
                  <div class="execution-stage" data-execution-stage="decode">
                    <span class="execution-stage-number">02</span>
                    <strong data-i18n="execStageDecodeTitle">DECODE</strong>
                    <small data-i18n="execStageDecodeDesc">Interpret opcode</small>
                  </div>
                  <div class="execution-arrow">→</div>
                  <div class="execution-stage" data-execution-stage="execute">
                    <span class="execution-stage-number">03</span>
                    <strong data-i18n="execStageExecuteTitle">EXECUTE</strong>
                    <small data-i18n="execStageExecuteDesc">Update CPU state</small>
                  </div>
                </div>
              </div>

              <div class="current-instruction">
                <div class="current-instruction-head">
                  <span data-i18n="currentInstructionLabel">CURRENT INSTRUCTION</span>
                  <span id="cpu-current-address">PC 00</span>
                </div>
                <code id="cpu-current-instruction" data-i18n="waitingForProgram">Waiting for program...</code>
                <div class="instruction-effect" id="cpu-instruction-effect" data-i18n="instructionEffectDefault">
                  Assemble a program, then press Step to see exactly what changes.
                </div>
              </div>
            </div>

            <div class="instruction-timeline-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">E</span>
                  <span class="panel-title" data-i18n="timelineTitle">Instruction timeline</span>
                </div>
                <span class="panel-meta" data-i18n="timelineMetaPcTracking">PC TRACKING</span>
              </div>
              <div id="cpu-timeline" class="cpu-timeline">
                <div class="timeline-empty" data-i18n="timelineEmpty">No instructions loaded.</div>
              </div>
            </div>

            <div class="wide-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">C</span>
                  <span class="panel-title" data-i18n="memoryTitle">Memory</span>
                </div>
                <span class="panel-meta" data-i18n="memoryMeta">32 CELLS</span>
              </div>
              <div id="cpu-memory" class="cpu-memory"></div>
            </div>

            <div class="wide-panel console-panel">
              <div class="panel-heading">
                <div>
                  <span class="panel-index">D</span>
                  <span class="panel-title" data-i18n="consoleTitle">Execution console</span>
                </div>
                <span class="panel-meta" data-i18n="consoleMeta">TRACE</span>
              </div>
              <div id="cpu-console" class="cpu-console"></div>
            </div>
          </div>
        </section>

        <section class="section" id="architecture">
          <div class="section-heading">
            <div class="section-number">02</div>
            <div>
              <div class="section-label" data-i18n="archSectionLabel">ARCHITECTURE</div>
              <h2 data-i18n="archSectionH2">What is inside this CPU?</h2>
              <p data-i18n="archSectionDesc">
                The simulator reduces a processor to the essential pieces:
                registers, memory, a program counter, flags and an instruction cycle.
              </p>
            </div>
          </div>

          <div class="architecture-grid">
            <article class="architecture-card featured">
              <span class="card-number">01</span>
              <div class="architecture-icon">REG</div>
              <h3 data-i18n="archRegTitle">Registers</h3>
              <p data-i18n="archRegDesc">
                Eight general-purpose registers, R0 through R7, provide the
                fastest storage available to the simulated CPU.
              </p>
              <div class="card-code">R0 · R1 · R2 · ... · R7</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">02</span>
              <div class="architecture-icon">MEM</div>
              <h3 data-i18n="archMemTitle">Memory</h3>
              <p data-i18n="archMemDesc">
                Thirty-two addressable memory cells hold values that programs
                can read with LOAD and write with STORE.
              </p>
              <div class="card-code" data-i18n="archMemCode">ADDRESS 00 — 31</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">03</span>
              <div class="architecture-icon">PC</div>
              <h3 data-i18n="archPcTitle">Program counter</h3>
              <p data-i18n="archPcDesc">
                The PC identifies the next instruction. Sequential execution
                increments it, while jumps replace it with a label target.
              </p>
              <div class="card-code">PC → instruction[PC]</div>
            </article>

            <article class="architecture-card">
              <span class="card-number">04</span>
              <div class="architecture-icon">ZF</div>
              <h3 data-i18n="archZfTitle">Zero flag</h3>
              <p data-i18n="archZfDesc">
                CMP updates the zero flag when two operands are equal. JZ uses
                that flag to decide whether a branch should happen.
              </p>
              <div class="card-code">CMP → ZF → JZ</div>
            </article>
          </div>

          <div class="pipeline">
            <div class="pipeline-label" data-i18n="pipelineLabel">INSTRUCTION PIPELINE — CONCEPTUAL VIEW</div>
            <div class="pipeline-track">
              <div class="pipeline-step">
                <span>01</span>
                <strong data-i18n="execStageFetchTitle">FETCH</strong>
                <small data-i18n="pipeFetchDesc">Read instruction at PC</small>
              </div>
              <div class="pipeline-connector"></div>
              <div class="pipeline-step">
                <span>02</span>
                <strong data-i18n="execStageDecodeTitle">DECODE</strong>
                <small data-i18n="pipeDecodeDesc">Identify operation + operands</small>
              </div>
              <div class="pipeline-connector"></div>
              <div class="pipeline-step active">
                <span>03</span>
                <strong data-i18n="execStageExecuteTitle">EXECUTE</strong>
                <small data-i18n="pipeExecuteDesc">Change CPU state</small>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="instructions">
          <div class="section-heading">
            <div class="section-number">03</div>
            <div>
              <div class="section-label" data-i18n="instrSectionLabel">INSTRUCTION SET</div>
              <h2 data-i18n="instrSectionH2">The CPU's vocabulary.</h2>
              <p data-i18n="instrSectionDesc">
                These nine operations are enough to demonstrate arithmetic,
                memory access, comparisons, control flow and termination.
              </p>
            </div>
          </div>

          <div class="instruction-table">
            <div class="instruction-row instruction-head">
              <span data-i18n="instrHeadOpcode">OPCODE</span>
              <span data-i18n="instrHeadForm">FORM</span>
              <span data-i18n="instrHeadWhat">WHAT IT DOES</span>
            </div>
            <div class="instruction-row">
              <code>MOV</code><span>R0, value</span><p data-i18n="instrMovDesc">Copies an immediate value or another register into the destination.</p>
            </div>
            <div class="instruction-row">
              <code>ADD</code><span>R0, value</span><p data-i18n="instrAddDesc">Adds the operand to the destination register.</p>
            </div>
            <div class="instruction-row">
              <code>SUB</code><span>R0, value</span><p data-i18n="instrSubDesc">Subtracts the operand from the destination register.</p>
            </div>
            <div class="instruction-row">
              <code>LOAD</code><span>R0, addr</span><p data-i18n="instrLoadDesc">Reads a value from memory into a register.</p>
            </div>
            <div class="instruction-row">
              <code>STORE</code><span>value, addr</span><p data-i18n="instrStoreDesc">Writes a value into one of the 32 memory cells.</p>
            </div>
            <div class="instruction-row">
              <code>CMP</code><span>R0, value</span><p data-i18n="instrCmpDesc">Compares two operands and updates the zero flag.</p>
            </div>
            <div class="instruction-row">
              <code>JMP</code><span>LABEL</span><p data-i18n="instrJmpDesc">Unconditionally changes the program counter.</p>
            </div>
            <div class="instruction-row">
              <code>JZ</code><span>LABEL</span><p data-i18n="instrJzDesc">Jumps only when the zero flag is set.</p>
            </div>
            <div class="instruction-row">
              <code>HALT</code><span>—</span><p data-i18n="instrHaltDesc">Stops execution and leaves the final machine state visible.</p>
            </div>
          </div>
        </section>

        <section class="section documentation" id="concepts">
          <div class="section-heading">
            <div class="section-number">04</div>
            <div>
              <div class="section-label" data-i18n="conceptsSectionLabel">REFERENCE</div>
              <h2 data-i18n="conceptsSectionH2">Key CPU concepts, explained.</h2>
              <p data-i18n="conceptsSectionDesc">
                Use these notes alongside the simulator to connect the visual
                state changes to the underlying computer architecture ideas.
              </p>
            </div>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>01</span> <span data-i18n="docGroup1Title">The instruction cycle</span></div>

            <details class="doc-item" open>
              <summary>
                <span class="doc-item-name" data-i18n="docFetchName">Fetch → Decode → Execute</span>
                <span class="badge" data-i18n="badgeCoreConcept">core concept</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docFetchBody">
                <p>
                  The CPU repeatedly obtains the next instruction, interprets
                  what that instruction means, and performs the requested
                  operation. This simulator makes those three phases visible
                  during every step.
                </p>
                <ol>
                  <li><strong>Fetch:</strong> use the PC to locate the next instruction.</li>
                  <li><strong>Decode:</strong> identify the opcode and operands.</li>
                  <li><strong>Execute:</strong> modify registers, memory, flags or control flow.</li>
                </ol>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docPcName">Program counter</span>
                <span class="badge">PC</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docPcBody">
                <p>
                  The program counter stores the address or index of the next
                  instruction to execute. Normally it advances sequentially;
                  JMP and JZ replace it with a different instruction index.
                </p>
                <div class="formula-box">PC → instruction → PC + 1</div>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docRegMemName">Registers vs memory</span>
                <span class="badge" data-i18n="badgeStorage">storage</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docRegMemBody">
                <p>
                  Registers are small, directly accessible storage locations
                  inside the CPU. Memory is a larger addressable storage area.
                  LOAD moves data from memory into a register; STORE writes it back.
                </p>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>02</span> <span data-i18n="docGroup2Title">Control flow &amp; flags</span></div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docCmpName">CMP and the zero flag</span>
                <span class="badge" data-i18n="badgeBranching">branching</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docCmpBody">
                <p>
                  CMP does not need to store a result in a general-purpose
                  register. Instead, it records whether the two operands are
                  equal in the zero flag. JZ can then use that condition to
                  choose between continuing sequentially and jumping to a label.
                </p>
                <div class="formula-box">CMP A, B → ZF = (A === B) → JZ LABEL</div>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docLoopsName">Loops</span>
                <span class="badge" data-i18n="badgeControlFlow">control flow</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docLoopsBody">
                <p>
                  A loop is created by combining a label, a state-changing
                  instruction, a comparison and a conditional or unconditional
                  jump. The countdown and sum examples demonstrate this pattern.
                </p>
                <ol>
                  <li>Update a register representing the loop state.</li>
                  <li>Compare it with a stopping condition.</li>
                  <li>Use JZ to leave the loop or JMP to repeat it.</li>
                </ol>
              </div>
            </details>
          </div>

          <div class="doc-group">
            <div class="doc-group-title"><span>03</span> <span data-i18n="docGroup3Title">From simulator to real CPU</span></div>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docLeavesOutName">What this model leaves out</span>
                <span class="badge" data-i18n="badgePerspective">perspective</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docLeavesOutBody">
                <p>
                  This is intentionally a teaching model. A real processor adds
                  many more details: instruction encoding, control logic,
                  caches, buses, pipelining, branch prediction, interrupts,
                  privilege levels and physical hardware timing.
                </p>
                <p>
                  The simplified machine is useful because the same fundamental
                  ideas remain visible: instructions change state, the PC drives
                  control flow, registers hold working data, and memory stores
                  persistent values.
                </p>
              </div>
            </details>

            <details class="doc-item">
              <summary>
                <span class="doc-item-name" data-i18n="docAssemblyName">Why assembly matters</span>
                <span class="badge" data-i18n="badgeLowLevel">low level</span>
                <span class="doc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="doc-body" data-i18n-html="docAssemblyBody">
                <p>
                  Assembly exposes operations close to the processor's
                  instruction model. Instead of expressing a high-level loop
                  directly, you explicitly manipulate registers, compare values,
                  store data and change the program counter.
                </p>
              </div>
            </details>
          </div>
        </section>

        <footer class="page-footer">
          <span data-i18n="footerText">CPU SIMULATOR · COMPUTER ARCHITECTURE</span>
          <a href="/home" data-i18n="footerHome">← Home</a>
        </footer>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  html { scroll-behavior: smooth; }

  .cpu-page {
    --bg: #070b0f;
    --bg-soft: #0b1117;
    --panel: rgba(12, 19, 26, 0.88);
    --panel-2: rgba(8, 14, 20, 0.92);
    --white: #edf6f5;
    --muted: rgba(237, 246, 245, 0.58);
    --faint: rgba(237, 246, 245, 0.31);
    --line: rgba(101, 220, 198, 0.15);
    --line-strong: rgba(101, 220, 198, 0.30);
    --sec: #55e6c1;
    --blue: #62a8ff;
    --blue-soft: rgba(98, 168, 255, 0.10);
    --green-soft: rgba(85, 230, 193, 0.09);
    --amber: #f4bd62;
    --red: #ff6f76;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    color: var(--white);
    background:
      radial-gradient(circle at 75% 4%, rgba(62, 130, 255, 0.09), transparent 28rem),
      radial-gradient(circle at 20% 22%, rgba(55, 230, 193, 0.06), transparent 25rem),
      var(--bg);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .ambient-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .35;
    background-image:
      linear-gradient(rgba(85,230,193,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(85,230,193,.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  .scanline {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .035;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255,255,255,.35) 4px
    );
  }

  .cpu-shell {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100vh;
  }

  .cpu-sidebar {
    width: 252px;
    flex: 0 0 252px;
    min-height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 2.15rem;
    padding: 2rem 1.35rem;
