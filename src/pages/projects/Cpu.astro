  .doc-group { margin-top: 2.25rem; }
  .doc-group:first-of-type { margin-top: 0; }
  .doc-group-title {
    display: flex; align-items: baseline; gap: .65rem;
    margin-bottom: .8rem;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1rem;
    font-weight: 600;
  }
  .doc-group-title span { color: var(--sec); font: .6rem "JetBrains Mono", monospace; }

  .doc-item {
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    background: rgba(9,16,22,.9);
  }
  .doc-item + .doc-item { margin-top: .5rem; }
  .doc-item summary {
    display: flex; align-items: center; gap: .65rem;
    padding: .85rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  .doc-item summary::-webkit-details-marker { display: none; }
  .doc-item summary:hover { background: var(--green-soft); }
  .doc-item-name {
    color: var(--white);
    font-family: "Space Grotesk", sans-serif;
    font-size: .83rem;
    font-weight: 600;
  }
  .badge {
    padding: .2rem .5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--sec);
    font-size: .5rem;
    background: var(--green-soft);
  }
  .doc-toggle {
    position: relative;
    width: 14px; height: 14px; margin-left: auto;
  }
  .doc-toggle::before, .doc-toggle::after {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    background: var(--sec);
    transform: translate(-50%,-50%);
    transition: opacity .2s ease, transform .2s ease;
  }
  .doc-toggle::before { width: 14px; height: 1px; }
  .doc-toggle::after { width: 1px; height: 14px; }
  .doc-item[open] .doc-toggle::after { opacity: 0; transform: translate(-50%,-50%) rotate(90deg); }

  .doc-body {
    padding: 0 1.1rem 1.1rem;
    border-top: 1px solid var(--line);
  }
  .doc-body p, .doc-body li {
    color: var(--muted);
    font: .8rem/1.75 "Space Grotesk", sans-serif;
  }
  .doc-body p { margin: .9rem 0 0; }
  .doc-body ol { margin: .9rem 0 0; padding-left: 1.2rem; }
  .doc-body li + li { margin-top: .25rem; }
  .doc-body strong { color: var(--white); }
  .formula-box {
    margin-top: .9rem;
    padding: .7rem .85rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--sec);
    background: var(--green-soft);
    font-size: .62rem;
  }

  .page-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 1.7rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: .55rem;
    letter-spacing: .08em;
  }
  .page-footer a { color: var(--muted); text-decoration: none; }
  .page-footer a:hover { color: var(--sec); }

  @keyframes cpu-fade-in {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 980px) {
    .cpu-shell { display: block; }
    .cpu-sidebar {
      position: relative;
      width: auto;
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 1.25rem;
      gap: 1.25rem;
    }
    .doc-nav { display: grid; grid-template-columns: repeat(5, 1fr); }
    .sidebar-status { margin-top: 0; }
    .cpu-content { width: min(930px, calc(100% - 32px)); }
  }

  @media (max-width: 760px) {
    .cpu-content { padding-top: 3rem; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); }
    .hero-stats div:nth-child(2) { border-right: 0; }
    .hero-stats div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .cpu-layout { grid-template-columns: 1fr; }
    .execution-monitor { grid-template-columns: 1fr; }
    .current-instruction { border-left: 0; border-top: 1px solid var(--line); }
    .architecture-grid { grid-template-columns: 1fr; }
    .pipeline-track { display: grid; grid-template-columns: 1fr; gap: .5rem; }
    .pipeline-connector { width: 1px; height: 18px; margin-left: 1.2rem; }
    .instruction-row { grid-template-columns: 75px 105px 1fr; }
    .doc-nav { grid-template-columns: repeat(2, 1fr); }
    .cpu-memory { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 520px) {
    .cpu-content { width: min(100% - 22px, 930px); }
    .hero h1 { font-size: clamp(2.65rem, 15vw, 4.1rem); }
    .hero-description { font-size: .92rem; }
    .section-heading { grid-template-columns: 32px minmax(0,1fr); gap: .7rem; }
    .simulator-card { border-radius: 11px; }
    .panel, .wide-panel { padding: .9rem; }
    .cpu-editor { min-height: 245px; }
    .execution-flow { gap: .25rem; }
    .execution-stage { padding: .65rem .45rem; }
    .execution-stage small { display: none; }
    .cpu-registers { grid-template-columns: repeat(2, 1fr); }
    .instruction-row { grid-template-columns: 68px 92px 1fr; padding: 0 .65rem; }
    .instruction-row p { font-size: .65rem; }
    .instruction-head { font-size: .43rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: .001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .001ms !important;
    }
  }
</style>

