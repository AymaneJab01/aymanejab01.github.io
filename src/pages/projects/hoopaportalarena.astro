function hpBarClass(pct){
  if(pct <= 25) return "low";
  if(pct <= 55) return "mid";
  return "";
}

function renderFighter(f, panel, sideLabel){
  var pct = Math.max(0, Math.round((f.hp/f.maxHp)*100));
  var barClass = hpBarClass(pct);
  var flags = "";
  if(f.paralyzedTurns > 0) flags += '<span class="flag bad">Locked down ('+f.paralyzedTurns+')</span>';
  if(f.rechargeTurns > 0) flags += '<span class="flag">Recharging ('+f.rechargeTurns+')</span>';
  if(f.dotHeal) flags += '<span class="flag gold">Void Curse active</span>';
  if(f.boostMult > 1) flags += '<span class="flag gold">Power surged ×'+f.boostMult.toFixed(2)+'</span>';

  var livesHTML = "";
  if(f.livesMax > 0){
    livesHTML = '<div class="lives-row">';
    for(var i=0;i<f.livesMax;i++){
      livesHTML += '<span class="life-dot'+(i < f.lives ? '' : ' used')+'"></span>';
    }
    livesHTML += '</div>';
  }

  // move list — shows the base move (and, once Mega Evolved, the special move too) with full descriptions.
  // Name sits on its own row so it never has to fight the type/power tags for space; those sit on a
  // second row underneath, which keeps every card's layout identical regardless of move-name length.
  var movesForList = f.special ? [f.move, f.special] : [f.move];
  var moveListHTML = '<div class="section-label">'+(movesForList.length>1?'Moves':'Move')+'</div><div class="move-list">' + movesForList.map(function(mv){
    var isSpecial = mv === f.special;
    var used = f.isMega && !!f.moveUsage[mv.name];
    return '<div class="move-item'+(isSpecial?' special':'')+(used?' used':'')+'">'+
      '<div class="move-item-top">'+
        '<span class="mv-name">'+mv.name+(isSpecial?' <span class="mv-star">✦</span>':'')+'</span>'+
        (used ? '<span class="mv-used-tag">Used</span>' : '') +
      '</div>'+
      '<div class="move-item-meta">'+
        '<span class="mv-type" style="background:'+TYPE_COLOR[mv.type]+'">'+cap(mv.type)+'</span>'+
        '<span class="mv-pow">PWR '+mv.power+'</span>'+
      '</div>'+
      '<p class="mv-desc">'+(mv.desc||'')+'</p>'+
    '</div>';
  }).join('') + '</div>';

  var cloneHTML = "";
  if(f.clones && f.clones.length){
    var aliveClones = f.clones.filter(function(c){ return c.hp > 0; });
    if(aliveClones.length){
      cloneHTML = '<div class="section-label">Clones ('+aliveClones.length+')</div><div class="clone-row">';
      aliveClones.forEach(function(c){
        var cpct = Math.max(0,Math.round((c.hp/c.maxHp)*100));
        cloneHTML +=
          '<div class="clone-chip">'+
            '<div class="clone-chip-art"><img src="'+f.img+'" alt=""></div>'+
            '<div class="clone-chip-info">'+
              '<span class="clone-chip-label">Clone</span>'+
              '<span class="cbar"><i class="'+hpBarClass(cpct)+'" style="width:'+cpct+'%"></i></span>'+
              '<span class="clone-chip-pct">'+cpct+'%</span>'+
            '</div>'+
          '</div>';
      });
      cloneHTML += '</div>';
    }
  }

  panel.style.setProperty("--facc", TYPE_COLOR[f.types[0]]);
  panel.style.setProperty("--facc2", TYPE_COLOR[f.types[1]||f.types[0]]);

  panel.innerHTML =
    '<div class="fighter-head"><span class="side-tag">'+sideLabel+'</span><div class="fighter-name-wrap"><h3>'+f.name+'</h3>'+(f.isMega?'<span class="mega-pill">✦ '+f.megaLabel+'</span>':'')+'</div></div>'+
    '<div class="fighter-portrait '+f.cssFilter+'" id="port-'+f.side+'"'+(f.halo?' style="--h1:'+f.halo[0]+';--h2:'+f.halo[1]+';--h3:'+f.halo[2]+';"':'')+'><img src="'+f.img+'" alt="'+f.name+'"><div class="dmg-pop" id="dmg-'+f.side+'"></div></div>'+
    '<div class="hp-row"><span class="hp-label">HP</span><div class="hp-bar"><div class="hp-fill '+barClass+'" id="hpfill-'+f.side+'" style="width:'+pct+'%"></div></div><span class="hp-num" id="hpnum-'+f.side+'">'+Math.max(0,Math.round(f.hp))+' / '+f.maxHp+'</span></div>'+
    livesHTML+
    '<div class="fighter-types">'+f.types.map(typeBadgeHTML).join("")+'</div>'+
    moveListHTML+
    '<div class="status-flags">'+flags+'</div>'+
    cloneHTML;
}

function renderRoundTrack(){
  var numEl = document.getElementById("turn-num");
  if(numEl) numEl.textContent = state.round;
  if(state.matchOver){
    roundLabel.textContent = "Duel complete";
  } else if(state.round === 0){
    roundLabel.textContent = "Ready — fight to the finish";
  } else {
    roundLabel.textContent = "Turn "+state.round+" complete";
  }
}

function renderActions(){
  if(!state || state.matchOver){
    arenaActions.innerHTML = '<button class="btn btn-ghost" disabled>Duel finished</button>';
    return;
  }
  var nextRound = state.round + 1;
  var label = state.round === 0 ? "Begin the Duel ✦" : "Continue — Turn "+nextRound+" ✦";
  arenaActions.innerHTML = '';

  var you = state.you;
  var choices = [];
  if(you.isMega && !state.resolving){
    choices = [you.move, you.special].filter(function(mv){ return mv && !you.moveUsage[mv.name]; });
  }

  if(choices.length > 1){
    var wrap = document.createElement("div");
    wrap.className = "move-choice";
    var title = document.createElement("div");
    title.className = "move-choice-title";
    title.textContent = "Pick "+you.name+"'s move for turn "+nextRound+":";
    wrap.appendChild(title);
    var row = document.createElement("div");
    row.className = "move-choice-row";
    [you.move, you.special].forEach(function(mv){
      var used = !!you.moveUsage[mv.name];
      var isSpecial = mv === you.special;
      var b = document.createElement("button");
      b.className = "btn move-btn"+(isSpecial ? " special" : "");
      b.disabled = used;
      b.innerHTML =
        '<span class="mv-name">'+mv.name+(isSpecial?' ✦':'')+'</span>'+
        '<span class="mv-meta">'+cap(mv.type)+' · PWR '+mv.power+'</span>'+
        (mv.desc ? '<span class="mv-btn-desc">'+mv.desc+'</span>' : '') +
        (used ? '<span class="mv-used">Already used</span>' : '');
      b.addEventListener("click", function(){
        sfxUiMoveClick();
        you.pendingMove = mv;
        resolveRound();
      });
      row.appendChild(b);
    });
    wrap.appendChild(row);
    arenaActions.appendChild(wrap);
    return;
  }

  if(choices.length === 1){ you.pendingMove = choices[0]; }

  var btn = document.createElement("button");
  btn.className = "btn btn-primary";
  btn.textContent = label;
  btn.addEventListener("click", function(){ sfxUiMoveClick(); resolveRound(); });
  arenaActions.appendChild(btn);
}

/* -------- damage helpers -------- */
function rand(min,max){ return min + Math.random()*(max-min); }

function computeHit(attacker, defenderTypes, move){
  var eff = effectiveness(move.type, defenderTypes);
  var crit = eff>0 && Math.random() < 0.12;
  var raw = move.power * (attacker.boostMult||1) * rand(0.9,1.15) * (eff===0?0:eff) * (crit?1.5:1);
  return {dmg: Math.round(raw), eff: eff, crit: crit};
}

function dmgTier(dmg){ return dmg>=42 ? "huge" : dmg>=20 ? "medium" : "low"; }

function applyDamage(target, dmg){
  target.hp -= dmg;
  var revived = false;
  if(target.hp <= 0){
    target.hp = 0;
    if(target.lives > 0){
      target.lives -= 1;
      target.hp = Math.round(target.maxHp*0.45);
      revived = true;
    }
  }
  target.tookDamage = true;
  return revived;
}

function popDamage(side, text, cls){
  var el = document.getElementById("dmg-"+side);
  if(!el) return;
  el.textContent = text;
  el.className = "dmg-pop show" + (cls? " "+cls : "");
  void el.offsetWidth;
  el.classList.add("show");
  setTimeout(function(){ el.classList.remove("show"); }, 950);
}

