---
// This is a fully self-contained page: its own <html>/<head>/<body>, no external
// layout required. If your project has a shared <Layout>, you can instead move the
// two Google Fonts <link> tags into that layout's <head> and render just the <body>
// content through it — everything else (styles, script, markup) can stay as-is.
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Pokémon Duel — Hoopa's Portal Arena</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
  /* ============================================================ */
  /* THEME TOKENS                                                  */
  /* ============================================================ */
  :root{
    --bg:#F4EFFB;
    --bg-elevated:#FFFFFF;
    --bg-arena:#ECE1FA;
    --ink:#1E1030;
    --ink-muted:rgba(30,16,48,0.62);
    --ink-faint:rgba(30,16,48,0.4);
    --violet:#5B2C82;
    --violet-deep:#3A1B5C;
    --violet-light:#8A4FC2;
    --gold:#B4820A;
    --gold-soft:#E8C568;
    --red:#B4324A;
    --card-bg:#FFFFFF;
    --card-border:rgba(91,44,130,0.16);
    --hand-bg:rgba(91,44,130,0.05);
    --shadow:rgba(59,29,92,0.16);
    --success:#2E8B57;
    --focus:#8A4FC2;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#120A1E;
      --bg-elevated:#1B1130;
      --bg-arena:#180E29;
      --ink:#F3ECFB;
      --ink-muted:rgba(243,236,251,0.64);
      --ink-faint:rgba(243,236,251,0.4);
      --violet:#9B5FD8;
      --violet-deep:#6C3AA8;
      --violet-light:#C298EB;
      --gold:#F2C230;
      --gold-soft:#FBE39A;
      --red:#F0576A;
      --card-bg:#1E1433;
      --card-border:rgba(242,194,48,0.16);
      --hand-bg:rgba(242,194,48,0.05);
      --shadow:rgba(0,0,0,0.5);
      --success:#4ED393;
      --focus:#F2C230;
    }
  }
  :root[data-theme="dark"]{
    --bg:#120A1E;
    --bg-elevated:#1B1130;
    --bg-arena:#180E29;
    --ink:#F3ECFB;
    --ink-muted:rgba(243,236,251,0.64);
    --ink-faint:rgba(243,236,251,0.4);
    --violet:#9B5FD8;
    --violet-deep:#6C3AA8;
    --violet-light:#C298EB;
    --gold:#F2C230;
    --gold-soft:#FBE39A;
    --red:#F0576A;
    --card-bg:#1E1433;
    --card-border:rgba(242,194,48,0.16);
    --hand-bg:rgba(242,194,48,0.05);
    --shadow:rgba(0,0,0,0.5);
    --success:#4ED393;
    --focus:#F2C230;
  }

  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
    line-height:1.5;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{
    font-family:"Fraunces","Georgia",serif;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  button{font-family:inherit;}
  :focus-visible{outline:2px solid var(--focus);outline-offset:3px;}

  /* ============================================================ */
  /* HERO                                                           */
  /* ============================================================ */
  .hero{
    position:relative;
    padding:96px 24px 88px;
    text-align:center;
    overflow:hidden;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(139,79,194,0.25), transparent 70%),
      var(--bg);
  }
  .hero-rings{
    position:absolute;
    top:50%;left:50%;
    width:min(640px, 140vw);
    height:min(640px, 140vw);
    transform:translate(-50%,-50%);
    pointer-events:none;
    opacity:0.55;
  }
  .hero-rings .ring-outer{transform-origin:200px 200px;animation:ringSpin 46s linear infinite;}
  .hero-rings .ring-inner{transform-origin:200px 200px;animation:ringSpinReverse 30s linear infinite;}
  @keyframes ringSpin{to{transform:rotate(360deg);}}
  @keyframes ringSpinReverse{to{transform:rotate(-360deg);}}

  .hero-inner{position:relative;z-index:1;max-width:640px;margin:0 auto;}
  .hero-kicker{
    display:inline-block;
    margin-bottom:22px;
    padding:6px 14px;
    border-radius:999px;
    border:1px solid var(--card-border);
    background:var(--bg-elevated);
    color:var(--violet);
    font-size:13px;
    font-weight:700;
  }
  .hero h1{
    margin:0;
    font-size:clamp(40px,7vw,68px);
    line-height:0.98;
    background:linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 35%, var(--violet-light) 75%);
    background-size:200% 200%;
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    animation:heroShine 7s ease-in-out infinite;
  }
  @keyframes heroShine{
    0%,100%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
  }
  .hero p{
    max-width:480px;
    margin:22px auto 0;
    color:var(--ink-muted);
    font-size:17px;
    line-height:1.65;
  }
  .hero-cta{
    margin-top:34px;
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:14px 26px;
    border-radius:14px;
    border:0;
    background:var(--violet);
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    box-shadow:0 10px 30px -12px var(--shadow);
    transition:transform 160ms ease, box-shadow 160ms ease;
  }
  .hero-cta:hover{transform:translateY(-2px);box-shadow:0 16px 34px -12px var(--shadow);}
  .hero-cta:active{transform:translateY(0);}
  .hero-cta .arrow{display:inline-block;transition:transform 160ms ease;}
  .hero-cta:hover .arrow{transform:translateX(4px);}

  .roster-preview{
    margin-top:52px;
    display:flex;
    justify-content:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .roster-chip{
    width:64px;height:64px;
    border-radius:16px;
    background:var(--bg-elevated);
    border:1px solid var(--card-border);
    padding:8px;
    display:flex;align-items:center;justify-content:center;
    position:relative;
    overflow:hidden;
    animation:chipBob 3.6s ease-in-out infinite;
  }
  .roster-chip:nth-child(2){animation-delay:0.3s;}
  .roster-chip:nth-child(3){animation-delay:0.6s;}
  .roster-chip:nth-child(4){animation-delay:0.9s;}
  .roster-chip:nth-child(5){animation-delay:1.2s;}
  @keyframes chipBob{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-5px);}
  }

  /* ============================================================ */
  /* ART STAGE — shared by hero chips, hand tiles, battle cards     */
  /* Falls back to generated SVG; swaps to a PNG automatically      */
  /* if a matching file exists at the given path.                   */
  /* ============================================================ */
  .art-stage{position:absolute;inset:0;}
  .art-fallback{position:absolute;inset:0;}
  .art-fallback svg{width:100%;height:100%;display:block;}
  .art-photo{
    position:absolute;inset:0;width:100%;height:100%;
    object-fit:cover;opacity:0;
    transition:opacity 480ms ease;
  }
  .art-photo.is-loaded{opacity:1;}

  /* ============================================================ */
  /* ARENA SHELL                                                    */
  /* ============================================================ */
  .arena-section{
    padding:20px 20px 100px;
    background:var(--bg-arena);
  }
  .arena-shell{
    width:min(980px, 100%);
    margin:0 auto;
  }

  .scoreboard{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:18px 22px;
    margin-top:-32px;
    position:relative;
    z-index:2;
    border-radius:18px;
    background:var(--bg-elevated);
    border:1px solid var(--card-border);
    box-shadow:0 18px 40px -20px var(--shadow);
  }
  .score-side{display:flex;flex-direction:column;gap:2px;min-width:74px;}
  .score-side.pc{align-items:flex-end;text-align:right;}
  .score-label{font-size:11px;font-weight:700;color:var(--ink-faint);letter-spacing:0.04em;}
  .score-value{font-family:"Fraunces",serif;font-size:30px;font-weight:600;font-variant-numeric:tabular-nums;}
  .round-pips{display:flex;gap:10px;align-items:center;}
  .round-pip{
    width:11px;height:11px;border-radius:50%;
    background:var(--card-border);
    transition:background 200ms ease, transform 200ms ease;
  }
  .round-pip.done-player{background:var(--violet);animation:pipPop 420ms ease;}
  .round-pip.done-pc{background:var(--red);animation:pipPop 420ms ease;}
  .round-pip.done-draw{background:var(--gold);animation:pipPop 420ms ease;}
  @keyframes pipPop{
    0%{transform:scale(0.4);}
    55%{transform:scale(1.5);}
    100%{transform:scale(1);}
  }
  .round-pip.current{transform:scale(1.35);box-shadow:0 0 0 3px var(--card-border);}
  .round-label{
    text-align:center;font-size:13px;color:var(--ink-muted);margin-top:8px;font-weight:600;
  }

  /* ============================================================ */
  /* BATTLE STAGE                                                   */
  /* ============================================================ */
  .stage{
    margin-top:26px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:18px;
    align-items:stretch;
    perspective:1000px;
    position:relative;
  }
  .stage-vs{
    align-self:center;
    font-family:"Fraunces",serif;
    font-size:14px;
    font-weight:600;
    color:var(--ink-faint);
    padding:0 4px;
  }
  .slot{
    min-height:340px;
    border-radius:18px;
    background:var(--bg-elevated);
    border:1px solid var(--card-border);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:20px;
    gap:10px;
    position:relative;
    overflow:hidden;
  }
  .slot-label{
    position:absolute;top:14px;left:16px;
    font-size:11px;font-weight:700;letter-spacing:0.04em;
    color:var(--ink-faint);
  }
  .slot-empty{color:var(--ink-faint);font-size:14px;text-align:center;max-width:180px;}

  @keyframes megaGlow{
    0%,100%{filter:drop-shadow(0 0 0px var(--gold));}
    50%{filter:drop-shadow(0 0 14px var(--gold));}
  }
  .slot.mega-active{animation:megaGlow 1.6s ease-in-out infinite;}

  .spark{
    position:absolute;top:50%;left:50%;width:6px;height:6px;border-radius:50%;
    background:var(--gold);
    animation:sparkBurst 750ms ease-out forwards;
  }
  @keyframes sparkBurst{
    0%{transform:translate(-50%,-50%) scale(1);opacity:1;}
    100%{transform:translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0);opacity:0;}
  }

  /* ---- move clash: two bolts collide between the slots ---- */
  .clash-fx{position:absolute;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .bolt{
    position:absolute;top:50%;width:14px;height:14px;margin-top:-7px;border-radius:50%;
    background:var(--bolt-color);box-shadow:0 0 18px var(--bolt-color);
  }
  .bolt-p{left:6%;animation:boltRight 380ms ease-in forwards;}
  .bolt-c{right:6%;animation:boltLeft 380ms ease-in forwards;}
  @keyframes boltRight{from{left:6%;}to{left:47%;}}
  @keyframes boltLeft{from{right:6%;}to{right:47%;}}
  .impact{
    position:absolute;top:50%;left:50%;width:8px;height:8px;border-radius:50%;
    background:var(--impact-color);
    transform:translate(-50%,-50%) scale(0);opacity:0;
    animation:impactPop 420ms ease-out 380ms forwards;
  }
  @keyframes impactPop{
    0%{transform:translate(-50%,-50%) scale(0);opacity:0;}
    35%{transform:translate(-50%,-50%) scale(7);opacity:0.85;}
    100%{transform:translate(-50%,-50%) scale(13);opacity:0;}
  }
  @keyframes stageShake{
    0%,100%{transform:translateX(0);}
    20%{transform:translateX(-6px);}
    40%{transform:translateX(5px);}
    60%{transform:translateX(-3px);}
    80%{transform:translateX(2px);}
  }
  .stage.shake{animation:stageShake 380ms ease;}

  /* ============================================================ */
  /* MEGA EVOLUTION — full-screen takeover, themed per form         */
  /* ============================================================ */
  .mega-overlay{
    position:fixed;inset:0;z-index:80;
    display:flex;align-items:center;justify-content:center;
    opacity:0;pointer-events:none;
    transition:opacity 340ms ease;
    background:radial-gradient(circle at 50% 45%, var(--ov-a,#2a1c40), var(--ov-b,#0a0512) 72%);
  }
  .mega-overlay.show{opacity:1;}
  .mega-overlay-content{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px;}
  .mega-overlay-art{
    width:200px;height:200px;border-radius:50%;overflow:hidden;
    box-shadow:0 0 70px var(--ov-accent,#fff);
    transform:scale(0.55);opacity:0;
    transition:transform 650ms cubic-bezier(.2,.8,.3,1), opacity 500ms ease;
  }
  .mega-overlay.show .mega-overlay-art{transform:scale(1);opacity:1;}
  .mega-overlay-art svg{width:100%;height:100%;display:block;}
  .mega-overlay-sub{
    font-family:"Barlow Condensed",sans-serif;font-size:19px;font-weight:700;color:#fff;letter-spacing:0.05em;
    text-transform:uppercase;text-align:center;
    transition:opacity 280ms ease;
  }
  .mega-overlay-title{
    font-family:"Barlow Condensed",sans-serif;font-size:clamp(28px,6vw,44px);font-weight:800;
    color:var(--ov-accent,#fff);text-align:center;
    opacity:0;transform:translateY(8px);
    transition:opacity 400ms ease, transform 400ms ease;
  }
  .mega-overlay-move{
    font-family:"Barlow Condensed",sans-serif;
    font-size:13px;color:rgba(255,255,255,0.85);letter-spacing:0.06em;text-transform:uppercase;
    opacity:0;transition:opacity 400ms ease 80ms;text-align:center;
  }
  .mega-overlay.phase2 .mega-overlay-sub{opacity:0;}
  .mega-overlay.phase2 .mega-overlay-title{opacity:1;transform:translateY(0);}
  .mega-overlay.phase2 .mega-overlay-move{opacity:1;}
  .mega-overlay::before{
    content:"";position:absolute;top:50%;left:50%;width:20px;height:20px;
    border-radius:50%;border:3px solid var(--ov-accent,#fff);
    transform:translate(-50%,-50%);
    opacity:0;
  }
  .mega-overlay.show::before{animation:ringBurst 900ms ease-out;}
  @keyframes ringBurst{
    0%{width:20px;height:20px;opacity:0.9;}
    100%{width:1000px;height:1000px;opacity:0;}
  }

  /* ---- battle card: TCG-style frame ---- */
  .battle-card{width:182px;transform-style:preserve-3d;}
  .card-frame{
    position:relative;
    border-radius:16px;
    padding:3px;
    background:linear-gradient(155deg, var(--gold-soft), var(--gold) 45%, var(--violet-light) 100%);
    box-shadow:0 20px 38px -18px var(--shadow);
  }
  .card-frame::after{
    content:"";position:absolute;inset:0;border-radius:16px;pointer-events:none;
    background:linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.75) 50%, transparent 65%);
    opacity:0.5;mix-blend-mode:overlay;
  }
  .battle-card.is-mega .card-frame{
    background:linear-gradient(155deg, var(--gold-soft), var(--violet-light) 40%, var(--gold) 75%, var(--gold-soft) 100%);
    background-size:220% 220%;
    animation:foilShift 3.5s ease-in-out infinite;
  }
  @keyframes foilShift{
    0%,100%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
  }
  .card-inner{
    border-radius:13px;
    background:var(--card-bg);
    padding:9px;
    display:flex;flex-direction:column;gap:6px;
  }
  .card-header{display:flex;flex-direction:column;gap:4px;}
  .stage-ribbon{
    align-self:flex-start;
    font-family:"Barlow Condensed",sans-serif;
    font-size:10px;font-weight:700;letter-spacing:0.09em;
    padding:2px 8px;border-radius:999px;
    background:var(--hand-bg); color:var(--ink-muted);
  }
  .battle-card.is-mega .stage-ribbon{background:var(--gold);color:#241606;}
  .name-row{display:flex;align-items:baseline;justify-content:space-between;gap:6px;}
  .card-name{
    font-family:"Barlow Condensed",sans-serif;
    font-size:19px;font-weight:800;letter-spacing:0.01em;line-height:1;
    text-transform:uppercase;
  }
  .pwr-badge{font-size:8.5px;font-weight:800;color:var(--ink-faint);white-space:nowrap;letter-spacing:0.03em;}
  .pwr-badge b{font-family:"Barlow Condensed",sans-serif;color:var(--ink);font-size:15px;}

  .art-window{position:relative;border-radius:9px;overflow:hidden;aspect-ratio:1/1;background:#000;}
  .art-window::after{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:repeating-linear-gradient(
      118deg,
      rgba(255,255,255,0.09) 0px, rgba(255,255,255,0.09) 3px,
      transparent 3px, transparent 16px
    );
    mix-blend-mode:overlay;opacity:0.55;
  }
  .holo-sheen{
    position:absolute;inset:0;pointer-events:none;opacity:0;
    background:linear-gradient(115deg, transparent 25%, rgba(255,255,255,0.6) 48%, transparent 68%);
    mix-blend-mode:overlay;
    transform:translateX(-130%);
  }
  .battle-card.is-mega .holo-sheen{opacity:1;animation:sheenSweep 2.3s ease-in-out infinite;}
  @keyframes sheenSweep{
    0%{transform:translateX(-130%);}
    100%{transform:translateX(130%);}
  }

  .card-types{display:flex;gap:4px;}
  .type-pill{
    display:inline-block;
    padding:2px 8px;
    border-radius:999px;
    font-size:9px;
    font-weight:800;
    letter-spacing:0.03em;
    color:#fff;
    text-transform:uppercase;
  }

  .move-block{border-top:1px solid var(--card-border);padding-top:6px;}
  .move-cost{display:flex;gap:4px;margin-bottom:4px;}
  .energy-pip{
    width:13px;height:13px;border-radius:50%;
    background-color:var(--pip-color,#999);
    background-image:radial-gradient(circle at 32% 28%, rgba(255,255,255,0.85), rgba(255,255,255,0) 45%);
    box-shadow:inset 0 -1px 2px rgba(0,0,0,0.35), 0 1px 1px rgba(0,0,0,0.2);
  }
  .move-name{font-family:"Barlow Condensed",sans-serif;font-size:14px;font-weight:700;letter-spacing:0.01em;}
  .move-effect{font-size:9px;color:var(--ink-muted);line-height:1.35;margin-top:2px;}

  .card-footer{
    display:flex;justify-content:space-between;align-items:center;
    border-top:1px solid var(--card-border);padding-top:6px;
    font-family:"Barlow Condensed",sans-serif;
    font-size:10px;letter-spacing:0.02em;color:var(--ink-faint);
  }
  .card-footer .stat-group{display:flex;align-items:center;gap:4px;}
  .card-footer .stat-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
  .card-footer .weak-value{color:var(--ink);font-weight:700;}
  .card-footer .card-no{font-variant-numeric:tabular-nums;opacity:0.8;}

  /* ============================================================ */
  /* RESULT BANNER                                                  */
  /* ============================================================ */
  .result-panel{
    margin-top:18px;
    border-radius:16px;
    border:1px solid var(--card-border);
    background:var(--bg-elevated);
    padding:20px 22px;
    display:none;
  }
  .result-panel.show{display:block;animation:panelIn 340ms ease both;}
  @keyframes panelIn{
    from{opacity:0;transform:translateY(10px);}
    to{opacity:1;transform:translateY(0);}
  }
  .result-headline{
    font-family:"Fraunces",serif;
    font-size:22px;
    font-weight:600;
    margin:0 0 10px;
  }
  .result-headline.player{color:var(--violet);}
  .result-headline.pc{color:var(--red);}
  .result-headline.draw{color:var(--gold);}

  .meter-row{display:grid;grid-template-columns:44px 1fr 40px;align-items:center;gap:10px;margin-bottom:7px;}
  .meter-label{font-size:11px;font-weight:700;color:var(--ink-muted);}
  .meter-track{height:8px;border-radius:999px;background:var(--hand-bg);overflow:hidden;}
  .meter-fill{height:100%;border-radius:999px;width:0%;transition:width 700ms cubic-bezier(.2,.8,.3,1);}
  .meter-fill.player{background:linear-gradient(90deg, var(--violet-light), var(--violet));}
  .meter-fill.pc{background:linear-gradient(90deg, var(--red), #8A2540);}
  .meter-num{font-size:12px;font-weight:800;text-align:right;font-variant-numeric:tabular-nums;}

  .result-detail{font-size:13px;color:var(--ink-muted);margin:8px 0 0;}
  .special-note{
    margin-top:10px;
    padding:10px 12px;
    border-radius:10px;
    background:var(--hand-bg);
    font-size:13px;
    color:var(--ink);
    animation:panelIn 300ms ease both;
  }
  .special-note strong{color:var(--gold);}

  .continue-row{margin-top:16px;display:flex;justify-content:flex-end;}
  .btn{
    padding:11px 20px;
    border-radius:11px;
    border:0;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    transition:transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
  }
  .btn-primary{background:var(--violet);color:#fff;}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 22px -12px var(--shadow);}
  .btn-primary:active{transform:translateY(0);}
  .btn-ghost{background:transparent;color:var(--violet);border:1px solid var(--card-border);}

  /* ============================================================ */
  /* HAND                                                           */
  /* ============================================================ */
  .hand-wrap{margin-top:30px;}
  .hand-heading{
    display:flex;align-items:baseline;justify-content:space-between;
    margin-bottom:12px;
  }
  .hand-heading h2{font-size:18px;margin:0;}
  .hand-heading span{font-size:13px;color:var(--ink-faint);}
  .hand{
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:12px;
  }
  .hand-card{
    background:var(--card-bg);
    border:1px solid var(--card-border);
    border-radius:14px;
    padding:12px 10px 14px;
    display:flex;flex-direction:column;align-items:center;gap:8px;
    cursor:pointer;
    transition:transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .hand-card:hover:not(:disabled){transform:translateY(-6px) scale(1.03);border-color:var(--violet-light);box-shadow:0 16px 26px -16px var(--shadow);}
  .hand-card:active:not(:disabled){transform:translateY(-2px) scale(1.01);}
  .hand-card .hand-art{width:54px;height:54px;position:relative;border-radius:10px;overflow:hidden;background:radial-gradient(circle at 50% 30%, rgba(120,80,180,0.12), transparent 70%);}
  .hand-card .hand-name{font-family:"Barlow Condensed",sans-serif;font-size:14px;font-weight:700;letter-spacing:0.02em;text-transform:uppercase;text-align:center;}
  .hand-card:disabled{
    opacity:0.32;
    cursor:default;
    filter:grayscale(0.6);
  }
  .hand-card:disabled .used-tag{
    font-size:9px;font-weight:800;color:var(--ink-faint);letter-spacing:0.05em;
  }

  /* ============================================================ */
  /* RULES PANEL                                                    */
  /* ============================================================ */
  .rules{
    margin-top:34px;
    border-radius:16px;
    border:1px solid var(--card-border);
    background:var(--bg-elevated);
    overflow:hidden;
  }
  .rules summary{
    list-style:none;
    cursor:pointer;
    padding:16px 20px;
    display:flex;align-items:center;justify-content:space-between;
    font-weight:700;font-size:14px;
  }
  .rules summary::-webkit-details-marker{display:none;}
  .rules summary::after{
    content:"+";
    font-size:20px;font-weight:400;color:var(--ink-faint);
  }
  .rules[open] summary::after{content:"–";}
  .rules-body{padding:0 20px 20px;color:var(--ink-muted);font-size:14px;line-height:1.7;}
  .rules-body h4{margin:16px 0 4px;color:var(--ink);font-size:13px;}
  .rules-body ul{margin:4px 0;padding-left:18px;}

  /* ============================================================ */
  /* FINAL SCREEN                                                   */
  /* ============================================================ */
  .final-overlay{
    display:none;
    margin-top:26px;
    border-radius:20px;
    padding:40px 28px;
    text-align:center;
    background:linear-gradient(160deg, var(--violet-deep), var(--violet));
    color:#fff;
    position:relative;
    overflow:hidden;
  }
  .final-overlay.show{display:block;animation:panelIn 420ms ease both;}
  .final-overlay h2{font-size:clamp(28px,5vw,40px);margin:0 0 8px;color:#fff;}
  .final-overlay p{color:rgba(255,255,255,0.8);max-width:420px;margin:0 auto;}
  .final-recap{
    margin:26px auto 0;
    max-width:480px;
    display:flex;flex-direction:column;gap:8px;
    text-align:left;
  }
  .final-recap .recap-row{
    display:flex;justify-content:space-between;gap:10px;
    padding:10px 14px;border-radius:10px;
    background:rgba(255,255,255,0.08);
    font-size:13px;
  }
  .final-cta{margin-top:26px;}
  .final-cta .btn-primary{background:#fff;color:var(--violet-deep);}

  /* ============================================================ */
  /* FOOTER                                                         */
  /* ============================================================ */
  .legal{
    padding:36px 20px 60px;
    text-align:center;
    background:var(--bg-arena);
  }
  .legal p{
    max-width:560px;margin:0 auto 6px;
    font-size:12px;line-height:1.7;
    color:var(--ink-faint);
  }
  .legal strong{color:var(--ink-muted);}

  /* ============================================================ */
  /* RESPONSIVE                                                     */
  /* ============================================================ */
  @media (max-width:760px){
    .stage{grid-template-columns:1fr;}
    .stage-vs{justify-self:center;}
    .battle-card{width:210px;margin:0 auto;}
    .hand{grid-template-columns:repeat(5, minmax(0,1fr));gap:7px;}
    .hand-card{padding:8px 4px 10px;}
    .hand-card .hand-art{width:38px;height:38px;}
    .hand-card .hand-name{font-size:9.5px;}
    .scoreboard{flex-wrap:wrap;}
    .meter-row{grid-template-columns:36px 1fr 34px;gap:6px;}
  }
  @media (max-width:420px){
    .hand{grid-template-columns:repeat(5,1fr);}
  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
    .hero-rings .ring-outer,.hero-rings .ring-inner{animation:none;}
    .battle-card.is-mega .card-frame{animation:none;}
    .battle-card.is-mega .holo-sheen{animation:none;opacity:0.25;}
  }
</style>
</head>
<body>

<header class="hero">
  <svg class="hero-rings" viewBox="0 0 400 400" aria-hidden="true">
    <g class="ring-outer">
      <circle cx="200" cy="200" r="180" fill="none" stroke="#F2C230" stroke-width="2" opacity="0.35"/>
      <circle cx="200" cy="200" r="150" fill="none" stroke="#F2C230" stroke-width="6" opacity="0.5"/>
    </g>
    <g class="ring-inner">
      <circle cx="200" cy="200" r="110" fill="none" stroke="#9B5FD8" stroke-width="3" opacity="0.4"/>
      <circle cx="200" cy="200" r="70" fill="none" stroke="#F2C230" stroke-width="10" opacity="0.25"/>
    </g>
  </svg>
  <div class="hero-inner">
    <span class="hero-kicker">Trading-card duel · fan project</span>
    <h1>Pokémon Duel</h1>
    <p>A three-round card duel set in Hoopa's portal arena. Pick your fighter, let type effectiveness decide the round, and watch for the rare Mega Evolution.</p>
    <button class="hero-cta" id="enterArenaBtn">
      Enter the arena <span class="arrow" aria-hidden="true">→</span>
    </button>
    <div class="roster-preview" aria-hidden="true" id="rosterPreview"></div>
  </div>
</header>

<section class="arena-section" id="arena">
  <div class="arena-shell">

    <div class="scoreboard">
      <div class="score-side">
        <span class="score-label">YOU</span>
        <span class="score-value" id="playerScore">0</span>
      </div>
      <div style="text-align:center;">
        <div class="round-pips" id="roundPips"></div>
        <div class="round-label" id="roundLabel">Round 1 of 3</div>
      </div>
      <div class="score-side pc">
        <span class="score-label">ARENA</span>
        <span class="score-value" id="pcScore">0</span>
      </div>
    </div>

    <div class="stage" id="stageEl">
      <div class="slot" id="playerSlot">
        <span class="slot-label">YOU</span>
        <div class="slot-empty">Choose a card from your hand below</div>
      </div>
      <div class="stage-vs">VS</div>
      <div class="slot" id="pcSlot">
        <span class="slot-label">ARENA</span>
        <div class="slot-empty">Waiting for your move…</div>
      </div>
    </div>

    <div class="result-panel" id="resultPanel">
      <h3 class="result-headline" id="resultHeadline"></h3>
      <div id="meterRows"></div>
      <p class="result-detail" id="resultDetail"></p>
      <div id="specialNotes"></div>
      <div class="continue-row">
        <button class="btn btn-primary" id="continueBtn">Continue</button>
      </div>
    </div>

    <div class="hand-wrap" id="handWrap">
      <div class="hand-heading">
        <h2>Your hand</h2>
        <span id="handHint">Pick one card to play this round</span>
      </div>
      <div class="hand" id="hand"></div>
    </div>

    <div class="final-overlay" id="finalOverlay">
      <h2 id="finalHeadline"></h2>
      <p id="finalDetail"></p>
      <div class="final-recap" id="finalRecap"></div>
      <div class="final-cta">
        <button class="btn btn-primary" id="playAgainBtn">Play again</button>
      </div>
    </div>

    <details class="rules">
      <summary>How Mega Evolution works</summary>
      <div class="rules-body">
        <h4>Format</h4>
        <p>Three rounds. Each round you play one card from your remaining hand; the arena plays one at random from its own. Whichever card is more type-effective against the other wins the round — worked out the way the main games do it, so a dual-type card can be hit by two types at once.</p>
        <h4>Mega Evolution</h4>
        <ul>
          <li><strong>Darkrai</strong> and <strong>Amphinobi</strong> — roughly a 30% chance to Mega Evolve when played, gaining two lives and a signature move.</li>
          <li><strong>Raichu</strong> — the same 30% chance, but splits into one of two Mega forms: Volt (Electric/Fighting) or Psy (Electric/Psychic).</li>
          <li><strong>Zygarde</strong> — can only reach its Complete Forme if your side has already lost a round <em>and</em> the same 30% roll succeeds. It won't evolve while things are still going well.</li>
          <li><strong>Hoopa</strong> has no Mega form — its rings are already at full power.</li>
        </ul>
        <h4>Two lives</h4>
        <p>A Mega Evolved card that's about to lose a round instead spends a life and unleashes its special move, turning the result around. Regular ties are broken by raw power; an exact mirror match comes down to chance.</p>
        <h4>Reading a card</h4>
        <p><strong>PWR</strong> is this card's power rating — used to break ties. <strong>Weak</strong> shows the single type that hits it hardest, computed from the same chart the round uses. The move line is flavor for base cards; for Mega forms it names the exact effect it triggers.</p>
        <h4>See it now</h4>
        <p>Mega Evolution is a ~30% roll, so you might not hit it in your first few rounds. Preview the full-screen sequence on demand:</p>
        <button type="button" class="btn btn-ghost" id="previewMegaBtn">▶ Preview a Mega Evolution</button>
      </div>
    </details>

  </div>
</section>

<div class="mega-overlay" id="megaOverlay" aria-hidden="true">
  <div class="mega-overlay-content">
    <div class="mega-overlay-art" id="megaOverlayArt"></div>
    <div class="mega-overlay-sub" id="megaOverlaySub"></div>
    <div class="mega-overlay-title" id="megaOverlayTitle"></div>
    <div class="mega-overlay-move" id="megaOverlayMove"></div>
  </div>
</div>

<footer class="legal">
  <p><strong>Pokémon</strong> and all related names, characters and trademarks are the property of Nintendo, Game Freak and Creatures Inc. This is an unofficial, non-commercial fan project, not affiliated with or endorsed by The Pokémon Company. All artwork generated by this page is original.</p>
  <p>Card art can optionally be swapped for your own local PNG files — see the image paths in the source. No third-party artwork ships with this project; a card simply falls back to its generated emblem if no file is found.</p>
  <p>Game concept, rules and design by <strong>[Aymane Jabrane]</strong>.</p>
</footer>

<script is:inline>

(function(){
  "use strict";

  /* ============================================================ */
  /* TYPE SYSTEM                                                    */
  /* ============================================================ */
  var TYPE_COLORS = {
    psychic:"#B24FD9", ghost:"#6E63D6", dark:"#5A4A72",
    water:"#1E9FB0", ground:"#B08A4E", dragon:"#4C77CC",
    electric:"#D9A404", fighting:"#C4453F"
  };

  // attacker -> defender -> multiplier (only non-1x entries listed)
  var CHART = {
    psychic:  { dark:0, psychic:0.5, fighting:2 },
    ghost:    { psychic:2, ghost:2, dark:0.5 },
    dark:     { psychic:2, ghost:2, dark:0.5, fighting:0.5 },
    water:    { ground:2, dragon:0.5, water:0.5 },
    ground:   { electric:2 },
    dragon:   { dragon:2 },
    electric: { water:2, electric:0.5, ground:0, dragon:0.5 },
    fighting: { psychic:0.5, dark:2, ghost:0 }
  };

  function typeMultiplier(atkType, defTypes){
    var c = CHART[atkType] || {};
    var m = 1;
    for (var i=0;i<defTypes.length;i++){
      var v = c[defTypes[i]];
      m *= (v === undefined ? 1 : v);
    }
    return m;
  }
  function bestMultiplier(atkTypes, defTypes){
    var best = 0, first = true;
    for (var i=0;i<atkTypes.length;i++){
      var m = typeMultiplier(atkTypes[i], defTypes);
      if (first || m > best){ best = m; first = false; }
    }
    return best;
  }
  function effLabel(m){
    if (m === 0) return "No effect";
    if (m < 1) return "Not very effective";
    if (m === 1) return "Neutral";
    if (m <= 2) return "Super effective";
    return "Devastating";
  }
  // The single type (from the chart's own type list) that hits `types` hardest.
  function computeWeakness(types){
    var best = 0, bestType = null;
    Object.keys(CHART).forEach(function(t){
      var m = typeMultiplier(t, types);
      if (m > best){ best = m; bestType = t; }
    });
    return best > 1 ? { type: bestType, mult: best } : null;
  }

  /* ============================================================ */
  /* ART — original generative SVG fallback, with optional PNG     */
  /* swap-in. Drop a file at the path below and it's used          */
  /* automatically; otherwise the emblem below is shown.           */
  /* ============================================================ */
  function typePills(types){
    return types.map(function(t){
      return '<span class="type-pill" style="background:'+TYPE_COLORS[t]+'">'+t+'</span>';
    }).join("");
  }

  // Wraps a fallback SVG + an <img> that swaps in if it loads.
  function renderArt(imgSrc, svgMarkup, altName){
    return '<div class="art-stage">'+
      '<div class="art-fallback">'+svgMarkup+'</div>'+
      '<img class="art-photo" src="'+imgSrc+'" alt="'+altName+'" loading="lazy" decoding="async" '+
        'onload="this.classList.add(\'is-loaded\')" onerror="this.remove()" />'+
    '</div>';
  }

  function hexPoints(cx,cy,r){
    var pts = [];
    for (var i=0;i<6;i++){
      var a = Math.PI/180*(60*i-30);
      pts.push((cx+r*Math.cos(a)).toFixed(1)+","+(cy+r*Math.sin(a)).toFixed(1));
    }
    return pts.join(" ");
  }

  function artHoopa(uid){
    return '<svg viewBox="0 0 200 200" role="img" aria-label="Hoopa emblem">'+
      '<defs>'+
        '<radialGradient id="'+uid+'bg" cx="50%" cy="45%" r="65%">'+
          '<stop offset="0%" stop-color="#B77BE0"/>'+
          '<stop offset="55%" stop-color="#5B2C82"/>'+
          '<stop offset="100%" stop-color="#2B1246"/>'+
        '</radialGradient>'+
        '<linearGradient id="'+uid+'gold" x1="0" y1="0" x2="1" y2="1">'+
          '<stop offset="0%" stop-color="#FCE9A8"/>'+
          '<stop offset="100%" stop-color="#C99A1F"/>'+
        '</linearGradient>'+
      '</defs>'+
      '<rect width="200" height="200" fill="url(#'+uid+'bg)"/>'+
      '<circle cx="100" cy="100" r="72" fill="none" stroke="url(#'+uid+'gold)" stroke-width="10"/>'+
      '<circle cx="100" cy="100" r="52" fill="none" stroke="url(#'+uid+'gold)" stroke-width="6" opacity="0.85"/>'+
      '<circle cx="100" cy="100" r="30" fill="#1B0E30" opacity="0.55"/>'+
      '<polygon points="100,78 112,100 100,122 88,100" fill="#E24C5C"/>'+
      '<circle cx="100" cy="100" r="4" fill="#FCE9A8"/>'+
      '</svg>';
  }

  function artDarkrai(uid){
    return '<svg viewBox="0 0 200 200" role="img" aria-label="Darkrai emblem">'+
      '<defs>'+
        '<radialGradient id="'+uid+'bg" cx="50%" cy="40%" r="70%">'+
          '<stop offset="0%" stop-color="#392A55"/>'+
          '<stop offset="100%" stop-color="#0C0716"/>'+
        '</radialGradient>'+
        '<linearGradient id="'+uid+'moon" x1="0" y1="0" x2="1" y2="1">'+
          '<stop offset="0%" stop-color="#EDE6FA"/>'+
          '<stop offset="100%" stop-color="#B6ACD6"/>'+
        '</linearGradient>'+
      '</defs>'+
      '<rect width="200" height="200" fill="url(#'+uid+'bg)"/>'+
      '<path d="M138 40a48 48 0 1 0 0 92 60 60 0 1 1 0-92Z" fill="url(#'+uid+'moon)" opacity="0.9"/>'+
      '<path d="M20 175c22-30 36-44 54-30 14 11 6 26-8 22-16-5-26 2-46 8Z" fill="#241640" opacity="0.8"/>'+
      '<path d="M40 150c26-18 46-18 60 2" stroke="#6E5B9A" stroke-width="4" fill="none" opacity="0.6" stroke-linecap="round"/>'+
      '<polygon points="72,108 84,100 72,92 66,100" fill="#F0576A"/>'+
      '</svg>';
  }

  function artAmphinobi(uid){
    return '<svg viewBox="0 0 200 200" role="img" aria-label="Amphinobi emblem">'+
      '<defs>'+
        '<radialGradient id="'+uid+'bg" cx="50%" cy="45%" r="68%">'+
          '<stop offset="0%" stop-color="#3FD3D9"/>'+
          '<stop offset="55%" stop-color="#187B8C"/>'+
          '<stop offset="100%" stop-color="#0B2E3B"/>'+
        '</radialGradient>'+
      '</defs>'+
      '<rect width="200" height="200" fill="url(#'+uid+'bg)"/>'+
      '<g transform="translate(100 100)">'+
        '<polygon points="0,-46 12,-12 46,0 12,12 0,46 -12,12 -46,0 -12,-12" fill="#0B2430" opacity="0.85"/>'+
        '<polygon points="0,-30 8,-8 30,0 8,8 0,30 -8,8 -30,0 -8,-8" fill="#E7FBFB"/>'+
      '</g>'+
      '<circle cx="46" cy="150" r="8" fill="#8FE9EC" opacity="0.8"/>'+
      '<circle cx="156" cy="54" r="5" fill="#8FE9EC" opacity="0.7"/>'+
      '<path d="M18 24 L54 60" stroke="#8FE9EC" stroke-width="3" opacity="0.5" stroke-linecap="round"/>'+
      '</svg>';
  }

  function artZygarde(uid, complete){
    var cell = complete ? "#F2B705" : "#3F9D6B";
    var hexes = "";
    var rows=[[30,40],[70,40],[110,40],[150,40],[50,70],[90,70],[130,70],[170,70]];
    for (var i=0;i<rows.length;i++){
      hexes += '<polygon points="'+hexPoints(rows[i][0],rows[i][1],13)+'" fill="none" stroke="#8FD9AE" stroke-width="1.4" opacity="0.35"/>';
    }
    return '<svg viewBox="0 0 200 200" role="img" aria-label="Zygarde emblem">'+
      '<defs>'+
        '<radialGradient id="'+uid+'bg" cx="50%" cy="45%" r="70%">'+
          '<stop offset="0%" stop-color="#2E7A50"/>'+
          '<stop offset="100%" stop-color="#0F2B1C"/>'+
        '</radialGradient>'+
      '</defs>'+
      '<rect width="200" height="200" fill="url(#'+uid+'bg)"/>'+
      hexes+
      '<path d="M30 150 C 70 110, 60 90, 100 90 S 130 60, 170 40" stroke="#DDEFC8" stroke-width="9" fill="none" stroke-linecap="round" opacity="0.9"/>'+
      '<circle cx="100" cy="90" r="11" fill="'+cell+'"/>'+
      '</svg>';
  }

  function artRaichu(uid, variant){
    var primary = variant==="volt" ? "#E1592A" : (variant==="psy" ? "#7B57D9" : "#D9A404");
    var spark = variant==="volt" ? "#FFD37A" : (variant==="psy" ? "#C9A8F5" : "#FFF3B0");
    return '<svg viewBox="0 0 200 200" role="img" aria-label="Raichu emblem">'+
      '<defs>'+
        '<radialGradient id="'+uid+'bg" cx="50%" cy="40%" r="70%">'+
          '<stop offset="0%" stop-color="'+spark+'"/>'+
          '<stop offset="55%" stop-color="'+primary+'"/>'+
          '<stop offset="100%" stop-color="#5C3406"/>'+
        '</radialGradient>'+
      '</defs>'+
      '<rect width="200" height="200" fill="url(#'+uid+'bg)"/>'+
      '<polygon points="112,28 70,108 96,108 84,172 140,88 110,88" fill="#241606" opacity="0.28"/>'+
      '<polygon points="108,24 66,104 92,104 80,168 136,84 106,84" fill="#FFF3B0"/>'+
      '<circle cx="46" cy="50" r="9" fill="'+spark+'"/>'+
      '<circle cx="160" cy="140" r="6" fill="'+spark+'"/>'+
      '</svg>';
  }

  /* ============================================================ */
  /* ROSTER                                                         */
  /* Each form carries an `img` path. Drop a matching PNG under     */
  /* that path in your project (e.g. /public/images/pokemon/...)    */
  /* and it will be used in place of the generated emblem — no      */
  /* code changes needed.                                           */
  /* ============================================================ */
  var MEGA_CHANCE = 0.3;
  var IMG_BASE = "/images/pokemon/";

  var ROSTER = [
    {
      id:"hoopa", name:"Hoopa", types:["psychic","ghost"], power:108,
      img:IMG_BASE+"hoopa.png",
      move:"Prankster's Rings", moveEffect:"Warps probability just enough to matter.",
      tagline:"Reshapes space through its rings. No Mega form — it's already running at full power.",
      art:artHoopa, canMega:false
    },
    {
      id:"darkrai", name:"Darkrai", types:["dark"], power:100,
      img:IMG_BASE+"darkrai.png",
      move:"Nightmare Veil", moveEffect:"Saps focus right before the clash.",
      tagline:"Feeds on nightmares. About a 30% chance to Mega Evolve, gaining two lives and Nightmare Vortex.",
      art:artDarkrai, canMega:true,
      mega:{ name:"Mega Darkrai", types:["dark","ghost"], move:"Nightmare Vortex", power:132,
             moveEffect:"Spends a life to guarantee the round.",
             img:IMG_BASE+"darkrai-mega.png", art:artDarkrai,
             theme:{ a:"#4B3A73", b:"#0B0714", accent:"#F0576A" } }
    },
    {
      id:"amphinobi", name:"Amphinobi", types:["water","dark"], power:103,
      img:IMG_BASE+"amphinobi.png",
      move:"Water Shuriken", moveEffect:"A blade of compressed water, thrown fast.",
      tagline:"Strikes with water-forged blades. About a 30% chance to Mega Evolve, gaining two lives and Aqua Shuriken.",
      art:artAmphinobi, canMega:true,
      mega:{ name:"Mega Amphinobi", types:["water","dark"], move:"Aqua Shuriken", power:129,
             moveEffect:"Spends a life to guarantee the round.",
             img:IMG_BASE+"amphinobi-mega.png", art:artAmphinobi,
             theme:{ a:"#1FA9B8", b:"#052027", accent:"#8FE9EC" } }
    },
    {
      id:"zygarde", name:"Zygarde", types:["dragon","ground"], power:118,
      img:IMG_BASE+"zygarde.png",
      move:"Land's Wrath", moveEffect:"Channels power drawn from the terrain.",
      tagline:"Only reaches its Complete Forme after this side has already lost a round — and only if the odds allow it.",
      art:function(uid){return artZygarde(uid,false);}, canMega:true, megaRequiresDamage:true,
      mega:{ name:"Zygarde Complete Forme", types:["dragon","ground"], move:"Core Enforcer", power:150,
             moveEffect:"Spends a life to guarantee the round.",
             img:IMG_BASE+"zygarde-complete.png",
             art:function(uid){return artZygarde(uid,true);},
             theme:{ a:"#2E7A50", b:"#061510", accent:"#F2B705" } }
    },
    {
      id:"raichu", name:"Raichu", types:["electric"], power:95,
      img:IMG_BASE+"raichu.png",
      move:"Static Discharge", moveEffect:"A short, sharp opening jolt.",
      tagline:"About a 30% chance to Mega Evolve — into either Volt (Electric/Fighting) or Psy (Electric/Psychic).",
      art:function(uid){return artRaichu(uid,"base");}, canMega:true,
      megaForms:[
        { name:"Mega Raichu — Volt", types:["electric","fighting"], move:"Thunder Fist", power:120,
          moveEffect:"Spends a life to guarantee the round.",
          img:IMG_BASE+"raichu-mega-volt.png",
          art:function(uid){return artRaichu(uid,"volt");},
          theme:{ a:"#E1592A", b:"#220C02", accent:"#FFD37A" } },
        { name:"Mega Raichu — Psy", types:["electric","psychic"], move:"Psyvolt Smash", power:120,
          moveEffect:"Spends a life to guarantee the round.",
          img:IMG_BASE+"raichu-mega-psy.png",
          art:function(uid){return artRaichu(uid,"psy");},
          theme:{ a:"#7B57D9", b:"#120A24", accent:"#C9A8F5" } }
      ]
    }
  ];
  ROSTER.forEach(function(c, i){ c.index = i+1; });

  function findCard(id){
    for (var i=0;i<ROSTER.length;i++) if (ROSTER[i].id===id) return ROSTER[i];
    return null;
  }

  /* ============================================================ */
  /* GAME STATE                                                     */
  /* ============================================================ */
  var state = null;

  function freshState(){
    return {
      round:1,
      playerHand: ROSTER.map(function(c){return c.id;}),
      pcHand: ROSTER.map(function(c){return c.id;}),
      playerWins:0, pcWins:0, draws:0,
      playerLosses:0, pcLosses:0,
      history:[],
      awaitingContinue:false,
      animating:false,
      displayForms:null,
      finished:false
    };
  }

  function baseFormOf(megaForm){
    var b = megaForm.base;
    return {
      base:b, name:b.name, types:b.types, power:b.power,
      art:b.art, img:b.img, move:b.move, moveEffect:b.moveEffect,
      isMega:false, lives:1
    };
  }

  // Resolve whether/how a card mega evolves when played.
  // side: "player" | "pc"
  function resolveBattleForm(cardId, side){
    var base = findCard(cardId);
    var roll = Math.random();
    var lost = side==="player" ? state.playerLosses>0 : state.pcLosses>0;

    var canRoll = base.canMega && roll < MEGA_CHANCE;
    var canEvolve = canRoll && (!base.megaRequiresDamage || lost);

    if (!canEvolve){
      return {
        base:base, name:base.name, types:base.types, power:base.power,
        art:base.art, img:base.img, move:base.move, moveEffect:base.moveEffect,
        isMega:false, lives:1
      };
    }

    var form;
    if (base.megaForms){
      form = base.megaForms[Math.floor(Math.random()*base.megaForms.length)];
    } else {
      form = base.mega;
    }
    return {
      base:base, name:form.name, types:form.types, power:form.power,
      art:form.art, img:form.img, move:form.move, moveEffect:form.moveEffect,
      theme:form.theme, isMega:true, lives:2
    };
  }

  function resolveTie(a,b){
    // a and b are battle forms; returns "a" or "b"
    if (a.power !== b.power) return a.power > b.power ? "a" : "b";
    return Math.random() < 0.5 ? "a" : "b";
  }

  function playRound(chosenId){
    if (state.awaitingContinue || state.finished) return;

    // remove chosen card from player's hand
    var idx = state.playerHand.indexOf(chosenId);
    if (idx === -1) return;
    state.playerHand.splice(idx,1);

    // pc picks randomly from its hand
    var pcIdx = Math.floor(Math.random()*state.pcHand.length);
    var pcId = state.pcHand[pcIdx];
    state.pcHand.splice(pcIdx,1);

    var pForm = resolveBattleForm(chosenId, "player");
    var cForm = resolveBattleForm(pcId, "pc");

    var effP = bestMultiplier(pForm.types, cForm.types);
    var effC = bestMultiplier(cForm.types, pForm.types);

    var winner; // "player" | "pc"
    var notes = [];

    if (effP > effC) winner = "player";
    else if (effC > effP) winner = "pc";
    else {
      var mirror = pForm.name === cForm.name;
      if (mirror){
        winner = Math.random() < 0.5 ? "player" : "pc";
        notes.push("Identical clash — the round comes down to sheer chance.");
      } else if (pForm.isMega && !cForm.isMega){
        winner = "player"; pForm.lives -= 1;
        notes.push(pForm.name + " spends a life to force the tie its way.");
      } else if (cForm.isMega && !pForm.isMega){
        winner = "pc"; cForm.lives -= 1;
        notes.push(cForm.name + " spends a life to force the tie its way.");
      } else {
        var w = resolveTie(pForm, cForm);
        winner = w === "a" ? "player" : "pc";
      }
    }

    // Mega "second chance": a losing mega'd card with lives left flips the result.
    function tryFlip(loserForm, winnerEff){
      if (loserForm.isMega && loserForm.lives > 0){
        loserForm.lives -= 1;
        var newEff = winnerEff + 0.5;
        notes.push(loserForm.name + " spends a life and unleashes " + loserForm.move + " — the round turns around.");
        return {flip:true, newEff:newEff};
      }
      return {flip:false};
    }

    if (winner === "pc" && pForm.isMega){
      var r = tryFlip(pForm, effC);
      if (r.flip){ winner = "player"; effP = r.newEff; }
    } else if (winner === "player" && cForm.isMega){
      var r2 = tryFlip(cForm, effP);
      if (r2.flip){ winner = "pc"; effC = r2.newEff; }
    }

    if (pForm.isMega) notes.unshift(pForm.name + " evolved on entry — two lives, ready to use " + pForm.move + ".");
    if (cForm.isMega) notes.unshift(cForm.name + " evolved on entry — two lives, ready to use " + cForm.move + ".");

    var record = {
      round:state.round, playerForm:pForm, pcForm:cForm,
      effP:effP, effC:effC, winner:winner, notes:notes
    };

    state.animating = true;
    state.displayForms = {
      player: pForm.isMega ? baseFormOf(pForm) : pForm,
      pc: cForm.isMega ? baseFormOf(cForm) : cForm
    };
    render();
    runRoundSequence(record);
  }

  function commitRound(record){
    state.animating = false;
    state.history.push(record);
    if (record.winner === "player"){ state.playerWins++; state.pcLosses++; }
    else { state.pcWins++; state.playerLosses++; }
    state.awaitingContinue = true;
    render();
  }

  // Orchestrates the reveal -> (mega evolution) -> move clash -> result sequence.
  function runRoundSequence(record){
    if (reduceMotion){
      state.displayForms = { player: record.playerForm, pc: record.pcForm };
      commitRound(record);
      return;
    }
    setTimeout(function(){
      var queue = [];
      if (record.playerForm.isMega) queue.push({ side:"player", form:record.playerForm });
      if (record.pcForm.isMega) queue.push({ side:"pc", form:record.pcForm });
      runMegaQueue(queue, 0, function(){
        runClash(record, function(){ commitRound(record); });
      });
    }, 620); // let the initial card reveal finish first
  }

  function runMegaQueue(queue, i, done){
    if (i >= queue.length){ done(); return; }
    var item = queue[i];
    showMegaOverlay(item.form, function(){
      state.displayForms[item.side] = item.form;
      render();
      setTimeout(function(){ runMegaQueue(queue, i+1, done); }, 140);
    });
  }

  // Full-screen themed takeover for a single Mega Evolution.
  function showMegaOverlay(form, done){
    var theme = form.theme || { a:"#2a1c40", b:"#0a0512", accent:"#fff" };
    els.megaOverlay.style.setProperty("--ov-a", theme.a);
    els.megaOverlay.style.setProperty("--ov-b", theme.b);
    els.megaOverlay.style.setProperty("--ov-accent", theme.accent);
    els.megaOverlaySub.textContent = form.base.name.toUpperCase() + " IS EVOLVING…";
    els.megaOverlayTitle.textContent = form.name.toUpperCase();
    els.megaOverlayMove.textContent = "New move: " + form.move;
    els.megaOverlayArt.innerHTML = form.art("ov" + form.base.id);

    els.megaOverlay.classList.add("show");
    els.megaOverlay.classList.remove("phase2");
    setTimeout(function(){ els.megaOverlay.classList.add("phase2"); }, 650);
    setTimeout(function(){
      els.megaOverlay.classList.remove("show", "phase2");
      setTimeout(done, 340);
    }, 1900);
  }

  // Two colored bolts travel from each card and collide at the center.
  function runClash(record, done){
    var colorP = TYPE_COLORS[record.playerForm.types[0]];
    var colorC = TYPE_COLORS[record.pcForm.types[0]];
    var impactColor = record.winner === "player" ? colorP : colorC;

    var fx = document.createElement("div");
    fx.className = "clash-fx";
    fx.innerHTML =
      '<span class="bolt bolt-p" style="--bolt-color:'+colorP+'"></span>'+
      '<span class="bolt bolt-c" style="--bolt-color:'+colorC+'"></span>'+
      '<span class="impact" style="--impact-color:'+impactColor+'"></span>';
    els.stageEl.appendChild(fx);
    els.stageEl.classList.add("shake");

    setTimeout(function(){ els.stageEl.classList.remove("shake"); }, 420);
    setTimeout(function(){ fx.remove(); done(); }, 760);
  }

  function advanceRound(){
    if (state.round >= 3){
      state.finished = true;
    } else {
      state.round++;
      state.awaitingContinue = false;
    }
    render();
  }

  /* ============================================================ */
  /* RENDER                                                         */
  /* ============================================================ */
  var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var els = {
    playerScore: document.getElementById("playerScore"),
    pcScore: document.getElementById("pcScore"),
    roundPips: document.getElementById("roundPips"),
    roundLabel: document.getElementById("roundLabel"),
    stageEl: document.getElementById("stageEl"),
    playerSlot: document.getElementById("playerSlot"),
    pcSlot: document.getElementById("pcSlot"),
    resultPanel: document.getElementById("resultPanel"),
    resultHeadline: document.getElementById("resultHeadline"),
    meterRows: document.getElementById("meterRows"),
    resultDetail: document.getElementById("resultDetail"),
    specialNotes: document.getElementById("specialNotes"),
    hand: document.getElementById("hand"),
    handWrap: document.getElementById("handWrap"),
    handHint: document.getElementById("handHint"),
    finalOverlay: document.getElementById("finalOverlay"),
    finalHeadline: document.getElementById("finalHeadline"),
    finalDetail: document.getElementById("finalDetail"),
    finalRecap: document.getElementById("finalRecap"),
    continueBtn: document.getElementById("continueBtn"),
    playAgainBtn: document.getElementById("playAgainBtn"),
    megaOverlay: document.getElementById("megaOverlay"),
    megaOverlayArt: document.getElementById("megaOverlayArt"),
    megaOverlaySub: document.getElementById("megaOverlaySub"),
    megaOverlayTitle: document.getElementById("megaOverlayTitle"),
    megaOverlayMove: document.getElementById("megaOverlayMove")
  };

  function energyPips(types){
    return types.map(function(t){
      return '<span class="energy-pip" style="--pip-color:'+TYPE_COLORS[t]+'"></span>';
    }).join("");
  }

  function cardMarkup(form, uidPrefix){
    var uid = uidPrefix + "-";
    var weak = computeWeakness(form.types);
    var weakText = weak ? (weak.type.charAt(0).toUpperCase()+weak.type.slice(1)+" ×"+trimNum(weak.mult)) : "None";
    return ''+
      '<div class="card-frame">'+
        '<div class="card-inner">'+
          '<div class="card-header">'+
            '<span class="stage-ribbon">'+(form.isMega ? "MEGA EVOLUTION" : "BASIC")+'</span>'+
            '<div class="name-row">'+
              '<span class="card-name">'+form.name+'</span>'+
              '<span class="pwr-badge">PWR <b>'+form.power+'</b></span>'+
            '</div>'+
          '</div>'+
          '<div class="art-window">'+renderArt(form.img, form.art(uid), form.name)+'<div class="holo-sheen"></div></div>'+
          '<div class="card-types">'+typePills(form.types)+'</div>'+
          '<div class="move-block">'+
            '<div class="move-cost">'+energyPips(form.types)+'</div>'+
            '<div class="move-name">'+form.move+'</div>'+
            '<div class="move-effect">'+form.moveEffect+'</div>'+
          '</div>'+
          '<div class="card-footer">'+
            '<span class="stat-group"><span class="stat-dot" style="background:'+(weak?TYPE_COLORS[weak.type]:'var(--card-border)')+'"></span>Weak <span class="weak-value">'+weakText+'</span></span>'+
            '<span class="card-no">No. 0'+form.base.index+'/05</span>'+
          '</div>'+
        '</div>'+
      '</div>';
  }

  function animateNumber(el, to){
    var from = parseInt(el.textContent, 10) || 0;
    if (from === to || reduceMotion){ el.textContent = to; return; }
    var start = null, duration = 420;
    function step(ts){
      if (!start) start = ts;
      var p = Math.min(1, (ts-start)/duration);
      el.textContent = Math.round(from + (to-from)*p);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function renderScoreboard(){
    animateNumber(els.playerScore, state.playerWins);
    animateNumber(els.pcScore, state.pcWins);
    els.roundLabel.textContent = state.finished ? "Duel complete" : ("Round "+state.round+" of 3");

    els.roundPips.innerHTML = "";
    for (var r=1; r<=3; r++){
      var pip = document.createElement("span");
      pip.className = "round-pip";
      var record = state.history[r-1];
      if (record){
        if (record.winner==="player") pip.className += " done-player";
        else pip.className += " done-pc";
      } else if (r === state.round && !state.finished){
        pip.className += " current";
      }
      els.roundPips.appendChild(pip);
    }
  }

  function spawnSparks(container){
    if (reduceMotion) return "";
    var out = "";
    for (var i=0;i<10;i++){
      var angle = Math.random()*Math.PI*2;
      var dist = 40 + Math.random()*50;
      var dx = Math.round(Math.cos(angle)*dist);
      var dy = Math.round(Math.sin(angle)*dist);
      out += '<span class="spark" style="--dx:'+dx+'px;--dy:'+dy+'px;animation-delay:'+(Math.random()*120).toFixed(0)+'ms;"></span>';
    }
    return out;
  }

  function renderSlots(playerForm, pcForm, winner){
    var pSparks = (winner==="player") ? spawnSparks() : "";
    var cSparks = (winner==="pc") ? spawnSparks() : "";
    els.playerSlot.innerHTML = '<span class="slot-label">YOU</span>'+
      '<div class="battle-card animate-in'+(playerForm.isMega ? ' is-mega':'')+'">'+cardMarkup(playerForm,"p")+'</div>'+pSparks;
    els.pcSlot.innerHTML = '<span class="slot-label">ARENA</span>'+
      '<div class="battle-card animate-in'+(pcForm.isMega ? ' is-mega':'')+'">'+cardMarkup(pcForm,"c")+'</div>'+cSparks;
    els.playerSlot.classList.toggle("mega-active", playerForm.isMega);
    els.pcSlot.classList.toggle("mega-active", pcForm.isMega);
  }

  function renderStage(){
    if (state.animating && state.displayForms){
      renderSlots(state.displayForms.player, state.displayForms.pc, null);
      els.resultPanel.classList.remove("show");
      return;
    }

    var last = state.history[state.history.length-1];
    var showingResult = state.awaitingContinue && last && last.round === state.round;

    if (!showingResult){
      els.playerSlot.innerHTML = '<span class="slot-label">YOU</span><div class="slot-empty">Choose a card from your hand below</div>';
      els.pcSlot.innerHTML = '<span class="slot-label">ARENA</span><div class="slot-empty">Waiting for your move…</div>';
      els.playerSlot.classList.remove("mega-active");
      els.pcSlot.classList.remove("mega-active");
      els.resultPanel.classList.remove("show");
      return;
    }

    renderSlots(last.playerForm, last.pcForm, last.winner);

    var headline, cls;
    if (last.winner==="player"){ headline="You win this round"; cls="player"; }
    else { headline="The arena wins this round"; cls="pc"; }

    els.resultHeadline.textContent = headline;
    els.resultHeadline.className = "result-headline "+cls;

    var maxRef = 4;
    var pPct = Math.min(100, (last.effP/maxRef)*100);
    var cPct = Math.min(100, (last.effC/maxRef)*100);
    els.meterRows.innerHTML =
      '<div class="meter-row"><span class="meter-label">You</span><div class="meter-track"><div class="meter-fill player" style="width:'+pPct+'%"></div></div><span class="meter-num">×'+trimNum(last.effP)+'</span></div>'+
      '<div class="meter-row"><span class="meter-label">Arena</span><div class="meter-track"><div class="meter-fill pc" style="width:'+cPct+'%"></div></div><span class="meter-num">×'+trimNum(last.effC)+'</span></div>';

    els.resultDetail.textContent =
      last.playerForm.name+" — "+effLabel(last.effP)+" · "+
      last.pcForm.name+" — "+effLabel(last.effC);

    els.specialNotes.innerHTML = last.notes.map(function(n){
      return '<div class="special-note"><strong>Special:</strong> '+n+'</div>';
    }).join("");

    els.resultPanel.classList.add("show");
  }

  function trimNum(n){
    return (Math.round(n*100)/100).toString();
  }

  function renderHand(){
    els.hand.innerHTML = "";
    ROSTER.forEach(function(c){
      var used = state.playerHand.indexOf(c.id) === -1;
      var btn = document.createElement("button");
      btn.className = "hand-card";
      btn.type = "button";
      btn.disabled = used || state.awaitingContinue || state.animating || state.finished;
      btn.innerHTML =
        '<div class="hand-art">'+renderArt(c.img, c.art("h"+c.id), c.name)+'</div>'+
        '<div class="hand-name">'+c.name+'</div>'+
        (used ? '<div class="used-tag">PLAYED</div>' : '');
      btn.title = c.tagline;
      btn.addEventListener("click", function(){ playRound(c.id); });
      els.hand.appendChild(btn);
    });

    els.handHint.textContent = state.finished ? "Duel complete" :
      (state.animating ? "Round in motion…" :
      (state.awaitingContinue ? "Round resolved — continue to keep playing" : "Pick one card to play this round"));
  }

  function renderFinal(){
    if (!state.finished){
      els.finalOverlay.classList.remove("show");
      els.handWrap.style.display = "";
      return;
    }
    els.handWrap.style.display = "none";

    var headline, detail;
    if (state.playerWins > state.pcWins){ headline="You win the duel"; detail="You took "+state.playerWins+" of 3 rounds."; }
    else if (state.pcWins > state.playerWins){ headline="The arena wins the duel"; detail="It took "+state.pcWins+" of 3 rounds."; }
    else { headline="The duel is level"; detail="Both sides finished with the same round count."; }

    els.finalHeadline.textContent = headline;
    els.finalDetail.textContent = detail;
    els.finalRecap.innerHTML = state.history.map(function(r){
      var who = r.winner==="player" ? "You" : "Arena";
      return '<div class="recap-row"><span>Round '+r.round+': '+r.playerForm.name+' vs '+r.pcForm.name+'</span><span>'+who+'</span></div>';
    }).join("");

    els.finalOverlay.classList.add("show");
  }

  function render(){
    renderScoreboard();
    renderStage();
    renderHand();
    renderFinal();
  }

  /* ============================================================ */
  /* HERO ROSTER PREVIEW                                            */
  /* ============================================================ */
  function renderRosterPreview(){
    var wrap = document.getElementById("rosterPreview");
    wrap.innerHTML = ROSTER.map(function(c){
      return '<div class="roster-chip" title="'+c.name+'">'+renderArt(c.img, c.art("preview"+c.id), c.name)+'</div>';
    }).join("");
  }

  /* ============================================================ */
  /* EVENTS                                                         */
  /* ============================================================ */
  document.getElementById("enterArenaBtn").addEventListener("click", function(){
    document.getElementById("arena").scrollIntoView({behavior: reduceMotion ? "auto" : "smooth", block:"start"});
  });
  els.continueBtn.addEventListener("click", advanceRound);
  els.playAgainBtn.addEventListener("click", function(){
    state = freshState();
    render();
  });

  // Stand-alone preview: shows the Mega Evolution takeover on demand, without
  // needing to win the ~30% roll first. Bypasses the reduced-motion skip since
  // it's an explicit, opt-in look rather than an automatic game animation —
  // but it still respects reduced motion for the transition timings themselves
  // (the CSS reduced-motion rule still shortens them to near-instant).
  var previewBtn = document.getElementById("previewMegaBtn");
  if (previewBtn){
    previewBtn.addEventListener("click", function(){
      var pool = ROSTER.filter(function(c){ return c.canMega; });
      var base = pool[Math.floor(Math.random()*pool.length)];
      var form = base.megaForms ? base.megaForms[Math.floor(Math.random()*base.megaForms.length)] : base.mega;
      var battleForm = {
        base:base, name:form.name, types:form.types, power:form.power,
        art:form.art, img:form.img, move:form.move, moveEffect:form.moveEffect,
        theme:form.theme, isMega:true, lives:2
      };
      showMegaOverlay(battleForm, function(){});
    });
  }

  /* ============================================================ */
  /* INIT                                                           */
  /* ============================================================ */
  renderRosterPreview();
  state = freshState();
  render();

})();

</script>
</body>
</html>