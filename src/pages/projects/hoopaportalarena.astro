var youPanel = document.getElementById("you-panel");
var cpuPanel = document.getElementById("cpu-panel");
var arenaActions = document.getElementById("arena-actions");
var battleLog = document.getElementById("battle-log");
var roundTrack = document.getElementById("round-track");
var roundLabel = document.getElementById("round-label");
var resultScreen = document.getElementById("result-screen");

var state = null; // battle state object

function freshFighter(key, side){
  var base = POKEMON[key];
  return {
    key:key, side:side, name:base.name, title:base.title,
    baseTypes: base.types.slice(), types: base.types.slice(),
    maxHp: base.hp, hp: base.hp,
    img: base.img, cssFilter:"", halo:null,
    move: base.move,
    isMega:false, megaLabel:null, special:null,
    lives:0, livesMax:0,
    dotHeal:null, // {dot,heal}
    boostMult:1,
    paralyzedTurns:0,
    rechargeTurns:0,
    hasUsedZygardeRoll:false,
    tookDamage:false,
    clones:[],
    justMegaEvolved:false,
    moveUsage:{}, // {moveName: true} — once Mega Evolved, each of the two moves fires once per game
    pendingMove:null // move the player picked in the move-select UI, consumed by the next round
  };
}

function pickMegaConfig(fighter){
  var base = POKEMON[fighter.key];
  if(base.megaOptions){
    // raichu: 2 possible forms, pick one at random if any triggers
    var triggered = base.megaOptions.filter(function(m){ return Math.random() < m.chance; });
    if(triggered.length) return triggered[Math.floor(Math.random()*triggered.length)];
    return null;
  }
  if(base.mega){
    if(base.mega.chanceMode === "random"){
      return Math.random() < base.mega.chance ? base.mega : null;
    }
  }
  return null;
}

function applyMega(fighter, cfg){
  fighter.isMega = true;
  fighter.megaLabel = cfg.label;
  fighter.img = cfg.img;
  fighter.cssFilter = cfg.cssFilter || "";
  fighter.halo = cfg.halo || null;
  fighter.types = cfg.types.slice();
  fighter.lives = cfg.lives;
  fighter.livesMax = cfg.lives;
  fighter.special = cfg.special;
  fighter.justMegaEvolved = true;
}

function startBattle(playerKey){
  var pool = ROSTER_ORDER.filter(function(k){ return k !== playerKey; });
  var cpuKey = pool[Math.floor(Math.random()*pool.length)];

  var you = freshFighter(playerKey, "you");
  var cpu = freshFighter(cpuKey, "cpu");

  state = {
    you:you, cpu:cpu,
    round:0, // turn counter — the duel has no round cap, it runs until a knockout
    matchOver:false,
    resolving:false,
    log:[]
  };

  addLog("A portal ring snaps open. <b>"+you.name+"</b> faces off against <b>"+cpu.name+"</b>!");

  renderFighter(you, youPanel, "You");
  renderFighter(cpu, cpuPanel, "Rival");
  renderRoundTrack();
  renderActions();
  updateBattleTension();
  resultScreen.classList.remove("show");
}

function addLog(html){
  state.log.push(html);
