});

/* ============================= HERO PARTICLES ============================= */
(function(){
  var canvas = document.getElementById("hero-particles");
  var ctx = canvas.getContext("2d");
  var particles = [];
  var embers = [];
  var W,H,DPR;
  function resize(){
    DPR = Math.min(window.devicePixelRatio||1, 2);
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W*DPR; canvas.height = H*DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  window.addEventListener("resize", resize);
  resize();
  // richer hyperspace palette: gold ring, magenta/violet rift, cyan static, plus a soft lavender accent
  var colors = ["#f5c518","#e879f9","#22d3ee","#a78bfa","#f472b6"];
  // three depth layers — far (small, slow, dim), mid, near (bigger, faster, brighter) — for real parallax
  var layers = [
    {count:34, radMin:60, radMax:130, sizeMin:0.5, sizeMax:1.4, speedMin:0.06, speedMax:0.18, alpha:0.5, blur:2},
    {count:26, radMin:90, radMax:190, sizeMin:1.1, sizeMax:2.2, speedMin:0.14, speedMax:0.32, alpha:0.75, blur:5},
    {count:14, radMin:120, radMax:230, sizeMin:1.8, sizeMax:3.2, speedMin:0.22, speedMax:0.46, alpha:0.95, blur:9}
  ];
  layers.forEach(function(layer, li){
    for(var i=0;i<layer.count;i++){
      var ang = Math.random()*Math.PI*2;
      var rad = layer.radMin + Math.random()*(layer.radMax-layer.radMin);
      particles.push({
        ang:ang, rad:rad, speed:(layer.speedMin+Math.random()*(layer.speedMax-layer.speedMin))*(Math.random()<0.5?1:-1),
        size:layer.sizeMin+Math.random()*(layer.sizeMax-layer.sizeMin),
        color:colors[Math.floor(Math.random()*colors.length)],
        baseAlpha:layer.alpha, blur:layer.blur,
        tw: Math.random()*Math.PI*2, twSpeed: 0.015+Math.random()*0.03,
        layer: li
      });
    }
  });
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hue = 0;

  function spawnEmber(cx,cy){
    var ang = Math.random()*Math.PI*2;
    embers.push({
      x: cx+Math.cos(ang)*30, y: cy+Math.sin(ang)*30*0.94,
      vx: Math.cos(ang)*(0.25+Math.random()*0.35), vy: Math.sin(ang)*(0.25+Math.random()*0.35)*0.94,
      size: 1+Math.random()*1.6, life: 0, maxLife: 90+Math.random()*60,
      color: colors[Math.floor(Math.random()*colors.length)]
    });
  }

  function frame(t){
    ctx.clearRect(0,0,W,H);
    var cx=W/2, cy=H/2;

    // slow-shifting nebula wash behind everything, for painterly color depth
    if(!reduced) hue += 0.05;
    var g = ctx.createRadialGradient(cx,cy,10,cx,cy,Math.max(W,H)*0.55);
    g.addColorStop(0, "hsla("+(320+Math.sin(hue*0.01)*20)+",85%,62%,0.10)");
    g.addColorStop(0.55, "hsla("+(260+Math.sin(hue*0.008)*30)+",80%,55%,0.05)");
    g.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = g;
    ctx.fillRect(0,0,W,H);

    particles.forEach(function(p){
      if(!reduced){ p.ang += p.speed*0.01; p.tw += p.twSpeed; }
      var x = cx + Math.cos(p.ang)*p.rad;
      var y = cy + Math.sin(p.ang)*p.rad*0.94;
      p._x = x; p._y = y;
      var tw = 0.5 + Math.sin(p.tw)*0.4;
      ctx.save();
      ctx.shadowColor = p.color;
      ctx.shadowBlur = p.blur;
      ctx.beginPath();
      ctx.arc(x,y,p.size,0,Math.PI*2);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = Math.max(0.12, tw*p.baseAlpha);
      ctx.fill();
      ctx.restore();
    });

    // faint drifting embers that occasionally spark off the ring for extra life
    if(!reduced && Math.random() < 0.045 && embers.length < 24) spawnEmber(cx,cy);
    ctx.save();
    for(var e=embers.length-1; e>=0; e--){
      var em = embers[e];
      em.life++;
      if(!reduced){ em.x += em.vx; em.y += em.vy; }
      var lp = em.life/em.maxLife;
      if(lp >= 1){ embers.splice(e,1); continue; }
      ctx.shadowColor = em.color; ctx.shadowBlur = 6;
      ctx.beginPath();
      ctx.arc(em.x, em.y, em.size*(1-lp*0.5), 0, Math.PI*2);
      ctx.fillStyle = em.color;
      ctx.globalAlpha = (1-lp)*0.6;
      ctx.fill();
    }
    ctx.restore();

    // faint constellation lines between nearby particles (skipped for the dim far layer to reduce clutter)
    ctx.lineWidth = 0.6;
    for(var a=0;a<particles.length;a++){
      if(particles[a].layer===0) continue;
      for(var b=a+1;b<particles.length;b++){
        if(particles[b].layer===0) continue;
        var dx = particles[a]._x-particles[b]._x, dy = particles[a]._y-particles[b]._y;
        var d = Math.sqrt(dx*dx+dy*dy);
        if(d < 46){
          ctx.strokeStyle = particles[a].color;
          ctx.globalAlpha = (1-d/46)*0.18;
          ctx.beginPath();
          ctx.moveTo(particles[a]._x, particles[a]._y);
          ctx.lineTo(particles[b]._x, particles[b]._y);
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

/* ============================= CONFETTI ============================= */
function launchConfetti(){
  var canvas = document.getElementById("confetti");
  var ctx = canvas.getContext("2d");
  var DPR = Math.min(window.devicePixelRatio||1,2);
  function size(){
    canvas.width = canvas.clientWidth*DPR;
    canvas.height = canvas.clientHeight*DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  size();
  var W = canvas.clientWidth, H = canvas.clientHeight;
  var colors = ["#f5c518","#e879f9","#22d3ee","#34d399","#fb7185"];
  var pieces = [];
  for(var i=0;i<130;i++){
    pieces.push({
      x: Math.random()*W, y: -20-Math.random()*H*0.6,
      vx:(Math.random()-0.5)*2.2, vy: 1.8+Math.random()*3.2,
      size: 3.5+Math.random()*5.5, rot: Math.random()*Math.PI, vr:(Math.random()-0.5)*0.32,
      color: colors[Math.floor(Math.random()*colors.length)],
      shape: Math.random()<0.35 ? "circle" : "rect"
    });
  }
  // a few expanding gold rings from center for extra sparkle
  var rings = [];
  for(var r=0;r<3;r++){ rings.push({delay:r*140, start:null}); }
  var frames = 0;
  function step(ts){
    ctx.clearRect(0,0,W,H);
    pieces.forEach(function(p){
      p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.vy+=0.01;
      ctx.save();
      ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      if(p.shape==="circle"){
        ctx.beginPath(); ctx.arc(0,0,p.size*0.55,0,Math.PI*2); ctx.fill();
      } else {
        ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6);
      }
      ctx.restore();
    });
    rings.forEach(function(rg){
      if(frames < rg.delay/16.7) return;
      if(rg.start===null) rg.start = frames;
      var lp = Math.min(1,(frames-rg.start)/40);
      if(lp>=1) return;
      ctx.beginPath();
      ctx.arc(W/2, H*0.38, 14+lp*120, 0, Math.PI*2);
      ctx.strokeStyle = "#f5c518";
      ctx.globalAlpha = (1-lp)*0.5;
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.globalAlpha = 1;
    });
    frames++;
    if(frames < 220) requestAnimationFrame(step);
    else ctx.clearRect(0,0,W,H);
  }
  requestAnimationFrame(step);
}

/* ============================= BATTLE THEME (original Web Audio composition) =============================
   An original cloud-trap battle theme — not a recording or transcription of any existing game's score —
   synthesized live so no audio asset needs to ship with the page. Half-time trap drums (a long, pitch-slid
   808, a backbeat clap, swung hats with the odd triplet roll) sit under a reverb-tailed lead and a
   slow-breathing pad. The arrangement alternates every 4 bars between a sparse "cloud" verse (airy bell
   lead) and a harder trap "drop" (punchier pluck lead, denser hats, doubled 808/clap), and nothing loops
   verbatim: the melody and hi-hats are regenerated fresh every bar from a scale + rhythm-slot pool, and
   the chords walk an 8-bar progression before repeating. A fixed 5-note "portal ring" hook — echoing
   Hoopa's rings rather than being generated — resurfaces once per progression cycle so the theme keeps a
   recognizable identity tied to the game instead of reading as generic drifting texture. Toggled by the
   nav button; a short pitched-up run "stings" over the top whenever a Pokémon Mega Evolves. */
var musicCtx = null, musicMaster = null, musicPlaying = false, musicScheduler = null;
var musicNextNoteTime = 0, musicStep = 0, musicNoiseBuffer = null;
var musicDelay = null, musicDelayFilter = null, musicDelayFeedback = null;
var musicBarSeed = -1, musicBarPlan = null;
var musicMasterFilter = null, music808Shaper = null;
var musicDuck = null;
var musicPortalCycle = 0;
var sfxMaster = null;
// battle tension: flips true whenever either fighter is critically low on HP, forcing the beat into
// its most intense pocket and layering a low heartbeat thump under it, regardless of where the normal
// cloud/drop cycle happens to be
var musicTension = false;
function setMusicTension(on){ musicTension = !!on; }
var MUSIC_BPM = 138; // fast clock, but the drum pattern below is felt in half-time — classic cloud-rap pocket
var MUSIC_ROOT = 146.83; // D3 — low and dreamy
// 8-bar chord progression (semitone offsets from the root) — twice the old length so the harmony
// takes longer to double back on itself; the cloud/drop sections below still alternate every 4 bars,
// but now land on a different half of the progression each time they repeat
var MUSIC_CHORDS = [[0,3,7,10],[10,2,5,9],[8,0,3,7],[5,8,0,3],[3,7,10,2],[0,5,8,0],[7,10,2,5],[5,8,0,3]];
// the scale the generative bell melody draws from each bar (D dorian — a little brighter than natural minor)
var MUSIC_SCALE = [0,2,3,5,7,9,10,12];
// candidate 16th-note slots a melody note may land on — deliberately sparse & syncopated, not four-on-the-floor
var MUSIC_MELODY_SLOTS = [0,3,6,7,10,13,14];
// a short ring-shaped hook (up a third, up a fourth, octave, back to the fifth) meant to echo Hoopa's
// portal rings — the one bit of the score that isn't generated fresh each bar, so it reads as the
// theme's actual signature/hook rather than just generative texture
var MUSIC_PORTAL_MOTIF = [0,3,7,12,7];
// an alternate contour of the same hook (fifth-first instead of third-first) — the ring motif still
// reads as the same idea, it just doesn't play back note-for-note identical every single cycle
var MUSIC_PORTAL_MOTIF_ALT = [0,7,10,12,15];

function musicFreq(semi){ return MUSIC_ROOT * Math.pow(2, semi/12); }
function musicRandInt(n){ return Math.floor(Math.random()*n); }

function musicEnsureCtx(){
  if(musicCtx) return;
  musicCtx = new (window.AudioContext||window.webkitAudioContext)();
  musicMaster = musicCtx.createGain();
  musicMaster.gain.value = 0.0001;
  // a filter that actually sweeps with the arrangement — muffled/dreamy through the "cloud" verses,
  // thrown wide open on the "drop" — the classic trap/cloud-rap filter-sweep move, and it's what makes
  // the drop *feel* like it lands instead of just getting louder
  musicMasterFilter = musicCtx.createBiquadFilter();
  musicMasterFilter.type = "lowpass"; musicMasterFilter.frequency.value = 3400; musicMasterFilter.Q.value = 0.7;
  musicMaster.connect(musicMasterFilter); musicMasterFilter.connect(musicCtx.destination);

  // sidechain-style "pump": every kick/808 hit ducks this bus for a beat, then lets it spring back —
  // everything EXCEPT the kick/808 themselves routes through it, so the low end punches through instead
  // of just adding volume, the way a real trap beat breathes around its kick
  musicDuck = musicCtx.createGain();
  musicDuck.gain.value = 1;
  musicDuck.connect(musicMaster);

  // gentle saturation on the sub, so the 808/kick have trap-style grit instead of a plain clean sine
  music808Shaper = musicCtx.createWaveShaper();
  var curve = new Float32Array(256);
  for(var ci=0; ci<256; ci++){ var xi = (ci/255)*2-1; curve[ci] = Math.tanh(xi*2.2); }
  music808Shaper.curve = curve; music808Shaper.oversample = "2x";
  music808Shaper.connect(musicMaster); // unducked — this IS the sidechain trigger, so it must punch through

  // a dub-style feedback delay gives the bell lead its "cloud" trailing echo
  musicDelay = musicCtx.createDelay(1.2);
  musicDelay.delayTime.value = (60/MUSIC_BPM)*0.75;
  musicDelayFilter = musicCtx.createBiquadFilter();
  musicDelayFilter.type = "lowpass"; musicDelayFilter.frequency.value = 2200;
  musicDelayFeedback = musicCtx.createGain(); musicDelayFeedback.gain.value = 0.42;
  musicDelay.connect(musicDelayFilter);
  musicDelayFilter.connect(musicDelayFeedback);
  musicDelayFeedback.connect(musicDelay);
  musicDelayFilter.connect(musicDuck);

  musicNoiseBuffer = musicCtx.createBuffer(1, musicCtx.sampleRate*0.4, musicCtx.sampleRate);
  var data = musicNoiseBuffer.getChannelData(0);
  for(var i=0;i<data.length;i++){ data[i] = Math.random()*2-1; }

  // attack sound effects get their own bus, straight to the speakers (no lowpass/delay coloring),
  // so hits stay crisp and punchy whether or not the background theme is even playing
  sfxMaster = musicCtx.createGain();
  sfxMaster.gain.value = 0.6;
  sfxMaster.connect(musicCtx.destination);
}

// airy bell/pluck lead — replaces the old violin voice with something softer and more "cloud"
function musicPlayBell(time, freqHz, dur, vel){
  var osc = musicCtx.createOscillator();
  osc.type = "sine";
  osc.frequency.setValueAtTime(freqHz, time);
  var osc2 = musicCtx.createOscillator();
  osc2.type = "triangle";
  osc2.frequency.setValueAtTime(freqHz*2.01, time); // slightly detuned octave partial for a bell shimmer
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(vel, time+0.012);
  g.gain.exponentialRampToValueAtTime(Math.max(0.0008,vel*0.001), time+dur);
  var g2 = musicCtx.createGain();
  g2.gain.setValueAtTime(0.0001, time);
  g2.gain.linearRampToValueAtTime(vel*0.22, time+0.01);
  g2.gain.exponentialRampToValueAtTime(0.0005, time+dur*0.6);
  osc.connect(g); osc2.connect(g2);
  g.connect(musicDuck); g2.connect(musicDuck);
  g.connect(musicDelay); // send to the cloud delay
  osc.start(time); osc2.start(time);
  osc.stop(time+dur+0.1); osc2.stop(time+dur+0.1);
}

// a punchier, more percussive pluck — the drop section's lead voice, for real timbral contrast against
// the airy cloud bells instead of just playing the same instrument louder
function musicPlayPluck(time, freqHz, dur, vel){
  var osc = musicCtx.createOscillator();
  osc.type = "sawtooth";
  osc.frequency.setValueAtTime(freqHz, time);
  var filt = musicCtx.createBiquadFilter();
  filt.type = "lowpass";
  filt.frequency.setValueAtTime(freqHz*7, time);
  filt.frequency.exponentialRampToValueAtTime(freqHz*1.4, time+dur*0.7);
  filt.Q.value = 1.4;
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(vel, time+0.006);
  g.gain.exponentialRampToValueAtTime(Math.max(0.0008,vel*0.02), time+dur);
  osc.connect(filt); filt.connect(g);
  g.connect(musicDuck); g.connect(musicDelay);
  osc.start(time); osc.stop(time+dur+0.08);
}

// Hoopa's portal-ring hook — a fixed, recognizable 5-note figure (not generative like the rest of the
// score) that surfaces every so often so the theme has an actual signature tying it back to the game,
// rather than reading as generic drifting trap texture the whole way through
function musicPlayPortalMotif(time, rootSemi){
  // alternates contour each cycle, and transposes into whatever chord is currently under it, so the
  // hook feels woven into the harmony instead of always chiming the same fixed pitches on top of it
  var motif = (musicPortalCycle % 2 === 0) ? MUSIC_PORTAL_MOTIF : MUSIC_PORTAL_MOTIF_ALT;
  musicPortalCycle++;
  var transpose = rootSemi || 0;
  motif.forEach(function(semi, i){
    musicPlayBell(time + i*0.11, musicFreq(semi+24+transpose), 0.5, 0.15 - i*0.012);
  });
  musicPortalWhoosh(time);
}

// a soft rising bandpass sweep timed under the portal-ring hook — a "portal tearing open" swell that
// ties the sound directly back to Hoopa's rings rather than reading as an arbitrary music sting
function musicPortalWhoosh(time){
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer;
  var filt = musicCtx.createBiquadFilter();
  filt.type = "bandpass"; filt.Q.value = 1.1;
  filt.frequency.setValueAtTime(260, time);
  filt.frequency.exponentialRampToValueAtTime(2400, time+0.85);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(0.1, time+0.25);
  g.gain.linearRampToValueAtTime(0.0001, time+0.85);
  src.connect(filt); filt.connect(g); g.connect(musicDuck); g.connect(musicDelay);
  src.start(time); src.stop(time+0.9);
}

function musicPlayPad(time, semis, dur){
  semis.forEach(function(s, si){
    var osc = musicCtx.createOscillator();
    osc.type = "triangle";
    osc.frequency.setValueAtTime(musicFreq(s-12), time);
    var lfo = musicCtx.createOscillator();
    lfo.type = "sine"; lfo.frequency.value = 0.12 + Math.random()*0.08;
    var lfoGain = musicCtx.createGain(); lfoGain.gain.value = 3;
    lfo.connect(lfoGain); lfoGain.connect(osc.frequency);
    var g = musicCtx.createGain();
    g.gain.setValueAtTime(0.0001, time);
    g.gain.linearRampToValueAtTime(0.045, time+0.9);
    g.gain.linearRampToValueAtTime(0.0001, time+dur);
    // a slow stereo drift on each pad voice so the chord breathes wide instead of sitting dead-center —
    // adds spaciousness/immersion without touching the melody or drums
    var pan = musicCtx.createStereoPanner ? musicCtx.createStereoPanner() : null;
    var panLfo = musicCtx.createOscillator();
    panLfo.type = "sine"; panLfo.frequency.value = 0.05 + Math.random()*0.04;
    var panLfoGain = musicCtx.createGain(); panLfoGain.gain.value = 0.5;
    panLfo.connect(panLfoGain);
    osc.connect(g);
    if(pan){ pan.pan.value = (si%2===0?-1:1)*0.18; panLfoGain.connect(pan.pan); g.connect(pan); pan.connect(musicDuck); }
    else { g.connect(musicDuck); }
    osc.start(time); lfo.start(time); panLfo.start(time);
    osc.stop(time+dur+0.05); lfo.stop(time+dur+0.05); panLfo.stop(time+dur+0.05);
  });
}

// a long, pitch-slid sub — the 808 heartbeat of the beat
function music808(time, semi, dur){
  var osc = musicCtx.createOscillator();
  osc.type = "sine";
  var f0 = musicFreq(semi-24);
  osc.frequency.setValueAtTime(f0*1.9, time);
  osc.frequency.exponentialRampToValueAtTime(f0, time+0.09);
  osc.frequency.exponentialRampToValueAtTime(f0*0.72, time+dur);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(0.5, time+0.02);
  g.gain.exponentialRampToValueAtTime(0.001, time+dur);
  osc.connect(g); g.connect(music808Shaper);
  osc.start(time); osc.stop(time+dur+0.05);
}

// a short, punchy kick transient layered alongside (or standing in for) the 808 — the 808 carries the
// pitched sustain, this carries the *thump*, the way a real trap beat separates the two so the drop
// actually hits instead of just humming a bassline
function musicKick(time, vel){
  var osc = musicCtx.createOscillator();
  osc.type = "sine";
  osc.frequency.setValueAtTime(155, time);
  osc.frequency.exponentialRampToValueAtTime(46, time+0.1);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(vel, time+0.005);
  g.gain.exponentialRampToValueAtTime(0.001, time+0.15);
  osc.connect(g); g.connect(music808Shaper);
  osc.start(time); osc.stop(time+0.17);
  // a short click transient on the attack gives it a percussive edge instead of a pure soft thump
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer;
  var filt = musicCtx.createBiquadFilter();
  filt.type = "bandpass"; filt.frequency.value = 1700; filt.Q.value = 0.7;
  var cg = musicCtx.createGain();
  cg.gain.setValueAtTime(vel*0.45, time);
  cg.gain.exponentialRampToValueAtTime(0.001, time+0.025);
  src.connect(filt); filt.connect(cg); cg.connect(music808Shaper);
  src.start(time); src.stop(time+0.03);
}

// the sidechain "pump" itself — ducks everything except the kick/808 bus for a beat, then springs
// back, so the low end always reads as the loudest, most physical thing in the mix right as it lands
function musicDuckHit(time, amount, releaseDur){
  var g = musicDuck.gain;
  g.cancelScheduledValues(time);
  g.setValueAtTime(1, time);
  g.linearRampToValueAtTime(Math.max(0.05, 1-amount), time+0.018);
  g.linearRampToValueAtTime(1, time+releaseDur);
}

function musicPlayClap(time){
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer;
  var filt = musicCtx.createBiquadFilter();
  filt.type = "bandpass"; filt.frequency.value = 1500; filt.Q.value = 0.9;
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(0.32, time+0.008);
  g.gain.exponentialRampToValueAtTime(0.001, time+0.16);
  src.connect(filt); filt.connect(g); g.connect(musicDuck);
  src.start(time); src.stop(time+0.18);
  // a brighter, shorter "snap" layer on top of the main clap body — the two together read as a fuller
  // trap snare instead of a single flat noise hit
  var src2 = musicCtx.createBufferSource();
  src2.buffer = musicNoiseBuffer;
  var filt2 = musicCtx.createBiquadFilter();
  filt2.type = "highpass"; filt2.frequency.value = 4200;
  var g2 = musicCtx.createGain();
  g2.gain.setValueAtTime(0.0001, time+0.004);
  g2.gain.linearRampToValueAtTime(0.22, time+0.012);
  g2.gain.exponentialRampToValueAtTime(0.001, time+0.07);
  src2.connect(filt2); filt2.connect(g2); g2.connect(musicDuck);
  src2.start(time); src2.stop(time+0.08);
}

function musicPlayHat(time, vel, open){
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer;
  var filt = musicCtx.createBiquadFilter();
  filt.type = "highpass"; filt.frequency.value = 7500;
  var g = musicCtx.createGain();
  var dur = open ? 0.16 : 0.045;
  g.gain.setValueAtTime(vel, time);
  g.gain.exponentialRampToValueAtTime(0.001, time+dur);
  src.connect(filt); filt.connect(g); g.connect(musicDuck);
  src.start(time); src.stop(time+dur+0.02);
}

// a short metallic rimshot accent — a sparse extra percussion layer that only shows up in the busier
// "drop" sections, so the groove there feels genuinely more intricate, not just louder
function musicPlayRim(time, vel){
  var osc = musicCtx.createOscillator();
  osc.type = "square";
  osc.frequency.setValueAtTime(1900, time);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(vel, time);
  g.gain.exponentialRampToValueAtTime(0.001, time+0.045);
  osc.connect(g); g.connect(musicDuck);
  osc.start(time); osc.stop(time+0.05);
}

// a rising noise sweep that builds across the last bar of a "cloud" block, right before the beat drops
function musicRiser(time, dur){
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer; src.loop = true;
  var filt = musicCtx.createBiquadFilter();
  filt.type = "bandpass"; filt.Q.value = 0.9;
  filt.frequency.setValueAtTime(280, time);
  filt.frequency.exponentialRampToValueAtTime(6200, time+dur);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(0.15, time+dur*0.92);
  g.gain.linearRampToValueAtTime(0.0001, time+dur);
  src.connect(filt); filt.connect(g); g.connect(musicMaster);
  src.start(time); src.stop(time+dur+0.05);
}

// the arrangement alternates every 4 bars between a sparse "cloud" verse and a busier trap "drop" —
// same generative approach (nothing hand-looped), but the drop is denser: more hats, a second clap,
// a doubled 808, and a bigger melody, so the beat actually feels like it drops instead of just humming along
function musicPlanBar(barIdx){
  var section = (Math.floor(barIdx/4) % 2 === 0) ? "cloud" : "drop";
  // a fighter on the ropes forces the beat into its most intense pocket immediately, instead of
  // waiting out the normal 4-bar cloud/drop cycle
  if(musicTension) section = "drop";
  var plan = { hats:[], melody:[], section:section, voice: section==="drop" ? "pluck" : "bell", tense: musicTension };
  var hatChance = section==="drop" ? 0.5 : 0.22;
  var hatBaseVel = section==="drop" ? 0.07 : 0.05;
  for(var s=0; s<16; s++){
    if(s%2===0 || Math.random()<hatChance){
      var open = (s===14 && Math.random()<0.4);
      plan.hats.push({step:s, vel:hatBaseVel+Math.random()*0.08, open:open});
    }
  }
  // trap-staple triplet roll into the next bar's downbeat — more likely once the drop kicks in
  if(Math.random() < (section==="drop" ? 0.55 : 0.3)){
    plan.hats.push({step:15, vel:0.05, open:false});
    plan.hats.push({step:15.33, vel:0.045, open:false});
    plan.hats.push({step:15.66, vel:0.04, open:false});
  }
  var noteCount = (section==="drop" ? 3+musicRandInt(3) : 2+musicRandInt(3));
  var usedSlots = MUSIC_MELODY_SLOTS.slice();
  for(var n=0; n<noteCount && usedSlots.length; n++){
    var pick = musicRandInt(usedSlots.length);
    var slot = usedSlots.splice(pick,1)[0];
    var degree = MUSIC_SCALE[musicRandInt(MUSIC_SCALE.length)];
    plan.melody.push({step:slot, semi:degree+12, len: 1.4+Math.random()*1.8, vel: 0.16+Math.random()*0.1});
  }
  // sparse metallic rim accents, only in the drop — gives the busier section a genuinely more
  // intricate groove instead of just piling on more of the same hats
  plan.rims = [];
  if(section==="drop"){
    [2,5,9,13].forEach(function(s){
      if(Math.random()<0.4) plan.rims.push({step:s, vel:0.09+Math.random()*0.05});
    });
  }
  return plan;
}

function musicScheduleStep(){
  var sixteenth = (60/MUSIC_BPM)/4;
  while(musicNextNoteTime < musicCtx.currentTime + 0.12){
    var barIdx = Math.floor(musicStep/16);
    var idx = musicStep % 16;
    if(barIdx !== musicBarSeed){
      musicBarSeed = barIdx;
      musicBarPlan = musicPlanBar(barIdx);
      var chordIdx = barIdx % MUSIC_CHORDS.length;
      musicPlayPad(musicNextNoteTime, MUSIC_CHORDS[chordIdx], sixteenth*16*1.05);
      // a riser through the last "cloud" bar announces the drop landing on the next 4-bar block
      if(musicBarPlan.section==="cloud" && barIdx%4===3){
        musicRiser(musicNextNoteTime, sixteenth*16);
      }
      var targetGain = musicBarPlan.section==="drop" ? 0.62 : 0.48;
      musicMaster.gain.cancelScheduledValues(musicNextNoteTime);
      musicMaster.gain.setValueAtTime(musicMaster.gain.value, musicNextNoteTime);
      musicMaster.gain.linearRampToValueAtTime(targetGain, musicNextNoteTime+0.35);
      // the master lowpass actually sweeps open on the drop and closes back down on the cloud verse —
      // this is most of what makes the arrangement *feel* dynamic bar to bar rather than just generative noodling
      var targetCutoff = musicBarPlan.section==="drop" ? 9500 : 3400;
      musicMasterFilter.frequency.cancelScheduledValues(musicNextNoteTime);
      musicMasterFilter.frequency.setValueAtTime(musicMasterFilter.frequency.value, musicNextNoteTime);
      musicMasterFilter.frequency.linearRampToValueAtTime(targetCutoff, musicNextNoteTime+0.5);
      // Hoopa's portal-ring hook resurfaces once per 8-bar progression cycle, so the theme keeps a
      // recognizable signature even as everything generative around it keeps shifting; transposed into
      // whatever chord opens that cycle so it lands as part of the harmony, not a fixed sample on top
      if(barIdx % 8 === 0){
        musicPlayPortalMotif(musicNextNoteTime + sixteenth*2, MUSIC_CHORDS[chordIdx][0]);
        // the filter sweep opens early through the motif itself, riding along with the whoosh
        musicMasterFilter.frequency.setValueAtTime(musicMasterFilter.frequency.value, musicNextNoteTime);
        musicMasterFilter.frequency.linearRampToValueAtTime(Math.max(targetCutoff,7000), musicNextNoteTime+0.9);
        musicMasterFilter.frequency.linearRampToValueAtTime(targetCutoff, musicNextNoteTime+sixteenth*16);
      }
    }
    var bassHere = (idx === 0) || (idx===10 && Math.random()<0.3) || (musicBarPlan.section==="drop" && idx===6);
    if(bassHere){
      var rootSemi = MUSIC_CHORDS[barIdx % MUSIC_CHORDS.length][0];
      var isDownbeat = (idx===0);
      music808(musicNextNoteTime, rootSemi, sixteenth*(isDownbeat?15:6));
      // the kick lands right with the 808 for a real transient, and pumps the rest of the mix out of
      // its way for a beat — this pairing is most of what makes the beat feel physically powerful
      musicKick(musicNextNoteTime, isDownbeat?0.95:0.72);
      musicDuckHit(musicNextNoteTime, isDownbeat?0.5:0.3, isDownbeat?0.36:0.22);
    }
    // in the drop, a four-on-the-floor kick fills in under the half-time 808 on the beats that didn't
    // already get one — the sub stays sparse and melodic, but the kick keeps driving every beat
    if(musicBarPlan.section==="drop" && !bassHere && (idx===4 || idx===8 || idx===12)){
      musicKick(musicNextNoteTime, 0.7);
      musicDuckHit(musicNextNoteTime, 0.26, 0.2);
    }
    // heartbeat: a quick low lub-dub layered in only while a fighter is critically low, so the danger
    // is felt physically in the beat, not just read off an HP bar
    if(musicBarPlan.tense && idx===2){
      musicKick(musicNextNoteTime, 0.55);
      musicDuckHit(musicNextNoteTime, 0.2, 0.14);
    }
    if(musicBarPlan.tense && idx===3){
      musicKick(musicNextNoteTime, 0.4);
      musicDuckHit(musicNextNoteTime, 0.14, 0.1);
    }
    if(idx === 8) musicPlayClap(musicNextNoteTime);
    if(musicBarPlan.section==="drop" && idx===4) musicPlayClap(musicNextNoteTime);
    musicBarPlan.hats.forEach(function(h){
      if(Math.floor(h.step)===idx){
        var frac = h.step - Math.floor(h.step);
        musicPlayHat(musicNextNoteTime + frac*sixteenth, h.vel, h.open);
      }
    });
    if(musicBarPlan.rims) musicBarPlan.rims.forEach(function(r){
      if(Math.floor(r.step)===idx){
        var rfrac = r.step - Math.floor(r.step);
        musicPlayRim(musicNextNoteTime + rfrac*sixteenth, r.vel);
      }
    });
    musicBarPlan.melody.forEach(function(m){
      if(m.step===idx){
        if(musicBarPlan.voice==="pluck") musicPlayPluck(musicNextNoteTime, musicFreq(m.semi), sixteenth*m.len, m.vel*1.3);
        else musicPlayBell(musicNextNoteTime, musicFreq(m.semi), sixteenth*m.len, m.vel);
      }
    });
    musicNextNoteTime += sixteenth;
    musicStep++;
  }
}

function musicStart(){
  musicEnsureCtx();
  if(musicCtx.state === "suspended") musicCtx.resume();
  if(musicPlaying) return;
  musicPlaying = true;
  musicStep = 0;
  musicBarSeed = -1;
  musicNextNoteTime = musicCtx.currentTime + 0.08;
  musicMaster.gain.cancelScheduledValues(musicCtx.currentTime);
  musicMaster.gain.setValueAtTime(musicMaster.gain.value, musicCtx.currentTime);
  musicMaster.gain.linearRampToValueAtTime(0.55, musicCtx.currentTime+1.6);
  musicScheduler = setInterval(musicScheduleStep, 25);
  var btn = document.getElementById("music-toggle");
  if(btn){ btn.classList.add("playing"); btn.setAttribute("aria-pressed","true"); }
}

function musicStop(){
  if(!musicPlaying) return;
  musicPlaying = false;
  if(musicScheduler) clearInterval(musicScheduler);
  if(musicMaster && musicCtx){
    musicMaster.gain.cancelScheduledValues(musicCtx.currentTime);
    musicMaster.gain.setValueAtTime(musicMaster.gain.value, musicCtx.currentTime);
    musicMaster.gain.linearRampToValueAtTime(0.0001, musicCtx.currentTime+0.5);
  }
  var btn = document.getElementById("music-toggle");
  if(btn){ btn.classList.remove("playing"); btn.setAttribute("aria-pressed","false"); }
}

// a short, pitched-up bell run layered over the loop whenever a Pokémon Mega Evolves
function musicMegaSting(){
  if(!musicPlaying || !musicCtx) return;
  var run = [0,3,7,10,12,15,19];
  var t = musicCtx.currentTime + 0.05;
  run.forEach(function(semi, i){
    musicPlayBell(t + i*0.08, musicFreq(semi+12), 0.5, 0.22);
  });
}

(function(){
  var btn = document.getElementById("music-toggle");
  if(!btn) return;
  btn.addEventListener("click", function(){
    if(musicPlaying) musicStop(); else musicStart();
  });
})();

/* ============================= LIGHT / DARK PORTAL TOGGLE =============================
   Tapping Hoopa's ring in the nav flips the whole arena between the default hyperspace-dark theme
   and a brighter daylight palette. Where the browser supports the View Transitions API, the new
   theme is revealed through a circle that blooms outward from the ring itself — like a portal
   opening onto the other palette — rather than a plain instant swap or crossfade. */
(function(){
  var root = document.documentElement;
  var toggle = document.getElementById("theme-toggle");
  if(!toggle) return;

  var saved = null;
  try{ saved = localStorage.getItem("hoopa-theme"); }catch(e){}
  if(saved === "light") setThemeAttr("light");

  function setThemeAttr(theme){
    if(theme === "light") root.setAttribute("data-theme","light");
    else root.removeAttribute("data-theme");
    toggle.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
    toggle.setAttribute("title", theme === "light" ? "Tap Hoopa's ring to return to hyperspace night" : "Tap Hoopa's ring to shift the arena's light");
    try{ localStorage.setItem("hoopa-theme", theme); }catch(e){}
  }

  function ringCenter(){
    var r = toggle.getBoundingClientRect();
    return { x: r.left + r.width/2, y: r.top + r.height/2 };
  }

  function runToggle(){
    var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    toggle.classList.remove("bursting"); void toggle.offsetWidth; toggle.classList.add("bursting");
    setTimeout(function(){ toggle.classList.remove("bursting"); }, 800);
    try{ sfxThemePortal(next === "light"); }catch(e){}

    if(!document.startViewTransition || reduceMotion){
      setThemeAttr(next);
      return;
    }

    var c = ringCenter();
    var maxRadius = Math.hypot(
      Math.max(c.x, window.innerWidth - c.x),
      Math.max(c.y, window.innerHeight - c.y)
    );

    var transition = document.startViewTransition(function(){ setThemeAttr(next); });
    transition.ready.then(function(){
      root.animate(
        { clipPath: [
            "circle(0px at "+c.x+"px "+c.y+"px)",
            "circle("+maxRadius+"px at "+c.x+"px "+c.y+"px)"
          ] },
        { duration: 850, easing: "cubic-bezier(.22,.9,.2,1)", pseudoElement: "::view-transition-new(root)" }
      );
    }).catch(function(){});
  }

  toggle.addEventListener("click", runToggle);
})();

/* ============================= ATTACK SOUND EFFECTS =============================
   Every hit gets a synthesized sound keyed to its move's type (reusing the same type→family
   grouping the visual FX already use) and scaled by damage tier; Mega specials get a sound built
   for their specific effect instead. Runs on its own mix bus (sfxMaster) so hits stay audible even
   with the theme off, and lazily starts the shared audio context itself so it works the moment a
   duel begins, regardless of whether the music was ever toggled on. */
var SFX_TIER_MUL = {huge:1.3, medium:1, low:0.72};

function sfxPan(side){
  if(!musicCtx.createStereoPanner) return null;
  var p = musicCtx.createStereoPanner();
  p.pan.value = side==="you" ? -0.24 : side==="cpu" ? 0.24 : 0;
  return p;
}
function sfxOut(node, side){
  var pan = sfxPan(side);
  if(pan){ node.connect(pan); pan.connect(sfxMaster); }
  else node.connect(sfxMaster);
}
function sfxNoiseBurst(time, dur, filterType, freq, Q, peakVel, side){
  var src = musicCtx.createBufferSource();
  src.buffer = musicNoiseBuffer;
  var filt = musicCtx.createBiquadFilter();
  filt.type = filterType; filt.frequency.setValueAtTime(freq, time); if(Q) filt.Q.value = Q;
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(peakVel, time+0.008);
  g.gain.exponentialRampToValueAtTime(0.001, time+dur);
  src.connect(filt); filt.connect(g);
  sfxOut(g, side);
  src.start(time); src.stop(time+dur+0.05);
}
function sfxTone(time, freqStart, freqEnd, dur, waveType, peakVel, side){
  var osc = musicCtx.createOscillator();
  osc.type = waveType;
  osc.frequency.setValueAtTime(freqStart, time);
  if(freqEnd !== freqStart) osc.frequency.exponentialRampToValueAtTime(Math.max(20,freqEnd), time+dur);
  var g = musicCtx.createGain();
  g.gain.setValueAtTime(0.0001, time);
  g.gain.linearRampToValueAtTime(peakVel, time+0.01);
  g.gain.exponentialRampToValueAtTime(0.001, time+dur);
  osc.connect(g);
  sfxOut(g, side);
  osc.start(time); osc.stop(time+dur+0.05);
}

// a bright, unmistakable "critical hit" sting layered on top of whatever the move's own sfx just
// played — a quick ascending glassy ping plus a sparkle-noise tail, so a crit reads instantly as
// something extra rather than just a louder version of the normal hit
function sfxCritHit(side){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.02;
  sfxTone(t, 1200, 2000, 0.12, "square", 0.1, side);
  sfxTone(t+0.05, 1800, 2600, 0.16, "sine", 0.12, side);
  sfxNoiseBurst(t+0.03, 0.22, "highpass", 4200, 1.1, 0.09, side);
}

// one distinct sound per visual-FX "family" (the same grouping TYPE_FX already uses), so every
// type reads differently but related types (e.g. ice/rock/ground/steel's shared "shards" family)
// share a sonic identity, just like they share a visual one.
function playTypeSfx(type, side, tier){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.015;
  var m = SFX_TIER_MUL[tier] || 1;
  var fam = (TYPE_FX[type]||{}).fam || "rings";
  if(fam==="flame"){
    sfxNoiseBurst(t, 0.3*m, "bandpass", 1900, 0.8, 0.26*m, side);
    sfxTone(t, 240, 520, 0.26*m, "sawtooth", 0.14*m, side);
  } else if(fam==="splash"){
    sfxNoiseBurst(t, 0.24*m, "bandpass", 2600, 1.3, 0.22*m, side);
    sfxTone(t+0.02, 760, 240, 0.22*m, "sine", 0.15*m, side);
  } else if(fam==="lightning"){
    for(var i=0;i<4;i++){ sfxTone(t+i*0.025, 900+Math.random()*600, 130, 0.09, "square", 0.15*m, side); }
    sfxNoiseBurst(t, 0.12, "highpass", 4200, 0.7, 0.13*m, side);
  } else if(fam==="swirl"){
    sfxNoiseBurst(t, 0.22*m, "bandpass", 1200, 1.4, 0.19*m, side);
    sfxTone(t, 520, 300, 0.2*m, "triangle", 0.12*m, side);
  } else if(fam==="shards"){
    sfxNoiseBurst(t, 0.16*m, "highpass", 3200, 1, 0.2*m, side);
    sfxTone(t, 1500, 950, 0.13*m, "square", 0.1*m, side);
  } else if(fam==="gust"){
    sfxNoiseBurst(t, 0.32*m, "bandpass", 900, 0.6, 0.2*m, side);
  } else if(fam==="ripple"){
    sfxTone(t, 700, 1000, 0.3*m, "sine", 0.15*m, side);
    sfxTone(t+0.05, 1050, 750, 0.26*m, "sine", 0.1*m, side);
  } else if(fam==="beam"){
    sfxTone(t, 190, 95, 0.32*m, "sawtooth", 0.2*m, side);
    sfxNoiseBurst(t+0.05, 0.18*m, "lowpass", 800, 0.7, 0.13*m, side);
  } else if(fam==="void"){
    sfxTone(t, 260, 95, 0.38*m, "sine", 0.19*m, side);
    sfxNoiseBurst(t, 0.28*m, "lowpass", 500, 0.6, 0.11*m, side);
  } else if(fam==="sparkle"){
    for(var j=0;j<3;j++){ sfxTone(t+j*0.05, 1000+j*260, 1000+j*260, 0.16, "triangle", 0.13*m, side); }
  } else { // "rings" — normal/fighting: a plain, punchy thud+crack
    sfxNoiseBurst(t, 0.1*m, "bandpass", 700, 1, 0.2*m, side);
    sfxTone(t, 150, 90, 0.12*m, "sine", 0.18*m, side);
  }
}

// bespoke sounds for each Mega special's actual effect, rather than reusing a type family
function playSignatureSfx(effectKey, side){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.015;
  if(effectKey==="clone"){
    sfxNoiseBurst(t, 0.2, "bandpass", 2400, 1.3, 0.2, side);
    sfxNoiseBurst(t+0.09, 0.2, "bandpass", 2100, 1.3, 0.18, side);
  } else if(effectKey==="dot_heal"){
    sfxTone(t, 220, 70, 0.5, "sine", 0.2, side);
    sfxNoiseBurst(t, 0.4, "lowpass", 450, 0.6, 0.12, side);
  } else if(effectKey==="aoe_paralyze_recharge"){
    sfxTone(t, 90, 55, 0.5, "sawtooth", 0.28, side);
    for(var i=0;i<5;i++){ sfxTone(t+0.1+i*0.03, 1200+Math.random()*500, 200, 0.08, "square", 0.13, side); }
  } else if(effectKey==="power_surge"){
    sfxTone(t, 300, 900, 0.4, "sawtooth", 0.2, side);
  } else if(effectKey==="burst"){
    sfxNoiseBurst(t, 0.5, "lowpass", 1200, 0.5, 0.26, side);
    sfxTone(t, 400, 90, 0.5, "sine", 0.19, side);
  }
}

// the Void Curse's recurring upkeep tick — a low draining groan panned to whoever is losing HP, answered
// by a soft rising chime panned to whoever is gaining it, so the drain/heal is audible every single turn
// it's active, not just when Darkrai first casts it
function sfxVoidDrainTick(fromSide, toSide){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.015;
  sfxTone(t, 260, 110, 0.4, "sawtooth", 0.15, fromSide);
  sfxNoiseBurst(t, 0.32, "lowpass", 480, 0.6, 0.09, fromSide);
  sfxTone(t+0.14, 480, 740, 0.32, "sine", 0.15, toSide);
  sfxTone(t+0.18, 700, 960, 0.26, "triangle", 0.1, toSide);
}

/* ============================= UI SOUND EFFECTS =============================
   Small synthesized cues for interface actions — picking a Pokémon, confirming, choosing a move,
   opening/closing a duel — so the page has audio feedback even outside of combat. Reuses the same
   tone/noise-burst primitives as the attack SFX, on the same shared context and sfx bus. */
function sfxUiSelect(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.01;
  sfxTone(t, 720, 900, 0.09, "triangle", 0.14, null);
}
function sfxUiConfirm(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.01;
  sfxTone(t, 340, 780, 0.22, "sine", 0.18, null);
  sfxTone(t+0.04, 520, 1040, 0.2, "triangle", 0.12, null);
  sfxNoiseBurst(t, 0.16, "highpass", 3000, 0.8, 0.08, null);
}
function sfxUiMoveClick(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.01;
  sfxTone(t, 480, 520, 0.07, "square", 0.1, null);
}
function sfxUiVictory(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.05;
  [0,4,7,12,16].forEach(function(semi,i){
    musicPlayBell(t+i*0.09, MUSIC_ROOT*2*Math.pow(2,semi/12), 0.55, 0.22);
  });
}
function sfxUiDefeat(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.05;
  sfxTone(t, 300, 130, 0.55, "sawtooth", 0.2, null);
  sfxTone(t+0.12, 220, 90, 0.5, "sine", 0.16, null);
}
function sfxUiDraw(){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.05;
  sfxTone(t, 400, 260, 0.4, "triangle", 0.16, null);
  sfxTone(t+0.15, 400, 260, 0.4, "triangle", 0.14, null);
}
// tapping Hoopa's ring to flip the arena's light: a soft portal-tear whoosh with a small chiming
// flourish riding on top, echoing the same ring-motif intervals as the battle theme's hook so the
// gesture feels like part of the same world rather than a generic UI click
function sfxThemePortal(toLight){
  if(!musicCtx) musicEnsureCtx();
  var t = musicCtx.currentTime + 0.02;
  sfxNoiseBurst(t, 0.5, "bandpass", toLight?900:420, 1, 0.16, null);
  sfxTone(t, toLight?260:520, toLight?900:180, 0.55, "sine", 0.14, null);
  [0,3,7].forEach(function(semi,i){
    sfxTone(t+0.1+i*0.06, musicFreq((toLight?semi+12:semi+24)), musicFreq((toLight?semi+12:semi+24)), 0.28, "triangle", 0.1, null);
  });
}

/* ============================= INITIAL EMPTY ARENA STATE ============================= */
function renderEmptyPanel(panel, label){
  panel.innerHTML = '<div class="fighter-head"><span class="side-tag">'+label+'</span><h3>—</h3></div>'+
    '<div class="fighter-portrait" style="display:flex;align-items:center;justify-content:center;">'+
    '<span style="color:var(--text-faint);font-size:12px;">awaiting Pokémon</span></div>';
}
renderEmptyPanel(youPanel, "You");
renderEmptyPanel(cpuPanel, "Rival");

/* ============================= SCROLL REVEAL + NAV PROGRESS ============================= */
(function(){
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var revealEls = document.querySelectorAll(".reveal");
  if(reduced){
    revealEls.forEach(function(el){ el.classList.add("in"); });
  } else if("IntersectionObserver" in window){
    // stagger cards that share a parent grid/row
    var seenParents = new Map();
    revealEls.forEach(function(el){
      var parent = el.parentElement;
      var count = seenParents.get(parent) || 0;
      el.style.transitionDelay = Math.min(count*70, 420) + "ms";
      seenParents.set(parent, count+1);
    });
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add("in");
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.12, rootMargin:"0px 0px -8% 0px"});
    revealEls.forEach(function(el){ io.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add("in"); });
  }

  var portalStage = document.getElementById("portal-stage");
  var portalTilt = document.getElementById("portal-tilt");
  if(portalStage && portalTilt && !reduced && window.matchMedia && window.matchMedia("(hover: hover)").matches){
    portalStage.addEventListener("mousemove", function(e){
      var r = portalStage.getBoundingClientRect();
      var px = (e.clientX - r.left)/r.width - 0.5;
      var py = (e.clientY - r.top)/r.height - 0.5;
      portalTilt.style.transform = "rotateY("+(px*16)+"deg) rotateX("+(-py*16)+"deg)";
    });
    portalStage.addEventListener("mouseleave", function(){
      portalTilt.style.transform = "rotateY(0deg) rotateX(0deg)";
    });
  }

  var navProgress = document.getElementById("nav-progress");
  if(navProgress){
    var ticking = false;
    function updateProgress(){
      var doc = document.documentElement;
      var scrollTop = window.scrollY || doc.scrollTop;
      var height = doc.scrollHeight - doc.clientHeight;
      var pct = height>0 ? Math.min(100, Math.max(0, (scrollTop/height)*100)) : 0;
      navProgress.style.width = pct+"%";
      ticking = false;
    }
    window.addEventListener("scroll", function(){
      if(!ticking){ requestAnimationFrame(updateProgress); ticking = true; }
    }, {passive:true});
    updateProgress();
  }

  // scroll-spy: highlight the nav link (and side-rail dot) for whichever section is currently in view
  var navLinkEls = document.querySelectorAll(".navlinks a");
  var railLinkEls = document.querySelectorAll(".side-rail a");
  var allSpyEls = document.querySelectorAll(".navlinks a, .side-rail a");
  if(allSpyEls.length && "IntersectionObserver" in window){
    var linkBySection = {};
    allSpyEls.forEach(function(a){
      var id = a.getAttribute("href").replace("#","");
      (linkBySection[id] = linkBySection[id] || []).push(a);
    });
    var sectionIo = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        var links = linkBySection[entry.target.id];
        if(!links) return;
        if(entry.isIntersecting) allSpyEls.forEach(function(a){ a.classList.toggle("active", links.indexOf(a) !== -1); });
      });
    }, {rootMargin:"-45% 0px -50% 0px", threshold:0});
    Object.keys(linkBySection).forEach(function(id){
      var sec = document.getElementById(id);
      if(sec) sectionIo.observe(sec);
    });
  }

  // back-to-top + side-rail: fade in once past the hero
  var backToTop = document.getElementById("back-to-top");
  var sideRail = document.getElementById("side-rail");
  var heroEl = document.querySelector(".hero");
  if(backToTop || sideRail){
    var showThreshold = heroEl ? heroEl.offsetHeight * 0.7 : 400;
    var chromeTicking = false;
    function updateChrome(){
      var past = (window.scrollY || document.documentElement.scrollTop) > showThreshold;
      if(backToTop) backToTop.classList.toggle("show", past);
      if(sideRail) sideRail.classList.toggle("show", past);
      chromeTicking = false;
    }
    window.addEventListener("scroll", function(){
      if(!chromeTicking){ requestAnimationFrame(updateChrome); chromeTicking = true; }
    }, {passive:true});
    updateChrome();
  }
  if(backToTop){
    backToTop.addEventListener("click", function(){
      window.scrollTo({top:0, behavior: reduced ? "auto" : "smooth"});
    });
  }

  // card tilt: a light 3D pointer-follow tilt on roster/mega/weakness cards, pointer devices only
  if(!reduced && window.matchMedia && window.matchMedia("(hover: hover)").matches){
    document.querySelectorAll(".tilt-card").forEach(function(card){
      card.addEventListener("mousemove", function(e){
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left)/r.width - 0.5;
        var py = (e.clientY - r.top)/r.height - 0.5;
        card.style.transform = "perspective(700px) rotateY("+(px*10)+"deg) rotateX("+(-py*10)+"deg) translateY(-3px)";
      });
      card.addEventListener("mouseleave", function(){
        card.style.transform = "";
      });
    });
  }

  // type chips: click a type to filter the weakness reference cards
  var typeChips = document.querySelectorAll(".type-chip");
  var weakCards = document.querySelectorAll(".weak-card");
  if(typeChips.length && weakCards.length){
    typeChips.forEach(function(chip){
      chip.addEventListener("click", function(){
        var isActive = chip.classList.contains("active");
        typeChips.forEach(function(c){ c.classList.remove("active"); });
        weakCards.forEach(function(c){ c.classList.remove("dim","hl-weak","hl-resist"); });
        if(isActive) return; // clicking the active chip again clears the filter
        chip.classList.add("active");
        var t = chip.dataset.type;
        weakCards.forEach(function(c){
          var weak = (c.dataset.weak||"").split(",");
          var resist = (c.dataset.resist||"").split(",");
          if(weak.indexOf(t) !== -1) c.classList.add("hl-weak");
          else if(resist.indexOf(t) !== -1) c.classList.add("hl-resist");
          else c.classList.add("dim");
        });
      });
    });
  }
})();

})();
    </script>
  </body>
</html>