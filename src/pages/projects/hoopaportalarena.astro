/* -------- canvas FX: mega bursts + signature move effects -------- */
function sizeFxCanvas(){
  var canvas = document.getElementById("fx-canvas");
  var arena = document.getElementById("arena-shell");
  if(!canvas || !arena) return null;
  var rect = arena.getBoundingClientRect();
  var dpr = Math.min(window.devicePixelRatio||1, 2);
  canvas.width = Math.max(1, rect.width*dpr);
  canvas.height = Math.max(1, rect.height*dpr);
  var ctx = canvas.getContext("2d");
  ctx.setTransform(dpr,0,0,dpr,0,0);
  return {ctx:ctx, w:rect.width, h:rect.height, canvas:canvas};
}

function getPortraitCenter(side){
  var el = document.getElementById("port-"+side);
  var arena = document.getElementById("arena-shell");
  if(!el || !arena) return {x:0,y:0};
  var er = el.getBoundingClientRect(), ar = arena.getBoundingClientRect();
  return {x: er.left-ar.left+er.width/2, y: er.top-ar.top+er.height/2};
}

function silhouettePortrait(side, on, color){
  var el = document.getElementById("port-"+side);
  if(!el) return;
  if(on){
    el.style.setProperty("--mh", color || "#f5c518");
    el.classList.add("mega-silhouette");
  } else {
    el.classList.remove("mega-silhouette");
  }
}

function drawShardShape(ctx, shape, sz){
  ctx.beginPath();
  if(shape==="crescent"){
    // Darkrai — nightmare crescent wisp
    ctx.arc(0,0,sz,Math.PI*0.15,Math.PI*1.55,false);
    ctx.arc(sz*0.32,0,sz*0.72,Math.PI*1.55,Math.PI*0.15,true);
  } else if(shape==="shuriken"){
    // Amphinobi — four-point ninja star
    for(var k=0;k<4;k++){
      var a = k*Math.PI/2;
      ctx.lineTo(Math.cos(a)*sz, Math.sin(a)*sz);
      ctx.lineTo(Math.cos(a+Math.PI/4)*sz*0.32, Math.sin(a+Math.PI/4)*sz*0.32);
    }
    ctx.closePath();
  } else if(shape==="hex"){
    // Zygarde — hexagonal data cell
    for(var h=0;h<6;h++){
      var ah = h*Math.PI/3 - Math.PI/6;
      var px = Math.cos(ah)*sz, py = Math.sin(ah)*sz;
      if(h===0) ctx.moveTo(px,py); else ctx.lineTo(px,py);
    }
    ctx.closePath();
  } else if(shape==="bolt"){
    // Raichu — lightning bolt
    ctx.moveTo(sz*0.18,-sz); ctx.lineTo(-sz*0.5,sz*0.1); ctx.lineTo(-sz*0.05,sz*0.1);
    ctx.lineTo(-sz*0.18,sz); ctx.lineTo(sz*0.5,-sz*0.1); ctx.lineTo(sz*0.05,-sz*0.1);
    ctx.closePath();
  } else if(shape==="ring"){
    // Hoopa — mini portal ring
    ctx.arc(0,0,sz,0,Math.PI*2);
    ctx.moveTo(sz*0.5,0); ctx.arc(0,0,sz*0.5,0,Math.PI*2,true);
  } else {
    // default diamond
    ctx.moveTo(0,-sz); ctx.lineTo(sz*0.62,0); ctx.lineTo(0,sz); ctx.lineTo(-sz*0.62,0);
    ctx.closePath();
  }
}

function playMegaShardConverge(side, colors, durationMs, shape){
  var fx = sizeFxCanvas();
  if(!fx) return Promise.resolve();
  var ctx = fx.ctx, canvas = fx.canvas;
  var center = getPortraitCenter(side);
  var c1=(colors&&colors[0])||"#f5c518";
  var shape2 = shape || "diamond";
  // a clean, single-color convergence: one small set of shards pulling straight in, nothing else
  // competing for attention while it happens — restraint is what reads as premium here, not volume
  var shards = [];
  var SHARD_N = 10;
  for(var i=0;i<SHARD_N;i++){
    var ang = (i/SHARD_N)*Math.PI*2 + Math.random()*0.3;
    var dist = 140+Math.random()*90;
    shards.push({
      sx: center.x+Math.cos(ang)*dist, sy: center.y+Math.sin(ang)*dist,
      delay: (i/SHARD_N)*0.3,
      size: 8+Math.random()*7,
      rot0: Math.random()*Math.PI,
      rotSpeed: (Math.random()-0.5)*8
    });
  }
  return new Promise(function(resolve){
    var start=null;
    function frame(ts){
      if(start===null) start=ts;
      var p = Math.min(1,(ts-start)/durationMs);
      // a translucent fill here (instead of a hard clear) would compound frame over frame with
      // nothing ever fully erasing it, eventually painting the whole arena solid — always clear fully.
      ctx.clearRect(0,0,fx.w,fx.h);

      // building core glow — intensifies as the shards close in, selling the charge-up
      var corePulse = Math.min(1,p*1.3);
      ctx.save();
      ctx.beginPath();
      ctx.arc(center.x, center.y, 9+corePulse*14, 0, Math.PI*2);
      ctx.fillStyle = c1; ctx.globalAlpha = corePulse*0.45;
      ctx.shadowColor = c1; ctx.shadowBlur = 16;
      ctx.fill();
      ctx.restore();

      // one clean ring pulsing gently as the shards pull in — a single confident gesture instead of
      // a layered vortex
      ctx.save();
      ctx.beginPath();
      ctx.arc(center.x, center.y, 26+Math.sin(p*Math.PI*3)*3, 0, Math.PI*2);
      ctx.strokeStyle = c1; ctx.globalAlpha = 0.4*Math.sin(Math.min(1,p)*Math.PI);
      ctx.lineWidth = 1.6;
      ctx.stroke();
      ctx.restore();

      shards.forEach(function(s){
        var lp = Math.max(0, Math.min(1, (p-s.delay)/(1-s.delay)));
        if(lp<=0) return;
        var ease = lp*lp*(3-2*lp);
        var x = s.sx + (center.x-s.sx)*ease;
        var y = s.sy + (center.y-s.sy)*ease;
        var scale = 1 - ease*0.35;
        ctx.save();
        ctx.translate(x,y);
        ctx.rotate(s.rot0 + ease*s.rotSpeed);
        var sz = s.size*scale;
        drawShardShape(ctx, shape2, sz);
        ctx.fillStyle = c1;
        ctx.shadowColor = c1; ctx.shadowBlur = 10;
        ctx.globalAlpha = 0.9;
        ctx.fill();
        ctx.restore();
      });
      ctx.globalAlpha = 1;
      if(p<1) requestAnimationFrame(frame);
      else { ctx.clearRect(0,0,fx.w,fx.h); resolve(); }
    }
    requestAnimationFrame(frame);
  });
}

// swaps in the Mega Evolved art and stats, then hands back a portrait that's still in its darkened
// silhouette state — no bright whiteout flash here. renderFighter rebuilds the portrait element from
// scratch (losing the silhouette class in the process), so it's reapplied right after the swap; the
// caller then clears it a beat later, and the silhouette's own CSS transition (see .mega-silhouette)
// fades smoothly from black to full color — a clean "unveil" without ever blowing out to solid white.
async function whiteoutSwapAndReveal(f, cfg){
  var side = f.side;
  var panel = side==="you" ? youPanel : cpuPanel;
  var label = side==="you" ? "You" : "Rival";
  var haloColor = (cfg.halo && cfg.halo[0]) || "#f5c518";

  await wait(110);
  applyMega(f, cfg);
  renderFighter(f, panel, label);
  silhouettePortrait(side, true, haloColor);
  await wait(140);
}

function arenaMegaPulse(color){
  var el = document.getElementById("arena-shell");
  if(!el) return;
  el.style.setProperty("--mp", color || "#f5c518");
  el.classList.remove("mega-pulse"); void el.offsetWidth; el.classList.add("mega-pulse");
  setTimeout(function(){ el.classList.remove("mega-pulse"); }, 720);
}

async function playMegaEvolution(f, cfg){
  var side = f.side;
  var panel = side==="you" ? youPanel : cpuPanel;
  var otherPanel = side==="you" ? cpuPanel : youPanel;
  var vsMid = document.querySelector(".vs-mid");
  var arenaEl = document.getElementById("arena-shell");
  var colors = cfg.halo || ["#f5c518","#e879f9","#22d3ee"];

  // the spotlight narrows: the opposing fighter and the VS marker step back, the arena crops in like
  // a widescreen frame, and everything eases forward very slightly — every cue says "watch this one"
  panel.style.setProperty("--mh", colors[0]);
  panel.classList.add("mega-focus");
  if(otherPanel) otherPanel.classList.add("mega-dim");
  if(vsMid) vsMid.classList.add("mega-dim");
  if(arenaEl) arenaEl.classList.add("mega-cinematic");
  if(musicPlaying && musicCtx) musicRiser(musicCtx.currentTime+0.02, 0.95);
  await wait(220); // let the frame actually close in before the shards start — otherwise it reads as simultaneous clutter instead of a clean beat-by-beat build

  silhouettePortrait(side, true, colors[0]);
  await playMegaShardConverge(side, colors, 780, cfg.shard);
  // the classic "beat drop": the mix ducks hard right as the swap happens, so it's nearly silent for
  // a beat, then the mega sting lands into that cleared space instead of competing with a full mix —
  // the momentary quiet is what makes the hit read as loud
  if(musicPlaying && musicCtx) musicDuckHit(musicCtx.currentTime+0.02, 0.82, 0.55);
  await whiteoutSwapAndReveal(f, cfg);
  silhouettePortrait(side, false);

  // the unveil itself: a light sheen sweeps the newly-revealed portrait with a soft weighted pop,
  // timed to land right as the silhouette's own fade finishes lifting
  var newPort = document.getElementById("port-"+side);
  if(newPort){
    newPort.classList.remove("reveal-pop","reveal-sheen"); void newPort.offsetWidth;
    newPort.classList.add("reveal-pop","reveal-sheen");
  }

  arenaMegaPulse(colors[1] || colors[0]);
  megaBurst(side, colors);
  musicMegaSting();

  // hold the spotlight a beat so the reveal actually registers, then let the frame open back up
  await wait(750);
  panel.classList.remove("mega-focus");
  if(otherPanel) otherPanel.classList.remove("mega-dim");
  if(vsMid) vsMid.classList.remove("mega-dim");
  if(arenaEl) arenaEl.classList.remove("mega-cinematic");
}

function megaBurst(side, colors){
  var fx = sizeFxCanvas();
  if(!fx) return;
  var ctx = fx.ctx, canvas = fx.canvas;
  var center = getPortraitCenter(side);
  var c1=(colors&&colors[0])||"#f5c518";
  var start=null, dur=900;
  // stripped down to three deliberate moves — a flash, one light streak, two rings — instead of
  // layering rays, sparks and multi-color rings on top of each other. Restraint is what reads as
  // clean and premium; a pile of simultaneous effects reads as noise no matter how nice each one is.
  function frame(ts){
    if(start===null) start=ts;
    var p = Math.min(1, (ts-start)/dur);
    ctx.clearRect(0,0,fx.w,fx.h);

    // a single anamorphic lens-flare streak sweeping horizontally through the reveal
    if(p<0.4){
      var flareP = p/0.4;
      var flareAlpha = Math.sin(Math.min(1,flareP)*Math.PI);
      var flareW = fx.w*1.5;
      ctx.save();
      ctx.translate(center.x, center.y);
      var streakGrad = ctx.createLinearGradient(-flareW/2,0,flareW/2,0);
      streakGrad.addColorStop(0,"transparent");
      streakGrad.addColorStop(0.47,c1);
      streakGrad.addColorStop(0.5,"#ffffff");
      streakGrad.addColorStop(0.53,c1);
      streakGrad.addColorStop(1,"transparent");
      ctx.fillStyle = streakGrad;
      ctx.globalAlpha = flareAlpha*0.5;
      ctx.fillRect(-flareW/2, -1.1, flareW, 2.2);
      ctx.restore();
    }

    // two clean rings, one color, no gradient rainbow — a single confident expanding pulse
    [0, 0.12].forEach(function(delay,i){
      var lp = Math.max(0, Math.min(1,(p-delay)/(1-delay)));
      if(lp<=0) return;
      var ease = 1-Math.pow(1-lp,2);
      var r = 10 + ease*(100+i*18);
      ctx.beginPath();
      ctx.arc(center.x, center.y, r, 0, Math.PI*2);
      ctx.strokeStyle = c1;
      ctx.globalAlpha = (1-lp)*0.7;
      ctx.lineWidth = 2.4 - i*0.5;
      ctx.stroke();
    });

    // soft flash core, fading fast — a gentle bloom rather than a hard white disc
    if(p<0.26){
      var flp = 1-p/0.26;
      var fg = ctx.createRadialGradient(center.x,center.y,0,center.x,center.y,34*flp);
      fg.addColorStop(0,"rgba(255,255,255,0.95)"); fg.addColorStop(1,"rgba(255,255,255,0)");
      ctx.beginPath();
      ctx.arc(center.x, center.y, 34*flp, 0, Math.PI*2);
      ctx.fillStyle = fg; ctx.globalAlpha = flp*0.8;
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    if(p<1) requestAnimationFrame(frame);
    else ctx.clearRect(0,0,fx.w,fx.h);
  }
  requestAnimationFrame(frame);
}

function drawShurikens(ctx, from, to, p, c1, c2){
  for(var i=0;i<3;i++){
    var delay = i*0.14;
    var lp = Math.max(0, Math.min(1, (p-delay)/0.55));
    if(lp<=0 || lp>=1) continue;
    var x = from.x + (to.x-from.x)*lp;
    var y = from.y + (to.y-from.y)*lp - Math.sin(lp*Math.PI)*34;
    var rot = lp*Math.PI*7;
    ctx.save();
    ctx.translate(x,y); ctx.rotate(rot);
    ctx.beginPath();
    for(var k=0;k<4;k++){
      var a = k*Math.PI/2;
      ctx.lineTo(Math.cos(a)*11, Math.sin(a)*11);
      ctx.lineTo(Math.cos(a+Math.PI/4)*3.5, Math.sin(a+Math.PI/4)*3.5);
    }
    ctx.closePath();
    ctx.fillStyle = i%2===0 ? c1 : c2;
    ctx.globalAlpha = 0.95;
    ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha=1;
}

function drawVoidTendrils(ctx, to, p, c1, c2, w, h){
  ctx.save();
  var pulse = Math.sin(Math.min(1,p)*Math.PI);
  // full-arena nightmare vignette so the curse reads clearly, not just a small local glow
  if(w && h){
    ctx.globalAlpha = pulse*0.35;
    var grad = ctx.createRadialGradient(to.x,to.y,10, to.x,to.y, Math.max(w,h)*0.7);
    grad.addColorStop(0, "rgba(0,0,0,0)");
    grad.addColorStop(0.55, c1);
    grad.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,w,h);
  }
  ctx.globalAlpha = pulse*0.95;
  for(var i=0;i<11;i++){
    var ang = (i/11)*Math.PI*2 + p*Math.PI*2.6;
    var r = 46 + Math.sin(p*Math.PI*3+i)*20;
    ctx.beginPath();
    ctx.moveTo(to.x, to.y);
    ctx.quadraticCurveTo(to.x+Math.cos(ang)*r*1.7, to.y+Math.sin(ang)*r*1.7, to.x+Math.cos(ang)*r, to.y+Math.sin(ang)*r);
    ctx.strokeStyle = i%2===0 ? c1 : c2;
    ctx.shadowColor = c1; ctx.shadowBlur = 12;
    ctx.lineWidth = 3.2;
    ctx.stroke();
  }
  ctx.shadowBlur = 0;
  ctx.beginPath();
  ctx.arc(to.x, to.y, 26+pulse*16, 0, Math.PI*2);
  ctx.fillStyle = c1;
  ctx.globalAlpha = pulse*0.4;
  ctx.fill();
  ctx.beginPath();
  ctx.arc(to.x, to.y, 12+pulse*9, 0, Math.PI*2);
  ctx.fillStyle = "#0a0410";
  ctx.globalAlpha = pulse*0.7;
  ctx.fill();
  ctx.restore();
}

// Darkrai's Void Curse upkeep tick: a visible stream of life force pulled from the cursed foe (from)
// across the arena into Darkrai (to), with a draining ring on the victim and a healing bloom on Darkrai —
// so the HP transfer reads clearly on-screen every turn, not just as numbers in the log.
function drawLifeDrain(ctx, from, to, p, c1, c2, w, h){
  ctx.save();
  var midx = (from.x+to.x)/2, midy = (from.y+to.y)/2 - Math.min(70, Math.abs(to.x-from.x)*0.18) - 30;
  function bez(t){
    var x = (1-t)*(1-t)*from.x + 2*(1-t)*t*midx + t*t*to.x;
    var y = (1-t)*(1-t)*from.y + 2*(1-t)*t*midy + t*t*to.y;
    return {x:x,y:y};
  }
  var pulse = Math.sin(Math.min(1,p)*Math.PI);
  // shrinking dark ring on the victim, reading as HP being torn away
  ctx.globalAlpha = pulse*0.6;
  ctx.beginPath();
  ctx.arc(from.x, from.y, 30-pulse*12, 0, Math.PI*2);
  ctx.strokeStyle = c1; ctx.lineWidth = 3; ctx.shadowColor = c1; ctx.shadowBlur = 10;
  ctx.stroke();
  ctx.shadowBlur = 0;
  // a stream of orbs travelling the curve from victim to Darkrai
  var N = 8;
  for(var i=0;i<N;i++){
    var off = i/N;
    var lp = (p*1.35 - off*0.5);
    if(lp<=0 || lp>=1) continue;
    var pos = bez(lp);
    var sz = 3+(1-lp)*3.6;
    ctx.beginPath();
    ctx.arc(pos.x, pos.y, sz, 0, Math.PI*2);
    ctx.fillStyle = i%2===0 ? c1 : c2;
    ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 8;
    ctx.globalAlpha = Math.min(1,lp*3.2)*Math.min(1,(1-lp)*3.2)*0.92;
    ctx.fill();
  }
  ctx.shadowBlur = 0;
  // warm bloom blooming on Darkrai as the stream lands, reading as the heal landing
  var healP = Math.max(0, Math.min(1, (p-0.4)/0.55));
  if(healP>0){
    ctx.globalAlpha = Math.sin(Math.min(1,healP)*Math.PI)*0.65;
    var grad = ctx.createRadialGradient(to.x,to.y,4, to.x,to.y,48);
    grad.addColorStop(0, c2); grad.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.arc(to.x,to.y,48,0,Math.PI*2); ctx.fill();
  }
  ctx.restore();
  ctx.globalAlpha = 1;
}

function drawCannonBeam(ctx, to, p, c1, c2, c3, w, h){
  // Lux Nihilium — Zygarde's "Order" pulse: a main core beam plus two flanking beams to read as
  // an arena-wide strike (it hits every card on the field), with hexagonal data-cell shrapnel on impact.
  var beamIn = Math.min(1, p/0.32);
  var beamOut = Math.max(0, 1-Math.max(0,(p-0.5))/0.5);
  var beamAlpha = beamIn*beamOut;
  if(beamAlpha>0.01 && w){
    ctx.save();
    [-1,0,1].forEach(function(off,i){
      var bx = to.x + off*w*0.24;
      var bw = (off===0?46:22)*beamIn;
      if(bw<=0.5) return;
      var grad = ctx.createLinearGradient(0,0,0,h);
      grad.addColorStop(0, c2); grad.addColorStop(0.5, c1); grad.addColorStop(1, c3);
      ctx.globalAlpha = beamAlpha*(off===0?1:0.55);
      ctx.fillStyle = grad;
      ctx.fillRect(bx-bw/2, 0, bw, h);
    });
    ctx.restore();
  }
  var ringP = Math.max(0, Math.min(1,(p-0.24)/0.6));
  if(ringP>0 && ringP<1){
    ctx.save();
    ctx.shadowColor = c1; ctx.shadowBlur = 10;
    [0,0.15].forEach(function(off){
      var lp = Math.max(0, Math.min(1, ringP+off));
      ctx.beginPath();
      ctx.arc(to.x, to.y, 8+lp*80, 0, Math.PI*2);
      ctx.strokeStyle = off===0?c1:c3; ctx.lineWidth = 3; ctx.globalAlpha = (1-lp)*0.85;
      ctx.stroke();
    });
    ctx.restore();
    // hexagonal "data cell" shrapnel bursting from the impact point
    var HEX_N = 9;
    for(var i=0;i<HEX_N;i++){
      var ang = (i/HEX_N)*Math.PI*2 + ringP*1.4;
      var r = 10+ringP*58;
      var hx = to.x+Math.cos(ang)*r, hy = to.y+Math.sin(ang)*r*0.85;
      ctx.save();
      ctx.translate(hx,hy); ctx.rotate(ang+ringP*3);
      drawShardShape(ctx, "hex", 5+ringP*3);
      ctx.fillStyle = i%2===0?c1:c3;
      ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 8;
      ctx.globalAlpha = (1-ringP)*0.9;
      ctx.fill();
      ctx.restore();
    }
  }
}

function drawLightning(ctx, to, p, c1, c2){
  if(p>0.62) return;
  var alpha = 1 - p/0.62;
  ctx.save();
  ctx.globalAlpha = alpha*(0.6+Math.random()*0.4);
  ctx.beginPath();
  ctx.moveTo(to.x+(Math.random()-0.5)*22, 0);
  var segs = 6;
  for(var i=1;i<=segs;i++){
    var yy = to.y*(i/segs);
    var xx = to.x + (Math.random()-0.5)*24;
    ctx.lineTo(xx, yy);
  }
  ctx.lineTo(to.x, to.y);
  ctx.strokeStyle = c1;
  ctx.lineWidth = 3;
  ctx.shadowColor = c2; ctx.shadowBlur = 16;
  ctx.stroke();
  ctx.restore();
}

function drawPortalBurst(ctx, to, p, c1, c2, c3){
  [0,0.18,0.34].forEach(function(delay,i){
    var lp = Math.max(0, Math.min(1,(p-delay)/(1-delay)));
    if(lp<=0) return;
    ctx.save();
    ctx.beginPath();
    ctx.ellipse(to.x, to.y, 10+lp*60, (10+lp*60)*0.55, p*Math.PI*1.4, 0, Math.PI*2);
    ctx.strokeStyle = [c1,c2,c3][i%3];
    ctx.globalAlpha = (1-lp)*0.85;
    ctx.lineWidth = 3;
    ctx.stroke();
    ctx.restore();
  });
}

function buildSignatureFxJob(effectKey, fromSide, toSide, colors){
  var from = getPortraitCenter(fromSide), to = getPortraitCenter(toSide);
  var c1=(colors&&colors[0])||"#e879f9", c2=(colors&&colors[1])||"#f5c518", c3=(colors&&colors[2])||"#22d3ee";
  return {
    duration: 1300,
    draw: function(ctx,p,w,h){
      drawImpactPunch(ctx, to, p, c1);
      if(effectKey==="clone"){ drawShurikens(ctx, from, to, p, c1, c3); }
      else if(effectKey==="dot_heal"){ drawVoidTendrils(ctx, to, p, c1, c2, w, h); drawLifeDrain(ctx, to, from, p, c1, c3, w, h); }
      else if(effectKey==="aoe_paralyze_recharge"){ drawCannonBeam(ctx, to, p, c1, c2, c3, w, h); }
      else if(effectKey==="power_surge"){ drawLightning(ctx, to, p, c1, c2); }
      else if(effectKey==="burst"){ drawPortalBurst(ctx, to, p, c1, c2, c3); }
    }
  };
}

/* -------- per-type attack FX: every base move gets an animation keyed to its type + damage tier -------- */
var TYPE_FX = {
  normal:{fam:"rings", n:3},
  fighting:{fam:"rings", n:5},
  fire:{fam:"flame", n:11},
  water:{fam:"splash", n:12},
  electric:{fam:"lightning"},
  grass:{fam:"swirl", n:10},
  bug:{fam:"swirl", n:14},
  ice:{fam:"shards", n:8, heavy:false},
  rock:{fam:"shards", n:9, heavy:true},
  ground:{fam:"shards", n:9, heavy:true},
  steel:{fam:"shards", n:10, heavy:false},
  flying:{fam:"gust"},
  psychic:{fam:"ripple", big:false},
  dragon:{fam:"beam"},
  ghost:{fam:"void"},
  dark:{fam:"void"},
  poison:{fam:"sparkle", n:8},
  fairy:{fam:"sparkle", n:11}
};

function fxRings(ctx, to, p, color, n){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 10;
  for(var i=0;i<n;i++){
    var delay = i*0.1;
    var lp = Math.max(0, Math.min(1,(p-delay)/(1-delay)));
    if(lp<=0) continue;
    var ease = 1-Math.pow(1-lp,2);
    ctx.beginPath();
    ctx.arc(to.x, to.y, 6+ease*(30+n*6), 0, Math.PI*2);
    ctx.strokeStyle = color; ctx.globalAlpha = (1-lp)*0.85; ctx.lineWidth = 3;
    ctx.stroke();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxFlame(ctx, to, p, color, count){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 8;
  for(var i=0;i<count;i++){
    var lp = Math.max(0, Math.min(1, p - (i%5)*0.05));
    var x = to.x + Math.sin(i*12.9+p*6)*15;
    var y = to.y - lp*42 + Math.sin(i)*4;
    ctx.beginPath();
    ctx.arc(x,y, 4+(1-lp)*3, 0, Math.PI*2);
    ctx.fillStyle = color; ctx.globalAlpha = (1-lp)*0.9; ctx.fill();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxSplash(ctx, to, p, color, count){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 6;
  for(var i=0;i<count;i++){
    var ang = (i/count)*Math.PI*2;
    var ease = 1-Math.pow(1-p,2);
    var dist = ease*34;
    var x = to.x+Math.cos(ang)*dist;
    var y = to.y+Math.sin(ang)*dist*0.6 + p*p*26;
    ctx.beginPath();
    ctx.arc(x,y,3,0,Math.PI*2);
    ctx.fillStyle = color; ctx.globalAlpha = (1-p)*0.9; ctx.fill();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxShards(ctx, to, p, color, count, heavy){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 7;
  for(var i=0;i<count;i++){
    var ang = (i/count)*Math.PI*2;
    var endR = heavy?42:27;
    var ease = 1-Math.pow(1-p,2);
    var r = 4+ease*endR;
    var x = to.x+Math.cos(ang)*r;
    var y = to.y+Math.sin(ang)*r*0.7 + (heavy?p*p*20:0);
    ctx.save();
    ctx.translate(x,y); ctx.rotate(ang+p*2.2);
    ctx.beginPath();
    ctx.moveTo(0,-5); ctx.lineTo(3.2,0); ctx.lineTo(0,5); ctx.lineTo(-3.2,0); ctx.closePath();
    ctx.fillStyle=color; ctx.globalAlpha=(1-p)*0.95; ctx.fill();
    ctx.restore();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxSwirl(ctx, to, p, color, count){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 6;
  for(var i=0;i<count;i++){
    var ang = (i/count)*Math.PI*2 + p*Math.PI*3;
    var r = 10+p*28;
    var x = to.x+Math.cos(ang)*r, y = to.y+Math.sin(ang)*r;
    ctx.beginPath();
    ctx.arc(x,y,2.6,0,Math.PI*2);
    ctx.fillStyle=color; ctx.globalAlpha=(1-p)*0.9; ctx.fill();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxGust(ctx, to, p, color){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 5;
  for(var i=0;i<3;i++){
    var off=i*9-9;
    ctx.beginPath();
    ctx.moveTo(to.x-42, to.y+off-p*10);
    ctx.quadraticCurveTo(to.x-10, to.y+off-15-p*6, to.x+36, to.y+off);
    ctx.strokeStyle=color; ctx.lineWidth=2.4; ctx.globalAlpha=(1-p)*0.75;
    ctx.stroke();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxRipple(ctx, to, p, color, big){
  var n=3;
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 8;
  for(var i=0;i<n;i++){
    var delay=i*0.14;
    var lp=Math.max(0,Math.min(1,(p-delay)/(1-delay)));
    if(lp<=0) continue;
    ctx.save();
    var rx=(big?18:11)+lp*(big?62:38), ry=rx*0.55;
    ctx.beginPath();
    ctx.ellipse(to.x,to.y,rx,ry, Math.sin(p*3)*0.2, 0, Math.PI*2);
    ctx.strokeStyle=color; ctx.globalAlpha=(1-lp)*0.8; ctx.lineWidth=2.4;
    ctx.stroke();
    ctx.restore();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxVoidPulse(ctx, to, p, color){
  ctx.beginPath();
  ctx.arc(to.x,to.y, 24*(1-p*0.5), 0, Math.PI*2);
  ctx.fillStyle=color; ctx.globalAlpha=(1-p)*0.4; ctx.fill();
  ctx.globalAlpha=1;
  for(var i=0;i<5;i++){
    var ang=(i/5)*Math.PI*2+p*Math.PI*1.5;
    var r=18+p*24;
    ctx.beginPath();
    ctx.moveTo(to.x,to.y);
    ctx.lineTo(to.x+Math.cos(ang)*r, to.y+Math.sin(ang)*r);
    ctx.strokeStyle=color; ctx.globalAlpha=(1-p)*0.5; ctx.lineWidth=1.6;
    ctx.stroke();
  }
  ctx.globalAlpha=1;
}
function fxSparkle(ctx, to, p, color, count){
  ctx.save();
  ctx.shadowColor = color; ctx.shadowBlur = 8;
  for(var i=0;i<count;i++){
    var ang=(i/count)*Math.PI*2 + i;
    var r = 8+p*34;
    var x=to.x+Math.cos(ang)*r, y=to.y+Math.sin(ang)*r;
    var s = 3.4*(1-p);
    ctx.save();
    ctx.translate(x,y); ctx.rotate(p*4+i);
    ctx.beginPath();
    ctx.moveTo(0,-s); ctx.lineTo(s*0.3,0); ctx.lineTo(0,s); ctx.lineTo(-s*0.3,0); ctx.closePath();
    ctx.fillStyle=color; ctx.globalAlpha=(1-p)*0.95; ctx.fill();
    ctx.restore();
  }
  ctx.restore();
  ctx.globalAlpha=1;
}
function fxBeam(ctx, from, to, p, color, w, h){
  // dragon-type "Core Enforcer" beam — carries trailing hexagonal data-cell shrapnel to tie it
  // visually to Zygarde's Order theme (the only dragon-type attacker in the roster).
  var alpha = p<0.7 ? 1 : (1-(p-0.7)/0.3);
  ctx.save();
  var dx=to.x-from.x, dy=to.y-from.y;
  var fullLen = Math.sqrt(dx*dx+dy*dy);
  var len=fullLen*Math.min(1,p/0.35);
  var ang=Math.atan2(dy,dx);
  ctx.translate(from.x, from.y); ctx.rotate(ang);
  var grad=ctx.createLinearGradient(0,0,Math.max(1,len),0);
  grad.addColorStop(0, color); grad.addColorStop(1, "rgba(255,255,255,0.9)");
  ctx.shadowColor = color; ctx.shadowBlur = 10;
  ctx.fillStyle=grad; ctx.globalAlpha=Math.max(0,alpha)*0.88;
  ctx.beginPath();
  ctx.moveTo(0,-6); ctx.lineTo(len,-2); ctx.lineTo(len,2); ctx.lineTo(0,6);
  ctx.closePath(); ctx.fill();
  if(len>10){
    var hexN = 5;
    for(var i=0;i<hexN;i++){
      var hx = len*((i+0.5)/hexN);
      var hy = Math.sin(p*10+i*2)*4;
      ctx.save();
      ctx.translate(hx,hy); ctx.rotate(p*3+i);
      drawShardShape(ctx, "hex", 3.4);
      ctx.fillStyle = "#fff"; ctx.globalAlpha = Math.max(0,alpha)*0.55;
      ctx.fill();
      ctx.restore();
    }
  }
  ctx.restore();
  ctx.globalAlpha=1;
}

function drawImpactPunch(ctx, to, p, color){
  // a quick bright core-flash + expanding shockwave layered under every attack fx, for a punchier hit feel
  var lp = Math.min(1, p/0.4);
  if(lp>=1) return;
  ctx.save();
  ctx.beginPath();
  ctx.arc(to.x, to.y, 4+lp*30, 0, Math.PI*2);
  ctx.fillStyle = "#ffffff";
  ctx.globalAlpha = (1-lp)*0.55;
  ctx.fill();
  ctx.beginPath();
  ctx.arc(to.x, to.y, 6+lp*54, 0, Math.PI*2);
  ctx.strokeStyle = color;
  ctx.lineWidth = 2.4;
  ctx.globalAlpha = (1-lp)*0.6;
  ctx.stroke();
  ctx.restore();
}

function drawTypeFx(fam, ctx, from, to, p, color, cfg, w, h){
  switch(fam){
    case "rings": fxRings(ctx, to, p, color, cfg.n||3); break;
    case "flame": fxFlame(ctx, to, p, color, cfg.n||10); break;
    case "splash": fxSplash(ctx, to, p, color, cfg.n||12); break;
    case "lightning": drawLightning(ctx, to, p, color, "#fff8dd"); break;
    case "swirl": fxSwirl(ctx, to, p, color, cfg.n||10); break;
    case "shards": fxShards(ctx, to, p, color, cfg.n||8, cfg.heavy); break;
    case "gust": fxGust(ctx, to, p, color); break;
    case "ripple": fxRipple(ctx, to, p, color, cfg.big); break;
    case "beam": fxBeam(ctx, from, to, p, color, w, h); break;
    case "void": fxVoidPulse(ctx, to, p, color); break;
    case "sparkle": fxSparkle(ctx, to, p, color, cfg.n||8); break;
  }
}

function buildAttackFxJob(type, dmg, fromSide, toSide){
  var cfg = TYPE_FX[type] || {fam:"rings", n:3};
  var color = TYPE_COLOR[type] || "#ffffff";
  var tier = dmg>=42 ? "huge" : dmg>=20 ? "medium" : "low";
  var scale = tier==="huge" ? 1.5 : tier==="medium" ? 1.1 : 0.75;
  var dur = tier==="huge" ? 1080 : tier==="medium" ? 900 : 700;
  var from = getPortraitCenter(fromSide), to = getPortraitCenter(toSide);
  var n2 = cfg.n ? Math.max(3, Math.round(cfg.n*scale)) : cfg.n;
  var cfg2 = {n:n2, heavy:cfg.heavy, big:cfg.big};
  return {
    duration: dur, tier: tier,
    draw: function(ctx,p,w,h){ drawImpactPunch(ctx, to, p, color); drawTypeFx(cfg.fam, ctx, from, to, p, color, cfg2, w, h); }
  };
}

// the recurring Void Curse upkeep tick — separate from the cast job above, since this one fires every
// turn the curse is active, not just when Darkrai first uses the move
function buildDrainTickFxJob(fromSide, toSide, colors){
  var from = getPortraitCenter(fromSide), to = getPortraitCenter(toSide);
  var c1 = (colors&&colors[0]) || "#a21caf", c2 = (colors&&colors[2]) || "#f472b6";
  return {
    duration: 950,
    draw: function(ctx,p,w,h){ drawLifeDrain(ctx, from, to, p, c1, c2, w, h); }
  };
}

function playDualFx(fx1, fx2){
  var fx = sizeFxCanvas();
  if(!fx) return;
  var ctx = fx.ctx, w = fx.w, h = fx.h;
  var maxDur = Math.max(fx1?fx1.duration:0, fx2?fx2.duration:0);
  if(maxDur<=0) return;
  var start=null;
  function frame(ts){
    if(start===null) start=ts;
    var t = ts-start;
    ctx.clearRect(0,0,w,h);
    if(fx1) fx1.draw(ctx, Math.min(1,t/fx1.duration), w, h);
    if(fx2) fx2.draw(ctx, Math.min(1,t/fx2.duration), w, h);
    if(t<maxDur) requestAnimationFrame(frame);
    else ctx.clearRect(0,0,w,h);
  }
  requestAnimationFrame(frame);
}

function animateHpBar(side, fromHp, toHp, maxHp){
  var fill = document.getElementById("hpfill-"+side);
  var num = document.getElementById("hpnum-"+side);
  if(!fill){ return; }
  var fromPct = Math.max(0,(fromHp/maxHp)*100);
  var toPct = Math.max(0,(toHp/maxHp)*100);
  var start = null;
  var dur = 560;
  function frame(ts){
    if(start===null) start = ts;
    var p = Math.min(1, (ts-start)/dur);
    var eased = 1-Math.pow(1-p,3);
    var curPct = fromPct + (toPct-fromPct)*eased;
    var curHp = fromHp + (toHp-fromHp)*eased;
    fill.style.width = Math.max(0,curPct)+"%";
    fill.className = "hp-fill "+hpBarClass(curPct);
    if(num) num.textContent = Math.max(0,Math.round(curHp))+" / "+maxHp;
    if(p<1) requestAnimationFrame(frame);
    else {
      fill.style.width = Math.max(0,toPct)+"%";
      fill.className = "hp-fill "+hpBarClass(toPct);
      if(num) num.textContent = Math.max(0,Math.round(toHp))+" / "+maxHp;
    }
  }
  requestAnimationFrame(frame);
}

/* battle tension: danger glow on a critically-low fighter, the momentum tug bar, and the music's
   reaction to how close the duel currently is — one readout drives all three so they never disagree */
function updateBattleTension(){
  if(!state) return;
  var you = state.you, cpu = state.cpu;
  var youDanger = you.hp>0 && (you.hp/you.maxHp) <= 0.3;
  var cpuDanger = cpu.hp>0 && (cpu.hp/cpu.maxHp) <= 0.3;
  if(youPanel) youPanel.classList.toggle("danger", youDanger);
  if(cpuPanel) cpuPanel.classList.toggle("danger", cpuDanger);

  var fill = document.getElementById("momentum-fill");
  if(fill){
    var youPct = Math.max(0, (you.hp/you.maxHp)*100);
    var cpuPct = Math.max(0, (cpu.hp/cpu.maxHp)*100);
    var diff = youPct - cpuPct; // -100..100, positive favors you
    var half = Math.min(50, Math.abs(diff)/2);
    fill.style.left = (diff>=0 ? (50-half) : 50) + "%";
    fill.style.width = half + "%";
    fill.style.background = diff>=0
      ? "linear-gradient(90deg,var(--cyan),var(--magenta-2))"
      : "linear-gradient(90deg,var(--magenta-2),var(--cyan))";
  }

  setMusicTension(!state.matchOver && (youDanger || cpuDanger));
}

/* -------- round resolution -------- */
function lockActionButton(locked){
  var btns = arenaActions.querySelectorAll("button");
  btns.forEach(function(btn){ btn.disabled = locked; });
}

async function resolveRound(){
  if(!state || state.matchOver || state.resolving) return;
  state.resolving = true;
  lockActionButton(true);

  state.round += 1;
  var you = state.you, cpu = state.cpu;
  var roundNote = [];

  showBanner("Turn "+state.round, "round");
  await wait(1150);

  // tick down status at top of round
  [you,cpu].forEach(function(f){ f.justMegaEvolved = false; });

  // Mega Evolution trigger check — random-mode mons get a fresh roll every round they're still in their
  // base form (so the transformation is seen live, not resolved silently before the duel starts, and a
  // fighter isn't stuck at its round-1 odds for the whole match); Zygarde rolls only after taking damage.
  for(var mi=0; mi<2; mi++){
    var f = mi===0 ? you : cpu;
    if(f.isMega) continue;
    var base = POKEMON[f.key];
    var cfg = pickMegaConfig(f);
    if(!cfg && base.mega && base.mega.chanceMode === "onDamage" && f.tookDamage){
      if(Math.random() < base.mega.chance) cfg = base.mega;
    }
    if(cfg){
      var preName = f.name, preLabel = cfg.label;
      // Hoopa Unbound is a forme change, not a Mega Evolution, so it gets its own verb/banner instead
      // of borrowing the "Mega Evolves" language used by everyone else's actual Mega Evolutions
      var isFormeChange = (f.key === "hoopa");
      showBanner(preName.toUpperCase()+(isFormeChange ? " IS UNBINDING..." : " IS EVOLVING..."), "transform");
      await wait(1000);
      await playMegaEvolution(f, cfg);
      roundNote.push("⚡ <b>"+preName+"</b> "+(isFormeChange ? "transforms into" : "Mega Evolves into")+" <b>"+f.megaLabel+"</b>!");
      showBanner("✦ "+preLabel.toUpperCase()+" ✦", "mega");
      await wait(1550);
    }
  }

  // paralysis check consumes a turn if locked down
  var youLocked = you.paralyzedTurns > 0;
  var cpuLocked = cpu.paralyzedTurns > 0;

  // choose moves — before Mega Evolving a fighter only has its base move; once Mega Evolved it has
  // two moves (base + special), each usable once per game. The player picks via the move-select UI
  // (stored in f.pendingMove); the CPU (and the player's own evolution-reveal round) auto-picks.
  function chooseMove(f){
    if(f.rechargeTurns > 0) return f.move; // recharging: forced back to the base move
    if(!f.isMega) return f.move;
    if(f.pendingMove && !f.moveUsage[f.pendingMove.name]) return f.pendingMove;
    if(f.special && !f.moveUsage[f.special.name]) return f.special;
    if(f.move && !f.moveUsage[f.move.name]) return f.move;
    return f.special || f.move;
  }
  var youMove = youLocked ? null : chooseMove(you);
  var cpuMove = cpuLocked ? null : chooseMove(cpu);
  // the free reveal-round attack (fired automatically the instant a fighter Mega Evolves) doesn't
  // spend its one-time use — that budget only starts ticking once the player can actually choose.
  if(youMove && you.isMega && !you.justMegaEvolved) you.moveUsage[youMove.name] = true;
  if(cpuMove && cpu.isMega && !cpu.justMegaEvolved) cpu.moveUsage[cpuMove.name] = true;
  you.pendingMove = null; cpu.pendingMove = null;

  var youHit = null, cpuHit = null;

  if(youMove && !youLocked){
    youHit = computeHit(you, cpu.types, youMove);
  }
  if(cpuMove && !cpuLocked){
    cpuHit = computeHit(cpu, you.types, cpuMove);
  }

  // windup: both portraits charge before the clash
  chargePortrait("you"); chargePortrait("cpu");
  await wait(800);
  flashVs();
  await wait(340);

  // attack FX: Mega specials get their signature animation, base moves get a type+damage-tier animation
  var youIsSpecial = youMove && you.special && youMove === you.special;
  var cpuIsSpecial = cpuMove && cpu.special && cpuMove === cpu.special;
  var youFxJob = null, cpuFxJob = null;
  if(youHit && youMove){
    youFxJob = youIsSpecial ? buildSignatureFxJob(you.special.effect, "you", "cpu", you.halo) : buildAttackFxJob(youMove.type, youHit.dmg, "you", "cpu");
    if(youIsSpecial) playSignatureSfx(you.special.effect, "you"); else playTypeSfx(youMove.type, "you", dmgTier(youHit.dmg));
  }
  if(cpuHit && cpuMove){
    cpuFxJob = cpuIsSpecial ? buildSignatureFxJob(cpu.special.effect, "cpu", "you", cpu.halo) : buildAttackFxJob(cpuMove.type, cpuHit.dmg, "cpu", "you");
    if(cpuIsSpecial) playSignatureSfx(cpu.special.effect, "cpu"); else playTypeSfx(cpuMove.type, "cpu", dmgTier(cpuHit.dmg));
  }
  playDualFx(youFxJob, cpuFxJob);

  // impact: apply damage simultaneously, animate hp bars, pop numbers, shake
  var youHpBefore = you.hp, cpuHpBefore = cpu.hp;
  var youRevived=false, cpuRevived=false;
  if(cpuHit){ youRevived = applyDamage(you, cpuHit.dmg); }
  if(youHit){ cpuRevived = applyDamage(cpu, youHit.dmg); }

  if(cpuHit && cpuHit.dmg>0){
    popDamage("you", "-"+cpuHit.dmg, cpuHit.crit ? "crit" : "");
    shakePortrait("you", cpuHit.crit ? "huge" : dmgTier(cpuHit.dmg));
    flashHit("you", cpuHit.crit ? "#f5c518" : (cpuIsSpecial ? (cpu.halo&&cpu.halo[0]) : (TYPE_COLOR[cpuMove.type])));
    animateHpBar("you", youHpBefore, you.hp, you.maxHp);
    if(cpuHit.crit) sfxCritHit("cpu");
  }
  if(youHit && youHit.dmg>0){
    popDamage("cpu", "-"+youHit.dmg, youHit.crit ? "crit" : "");
    shakePortrait("cpu", youHit.crit ? "huge" : dmgTier(youHit.dmg));
    flashHit("cpu", youHit.crit ? "#f5c518" : (youIsSpecial ? (you.halo&&you.halo[0]) : (TYPE_COLOR[youMove.type])));
    animateHpBar("cpu", cpuHpBefore, cpu.hp, cpu.maxHp);
    if(youHit.crit) sfxCritHit("you");
  }

  var bigHit = (youHit && youHit.eff>=2) || (cpuHit && cpuHit.eff>=2) || (youHit && youHit.dmg>=55) || (cpuHit && cpuHit.dmg>=55) || (youHit && youHit.crit) || (cpuHit && cpuHit.crit);
  if(bigHit) shakeArena();

  updateBattleTension();

  // headline effectiveness banner — pick whichever hit is most dramatic
  function effWeight(hit){ if(!hit) return -1; if(hit.eff===0) return 3; if(hit.eff>=4) return 2.5; if(hit.eff>=2) return 2; if(hit.eff<1) return 1; return 0; }
  var wy = effWeight(youHit), wc = effWeight(cpuHit);
  var bannerPick = null, bannerAttacker = null;
  if(wy>=wc && wy>0){ bannerPick = youHit; bannerAttacker = you; }
  else if(wc>wy && wc>0){ bannerPick = cpuHit; bannerAttacker = cpu; }
  if(bannerPick){
    var word, kind;
    if(bannerPick.eff===0){ word="NO EFFECT!"; kind="eff-none"; }
    else if(bannerPick.eff>=4){ word="DEVASTATING!"; kind="eff-devastating"; }
    else if(bannerPick.eff>=2){ word="SUPER EFFECTIVE!"; kind="eff-super"; }
    else { word="RESISTED..."; kind="eff-resist"; }
    showBanner(bannerAttacker.name+" — "+word, kind);
  }

  // logs for attacks
  if(youLocked){
    roundNote.push("🔒 <b>"+you.name+"</b> is locked down by Lux Nihilium's aftershock and cannot act!");
  } else if(youHit){
    roundNote.push(effLine(you, cpu, youMove, youHit));
  }
  if(cpuLocked){
    roundNote.push("🔒 <b>"+cpu.name+"</b> is locked down and cannot act!");
  } else if(cpuHit){
    roundNote.push(effLine(cpu, you, cpuMove, cpuHit));
  }

  await wait(1600);

  // decrement paralysis / recharge counters
  if(you.paralyzedTurns>0) you.paralyzedTurns--;
  if(cpu.paralyzedTurns>0) cpu.paralyzedTurns--;
  if(you.rechargeTurns>0) you.rechargeTurns--;
  if(cpu.rechargeTurns>0) cpu.rechargeTurns--;

  // handle special move side-effects (only when actually used this round, not during recharge)
  var specialPairs = [
    {f:you, hit:youHit, mv:youMove, o:cpu, locked:youLocked},
    {f:cpu, hit:cpuHit, mv:cpuMove, o:you, locked:cpuLocked}
  ];
  for(var si=0; si<specialPairs.length; si++){
    var pair = specialPairs[si];
    var pf=pair.f, pmv=pair.mv, po=pair.o;
    if(pair.locked || !pmv || !pf.special || pmv !== pf.special) continue;
    var peff = pf.special.effect;
    if(peff === "dot_heal"){
      pf.dotHeal = {dot:pf.special.dot, heal:pf.special.heal};
      roundNote.push("🌑 A curse of nightmare energy settles over <b>"+po.name+"</b>.");
      showBanner(pf.special.name.toUpperCase(), "lock");
      await wait(1200);
    } else if(peff === "clone"){
      var count = pf.special.cloneCount;
      var newClones = [];
      for(var i=0;i<count;i++){
        newClones.push({hp: Math.round(pf.maxHp*pf.special.cloneHpFrac), maxHp: Math.round(pf.maxHp*pf.special.cloneHpFrac)});
      }
      pf.clones = pf.clones.concat(newClones);
      roundNote.push("💧 Two shimmering clones of <b>"+pf.name+"</b> spring from the shockwave!");
      renderFighter(pf, pf.side==="you"?youPanel:cpuPanel, pf.side==="you"?"You":"Rival");
      showBanner("CLONES SUMMONED!", "clone");
      await wait(1200);
    } else if(peff === "aoe_paralyze_recharge"){
      pf.rechargeTurns = pf.special.recharge;
      if(po.clones && po.clones.length){
        po.clones.forEach(function(c){
          if(c.hp>0){ var d = Math.round(pf.special.power*0.6*rand(0.9,1.1)); c.hp = Math.max(0,c.hp-d); }
        });
        roundNote.push("💥 The shockwave rips through every clone on the field.");
      }
      if(Math.random() < pf.special.paralyzeChance){
        po.paralyzedTurns = pf.special.paralyzeRounds;
        roundNote.push("🌀 <b>"+po.name+"</b> is caught in the lockdown field and can't move for "+pf.special.paralyzeRounds+" turns!");
        showBanner(po.name+" LOCKED DOWN!", "lock");
        await wait(1200);
      }
    } else if(peff === "power_surge"){
      pf.boostMult = (pf.boostMult||1) + pf.special.boost;
      if(pf.special.bonusType){
        var bonus = Math.round(pf.special.bonusPower * rand(0.9,1.15) * effectiveness(pf.special.bonusType, po.types));
        applyDamage(po, bonus);
        roundNote.push("⚡ A secondary "+cap(pf.special.bonusType)+" surge slams <b>"+po.name+"</b> for "+bonus+" more damage!");
      }
      roundNote.push("🔋 <b>"+pf.name+"</b>'s power keeps surging (now ×"+pf.boostMult.toFixed(2)+").");
      showBanner("POWER SURGING!", "clone");
      await wait(1050);
    } else if(peff === "burst"){
      roundNote.push("🌌 The rift's aftershock fades, leaving <b>"+pf.name+"</b> in its unbound form.");
    }
  }

  // clone strike pass (uses parent's base move & special.cloneDmgFrac)
  [{f:you,o:cpu,side:"cpu"},{f:cpu,o:you,side:"you"}].forEach(function(pair){
    var f=pair.f, o=pair.o;
    if(f.clones && f.clones.length && f.special && f.special.cloneDmgFrac){
      var aliveClones = f.clones.filter(function(c){return c.hp>0;});
      if(aliveClones.length){
        var perClone = Math.round(f.move.power * f.special.cloneDmgFrac * effectiveness(f.move.type, o.types) * rand(0.9,1.1));
        var total = perClone * aliveClones.length;
        if(total>0){
          var beforeHp = o.hp;
          var cFrom = getPortraitCenter(f.side), cTo = getPortraitCenter(pair.side);
          var cColor1 = (f.halo&&f.halo[0]) || TYPE_COLOR[f.move.type], cColor2 = (f.halo&&f.halo[2]) || "#22d3ee";
          showBanner(aliveClones.length+"x CLONE STRIKE!", "clone");
          playDualFx({
            duration: 900,
            draw: function(ctx,p,w,h){
              for(var ci=0; ci<aliveClones.length; ci++){
                var stagger = Math.max(0, Math.min(1, (p - ci*0.16) / (1 - ci*0.16)));
                if(stagger<=0) continue;
                drawShurikens(ctx, cFrom, cTo, stagger, cColor1, cColor2);
              }
            }
          }, null);
          applyDamage(o, total);
          popDamage(pair.side, "-"+total, "");
          shakePortrait(pair.side, dmgTier(total));
          flashHit(pair.side, cColor1);
          animateHpBar(pair.side, beforeHp, o.hp, o.maxHp);
          roundNote.push("🥷 "+aliveClones.length+" clone(s) of <b>"+f.name+"</b> strike <b>"+o.name+"</b> for "+total+" combined damage!");
        }
      }
    }
  });
  await wait(1250);

  // dot/heal tick (applies from the round AFTER activation, and also mildly on activation round for immediate feedback)
  // — guarded against reviving a fighter that was already knocked to 0 HP with no lives left earlier
  // THIS SAME turn (in the impact section above): without this check, Darkrai's own Void Curse heal
  // could quietly bring it back after a lethal hit, so the match never actually ended even though the
  // final HP/lives check further down should have called it a loss.
  var dotHealTicked = false;
  [{f:you,o:cpu,oside:"cpu",fside:"you"},{f:cpu,o:you,oside:"you",fside:"cpu"}].forEach(function(pair){
    var f=pair.f, o=pair.o;
    if(f.dotHeal && f.hp<=0 && f.lives<=0){
      // the curse's caster has already fallen this turn — the curse dies with it, no self-heal
      f.dotHeal = null;
      return;
    }
    if(f.dotHeal){
      dotHealTicked = true;
      var oBefore = o.hp, fBefore = f.hp;
      applyDamage(o, f.dotHeal.dot);
      f.hp = Math.min(f.maxHp, f.hp + f.dotHeal.heal);
      popDamage(pair.oside, "-"+f.dotHeal.dot, "");
      popDamage(pair.fside, "+"+f.dotHeal.heal, "heal");
      animateHpBar(pair.oside, oBefore, o.hp, o.maxHp);
      animateHpBar(pair.fside, fBefore, f.hp, f.maxHp);
      flashHit(pair.oside, (f.halo&&f.halo[0])||"#a21caf");
      flashHit(pair.fside, (f.halo&&f.halo[2])||"#f472b6");
      shakePortrait(pair.oside, "low");
      playDualFx(buildDrainTickFxJob(pair.oside, pair.fside, f.halo), null);
      sfxVoidDrainTick(pair.oside, pair.fside);
      roundNote.push("🩸 The Void Curse saps "+f.dotHeal.dot+" HP from <b>"+o.name+"</b> and mends "+f.dotHeal.heal+" HP on <b>"+f.name+"</b>.");
    }
  });
  await wait(dotHealTicked ? 1150 : 900);

  if(youRevived){ roundNote.push("✨ <b>"+you.name+"</b> burns its extra life and holds on!"); showBanner(you.name+" — EXTRA LIFE!", "life"); await wait(1150); }
  if(cpuRevived){ roundNote.push("✨ <b>"+cpu.name+"</b> burns its extra life and holds on!"); showBanner(cpu.name+" — EXTRA LIFE!", "life"); await wait(1150); }

  addLog("<b>— Turn "+state.round+" —</b>");
  roundNote.forEach(function(n){ addLog(n); });

  renderFighter(you, youPanel, "You");
  renderFighter(cpu, cpuPanel, "Rival");
  renderRoundTrack();
  updateBattleTension();

  state.resolving = false;

  // check match end — no round cap: the duel just keeps going, turn after turn, until someone's
  // HP (and any extra lives) run out
  var youDead = you.hp<=0 && you.lives<=0;
  var cpuDead = cpu.hp<=0 && cpu.lives<=0;
  if(youDead || cpuDead){
    endMatch(youDead, cpuDead);
  } else {
    renderActions();
  }
}

function effLine(attacker, defender, move, hit){
  var effWord = hit.eff >= 2 ? "<b style=\"color:var(--good)\">super effective</b>" :
                hit.eff === 0 ? "<b style=\"color:var(--text-faint)\">no effect</b>" :
                hit.eff < 1 ? "<b style=\"color:var(--bad)\">resisted</b>" : "effective";
  return "<b>"+attacker.name+"</b> uses <b>"+move.name+"</b> — "+effWord+" — "+hit.dmg+" damage to "+defender.name+".";
}

function endMatch(youDead, cpuDead){
  state.matchOver = true;
  renderRoundTrack();
  renderActions();
  setMusicTension(false);

  // true = you win, false = rival wins, null = a simultaneous mutual knockout — genuinely rare, but
  // possible now that both sides trade hits every single turn until one of them drops
  var playerWon = (youDead && cpuDead) ? null : cpuDead;

  var title = document.getElementById("result-title");
  var eyebrow = document.getElementById("result-eyebrow");
  var sub = document.getElementById("result-sub");
  var card = document.getElementById("result-card");
  var portraitImg = document.getElementById("result-portrait-img");
  var statsEl = document.getElementById("result-stats");

  var youPct = Math.max(0, Math.round((state.you.hp/state.you.maxHp)*100));
  var cpuPct = Math.max(0, Math.round((state.cpu.hp/state.cpu.maxHp)*100));

  var statsHTML =
    '<span class="result-stat">Turns fought <b>'+state.round+'</b></span>'+
    '<span class="result-stat'+(playerWon===true?' good':'')+'">Your HP left <b>'+youPct+'%</b></span>'+
    '<span class="result-stat'+(playerWon===false?' bad':'')+'">Rival HP left <b>'+cpuPct+'%</b></span>';
  statsEl.innerHTML = statsHTML;

  if(playerWon === true){
    title.textContent = state.you.name + " wins the duel!";
    title.className = "win";
    eyebrow.textContent = "Victory";
    sub.textContent = "The portal seals in your favor after "+state.round+" turns against "+state.cpu.name+".";
    addLog("<b>"+state.you.name+"</b> wins the duel! ✦");
    card.className = "result-card win";
    portraitImg.src = state.you.img;
    portraitImg.alt = state.you.name;
    launchConfetti();
    sfxUiVictory();
  } else if(playerWon === false){
    title.textContent = state.cpu.name + " takes the duel";
    title.className = "lose";
    eyebrow.textContent = "Defeat";
    sub.textContent = "The rival's portal held stronger this time. Open a new one and try again.";
    addLog("<b>"+state.cpu.name+"</b> wins the duel.");
    card.className = "result-card lose";
    portraitImg.src = state.cpu.img;
    portraitImg.alt = state.cpu.name;
    sfxUiDefeat();
  } else {
    title.textContent = "Both portals collapse at once";
    title.className = "draw";
    eyebrow.textContent = "Draw";
    sub.textContent = "Neither "+state.you.name+" nor "+state.cpu.name+" could land the final blow first — a true mutual knockout.";
    addLog("<b>"+state.you.name+"</b> and <b>"+state.cpu.name+"</b> fall in the same turn — a draw.");
    card.className = "result-card draw";
    portraitImg.src = state.you.img;
    portraitImg.alt = state.you.name;
    sfxUiDraw();
  }

  resultScreen.classList.add("show");
}

