---
// Hoopa Portal Arena — single-file Astro page (all game state runs client-side, no server logic needed).
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hoopa Portal Arena</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
  :root{
    --bg:#0a0714;
    --bg-1:#0f0b1d;
    --surface:#171029;
    --surface-2:#1f1636;
    --surface-3:#291d47;
    --line:rgba(232,220,255,0.10);
    --line-strong:rgba(232,220,255,0.20);
    --magenta:#c026d3;
    --magenta-2:#e879f9;
    --gold:#f5c518;
    --gold-2:#ffe083;
    --cyan:#22d3ee;
    --text:#f4eefc;
    --text-dim:#b3a3cf;
    --text-faint:#7c6c9c;
    --good:#34d399;
    --warn:#fbbf24;
    --bad:#fb7185;
    --r-sm:10px;
    --r-md:16px;
    --r-lg:26px;
    --shadow-glow: 0 0 60px rgba(192,38,211,0.25);
    --font-display:'Orbitron', 'Segoe UI', sans-serif;
    --font-body:'Sora', 'Segoe UI', sans-serif;
  }

  /* ---------- light mode: Hoopa's ring opens a portal onto a brighter Lumiose sky ----------
     Same hyperspace palette (magenta / gold / cyan) deepened for contrast on a pale, warm-white
     backdrop, so the arena reads as the same world in daylight rather than an unrelated skin. */
  :root[data-theme="light"]{
    --bg:#f8f4fb;
    --bg-1:#ffffff;
    --surface:#ffffff;
    --surface-2:#f4edfb;
    --surface-3:#ece0f7;
    --line:rgba(74,36,110,0.12);
    --line-strong:rgba(74,36,110,0.22);
    --magenta:#a21caf;
    --magenta-2:#c026d3;
    --gold:#a9720b;
    --gold-2:#c4890f;
    --cyan:#0e7490;
    --text:#1c1229;
    --text-dim:#5b4a78;
    --text-faint:#8577a0;
    --good:#047857;
    --warn:#b45309;
    --bad:#dc2626;
    --shadow-glow: 0 0 60px rgba(192,38,211,0.14);
  }
  :root[data-theme="light"] body{
    background:
      radial-gradient(1100px 620px at 82% -8%, rgba(192,38,211,0.12), transparent 60%),
      radial-gradient(900px 560px at 6% 8%, rgba(34,211,238,0.10), transparent 55%),
      radial-gradient(1400px 900px at 50% 120%, rgba(245,197,24,0.10), transparent 60%),
      var(--bg);
  }
  :root[data-theme="light"] .bg-aurora{
    background:
      radial-gradient(900px 600px at 20% 20%, rgba(192,38,211,0.12), transparent 60%),
      radial-gradient(800px 600px at 80% 30%, rgba(34,211,238,0.10), transparent 60%),
      radial-gradient(1000px 700px at 50% 95%, rgba(245,197,24,0.10), transparent 60%);
    background-size:220% 220%;
  }
  :root[data-theme="light"] .bg-grain{opacity:0.025;mix-blend-mode:multiply;}
  :root[data-theme="light"] .nav{background:rgba(255,255,255,0.72);}
  :root[data-theme="light"] .result-screen{background:linear-gradient(180deg, rgba(255,255,255,0.92), rgba(244,237,251,0.98));}
  :root[data-theme="light"] .hero-particles-canvas, :root[data-theme="light"] #hero-particles{opacity:0.7;}
  /* the hero title's gradient starts at solid white for contrast against the dark hero band — swap
     that stop for a deep portal-violet in light mode, where white-on-near-white would vanish */
  :root[data-theme="light"] .hero h1{
    /* background-image (not the `background` shorthand) so this doesn't silently reset
       background-clip back to its border-box default and break the text-clip effect */
    background-image:linear-gradient(120deg,#2c1444 6%, var(--gold-2) 42%, var(--magenta-2) 74%, var(--cyan) 100%);
  }

  /* the portal-wipe transition itself: when the browser supports View Transitions, the incoming theme
     is clipped to a circle that blooms outward from wherever the ring was tapped (set inline via JS on
     document.documentElement.animate against ::view-transition-new(root)); everywhere else, fall back to
     a plain, fast crossfade so switching theme never looks broken, just less theatrical. */
  ::view-transition-old(root), ::view-transition-new(root){
    animation-duration:0.5s;
    mix-blend-mode:normal;
  }
  ::view-transition-old(root){ animation: none; }
  ::view-transition-new(root){ animation: none; }
  @media (prefers-reduced-motion: reduce){
    ::view-transition-old(root), ::view-transition-new(root){ animation:none !important; }
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  html,body{background:var(--bg);}
  body{
    margin:0;
    font-family:var(--font-body);
    color:var(--text);
    background:
      radial-gradient(1100px 620px at 82% -8%, rgba(192,38,211,0.24), transparent 60%),
      radial-gradient(900px 560px at 6% 8%, rgba(34,211,238,0.14), transparent 55%),
      radial-gradient(1400px 900px at 50% 120%, rgba(245,197,24,0.08), transparent 60%),
      var(--bg);
    padding-inline:0;
    overflow-x:hidden;
  }
  img{max-width:100%;}
  [hidden]{display:none!important;}
  .bg-aurora{
    position:fixed;inset:0;z-index:-2;pointer-events:none;
    background:
      radial-gradient(900px 600px at 20% 20%, rgba(192,38,211,0.20), transparent 60%),
      radial-gradient(800px 600px at 80% 30%, rgba(34,211,238,0.15), transparent 60%),
      radial-gradient(1000px 700px at 50% 95%, rgba(245,197,24,0.11), transparent 60%);
    background-size:220% 220%;
    animation:auroraDrift 28s ease-in-out infinite;
  }
  @keyframes auroraDrift{
    0%,100%{background-position:0% 10%, 100% 0%, 50% 100%;}
    50%{background-position:35% 45%, 65% 55%, 55% 70%;}
  }
  .bg-grain{
    position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:0.035;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='120' height='120'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  @media (prefers-reduced-motion: reduce){ .bg-aurora{animation:none;} }
  h1,h2,h3,h4{font-family:var(--font-display);margin:0;text-wrap:balance;letter-spacing:0.01em;}
  p{margin:0;}
  button{font-family:var(--font-body);}
  ::selection{background:var(--magenta);color:#fff;}

  .wrap{max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,4vw,40px);}

  .eyebrow{
    font-family:var(--font-display);
    font-size:11.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--gold);
    display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:"";width:22px;height:2px;background:linear-gradient(90deg,var(--gold),transparent);}

  /* ---------- NAV ---------- */
  .nav{
    position:sticky;top:0;z-index:50;
    padding:14px clamp(16px,4vw,40px);
    padding-top:calc(14px + env(safe-area-inset-top,0px));
    display:flex;align-items:center;justify-content:space-between;
    backdrop-filter:blur(14px) saturate(140%);
    background:rgba(10,7,20,0.65);
    border-bottom:1px solid var(--line);
  }
  .nav-progress{
    position:absolute;left:0;bottom:-1px;height:2px;width:0%;
    background:linear-gradient(90deg,var(--magenta-2),var(--gold),var(--cyan));
    box-shadow:0 0 10px rgba(232,121,249,0.6);transition:width .08s linear;
  }
  .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:15px;letter-spacing:0.06em;}
  .brand .ring{width:22px;height:22px;border-radius:50%;border:3px solid var(--gold);position:relative;box-shadow:0 0 14px rgba(245,197,24,0.6);animation:brandpulse 2.6s ease-in-out infinite;}
  .brand .ring::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:1.5px solid var(--magenta-2);opacity:0.7;animation:spin 9s linear infinite;}
  @keyframes brandpulse{0%,100%{box-shadow:0 0 14px rgba(245,197,24,0.6);}50%{box-shadow:0 0 20px rgba(245,197,24,0.9);}}
  @media (prefers-reduced-motion: reduce){ .brand .ring, .brand .ring::after{animation:none;} }

  /* ---------- theme-toggle ring button (click Hoopa's ring to flip the arena's light) ---------- */
  .ring-toggle{
    position:relative;display:inline-flex;align-items:center;justify-content:center;
    background:none;border:none;padding:6px;margin:-6px;border-radius:50%;cursor:pointer;
    -webkit-tap-highlight-color:transparent;
  }
  .ring-toggle .ring{transition:transform .3s cubic-bezier(.34,1.56,.64,1);}
  .ring-toggle:hover .ring{box-shadow:0 0 22px rgba(245,197,24,0.95);}
  .ring-toggle:active .ring{transform:scale(0.86);}
  .ring-toggle:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
  .ring-toggle::before{
    content:"";position:absolute;inset:-12px;border-radius:50%;pointer-events:none;
    background:radial-gradient(circle, rgba(245,197,24,0.55), rgba(232,121,249,0.25) 45%, transparent 72%);
    opacity:0;transform:scale(0.25);
  }
  .ring-toggle.bursting::before{animation:ringPortalBurst .75s cubic-bezier(.16,.8,.3,1);}
  .ring-toggle.bursting .ring{animation:ringPortalSpin .75s cubic-bezier(.3,.9,.2,1);}
  @keyframes ringPortalBurst{0%{opacity:0.95;transform:scale(0.25);}100%{opacity:0;transform:scale(3.6);}}
  @keyframes ringPortalSpin{0%{transform:scale(1) rotate(0deg);}45%{transform:scale(1.35) rotate(190deg);}100%{transform:scale(1) rotate(360deg);}}
  @media (prefers-reduced-motion: reduce){ .ring-toggle.bursting::before, .ring-toggle.bursting .ring{animation:none;} }
  .navlinks{display:flex;gap:26px;font-size:13px;color:var(--text-dim);}
  .navlinks a{color:inherit;text-decoration:none;transition:color .2s;position:relative;padding-bottom:2px;}
  .navlinks a:hover{color:var(--gold-2);}
  .navlinks a::after{
    content:"";position:absolute;left:0;right:100%;bottom:-4px;height:1.5px;
    background:linear-gradient(90deg,var(--gold),var(--magenta-2));transition:right .3s cubic-bezier(.2,.8,.2,1);
  }
  .navlinks a.active{color:var(--gold-2);}
  .navlinks a.active::after{right:0;}
  @media (max-width:620px){.navlinks{display:none;}}

  .music-toggle{
    display:flex;align-items:center;gap:7px;
    background:var(--surface);border:1px solid var(--line);border-radius:999px;
    padding:7px 13px 7px 11px;color:var(--text-dim);cursor:pointer;
    font-family:var(--font-display);font-size:10.5px;letter-spacing:0.06em;text-transform:uppercase;
    transition:border-color .25s, color .25s, box-shadow .25s;
  }
  .music-toggle:hover{border-color:var(--line-strong);color:var(--text);}
  .music-toggle svg{flex-shrink:0;}
  .music-toggle .music-bars{display:flex;align-items:flex-end;gap:2px;height:11px;}
  .music-toggle .music-bars i{display:block;width:2px;height:4px;border-radius:1px;background:currentColor;opacity:0.5;}
  .music-toggle.playing{color:var(--gold-2);border-color:rgba(245,197,24,0.45);box-shadow:0 0 16px -4px rgba(245,197,24,0.5);}
  .music-toggle.playing .music-bars i{opacity:1;animation:musicbar 0.9s ease-in-out infinite;}
  .music-toggle.playing .music-bars i:nth-child(1){animation-delay:-0.6s;}
  .music-toggle.playing .music-bars i:nth-child(2){animation-delay:-0.3s;}
  .music-toggle.playing .music-bars i:nth-child(3){animation-delay:0s;}
  @keyframes musicbar{0%,100%{height:4px;}50%{height:11px;}}
  @media (max-width:480px){.music-toggle .music-label{display:none;}.music-toggle{padding:8px;}}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    padding-top:clamp(52px,9vw,88px);
    padding-bottom:56px;
    overflow:hidden;
  }
  .hero-inner{
    display:grid;grid-template-columns:1.05fr 0.95fr;gap:36px;align-items:center;
  }
  @media (max-width:880px){.hero-inner{grid-template-columns:1fr;}}

  .hero h1{
    font-size:clamp(40px,6.6vw,74px);
    line-height:0.98;
    font-weight:900;
    background:linear-gradient(120deg,#fff 10%, var(--gold-2) 45%, var(--magenta-2) 75%, var(--cyan) 100%);
    background-size:180% auto;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 4px 30px rgba(192,38,211,0.25));
    margin-top:14px;
  }
  .hero p.lead{
    margin-top:18px;max-width:52ch;color:var(--text-dim);font-size:16.5px;line-height:1.6;
  }
  .hero-cta{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap;}

  @keyframes heroIn{
    0%{opacity:0;transform:translateY(18px);}
    100%{opacity:1;transform:translateY(0);}
  }
  .hero .eyebrow{animation:heroIn .7s cubic-bezier(.16,.8,.3,1) both;}
  .hero h1{animation:heroIn .8s cubic-bezier(.16,.8,.3,1) .08s both, gradientshift 7s ease-in-out 1s infinite;}
  .hero p.lead{animation:heroIn .8s cubic-bezier(.16,.8,.3,1) .18s both;}
  .hero-cta{animation:heroIn .8s cubic-bezier(.16,.8,.3,1) .28s both;}
  .stat-strip{animation:heroIn .8s cubic-bezier(.16,.8,.3,1) .38s both;}
  .portal-stage{animation:heroIn 1s cubic-bezier(.16,.8,.3,1) .15s both;}
  @keyframes gradientshift{
    0%,100%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
  }
  @media (prefers-reduced-motion: reduce){
    .hero .eyebrow, .hero h1, .hero p.lead, .hero-cta, .stat-strip, .portal-stage{animation:none;}
  }

  .btn{
    appearance:none;border:none;cursor:pointer;position:relative;overflow:hidden;
    font-family:var(--font-display);font-weight:700;font-size:12.5px;letter-spacing:0.08em;text-transform:uppercase;
    padding:15px 26px;border-radius:999px;
    display:inline-flex;align-items:center;gap:10px;
    transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s, filter .2s;
  }
  .btn:active{transform:scale(0.96);}
  .btn-primary{
    color:#1a0a1f;background:linear-gradient(120deg,var(--gold),var(--magenta-2));
    box-shadow:0 10px 30px rgba(192,38,211,0.35), 0 0 0 1px rgba(255,255,255,0.15) inset;
  }
  .btn-primary::after{
    content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
    transform:skewX(-18deg);transition:left .55s ease;
  }
  .btn-primary:hover::after{left:130%;}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(192,38,211,0.48);}
  .btn-ghost{
    color:var(--text);background:rgba(255,255,255,0.04);border:1px solid var(--line-strong);
  }
  .btn-ghost:hover{background:rgba(255,255,255,0.08);border-color:var(--magenta-2);}
  .btn:disabled{opacity:0.35;cursor:not-allowed;filter:grayscale(0.4);transform:none!important;box-shadow:none!important;}

  .portal-stage{
    position:relative;aspect-ratio:1/1;max-width:440px;margin-inline:auto;width:100%;
    transform-style:preserve-3d;perspective:700px;
  }
  .portal-tilt{
    width:100%;height:100%;position:relative;
    transition:transform .3s cubic-bezier(.2,.8,.2,1);
    transform-style:preserve-3d;
  }
  .portal-stage canvas{position:absolute;inset:0;width:100%;height:100%;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .portal-core{
    position:absolute;inset:0;margin:auto;width:30%;height:30%;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff, var(--gold) 30%, var(--magenta) 70%, #2a0a33 100%);
    box-shadow:0 0 70px 10px rgba(192,38,211,0.5), 0 0 130px 40px rgba(245,197,24,0.2);
    animation:pulse 3.2s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.06);}}

  .portal-hoopa{
    position:absolute;inset:0;margin:auto;width:56%;height:56%;z-index:5;
    display:flex;align-items:center;justify-content:center;pointer-events:none;
    animation:hoopa-float 4.6s ease-in-out infinite;
  }
  .portal-hoopa img{
    width:100%;height:100%;object-fit:contain;
    filter:drop-shadow(0 0 26px rgba(245,197,24,0.55)) drop-shadow(0 18px 30px rgba(0,0,0,0.55));
  }
  @keyframes hoopa-float{
    0%,100%{transform:translateY(0) rotate(-1.5deg);}
    50%{transform:translateY(-10px) rotate(1.5deg);}
  }

  .stat-strip{
    display:flex;gap:26px;margin-top:38px;flex-wrap:wrap;
  }
  .stat-strip div{display:flex;flex-direction:column;gap:2px;}
  .stat-strip b{font-family:var(--font-display);font-size:22px;color:var(--gold-2);}
  .stat-strip span{font-size:11px;color:var(--text-faint);letter-spacing:0.06em;text-transform:uppercase;}

  /* ---------- SECTION HEADERS ---------- */
  section{padding-block:64px;}
  .sec-head{max-width:640px;margin-bottom:38px;}
  .sec-head h2{font-size:clamp(26px,3.6vw,38px);margin-top:10px;}
  .sec-head p{color:var(--text-dim);margin-top:12px;font-size:15px;line-height:1.6;}

  /* ---------- SCROLL REVEAL ---------- */
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.16,.8,.3,1), transform .7s cubic-bezier(.16,.8,.3,1);}
  .reveal.in{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){ .reveal{opacity:1;transform:none;transition:none;} }

  /* ---------- POKÉMON SELECT ---------- */
  .roster{
    display:grid;grid-template-columns:repeat(5,1fr);gap:16px;
  }
  @media (max-width:980px){.roster{grid-template-columns:repeat(3,1fr);}}
  @media (max-width:620px){.roster{grid-template-columns:repeat(2,1fr);}}

  .mon-card{
    position:relative;border-radius:var(--r-md);
    background:linear-gradient(180deg,var(--surface),var(--surface-2));
    border:1px solid var(--line);padding:16px 16px 18px;
    cursor:pointer;text-align:center;
    display:flex;flex-direction:column;
    overflow:hidden;
    transition:transform .35s cubic-bezier(.2,.8,.2,1), border-color .25s, box-shadow .35s;
    transform-style:preserve-3d;perspective:600px;
  }
  .mon-card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:3px;
    background:linear-gradient(90deg, var(--accent, var(--gold)), var(--accent2, var(--accent, var(--magenta-2))));
    opacity:0;transition:opacity .3s;
  }
  .mon-card:hover::before, .mon-card.selected::before{opacity:1;}
  .mon-card:hover{transform:translateY(-5px);border-color:var(--accent, var(--line-strong));box-shadow:0 20px 44px rgba(0,0,0,0.42), 0 0 30px -8px var(--accent, transparent);}
  .mon-card.selected{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold), 0 20px 48px rgba(245,197,24,0.24);}
  .mon-card .art-wrap{
    aspect-ratio:1/1;border-radius:var(--r-sm);
    background:radial-gradient(circle at 50% 30%, rgba(192,38,211,0.22), transparent 70%), var(--surface-3);
    display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:12px;
    position:relative;
    box-shadow:inset 0 0 0 1px var(--line);
    transition:box-shadow .3s;
  }
  .mon-card:hover .art-wrap, .mon-card.selected .art-wrap{box-shadow:inset 0 0 0 1px var(--accent, var(--line-strong)), 0 0 26px -8px var(--accent, transparent);}
  .mon-card .art-wrap img{width:80%;height:80%;object-fit:contain;filter:drop-shadow(0 8px 18px rgba(0,0,0,0.5));transition:transform .4s;}
  .mon-card:hover .art-wrap img{transform:scale(1.07) translateY(-3px);}
  .mon-card .pick-check{
    position:absolute;top:9px;left:9px;z-index:3;width:22px;height:22px;border-radius:50%;
    background:var(--gold);color:#1a0a1f;display:flex;align-items:center;justify-content:center;
    font-size:13px;font-weight:900;box-shadow:0 4px 12px rgba(245,197,24,0.5);
    opacity:0;transform:scale(0.5);transition:opacity .25s, transform .25s cubic-bezier(.34,1.56,.64,1);
  }
  .mon-card.selected .pick-check{opacity:1;transform:scale(1);}
  .mon-card h3{font-size:15px;letter-spacing:0.02em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .mon-card .sub{font-size:10.5px;color:var(--text-faint);margin-top:2px;text-transform:uppercase;letter-spacing:0.08em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .typebadges{display:flex;gap:5px;justify-content:center;margin-top:9px;flex-wrap:wrap;}
  .typebadge{
    font-family:var(--font-display);font-size:9px;letter-spacing:0.05em;text-transform:uppercase;
    padding:4px 9px;border-radius:999px;color:#1a0a1f;font-weight:700;
  }
  .mon-card .mini-stats{display:flex;gap:8px;margin-top:12px;}
  .mon-card .ms-chip{
    flex:1;min-width:0;background:var(--surface-3);border:1px solid var(--line);border-radius:10px;
    padding:7px 9px;text-align:left;
  }
  .mon-card .ms-chip .ms-k{
    display:block;font-size:8.5px;font-family:var(--font-display);letter-spacing:0.08em;text-transform:uppercase;
    color:var(--text-faint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .mon-card .ms-chip .ms-v{display:block;font-size:12px;color:var(--text-dim);font-weight:600;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .mon-card .ms-chip.move .ms-v{color:var(--gold-2);}
  .mon-card .mon-move-desc{
    font-size:10.5px;color:var(--text-faint);line-height:1.55;margin-top:10px;text-align:left;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  .mon-card .mega-tag{
    position:absolute;top:9px;right:9px;z-index:2;font-size:8.5px;font-family:var(--font-display);
    background:rgba(245,197,24,0.18);color:var(--gold-2);border:1px solid rgba(245,197,24,0.45);
    padding:4px 8px;border-radius:999px;letter-spacing:0.05em;backdrop-filter:blur(4px);
    display:flex;align-items:center;gap:3px;
  }
  .mon-card .mega-tag::before{content:"✦";font-size:9px;}

  .select-bar{
    margin-top:26px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:10px 10px 10px 22px;
  }
  .select-bar .info{font-size:13.5px;color:var(--text-dim);}
  .select-bar .info b{color:var(--gold-2);}

  /* ---------- ARENA ---------- */
  .arena-shell{
    border-radius:var(--r-lg);
    background:linear-gradient(180deg, var(--surface), var(--bg-1));
    border:1px solid var(--line);
    padding:clamp(18px,3.4vw,36px);
    position:relative;overflow:hidden;
    box-shadow:inset 0 0 0 0 transparent;transition:box-shadow 1.1s ease;
  }
  /* a soft vignette closing in around the edges deepens the spotlight already put on the transforming
     fighter, without needing another pseudo-element layer */
  .arena-shell.mega-cinematic{box-shadow:inset 0 0 130px 30px rgba(4,2,10,0.55);}
  @media (prefers-reduced-motion: reduce){ .arena-shell{transition:none;} }
  .arena-shell::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(700px 300px at 50% -10%, rgba(192,38,211,0.16), transparent 70%);
    animation:arenaGlow 6s ease-in-out infinite;
  }
  @keyframes arenaGlow{0%,100%{opacity:0.7;}50%{opacity:1;}}
  @media (prefers-reduced-motion: reduce){ .arena-shell::before{animation:none;} }
  .arena-shell.shake-big{animation:bigshake .5s cubic-bezier(.36,.07,.19,.97);}

  .arena-shell.mega-pulse::after{
    content:"";position:absolute;inset:0;z-index:21;pointer-events:none;border-radius:inherit;
    background:radial-gradient(circle at 50% 50%, var(--mp, #fff) 0%, transparent 70%);
    opacity:0;animation:arenapulse .7s ease-out;
  }
  @keyframes arenapulse{
    0%{opacity:0.55;}
    100%{opacity:0;}
  }

  /* CINEMATIC FRAMING — a clean, single-gesture way to say "this moment matters" without adding any
     more visual clutter: two bars close in from the top and bottom like a widescreen crop, and the
     whole arena eases into a very slight push-in, exactly like a film would frame a key beat. */
  .cinema-bar{
    position:absolute;left:0;right:0;height:15%;z-index:24;pointer-events:none;
    background:linear-gradient(180deg, rgba(6,4,12,0.97), rgba(6,4,12,0.75));
    transform:translateY(-100%);transition:transform .6s cubic-bezier(.16,.8,.24,1);
  }
  .cinema-bar-top{top:0;}
  .cinema-bar-bottom{bottom:0;background:linear-gradient(0deg, rgba(6,4,12,0.97), rgba(6,4,12,0.75));transform:translateY(100%);}
  .arena-shell.mega-cinematic .cinema-bar-top{transform:translateY(0);}
  .arena-shell.mega-cinematic .cinema-bar-bottom{transform:translateY(0);}
  .arena-shell .versus-grid{transition:transform 1.1s cubic-bezier(.16,.8,.24,1);}
  .arena-shell.mega-cinematic .versus-grid{transform:scale(1.014);}
  @media (prefers-reduced-motion: reduce){
    .cinema-bar{transition:none;}
    .arena-shell .versus-grid{transition:none;}
    .arena-shell.mega-cinematic .versus-grid{transform:none;}
  }
  @keyframes bigshake{
    10%,90%{transform:translate3d(-1px,0,0);}
    20%,80%{transform:translate3d(3px,0,0);}
    30%,50%,70%{transform:translate3d(-6px,0,0);}
    40%,60%{transform:translate3d(6px,0,0);}
  }

  #fx-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:22;}

  .fx-banner{
    position:absolute;top:38%;left:50%;transform:translate(-50%,-50%) scale(0.6);
    z-index:25;font-family:var(--font-display);font-weight:900;text-align:center;
    pointer-events:none;opacity:0;white-space:nowrap;
    text-shadow:0 4px 26px rgba(0,0,0,0.65);letter-spacing:0.03em;
  }
  .fx-banner.show{animation:fxpunch 1.5s cubic-bezier(.2,.85,.25,1.1) forwards;}
  @keyframes fxpunch{
    0%{opacity:0;transform:translate(-50%,-50%) scale(0.4) rotate(-3deg);}
    16%{opacity:1;transform:translate(-50%,-50%) scale(1.16) rotate(1.5deg);}
    32%{transform:translate(-50%,-50%) scale(1) rotate(0deg);}
    78%{opacity:1;}
    100%{opacity:0;transform:translate(-50%,-50%) scale(0.94) translateY(-6px);}
  }
  .fx-round{color:var(--text-dim);font-size:clamp(15px,2.2vw,19px);letter-spacing:0.16em;text-transform:uppercase;}
  /* a quieter, more "title card" treatment for the pre-transformation line — thin rule lines draw
     outward from the text instead of the usual punchy scale-in, so the moment reads as deliberate
     rather than just another impact banner */
  .fx-transform{
    color:var(--text);font-size:clamp(13px,2vw,16px);letter-spacing:0.34em;
    text-transform:uppercase;font-weight:700;padding:0 4px;
    /* deliberately no position here — .fx-banner already sets position:absolute on this same element,
       and redeclaring it (even as "relative") would collide with that rule at equal specificity and
       could win on source order, silently pulling the whole banner out of its intended placement */
  }
  /* the default banner position (38% down the whole arena-shell, actions/log included) lands right on
     top of the panel border once a transformation is in play — pull this one up so its title-card
     treatment sits cleanly over the header instead of straddling that edge */
  .fx-banner.fx-transform{top:15%;}
  .fx-transform::before, .fx-transform::after{
    content:"";position:absolute;top:50%;width:42px;height:1px;
    transform:translateY(-50%) scaleX(0);opacity:0;
  }
  .fx-transform::before{right:100%;margin-right:14px;transform-origin:right center;background:linear-gradient(90deg, transparent, var(--gold-2));}
  .fx-transform::after{left:100%;margin-left:14px;transform-origin:left center;background:linear-gradient(90deg, var(--gold-2), transparent);}
  .fx-banner.fx-transform.show::before, .fx-banner.fx-transform.show::after{animation:transformRule 1.5s cubic-bezier(.2,.85,.25,1.1) forwards;}
  @keyframes transformRule{
    0%{transform:translateY(-50%) scaleX(0);opacity:0;}
    22%{opacity:1;}
    42%{transform:translateY(-50%) scaleX(1);}
    78%{opacity:1;transform:translateY(-50%) scaleX(1);}
    100%{opacity:0;transform:translateY(-50%) scaleX(1);}
  }
  .fx-mega{
    font-size:clamp(22px,4.2vw,36px);
    background:linear-gradient(120deg,var(--gold),var(--magenta-2));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .fx-eff-super{color:var(--good);font-size:clamp(19px,3.4vw,29px);text-transform:uppercase;}
  .fx-eff-devastating{
    font-size:clamp(22px,4vw,33px);text-transform:uppercase;
    background:linear-gradient(120deg,var(--gold),var(--bad));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .fx-eff-none{color:var(--text-faint);font-size:clamp(17px,3vw,25px);text-transform:uppercase;}
  .fx-eff-resist{color:var(--bad);font-size:clamp(16px,2.6vw,22px);text-transform:uppercase;opacity:0.9;}
  .fx-clone{color:var(--cyan);font-size:clamp(17px,3vw,25px);text-transform:uppercase;}
  .fx-lock{color:var(--bad);font-size:clamp(17px,3vw,25px);text-transform:uppercase;}
  .fx-life{color:var(--magenta-2);font-size:clamp(17px,3vw,25px);text-transform:uppercase;}

  @media (max-width:520px){ .fx-banner{white-space:normal;max-width:88%;} }
  .arena-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px;flex-wrap:wrap;}
  .round-track{display:flex;gap:8px;align-items:center;}
  .turn-badge{
    display:flex;align-items:center;gap:7px;
    background:var(--surface);border:1px solid var(--line);border-radius:999px;
    padding:6px 13px;font-family:var(--font-display);font-size:11px;letter-spacing:0.08em;
    text-transform:uppercase;color:var(--text-dim);
  }
  .turn-badge b{color:var(--gold-2);font-size:13px;margin-left:2px;}
  .turn-badge-dot{width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px rgba(245,197,24,0.7);animation:turnpulse 1.8s ease-in-out infinite;}
  @keyframes turnpulse{0%,100%{opacity:0.5;transform:scale(0.85);}50%{opacity:1;transform:scale(1.1);}}
  .round-label{font-family:var(--font-display);font-size:11px;letter-spacing:0.1em;color:var(--text-faint);text-transform:uppercase;}

  .versus-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:start;}
  @media (max-width:760px){.versus-grid{grid-template-columns:1fr;}}
  .vs-mid{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding-top:70px;}
  @media (max-width:760px){.vs-mid{padding-top:0;order:3;}}
  .vs-mid .vs-badge{
    font-family:var(--font-display);font-weight:900;font-size:20px;color:var(--gold);
    width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    background:var(--surface-2);border:1px solid var(--line-strong);
    transition:transform .2s, box-shadow .2s;
  }
  .vs-mid .vs-badge.clash{animation:vsclash .5s ease;}
  /* MOMENTUM BAR — a small tug-of-war readout between the two HP totals, so who's actually ahead in
     the duel is visible at a glance instead of requiring a side-by-side number comparison */
  .momentum-bar{
    width:64px;height:6px;border-radius:999px;background:var(--surface-3);
    overflow:hidden;position:relative;box-shadow:inset 0 1px 3px rgba(0,0,0,0.4);
  }
  .momentum-fill{
    position:absolute;top:0;bottom:0;left:50%;width:0%;
    background:linear-gradient(90deg,var(--magenta-2),var(--cyan));
    transition:width .6s cubic-bezier(.2,.8,.2,1), left .6s cubic-bezier(.2,.8,.2,1);
    border-radius:999px;
  }
  .momentum-label{font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);font-family:var(--font-display);}
  @keyframes vsclash{
    0%{transform:scale(1);box-shadow:none;}
    40%{transform:scale(1.35);box-shadow:0 0 30px 8px rgba(245,197,24,0.55);}
    100%{transform:scale(1);box-shadow:none;}
  }

  .fighter{
    background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-md);
    padding:20px;position:relative;overflow:hidden;
    box-shadow:0 14px 34px rgba(0,0,0,0.28);
    transition:border-color .3s, box-shadow .3s;
  }
  .fighter::before{
    content:"";position:absolute;top:0;left:0;right:0;height:3px;z-index:1;
    background:linear-gradient(90deg, var(--facc, var(--gold)), var(--facc2, var(--magenta-2)));
    opacity:0.85;
  }
  .fighter.you{border-color:rgba(232,121,249,0.18);}
  .fighter.cpu{border-color:rgba(34,211,238,0.18);}
  /* MEGA EVOLUTION SPOTLIGHT — while one fighter transforms, the rest of the arena steps back so
     every bit of visual attention lands on them, like a stage light narrowing to one performer */
  .fighter{transition:opacity .55s ease, filter .55s ease, transform .55s cubic-bezier(.2,.8,.2,1), box-shadow .55s ease, z-index 0s;}
  .fighter.mega-focus{
    position:relative;z-index:6;transform:scale(1.018);
    box-shadow:0 22px 54px rgba(0,0,0,0.45), 0 0 46px -6px var(--mh, var(--gold));
  }
  .fighter.mega-dim{opacity:0.34;filter:grayscale(0.55) saturate(0.7);}
  .vs-mid{transition:opacity .55s ease;}
  .vs-mid.mega-dim{opacity:0.3;}
  @media (prefers-reduced-motion: reduce){ .fighter{transition:opacity .3s ease;} .fighter.mega-focus{transform:none;} }
  /* DANGER STATE — a low, urgent pulse once a fighter drops to critical HP, so the tension is felt
     in the panel itself and not just read off the number */
  .fighter.danger{animation:dangerPulse 1.3s ease-in-out infinite;}
  @keyframes dangerPulse{
    0%,100%{box-shadow:0 14px 34px rgba(0,0,0,0.28), 0 0 0 1px rgba(251,113,133,0.25);}
    50%{box-shadow:0 14px 34px rgba(0,0,0,0.28), 0 0 26px 2px rgba(251,113,133,0.55), 0 0 0 1px rgba(251,113,133,0.6);}
  }
  @media (prefers-reduced-motion: reduce){ .fighter.danger{animation:none;box-shadow:0 14px 34px rgba(0,0,0,0.28), 0 0 0 1px rgba(251,113,133,0.45);} }
  /* order is only needed once the grid collapses to a single column on mobile — applying it at
     desktop width too would hijack the grid's auto-placement (vs-mid has the default order:0 and
     would "steal" the first 1fr track), squashing the CPU panel into the narrow middle slot. */
  @media (max-width:760px){.fighter.you{order:1;} .fighter.cpu{order:2;}}

  .fighter-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;}
  .fighter-head .side-tag{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-faint);font-family:var(--font-display);padding-top:2px;}
  .fighter-name-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:5px;text-align:right;min-width:0;}
  .fighter-head h3{font-size:16px;line-height:1.2;}
  .mega-pill{
    font-size:10px;font-family:var(--font-display);letter-spacing:0.04em;color:var(--gold-2);
    background:rgba(245,197,24,0.12);border:1px solid rgba(245,197,24,0.35);
    padding:3px 9px;border-radius:999px;white-space:nowrap;
    /* this pill only ever gets (re)painted into the DOM at the instant a fighter's new form is
       revealed, so a standing entrance animation here always lands right on cue without any extra
       JS timing to coordinate — a small confident settle instead of just popping into existence */
    animation:pillSettle .5s cubic-bezier(.2,.8,.2,1.15) both;
  }
  @keyframes pillSettle{
    0%{opacity:0;transform:translateY(-3px) scale(0.85);}
    100%{opacity:1;transform:translateY(0) scale(1);}
  }
  @media (prefers-reduced-motion: reduce){ .mega-pill{animation:none;} }

  .fighter-portrait{
    aspect-ratio:4/3;border-radius:var(--r-sm);
    background:radial-gradient(circle at 50% 25%, rgba(192,38,211,0.2), transparent 65%), var(--surface-3);
    display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;margin-bottom:14px;
    box-shadow:inset 0 0 0 1px var(--line);
  }
  .fighter-portrait img{width:70%;height:70%;object-fit:contain;filter:drop-shadow(0 10px 20px rgba(0,0,0,0.5));transition:filter .3s, transform .3s;animation:idlefloat 3.6s ease-in-out infinite;}
  @keyframes idlefloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}
  @media (prefers-reduced-motion: reduce){ .fighter-portrait img{animation:none;} }
  .fighter-portrait.shake{animation:shake .42s;}
  @keyframes shake{
    10%,90%{transform:translate3d(-2px,0,0);}
    20%,80%{transform:translate3d(4px,0,0);}
    30%,50%,70%{transform:translate3d(-8px,0,0);}
    40%,60%{transform:translate3d(8px,0,0);}
  }
  .fighter-portrait.shake-lo{animation:shake-lo .3s;}
  @keyframes shake-lo{
    20%,80%{transform:translate3d(2px,0,0);}
    40%,60%{transform:translate3d(-3px,0,0);}
  }
  .fighter-portrait.shake-heavy{animation:shake-heavy .5s cubic-bezier(.36,.07,.19,.97);}
  @keyframes shake-heavy{
    10%,90%{transform:translate3d(-3px,-1px,0) rotate(-0.4deg);}
    20%,80%{transform:translate3d(6px,1px,0) rotate(0.5deg);}
    30%,50%,70%{transform:translate3d(-12px,0,0) rotate(-1deg);}
    40%,60%{transform:translate3d(12px,0,0) rotate(1deg);}
  }
  .fighter-portrait.hit-flash::before{
    content:"";position:absolute;inset:0;z-index:4;pointer-events:none;border-radius:inherit;
    background:radial-gradient(circle, var(--hc, #fff) 0%, transparent 68%);
    mix-blend-mode:screen;opacity:0;animation:hitflash .38s ease-out;
  }
  @keyframes hitflash{
    0%{opacity:0.85;}
    100%{opacity:0;}
  }
  .fighter.you .fighter-portrait.charge{animation:chargeglow-you .68s ease;}
  .fighter.cpu .fighter-portrait.charge{animation:chargeglow-cpu .68s ease;}
  @keyframes chargeglow-you{
    0%{filter:brightness(1) saturate(1);transform:translateX(0);}
    55%{filter:brightness(1.45) saturate(1.35) drop-shadow(0 0 18px rgba(232,121,249,0.55));transform:translateX(6px) scale(1.03);}
    100%{filter:brightness(1) saturate(1);transform:translateX(0);}
  }
  @keyframes chargeglow-cpu{
    0%{filter:brightness(1) saturate(1);transform:translateX(0);}
    55%{filter:brightness(1.45) saturate(1.35) drop-shadow(0 0 18px rgba(34,211,238,0.5));transform:translateX(-6px) scale(1.03);}
    100%{filter:brightness(1) saturate(1);transform:translateX(0);}
  }
  .mega-tint-dark img{filter:hue-rotate(-18deg) saturate(1.5) brightness(0.92) drop-shadow(0 0 16px rgba(112,88,72,0.7));}
  .mega-tint-king img{filter:hue-rotate(28deg) saturate(1.8) brightness(1.15) drop-shadow(0 0 18px rgba(245,197,24,0.75));}

  /* Mega Evolution transformation sequence: silhouette + converging shards + whiteout swap */
  .fighter-portrait.mega-silhouette{
    box-shadow:inset 0 0 0 2px var(--mh, var(--gold)), 0 0 34px -4px var(--mh, var(--gold));
    transition:box-shadow .5s ease;
  }
  .fighter-portrait.mega-silhouette img{
    filter:brightness(0.07) saturate(0) drop-shadow(0 0 14px var(--mh, var(--gold)));
    transition:filter .5s ease;
  }
  /* a soft scale-pop the instant the silhouette lifts, so the new form feels like it arrives with
     weight rather than just fading up in place */
  .fighter-portrait.reveal-pop{animation:revealPop .62s cubic-bezier(.2,.85,.25,1.3);}
  @keyframes revealPop{
    0%{transform:scale(1);}
    38%{transform:scale(1.085);}
    100%{transform:scale(1);}
  }
  /* a single diagonal light sheen sweeping across the portrait right at the reveal — the same kind
     of glossy "unveil" pass a premium card-flip or product shot uses */
  .fighter-portrait.reveal-sheen::after{
    content:"";position:absolute;inset:0;z-index:5;pointer-events:none;
    background:linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.75) 48%, transparent 66%);
    background-size:250% 250%;background-position:-40% -40%;
    animation:revealSheen .85s ease-out;
  }
  @keyframes revealSheen{
    0%{background-position:-60% -60%;opacity:0;}
    16%{opacity:0.9;}
    100%{background-position:60% 60%;opacity:0;}
  }
  @media (prefers-reduced-motion: reduce){
    .fighter-portrait.reveal-pop{animation:none;}
    .fighter-portrait.reveal-sheen::after{animation:none;display:none;}
  }
  .mega-halo{
    --h1:#e879f9; --h2:#f5c518; --h3:#22d3ee;
  }
  .mega-halo::before{
    content:"";position:absolute;inset:6%;border-radius:50%;
    background:conic-gradient(from 0deg, var(--h1), var(--h2), var(--h3), var(--h1));
    opacity:0.4;filter:blur(16px);animation:auraspin 6s linear infinite;z-index:0;
  }
  .mega-halo::after{
    content:"";position:absolute;inset:14%;border-radius:50%;
    border:1.5px solid var(--h2);opacity:0.55;
    box-shadow:0 0 22px 2px var(--h1), inset 0 0 16px 1px var(--h3);
    animation:auraspin 9s linear infinite reverse;z-index:0;
  }
  .mega-halo img{position:relative;z-index:1;}
  @keyframes auraspin{to{transform:rotate(360deg);}}

  .dmg-pop{
    position:absolute;top:10%;left:50%;transform:translateX(-50%);
    font-family:var(--font-display);font-weight:800;font-size:26px;color:var(--bad);
    text-shadow:0 2px 10px rgba(0,0,0,0.6);pointer-events:none;opacity:0;
  }
  .dmg-pop.show{animation:popup 1s ease forwards;}
  .dmg-pop.heal{color:var(--good);}
  .dmg-pop.eff{color:var(--gold-2);}
  .dmg-pop.crit{color:var(--gold-2);font-size:31px;text-shadow:0 2px 4px rgba(0,0,0,0.6), 0 0 18px rgba(245,197,24,0.85);}
  .dmg-pop.crit::before{
    content:"CRITICAL";position:absolute;left:50%;top:-16px;transform:translateX(-50%);
    font-size:10px;letter-spacing:0.14em;color:var(--gold-2);white-space:nowrap;
  }
  @keyframes popup{
    0%{opacity:0;transform:translate(-50%,10px) scale(0.7);}
    18%{opacity:1;transform:translate(-50%,-8px) scale(1.15);}
    70%{opacity:1;transform:translate(-50%,-26px) scale(1);}
    100%{opacity:0;transform:translate(-50%,-46px) scale(0.9);}
  }

  .hp-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
  .hp-row .hp-label{font-size:10.5px;color:var(--text-faint);font-family:var(--font-display);letter-spacing:0.05em;min-width:30px;}
  .hp-bar{flex:1;height:10px;border-radius:999px;background:var(--surface-3);overflow:hidden;border:1px solid var(--line);box-shadow:inset 0 1px 3px rgba(0,0,0,0.4);}
  .hp-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--good),#6ee7b7);transition:width .6s cubic-bezier(.2,.8,.2,1), background .4s;box-shadow:0 0 8px rgba(52,211,153,0.5);}
  .hp-fill.mid{background:linear-gradient(90deg,var(--warn),#fde68a);box-shadow:0 0 8px rgba(245,197,24,0.5);}
  .hp-fill.low{background:linear-gradient(90deg,var(--bad),#fca5a5);box-shadow:0 0 8px rgba(251,113,133,0.6);}
  .hp-num{font-size:11px;color:var(--text-dim);font-variant-numeric:tabular-nums;min-width:52px;text-align:right;}
  .lives-row{display:flex;gap:5px;margin-bottom:10px;min-height:12px;}
  .life-dot{width:10px;height:10px;border-radius:50%;background:var(--magenta-2);box-shadow:0 0 8px rgba(232,121,249,0.7);}
  .life-dot.used{background:var(--surface-3);box-shadow:none;}

  .fighter-types{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;}
  .move-line{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text-dim);background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sm);padding:9px 11px;margin-top:6px;}
  .move-line b{color:var(--text);font-weight:600;}
  .move-line .pow{color:var(--gold-2);font-family:var(--font-display);font-size:11px;}

  .section-label{
    font-size:10px;font-family:var(--font-display);letter-spacing:0.1em;text-transform:uppercase;
    color:var(--text-faint);margin-top:14px;margin-bottom:6px;
  }
  .move-list{display:flex;flex-direction:column;gap:8px;}
  .move-item{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sm);
    padding:10px 12px;position:relative;transition:border-color .25s, background .25s, transform .25s;
  }
  .move-item:hover{border-color:var(--facc, var(--line-strong));transform:translateX(2px);}
  .move-item.special{border-color:rgba(245,197,24,0.4);background:linear-gradient(160deg,rgba(245,197,24,0.08),rgba(232,121,249,0.06));}
  .move-item.special:hover{border-color:rgba(245,197,24,0.6);}
  .move-item.used{opacity:0.5;}
  .move-item.used:hover{transform:none;border-color:var(--line);}
  .move-item-top{display:flex;align-items:center;justify-content:space-between;gap:8px;}
  .move-item .mv-name{font-size:12.5px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .move-item .mv-star{color:var(--gold-2);}
  .move-item.special .mv-name{color:var(--gold-2);}
  .move-item-meta{display:flex;align-items:center;gap:8px;margin-top:6px;}
  .move-item .mv-type{
    font-family:var(--font-display);font-size:8.5px;letter-spacing:0.05em;text-transform:uppercase;
    padding:2.5px 7px;border-radius:999px;color:#1a0a1f;font-weight:700;flex-shrink:0;
  }
  .move-item .mv-pow{color:var(--gold-2);font-family:var(--font-display);font-size:10.5px;white-space:nowrap;}
  .move-item .mv-desc{font-size:11px;color:var(--text-faint);line-height:1.5;margin-top:7px;}
  .move-item .mv-used-tag{
    flex-shrink:0;font-size:9px;font-family:var(--font-display);letter-spacing:0.05em;
    text-transform:uppercase;color:var(--bad);background:rgba(251,113,133,0.12);
    border:1px solid rgba(251,113,133,0.3);padding:2px 7px;border-radius:999px;
  }
  .status-flags{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;}
  .flag{font-size:9.5px;font-family:var(--font-display);letter-spacing:0.05em;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:rgba(34,211,238,0.14);color:var(--cyan);border:1px solid rgba(34,211,238,0.35);}
  .flag.bad{background:rgba(251,113,133,0.14);color:var(--bad);border-color:rgba(251,113,133,0.35);}
  .flag.gold{background:rgba(245,197,24,0.14);color:var(--gold-2);border-color:rgba(245,197,24,0.35);}

  .clone-row{display:flex;gap:8px;flex-wrap:wrap;}
  .clone-chip{
    display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid rgba(34,211,238,0.3);
    border-radius:var(--r-sm);padding:7px 11px 7px 7px;
    box-shadow:0 0 0 1px rgba(34,211,238,0.08) inset, 0 6px 14px -8px rgba(34,211,238,0.4);
    animation:cloneIn .4s cubic-bezier(.2,.9,.25,1.15) both;
  }
  @keyframes cloneIn{0%{opacity:0;transform:scale(0.7) translateY(6px);}100%{opacity:1;transform:scale(1) translateY(0);}}
  .clone-chip-art{
    width:34px;height:34px;border-radius:50%;flex-shrink:0;overflow:hidden;
    background:radial-gradient(circle,rgba(34,211,238,0.22),var(--surface-3) 72%);
    box-shadow:0 0 0 1px rgba(34,211,238,0.4);
    display:flex;align-items:center;justify-content:center;
  }
  .clone-chip-art img{width:82%;height:82%;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));}
  .clone-chip-info{display:flex;flex-direction:column;gap:3px;min-width:56px;}
  .clone-chip-label{font-family:var(--font-display);font-size:9px;letter-spacing:0.06em;text-transform:uppercase;color:var(--cyan);}
  .clone-chip .cbar{width:52px;height:5px;border-radius:999px;background:var(--surface-3);overflow:hidden;}
  .clone-chip .cbar i{display:block;height:100%;background:var(--good);transition:width .5s cubic-bezier(.2,.8,.2,1);}
  .clone-chip .cbar i.mid{background:var(--warn);}
  .clone-chip .cbar i.low{background:var(--bad);}
  .clone-chip-pct{font-size:9.5px;color:var(--text-faint);font-family:var(--font-display);}

  .arena-actions{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap;}

  .move-choice{width:100%;display:flex;flex-direction:column;align-items:center;gap:12px;}
  .move-choice-title{font-family:var(--font-display);font-size:12px;letter-spacing:0.05em;text-transform:uppercase;color:var(--text-dim);}
  .move-choice-row{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
  .move-btn{
    flex-direction:column;align-items:flex-start;gap:4px;
    color:var(--text);background:var(--surface);border:1px solid var(--line-strong);
    padding:12px 20px;min-width:190px;text-align:left;
  }
  .move-btn:hover:not(:disabled){background:rgba(255,255,255,0.08);border-color:var(--magenta-2);transform:translateY(-2px);}
  .move-btn .mv-name{font-size:13px;letter-spacing:0.02em;color:var(--text);}
  .move-btn .mv-meta{font-size:10.5px;color:var(--text-faint);letter-spacing:0.04em;}
  .move-btn.special{border-color:rgba(245,197,24,0.45);background:linear-gradient(160deg,rgba(245,197,24,0.1),rgba(232,121,249,0.08));}
  .move-btn.special .mv-name{color:var(--gold-2);}
  .move-btn .mv-used{font-size:9.5px;font-family:var(--font-display);letter-spacing:0.05em;text-transform:uppercase;color:var(--bad);}
  .move-btn{max-width:260px;}
  .move-btn .mv-btn-desc{display:block;font-size:10.5px;color:var(--text-faint);line-height:1.45;margin-top:4px;white-space:normal;text-transform:none;letter-spacing:normal;font-family:var(--font-body);font-weight:400;}

  .battle-log{
    margin-top:22px;background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-md);
    padding:14px 16px;max-height:150px;overflow-y:auto;font-size:12.5px;color:var(--text-dim);
  }
  .battle-log .log-title{font-family:var(--font-display);font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-faint);margin-bottom:8px;}
  .battle-log p{padding:3px 0;border-bottom:1px dashed var(--line);}
  .battle-log p:last-child{border-bottom:none;}
  .battle-log b{color:var(--gold-2);}

  .result-screen{
    position:absolute;inset:0;z-index:30;border-radius:var(--r-lg);
    background:linear-gradient(180deg, rgba(10,7,20,0.92), rgba(15,11,29,0.98));
    display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px;padding:30px;
    opacity:0;pointer-events:none;transition:opacity .4s;
  }
  .result-screen.show{opacity:1;pointer-events:auto;}

  .result-card{
    position:relative;display:flex;flex-direction:column;align-items:center;gap:14px;
    width:100%;max-width:460px;padding:36px 32px 30px;border-radius:var(--r-lg);
    background:linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.01)), var(--surface-2);
    border:1px solid var(--line-strong);
    box-shadow:0 30px 70px rgba(0,0,0,0.5);
    opacity:0;transform:translateY(16px) scale(0.96);
  }
  .result-screen.show .result-card{animation:resultCardIn .6s cubic-bezier(.16,.8,.3,1) .05s both;}
  @keyframes resultCardIn{0%{opacity:0;transform:translateY(16px) scale(0.96);}100%{opacity:1;transform:translateY(0) scale(1);}}
  .result-card.win{
    border-color:rgba(245,197,24,0.4);
    box-shadow:0 30px 70px rgba(0,0,0,0.55), 0 0 70px -14px rgba(245,197,24,0.45);
  }
  .result-card.lose{
    border-color:var(--line-strong);
    box-shadow:0 30px 70px rgba(0,0,0,0.55);
  }
  .result-card.draw{
    border-color:rgba(34,211,238,0.35);
    box-shadow:0 30px 70px rgba(0,0,0,0.55), 0 0 60px -14px rgba(34,211,238,0.35);
  }
  .result-card::before{
    content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
    background:radial-gradient(circle at 50% -10%, rgba(245,197,24,0.16), transparent 60%);
    opacity:0;transition:opacity .5s;
  }
  .result-card.win::before{opacity:1;}

  .result-portrait{
    width:112px;height:112px;border-radius:50%;position:relative;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
    background:radial-gradient(circle, rgba(245,197,24,0.22), transparent 72%);
  }
  .result-card.win .result-portrait{
    box-shadow:0 0 0 2px rgba(245,197,24,0.55), 0 0 46px -6px rgba(245,197,24,0.6);
    animation:resultPortraitPop .7s cubic-bezier(.2,.9,.25,1.2) .15s both;
  }
  .result-card.lose .result-portrait{
    background:radial-gradient(circle, rgba(255,255,255,0.08), transparent 72%);
    box-shadow:0 0 0 2px var(--line-strong);
  }
  .result-card.draw .result-portrait{
    background:radial-gradient(circle, rgba(34,211,238,0.18), transparent 72%);
    box-shadow:0 0 0 2px rgba(34,211,238,0.45);
  }
  .result-portrait img{
    width:86%;height:86%;object-fit:contain;
    filter:drop-shadow(0 8px 16px rgba(0,0,0,0.6));
  }
  .result-card.lose .result-portrait img{filter:grayscale(0.65) brightness(0.72) drop-shadow(0 8px 16px rgba(0,0,0,0.6));}
  @keyframes resultPortraitPop{0%{transform:scale(0.6);opacity:0;}60%{transform:scale(1.1);opacity:1;}100%{transform:scale(1);}}

  .result-card h2{font-size:clamp(26px,4.4vw,40px);}
  .result-card h2.win{
    background:linear-gradient(120deg,var(--gold),var(--magenta-2),var(--cyan),var(--gold));
    background-size:300% auto;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:winshimmer 3.5s linear infinite, winpop .7s cubic-bezier(.2,.9,.25,1.2) .1s both;
  }
  .result-card h2.lose{color:var(--text-dim);animation:losein .5s ease both;}
  .result-card h2.draw{color:var(--cyan);animation:losein .5s ease both;}
  @keyframes winshimmer{to{background-position:300% 50%;}}
  @keyframes winpop{0%{transform:scale(0.7);opacity:0;}60%{transform:scale(1.08);opacity:1;}100%{transform:scale(1);}}
  @keyframes losein{0%{opacity:0;transform:translateY(10px);}100%{opacity:1;transform:translateY(0);}}
  .result-screen.show .eyebrow{animation:heroIn .5s cubic-bezier(.16,.8,.3,1) .05s both;}
  .result-screen.show .result-stats{animation:heroIn .5s cubic-bezier(.16,.8,.3,1) .2s both;}
  .result-screen.show .btn{animation:heroIn .6s cubic-bezier(.16,.8,.3,1) .3s both;}
  .result-screen canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}

  .result-stats{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:2px;}
  .result-stat{
    background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 13px;
    font-family:var(--font-display);font-size:10.5px;letter-spacing:0.04em;color:var(--text-faint);
    text-transform:uppercase;
  }
  .result-stat b{color:var(--text);font-weight:700;font-family:var(--font-body);text-transform:none;font-size:11.5px;letter-spacing:0;}
  .result-stat.good{border-color:rgba(52,211,153,0.35);color:var(--good);}
  .result-stat.bad{border-color:rgba(251,113,133,0.32);color:var(--bad);}

  /* ---------- TYPE CHART ---------- */
  .type-grid{display:flex;flex-wrap:wrap;gap:9px;}
  .type-chip{
    display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:999px;
    background:var(--surface);border:1px solid var(--line);font-size:12.5px;color:var(--text-dim);
    cursor:default;transition:transform .2s, border-color .2s;
  }
  .type-chip:hover{transform:translateY(-2px);border-color:var(--line-strong);}
  .type-chip .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;box-shadow:0 0 8px currentColor;}
  .type-chip b{color:var(--text);font-weight:600;}

  .weak-table{margin-top:26px;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;}
  .weak-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:16px;transition:transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s, box-shadow .3s;}
  .weak-card:hover{transform:translateY(-4px);border-color:var(--accent, var(--line-strong));box-shadow:0 14px 30px rgba(0,0,0,0.35), 0 0 22px -8px var(--accent, transparent);}
  .weak-card .wk-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .weak-card img{width:38px;height:38px;object-fit:contain;background:var(--surface-3);border-radius:50%;padding:4px;}
  .weak-card h4{font-size:13.5px;}
  .weak-line{font-size:11.5px;color:var(--text-faint);margin-top:5px;}
  .weak-line b{color:var(--bad);font-weight:600;}
  .weak-line.res b{color:var(--good);}

  /* ---------- RULES / ABOUT ---------- */
  .rules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  @media (max-width:820px){.rules-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:560px){.rules-grid{grid-template-columns:1fr;}}
  .rule-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:20px;}
  .rule-card .num{font-family:var(--font-display);font-size:12px;color:var(--gold);letter-spacing:0.1em;}
  .rule-card h4{margin-top:10px;font-size:15px;}
  .rule-card p{margin-top:8px;font-size:13px;color:var(--text-dim);line-height:1.55;}

  .lore-note{
    display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;
    background:linear-gradient(120deg, rgba(192,38,211,0.10), rgba(34,211,238,0.08));
    border:1px solid var(--line-strong);border-radius:var(--r-md);
    padding:16px 20px;margin-bottom:22px;
  }
  .lore-note .lore-tag{
    flex-shrink:0;font-family:var(--font-display);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;
    color:var(--bg);background:linear-gradient(120deg,var(--gold),var(--magenta-2));
    padding:5px 11px;border-radius:999px;margin-top:2px;
  }
  .lore-note p{flex:1;min-width:240px;font-size:13px;color:var(--text-dim);line-height:1.65;}
  .lore-note b{color:var(--gold-2);font-weight:600;}
  .lore-note i{color:var(--magenta-2);font-style:normal;font-weight:600;}

  .mega-showcase{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:10px;}
  @media (max-width:900px){.mega-showcase{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:520px){.mega-showcase{grid-template-columns:1fr;}}
  .mega-card{background:linear-gradient(180deg,var(--surface),var(--surface-2));border:1px solid var(--line);border-radius:var(--r-md);padding:14px;text-align:center;transition:transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s, box-shadow .3s;}
  .mega-card:hover{transform:translateY(-5px);border-color:var(--h1, var(--line-strong));box-shadow:0 18px 36px rgba(0,0,0,0.4), 0 0 26px -6px var(--h1, transparent);}
  .mega-card .art-wrap{aspect-ratio:1/1;border-radius:var(--r-sm);background:radial-gradient(circle at 50% 30%,rgba(245,197,24,0.18),transparent 70%),var(--surface-3);display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
  .mega-card img{width:78%;height:78%;object-fit:contain;}
  .mega-card h4{font-size:13px;}
  .mega-card .movename{font-family:var(--font-display);font-size:10.5px;color:var(--gold-2);margin-top:6px;letter-spacing:0.03em;}
  .mega-card p{font-size:11.5px;color:var(--text-faint);margin-top:6px;line-height:1.5;}

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line);padding-block:34px;margin-top:20px;}
  .foot-grid{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:flex-start;}
  .foot-brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:14px;}
  footer p{font-size:11.5px;color:var(--text-faint);line-height:1.7;max-width:64ch;margin-top:10px;}
  footer .credit{font-size:11.5px;color:var(--text-dim);margin-top:14px;}
  footer .credit b{color:var(--gold-2);}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important;}
  }

  /* ---------- CUSTOM SCROLLBAR — the last unstyled browser-chrome surface on the page ---------- */
  html{scrollbar-width:thin;scrollbar-color:var(--magenta-2) transparent;}
  ::-webkit-scrollbar{width:10px;height:10px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{
    background-color:var(--magenta-2);
    background-image:linear-gradient(180deg,var(--gold),var(--magenta-2),var(--cyan));
    border-radius:999px;border:2px solid var(--bg);background-clip:padding-box;
  }
  ::-webkit-scrollbar-thumb:hover{background-image:linear-gradient(180deg,var(--cyan),var(--magenta-2),var(--gold));}

  /* ---------- BOOT VEIL — a quick ring-expand reveal on first load, echoing the theme-toggle's own
     portal-wipe so the brand mark shows up at the very first moment the page is seen, not just in the
     nav. Pure CSS (no JS dependency), so it can never get stuck open. ---------- */
  .boot-veil{
    position:fixed;inset:0;z-index:200;background:var(--bg);
    display:flex;align-items:center;justify-content:center;
    animation:bootVeilOut 1s ease forwards;
  }
  .boot-ring{
    width:56px;height:56px;border-radius:50%;border:4px solid var(--magenta-2);
    box-shadow:0 0 30px rgba(232,121,249,0.55);
    animation:bootRingIn .85s cubic-bezier(.16,.8,.3,1) forwards;
  }
  @keyframes bootRingIn{
    0%{transform:scale(0.2) rotate(0deg);opacity:0;border-color:var(--magenta-2);}
    55%{transform:scale(1.3) rotate(200deg);opacity:1;border-color:var(--gold);}
    100%{transform:scale(46) rotate(340deg);opacity:0;border-width:1px;border-color:var(--cyan);}
  }
  @keyframes bootVeilOut{
    0%,58%{opacity:1;visibility:visible;}
    100%{opacity:0;visibility:hidden;}
  }
  @media (prefers-reduced-motion: reduce){ .boot-veil{display:none;} }

  /* ---------- BACK-TO-TOP — Hoopa's ring again, this time as a floating shortcut once you've
     scrolled past the hero ---------- */
  .back-to-top{
    position:fixed;right:20px;bottom:20px;z-index:60;
    width:44px;height:44px;border-radius:50%;
    background:rgba(23,16,41,0.72);backdrop-filter:blur(12px) saturate(140%);
    border:1px solid var(--line-strong);
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    opacity:0;pointer-events:none;transform:translateY(14px) scale(0.9);
    transition:opacity .3s ease, transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
  }
  .back-to-top.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1);}
  .back-to-top:hover{box-shadow:0 0 20px rgba(245,197,24,0.4);}
  .back-to-top:active{transform:scale(0.9);}
  .back-to-top .ring{width:16px;height:16px;}
  :root[data-theme="light"] .back-to-top{background:rgba(255,255,255,0.78);}
  @media (max-width:640px){ .back-to-top{right:14px;bottom:14px;width:40px;height:40px;} }

  /* ---------- SIDE RAIL — a slim section map so a page this long stays easy to navigate, desktop only ---------- */
  .side-rail{
    position:fixed;right:20px;top:50%;transform:translateY(-50%);z-index:55;
    display:flex;flex-direction:column;gap:15px;
    opacity:0;pointer-events:none;transition:opacity .35s ease;
  }
  .side-rail.show{opacity:1;pointer-events:auto;}
  .side-rail a{position:relative;width:10px;height:10px;display:block;}
  .side-rail a span{
    position:absolute;inset:0;border-radius:50%;background:var(--line-strong);
    transition:background .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .side-rail a:hover span{background:var(--text-dim);}
  .side-rail a.active span{background:var(--gold);transform:scale(1.6);box-shadow:0 0 10px rgba(245,197,24,0.7);}
  .side-rail a::before{
    content:attr(aria-label);position:absolute;right:20px;top:50%;transform:translateY(-50%);
    font-family:var(--font-display);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
    color:var(--text-dim);white-space:nowrap;opacity:0;pointer-events:none;
    background:var(--surface);padding:5px 9px;border-radius:6px;border:1px solid var(--line);
    transition:opacity .2s ease;
  }
  .side-rail a:hover::before{opacity:1;}
  @media (max-width:980px){ .side-rail{display:none;} }

  /* ---------- CARD TILT — a light 3D pointer-follow tilt applied via JS to roster/mega/type cards
     (desktop with a real pointer only); each card owns its own transition timing so the snap-back on
     mouseleave doesn't fight the live tilt while the pointer is moving ---------- */
  .tilt-card{transform-style:preserve-3d;will-change:transform;}

  /* ---------- TYPES SECTION — a real two-column reference layout instead of the same stacked
     single-column template every other section uses: the type legend acts as a sticky filter panel,
     the weakness cards are the results ---------- */
  .types-layout{display:grid;grid-template-columns:250px 1fr;gap:30px;align-items:start;}
  .types-layout .type-grid{position:sticky;top:88px;}
  .types-hint{font-size:11px;color:var(--text-faint);margin-bottom:10px;letter-spacing:0.02em;}
  @media (max-width:880px){
    .types-layout{grid-template-columns:1fr;}
    .types-layout .type-grid{position:static;}
  }
  .type-chip{cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent;transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;border-radius:999px;}
  .type-chip:hover{transform:translateY(-2px);}
  .type-chip.active{box-shadow:0 0 0 2px currentColor inset;}
  .weak-card{transition:transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s ease, box-shadow .3s ease, opacity .3s ease;}
  .weak-card.dim{opacity:0.32;}
  .weak-card.hl-weak{border-color:var(--bad);box-shadow:0 14px 30px rgba(0,0,0,0.35), 0 0 0 1px var(--bad) inset;}
  .weak-card.hl-resist{border-color:var(--good);box-shadow:0 14px 30px rgba(0,0,0,0.35), 0 0 0 1px var(--good) inset;}
    </style>
  </head>
  <body>

<div class="boot-veil" id="boot-veil" aria-hidden="true"><span class="boot-ring"></span></div>

<div class="bg-aurora" aria-hidden="true"></div>
<div class="bg-grain" aria-hidden="true"></div>

<button type="button" class="back-to-top" id="back-to-top" aria-label="Back to top" title="Back to top">
  <span class="ring"></span>
</button>

<nav class="side-rail" id="side-rail" aria-label="Section map">
  <a href="#roster" aria-label="Roster"><span></span></a>
  <a href="#arena" aria-label="Arena"><span></span></a>
  <a href="#types" aria-label="Types"><span></span></a>
  <a href="#megas" aria-label="Transforms"><span></span></a>
  <a href="#rules" aria-label="Rules"><span></span></a>
</nav>

<div class="nav">
  <div class="brand">
    <button type="button" class="ring-toggle" id="theme-toggle" aria-label="Open a portal to light mode" aria-pressed="false" title="Tap Hoopa's ring to shift the arena's light">
      <span class="ring"></span>
    </button>
    HOOPA PORTAL ARENA
  </div>
  <div class="navlinks">
    <a href="#roster">Roster</a>
    <a href="#arena">Arena</a>
    <a href="#types">Types</a>
    <a href="#megas">Transforms</a>
    <a href="#rules">Rules</a>
  </div>
  <button class="music-toggle" id="music-toggle" type="button" aria-pressed="false" title="Play battle theme (original violin-led score)">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M9 18V5l12-2v13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" fill="currentColor"/><circle cx="18" cy="16" r="3" fill="currentColor"/></svg>
    <span class="music-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="music-label">Theme</span>
  </button>
  <div class="nav-progress" id="nav-progress"></div>
</div>

<header class="hero wrap">
  <div class="hero-inner">
    <div>
      <div class="eyebrow">Fan-made portal battler</div>
      <h1>Hoopa Portal<br>Arena</h1>
      <p class="lead">Test your strength, pick a Pokémon, and be ready to explore new strategies. One duel, fought turn by turn until someone's HP hits zero. Five legends, every one hiding a transformation — a Mega Evolution, or for Hoopa, its Unbound Forme — and only one way to find out who's still standing.</p>
      <div class="hero-cta">
        <button class="btn btn-primary" id="cta-start">Enter the Arena ✦</button>
        <a href="#rules" class="btn btn-ghost">How it works</a>
      </div>
      <div class="stat-strip">
        <div><b>5</b><span>Pokémon</span></div>
        <div><b>6</b><span>Hidden forms</span></div>
        <div><b>18</b><span>Types covered</span></div>
        <div><b>∞</b><span>Turns to the KO</span></div>
      </div>
    </div>
    <div class="portal-stage" id="portal-stage">
      <div class="portal-tilt" id="portal-tilt">
        <canvas id="hero-particles"></canvas>
        <div class="portal-core"></div>
        <div class="portal-hoopa"><img src="/hoopa.png" alt="Hoopa, the Mischief Djinn"></div>
      </div>
    </div>
  </div>
</header>

<main>
  <section id="roster" class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">Step 1</div>
      <h2>Choose your Pokémon</h2>
      <p>Pick one of five legends to carry into the portal. A rival Trainer will randomly step in the moment you confirm.</p>
    </div>
    <div class="roster" id="roster-grid"></div>
    <div class="select-bar">
      <div class="info">Selected: <b id="sel-name">none yet</b></div>
      <button class="btn btn-primary" id="confirm-pick" disabled>Summon rival &amp; enter arena</button>
    </div>
  </section>

  <section id="arena" class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">Step 2</div>
      <h2>The Arena</h2>
      <p>One continuous duel. Type effectiveness decides who lands the bigger blow each turn, and it keeps going until a Pokémon runs out of HP. Watch for Mega Evolutions — and Hoopa's Unbound Forme — they can flip a duel in one flash.</p>
    </div>
    <div class="arena-shell" id="arena-shell">
      <div class="cinema-bar cinema-bar-top" aria-hidden="true"></div>
      <div class="cinema-bar cinema-bar-bottom" aria-hidden="true"></div>
      <div class="arena-top">
        <div class="round-label" id="round-label">Awaiting Pokémon</div>
        <div class="round-track" id="round-track">
          <span class="turn-badge"><span class="turn-badge-dot"></span>Turn <b id="turn-num">0</b></span>
        </div>
      </div>

      <div class="versus-grid">
        <div class="fighter you" id="you-panel"></div>
        <div class="vs-mid">
          <div class="vs-badge">VS</div>
          <div class="momentum-bar" id="momentum-bar"><div class="momentum-fill" id="momentum-fill"></div></div>
          <div class="momentum-label">Momentum</div>
        </div>
        <div class="fighter cpu" id="cpu-panel"></div>
      </div>

      <canvas id="fx-canvas"></canvas>
      <div class="fx-banner" id="fx-banner"></div>

      <div class="arena-actions" id="arena-actions">
        <button class="btn btn-ghost" id="pick-first" disabled>Select a Pokémon above first ↑</button>
      </div>

      <div class="battle-log" id="battle-log">
        <div class="log-title">Battle log</div>
        <p>The portal is quiet. Choose a Pokémon to begin.</p>
      </div>

      <div class="result-screen" id="result-screen">
        <canvas id="confetti"></canvas>
        <div class="result-card" id="result-card">
          <div class="result-portrait" id="result-portrait"><img id="result-portrait-img" src="" alt=""></div>
          <div class="eyebrow" id="result-eyebrow">Match complete</div>
          <h2 id="result-title">—</h2>
          <p id="result-sub" style="color:var(--text-dim);max-width:40ch;"></p>
          <div class="result-stats" id="result-stats"></div>
          <button class="btn btn-primary" id="rematch-btn">Open a new portal ↻</button>
        </div>
      </div>
    </div>
  </section>

  <section id="types" class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">Reference</div>
      <h2>All 18 elemental types</h2>
      <p>Every move and every Pokémon in the arena is built on the full Pokémon type wheel. Effectiveness (×2 super-effective, ×0.5 resisted, ×0 immune) drives every round.</p>
    </div>
    <div class="types-layout">
      <div>
        <p class="types-hint">Tap a type to see which roster Pokémon are weak to it (red) or resist it (green).</p>
        <div class="type-grid" id="type-grid"></div>
      </div>
      <div class="weak-table" id="weak-table"></div>
    </div>
  </section>

  <section id="megas" class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">Transformations</div>
      <h2>Signature transformation moves</h2>
      <p>Every Pokémon carries a hidden transformation. Trigger odds are rolled live during the duel — nothing is guaranteed.</p>
    </div>
    <div class="lore-note">
      <span class="lore-tag">Lore spark</span>
      <p>Every artwork here — down to Mega Darkrai's spiked void, Mega Zygarde's cannon-like Complete build, and both Mega Raichu forms — is pulled straight from Pokémon Legends: Z-A's <b>Mega Dimension</b> DLC. In that story, rings torn open by <b>Hoopa</b> flood Lumiose City with residual Mega Power, bleeding into a rift called <i>Hyperspace Lumiose</i> where Rogue Mega Evolutions roam free. This arena's void-and-portal palette — magenta, gold-ring, and hyperspace cyan — is this project's own color take on that same hyperspace idea.</p>
    </div>
    <div class="mega-showcase" id="mega-showcase"></div>
  </section>

  <section id="rules" class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">Step 0</div>
      <h2>How a duel plays out</h2>
    </div>
    <div class="rules-grid">
      <div class="rule-card reveal">
        <div class="num">01</div>
        <h4>Pick &amp; summon</h4>
        <p>You choose one of five Pokémon. The instant you confirm, a rival Trainer randomly steps in with one of the remaining four.</p>
      </div>
      <div class="rule-card reveal">
        <div class="num">02</div>
        <h4>Type weakness resolves the round</h4>
        <p>Both sides attack at once. Whoever's move type is super-effective against the opponent's typing lands the heavier hit and takes the round.</p>
      </div>
      <div class="rule-card reveal">
        <div class="num">03</div>
        <h4>A hidden transformation can trigger</h4>
        <p>Darkrai, Amphinobi and Raichu roll a hidden chance to Mega Evolve; Hoopa rolls that same hidden chance to shift into its Unbound Forme. Either way it's a second life and a signature move. Zygarde only awakens after it has taken battle damage.</p>
      </div>
      <div class="rule-card reveal">
        <div class="num">04</div>
        <h4>Signature moves change the arena</h4>
        <p>Infernal Dark Void curses and drains. Water Life Shurikens splits into clones. Lux Nihilium hits everything on the field and can lock an opponent down.</p>
      </div>
      <div class="rule-card reveal">
        <div class="num">05</div>
        <h4>The duel runs until someone's out</h4>
        <p>There's no round limit — turns keep coming until one side's HP (and any extra lives) hits zero.</p>
      </div>
      <div class="rule-card reveal">
        <div class="num">06</div>
        <h4>Open a new portal anytime</h4>
        <p>Rematch instantly with a fresh random rival and fresh Mega odds. Every duel plays out differently.</p>
      </div>
    </div>
  </section>
</main>

<footer class="wrap">
  <div class="foot-grid">
    <div>
      <div class="foot-brand"><span class="ring" style="width:16px;height:16px;border-width:2px;"></span>HOOPA PORTAL ARENA</div>
      <p>Pokémon, all Pokémon character names, and their respective artwork are trademarks of Nintendo, Game Freak, Creatures Inc. and The Pokémon Company. All rights to the Pokémon franchise, its characters and imagery belong to their respective owners. This is an unofficial, non-commercial fan project.</p>
      <p class="credit">Game concept, rules, mechanics and design by <b>Aymane</b>.</p>
    </div>
  </div>
</footer>

    <script is:inline>
(function(){
"use strict";

/* ============================= TYPE SYSTEM ============================= */
var TYPES = ["normal","fire","water","electric","grass","ice","fighting","poison","ground","flying","psychic","bug","rock","ghost","dragon","dark","steel","fairy"];

var TYPE_COLOR = {
  normal:"#A8A878", fire:"#F08030", water:"#6890F0", electric:"#F8D030", grass:"#78C850",
  ice:"#98D8D8", fighting:"#C03028", poison:"#A040A0", ground:"#E0C068", flying:"#A890F0",
  psychic:"#F85888", bug:"#A8B820", rock:"#B8A038", ghost:"#705898", dragon:"#7038F8",
  dark:"#705848", steel:"#B8B8D0", fairy:"#EE99AC"
};

var TYPE_CHART = {
  normal:{2:[],0.5:["rock","steel"],0:["ghost"]},
  fire:{2:["grass","ice","bug","steel"],0.5:["fire","water","rock","dragon"],0:[]},
  water:{2:["fire","ground","rock"],0.5:["water","grass","dragon"],0:[]},
  electric:{2:["water","flying"],0.5:["electric","grass","dragon"],0:["ground"]},
  grass:{2:["water","ground","rock"],0.5:["fire","grass","poison","flying","bug","dragon","steel"],0:[]},
  ice:{2:["grass","ground","flying","dragon"],0.5:["fire","water","ice","steel"],0:[]},
  fighting:{2:["normal","ice","rock","dark","steel"],0.5:["poison","flying","psychic","bug","fairy"],0:["ghost"]},
  poison:{2:["grass","fairy"],0.5:["poison","ground","rock","ghost"],0:["steel"]},
  ground:{2:["fire","electric","poison","rock","steel"],0.5:["grass","bug"],0:["flying"]},
  flying:{2:["grass","fighting","bug"],0.5:["electric","rock","steel"],0:[]},
  psychic:{2:["fighting","poison"],0.5:["psychic","steel"],0:["dark"]},
  bug:{2:["grass","psychic","dark"],0.5:["fire","fighting","poison","flying","ghost","steel","fairy"],0:[]},
  rock:{2:["fire","ice","flying","bug"],0.5:["fighting","ground","steel"],0:[]},
  ghost:{2:["psychic","ghost"],0.5:["dark"],0:["normal"]},
  dragon:{2:["dragon"],0.5:["steel"],0:["fairy"]},
  dark:{2:["psychic","ghost"],0.5:["fighting","dark","fairy"],0:[]},
  steel:{2:["ice","rock","fairy"],0.5:["fire","water","electric","steel"],0:[]},
  fairy:{2:["fighting","dragon","dark"],0.5:["fire","poison","steel"],0:[]}
};

function effectiveness(atkType, defTypes){
  var mult = 1;
  defTypes.forEach(function(dt){
    var chart = TYPE_CHART[atkType];
    if(!chart) return;
    if(chart[2] && chart[2].indexOf(dt) !== -1) mult *= 2;
    else if(chart[0.5] && chart[0.5].indexOf(dt) !== -1) mult *= 0.5;
    else if(chart[0] && chart[0].indexOf(dt) !== -1) mult *= 0;
  });
  return mult;
}

/* ============================= ROSTER DATA ============================= */
var POKEMON = {
  hoopa:{
    id:"hoopa", name:"Hoopa", title:"The Mischief Djinn", types:["psychic","ghost"],
    hp:100, img:"/hoopa.png",
    move:{name:"Hyperspace Hole", type:"psychic", power:38,
      desc:"Hoopa punches a small ring into the air and yanks a fist straight through it into the foe."},
    mega:{
      chanceMode:"random", chance:0.30,
      label:"Hoopa Unbound", img:"/hoopa-unbound.png",
      types:["psychic","dark"], lives:1, halo:["#f43f8f","#7c3aed","#f5c518"], shard:"ring",
      special:{name:"Djinn's Cataclysm", type:"dark", power:72, effect:"burst",
        desc:"Hundreds of rings tear open at once, crushing the arena in void energy."}
    }
  },
  darkrai:{
    id:"darkrai", name:"Darkrai", title:"The Pitch-Black Nightmare", types:["dark"],
    hp:95, img:"/darkrai.png",
    move:{name:"Nightmare Pulse", type:"dark", power:42,
      desc:"A wave of pitch-black dream energy rolls out from Darkrai's crest, dragging the target's fears with it."},
    mega:{
      chanceMode:"random", chance:0.35,
      label:"Mega Darkrai", img:"/darkrai-mega.png",
      types:["dark"], lives:1, halo:["#a21caf","#0f0a1e","#f472b6"], shard:"crescent",
      special:{name:"Infernal Dark Void", type:"dark", power:60, effect:"dot_heal", dot:8, heal:6,
        desc:"A huge blast of nightmare energy, then a curse that drains the foe and mends Darkrai every turn after."}
    }
  },
  amphinobi:{
    id:"amphinobi", name:"Amphinobi", title:"The Ninja Frog", types:["water"],
    hp:90, img:"/amphinobi.png",
    move:{name:"Aqua Kunai", type:"water", power:40,
      desc:"A blade of compressed water flicked from the fingertips, fast enough to whistle on the way in."},
    mega:{
      chanceMode:"random", chance:0.35,
      label:"Mega Amphinobi", img:"/amphinobi-mega.png",
      types:["water","dark"], lives:1, halo:["#0ea5e9","#1e293b","#f472b6"], shard:"shuriken",
      special:{name:"Water Life Shurikens", type:"water", power:55, effect:"clone", cloneHpFrac:0.35, cloneCount:2, cloneDmgFrac:0.5,
        desc:"A shattering strike that splits into two lesser clones — same move, no further cloning."}
    }
  },
  zygarde:{
    id:"zygarde", name:"Zygarde", title:"The Order Guardian", types:["dragon","ground"],
    hp:112, img:"/zygarde.png",
    move:{name:"Core Enforcer", type:"dragon", power:45,
      desc:"A lance of hexagonal core-cells streaks out and detonates on contact, enforcing order with raw draconic weight."},
    mega:{
      chanceMode:"onDamage", chance:0.50,
      label:"Zygarde Complete Forme", img:"/zygarde-mega.png",
      types:["dragon","ground"], lives:1, halo:["#16a34a","#7c3aed","#ef4444"], shard:"hex",
      special:{name:"Lux Nihilium", type:"dragon", power:82, effect:"aoe_paralyze_recharge",
        paralyzeChance:1/3, paralyzeRounds:3, recharge:2,
        desc:"Only awakens after tasting battle damage. Three columns of Order energy crash down at once and shatter into data-cell shrapnel, hitting every card in the arena and able to lock an opponent down for three turns — then needs two turns to recharge."}
    }
  },
  raichu:{
    id:"raichu", name:"Raichu", title:"The Surging Mouse", types:["electric"],
    hp:85, img:"/raichu.png",
    move:{name:"Thunder Fang", type:"electric", power:44,
      desc:"A crackling bite that drives a jolt of live current straight through the target."},
    megaOptions:[
      {chanceMode:"random", chance:0.16, label:"Mega Raichu X", img:"/raichu-mega-x.png",
        types:["electric"], lives:1, halo:["#facc15","#111827","#fb923c"], shard:"bolt",
        special:{name:"Raijin's Uppercut", type:"electric", power:58, effect:"power_surge", boost:0.28,
          desc:"Lightning-bolt legs plant a crowned uppercut, then keep this Raichu's power surging every turn after."}},
      {chanceMode:"random", chance:0.16, label:"Mega Raichu Y", img:"/raichu-mega-y.png",
        types:["electric"], lives:1, halo:["#fb923c","#facc15","#78350f"], shard:"bolt",
        special:{name:"Thunderwing Dive", type:"electric", power:56, effect:"power_surge", boost:0.24,
          desc:"Bat-like lightning ears fold into wings for a diving strike, charging fiercer with every hit."}}
    ]
  }
};

var ROSTER_ORDER = ["hoopa","darkrai","amphinobi","zygarde","raichu"];

/* ============================= UI: TYPE CHIPS ============================= */
var typeGrid = document.getElementById("type-grid");
TYPES.forEach(function(t){
  var chip = document.createElement("div");
  chip.className = "type-chip";
  chip.dataset.type = t;
  chip.style.color = TYPE_COLOR[t];
  chip.innerHTML = '<span class="dot" style="background:'+TYPE_COLOR[t]+'"></span><b style="color:'+TYPE_COLOR[t]+'">'+cap(t)+'</b>';
  typeGrid.appendChild(chip);
});

function cap(s){return s.charAt(0).toUpperCase()+s.slice(1);}
function typeBadgeHTML(t){
  return '<span class="typebadge" style="background:'+TYPE_COLOR[t]+'">'+cap(t)+'</span>';
}

/* weakness reference cards for the 5 roster mons */
var weakTable = document.getElementById("weak-table");
ROSTER_ORDER.forEach(function(key){
  var p = POKEMON[key];
  var weakTo = [], resistedBy = [];
  TYPES.forEach(function(t){
    var m = effectiveness(t, p.types);
    if(m > 1) weakTo.push(t);
    else if(m < 1) resistedBy.push(t);
  });
  var card = document.createElement("div");
  card.className = "weak-card reveal tilt-card";
  card.dataset.weak = weakTo.join(",");
  card.dataset.resist = resistedBy.join(",");
  card.style.setProperty("--accent", TYPE_COLOR[p.types[0]]);
  card.innerHTML =
    '<div class="wk-head"><img src="'+p.img+'" alt=""><div><h4>'+p.name+'</h4><div class="typebadges" style="justify-content:flex-start;margin-top:4px;">'+p.types.map(typeBadgeHTML).join("")+'</div></div></div>'+
    '<div class="weak-line">Weak to: <b>'+(weakTo.length?weakTo.map(cap).join(", "):"nothing notable")+'</b></div>'+
    '<div class="weak-line res">Resists: <b>'+(resistedBy.length?resistedBy.map(cap).join(", "):"nothing notable")+'</b></div>';
  weakTable.appendChild(card);
});

/* mega showcase */
var megaShowcase = document.getElementById("mega-showcase");
function haloStyle(halo){
  var base = "position:relative;overflow:hidden;";
  if(halo) base += "--h1:"+halo[0]+";--h2:"+halo[1]+";--h3:"+halo[2]+";";
  return ' style="'+base+'"';
}
function addMegaCard(baseName, m){
  var el = document.createElement("div");
  el.className = "mega-card reveal tilt-card";
  if(m.halo) el.style.setProperty("--h1", m.halo[0]);
  el.innerHTML =
    '<div class="art-wrap'+(m.cssFilter?' '+m.cssFilter:'')+(m.halo?' mega-halo':'')+'"'+haloStyle(m.halo)+'><img src="'+m.img+'" alt=""></div>'+
    '<h4>'+m.label+'</h4>'+
    '<div class="typebadges">'+m.types.map(typeBadgeHTML).join("")+'</div>'+
