grid.querySelectorAll('.card').forEach(card=>{
  card.addEventListener('click', ()=> card.classList.toggle('flipped'));
  card.addEventListener('mousemove', e=>{
    if(reducedMotion || card.classList.contains('flipped')) return;
    const r=card.getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-.5;
    const y=(e.clientY-r.top)/r.height-.5;
    card.style.transform=`perspective(1200px) rotateX(${(-y*5).toFixed(2)}deg) rotateY(${(x*7).toFixed(2)}deg) translateY(-5px)`;
  });
  card.addEventListener('mouseleave', ()=>{ card.style.transform=''; });
});

/* ============ SCROLL REVEALS ============ */
const io = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('in');
      if(e.target.classList.contains('card')){
        const fill = e.target.querySelector('.hp-fill');
        if(fill){
          const hp = parseInt(fill.dataset.hp,10);
          const pct = Math.min(100, (hp/300)*100);
          requestAnimationFrame(()=> fill.style.width = pct+'%');
        }
      }
      io.unobserve(e.target);
    }
  });
}, { threshold:0.2 });

document.querySelectorAll('.reveal, .card').forEach(el=>{
  el.classList.add('reveal');
  io.observe(el);
});

document.querySelectorAll('.mask-reveal').forEach(el => io.observe(el));
