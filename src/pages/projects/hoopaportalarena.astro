  setTimeout(function(){ el.classList.remove("hit-flash"); }, 420);
}

function wait(ms){ return new Promise(function(resolve){ setTimeout(resolve, ms); }); }

var bannerHideTimer = null;
function showBanner(text, kind){
  var el = document.getElementById("fx-banner");
  if(!el) return;
  // a banner shown while the previous one's own hide-timer is still pending (the mega/unbound
  // sequence fires two banners under 1.5s apart) would otherwise get cut off mid-animation by that
  // stale timer — always cancel any pending hide before starting a fresh one
  if(bannerHideTimer){ clearTimeout(bannerHideTimer); bannerHideTimer = null; }
  // when one banner fires while a previous one is still mid-animation (exactly what the mega/unbound
  // sequence does), the "animation" declaration that plays it is identical for every kind — so if
  // "show" is never actually removed, the browser treats this as the SAME animation instance
  // continuing rather than a fresh one, and the new banner inherits however little time the old one
  // had left. Removing "show" and forcing a reflow before re-adding it guarantees a clean restart.
  el.classList.remove("show");
  el.textContent = text;
  el.className = "fx-banner fx-"+kind;
  void el.offsetWidth;
  el.classList.add("show");
  bannerHideTimer = setTimeout(function(){ el.classList.remove("show"); bannerHideTimer = null; }, 1500);
}

function chargePortrait(side){
  var el = document.getElementById("port-"+side);
  if(!el) return;
  el.classList.remove("charge"); void el.offsetWidth; el.classList.add("charge");
  setTimeout(function(){ el.classList.remove("charge"); }, 680);
}

