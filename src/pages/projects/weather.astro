---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">

  <main
    class="weather-page relative min-h-screen overflow-hidden text-[var(--white)]"
  >

    <!-- ========================================================= -->
    <!-- INTERACTIVE BACKGROUND -->
    <!-- ========================================================= -->

    <canvas
      id="weather-background"
      class="pointer-events-none fixed inset-0 -z-20 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div
      class="pointer-events-none fixed inset-0 -z-[19]"
      aria-hidden="true"
    >
      <div class="blue-atmosphere"></div>
      <div class="blue-grid"></div>
      <div class="blue-noise"></div>
    </div>


    <!-- ========================================================= -->
    <!-- DOCUMENTATION SHELL -->
    <!-- ========================================================= -->

    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)] gap-12">

        <!-- ===================================================== -->
        <!-- DOCUMENTATION SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="hidden lg:block pt-32">

          <div class="sticky top-24">

            <div
              class="mb-6 text-[10px] font-mono uppercase
              tracking-[0.25em] text-[#2490ff]"
            >
              Project 03
            </div>

            <nav
              class="space-y-1 border-l border-white/10"
              aria-label="Weather documentation"
            >

              <a
                href="#overview"
                class="doc-link"
              >
                Overview
              </a>

              <a
                href="#current-weather"
                class="doc-link"
              >
                Current weather
              </a>

              <a
                href="#forecast"
                class="doc-link"
              >
                Forecast
              </a>

              <a
                href="#locations"
                class="doc-link"
              >
                Locations
              </a>

              <a
                href="#implementation"
                class="doc-link"
              >
                Implementation
              </a>

            </nav>


            <div class="mt-10 border-t border-white/10 pt-5">

              <div
                class="text-[10px] font-mono uppercase
                tracking-[0.2em] text-white/35"
              >
                Data source
              </div>

              <div class="mt-2 text-xs text-white/55">
                Open-Meteo
              </div>

            </div>

          </div>

        </aside>


        <!-- ===================================================== -->
        <!-- DOCUMENTATION CONTENT -->
        <!-- ===================================================== -->

        <div class="min-w-0 pt-24 pb-24 md:pt-32 md:pb-40">

          <!-- =================================================== -->
          <!-- HEADER -->
          <!-- =================================================== -->

          <section id="overview">

            <div class="mb-6 flex items-center gap-3">

              <span class="status-dot"></span>

              <span
                class="text-[10px] font-mono uppercase
                tracking-[0.28em] text-[#2490ff]"
              >
                Live weather system
              </span>

            </div>


            <h1
              class="max-w-4xl text-4xl font-medium
              tracking-[-0.04em] sm:text-5xl
              md:text-6xl lg:text-7xl"
            >
              Weather Dashboard
              <span class="text-[#2490ff]">.</span>
            </h1>


            <p
              class="mt-7 max-w-2xl text-base leading-8
              text-white/55 md:text-lg"
            >
              Real-time weather information for
              <span class="text-white/85">Alcoi</span>
              and
              <span class="text-white/85">Valencia</span>,
              presented through a technical documentation-inspired
              interface with an interactive electric-blue environment.
            </p>


            <!-- Mobile documentation navigation -->

            <div
              class="mt-8 flex flex-wrap gap-2 lg:hidden"
            >

              <a href="#current-weather" class="mobile-doc-link">
                Current
              </a>

              <a href="#forecast" class="mobile-doc-link">
                Forecast
              </a>

              <a href="#implementation" class="mobile-doc-link">
                Implementation
              </a>

            </div>


            <!-- Metadata -->

            <div
              class="mt-10 flex flex-wrap items-center gap-x-6
              gap-y-3 border-y border-white/10 py-5"
            >

              <div class="meta-item">
                <span>API</span>
                <strong>Open-Meteo</strong>
              </div>

              <div class="meta-separator"></div>

              <div class="meta-item">
                <span>UPDATE</span>
                <strong>Real-time</strong>
              </div>

              <div class="meta-separator"></div>

              <div class="meta-item">
                <span>TIMEZONE</span>
                <strong>Europe/Madrid</strong>
              </div>

              <div class="meta-separator"></div>

              <div class="meta-item">
                <span>STACK</span>
                <strong>Astro + TypeScript</strong>
              </div>

            </div>

          </section>


          <!-- =================================================== -->
          <!-- CURRENT WEATHER -->
          <!-- =================================================== -->

          <section
            id="current-weather"
            class="doc-section"
          >

            <div class="section-heading">

              <span class="section-number">
                01
              </span>

              <div>
                <span class="section-kicker">
                  Current conditions
                </span>

                <h2>
                  Weather right now
                </h2>
              </div>

            </div>


            <!-- WEATHER CARDS -->

            <div
              class="mt-8 grid grid-cols-1 gap-5 xl:grid-cols-2"
            >

              <!-- ================================================= -->
              <!-- ALCOI -->
              <!-- ================================================= -->

              <article
                class="weather-card"
                data-city="Alcoi"
                data-lat="38.6983"
                data-lon="-0.4743"
              >

                <div class="card-light"></div>

                <div class="relative z-10">

                  <div class="flex items-start justify-between">

                    <div>

                      <div class="location-label">
                        Location
                      </div>

                      <h3 class="city-name">
                        Alcoi
                        <span>.</span>
                      </h3>

                      <div class="coordinates">
                        38.6983° N · 0.4743° W
                      </div>

                    </div>


                    <div
                      class="weather-icon"
                      aria-label="Weather condition"
                    >
                      ⛅
                    </div>

                  </div>


                  <div class="mt-10">

                    <div class="flex items-end gap-4">

                      <div
                        class="weather-temperature"
                      >
                        --
                      </div>

                      <div class="pb-2 text-xl text-white/35">
                        °C
                      </div>

                    </div>


                    <div
                      class="weather-description mt-2"
                    >
                      Loading conditions...
                    </div>

                  </div>


                  <div
                    class="mt-9 grid grid-cols-2
                    gap-x-6 gap-y-6
                    border-t border-white/10 pt-7"
                  >

                    <div class="weather-stat">
                      <span>Feels like</span>
                      <strong class="weather-feels">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>High</span>
                      <strong class="weather-high">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Low</span>
                      <strong class="weather-low">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Rain chance</span>
                      <strong class="weather-rain">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Wind</span>
                      <strong class="weather-wind">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Humidity</span>
                      <strong class="weather-humidity">
                        --
                      </strong>
                    </div>

                  </div>


                  <div
                    class="mt-7 border-t border-white/10 pt-5"
                  >

                    <div
                      class="flex items-center justify-between"
                    >

                      <span class="text-[10px] font-mono uppercase tracking-widest text-white/30">
                        Last updated
                      </span>

                      <span
                        class="weather-time text-xs font-mono text-white/50"
                      >
                        --
                      </span>

                    </div>

                  </div>

                </div>

              </article>


              <!-- ================================================= -->
              <!-- VALENCIA -->
              <!-- ================================================= -->

              <article
                class="weather-card"
                data-city="Valencia"
                data-lat="39.4699"
                data-lon="-0.3763"
              >

                <div class="card-light"></div>

                <div class="relative z-10">

                  <div class="flex items-start justify-between">

                    <div>

                      <div class="location-label">
                        Location
                      </div>

                      <h3 class="city-name">
                        Valencia
                        <span>.</span>
                      </h3>

                      <div class="coordinates">
                        39.4699° N · 0.3763° W
                      </div>

                    </div>


                    <div
                      class="weather-icon"
                      aria-label="Weather condition"
                    >
                      ☀️
                    </div>

                  </div>


                  <div class="mt-10">

                    <div class="flex items-end gap-4">

                      <div
                        class="weather-temperature"
                      >
                        --
                      </div>

                      <div class="pb-2 text-xl text-white/35">
                        °C
                      </div>

                    </div>


                    <div
                      class="weather-description mt-2"
                    >
                      Loading conditions...
                    </div>

                  </div>


                  <div
                    class="mt-9 grid grid-cols-2
                    gap-x-6 gap-y-6
                    border-t border-white/10 pt-7"
                  >

                    <div class="weather-stat">
                      <span>Feels like</span>
                      <strong class="weather-feels">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>High</span>
                      <strong class="weather-high">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Low</span>
                      <strong class="weather-low">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Rain chance</span>
                      <strong class="weather-rain">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Wind</span>
                      <strong class="weather-wind">
                        --
                      </strong>
                    </div>

                    <div class="weather-stat">
                      <span>Humidity</span>
                      <strong class="weather-humidity">
                        --
                      </strong>
                    </div>

                  </div>


                  <div
                    class="mt-7 border-t border-white/10 pt-5"
                  >

                    <div
                      class="flex items-center justify-between"
                    >

                      <span class="text-[10px] font-mono uppercase tracking-widest text-white/30">
                        Last updated
                      </span>

                      <span
                        class="weather-time text-xs font-mono text-white/50"
                      >
                        --
                      </span>

                    </div>

                  </div>

                </div>

              </article>

            </div>

          </section>


          <!-- =================================================== -->
          <!-- FORECAST -->
          <!-- =================================================== -->

          <section
            id="forecast"
            class="doc-section"
          >

            <div class="section-heading">

              <span class="section-number">
                02
              </span>

              <div>
                <span class="section-kicker">
                  Daily forecast
                </span>

                <h2>
                  Next 7 days
                </h2>
              </div>

            </div>


            <p class="section-description">
              A compact forecast view showing the expected
              temperature range and precipitation probability
              for each location.
            </p>


            <!-- Forecast location selector -->

            <div class="mt-8 flex gap-2">

              <button
                type="button"
                class="forecast-tab active"
                data-forecast-city="Alcoi"
              >
                Alcoi
              </button>

              <button
                type="button"
                class="forecast-tab"
                data-forecast-city="Valencia"
              >
                Valencia
              </button>

            </div>


            <div
              id="forecast-container"
              class="mt-4 overflow-hidden rounded-2xl
              border border-white/10 bg-[#080d14]/80
              backdrop-blur-xl"
            >

              <div
                class="forecast-header hidden sm:grid
                grid-cols-[1.4fr_1fr_1fr_1fr]
                border-b border-white/10
                px-5 py-3"
              >

                <span>DAY</span>
                <span>CONDITION</span>
                <span>TEMPERATURE</span>
                <span>RAIN</span>

              </div>


              <div id="forecast-list">

                <div class="forecast-loading">
                  Loading forecast...
                </div>

              </div>

            </div>

          </section>


          <!-- =================================================== -->
          <!-- LOCATIONS -->
          <!-- =================================================== -->

          <section
            id="locations"
            class="doc-section"
          >

            <div class="section-heading">

              <span class="section-number">
                03
              </span>

              <div>
                <span class="section-kicker">
                  Locations
                </span>

                <h2>
                  Monitoring two cities
                </h2>
              </div>

            </div>


            <div
              class="mt-8 grid grid-cols-1
              md:grid-cols-2 gap-px
              overflow-hidden rounded-2xl
              border border-white/10
              bg-white/10"
            >

              <div class="location-block">

                <div class="location-index">
                  01
                </div>

                <h3>
                  Alcoi
                </h3>

                <p>
                  Inland Alicante region with a
                  mountainous Mediterranean climate.
                </p>

                <code>
                  lat: 38.6983<br />
                  lon: -0.4743
                </code>

              </div>


              <div class="location-block">

                <div class="location-index">
                  02
                </div>

                <h3>
                  Valencia
                </h3>

                <p>
                  Mediterranean coastal city on
                  Spain's eastern coast.
                </p>

                <code>
                  lat: 39.4699<br />
                  lon: -0.3763
                </code>

              </div>

            </div>

          </section>


          <!-- =================================================== -->
          <!-- IMPLEMENTATION -->
          <!-- =================================================== -->

          <section
            id="implementation"
            class="doc-section"
          >

            <div class="section-heading">

              <span class="section-number">
                04
              </span>

              <div>
                <span class="section-kicker">
                  Implementation
                </span>

                <h2>
                  How it works
                </h2>
              </div>

            </div>


            <div
              class="mt-8 rounded-2xl
              border border-white/10
              bg-[#080d14]/75
              backdrop-blur-xl"
            >

              <div class="implementation-row">

                <div class="implementation-number">
                  01
                </div>

                <div>

                  <h3>
                    Fetch weather data
                  </h3>

                  <p>
                    The page requests current and daily
                    forecast data directly from Open-Meteo
                    using the coordinates of each city.
                  </p>

                </div>

              </div>


              <div class="implementation-row">

                <div class="implementation-number">
                  02
                </div>

                <div>

                  <h3>
                    Update the interface
                  </h3>

                  <p>
                    The response is mapped into the weather
                    cards and forecast rows without requiring
                    a page reload.
                  </p>

                </div>

              </div>


              <div class="implementation-row">

                <div class="implementation-number">
                  03
                </div>

                <div>

                  <h3>
                    Render the environment
                  </h3>

                  <p>
                    A lightweight Canvas animation creates
                    an electric-blue particle field with
                    cursor interaction, connecting lines
                    and a technical grid.
                  </p>

                </div>

              </div>

            </div>


            <!-- Technology pills -->

            <div class="mt-10">

              <div class="technology-label">
                Technologies
              </div>

              <div class="mt-4 flex flex-wrap gap-2">

                <span class="tech-pill">
                  Astro
                </span>

                <span class="tech-pill">
                  TypeScript
                </span>

                <span class="tech-pill">
                  Open-Meteo API
                </span>

                <span class="tech-pill">
                  Canvas
                </span>

                <span class="tech-pill">
                  CSS
                </span>

                <span class="tech-pill">
                  REST
                </span>

              </div>

            </div>

          </section>


          <!-- =================================================== -->
          <!-- FOOTER NAVIGATION -->
          <!-- =================================================== -->

          <div
            class="mt-20 border-t border-white/10 pt-8"
          >

            <a
              href="/#projects"
              class="back-link"
            >
              <span>←</span>
              <span>Back to projects</span>
            </a>

          </div>

        </div>

      </div>

    </div>

  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>

  interface CurrentWeather {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
  }

  interface DailyWeather {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
  }

  interface WeatherResponse {
    current: CurrentWeather;
    daily: DailyWeather;
  }


  const getDescription = (
    code: number
  ): string => {

    const descriptions: Record<number, string> = {

      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",

      45: "Fog",
      48: "Rime fog",

      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",

      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",

      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",

      80: "Light rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",

      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",

    };

    return descriptions[code] ?? "Unknown conditions";
  };


  const getIcon = (
    code: number
  ): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 82) {
      return "🌦️";
    }

    return "⛈️";
  };


  const formatDay = (
    dateString: string,
    index: number
  ): string => {

    if (index === 0) {
      return "Today";
    }

    const date = new Date(
      `${dateString}T12:00:00`
    );

    return date.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
        day: "numeric",
        month: "short",
      }
    );
  };


  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );


  const cityData: Record<
    string,
    {
      lat: string;
      lon: string;
    }
  > = {

    Alcoi: {
      lat: "38.6983",
      lon: "-0.4743",
    },

    Valencia: {
      lat: "39.4699",
      lon: "-0.3763",
    },

  };


  const weatherCache: Record<
    string,
    WeatherResponse
  > = {};


  const fetchWeather = async (
    city: string
  ): Promise<WeatherResponse | null> => {

    if (weatherCache[city]) {
      return weatherCache[city];
    }


    const location =
      cityData[city];


    if (!location) {
      return null;
    }


    try {

      const url =
        "https://api.open-meteo.com/v1/forecast" +
        `?latitude=${location.lat}` +
        `&longitude=${location.lon}` +
        "&current=" +
        "temperature_2m," +
        "relative_humidity_2m," +
        "apparent_temperature," +
        "weather_code," +
        "wind_speed_10m" +
        "&daily=" +
        "weather_code," +
        "temperature_2m_max," +
        "temperature_2m_min," +
        "precipitation_probability_max" +
        "&forecast_days=7" +
        "&timezone=Europe%2FMadrid";


      const response =
        await fetch(url);


      if (!response.ok) {
        throw new Error(
          "Weather API request failed"
        );
      }


      const data =
        await response.json();


      weatherCache[city] = data;

      return data;

    } catch (error) {

      console.error(
        "Weather request error:",
        error
      );

      return null;
    }

  };


  const updateWeatherCard = async (
    card: HTMLElement
  ) => {

    const city =
      card.dataset.city;


    if (!city) {
      return;
    }


    const data =
      await fetchWeather(city);


    if (!data) {

      const description =
        card.querySelector(
          ".weather-description"
        );

      if (description) {
        description.textContent =
          "Unable to load weather";
      }

      return;
    }


    const current =
      data.current;

    const daily =
      data.daily;


    const temperature =
      card.querySelector(
        ".weather-temperature"
      );

    const description =
      card.querySelector(
        ".weather-description"
      );

    const feels =
      card.querySelector(
        ".weather-feels"
      );

    const high =
      card.querySelector(
        ".weather-high"
      );

    const low =
      card.querySelector(
        ".weather-low"
      );

    const rain =
      card.querySelector(
        ".weather-rain"
      );

    const wind =
      card.querySelector(
        ".weather-wind"
      );

    const humidity =
      card.querySelector(
        ".weather-humidity"
      );

    const time =
      card.querySelector(
        ".weather-time"
      );

    const icon =
      card.querySelector(
        ".weather-icon"
      );


    if (temperature) {
      temperature.textContent =
        String(
          Math.round(
            current.temperature_2m
          )
        );
    }


    if (description) {
      description.textContent =
        getDescription(
          current.weather_code
        );
    }


    if (feels) {
      feels.textContent =
        `${Math.round(
          current.apparent_temperature
        )}°C`;
    }


    if (high) {
      high.textContent =
        `${Math.round(
          daily.temperature_2m_max[0]
        )}°C`;
    }


    if (low) {
      low.textContent =
        `${Math.round(
          daily.temperature_2m_min[0]
        )}°C`;
    }


    if (rain) {
      rain.textContent =
        `${daily.precipitation_probability_max[0] ?? 0}%`;
    }


    if (wind) {
      wind.textContent =
        `${Math.round(
          current.wind_speed_10m
        )} km/h`;
    }


    if (humidity) {
      humidity.textContent =
        `${current.relative_humidity_2m}%`;
    }


    if (time) {

      time.textContent =
        new Date().toLocaleTimeString(
          "en-GB",
          {
            hour: "2-digit",
            minute: "2-digit",
          }
        );
    }


    if (icon) {
      icon.textContent =
        getIcon(
          current.weather_code
        );
    }

  };


  weatherCards.forEach(
    (card) => {
      updateWeatherCard(card);
    }
  );


  <!-- ========================================================= -->
  <!-- FORECAST -->
  <!-- ========================================================= -->


  const forecastList =
    document.querySelector<HTMLElement>(
      "#forecast-list"
    );


  const forecastTabs =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-tab"
    );


  let selectedForecastCity =
    "Alcoi";


  const renderForecast = async (
    city: string
  ) => {

    if (!forecastList) {
      return;
    }


    forecastList.innerHTML =
      `
        <div class="forecast-loading">
          Loading ${city} forecast...
        </div>
      `;


    const data =
      await fetchWeather(city);


    if (!data) {

      forecastList.innerHTML =
        `
          <div class="forecast-loading">
            Unable to load forecast.
          </div>
        `;

      return;
    }


    const daily =
      data.daily;


    forecastList.innerHTML = "";


    daily.time.forEach(
      (
        date,
        index
      ) => {

        const row =
          document.createElement(
            "div"
          );


        row.className =
          "forecast-row";


        const day =
          document.createElement(
            "div"
          );

        day.className =
          "forecast-day";


        const dayName =
          document.createElement(
            "strong"
          );

        dayName.textContent =
          formatDay(
            date,
            index
          );


        const dateSmall =
          document.createElement(
            "span"
          );

        dateSmall.textContent =
          date;


        day.appendChild(
          dayName
        );

        day.appendChild(
          dateSmall
        );


        const condition =
          document.createElement(
            "div"
          );

        condition.className =
          "forecast-condition";


        const conditionIcon =
          document.createElement(
            "span"
          );

        conditionIcon.textContent =
          getIcon(
            daily.weather_code[index]
          );


        const conditionText =
          document.createElement(
            "span"
          );

        conditionText.textContent =
          getDescription(
            daily.weather_code[index]
          );


        condition.appendChild(
          conditionIcon
        );

        condition.appendChild(
          conditionText
        );


        const temperature =
          document.createElement(
            "div"
          );

        temperature.className =
          "forecast-temperature";


        temperature.innerHTML =
          `
            <strong>
              ${Math.round(
                daily.temperature_2m_max[index]
              )}°
            </strong>

            <span>
              ${Math.round(
                daily.temperature_2m_min[index]
              )}°
            </span>
          `;


        const precipitation =
          document.createElement(
            "div"
          );

        precipitation.className =
          "forecast-rain";


        precipitation.textContent =
          `${daily.precipitation_probability_max[index] ?? 0}%`;


        row.appendChild(day);
        row.appendChild(condition);
        row.appendChild(temperature);
        row.appendChild(precipitation);


        forecastList.appendChild(
          row
        );

      }
    );

  };


  forecastTabs.forEach(
    (tab) => {

      tab.addEventListener(
        "click",
        () => {

          const city =
            tab.dataset.forecastCity;


          if (!city) {
            return;
          }


          selectedForecastCity =
            city;


          forecastTabs.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          tab.classList.add(
            "active"
          );


          renderForecast(
            selectedForecastCity
          );

        }
      );

    }
  );


  renderForecast(
    selectedForecastCity
  );

</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE INTERACTIVE BACKGROUND -->
<!-- ============================================================= -->

<script>

  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        radius: number;
        alpha: number;
      }


      const particles: Particle[] =
        [];


      let width = 0;
      let height = 0;


      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;


      const getParticleCount =
        () => {

          if (
            window.innerWidth < 640
          ) {
            return 38;
          }

          if (
            window.innerWidth < 1024
          ) {
            return 58;
          }

          return 90;
        };


      const resize =
        () => {

          const ratio =
            Math.min(
              window.devicePixelRatio || 1,
              2
            );


          width =
            window.innerWidth;

          height =
            window.innerHeight;


          canvas.width =
            width * ratio;

          canvas.height =
            height * ratio;


          canvas.style.width =
            `${width}px`;

          canvas.style.height =
            `${height}px`;


          context.setTransform(
            ratio,
            0,
            0,
            ratio,
            0,
            0
          );

        };


      const createParticle =
        (): Particle => {

          return {

            x:
              Math.random() *
              width,

            y:
              Math.random() *
              height,

            vx:
              (
                Math.random() -
                0.5
              ) * 0.22,

            vy:
              (
                Math.random() -
                0.5
              ) * 0.22,

            radius:
              Math.random() *
              1.5 +
              0.35,

            alpha:
              Math.random() *
              0.42 +
              0.05,

          };

        };


      const initialize =
        () => {

          particles.length =
            0;


          const count =
            getParticleCount();


          for (
            let i = 0;
            i < count;
            i++
          ) {

            particles.push(
              createParticle()
            );

          }

        };


      const drawGrid =
        () => {

          const spacing =
            80;


          context.save();


          context.lineWidth =
            1;


          const offsetX =
            (
              mouseX -
              width / 2
            ) * 0.012;


          const offsetY =
            (
              mouseY -
              height / 2
            ) * 0.012;


          context.strokeStyle =
            "rgba(36,144,255,0.045)";


          for (
            let x =
              -spacing +
              (
                offsetX %
                spacing
              );

            x <
            width +
            spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();

          }


          for (
            let y =
              -spacing +
              (
                offsetY %
                spacing
              );

            y <
            height +
            spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();

          }


          context.restore();

        };


      const drawGlow =
        () => {

          const gradient =
            context.createRadialGradient(
              mouseX,
              mouseY,
              0,
              mouseX,
              mouseY,
              320
            );


          gradient.addColorStop(
            0,
            "rgba(36,144,255,0.10)"
          );


          gradient.addColorStop(
            0.45,
            "rgba(36,144,255,0.035)"
          );


          gradient.addColorStop(
            1,
            "rgba(36,144,255,0)"
          );


          context.fillStyle =
            gradient;


          context.fillRect(
            0,
            0,
            width,
            height
          );

        };


      const drawConnections =
        () => {

          const maxDistance =
            145;


          for (
            let i = 0;
            i < particles.length;
            i++
          ) {

            for (
              let j = i + 1;
              j < particles.length;
              j++
            ) {

              const a =
                particles[i];

              const b =
                particles[j];


              const dx =
                a.x -
                b.x;

              const dy =
                a.y -
                b.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const alpha =
                  (
                    1 -
                    distance /
                      maxDistance
                  ) * 0.08;


                context.beginPath();


                context.moveTo(
                  a.x,
                  a.y
                );


                context.lineTo(
                  b.x,
                  b.y
                );


                context.strokeStyle =
                  `rgba(36,144,255,${alpha})`;


                context.lineWidth =
                  0.7;


                context.stroke();

              }

            }

          }

        };


      const drawParticles =
        () => {

          for (
            const particle
            of particles
          ) {

            particle.x +=
              particle.vx;

            particle.y +=
              particle.vy;


            if (
              particle.x <
              -20
            ) {
              particle.x =
                width + 20;
            }


            if (
              particle.x >
              width + 20
            ) {
              particle.x =
                -20;
            }


            if (
              particle.y <
              -20
            ) {
              particle.y =
                height + 20;
            }


            if (
              particle.y >
              height + 20
            ) {
              particle.y =
                -20;
            }


            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance < 220
            ) {

              const force =
                (
                  1 -
                  distance /
                    220
                ) * 0.006;


              particle.vx +=
                dx * force;

              particle.vy +=
                dy * force;

            }


            particle.vx *=
              0.992;

            particle.vy *=
              0.992;


            context.beginPath();


            context.arc(
              particle.x,
              particle.y,
              particle.radius,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(36,144,255,${particle.alpha})`;


            context.fill();

          }

        };


      const animate =
        () => {

          mouseX +=
            (
              targetMouseX -
              mouseX
            ) * 0.045;


          mouseY +=
            (
              targetMouseY -
              mouseY
            ) * 0.045;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawGrid();

          drawGlow();

          drawConnections();

          drawParticles();


          requestAnimationFrame(
            animate
          );

        };


      window.addEventListener(
        "resize",
        () => {

          resize();

          initialize();

        }
      );


      window.addEventListener(
        "mousemove",
        (event) => {

          targetMouseX =
            event.clientX;

          targetMouseY =
            event.clientY;

        },
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        () => {

          targetMouseX =
            width / 2;

          targetMouseY =
            height / 2;

        }
      );


      resize();


      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;


      mouseX =
        width / 2;

      mouseY =
        height / 2;


      initialize();

      animate();

    }

  }

</script>


