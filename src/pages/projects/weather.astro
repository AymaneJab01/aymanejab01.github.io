                  --
                </strong>

              </div>


              <div class="weather-summary-item">

                <span>HIGH</span>

                <strong class="weather-high">
                  --
                </strong>

              </div>


              <div class="weather-summary-item">

                <span>LOW</span>

                <strong class="weather-low">
