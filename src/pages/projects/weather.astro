  .api-header {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--white-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
  }


  .api-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--electric-blue);
    box-shadow:
      0 0 12px rgba(0, 174, 255, 0.65);
  }


  .api-box code {
    display: block;
    margin-top: 13px;
    overflow-wrap: anywhere;
    color: var(--electric-blue-bright);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 12px;
  }


  /* ============================================================ */
  /* BACK */
  /* ============================================================ */

  .back-section {
    margin-top: 60px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
