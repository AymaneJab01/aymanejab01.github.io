<style>
  /* ============================================================ */
  /* VARIABLES */
  /* ============================================================ */

  .weather-page {
    --electric-blue: #0071f0;
    --electric-blue-bright: #2f8dff;
    --electric-blue-deep: #0a4fc4;
    --electric-blue-soft: rgba(0, 113, 240, 0.07);

    --ink: #0d1420;
    --ink-soft: rgba(13, 20, 32, 0.64);
    --ink-muted: rgba(13, 20, 32, 0.42);

    --white: #ffffff;

    --border: rgba(13, 20, 32, 0.08);
    --glass-line: rgba(255, 255, 255, 0.76);

    --glass: rgba(255, 255, 255, 0.58);

    --glass-shadow:
      0 24px 60px rgba(29, 77, 130, 0.14);

    position: relative;

    min-height: 100vh;

    overflow: hidden;

    color: var(--ink);

    background:
      radial-gradient(
        circle at 8% 12%,
        rgba(130, 214, 255, 0.48),
