<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>

  type WeatherCurrent = {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    surface_pressure: number;
    uv_index: number;
  };


  type WeatherForecast = {
    time: string[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    weather_code: number[];
  };


  type WeatherApiResponse = {
    current: WeatherCurrent;
    daily: WeatherForecast;
    hourly: {
      time: string[];
      temperature_2m: number[];
      weather_code: number[];
    };
  };


  const getDescription = (
    code: number
  ): string => {

    const descriptions: Record<number, string> = {

      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",

      45: "Fog",
      48: "Rime fog",

      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",

      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",

      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",

      80: "Rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",

      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",

    };

    return descriptions[code] ?? "Unknown conditions";

  };


  const getIcon = (
    code: number
  ): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 82) {
      return "🌦️";
    }

    return "⛈️";

  };


  const formatDay = (
    dateString: string,
    index: number
  ): string => {

    if (index === 0) {
      return "Today";
    }

    if (index === 1) {
      return "Tomorrow";
    }

    return new Date(
      `${dateString}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );

  };


  const updateHourly = (
    panel: HTMLElement,
    data: WeatherApiResponse
  ) => {

    const now = new Date();

    let closestIndex = 0;

    let smallestDifference =
      Number.POSITIVE_INFINITY;


    data.hourly.time.forEach(
      (time, index) => {

        const difference =
          Math.abs(
            new Date(time).getTime() -
            now.getTime()
          );

        if (
          difference <
          smallestDifference
        ) {

          smallestDifference =
            difference;

          closestIndex =
            index;

        }

      }
    );


    const cards =
      panel.querySelectorAll<HTMLElement>(
        ".hour-card"
      );


    cards.forEach(
      (card, index) => {

        const dataIndex =
          closestIndex + index;

        if (
          dataIndex >=
          data.hourly.time.length
        ) {
          return;
        }


        const date =
          new Date(
            data.hourly.time[dataIndex]
          );


        const time =
          index === 0
            ? "NOW"
            : date.toLocaleTimeString(
                "en-GB",
                {
                  hour: "2-digit",
                  minute: "2-digit",
                }
              );


        const temperature =
          Math.round(
            data.hourly.temperature_2m[
              dataIndex
            ]
          );


        const icon =
          getIcon(
            data.hourly.weather_code[
              dataIndex
            ]
          );


        const timeElement =
          card.querySelector("span");

        const iconElement =
          card.querySelector(".hour-icon");

        const temperatureElement =
          card.querySelector("b");


        if (timeElement) {
          timeElement.textContent =
            time;
        }

        if (iconElement) {
          iconElement.textContent =
            icon;
        }

        if (temperatureElement) {
          temperatureElement.textContent =
            `${temperature}°`;
        }

      }
    );

  };


  const updateForecast = (
    panel: HTMLElement,
    data: WeatherApiResponse
  ) => {

    const rows =
      panel.querySelectorAll<HTMLElement>(
        ".forecast-row"
      );


    rows.forEach(
      (row, index) => {

        if (
          index >=
          data.daily.time.length
        ) {
          return;
        }


        const date =
          data.daily.time[index];


        const day =
          row.querySelector(
            ".forecast-day"
          );

        const icon =
          row.querySelector(
            ".forecast-icon"
          );

        const description =
          row.querySelector(
            ".forecast-description"
          );

        const rain =
          row.querySelector(
            ".forecast-rain"
          );

        const temperatures =
          row.querySelectorAll(
            ".forecast-temperature strong, .forecast-temperature span"
          );


        if (day) {

          day.textContent =
            formatDay(
              date,
              index
            );

        }


        if (icon) {

          icon.textContent =
            getIcon(
              data.daily.weather_code[
                index
              ]
            );

        }


        if (description) {

          description.textContent =
            getDescription(
              data.daily.weather_code[
                index
              ]
            );

        }


        if (rain) {

          rain.textContent =
            `${data.daily.precipitation_probability_max[index]}%`;

        }


        if (
          temperatures.length >= 2
        ) {

          temperatures[0].textContent =
            `${Math.round(
              data.daily.temperature_2m_max[
                index
              ]
            )}°`;

          temperatures[1].textContent =
            `${Math.round(
              data.daily.temperature_2m_min[
                index
              ]
            )}°`;

        }

      }
    );

  };


  const loadWeather = async (
    panel: HTMLElement
  ) => {

    const latitude =
      panel.dataset.lat;

    const longitude =
      panel.dataset.lon;


    if (
      !latitude ||
      !longitude
    ) {

      return;

    }


    try {

      const url =
        "https://api.open-meteo.com/v1/forecast" +
        `?latitude=${latitude}` +
        `&longitude=${longitude}` +
        "&current=" +
        "temperature_2m," +
        "relative_humidity_2m," +
        "apparent_temperature," +
        "weather_code," +
        "wind_speed_10m," +
        "surface_pressure," +
        "uv_index" +
        "&hourly=" +
        "temperature_2m," +
        "weather_code" +
        "&daily=" +
        "temperature_2m_max," +
        "temperature_2m_min," +
        "precipitation_probability_max," +
        "weather_code" +
        "&timezone=Europe%2FMadrid";


      const response =
        await fetch(url);


      if (!response.ok) {

        throw new Error(
          "Weather API request failed"
        );

      }


      const data =
        await response.json() as WeatherApiResponse;


      const current =
        data.current;


      const temperature =
        panel.querySelector(
          ".temperature"
        );

      const description =
        panel.querySelector(
          ".weather-description"
        );

      const icon =
        panel.querySelector(
          ".weather-icon-large"
        );

      const feels =
        panel.querySelector(
          ".weather-feels"
        );

      const high =
        panel.querySelector(
          ".weather-high"
        );

      const low =
        panel.querySelector(
          ".weather-low"
        );

      const rain =
        panel.querySelector(
          ".weather-rain"
        );

      const wind =
        panel.querySelector(
          ".weather-wind"
        );

      const humidity =
        panel.querySelector(
          ".weather-humidity"
        );

      const pressure =
        panel.querySelector(
          ".weather-pressure"
        );

      const uv =
        panel.querySelector(
          ".weather-uv"
        );

      const updated =
        panel.querySelector(
          ".weather-updated"
        );


      if (temperature) {

        temperature.textContent =
          `${Math.round(
            current.temperature_2m
          )}`;

      }


      if (description) {

        description.textContent =
          getDescription(
            current.weather_code
          );

      }


      if (icon) {

        icon.textContent =
          getIcon(
            current.weather_code
          );

      }


      if (feels) {

        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°`;

      }


      if (high) {

        high.textContent =
          `${Math.round(
            data.daily.temperature_2m_max[0]
          )}°`;

      }


      if (low) {

        low.textContent =
          `${Math.round(
            data.daily.temperature_2m_min[0]
          )}°`;

      }


      if (rain) {

        rain.textContent =
          `${data.daily.precipitation_probability_max[0]}%`;

      }


      if (wind) {

        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )}`;

      }


      if (humidity) {

        humidity.textContent =
          `${current.relative_humidity_2m}`;

      }


      if (pressure) {

        pressure.textContent =
          `${Math.round(
            current.surface_pressure
          )}`;

      }


      if (uv) {

        uv.textContent =
          current.uv_index.toFixed(1);

      }


      if (updated) {

        updated.textContent =
          new Date().toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit",
            }
          );

      }


      updateHourly(
        panel,
        data
      );


      updateForecast(
        panel,
        data
      );


    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );


      const description =
        panel.querySelector(
          ".weather-description"
        );


      if (description) {

        description.textContent =
          "Unable to load weather";

      }

    }

  };


  const weatherPanels =
    document.querySelectorAll<HTMLElement>(
      ".weather-location"
    );


  weatherPanels.forEach(
    (panel) => {
      loadWeather(panel);
    }
  );


  /*
   * LOCATION SWITCHING
   */

  const locationTabs =
    document.querySelectorAll<HTMLButtonElement>(
      ".location-tab"
    );


  locationTabs.forEach(
    (tab) => {

      tab.addEventListener(
        "click",
        () => {

          const location =
            tab.dataset.location;


          if (!location) {
            return;
          }


          locationTabs.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          tab.classList.add(
            "active"
          );


          weatherPanels.forEach(
            (panel) => {

              if (
                panel.dataset.locationPanel ===
                location
              ) {

                panel.classList.add(
                  "active-location"
                );

              } else {

                panel.classList.remove(
                  "active-location"
                );

              }

            }
          );

        }
      );

    }
  );

</script>


<!-- ============================================================= -->
<!-- INTERACTIVE CANVAS -->
<!-- ============================================================= -->

<script>

  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      type Particle = {

        x: number;
        y: number;

        vx: number;
        vy: number;

        size: number;
        opacity: number;

      };


      const particles: Particle[] =
        [];


      let width = 0;
      let height = 0;


      let mouseX = 0;
      let mouseY = 0;


      let targetMouseX = 0;
      let targetMouseY = 0;


      const isMobile =
        window.innerWidth < 768;


      const particleCount =
        isMobile
          ? 38
          : 85;


      const resize = () => {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;

        height =
          window.innerHeight;


        canvas.width =
          width * ratio;

        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;

        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );

      };


      const createParticle =
        (): Particle => {

          return {

            x:
              Math.random() *
              width,

            y:
              Math.random() *
              height,

            vx:
              (Math.random() - 0.5) *
              0.25,

            vy:
              (Math.random() - 0.5) *
              0.25,

            size:
              Math.random() *
              1.5 +
              0.4,

            opacity:
              Math.random() *
              0.45 +
              0.08,

          };

        };


      const initialize =
        () => {

          particles.length =
            0;


          for (
            let i = 0;
            i < particleCount;
            i++
          ) {

            particles.push(
              createParticle()
            );

          }

        };


      const drawGrid =
        () => {

          const spacing =
            80;


          context.save();


          context.strokeStyle =
            "rgba(0,170,255,0.035)";


          context.lineWidth =
            1;


          const offsetX =
            (
              mouseX -
              width / 2
            ) * 0.012;


          const offsetY =
            (
              mouseY -
              height / 2
            ) * 0.012;


          for (
            let x =
              -spacing +
              (offsetX % spacing);

            x <
            width +
            spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();

          }


          for (
            let y =
              -spacing +
              (offsetY % spacing);

            y <
            height +
            spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();

          }


          context.restore();

        };


      const drawParticles =
        () => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;

            particle.y +=
              particle.vy;


            if (
              particle.x <
              -10
            ) {

              particle.x =
                width + 10;

            }


            if (
              particle.x >
              width + 10
            ) {

              particle.x =
                -10;

            }


            if (
              particle.y <
              -10
            ) {

              particle.y =
                height + 10;

            }


            if (
              particle.y >
              height + 10
            ) {

              particle.y =
                -10;

            }


            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              220
            ) {

              const force =
                (
                  1 -
                  distance / 220
                ) * 0.012;


              particle.vx +=
                dx * force;


              particle.vy +=
                dy * force;

            }


            particle.vx *=
              0.995;

            particle.vy *=
              0.995;


            context.beginPath();


            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(0,174,255,${particle.opacity})`;


            context.fill();

          }

        };


      const drawConnections =
        () => {

          const maxDistance =
            145;


          for (
            let i = 0;
            i < particles.length;
            i++
          ) {

            for (
              let j =
                i + 1;

              j <
              particles.length;

              j++
            ) {

              const a =
                particles[i];


              const b =
                particles[j];


              const dx =
                a.x -
                b.x;


              const dy =
                a.y -
                b.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (
                    1 -
                    distance /
                      maxDistance
                  ) * 0.085;


                context.beginPath();


                context.moveTo(
                  a.x,
                  a.y
                );


                context.lineTo(
                  b.x,
                  b.y
                );


                context.strokeStyle =
                  `rgba(0,174,255,${opacity})`;


                context.lineWidth =
                  1;


                context.stroke();

              }

            }

          }

        };


      const drawMouseGlow =
        () => {

          const gradient =
            context.createRadialGradient(
              targetMouseX,
              targetMouseY,
              0,
              targetMouseX,
              targetMouseY,
              260
            );


          gradient.addColorStop(
            0,
            "rgba(0,174,255,0.08)"
          );


          gradient.addColorStop(
            1,
            "rgba(0,174,255,0)"
          );


          context.fillStyle =
            gradient;


          context.fillRect(
            0,
            0,
            width,
            height
          );

        };


      const animate =
        () => {

          mouseX +=
            (
              targetMouseX -
              mouseX
            ) * 0.045;


          mouseY +=
            (
              targetMouseY -
              mouseY
            ) * 0.045;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawGrid();

          drawMouseGlow();

          drawConnections();

          drawParticles();


          requestAnimationFrame(
            animate
          );

        };


      window.addEventListener(
        "resize",
        () => {

          resize();

          initialize();

        }
      );


      window.addEventListener(
        "mousemove",
        (event) => {

          targetMouseX =
            event.clientX;

          targetMouseY =
            event.clientY;

        },
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        () => {

          targetMouseX =
            width / 2;

          targetMouseY =
            height / 2;

        }
      );


      resize();


      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;


      mouseX =
        width / 2;

      mouseY =
        height / 2;


      initialize();


      const reduceMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reduceMotion) {

        animate();

      } else {

        drawGrid();

      }

    }

  }

</script>


