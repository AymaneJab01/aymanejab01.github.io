---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">
  <main class="weather-page">
    <!-- Interactive background -->
    <canvas
      id="weather-background"
      class="weather-background"
      aria-hidden="true"
    ></canvas>

    <div class="weather-atmosphere" aria-hidden="true"></div>

    <section class="weather-content">
      <div class="weather-wrapper">

        <!-- ====================================================== -->
        <!-- PAGE LABEL -->
        <!-- ====================================================== -->

        <header class="page-header">
          <div class="project-label">
            <span class="status-dot"></span>
            <span>PROJECT 03 / WEATHER</span>
          </div>

          <div class="technology-tags">
            <span>Astro</span>
            <span>TypeScript</span>
            <span>Open-Meteo</span>
            <span>Canvas</span>
          </div>
        </header>


        <!-- ====================================================== -->
        <!-- LOCATION SWITCHER -->
        <!-- ====================================================== -->

        <nav class="location-tabs" aria-label="Choose location">
          <button
            type="button"
            class="location-tab active"
            data-lat="38.6983"
            data-lon="-0.4743"
            data-city="Alcoi"
            data-region="Alicante, Spain"
          >
            Alcoi
          </button>

          <button
            type="button"
            class="location-tab"
            data-lat="39.4699"
            data-lon="-0.3763"
            data-city="Valencia"
            data-region="Valencia, Spain"
          >
            Valencia
          </button>
        </nav>


        <!-- ====================================================== -->
        <!-- HERO / CURRENT CONDITIONS -->
        <!-- ====================================================== -->

        <section class="hero" aria-labelledby="hero-city">
          <div class="hero-glow" aria-hidden="true"></div>

          <div class="hero-top">
            <div class="hero-location">
              <span class="hero-eyebrow">LOCATION</span>
              <h1 id="hero-city">
                Alcoi<span>.</span>
              </h1>
              <p id="hero-region">Alicante, Spain</p>
            </div>

            <div class="hero-icon-badge" id="hero-icon" aria-hidden="true">
              —
            </div>
          </div>

          <div class="hero-now">
            <span class="hero-now-label">NOW</span>

            <div class="hero-temp-row">
              <span id="hero-temp" class="hero-temp">--</span>
              <span class="hero-unit">°C</span>
            </div>

            <p id="hero-description" class="hero-description">
              Loading weather...
            </p>
          </div>

          <div class="hero-stats">
            <div class="hero-stat">
              <span>FEELS LIKE</span>
              <strong id="hero-feels">--</strong>
            </div>

            <div class="hero-stat">
              <span>HIGH</span>
              <strong id="hero-high">--</strong>
            </div>

            <div class="hero-stat">
              <span>LOW</span>
              <strong id="hero-low">--</strong>
            </div>

            <div class="hero-stat">
              <span>CHANCE OF RAIN</span>
              <strong id="hero-rain">--</strong>
            </div>
          </div>

          <div class="hero-meta">
            <span>WIND <strong id="hero-wind">--</strong></span>
            <span>HUMIDITY <strong id="hero-humidity">--</strong></span>
            <span>UPDATED <strong id="hero-time">--</strong></span>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- TODAY'S OUTLOOK -->
        <!-- ====================================================== -->

        <section class="outlook-section" aria-labelledby="outlook-title">
          <div class="outlook-card">
            <span class="outlook-eyebrow">TODAY'S OUTLOOK</span>
            <h2 id="outlook-title">
              What to expect
            </h2>
            <p id="outlook-text">
              Fetching the latest conditions to build today's outlook.
            </p>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DAILY FORECAST -->
        <!-- ====================================================== -->

        <section
          class="weather-section forecast-section"
          aria-labelledby="forecast-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>DAILY FORECAST</span>

            <h2 id="forecast-title">
              Seven day outlook
            </h2>

            <p>
              A seven-day forecast generated from the same live
              weather service, for the selected location above.
            </p>
          </div>


          <div
            id="forecast-container"
            class="forecast-container"
          >
            <div class="forecast-loading">
              Loading forecast...
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DOCUMENTATION -->
        <!-- ====================================================== -->

        <section
          class="weather-section documentation-section"
          aria-labelledby="documentation-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>DOCUMENTATION</span>

            <h2 id="documentation-title">
              Live data meets interactive UI.
            </h2>

            <p>
              This project combines a lightweight Astro page with
              client-side TypeScript to retrieve and display live
              meteorological information.
            </p>
          </div>


          <div class="documentation-grid">

            <article class="documentation-card">
              <span>01</span>

              <h3>
                Data source
              </h3>

              <p>
                Weather information is retrieved from Open-Meteo
                using geographic coordinates for Alcoi and Valencia.
              </p>
            </article>


            <article class="documentation-card">
              <span>02</span>

              <h3>
                Client rendering
              </h3>

              <p>
                TypeScript fetches weather information in the
                browser and updates the interface dynamically.
              </p>
            </article>


            <article class="documentation-card">
              <span>03</span>

              <h3>
                Interactive background
              </h3>

              <p>
                Canvas particles, connections and a subtle grid
                create a sophisticated electric-blue atmosphere.
              </p>
            </article>


            <article class="documentation-card">
              <span>04</span>

              <h3>
                Responsive design
              </h3>

              <p>
                The dashboard adapts between mobile and desktop
                layouts while preserving the visual hierarchy.
              </p>
            </article>

          </div>


          <div class="technologies">
            <span>TECHNOLOGIES</span>

            <div class="technology-list">
              <span>Astro</span>
              <span>TypeScript</span>
              <span>Open-Meteo API</span>
              <span>Fetch API</span>
              <span>HTML</span>
              <span>CSS</span>
              <span>Canvas API</span>
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- API -->
        <!-- ====================================================== -->

        <section class="api-section">
          <div class="api-box">
            <div class="api-header">
              <span class="api-dot"></span>
              <span>API ENDPOINT</span>
            </div>

            <code>
              api.open-meteo.com/v1/forecast
            </code>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- BACK -->
        <!-- ====================================================== -->

        <div class="back-section">
          <a
            href="/#projects"
            class="back-link"
          >
            <span>←</span>
            <span>Back to projects</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  /* ============================================================ */
  /* WEATHER DESCRIPTION */
  /* ============================================================ */

  function getWeatherDescription(code: number): string {
    switch (code) {
      case 0:
        return "Clear sky";
      case 1:
        return "Mainly clear";
      case 2:
        return "Partly cloudy";
      case 3:
        return "Overcast";
      case 45:
        return "Fog";
      case 48:
        return "Rime fog";
      case 51:
        return "Light drizzle";
      case 53:
        return "Moderate drizzle";
      case 55:
        return "Dense drizzle";
      case 56:
        return "Light freezing drizzle";
      case 57:
        return "Dense freezing drizzle";
      case 61:
        return "Light rain";
      case 63:
        return "Moderate rain";
      case 65:
        return "Heavy rain";
      case 66:
        return "Light freezing rain";
      case 67:
        return "Heavy freezing rain";
      case 71:
        return "Light snow";
      case 73:
        return "Moderate snow";
      case 75:
        return "Heavy snow";
      case 77:
        return "Snow grains";
      case 80:
        return "Light rain showers";
      case 81:
        return "Moderate rain showers";
      case 82:
        return "Heavy rain showers";
      case 85:
        return "Light snow showers";
      case 86:
        return "Heavy snow showers";
      case 95:
        return "Thunderstorm";
      case 96:
        return "Thunderstorm with hail";
      case 99:
        return "Thunderstorm with heavy hail";
      default:
        return "Unknown conditions";
    }
  }


  /* ============================================================ */
  /* WEATHER ICON */
  /* ============================================================ */

  function getWeatherIcon(code: number): string {
    if (code === 0) return "☀";
    if (code <= 3) return "◐";
    if (code <= 48) return "≋";
    if (code <= 67) return "∿";
    if (code <= 77) return "❄";
    if (code <= 86) return "◒";
    return "ϟ";
  }


  /* ============================================================ */
  /* API URL */
  /* ============================================================ */

  function buildWeatherUrl(latitude: string, longitude: string): string {
    const base = "https://api.open-meteo.com/v1/forecast";

    const params = new URLSearchParams({
      latitude,
      longitude,
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",
      timezone: "Europe/Madrid",
      forecast_days: "7"
    });

    return `${base}?${params.toString()}`;
  }


  /* ============================================================ */
  /* FORMAT HELPERS */
  /* ============================================================ */

  function formatTime(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "--";
    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function formatDay(value: string): string {
    const date = new Date(`${value}T12:00:00`);
    if (Number.isNaN(date.getTime())) return "--";
    return date.toLocaleDateString("en-GB", { weekday: "short" });
  }


  /* ============================================================ */
  /* DOM REFERENCES */
  /* ============================================================ */

  const heroCity = document.getElementById("hero-city");
  const heroRegion = document.getElementById("hero-region");
  const heroIcon = document.getElementById("hero-icon");
  const heroTemp = document.getElementById("hero-temp");
  const heroDescription = document.getElementById("hero-description");
  const heroFeels = document.getElementById("hero-feels");
  const heroHigh = document.getElementById("hero-high");
  const heroLow = document.getElementById("hero-low");
  const heroRain = document.getElementById("hero-rain");
  const heroWind = document.getElementById("hero-wind");
  const heroHumidity = document.getElementById("hero-humidity");
  const heroTime = document.getElementById("hero-time");

  const outlookText = document.getElementById("outlook-text");

  const forecastContainer =
    document.getElementById("forecast-container") as HTMLElement | null;

  const locationTabs =
    document.querySelectorAll<HTMLButtonElement>(".location-tab");


  /* ============================================================ */
  /* RENDER: HERO + OUTLOOK */
  /* ============================================================ */

  function renderHero(city: string, region: string, data: WeatherResponse): void {
    const current = data.current;
    const today = 0;

    const high = data.daily.temperature_2m_max[today];
    const low = data.daily.temperature_2m_min[today];
    const rain = data.daily.precipitation_probability_max[today];

    if (heroCity) {
      heroCity.innerHTML = `${city}<span>.</span>`;
    }

    if (heroRegion) {
      heroRegion.textContent = region;
    }

    if (heroTemp) {
      heroTemp.textContent = Math.round(current.temperature_2m).toString();
    }

    if (heroDescription) {
      heroDescription.textContent = getWeatherDescription(current.weather_code);
    }

    if (heroIcon) {
      heroIcon.textContent = getWeatherIcon(current.weather_code);
    }

    if (heroFeels) {
      heroFeels.textContent = `${Math.round(current.apparent_temperature)}°`;
    }

    if (heroHigh && high !== undefined) {
      heroHigh.textContent = `${Math.round(high)}°`;
    }

    if (heroLow && low !== undefined) {
      heroLow.textContent = `${Math.round(low)}°`;
    }

    if (heroRain) {
      heroRain.textContent = rain !== undefined ? `${Math.round(rain)}%` : "--";
    }

    if (heroWind) {
      heroWind.textContent = `${Math.round(current.wind_speed_10m)} km/h`;
    }

    if (heroHumidity) {
      heroHumidity.textContent = `${current.relative_humidity_2m}%`;
    }

    if (heroTime) {
      heroTime.textContent = formatTime(current.time);
    }

    if (outlookText && high !== undefined && low !== undefined) {
      const description = getWeatherDescription(current.weather_code).toLowerCase();
      const rainText =
        rain !== undefined && rain >= 30
          ? ` There's a ${Math.round(rain)}% chance of rain, so it may be worth keeping an umbrella close by.`
          : "";

      outlookText.textContent =
        `Expect ${description} in ${city} today, with a high near ${Math.round(high)}° and a low around ${Math.round(low)}°.${rainText}`;
    }
  }


  /* ============================================================ */
  /* RENDER: DAILY FORECAST STRIP */
  /* ============================================================ */

  function renderForecast(data: WeatherResponse): void {
    if (!forecastContainer) return;

    const daily = data.daily;
    forecastContainer.innerHTML = "";

    for (let index = 0; index < daily.time.length; index += 1) {
      const date = daily.time[index];
      const weatherCode = daily.weather_code[index];
      const maximum = daily.temperature_2m_max[index];
      const minimum = daily.temperature_2m_min[index];

      if (
        date === undefined ||
        weatherCode === undefined ||
        maximum === undefined ||
        minimum === undefined
      ) {
        continue;
      }

      const item = document.createElement("article");
      item.className = "forecast-item";

      const day = document.createElement("span");
      day.className = "forecast-day";
      day.textContent = index === 0 ? "Today" : formatDay(date);

      const icon = document.createElement("span");
      icon.className = "forecast-icon";
      icon.textContent = getWeatherIcon(weatherCode);

      const description = document.createElement("span");
      description.className = "forecast-description";
      description.textContent = getWeatherDescription(weatherCode);

      const temperatures = document.createElement("div");
      temperatures.className = "forecast-temperatures";

      const high = document.createElement("strong");
      high.textContent = `${Math.round(maximum)}°`;

      const low = document.createElement("span");
      low.textContent = `${Math.round(minimum)}°`;

      temperatures.append(high, low);
      item.append(day, icon, description, temperatures);
      forecastContainer.appendChild(item);
    }
  }


  /* ============================================================ */
  /* LOAD A CITY (drives hero + outlook + forecast together) */
  /* ============================================================ */

  async function loadCity(
    latitude: string,
    longitude: string,
    city: string,
    region: string
  ): Promise<void> {
    if (heroDescription) {
      heroDescription.textContent = "Loading weather...";
    }

    if (forecastContainer) {
      forecastContainer.innerHTML =
        '<div class="forecast-loading">Loading forecast...</div>';
    }

    try {
      const response = await fetch(buildWeatherUrl(latitude, longitude));

      if (!response.ok) {
        throw new Error(`Weather request failed: ${response.status}`);
      }

      const data = (await response.json()) as WeatherResponse;

      renderHero(city, region, data);
      renderForecast(data);
    } catch (error) {
      console.error("Weather error:", error);

      if (heroDescription) {
        heroDescription.textContent = "Unable to load weather";
      }

      if (heroTemp) {
        heroTemp.textContent = "--";
      }

      if (outlookText) {
        outlookText.textContent = "Unable to load today's outlook right now.";
      }

      if (forecastContainer) {
        forecastContainer.innerHTML =
          '<div class="forecast-loading">Unable to load forecast.</div>';
      }
    }
  }


  /* ============================================================ */
  /* LOCATION TABS */
  /* ============================================================ */

  function activateTab(button: HTMLButtonElement): void {
    locationTabs.forEach((tab) => tab.classList.remove("active"));
    button.classList.add("active");

    const latitude = button.dataset.lat;
    const longitude = button.dataset.lon;
    const city = button.dataset.city;
    const region = button.dataset.region;

    if (!latitude || !longitude || !city || !region) return;

    void loadCity(latitude, longitude, city, region);
  }

  locationTabs.forEach((button) => {
    button.addEventListener("click", () => activateTab(button));
  });

  const firstTab = locationTabs.item(0);
  if (firstTab) {
    activateTab(firstTab);
  }
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE CANVAS -->
<!-- ============================================================= -->

<script>
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    opacity: number;
  }

  const canvas =
    document.getElementById("weather-background") as HTMLCanvasElement | null;

  if (canvas) {
    const maybeContext = canvas.getContext("2d");

    if (maybeContext) {
      const canvasEl: HTMLCanvasElement = canvas;
      const context: CanvasRenderingContext2D = maybeContext;

      const particles: Particle[] = [];

      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;

      function getParticleCount(): number {
        return window.innerWidth < 768 ? 22 : 42;
      }

      let particleCount = getParticleCount();

      function resize(): void {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);

        width = window.innerWidth;
        height = window.innerHeight;

        canvasEl.width = width * ratio;
        canvasEl.height = height * ratio;

        canvasEl.style.width = `${width}px`;
        canvasEl.style.height = `${height}px`;

        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        particleCount = getParticleCount();
      }

      function createParticle(): Particle {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.08,
          vy: (Math.random() - 0.5) * 0.08,
          size: Math.random() * 1.3 + 0.4,
          opacity: Math.random() * 0.28 + 0.08
        };
      }

      function initializeParticles(): void {
        particles.length = 0;
        for (let index = 0; index < particleCount; index += 1) {
          particles.push(createParticle());
        }
      }

      function drawGrid(): void {
        const spacing = 84;

        const offsetX = (mouseX - width / 2) * 0.01;
        const offsetY = (mouseY - height / 2) * 0.01;

        context.save();
        context.strokeStyle = "rgba(0, 113, 240, 0.05)";
        context.lineWidth = 1;

        for (
          let x = -spacing + (offsetX % spacing);
          x < width + spacing;
          x += spacing
        ) {
          context.beginPath();
          context.moveTo(x, 0);
          context.lineTo(x, height);
          context.stroke();
        }

        for (
          let y = -spacing + (offsetY % spacing);
          y < height + spacing;
          y += spacing
        ) {
          context.beginPath();
          context.moveTo(0, y);
          context.lineTo(width, y);
          context.stroke();
        }

        context.restore();
      }

      function drawConnections(): void {
        const maxDistance = 130;

        for (let i = 0; i < particles.length; i += 1) {
          const first = particles[i];
          if (!first) continue;

          for (let j = i + 1; j < particles.length; j += 1) {
            const second = particles[j];
            if (!second) continue;

            const dx = first.x - second.x;
            const dy = first.y - second.y;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < maxDistance) {
              const opacity = (1 - distance / maxDistance) * 0.08;

              context.beginPath();
              context.moveTo(first.x, first.y);
              context.lineTo(second.x, second.y);
              context.strokeStyle = `rgba(0,113,240,${opacity})`;
              context.lineWidth = 1;
              context.stroke();
            }
          }
        }
      }

      function drawParticles(): void {
        for (const particle of particles) {
          particle.x += particle.vx;
          particle.y += particle.vy;

          if (particle.x < -10) particle.x = width + 10;
          if (particle.x > width + 10) particle.x = -10;
          if (particle.y < -10) particle.y = height + 10;
          if (particle.y > height + 10) particle.y = -10;

          const dx = targetMouseX - particle.x;
          const dy = targetMouseY - particle.y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < 180 && distance > 0) {
            const force = (1 - distance / 180) * 0.004;
            particle.vx += dx * force;
            particle.vy += dy * force;
          }

          particle.vx *= 0.996;
          particle.vy *= 0.996;

          context.beginPath();
          context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          context.fillStyle = `rgba(0,113,240,${particle.opacity})`;
          context.fill();
        }
      }

      function drawMouseGlow(): void {
        const gradient = context.createRadialGradient(
          targetMouseX,
          targetMouseY,
          0,
          targetMouseX,
          targetMouseY,
          260
        );

        gradient.addColorStop(0, "rgba(0,113,240,0.05)");
        gradient.addColorStop(0.45, "rgba(0,113,240,0.018)");
        gradient.addColorStop(1, "rgba(0,113,240,0)");

        context.fillStyle = gradient;
        context.fillRect(0, 0, width, height);
      }

      function animate(): void {
        mouseX += (targetMouseX - mouseX) * 0.045;
        mouseY += (targetMouseY - mouseY) * 0.045;

        context.clearRect(0, 0, width, height);

        drawMouseGlow();
        drawGrid();
        drawConnections();
        drawParticles();

        animationFrame = window.requestAnimationFrame(animate);
      }

      function handleResize(): void {
        resize();
        initializeParticles();
      }

      function handleMouseMove(event: MouseEvent): void {
        targetMouseX = event.clientX;
        targetMouseY = event.clientY;
      }

      function handleMouseLeave(): void {
        targetMouseX = width / 2;
        targetMouseY = height / 2;
      }

      resize();

      targetMouseX = width / 2;
      targetMouseY = height / 2;
      mouseX = width / 2;
      mouseY = height / 2;

      initializeParticles();

      window.addEventListener("resize", handleResize);
      window.addEventListener("mousemove", handleMouseMove, { passive: true });
      window.addEventListener("mouseleave", handleMouseLeave);

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!reducedMotion) {
        animationFrame = window.requestAnimationFrame(animate);
      } else {
        drawGrid();
        drawConnections();
        drawParticles();
      }

      window.addEventListener("pagehide", () => {
        window.cancelAnimationFrame(animationFrame);
        window.removeEventListener("resize", handleResize);
        window.removeEventListener("mousemove", handleMouseMove);
        window.removeEventListener("mouseleave", handleMouseLeave);
      });
    }
  }
</script>


<!-- ============================================================= -->
<!-- STYLES -->
<!-- ============================================================= -->

<style>
  /* ============================================================ */
  /* PAGE */
  /* ============================================================ */

  .weather-page {
    --electric-blue: #0071f0;
    --electric-blue-bright: #2f8dff;
    --electric-blue-soft: rgba(0, 113, 240, 0.07);
    --ink: #0d1420;
    --ink-soft: rgba(13, 20, 32, 0.64);
    --ink-muted: rgba(13, 20, 32, 0.42);
    --white: #ffffff;
    --border: rgba(13, 20, 32, 0.08);
    --border-blue: rgba(0, 113, 240, 0.28);
    --shadow-card: 0 20px 60px rgba(13, 20, 32, 0.06);

    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--ink);
