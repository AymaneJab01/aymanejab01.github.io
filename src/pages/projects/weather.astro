---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">
  <main class="weather-page">
    <!-- Interactive background -->
    <canvas
      id="weather-background"
      class="weather-background"
      aria-hidden="true"
    ></canvas>

    <div class="weather-atmosphere" aria-hidden="true"></div>

    <section class="weather-content">
      <div class="weather-wrapper">

        <!-- ====================================================== -->
        <!-- TOP BAR -->
        <!-- ====================================================== -->

        <header class="top-bar">
          <div class="brand">
            <span class="brand-dot"></span>
            <span>WEATHER</span>
          </div>

          <div class="location-dropdown">
            <button
              type="button"
              class="location-toggle"
              id="location-toggle"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="location-toggle-label">Alcoi</span>
              <svg class="chevron" width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <ul class="location-menu" id="location-menu" role="listbox">
              <li>
                <button
                  type="button"
                  class="location-option active"
                  data-lat="38.6983"
                  data-lon="-0.4743"
                  data-city="Alcoi"
                  data-region="Alicante, Spain"
                  role="option"
                  aria-selected="true"
                >
                  Alcoi
                </button>
              </li>

              <li>
                <button
                  type="button"
                  class="location-option"
                  data-lat="39.4699"
                  data-lon="-0.3763"
                  data-city="Valencia"
                  data-region="Valencia, Spain"
                  role="option"
                  aria-selected="false"
                >
                  Valencia
                </button>
              </li>

              <li>
                <button
                  type="button"
                  class="location-option"
                  data-lat="37.9787"
                  data-lon="-0.6822"
                  data-city="Torrevieja"
                  data-region="Alicante, Spain"
                  role="option"
                  aria-selected="false"
                >
                  Torrevieja
                </button>
              </li>
            </ul>
          </div>

          <nav class="top-nav" aria-label="Sections">
            <a href="#hero-section" class="top-nav-link active" data-nav-link>Today</a>
            <a href="#hourly-section" class="top-nav-link" data-nav-link>Hourly</a>
            <a href="#forecast-section" class="top-nav-link" data-nav-link>10 Day</a>
          </nav>
        </header>


        <p class="location-meta">
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
            <path d="M6 0.5C2.96 0.5 0.5 2.96 0.5 6C0.5 10.1 6 13.5 6 13.5C6 13.5 11.5 10.1 11.5 6C11.5 2.96 9.04 0.5 6 0.5Z" stroke="currentColor" stroke-width="1"/>
            <circle cx="6" cy="6" r="2" stroke="currentColor" stroke-width="1"/>
          </svg>
          <span id="meta-location">Alcoi, Alicante, Spain</span>
          <span class="meta-divider">Ã‚Â·</span>
          <span>As of <span id="meta-time">--</span></span>
        </p>


        <!-- ====================================================== -->
        <!-- HERO / CURRENT CONDITIONS -->
        <!-- ====================================================== -->

        <section class="hero" id="hero-section" aria-labelledby="hero-city">
          <h1 id="hero-city" class="sr-only">Current weather</h1>

          <div class="hero-top">
            <div class="hero-temp-block">
              <div class="hero-temp-row">
                <span id="hero-temp" class="hero-temp">--</span>
                <span class="hero-unit">Ã‚Â°</span>
              </div>
            </div>

            <div class="hero-condition">
              <div class="hero-icon" id="hero-icon" aria-hidden="true">Ã¢â‚¬â€</div>
              <p id="hero-description" class="hero-description">
                Loading weather...
              </p>
            </div>
          </div>

          <div class="hero-stats-row">
            <span>Feels Like <strong id="hero-feels">--</strong></span>
            <span class="stat-divider">|</span>
            <span>High <strong id="hero-high">--</strong></span>
            <span class="stat-divider">|</span>
            <span>Low <strong id="hero-low">--</strong></span>
          </div>

          <div class="hero-stats-row">
            <span>Chance of Rain <strong id="hero-rain">--</strong></span>
            <span class="stat-divider">|</span>
            <span><strong id="hero-precip">--</strong></span>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- TODAY'S OUTLOOK -->
        <!-- ====================================================== -->

        <section class="outlook-section" aria-labelledby="outlook-title">
          <h2 id="outlook-title">Today's Outlook</h2>
          <p id="outlook-text">
            Fetching the latest conditions to build today's outlook.
          </p>
        </section>


        <!-- ====================================================== -->
        <!-- HOURLY -->
        <!-- ====================================================== -->

        <section class="hourly-section" id="hourly-section" aria-labelledby="hourly-title">
          <h2 id="hourly-title" class="sr-only">Hourly forecast</h2>

          <div class="hourly-scroll-wrap">
            <button type="button" class="hourly-nav hourly-nav-prev" id="hourly-prev" aria-label="Scroll earlier">
              <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7L7 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>

            <div class="hourly-strip" id="hourly-strip">
              <div class="hourly-loading">Loading hourly forecast...</div>
            </div>

            <button type="button" class="hourly-nav hourly-nav-next" id="hourly-next" aria-label="Scroll later">
              <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DAILY FORECAST -->
        <!-- ====================================================== -->

        <section
          class="weather-section forecast-section"
          id="forecast-section"
          aria-labelledby="forecast-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>10 DAY FORECAST</span>

            <h2 id="forecast-title">
              Ten day outlook
            </h2>

            <p>
              A detailed ten-day forecast generated from the same live
              weather service, for the selected location above.
            </p>
          </div>


          <div
            id="forecast-container"
            class="forecast-container"
          >
            <div class="forecast-loading">
              Loading forecast...
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DOCUMENTATION -->
        <!-- ====================================================== -->

        <section
          class="weather-section documentation-section"
          aria-labelledby="documentation-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>DOCUMENTATION</span>

            <h2 id="documentation-title">
              Live data meets interactive UI.
            </h2>

            <p>
              This project combines a lightweight Astro page with
              client-side TypeScript to retrieve and display live
              meteorological information.
            </p>
          </div>


          <div class="documentation-grid">

            <article class="documentation-card">
              <span>01</span>

              <h3>
                Data source
              </h3>

              <p>
                Weather information is retrieved from Open-Meteo
                using geographic coordinates for Alcoi, Valencia
                and Torrevieja.
              </p>
            </article>


            <article class="documentation-card">
              <span>02</span>

              <h3>
                Client rendering
              </h3>

              <p>
                TypeScript fetches weather information in the
                browser and updates the interface dynamically.
              </p>
            </article>


            <article class="documentation-card">
              <span>03</span>

              <h3>
                Interactive background
              </h3>

              <p>
                Canvas particles, connections and a subtle grid
                create a sophisticated electric-blue atmosphere.
              </p>
            </article>


            <article class="documentation-card">
              <span>04</span>

              <h3>
                Responsive design
              </h3>

              <p>
                The dashboard adapts between mobile and desktop
                layouts while preserving the visual hierarchy.
              </p>
            </article>

          </div>


          <div class="technologies">
            <span>TECHNOLOGIES</span>

            <div class="technology-list">
              <span>Astro</span>
              <span>TypeScript</span>
              <span>Open-Meteo API</span>
              <span>Fetch API</span>
              <span>HTML</span>
              <span>CSS</span>
              <span>Canvas API</span>
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- API -->
        <!-- ====================================================== -->

        <section class="api-section">
          <div class="api-box">
            <div class="api-header">
              <span class="api-dot"></span>
              <span>API ENDPOINT</span>
            </div>

            <code>
              api.open-meteo.com/v1/forecast
            </code>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- BACK -->
        <!-- ====================================================== -->

        <div class="back-section">
          <a
            href="/#projects"
            class="back-link"
          >
            <span>Ã¢â€ Â</span>
            <span>Back to projects</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    precipitation_sum: number[];
    precipitation_hours: number[];
    wind_speed_10m_max: number[];
    wind_gusts_10m_max: number[];
    uv_index_max: number[];
    sunrise: string[];
    sunset: string[];
  }

  interface WeatherHourly {
    time: string[];
    temperature_2m: number[];
    weather_code: number[];
    precipitation_probability: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
    hourly: WeatherHourly;
    timezone_abbreviation?: string;
  }


  /* ============================================================ */
  /* WEATHER DESCRIPTION */
  /* ============================================================ */

  function getWeatherDescription(code: number): string {
    switch (code) {
      case 0:
        return "Clear sky";
      case 1:
        return "Mainly clear";
      case 2:
        return "Partly cloudy";
      case 3:
        return "Overcast";
      case 45:
        return "Fog";
      case 48:
        return "Rime fog";
      case 51:
        return "Light drizzle";
      case 53:
        return "Moderate drizzle";
      case 55:
        return "Dense drizzle";
      case 56:
        return "Light freezing drizzle";
      case 57:
        return "Dense freezing drizzle";
      case 61:
        return "Light rain";
      case 63:
        return "Moderate rain";
      case 65:
        return "Heavy rain";
      case 66:
        return "Light freezing rain";
      case 67:
        return "Heavy freezing rain";
      case 71:
        return "Light snow";
      case 73:
        return "Moderate snow";
      case 75:
        return "Heavy snow";
      case 77:
        return "Snow grains";
      case 80:
        return "Light rain showers";
      case 81:
        return "Moderate rain showers";
      case 82:
        return "Heavy rain showers";
      case 85:
        return "Light snow showers";
      case 86:
        return "Heavy snow showers";
      case 95:
        return "Thunderstorm";
      case 96:
        return "Thunderstorm with hail";
      case 99:
        return "Thunderstorm with heavy hail";
      default:
        return "Unknown conditions";
    }
  }


  /* ============================================================ */
  /* WEATHER ICON */
  /* ============================================================ */

  function getWeatherIcon(code: number): string {
    if (code === 0) return "Ã¢Ëœâ‚¬";
    if (code <= 3) return "Ã¢â€”Â";
    if (code <= 48) return "Ã¢â€°â€¹";
    if (code <= 67) return "Ã¢Ë†Â¿";
    if (code <= 77) return "Ã¢Ââ€ž";
    if (code <= 86) return "Ã¢â€”â€™";
    return "ÃÅ¸";
  }


  /* ============================================================ */
  /* API URL */
  /* ============================================================ */

  function buildWeatherUrl(latitude: string, longitude: string): string {
    const base = "https://api.open-meteo.com/v1/forecast";

    const params = new URLSearchParams({
      latitude,
      longitude,
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",
      hourly: "temperature_2m,weather_code,precipitation_probability",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,precipitation_hours,wind_speed_10m_max,wind_gusts_10m_max,uv_index_max,sunrise,sunset",
      timezone: "Europe/Madrid",
      forecast_days: "10"
    });

    return `${base}?${params.toString()}`;
  }


  /* ============================================================ */
  /* FORMAT HELPERS */
  /* ============================================================ */

  function formatTime(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "--";
    return date
      .toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
      .replace(" ", " ");
  }

  function formatHour(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "--";
    return date
      .toLocaleTimeString("en-US", { hour: "numeric" })
      .replace(" ", "")
      .toLowerCase();
  }

  function formatDay(value: string): string {
    const date = new Date(`${value}T12:00:00`);
    if (Number.isNaN(date.getTime())) return "--";
    return date.toLocaleDateString("en-GB", { weekday: "short" });
  }

  function formatShortDate(value: string): string {
    const date = new Date(`${value}T12:00:00`);
    if (Number.isNaN(date.getTime())) return "--";
    return date.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
  }

  function uvLabel(value: number | undefined): string {
    if (value === undefined) return "--";
    if (value < 3) return "Low";
    if (value < 6) return "Moderate";
    if (value < 8) return "High";
    return "Very high";
  }


  /* ============================================================ */
  /* DOM REFERENCES */
  /* ============================================================ */

  const metaLocation = document.getElementById("meta-location");
  const metaTime = document.getElementById("meta-time");

  const heroIcon = document.getElementById("hero-icon");
  const heroTemp = document.getElementById("hero-temp");
  const heroDescription = document.getElementById("hero-description");
  const heroFeels = document.getElementById("hero-feels");
  const heroHigh = document.getElementById("hero-high");
  const heroLow = document.getElementById("hero-low");
  const heroRain = document.getElementById("hero-rain");
  const heroPrecip = document.getElementById("hero-precip");

  const outlookText = document.getElementById("outlook-text");

  const hourlyStrip = document.getElementById("hourly-strip");
  const hourlyPrev = document.getElementById("hourly-prev") as HTMLButtonElement | null;
  const hourlyNext = document.getElementById("hourly-next") as HTMLButtonElement | null;

  const forecastContainer =
    document.getElementById("forecast-container") as HTMLElement | null;

  const locationToggle =
    document.getElementById("location-toggle") as HTMLButtonElement | null;
  const locationToggleLabel = document.getElementById("location-toggle-label");
  const locationMenu = document.getElementById("location-menu");
  const locationOptions =
    document.querySelectorAll<HTMLButtonElement>(".location-option");

  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");


  /* ============================================================ */
  /* RENDER: HERO + META + OUTLOOK */
  /* ============================================================ */

  function renderHero(city: string, region: string, data: WeatherResponse): void {
    const current = data.current;
    const today = 0;

    const high = data.daily.temperature_2m_max[today];
    const low = data.daily.temperature_2m_min[today];
    const rain = data.daily.precipitation_probability_max[today];
    const precip = data.daily.precipitation_sum[today];

    if (metaLocation) {
      metaLocation.textContent = `${city}, ${region}`;
    }

    if (metaTime) {
      const tz = data.timezone_abbreviation ? ` ${data.timezone_abbreviation}` : "";
      metaTime.textContent = `${formatTime(current.time)}${tz}`;
    }

    if (heroTemp) {
      heroTemp.textContent = Math.round(current.temperature_2m).toString();
    }

    if (heroDescription) {
      heroDescription.textContent = getWeatherDescription(current.weather_code);
    }

    if (heroIcon) {
      heroIcon.textContent = getWeatherIcon(current.weather_code);
    }

    if (heroFeels) {
      heroFeels.textContent = `${Math.round(current.apparent_temperature)}Ã‚Â°`;
    }

    if (heroHigh && high !== undefined) {
      heroHigh.textContent = `${Math.round(high)}Ã‚Â°`;
    }

    if (heroLow && low !== undefined) {
      heroLow.textContent = `${Math.round(low)}Ã‚Â°`;
    }

    if (heroRain) {
      heroRain.textContent = rain !== undefined ? `${Math.round(rain)}%` : "--";
    }

    if (heroPrecip) {
      heroPrecip.textContent = precip !== undefined ? `${precip.toFixed(1)} mm` : "--";
    }

    if (outlookText && high !== undefined && low !== undefined) {
      const description = getWeatherDescription(current.weather_code).toLowerCase();
      const rainText =
        rain !== undefined && rain >= 30
          ? ` There's a ${Math.round(rain)}% chance of rain, so it may be worth keeping an umbrella close by.`
          : "";

      outlookText.textContent =
        `Expect ${description} in ${city} today, with a high near ${Math.round(high)}Ã‚Â° and a low around ${Math.round(low)}Ã‚Â°.${rainText}`;
    }
  }


  /* ============================================================ */
  /* RENDER: HOURLY STRIP */
  /* ============================================================ */

  function renderHourly(data: WeatherResponse): void {
    if (!hourlyStrip) return;

    const hourly = data.hourly;
    const now = new Date(data.current.time).getTime();

    let startIndex = hourly.time.findIndex((t) => new Date(t).getTime() >= now);
    if (startIndex === -1) startIndex = 0;

    const slice = hourly.time.slice(startIndex, startIndex + 24);

    hourlyStrip.innerHTML = "";

    slice.forEach((time, offset) => {
      const index = startIndex + offset;
      const temp = hourly.temperature_2m[index];
      const code = hourly.weather_code[index];
      const rain = hourly.precipitation_probability[index];

      if (temp === undefined || code === undefined) return;

      const item = document.createElement("div");
      item.className = offset === 0 ? "hourly-item now" : "hourly-item";

      const label = document.createElement("span");
      label.className = "hourly-time";
      label.textContent = offset === 0 ? "Now" : formatHour(time);

      const icon = document.createElement("span");
      icon.className = "hourly-icon";
      icon.textContent = getWeatherIcon(code);

      const rainLabel = document.createElement("span");
      rainLabel.className = "hourly-rain";
      rainLabel.textContent = rain !== undefined && rain >= 20 ? `${Math.round(rain)}%` : "";

      const tempLabel = document.createElement("span");
      tempLabel.className = "hourly-temp";
      tempLabel.textContent = `${Math.round(temp)}Ã‚Â°`;

      item.append(label, icon, rainLabel, tempLabel);
      hourlyStrip.appendChild(item);
    });
  }


  /* ============================================================ */
  /* RENDER: DAILY FORECAST STRIP */
  /* ============================================================ */

  function renderForecast(data: WeatherResponse): void {
    if (!forecastContainer) return;

    const daily = data.daily;
    const rangeMin = Math.min(...daily.temperature_2m_min);
    const rangeMax = Math.max(...daily.temperature_2m_max);
    const range = Math.max(rangeMax - rangeMin, 1);
    forecastContainer.innerHTML = "";

    daily.time.forEach((date, index) => {
      const code = daily.weather_code[index];
      const high = daily.temperature_2m_max[index];
      const low = daily.temperature_2m_min[index];
      if (code === undefined || high === undefined || low === undefined) return;

      const rain = daily.precipitation_probability_max[index] ?? 0;
      const amount = daily.precipitation_sum[index] ?? 0;
      const start = ((low - rangeMin) / range) * 100;
      const width = Math.max(((high - low) / range) * 100, 8);
      const item = document.createElement("article");
      item.className = "forecast-item";
      item.innerHTML = `
        <button class="forecast-summary" type="button" aria-expanded="false">
          <span class="forecast-date"><strong>${index === 0 ? "Today" : formatDay(date)}</strong><small>${formatShortDate(date)}</small></span>
          <span class="forecast-condition"><i aria-hidden="true">${getWeatherIcon(code)}</i><span><strong>${getWeatherDescription(code)}</strong><small>${rain ? `${Math.round(rain)}% chance of rain` : "Dry conditions expected"}</small></span></span>
          <span class="forecast-rain"><strong>${Math.round(rain)}%</strong><small>${amount.toFixed(1)} mm</small></span>
          <span class="forecast-temperature"><strong>${Math.round(low)}Â°</strong><span class="temperature-track"><i style="left:${start}%; width:${width}%"></i></span><b>${Math.round(high)}Â°</b></span>
          <span class="forecast-chevron" aria-hidden="true">âŒ„</span>
        </button>
        <div class="forecast-details">
          <span><small>Precipitation</small><strong>${amount.toFixed(1)} mm Â· ${daily.precipitation_hours[index] ?? 0}h</strong></span>
          <span><small>Wind / gusts</small><strong>${Math.round(daily.wind_speed_10m_max[index] ?? 0)} / ${Math.round(daily.wind_gusts_10m_max[index] ?? 0)} km/h</strong></span>
          <span><small>UV index</small><strong>${Math.round(daily.uv_index_max[index] ?? 0)} Â· ${uvLabel(daily.uv_index_max[index])}</strong></span>
          <span><small>Daylight</small><strong>${daily.sunrise[index] ? formatTime(daily.sunrise[index]) : "--"} â€“ ${daily.sunset[index] ? formatTime(daily.sunset[index]) : "--"}</strong></span>
        </div>`;
      const summary = item.querySelector<HTMLButtonElement>(".forecast-summary");
      summary?.addEventListener("click", () => {
        const isOpen = item.classList.toggle("is-open");
        summary.setAttribute("aria-expanded", String(isOpen));
      });
      forecastContainer.appendChild(item);
    });
  }

  /* ============================================================ */
  /* LOAD A CITY */
  /* ============================================================ */

  async function loadCity(
    latitude: string,
    longitude: string,
    city: string,
    region: string
  ): Promise<void> {
    if (heroDescription) {
      heroDescription.textContent = "Loading weather...";
    }

    if (forecastContainer) {
      forecastContainer.innerHTML =
        '<div class="forecast-loading">Loading forecast...</div>';
    }

    if (hourlyStrip) {
      hourlyStrip.innerHTML = '<div class="hourly-loading">Loading hourly forecast...</div>';
    }

    try {
      const response = await fetch(buildWeatherUrl(latitude, longitude));

      if (!response.ok) {
        throw new Error(`Weather request failed: ${response.status}`);
      }

      const data = (await response.json()) as WeatherResponse;

      renderHero(city, region, data);
      renderHourly(data);
      renderForecast(data);
    } catch (error) {
      console.error("Weather error:", error);

      if (heroDescription) {
        heroDescription.textContent = "Unable to load weather";
      }

      if (heroTemp) {
        heroTemp.textContent = "--";
      }

      if (outlookText) {
        outlookText.textContent = "Unable to load today's outlook right now.";
      }

      if (forecastContainer) {
        forecastContainer.innerHTML =
          '<div class="forecast-loading">Unable to load forecast.</div>';
      }

      if (hourlyStrip) {
        hourlyStrip.innerHTML =
          '<div class="hourly-loading">Unable to load hourly forecast.</div>';
      }
    }
  }


  /* ============================================================ */
  /* LOCATION DROPDOWN */
  /* ============================================================ */

  function closeLocationMenu(): void {
    locationMenu?.classList.remove("open");
    locationToggle?.setAttribute("aria-expanded", "false");
  }

  function openLocationMenu(): void {
    locationMenu?.classList.add("open");
    locationToggle?.setAttribute("aria-expanded", "true");
  }

  locationToggle?.addEventListener("click", () => {
    const isOpen = locationMenu?.classList.contains("open");
    if (isOpen) {
      closeLocationMenu();
    } else {
      openLocationMenu();
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (
      locationMenu &&
      locationToggle &&
      !locationMenu.contains(target) &&
      !locationToggle.contains(target)
    ) {
      closeLocationMenu();
    }
  });

  function selectLocation(button: HTMLButtonElement): void {
    locationOptions.forEach((option) => {
      option.classList.remove("active");
      option.setAttribute("aria-selected", "false");
    });

    button.classList.add("active");
    button.setAttribute("aria-selected", "true");

    if (locationToggleLabel && button.dataset.city) {
      locationToggleLabel.textContent = button.dataset.city;
    }

    closeLocationMenu();

    const latitude = button.dataset.lat;
    const longitude = button.dataset.lon;
    const city = button.dataset.city;
    const region = button.dataset.region;

    if (!latitude || !longitude || !city || !region) return;

    void loadCity(latitude, longitude, city, region);
  }

  locationOptions.forEach((button) => {
    button.addEventListener("click", () => selectLocation(button));
  });

  const firstLocation = locationOptions.item(0);
  if (firstLocation) {
    selectLocation(firstLocation);
  }


  /* ============================================================ */
  /* TOP NAV (section links) */
  /* ============================================================ */

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      navLinks.forEach((other) => other.classList.remove("active"));
      link.classList.add("active");
    });
  });


  /* ============================================================ */
  /* HOURLY STRIP ARROWS */
  /* ============================================================ */

  hourlyPrev?.addEventListener("click", () => {
    hourlyStrip?.scrollBy({ left: -280, behavior: "smooth" });
  });

  hourlyNext?.addEventListener("click", () => {
    hourlyStrip?.scrollBy({ left: 280, behavior: "smooth" });
  });
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE CANVAS -->
<!-- ============================================================= -->

<script>
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    opacity: number;
  }

  const canvas =
    document.getElementById("weather-background") as HTMLCanvasElement | null;

  if (canvas) {
    const maybeContext = canvas.getContext("2d");

    if (maybeContext) {
      const canvasEl: HTMLCanvasElement = canvas;
      const context: CanvasRenderingContext2D = maybeContext;

      const particles: Particle[] = [];

      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;

      function getParticleCount(): number {
        return window.innerWidth < 768 ? 22 : 42;
      }

      let particleCount = getParticleCount();

      function resize(): void {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);

        width = window.innerWidth;
        height = window.innerHeight;

        canvasEl.width = width * ratio;
        canvasEl.height = height * ratio;

        canvasEl.style.width = `${width}px`;
        canvasEl.style.height = `${height}px`;

        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        particleCount = getParticleCount();
      }

      function createParticle(): Particle {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.08,
          vy: (Math.random() - 0.5) * 0.08,
          size: Math.random() * 1.3 + 0.4,
          opacity: Math.random() * 0.28 + 0.08
        };
      }

      function initializeParticles(): void {
        particles.length = 0;
        for (let index = 0; index < particleCount; index += 1) {
          particles.push(createParticle());
        }
      }

      function drawGrid(): void {
        const spacing = 84;

        const offsetX = (mouseX - width / 2) * 0.01;
        const offsetY = (mouseY - height / 2) * 0.01;

        context.save();
        context.strokeStyle = "rgba(0, 113, 240, 0.05)";
        context.lineWidth = 1;

        for (
          let x = -spacing + (offsetX % spacing);
          x < width + spacing;
          x += spacing
        ) {
          context.beginPath();
          context.moveTo(x, 0);
          context.lineTo(x, height);
          context.stroke();
        }

        for (
          let y = -spacing + (offsetY % spacing);
          y < height + spacing;
          y += spacing
        ) {
          context.beginPath();
          context.moveTo(0, y);
          context.lineTo(width, y);
          context.stroke();
        }

        context.restore();
      }

      function drawConnections(): void {
        const maxDistance = 130;

        for (let i = 0; i < particles.length; i += 1) {
          const first = particles[i];
          if (!first) continue;

          for (let j = i + 1; j < particles.length; j += 1) {
            const second = particles[j];
            if (!second) continue;

            const dx = first.x - second.x;
            const dy = first.y - second.y;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < maxDistance) {
              const opacity = (1 - distance / maxDistance) * 0.08;

              context.beginPath();
              context.moveTo(first.x, first.y);
              context.lineTo(second.x, second.y);
              context.strokeStyle = `rgba(0,113,240,${opacity})`;
              context.lineWidth = 1;
              context.stroke();
            }
          }
        }
      }

      function drawParticles(): void {
        for (const particle of particles) {
          particle.x += particle.vx;
          particle.y += particle.vy;

          if (particle.x < -10) particle.x = width + 10;
          if (particle.x > width + 10) particle.x = -10;
          if (particle.y < -10) particle.y = height + 10;
          if (particle.y > height + 10) particle.y = -10;

          const dx = targetMouseX - particle.x;
          const dy = targetMouseY - particle.y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < 180 && distance > 0) {
            const force = (1 - distance / 180) * 0.004;
            particle.vx += dx * force;
            particle.vy += dy * force;
          }

          particle.vx *= 0.996;
          particle.vy *= 0.996;

          context.beginPath();
          context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          context.fillStyle = `rgba(0,113,240,${particle.opacity})`;
          context.fill();
        }
      }

      function drawMouseGlow(): void {
        const gradient = context.createRadialGradient(
          targetMouseX,
          targetMouseY,
          0,
          targetMouseX,
          targetMouseY,
          260
        );

        gradient.addColorStop(0, "rgba(0,113,240,0.05)");
        gradient.addColorStop(0.45, "rgba(0,113,240,0.018)");
        gradient.addColorStop(1, "rgba(0,113,240,0)");

        context.fillStyle = gradient;
        context.fillRect(0, 0, width, height);
      }

      function animate(): void {
        mouseX += (targetMouseX - mouseX) * 0.045;
        mouseY += (targetMouseY - mouseY) * 0.045;

        context.clearRect(0, 0, width, height);

        drawMouseGlow();
        drawGrid();
        drawConnections();
        drawParticles();

        animationFrame = window.requestAnimationFrame(animate);
      }

      function handleResize(): void {
        resize();
        initializeParticles();
      }

      function handleMouseMove(event: MouseEvent): void {
        targetMouseX = event.clientX;
        targetMouseY = event.clientY;
      }

      function handleMouseLeave(): void {
        targetMouseX = width / 2;
        targetMouseY = height / 2;
      }

      resize();

      targetMouseX = width / 2;
      targetMouseY = height / 2;
      mouseX = width / 2;
      mouseY = height / 2;

      initializeParticles();

      window.addEventListener("resize", handleResize);
      window.addEventListener("mousemove", handleMouseMove, { passive: true });
      window.addEventListener("mouseleave", handleMouseLeave);

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!reducedMotion) {
        animationFrame = window.requestAnimationFrame(animate);
      } else {
        drawGrid();
        drawConnections();
        drawParticles();
      }

      window.addEventListener("pagehide", () => {
        window.cancelAnimationFrame(animationFrame);
        window.removeEventListener("resize", handleResize);
        window.removeEventListener("mousemove", handleMouseMove);
        window.removeEventListener("mouseleave", handleMouseLeave);
      });
    }
  }
</script>


