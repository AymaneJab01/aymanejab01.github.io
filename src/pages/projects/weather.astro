---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Weather Dashboard">
  <main class="weather-page">

```
<!-- Background -->
<div class="weather-background" aria-hidden="true"></div>

<canvas
  id="weather-background-canvas"
  class="weather-canvas"
  aria-hidden="true"
></canvas>

<div class="weather-container">

  <!-- ===================================================== -->
  <!-- HEADER -->
  <!-- ===================================================== -->

  <header class="weather-header">

    <div class="weather-eyebrow">
      <span class="status-dot"></span>
      <span>PROJECT 03 / WEATHER</span>
    </div>

    <div class="header-grid">

      <div class="header-copy">
        <h1>
          Weather
          <span>Dashboard.</span>
        </h1>

        <p>
          Real-time weather conditions and seven-day forecasts
          for Alcoi and Valencia, presented through a clean,
          data-focused interface.
        </p>
      </div>

      <div class="header-status">

        <div class="live-indicator">
          <span></span>
          LIVE DATA
        </div>

        <p>Open-Meteo API</p>

      </div>

    </div>

    <div class="technology-row">
      <span>Astro</span>
      <span>TypeScript</span>
      <span>REST API</span>
      <span>Open-Meteo</span>
      <span>Canvas</span>
    </div>

  </header>


  <!-- ===================================================== -->
  <!-- CURRENT CONDITIONS -->
  <!-- ===================================================== -->

  <section
    class="weather-section"
    aria-labelledby="current-weather-title"
  >

    <div class="section-heading">

      <div>
        <span class="section-kicker">
          CURRENT CONDITIONS
        </span>

        <h2 id="current-weather-title">
          Right now.
        </h2>
      </div>

      <p>Live meteorological data</p>

    </div>


    <div class="weather-grid">

      <!-- ALCOI -->

      <article
        class="weather-card"
        data-lat="38.6983"
        data-lon="-0.4743"
        data-city="Alcoi"
      >

        <div class="card-top-glow"></div>

        <div class="weather-card-content">

          <div class="city-header">

            <div>
              <span class="location-label">
                LOCATION
              </span>

              <h3>
                Alcoi<span>.</span>
              </h3>

              <p>Alicante, Spain</p>
            </div>

            <div
              class="weather-icon"
              aria-hidden="true"
            >
              ⛅
            </div>

          </div>


          <div class="temperature-area">

            <div class="temperature-line">

              <span class="weather-temperature">
                --
              </span>

              <span class="temperature-unit">
                °C
              </span>

            </div>

            <p class="weather-description">
              Loading weather...
            </p>

          </div>


          <div class="weather-data">

            <div class="data-item">
              <span>FEELS LIKE</span>
              <strong class="weather-feels">--</strong>
            </div>

            <div class="data-item">
              <span>WIND</span>
              <strong class="weather-wind">--</strong>
            </div>

            <div class="data-item">
              <span>HUMIDITY</span>
              <strong class="weather-humidity">--</strong>
            </div>

            <div class="data-item">
              <span>UPDATED</span>
              <strong class="weather-time">--</strong>
            </div>

          </div>

        </div>

      </article>


      <!-- VALENCIA -->

      <article
        class="weather-card"
        data-lat="39.4699"
        data-lon="-0.3763"
        data-city="Valencia"
      >

        <div class="card-top-glow"></div>

        <div class="weather-card-content">

          <div class="city-header">

            <div>
              <span class="location-label">
                LOCATION
              </span>

              <h3>
                Valencia<span>.</span>
              </h3>

              <p>Valencia, Spain</p>
            </div>

            <div
              class="weather-icon"
              aria-hidden="true"
            >
              ☀️
            </div>

          </div>


          <div class="temperature-area">

            <div class="temperature-line">

              <span class="weather-temperature">
                --
              </span>

              <span class="temperature-unit">
                °C
              </span>

            </div>

            <p class="weather-description">
              Loading weather...
            </p>

          </div>


          <div class="weather-data">

            <div class="data-item">
              <span>FEELS LIKE</span>
              <strong class="weather-feels">--</strong>
            </div>

            <div class="data-item">
              <span>WIND</span>
              <strong class="weather-wind">--</strong>
            </div>

            <div class="data-item">
              <span>HUMIDITY</span>
              <strong class="weather-humidity">--</strong>
            </div>

            <div class="data-item">
              <span>UPDATED</span>
              <strong class="weather-time">--</strong>
            </div>

          </div>

        </div>

      </article>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- FORECAST -->
  <!-- ===================================================== -->

  <section
    class="weather-section forecast-section"
    aria-labelledby="forecast-title"
  >

    <div class="section-heading">

      <div>
        <span class="section-kicker">
          FORECAST
        </span>

        <h2 id="forecast-title">
          Seven day outlook.
        </h2>
      </div>

      <p>Select a location</p>

    </div>


    <div class="forecast-selector">

      <button
        type="button"
        class="forecast-button active"
        data-forecast-location="38.6983,-0.4743"
      >
        Alcoi
      </button>

      <button
        type="button"
        class="forecast-button"
        data-forecast-location="39.4699,-0.3763"
      >
        Valencia
      </button>

    </div>


    <div
      id="forecast-container"
      class="forecast-container"
    >
      <div class="forecast-loading">
        Loading forecast...
      </div>
    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ABOUT -->
  <!-- ===================================================== -->

  <section class="details-section">

    <div class="details-introduction">

      <span class="section-kicker">
        ABOUT THE PROJECT
      </span>

      <h2>
        Live data,
        <span>designed clearly.</span>
      </h2>

      <p>
        This project combines a lightweight Astro interface
        with client-side TypeScript to retrieve live weather
        information directly from the Open-Meteo API.
      </p>

    </div>


    <div class="details-grid">

      <article class="detail-card">

        <div class="detail-number">
          01
        </div>

        <div>
          <h3>Live API</h3>

          <p>
            Current conditions and forecasts are retrieved
            dynamically from Open-Meteo using geographic
            coordinates.
          </p>
        </div>

      </article>


      <article class="detail-card">

        <div class="detail-number">
          02
        </div>

        <div>
          <h3>Client-side</h3>

          <p>
            Weather information is requested directly in
            the browser without requiring a dedicated
            backend service.
          </p>
        </div>

      </article>


      <article class="detail-card">

        <div class="detail-number">
          03
        </div>

        <div>
          <h3>Interactive</h3>

          <p>
            A lightweight canvas system creates a subtle
            animated blue atmosphere that reacts to mouse
            movement.
          </p>
        </div>

      </article>


      <article class="detail-card">

        <div class="detail-number">
          04
        </div>

        <div>
          <h3>Responsive</h3>

          <p>
            The dashboard adapts from a compact mobile
            layout to a spacious desktop presentation.
          </p>
        </div>

      </article>

    </div>


    <div class="technology-section">

      <span class="section-kicker">
        TECHNOLOGIES
      </span>

      <div class="technology-list">
        <span>Astro</span>
        <span>TypeScript</span>
        <span>Open-Meteo API</span>
        <span>Fetch API</span>
        <span>Canvas API</span>
      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- API -->
  <!-- ===================================================== -->

  <section class="api-section">

    <div class="api-card">

      <div class="api-heading">
        <span class="api-dot"></span>
        <span>DATA SOURCE</span>
      </div>

      <code>
        api.open-meteo.com/v1/forecast
      </code>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- BACK -->
  <!-- ===================================================== -->

  <div class="back-section">

    <a
      href="/#projects"
      class="back-link"
    >
      <span class="back-arrow">←</span>
      <span>Back to projects</span>
    </a>

  </div>

</div>
```

  </main>
</Layout>

<!-- =========================================================== -->

<!-- WEATHER LOGIC -->

<!-- =========================================================== -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  const descriptions: Record<number, string> = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Light rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Light snow",
    73: "Moderate snow",
    75: "Heavy snow",
    77: "Snow grains",
    80: "Light rain showers",
    81: "Moderate rain showers",
    82: "Heavy rain showers",
    85: "Light snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with hail",
    99: "Thunderstorm with heavy hail"
  };


  const getDescription = (
    code: number
  ): string => {
    return descriptions[code] ?? "Unknown conditions";
  };


  const getIcon = (
    code: number
  ): string => {
    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 86) {
      return "🌦️";
    }

    return "⛈️";
  };


  const buildWeatherUrl = (
    latitude: string,
    longitude: string
  ): string => {
    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${encodeURIComponent(latitude)}` +
      `&longitude=${encodeURIComponent(longitude)}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  };


  const formatTime = (
    value: string
  ): string => {
    return new Date(value).toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit"
      }
    );
  };


  const formatDay = (
    value: string
  ): string => {
    return new Date(
      `${value}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short"
      }
    );
  };


  /* ========================================================= */
  /* CURRENT WEATHER */
  /* ========================================================= */

  const loadWeather = async (
    card: HTMLElement
  ): Promise<void> => {
    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }

    try {
      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );

      if (!response.ok) {
        throw new Error(
          `Weather request failed: ${response.status}`
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      const current = data.current;

      const temperature =
        card.querySelector<HTMLElement>(
          ".weather-temperature"
        );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      const feels =
        card.querySelector<HTMLElement>(
          ".weather-feels"
        );

      const wind =
        card.querySelector<HTMLElement>(
          ".weather-wind"
        );

      const humidity =
        card.querySelector<HTMLElement>(
          ".weather-humidity"
        );

      const time =
        card.querySelector<HTMLElement>(
          ".weather-time"
        );

      const icon =
        card.querySelector<HTMLElement>(
          ".weather-icon"
        );


      if (temperature) {
        temperature.textContent =
          String(
            Math.round(
              current.temperature_2m
            )
          );
      }


      if (description) {
        description.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (feels) {
        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°C`;
      }


      if (wind) {
        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (humidity) {
        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (time) {
        time.textContent =
          formatTime(current.time);
      }


      if (icon) {
        icon.textContent =
          getIcon(
            current.weather_code
          );
      }

    } catch (error) {
      console.error(
        "Weather loading error:",
        error
      );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      if (description) {
        description.textContent =
          "Unable to load weather";
      }
    }
  };


  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );


  weatherCards.forEach(
    (card) => {
      void loadWeather(card);
    }
  );


  /* ========================================================= */
  /* FORECAST */
  /* ========================================================= */

  const forecastContainer =
    document.querySelector<HTMLElement>(
      "#forecast-container"
    );


  const forecastButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );


  const loadForecast = async (
    latitude: string,
    longitude: string
  ): Promise<void> => {
    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML =
      '<div class="forecast-loading">Loading forecast...</div>';


    try {
      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          `Forecast request failed: ${response.status}`
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const daily = data.daily;


      forecastContainer.innerHTML = "";


      daily.time.forEach(
        (date, index) => {

          const item =
            document.createElement(
              "article"
            );

          item.className =
            "forecast-item";


          const day =
            document.createElement(
              "span"
            );

          day.className =
            "forecast-day";

          day.textContent =
            index === 0
              ? "Today"
              : formatDay(date);


          const icon =
            document.createElement(
              "span"
            );

          icon.className =
            "forecast-icon";

          icon.textContent =
            getIcon(
              daily.weather_code[index] ?? 0
            );


          const temperatures =
            document.createElement(
              "div"
            );

          temperatures.className =
            "forecast-temperatures";


          const maximum =
            document.createElement(
              "strong"
            );

          maximum.textContent =
            `${Math.round(
              daily.temperature_2m_max[index] ?? 0
            )}°`;


          const minimum =
            document.createElement(
              "span"
            );

          minimum.className =
            "forecast-min";

          minimum.textContent =
            `${Math.round(
              daily.temperature_2m_min[index] ?? 0
            )}°`;


          temperatures.append(
            maximum,
            minimum
          );


          item.append(
            day,
            icon,
            temperatures
          );


          forecastContainer.appendChild(
            item
          );
        }
      );

    } catch (error) {
      console.error(
        "Forecast loading error:",
        error
      );

      forecastContainer.innerHTML =
        '<div class="forecast-loading">Unable to load forecast.</div>';
    }
  };


  const defaultLocation =
    forecastButtons[0]?.dataset.forecastLocation;


  if (defaultLocation) {

    const [
      latitude,
      longitude
    ] =
      defaultLocation.split(",");


    if (latitude && longitude) {
      void loadForecast(
        latitude,
        longitude
      );
    }
  }


  forecastButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          forecastButtons.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          button.classList.add(
            "active"
          );


          const location =
            button.dataset
              .forecastLocation;


          if (!location) {
            return;
          }


          const [
            latitude,
            longitude
          ] =
            location.split(",");


          if (!latitude || !longitude) {
            return;
          }


          void loadForecast(
            latitude,
            longitude
          );
        }
      );
    }
  );
</script>

<!-- =========================================================== -->

<!-- INTERACTIVE BACKGROUND -->

<!-- =========================================================== -->

<script>
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background-canvas"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        opacity: number;
      }


      const particles: Particle[] = [];


      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;


      const getParticleCount =
        (): number =>
          window.innerWidth < 768
            ? 22
            : 42;


      let particleCount =
        getParticleCount();


      const resize = (): void => {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;

        height =
          window.innerHeight;


        canvas.width =
          width * ratio;

        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;

        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particleCount =
          getParticleCount();
      };


      const createParticle =
        (): Particle => ({
          x:
            Math.random() * width,

          y:
            Math.random() * height,

          vx:
            (Math.random() - 0.5) * 0.08,

          vy:
            (Math.random() - 0.5) * 0.08,

          size:
            Math.random() * 1.2 + 0.3,

          opacity:
            Math.random() * 0.12 + 0.025
        });


      const initialize =
        (): void => {

          particles.length = 0;


          for (
            let index = 0;
            index < particleCount;
            index += 1
          ) {

            particles.push(
              createParticle()
            );
          }
        };


      const drawGrid =
        (): void => {

          const spacing = 90;


          const offsetX =
            (mouseX - width / 2) *
            0.008;


          const offsetY =
            (mouseY - height / 2) *
            0.008;


          context.save();


          context.strokeStyle =
            "rgba(0,140,255,0.035)";


          context.lineWidth = 1;


          for (
            let x =
              -spacing +
              (offsetX % spacing);

            x <
            width + spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();
          }


          for (
            let y =
              -spacing +
              (offsetY % spacing);

            y <
            height + spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();
          }


          context.restore();
        };


      const drawConnections =
        (): void => {

          const maxDistance = 130;


          for (
            let i = 0;
            i < particles.length;
            i += 1
          ) {

            const first =
              particles[i];


            if (!first) {
              continue;
            }


            for (
              let j = i + 1;
              j < particles.length;
              j += 1
            ) {

              const second =
                particles[j];


              if (!second) {
                continue;
              }


              const dx =
                first.x -
                second.x;


              const dy =
                first.y -
                second.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (1 -
                    distance /
                      maxDistance) *
                  0.045;


                context.beginPath();


                context.moveTo(
                  first.x,
                  first.y
                );


                context.lineTo(
                  second.x,
                  second.y
                );


                context.strokeStyle =
                  `rgba(0,140,255,${opacity})`;


                context.lineWidth = 1;


                context.stroke();
              }
            }
          }
        };


      const drawParticles =
        (): void => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;

            particle.y +=
              particle.vy;


            if (
              particle.x <
              -10
            ) {
              particle.x =
                width + 10;
            }


            if (
              particle.x >
              width + 10
            ) {
              particle.x = -10;
            }


            if (
              particle.y <
              -10
            ) {
              particle.y =
                height + 10;
            }


            if (
              particle.y >
              height + 10
            ) {
              particle.y = -10;
            }


            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              180
            ) {

              const force =
                (1 -
                  distance /
                    180) *
                0.0025;


              particle.vx +=
                dx * force;

              particle.vy +=
                dy * force;
            }


            particle.vx *=
              0.997;

            particle.vy *=
              0.997;


            context.beginPath();


            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(0,140,255,${particle.opacity})`;


            context.fill();
          }
        };


      const animate =
        (): void => {

          mouseX +=
            (targetMouseX -
              mouseX) *
            0.035;


          mouseY +=
            (targetMouseY -
              mouseY) *
            0.035;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawGrid();
          drawConnections();
          drawParticles();


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


      const handleResize =
        (): void => {

          resize();
          initialize();
        };


      const handleMouseMove =
        (
          event: MouseEvent
        ): void => {

          targetMouseX =
            event.clientX;

          targetMouseY =
            event.clientY;
        };


      const handleMouseLeave =
        (): void => {

          targetMouseX =
            width / 2;

          targetMouseY =
            height / 2;
        };


      resize();


      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;

      mouseX =
        width / 2;

      mouseY =
        height / 2;


      initialize();


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {

        animationFrame =
          requestAnimationFrame(
            animate
          );

      } else {

        drawGrid();
        drawConnections();
        drawParticles();
      }


      window.addEventListener(
        "resize",
        handleResize
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        {
          passive: true
        }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );


          window.removeEventListener(
            "resize",
            handleResize
          );


          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );


          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>

