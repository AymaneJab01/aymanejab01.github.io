---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">
  <main class="weather-page">
    <canvas
      id="weather-background"
      class="weather-background"
      aria-hidden="true"
    ></canvas>

    <div class="weather-atmosphere" aria-hidden="true"></div>

    <section class="weather-content">
      <div class="weather-wrapper">

        <!-- ====================================================== -->
        <!-- TOP BAR -->
        <!-- ====================================================== -->

        <header class="top-bar">
          <div class="brand">
            <span class="brand-dot"></span>
            <span>WEATHER</span>

            <span class="brand-location" id="brand-location">
              Alcoi
            </span>
          </div>

          <div class="location-dropdown">
            <button
              type="button"
              class="location-toggle"
              id="location-toggle"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="location-toggle-label">Alcoi</span>

              <svg
                class="chevron"
                width="12"
                height="8"
                viewBox="0 0 12 8"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1 1.5L6 6.5L11 1.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <ul
              class="location-menu"
              id="location-menu"
              role="listbox"
            >
              <li>
                <button
                  type="button"
                  class="location-option active"
                  data-lat="38.6983"
                  data-lon="-0.4743"
                  data-city="Alcoi"
                  data-region="Alicante, Spain"
                  role="option"
                  aria-selected="true"
                >
                  Alcoi
                </button>
              </li>

              <li>
                <button
                  type="button"
                  class="location-option"
                  data-lat="39.4699"
                  data-lon="-0.3763"
                  data-city="Valencia"
                  data-region="Valencia, Spain"
                  role="option"
                  aria-selected="false"
                >
                  Valencia
                </button>
              </li>

              <li>
                <button
                  type="button"
                  class="location-option"
                  data-lat="37.9787"
                  data-lon="-0.6822"
                  data-city="Torrevieja"
                  data-region="Alicante, Spain"
                  role="option"
                  aria-selected="false"
                >
                  Torrevieja
                </button>
              </li>
            </ul>
          </div>

          <nav class="top-nav" aria-label="Sections">
            <a
              href="#hero-section"
              class="top-nav-link active"
              data-nav-link
            >
              Today
            </a>

            <a
              href="#hourly-section"
              class="top-nav-link"
              data-nav-link
            >
              Hourly
            </a>

            <a
              href="#forecast-section"
              class="top-nav-link"
              data-nav-link
            >
              10 Day
            </a>
          </nav>
        </header>


        <!-- ====================================================== -->
        <!-- LOCATION META -->
        <!-- ====================================================== -->

        <p class="location-meta">
          <svg
            width="12"
            height="14"
            viewBox="0 0 12 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 0.5C2.96 0.5 0.5 2.96 0.5 6C0.5 10.1 6 13.5 6 13.5C6 13.5 11.5 10.1 11.5 6C11.5 2.96 9.04 0.5 6 0.5Z"
              stroke="currentColor"
              stroke-width="1"
            />

            <circle
              cx="6"
              cy="6"
              r="2"
              stroke="currentColor"
              stroke-width="1"
            />
          </svg>

          <span id="meta-location">
            Alcoi, Alicante, Spain
          </span>

          <span class="meta-divider">&middot;</span>

          <span>
            As of
            <span id="meta-time">--</span>
          </span>
        </p>


        <!-- ====================================================== -->
        <!-- HERO -->
        <!-- ====================================================== -->

        <section
          class="hero"
          id="hero-section"
          aria-labelledby="hero-city"
        >
          <h1 id="hero-city" class="sr-only">
            Current weather
          </h1>

          <div class="hero-top">
            <div class="hero-temp-block">
              <div class="hero-temp-row">
                <span id="hero-temp" class="hero-temp">
                  --
                </span>

                <span class="hero-unit">
                  &deg;
                </span>
              </div>
            </div>

            <div class="hero-condition">
              <div
                class="hero-icon"
                id="hero-icon"
                aria-hidden="true"
              >
                --
              </div>

              <p
                id="hero-description"
                class="hero-description"
              >
                Loading weather...
              </p>
            </div>
          </div>

          <div class="hero-stats-row">
            <span>
              Feels Like
              <strong id="hero-feels">--</strong>
            </span>

            <span class="stat-divider">|</span>

            <span>
              High
              <strong id="hero-high">--</strong>
            </span>

            <span class="stat-divider">|</span>

            <span>
              Low
              <strong id="hero-low">--</strong>
            </span>
          </div>

          <div class="hero-stats-row">
            <span>
              Chance of Rain
              <strong id="hero-rain">--</strong>
            </span>

            <span class="stat-divider">|</span>

            <span>
              Precipitation
              <strong id="hero-precip">--</strong>
            </span>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- OUTLOOK -->
        <!-- ====================================================== -->

        <section
          class="outlook-section"
          aria-labelledby="outlook-title"
        >
          <div class="outlook-icon" aria-hidden="true">
            ✦
          </div>

          <div>
            <h2 id="outlook-title">
              Today's Outlook
            </h2>

            <p id="outlook-text">
              Fetching the latest conditions to build today's
              outlook.
            </p>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- HOURLY WEATHER -->
        <!-- ====================================================== -->

        <section
          class="hourly-section"
          id="hourly-section"
          aria-labelledby="hourly-title"
        >
          <div class="section-divider"></div>

          <div class="hourly-header">
            <div>
              <span class="section-kicker">
                HOURLY WEATHER
              </span>

              <h2 id="hourly-title">
                Hourly forecast
              </h2>

              <p>
                Hour-by-hour conditions for the selected location.
              </p>
            </div>

            <div class="hourly-controls">
              <button
                type="button"
                class="hourly-nav"
                id="hourly-prev"
                aria-label="Scroll earlier"
              >
                <svg
                  width="8"
                  height="14"
                  viewBox="0 0 8 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M7 1L1 7L7 13"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <button
                type="button"
                class="hourly-nav"
                id="hourly-next"
                aria-label="Scroll later"
              >
                <svg
                  width="8"
                  height="14"
                  viewBox="0 0 8 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M1 1L7 7L1 13"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>

          <div class="hourly-card">
            <div class="hourly-table-wrap">
              <div class="hourly-table">

                <div class="hourly-row hourly-head">
                  <div>Time</div>
                  <div>Sky condition</div>
                  <div>Temperature</div>
                  <div>Precip</div>
                  <div>Humidity</div>
                  <div>Wind</div>
                </div>

                <div
                  id="hourly-table-body"
                  class="hourly-table-body"
                >
                  <div class="hourly-loading">
                    Loading hourly forecast...
                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DAILY FORECAST -->
        <!-- ====================================================== -->

        <section
          class="weather-section forecast-section"
          id="forecast-section"
          aria-labelledby="forecast-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>10 DAY FORECAST</span>

            <h2 id="forecast-title">
              Ten day outlook
            </h2>

            <p>
              A detailed ten-day forecast generated from the same
              live weather service, for the selected location above.
            </p>
          </div>

          <div
            id="forecast-container"
            class="forecast-container"
          >
            <div class="forecast-loading">
              Loading forecast...
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DOCUMENTATION -->
        <!-- ====================================================== -->

        <section
          class="weather-section documentation-section"
          aria-labelledby="documentation-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>DOCUMENTATION</span>

            <h2 id="documentation-title">
              Live data meets interactive UI.
            </h2>

            <p>
              This project combines a lightweight Astro page with
              client-side TypeScript to retrieve and display live
              meteorological information.
            </p>
          </div>

          <div class="documentation-grid">

            <article class="documentation-card">
              <span>01</span>

              <h3>Data source</h3>

              <p>
                Weather information is retrieved from Open-Meteo
                using geographic coordinates for Alcoi, Valencia
                and Torrevieja.
              </p>
            </article>

            <article class="documentation-card">
              <span>02</span>

              <h3>Client rendering</h3>

              <p>
                TypeScript fetches weather information in the
                browser and updates the interface dynamically.
              </p>
            </article>

            <article class="documentation-card">
              <span>03</span>

              <h3>Interactive background</h3>

              <p>
                Canvas particles, connections and a subtle grid
                create a sophisticated electric-blue atmosphere.
              </p>
            </article>

            <article class="documentation-card">
              <span>04</span>

              <h3>Responsive design</h3>

              <p>
                The dashboard adapts between mobile and desktop
                layouts while preserving the visual hierarchy.
              </p>
            </article>

          </div>

          <div class="technologies">
            <span>TECHNOLOGIES</span>

            <div class="technology-list">
              <span>Astro</span>
              <span>TypeScript</span>
              <span>Open-Meteo API</span>
              <span>Fetch API</span>
              <span>HTML</span>
              <span>CSS</span>
              <span>Canvas API</span>
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- API -->
        <!-- ====================================================== -->

        <section class="api-section">
          <div class="api-box">
            <div class="api-header">
              <span class="api-dot"></span>
              <span>API ENDPOINT</span>
            </div>

            <code>
              api.open-meteo.com/v1/forecast
            </code>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- BACK -->
        <!-- ====================================================== -->

        <div class="back-section">
          <a
            href="/#projects"
            class="back-link"
          >
            <span aria-hidden="true">&larr;</span>
            <span>Back to projects</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    precipitation_sum: number[];
    precipitation_hours: number[];
    wind_speed_10m_max: number[];
    wind_gusts_10m_max: number[];
    uv_index_max: number[];
    sunrise: string[];
    sunset: string[];
  }

  interface WeatherHourly {
    time: string[];
    temperature_2m: number[];
    weather_code: number[];
    precipitation_probability: number[];
    relative_humidity_2m: number[];
    wind_speed_10m: number[];
    wind_direction_10m: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
    hourly: WeatherHourly;
    timezone_abbreviation?: string;
  }


  /* ============================================================ */
  /* WEATHER DESCRIPTION */
  /* ============================================================ */

  function getWeatherDescription(code: number): string {
    switch (code) {
      case 0:
        return "Clear sky";

      case 1:
        return "Mainly clear";

      case 2:
        return "Partly cloudy";

      case 3:
        return "Overcast";

      case 45:
        return "Fog";

      case 48:
        return "Rime fog";

      case 51:
        return "Light drizzle";

      case 53:
        return "Moderate drizzle";

      case 55:
        return "Dense drizzle";

      case 56:
        return "Light freezing drizzle";

      case 57:
        return "Dense freezing drizzle";

      case 61:
        return "Light rain";

      case 63:
        return "Moderate rain";

      case 65:
        return "Heavy rain";

      case 66:
        return "Light freezing rain";

      case 67:
        return "Heavy freezing rain";

      case 71:
        return "Light snow";

      case 73:
        return "Moderate snow";

      case 75:
        return "Heavy snow";

      case 77:
        return "Snow grains";

      case 80:
        return "Light rain showers";

      case 81:
        return "Moderate rain showers";

      case 82:
        return "Heavy rain showers";

      case 85:
        return "Light snow showers";

      case 86:
        return "Heavy snow showers";

      case 95:
        return "Thunderstorm";

      case 96:
        return "Thunderstorm with hail";

      case 99:
        return "Thunderstorm with heavy hail";

      default:
        return "Unknown conditions";
    }
  }


  /* ============================================================ */
  /* WEATHER ICON */
  /* ============================================================ */

  function getWeatherIcon(code: number): string {
    const common =
      'class="weather-icon-svg" viewBox="0 0 48 48" fill="none" aria-hidden="true"';

    if (code === 0) {
      return `
        <svg ${common}>
          <circle
            cx="24"
            cy="24"
            r="8"
            stroke="currentColor"
            stroke-width="3"
          />
          <path
            d="M24 4v6m0 28v6M4 24h6m28 0h6M10 10l4 4m20 20 4 4m0-28-4 4M14 34l-4 4"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      `;
    }

    if (code === 1 || code === 2) {
      return `
        <svg ${common}>
          <circle
            cx="17"
            cy="16"
            r="6"
            stroke="currentColor"
            stroke-width="3"
          />
          <path
            d="M14 35h22a7 7 0 0 0 0-14 10 10 0 0 0-19-2A8 8 0 0 0 14 35Z"
            stroke="currentColor"
            stroke-width="3"
            stroke-linejoin="round"
          />
        </svg>
      `;
    }

    if (code === 3) {
      return `
        <svg ${common}>
          <path
            d="M10 17h28M7 24h34M11 31h26"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      `;
    }

    if (code === 45 || code === 48) {
      return `
        <svg ${common}>
          <path
            d="M8 17h32M5 24h28M10 31h30"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      `;
    }

    if (
      (code >= 51 && code <= 67) ||
      (code >= 80 && code <= 82)
    ) {
      return `
        <svg ${common}>
          <path
            d="M12 27h24a7 7 0 0 0 0-14 10 10 0 0 0-19-2A8 8 0 0 0 12 27Z"
            stroke="currentColor"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
            d="m16 34-2 6m11-6-2 6m10-6-2 6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      `;
    }

    if (
      (code >= 71 && code <= 77) ||
      (code >= 85 && code <= 86)
    ) {
      return `
        <svg ${common}>
          <path
            d="M12 27h24a7 7 0 0 0 0-14 10 10 0 0 0-19-2A8 8 0 0 0 12 27Z"
            stroke="currentColor"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
            d="M17 34v5m8-5v5m8-5v5"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      `;
    }

    if (code >= 95) {
      return `
        <svg ${common}>
          <path
            d="M12 27h24a7 7 0 0 0 0-14 10 10 0 0 0-19-2A8 8 0 0 0 12 27Z"
            stroke="currentColor"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
            d="m26 28-5 9h6l-4 8"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      `;
    }

    return `
      <svg ${common}>
        <circle
          cx="24"
          cy="24"
          r="8"
          stroke="currentColor"
          stroke-width="3"
        />
      </svg>
    `;
  }


  /* ============================================================ */
  /* WIND DIRECTION */
  /* ============================================================ */

  function degreesToDirection(degrees: number): string {
    const directions = [
      "N",
      "NE",
      "E",
      "SE",
      "S",
      "SW",
      "W",
      "NW"
    ];

    const index =
      Math.round(degrees / 45) % directions.length;

    return directions[index] ?? "N";
  }


  /* ============================================================ */
  /* API URL */
  /* ============================================================ */

  function buildWeatherUrl(
    latitude: string,
    longitude: string
  ): string {
    const base =
      "https://api.open-meteo.com/v1/forecast";

    const params = new URLSearchParams({
      latitude,
      longitude,

      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",

      hourly:
        "temperature_2m,weather_code,precipitation_probability,relative_humidity_2m,wind_speed_10m,wind_direction_10m",

      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,precipitation_hours,wind_speed_10m_max,wind_gusts_10m_max,uv_index_max,sunrise,sunset",

      timezone: "Europe/Madrid",

      forecast_days: "10"
    });

    return `${base}?${params.toString()}`;
  }


  /* ============================================================ */
  /* FORMAT HELPERS */
  /* ============================================================ */

  function formatTime(value: string): string {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleTimeString("en-US", {
      hour: "numeric",
      minute: "2-digit"
    });
  }


  function formatHour(value: string): string {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date
      .toLocaleTimeString("en-US", {
        hour: "numeric"
      })
      .replace(" ", "")
      .toLowerCase();
  }


  function formatDay(value: string): string {
    const date = new Date(`${value}T12:00:00`);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleDateString("en-GB", {
      weekday: "short"
    });
  }


  function formatShortDate(value: string): string {
    const date = new Date(`${value}T12:00:00`);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short"
    });
  }


  function uvLabel(value: number | undefined): string {
    if (value === undefined) return "--";

    if (value < 3) return "Low";
    if (value < 6) return "Moderate";
    if (value < 8) return "High";

    return "Very high";
  }


  /* ============================================================ */
  /* DOM */
  /* ============================================================ */

  const metaLocation =
    document.getElementById("meta-location");

  const brandLocation =
    document.getElementById("brand-location");

  const metaTime =
    document.getElementById("meta-time");

  const heroIcon =
    document.getElementById("hero-icon");

  const heroTemp =
    document.getElementById("hero-temp");

  const heroDescription =
    document.getElementById("hero-description");

  const heroFeels =
    document.getElementById("hero-feels");

  const heroHigh =
    document.getElementById("hero-high");

  const heroLow =
    document.getElementById("hero-low");

  const heroRain =
    document.getElementById("hero-rain");

  const heroPrecip =
    document.getElementById("hero-precip");

  const outlookText =
    document.getElementById("outlook-text");

  const hourlyTableBody =
    document.getElementById("hourly-table-body");

  const hourlyPrev =
    document.getElementById("hourly-prev") as HTMLButtonElement | null;

  const hourlyNext =
    document.getElementById("hourly-next") as HTMLButtonElement | null;

  const forecastContainer =
    document.getElementById(
      "forecast-container"
    ) as HTMLElement | null;

  const locationToggle =
    document.getElementById(
      "location-toggle"
    ) as HTMLButtonElement | null;

  const locationToggleLabel =
    document.getElementById(
      "location-toggle-label"
    );

  const locationMenu =
    document.getElementById("location-menu");

  const locationOptions =
    document.querySelectorAll<HTMLButtonElement>(
      ".location-option"
    );

  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>(
      "[data-nav-link]"
    );


  /* ============================================================ */
  /* HERO */
  /* ============================================================ */

  function renderHero(
    city: string,
    region: string,
    data: WeatherResponse
  ): void {
    const current = data.current;

    const high =
      data.daily.temperature_2m_max[0];

    const low =
      data.daily.temperature_2m_min[0];

    const rain =
      data.daily.precipitation_probability_max[0];

    const precip =
      data.daily.precipitation_sum[0];

    if (metaLocation) {
      metaLocation.textContent =
        `${city}, ${region}`;
    }

    if (brandLocation) {
      brandLocation.textContent = city;
    }

    if (metaTime) {
      const timezone =
        data.timezone_abbreviation
          ? ` ${data.timezone_abbreviation}`
          : "";

      metaTime.textContent =
        `${formatTime(current.time)}${timezone}`;
    }

    if (heroTemp) {
      heroTemp.textContent =
        Math.round(
          current.temperature_2m
        ).toString();
    }

    if (heroDescription) {
      heroDescription.textContent =
        getWeatherDescription(
          current.weather_code
        );
    }

    if (heroIcon) {
      heroIcon.innerHTML =
        getWeatherIcon(
          current.weather_code
        );
    }

    if (heroFeels) {
      heroFeels.textContent =
        `${Math.round(current.apparent_temperature)}°`;
    }

    if (heroHigh && high !== undefined) {
      heroHigh.textContent =
        `${Math.round(high)}°`;
    }

    if (heroLow && low !== undefined) {
      heroLow.textContent =
        `${Math.round(low)}°`;
    }

    if (heroRain) {
      heroRain.textContent =
        rain !== undefined
          ? `${Math.round(rain)}%`
          : "--";
    }

    if (heroPrecip) {
      heroPrecip.textContent =
        precip !== undefined
          ? `${precip.toFixed(1)} mm`
          : "--";
    }

    if (
      outlookText &&
      high !== undefined &&
      low !== undefined
    ) {
      const description =
        getWeatherDescription(
          current.weather_code
        ).toLowerCase();

      const rainText =
        rain !== undefined && rain >= 30
          ? ` There is a ${Math.round(
              rain
            )}% chance of rain today.`
          : " Rain chances remain low today.";

      outlookText.textContent =
        `Expect ${description} in ${city} today, with a high near ${Math.round(
          high
        )}° and a low around ${Math.round(
          low
        )}°.${rainText}`;
    }
  }


  /* ============================================================ */
  /* HOURLY TABLE */
  /* ============================================================ */

  function renderHourly(
    data: WeatherResponse
  ): void {
    if (!hourlyTableBody) return;

    const hourly = data.hourly;

    const now =
      new Date(data.current.time).getTime();

    let startIndex =
      hourly.time.findIndex(
        (time) =>
          new Date(time).getTime() >= now
      );

    if (startIndex === -1) {
      startIndex = 0;
    }

    const endIndex =
      Math.min(
        startIndex + 24,
        hourly.time.length
      );

    hourlyTableBody.innerHTML = "";

    for (
      let index = startIndex;
      index < endIndex;
      index += 1
    ) {
      const time =
        hourly.time[index];

      const temperature =
        hourly.temperature_2m[index];

      const code =
        hourly.weather_code[index];

      const precipitation =
        hourly.precipitation_probability[index];

      const humidity =
        hourly.relative_humidity_2m[index];

      const wind =
        hourly.wind_speed_10m[index];

      const windDirection =
        hourly.wind_direction_10m[index];

      if (
        time === undefined ||
        temperature === undefined ||
        code === undefined
      ) {
        continue;
      }

      const row =
        document.createElement("div");

      row.className =
        index === startIndex
          ? "hourly-row hourly-now"
          : "hourly-row";

      const timeCell =
        document.createElement("div");

      timeCell.className =
        "hourly-time-cell";

      const timeLabel =
        document.createElement("strong");

      timeLabel.textContent =
        index === startIndex
          ? "Now"
          : formatHour(time);

      const fullTime =
        document.createElement("small");

      fullTime.textContent =
        index === startIndex
          ? formatHour(time)
          : "";

      timeCell.append(
        timeLabel,
        fullTime
      );


      const conditionCell =
        document.createElement("div");

      conditionCell.className =
        "hourly-condition-cell";

      const icon =
        document.createElement("span");

      icon.className =
        "hourly-condition-icon";

      icon.innerHTML =
        getWeatherIcon(code);

      const conditionText =
        document.createElement("span");

      conditionText.textContent =
        getWeatherDescription(code);

      conditionCell.append(
        icon,
        conditionText
      );


      const temperatureCell =
        document.createElement("div");

      temperatureCell.className =
        "hourly-temperature-cell";

      temperatureCell.textContent =
        `${Math.round(temperature)}°`;


      const precipitationCell =
        document.createElement("div");

      precipitationCell.className =
        "hourly-precip-cell";

      precipitationCell.textContent =
        precipitation !== undefined
          ? `${Math.round(precipitation)}%`
          : "--";


      const humidityCell =
        document.createElement("div");

      humidityCell.className =
        "hourly-humidity-cell";

      humidityCell.textContent =
        humidity !== undefined
          ? `${Math.round(humidity)}%`
          : "--";


      const windCell =
        document.createElement("div");

      windCell.className =
        "hourly-wind-cell";

      if (
        wind !== undefined &&
        windDirection !== undefined
      ) {
        const arrow =
          document.createElement("span");

        arrow.className =
          "wind-arrow";

        arrow.style.transform =
          `rotate(${windDirection}deg)`;

        arrow.textContent = "→";

        const windText =
          document.createElement("span");

        windText.innerHTML =
          `<strong>${Math.round(
            wind
          )} km/h</strong><small>${degreesToDirection(
            windDirection
          )}</small>`;

        windCell.append(
          arrow,
          windText
        );
      } else {
        windCell.textContent = "--";
      }


      row.append(
        timeCell,
        conditionCell,
        temperatureCell,
        precipitationCell,
        humidityCell,
        windCell
      );

      hourlyTableBody.appendChild(row);
    }
  }


  /* ============================================================ */
  /* DAILY FORECAST */
  /* ============================================================ */

  function renderForecast(
    data: WeatherResponse
  ): void {
    if (!forecastContainer) return;

    const daily = data.daily;

    const rangeMin =
      Math.min(
        ...daily.temperature_2m_min
      );

    const rangeMax =
      Math.max(
        ...daily.temperature_2m_max
      );

    const range =
      Math.max(
        rangeMax - rangeMin,
        1
      );

    forecastContainer.innerHTML = "";

    daily.time.forEach(
      (date, index) => {
        const code =
          daily.weather_code[index];

        const high =
          daily.temperature_2m_max[index];

        const low =
          daily.temperature_2m_min[index];

        if (
          code === undefined ||
          high === undefined ||
          low === undefined
        ) {
          return;
        }

        const rain =
          daily.precipitation_probability_max[index] ??
          0;

        const amount =
          daily.precipitation_sum[index] ??
          0;

        const start =
          ((low - rangeMin) / range) *
          100;

        const width =
          Math.max(
            ((high - low) / range) * 100,
            8
          );

        const item =
          document.createElement("article");

        item.className =
          "forecast-item";

        item.innerHTML = `
          <button
            class="forecast-summary"
            type="button"
            aria-expanded="false"
          >
            <span class="forecast-date">
              <strong>
                ${
                  index === 0
                    ? "Today"
                    : formatDay(date)
                }
              </strong>

              <small>
                ${formatShortDate(date)}
              </small>
            </span>

            <span class="forecast-condition">
              <i aria-hidden="true">
                ${getWeatherIcon(code)}
              </i>

              <span>
                <strong>
                  ${getWeatherDescription(code)}
                </strong>

                <small>
                  ${
                    rain
                      ? `${Math.round(
                          rain
                        )}% chance of rain`
                      : "Dry conditions expected"
                  }
                </small>
              </span>
            </span>

            <span class="forecast-rain">
              <strong>
                ${Math.round(rain)}%
              </strong>

              <small>
                ${amount.toFixed(1)} mm
              </small>
            </span>

            <span class="forecast-temperature">
              <strong>
                ${Math.round(low)}°
              </strong>

              <span class="temperature-track">
                <i
                  style="
                    left:${start}%;
                    width:${width}%;
                  "
                ></i>
              </span>

              <b>
                ${Math.round(high)}°
              </b>
            </span>

            <span
              class="forecast-chevron"
              aria-hidden="true"
            >
              ↓
            </span>
          </button>

          <div class="forecast-details">
            <span>
              <small>Precipitation</small>

              <strong>
                ${amount.toFixed(1)} mm
                &middot;
                ${
                  daily.precipitation_hours[index] ??
                  0
                }h
              </strong>
            </span>

            <span>
              <small>Wind / gusts</small>

              <strong>
                ${
                  Math.round(
                    daily.wind_speed_10m_max[index] ??
                    0
                  )
                }
                /
                ${
                  Math.round(
                    daily.wind_gusts_10m_max[index] ??
                    0
                  )
                }
                km/h
              </strong>
            </span>

            <span>
              <small>UV index</small>

              <strong>
                ${
                  Math.round(
                    daily.uv_index_max[index] ??
                    0
                  )
                }
                &middot;
                ${uvLabel(
                  daily.uv_index_max[index]
                )}
              </strong>
            </span>

            <span>
              <small>Daylight</small>

              <strong>
                ${
                  daily.sunrise[index]
                    ? formatTime(
                        daily.sunrise[index]
                      )
                    : "--"
                }

                &ndash;

                ${
                  daily.sunset[index]
                    ? formatTime(
                        daily.sunset[index]
                      )
                    : "--"
                }
              </strong>
            </span>
          </div>
        `;

        const summary =
          item.querySelector<HTMLButtonElement>(
            ".forecast-summary"
          );

        summary?.addEventListener(
          "click",
          () => {
            const isOpen =
              item.classList.toggle(
                "is-open"
              );

            summary.setAttribute(
              "aria-expanded",
              String(isOpen)
            );
          }
        );

        forecastContainer.appendChild(item);
      }
    );
  }


  /* ============================================================ */
  /* LOAD CITY */
  /* ============================================================ */

  async function loadCity(
    latitude: string,
    longitude: string,
    city: string,
    region: string
  ): Promise<void> {
    if (heroDescription) {
      heroDescription.textContent =
        "Loading weather...";
    }

    if (forecastContainer) {
      forecastContainer.innerHTML =
        '<div class="forecast-loading">Loading forecast...</div>';
    }

    if (hourlyTableBody) {
      hourlyTableBody.innerHTML =
        '<div class="hourly-loading">Loading hourly forecast...</div>';
    }

    try {
      const response =
        await fetch(
          buildWeatherUrl(
            latitude,
            longitude
          )
        );

      if (!response.ok) {
        throw new Error(
          `Weather request failed: ${response.status}`
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      renderHero(
        city,
        region,
        data
      );

      renderHourly(data);

      renderForecast(data);
    } catch (error) {
      console.error(
        "Weather error:",
        error
      );

      if (heroDescription) {
        heroDescription.textContent =
          "Unable to load weather";
      }

      if (heroTemp) {
        heroTemp.textContent =
          "--";
      }

      if (outlookText) {
        outlookText.textContent =
          "Unable to load today's outlook right now.";
      }

      if (forecastContainer) {
        forecastContainer.innerHTML =
          '<div class="forecast-loading">Unable to load forecast.</div>';
      }

      if (hourlyTableBody) {
        hourlyTableBody.innerHTML =
          '<div class="hourly-loading">Unable to load hourly forecast.</div>';
      }
    }
  }


  /* ============================================================ */
  /* LOCATION MENU */
  /* ============================================================ */

  function closeLocationMenu(): void {
    locationMenu?.classList.remove(
      "open"
    );

    locationToggle?.setAttribute(
      "aria-expanded",
      "false"
    );
  }


  function openLocationMenu(): void {
    locationMenu?.classList.add(
      "open"
    );

    locationToggle?.setAttribute(
      "aria-expanded",
      "true"
    );
  }


  locationToggle?.addEventListener(
    "click",
    () => {
      const isOpen =
        locationMenu?.classList.contains(
          "open"
        );

      if (isOpen) {
        closeLocationMenu();
      } else {
        openLocationMenu();
      }
    }
  );


  document.addEventListener(
    "click",
    (event) => {
      const target =
        event.target as Node;

      if (
        locationMenu &&
        locationToggle &&
        !locationMenu.contains(target) &&
        !locationToggle.contains(target)
      ) {
        closeLocationMenu();
      }
    }
  );


  function selectLocation(
    button: HTMLButtonElement
  ): void {
    locationOptions.forEach(
      (option) => {
        option.classList.remove(
          "active"
        );

        option.setAttribute(
          "aria-selected",
          "false"
        );
      }
    );

    button.classList.add("active");

    button.setAttribute(
      "aria-selected",
      "true"
    );

    const latitude =
      button.dataset.lat;

    const longitude =
      button.dataset.lon;

    const city =
      button.dataset.city;

    const region =
      button.dataset.region;

    if (
      !latitude ||
      !longitude ||
      !city ||
      !region
    ) {
      return;
    }

    if (locationToggleLabel) {
      locationToggleLabel.textContent =
        city;
    }

    closeLocationMenu();

    void loadCity(
      latitude,
      longitude,
      city,
      region
    );
  }


  locationOptions.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          selectLocation(button);
        }
      );
    }
  );


  /* ============================================================ */
  /* NAV */
  /* ============================================================ */

  navLinks.forEach(
    (link) => {
      link.addEventListener(
        "click",
        () => {
          navLinks.forEach(
            (other) =>
              other.classList.remove(
                "active"
              )
          );

          link.classList.add(
            "active"
          );
        }
      );
    }
  );


  /* ============================================================ */
  /* HOURLY CONTROLS */
  /* ============================================================ */

  function scrollHourly(
    amount: number
  ): void {
    const table =
      document.querySelector(
        ".hourly-table-wrap"
      );

    if (table) {
      table.scrollBy({
        left: amount,
        behavior: "smooth"
      });
    }
  }


  hourlyPrev?.addEventListener(
    "click",
    () => {
      scrollHourly(-420);
    }
  );


  hourlyNext?.addEventListener(
    "click",
    () => {
      scrollHourly(420);
    }
  );


  /* ============================================================ */
  /* INITIAL CITY */
  /* ============================================================ */

  const firstLocation =
    locationOptions.item(0);

  if (firstLocation) {
    const latitude =
      firstLocation.dataset.lat;

    const longitude =
      firstLocation.dataset.lon;

    const city =
      firstLocation.dataset.city;

    const region =
      firstLocation.dataset.region;

    if (
      latitude &&
      longitude &&
      city &&
      region
    ) {
      void loadCity(
        latitude,
        longitude,
        city,
        region
      );
    }
  }
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE CANVAS -->
<!-- ============================================================= -->

<script>
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    opacity: number;
  }

  const canvas =
    document.getElementById(
      "weather-background"
    ) as HTMLCanvasElement | null;

  if (canvas) {
    const maybeContext =
      canvas.getContext("2d");

    if (maybeContext) {
      const context =
        maybeContext;

      const particles: Particle[] = [];

      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;


      function getParticleCount(): number {
        return window.innerWidth < 768
          ? 22
          : 42;
      }


      let particleCount =
        getParticleCount();


      function resize() {
  if (!canvas) return;

  canvas.width = Math.floor(window.innerWidth * devicePixelRatio);
  canvas.height = Math.floor(window.innerHeight * devicePixelRatio);

  canvas.style.width = `${window.innerWidth}px`;
  canvas.style.height = `${window.innerHeight}px`;
}


      function createParticle(): Particle {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx:
            (Math.random() - 0.5) *
            0.08,
          vy:
            (Math.random() - 0.5) *
            0.08,
          size:
            Math.random() * 1.3 +
            0.4,
          opacity:
            Math.random() * 0.28 +
            0.08
        };
      }


      function initializeParticles(): void {
        particles.length = 0;

        for (
          let index = 0;
          index < particleCount;
          index += 1
        ) {
          particles.push(
            createParticle()
          );
        }
      }


      function drawGrid(): void {
        const spacing = 84;

        const offsetX =
          (mouseX - width / 2) *
          0.01;

        const offsetY =
          (mouseY - height / 2) *
          0.01;

        context.save();

        context.strokeStyle =
          "rgba(0, 113, 240, 0.05)";

        context.lineWidth = 1;

        for (
          let x =
            -spacing +
            (offsetX % spacing);
          x < width + spacing;
          x += spacing
        ) {
          context.beginPath();

          context.moveTo(
            x,
            0
          );

          context.lineTo(
            x,
            height
          );

          context.stroke();
        }

        for (
          let y =
            -spacing +
            (offsetY % spacing);
          y < height + spacing;
          y += spacing
        ) {
          context.beginPath();

          context.moveTo(
            0,
            y
          );

          context.lineTo(
            width,
            y
          );

          context.stroke();
        }

        context.restore();
      }


      function drawConnections(): void {
        const maxDistance = 130;

        for (
          let i = 0;
          i < particles.length;
          i += 1
        ) {
          const first =
            particles[i];

          if (!first) continue;

          for (
            let j = i + 1;
            j < particles.length;
            j += 1
          ) {
            const second =
              particles[j];

            if (!second) continue;

            const dx =
              first.x -
              second.x;

            const dy =
              first.y -
              second.y;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );

            if (
              distance <
              maxDistance
            ) {
              const opacity =
                (1 -
                  distance /
                    maxDistance) *
                0.08;

              context.beginPath();

              context.moveTo(
                first.x,
                first.y
              );

              context.lineTo(
                second.x,
                second.y
              );

              context.strokeStyle =
                `rgba(0,113,240,${opacity})`;

              context.lineWidth = 1;

              context.stroke();
            }
          }
        }
      }


      function drawParticles(): void {
        for (
          const particle of particles
        ) {
          particle.x +=
            particle.vx;

          particle.y +=
            particle.vy;

          if (
            particle.x <
            -10
          ) {
            particle.x =
              width + 10;
          }

          if (
            particle.x >
            width + 10
          ) {
            particle.x = -10;
          }

          if (
            particle.y <
            -10
          ) {
            particle.y =
              height + 10;
          }

          if (
            particle.y >
            height + 10
          ) {
            particle.y = -10;
          }

          const dx =
            targetMouseX -
            particle.x;

          const dy =
            targetMouseY -
            particle.y;

          const distance =
            Math.sqrt(
              dx * dx +
              dy * dy
            );

          if (
            distance < 180 &&
            distance > 0
          ) {
            const force =
              (1 -
                distance /
                  180) *
              0.004;

            particle.vx +=
              dx * force;

            particle.vy +=
              dy * force;
          }

          particle.vx *=
            0.996;

          particle.vy *=
            0.996;

          context.beginPath();

          context.arc(
            particle.x,
            particle.y,
            particle.size,
            0,
            Math.PI * 2
          );

          context.fillStyle =
            `rgba(0,113,240,${particle.opacity})`;

          context.fill();
        }
      }


      function drawMouseGlow(): void {
        const gradient =
          context.createRadialGradient(
            targetMouseX,
            targetMouseY,
            0,
            targetMouseX,
            targetMouseY,
            260
          );

        gradient.addColorStop(
          0,
          "rgba(0,113,240,0.05)"
        );

        gradient.addColorStop(
          0.45,
          "rgba(0,113,240,0.018)"
        );

        gradient.addColorStop(
          1,
          "rgba(0,113,240,0)"
        );

        context.fillStyle =
          gradient;

        context.fillRect(
          0,
          0,
          width,
          height
        );
      }


      function animate(): void {
        mouseX +=
          (targetMouseX -
            mouseX) *
          0.045;

        mouseY +=
          (targetMouseY -
            mouseY) *
          0.045;

        context.clearRect(
          0,
          0,
          width,
          height
        );

        drawMouseGlow();
        drawGrid();
        drawConnections();
        drawParticles();

        animationFrame =
          window.requestAnimationFrame(
            animate
          );
      }


      function handleResize(): void {
        resize();
        initializeParticles();
      }


      function handleMouseMove(
        event: MouseEvent
      ): void {
        targetMouseX =
          event.clientX;

        targetMouseY =
          event.clientY;
      }


      function handleMouseLeave(): void {
        targetMouseX =
          width / 2;

        targetMouseY =
          height / 2;
      }


      resize();

      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;

      mouseX =
        width / 2;

      mouseY =
        height / 2;

      initializeParticles();

      window.addEventListener(
        "resize",
        handleResize
      );

      window.addEventListener(
        "mousemove",
        handleMouseMove,
        { passive: true }
      );

      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {
        animationFrame =
          window.requestAnimationFrame(
            animate
          );
      } else {
        drawGrid();
        drawConnections();
        drawParticles();
      }


      window.addEventListener(
        "pagehide",
        () => {
          window.cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            handleResize
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>


<!-- ============================================================= -->
<!-- STYLES -->
<!-- ============================================================= -->

<style>
  /* ============================================================ */
  /* VARIABLES */
  /* ============================================================ */

  .weather-page {
    --electric-blue: #0071f0;
    --electric-blue-bright: #2f8dff;
    --electric-blue-deep: #0a4fc4;
    --electric-blue-soft: rgba(0, 113, 240, 0.07);

    --ink: #0d1420;
    --ink-soft: rgba(13, 20, 32, 0.64);
    --ink-muted: rgba(13, 20, 32, 0.42);

    --white: #ffffff;

    --border: rgba(13, 20, 32, 0.08);
    --glass-line: rgba(255, 255, 255, 0.76);

    --glass: rgba(255, 255, 255, 0.58);

    --glass-shadow:
      0 24px 60px rgba(29, 77, 130, 0.14);

    position: relative;
    min-height: 100vh;
    overflow: hidden;

    color: var(--ink);

    background:
      radial-gradient(
        circle at 8% 12%,
        rgba(130, 214, 255, 0.48),
        transparent 28%
      ),
      radial-gradient(
        circle at 92% 18%,
        rgba(160, 181, 255, 0.34),
        transparent 32%
      ),
      radial-gradient(
        circle at 48% 92%,
        rgba(117, 232, 221, 0.25),
        transparent 36%
      ),
      linear-gradient(
        145deg,
        #e9f7ff 0%,
        #e9efff 49%,
        #f8f7ff 100%
      );

    scroll-behavior: smooth;
  }


  * {
    box-sizing: border-box;
  }


  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }


  /* ============================================================ */
  /* BACKGROUND */
  /* ============================================================ */

  .weather-background {
    position: fixed;
    inset: 0;

    z-index: 0;

    width: 100%;
    height: 100%;

    pointer-events: none;
  }


  .weather-atmosphere {
    position: fixed;
    inset: 0;

    z-index: 1;

    pointer-events: none;

    background:
      radial-gradient(
        circle at 20% 0%,
        rgba(255, 255, 255, 0.76),
        transparent 26%
      ),
      radial-gradient(
        circle at 83% 25%,
        rgba(255, 255, 255, 0.45),
        transparent 24%
      );

    animation:
      liquid-drift 16s ease-in-out infinite alternate;
  }


  .weather-content {
    position: relative;
    z-index: 2;
  }


  .weather-wrapper {
    width: 100%;
    max-width: 1150px;

    margin: 0 auto;

    padding:
      40px 24px 80px;
  }


  /* ============================================================ */
  /* TOP BAR */
  /* ============================================================ */

  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    flex-wrap: wrap;

    gap: 16px;

    padding:
      12px 18px;

    margin-bottom: 18px;

    border:
      1px solid var(--glass-line);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.62);

    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);

    backdrop-filter:
      blur(22px) saturate(145%);

    -webkit-backdrop-filter:
      blur(22px) saturate(145%);
  }


  .brand {
    display: flex;
    align-items: center;

    gap: 8px;

    color: var(--ink);

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.14em;
  }


  .brand-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background:
      var(--electric-blue);

    box-shadow:
      0 0 8px var(--electric-blue),
      0 0 20px rgba(0, 113, 240, 0.35);
  }


  .brand-location {
    padding:
      5px 9px;

    border:
      1px solid rgba(0, 113, 240, 0.18);

    border-radius: 999px;

    color:
      var(--electric-blue);

    background:
      rgba(0, 113, 240, 0.07);

    font-size: 10px;

    letter-spacing:
      0.04em;
  }


  .location-dropdown {
    position: relative;
  }


  .location-toggle {
    display: flex;
    align-items: center;

    gap: 8px;

    padding:
      9px 16px;

    border:
      1px solid rgba(255, 255, 255, 0.12);

    border-radius: 999px;

    color:
      var(--white);

    background:
      var(--ink);

    font-family: inherit;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }


  .location-toggle:hover {
    transform: translateY(-1px);

    box-shadow:
      0 8px 20px
      rgba(13, 20, 32, 0.18);
  }


  .location-toggle .chevron {
    transition:
      transform 0.2s ease;
  }


  .location-toggle[aria-expanded="true"]
    .chevron {
    transform:
      rotate(180deg);
  }


  .location-menu {
    position: absolute;

    top:
      calc(100% + 8px);

    left: 0;

    z-index: 20;

    display: none;

    min-width: 180px;

    padding: 6px;

    margin: 0;

    list-style: none;

    border:
      1px solid var(--glass-line);

    border-radius: 16px;

    background:
      rgba(250, 253, 255, 0.92);

    box-shadow:
      0 20px 50px
      rgba(29, 77, 130, 0.18);

    backdrop-filter:
      blur(20px);
  }


  .location-menu.open {
    display: block;
  }


  .location-option {
    width: 100%;

    padding:
      10px 12px;

    border: 0;

    border-radius: 10px;

    background:
      transparent;

    color:
      var(--ink-soft);

    font-family: inherit;

    font-size: 14px;

    text-align: left;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }


  .location-option:hover,
  .location-option.active {
    background:
      var(--electric-blue-soft);

    color:
      var(--electric-blue);
  }


  .location-option.active {
    font-weight: 700;
  }


  .top-nav {
    display: flex;

    gap: 22px;
  }


  .top-nav-link {
    padding-bottom: 2px;

    border-bottom:
      2px solid transparent;

    color:
      var(--ink-muted);

    font-size: 14px;
    font-weight: 500;

    text-decoration: none;

    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }


  .top-nav-link:hover {
    color:
      var(--ink);
  }


  .top-nav-link.active {
    color:
      var(--electric-blue);

    border-color:
      var(--electric-blue);
  }


  /* ============================================================ */
  /* LOCATION */
  /* ============================================================ */

  .location-meta {
    display: flex;
    align-items: center;

    flex-wrap: wrap;

    gap: 8px;

    margin:
      0 0 20px 6px;

    color:
      var(--ink-muted);

    font-size: 13px;
  }


  .location-meta svg {
    flex-shrink: 0;

    color:
      var(--electric-blue);
  }


  .meta-divider {
    color:
      var(--ink-muted);
  }


  /* ============================================================ */
  /* HERO */
  /* ============================================================ */

  .hero {
    position: relative;

    isolation: isolate;

    overflow: hidden;

    padding:
      40px 44px;

    border:
      1px solid rgba(255, 255, 255, 0.58);

    border-radius: 28px;

    background:
      radial-gradient(
        circle at 20% 15%,
        rgba(255, 255, 255, 0.42),
        transparent 25%
      ),
      linear-gradient(
        132deg,
        rgba(19, 65, 162, 0.94),
        rgba(12, 132, 237, 0.88) 55%,
        rgba(85, 184, 255, 0.84)
      );

    box-shadow:
      0 30px 75px
      rgba(17, 87, 177, 0.3),
      inset 0 1px
      rgba(255, 255, 255, 0.55);

    scroll-margin-top:
      90px;
  }


  .hero::before,
  .hero::after {
    position: absolute;

    z-index: -1;

    content: "";

    border-radius: 50%;

    pointer-events: none;
  }


  .hero::before {
    width: 340px;
    height: 340px;

    right: -88px;
    bottom: -205px;

    background:
      rgba(255, 255, 255, 0.2);

    animation:
      liquid-float 9s
      ease-in-out infinite;
  }


  .hero::after {
    width: 160px;
    height: 160px;

    top: -85px;
    left: 45%;

    background:
      rgba(174, 234, 255, 0.25);

    animation:
      liquid-float 12s
      ease-in-out -4s infinite reverse;
  }


  .hero-top {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;
  }


  .hero-temp-row {
    display: flex;

    align-items: flex-start;
  }


  .hero-temp {
    color:
      var(--white);

    font-size:
      clamp(4.5rem, 11vw, 7rem);

    font-weight: 600;

    line-height: 0.85;

    letter-spacing:
      -0.04em;
  }


  .hero-unit {
    margin-top: 6px;

    color:
      var(--white);

    font-size:
      clamp(2rem, 4vw, 2.8rem);

    font-weight: 300;
  }


  .hero-condition {
    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 10px;

    text-align: right;
  }


  .hero-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 64px;
    height: 64px;

    color:
      var(--white);
  }


  .hero-description {
    max-width: 220px;

    margin: 0;

    color:
      var(--white);

    font-size: 18px;
    font-weight: 600;
  }


  .hero-stats-row {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 10px;

    margin-top: 18px;

    color:
      rgba(255, 255, 255, 0.9);

    font-size: 16px;
  }


  .hero-stats-row strong {
    color:
      var(--white);

    font-weight: 700;
  }


  .stat-divider {
    color:
      rgba(255, 255, 255, 0.45);
  }


  /* ============================================================ */
  /* OUTLOOK */
  /* ============================================================ */

  .outlook-section {
    display: grid;

    grid-template-columns:
      46px 1fr;

    gap: 16px;

    margin-top: 30px;

    padding:
      21px 24px;

    border:
      1px solid var(--glass-line);

    border-radius: 22px;

    background:
      var(--glass);

    box-shadow:
      var(--glass-shadow),
      inset 0 1px
      rgba(255, 255, 255, 0.88);

    backdrop-filter:
      blur(22px) saturate(145%);

    -webkit-backdrop-filter:
      blur(22px) saturate(145%);
  }


  .outlook-icon {
    display: grid;

    place-items: center;

    width: 42px;
    height: 42px;

    border:
      1px solid
      rgba(255, 255, 255, 0.88);

    border-radius: 14px;

    color:
      var(--electric-blue);

    background:
      rgba(255, 255, 255, 0.4);

    box-shadow:
      inset 0 1px
      rgba(255, 255, 255, 0.9);

    font-size: 20px;
  }


  .outlook-section h2 {
    margin: 0;

    color:
      var(--ink);

    font-size: 20px;
    font-weight: 700;
  }


  .outlook-section p {
    max-width: 720px;

    margin:
      8px 0 0;

    color:
      var(--ink-soft);

    font-size: 15px;

    line-height: 1.7;
  }


  /* ============================================================ */
  /* SECTION */
  /* ============================================================ */

  .section-divider {
    height: 1px;

    margin-bottom: 40px;

    background:
      var(--border);
  }


  .section-kicker,
  .section-heading > span,
  .technologies > span {
    display: inline-block;

    color:
      var(--electric-blue);

    font-size: 11px;
    font-weight: 700;

    letter-spacing:
      0.2em;
  }


  /* ============================================================ */
  /* HOURLY */
  /* ============================================================ */

  .hourly-section {
    margin-top: 76px;

    scroll-margin-top:
      90px;
  }


  .hourly-header {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 24px;

    margin-bottom: 24px;
  }


  .hourly-header h2 {
    margin:
      10px 0 0;

    color:
      var(--ink);

    font-size:
      clamp(1.8rem, 3.6vw, 2.5rem);

    font-weight: 500;

    letter-spacing:
      -0.03em;
  }


  .hourly-header p {
    margin:
      10px 0 0;

    color:
      var(--ink-soft);

    font-size: 14px;
  }


  .hourly-controls {
    display: flex;

    gap: 8px;
  }


  .hourly-nav {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    border:
      1px solid
      rgba(13, 20, 32, 0.1);

    border-radius: 50%;

    color:
      var(--ink-soft);

    background:
      rgba(255, 255, 255, 0.72);

    box-shadow:
      0 8px 20px
      rgba(29, 77, 130, 0.08);

    cursor: pointer;

    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }


  .hourly-nav:hover {
    color:
      var(--electric-blue);

    border-color:
      rgba(0, 113, 240, 0.28);

    transform:
      translateY(-1px);
  }


  .hourly-card {
    overflow: hidden;

    border:
      1px solid
      rgba(255, 255, 255, 0.8);

    border-radius: 24px;

    background:
      rgba(255, 255, 255, 0.68);

    box-shadow:
      0 24px 60px
      rgba(29, 77, 130, 0.12),
      inset 0 1px
      rgba(255, 255, 255, 0.95);

    backdrop-filter:
      blur(20px) saturate(140%);

    -webkit-backdrop-filter:
      blur(20px) saturate(140%);
  }


  .hourly-table-wrap {
    width: 100%;

    overflow-x: auto;

    scrollbar-width: thin;
    scrollbar-color:
      rgba(0, 113, 240, 0.25)
      transparent;
  }


  .hourly-table {
    min-width: 790px;
  }


  .hourly-row {
    display: grid;

    grid-template-columns:
      100px
      minmax(230px, 1.5fr)
      120px
      100px
      100px
      150px;

    align-items: center;

    min-height: 70px;

    border-bottom:
      1px solid
      rgba(13, 20, 32, 0.08);

    column-gap: 16px;

    padding:
      0 22px;

    transition:
      background 0.2s ease;
  }


  .hourly-row:last-child {
    border-bottom: 0;
  }


  .hourly-head {
    min-height: 54px;

    color:
      rgba(13, 20, 32, 0.55);

    background:
      rgba(245, 249, 255, 0.7);

    font-size: 12px;
    font-weight: 600;
  }


  .hourly-row:not(.hourly-head):hover {
    background:
      rgba(255, 255, 255, 0.62);
  }


  .hourly-now {
    position: relative;

    background:
      linear-gradient(
        90deg,
        rgba(0, 113, 240, 0.075),
        rgba(255, 255, 255, 0.25)
      );
  }


  .hourly-now::before {
    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 3px;

    content: "";

    background:
      var(--electric-blue);
  }


  .hourly-time-cell {
    display: flex;

    flex-direction: column;

    gap: 3px;
  }


  .hourly-time-cell strong {
    color:
      var(--ink);

    font-size: 15px;
  }


  .hourly-time-cell small {
    color:
      var(--ink-muted);

    font-size: 10px;
  }


  .hourly-now
    .hourly-time-cell strong {
    color:
      var(--electric-blue);
  }


  .hourly-condition-cell {
    display: flex;

    align-items: center;

    gap: 13px;

    min-width: 0;

    color:
      var(--ink);
  }


  .hourly-condition-cell > span:last-child {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 14px;
    font-weight: 500;
  }


  .hourly-condition-icon {
    display: grid;

    place-items: center;

    flex:
      0 0 42px;

    width: 42px;
    height: 42px;

    border:
      1px solid
      rgba(0, 113, 240, 0.15);

    border-radius: 13px;

    color:
      var(--electric-blue);

    background:
      rgba(0, 113, 240, 0.06);
  }


  .hourly-temperature-cell {
    color:
      var(--ink);

    font-size: 17px;
    font-weight: 700;
  }


  .hourly-precip-cell {
    color:
      var(--electric-blue);

    font-size: 14px;
    font-weight: 600;
  }


  .hourly-humidity-cell {
    color:
      var(--ink-soft);

    font-size: 14px;
  }


  .hourly-wind-cell {
    display: flex;

    align-items: center;

    gap: 10px;

    color:
      var(--ink-soft);
  }


  .hourly-wind-cell > span:last-child {
    display: flex;

    flex-direction: column;

    gap: 2px;
  }


  .hourly-wind-cell strong {
    color:
      var(--ink);

    font-size: 13px;
  }


  .hourly-wind-cell small {
    color:
      var(--ink-muted);

    font-size: 10px;
  }


  .wind-arrow {
    display: grid;

    place-items: center;

    width: 27px;
    height: 27px;

    border-radius: 50%;

    color:
      var(--electric-blue);

    background:
      rgba(0, 113, 240, 0.07);

    font-size: 16px;

    transition:
      transform 0.2s ease;
  }


  .hourly-loading {
    padding:
      45px 20px;

    color:
      var(--ink-muted);

    text-align: center;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 11px;
  }


  /* ============================================================ */
  /* ICON */
  /* ============================================================ */

  .weather-icon-svg {
    display: block;

    width: 1em;
    height: 1em;
  }


  .hero-icon .weather-icon-svg {
    width: 1.2em;
    height: 1.2em;
  }


  .hourly-condition-icon
    .weather-icon-svg {
    width: 25px;
    height: 25px;
  }


  .forecast-condition
    .weather-icon-svg {
    width: 26px;
    height: 26px;
  }


  /* ============================================================ */
  /* DAILY FORECAST */
  /* ============================================================ */

  .weather-section {
    margin-top: 90px;

    scroll-margin-top:
      90px;
  }


  .section-heading h2 {
    margin-top: 12px;

    color:
      var(--ink);

    font-size:
      clamp(1.8rem, 3.6vw, 2.6rem);

    font-weight: 500;

    letter-spacing:
      -0.03em;
  }


  .section-heading p {
    max-width: 680px;

    margin-top: 14px;

    color:
      var(--ink-soft);

    font-size: 14px;

    line-height: 1.8;
  }


  .forecast-container {
    margin-top: 26px;

    overflow: hidden;

    border:
      1px solid
      rgba(255, 255, 255, 0.8);

    border-radius: 24px;

    background:
      rgba(255, 255, 255, 0.68);

    box-shadow:
      0 24px 60px
      rgba(29, 77, 130, 0.12),
      inset 0 1px
      rgba(255, 255, 255, 0.9);

    backdrop-filter:
      blur(20px);
  }


  .forecast-item + .forecast-item {
    border-top:
      1px solid
      var(--border);
  }


  .forecast-summary {
    display: grid;

    grid-template-columns:
      104px
      minmax(180px, 1.2fr)
      86px
      minmax(210px, 1fr)
      22px;

    align-items: center;

    gap: 20px;

    width: 100%;

    min-height: 88px;

    padding:
      17px 24px;

    border: 0;

    color:
      var(--ink);

    background:
      transparent;

    font: inherit;

    text-align: left;

    cursor: pointer;

    transition:
      background 0.2s ease;
  }


  .forecast-summary:hover,
  .forecast-item.is-open
    .forecast-summary {
    background:
      linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.7),
        rgba(226, 243, 255, 0.28)
      );
  }


  .forecast-date,
  .forecast-condition,
  .forecast-rain,
  .forecast-temperature {
    display: flex;

    align-items: center;
  }


  .forecast-date,
  .forecast-rain {
    display: grid;

    gap: 4px;
  }


  .forecast-date strong,
  .forecast-condition strong,
  .forecast-rain strong {
    font-size: 14px;

    font-weight: 650;
  }


  .forecast-date small,
  .forecast-condition small,
  .forecast-rain small,
  .forecast-details small {
    color:
      var(--ink-muted);

    font-size: 11px;
  }


  .forecast-condition {
    gap: 13px;

    min-width: 0;
  }


  .forecast-condition > i {
    display: grid;

    flex:
      0 0 42px;

    width: 42px;
    height: 42px;

    place-items: center;

    border:
      1px solid
      rgba(0, 113, 240, 0.14);

    border-radius: 14px;

    color:
      var(--electric-blue);

    background:
      var(--electric-blue-soft);

    font-style: normal;
  }


  .forecast-condition > span {
    display: grid;

    gap: 4px;

    min-width: 0;
  }


  .forecast-condition strong {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
  }


  .forecast-rain strong {
    color:
      var(--electric-blue);
  }


  .forecast-temperature {
    justify-content: end;

    gap: 10px;
  }


  .forecast-temperature > strong {
    color:
      var(--ink-muted);

    font-size: 15px;
  }


  .forecast-temperature > b {
    font-size: 15px;
  }


  .temperature-track {
    position: relative;

    width:
      min(100%, 116px);

    height: 6px;

    overflow: hidden;

    border-radius: 999px;

    background:
      linear-gradient(
        90deg,
        #d6e8ff,
        #ffe4b0
      );
  }


  .temperature-track i {
    position: absolute;

    top: 0;
    bottom: 0;

    display: block;

    min-width: 9px;

    border-radius: inherit;

    background:
      linear-gradient(
        90deg,
        #2389ff,
        #ffb13b
      );
  }


  .forecast-chevron {
    color:
      var(--ink-muted);

    font-size: 20px;

    transition:
      transform 0.2s ease;
  }


  .forecast-item.is-open
    .forecast-chevron {
    transform:
      rotate(180deg);
  }


  .forecast-details {
    display: none;

    grid-template-columns:
      repeat(4, 1fr);

    gap: 1px;

    border-top:
      1px solid
      var(--border);

    background:
      var(--border);
  }


  .forecast-item.is-open
    .forecast-details {
    display: grid;
  }


  .forecast-details > span {
    display: grid;

    gap: 5px;

    padding:
      15px 24px 18px;

    background:
      rgba(248, 251, 255, 0.88);
  }


  .forecast-details strong {
    color:
      var(--ink-soft);

    font-size: 12px;
    font-weight: 600;
  }


  .forecast-loading {
    padding:
      45px 20px;

    color:
      var(--ink-muted);

    text-align: center;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

