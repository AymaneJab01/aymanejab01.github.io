  /* ==========================================================
     RESPONSIVE
  ========================================================== */

  @media (max-width: 850px) {
    .hero-weather-card {
      grid-template-columns: 1fr;
    }

    .hero-side {
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .details-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .location-tabs {
      grid-template-columns: 1fr;
    }

