    transform: translateX(5px);
    opacity: 0.8;
  }


  /* ============================================================ */
  /* MOBILE */
  /* ============================================================ */

  @media (max-width: 900px) {
    .weather-wrapper {
      padding-top: 90px;
    }


    .weather-cards {
      grid-template-columns: 1fr;
    }


    .forecast-container {
      overflow-x: auto;
      grid-template-columns:
        repeat(7, 120px);
    }


    .forecast-item {
      min-width: 120px;
    }
  }


  @media (max-width: 650px) {
    .weather-wrapper {
      padding:
        70px 16px 60px;
    }


    .weather-header {
      margin-bottom: 70px;
    }


    .weather-header h1 {
      font-size: 3.3rem;
    }


    .header-description {
      font-size: 14px;
    }


    .weather-section {
      margin-top: 70px;
    }


    .weather-card {
      min-height: 430px;
      border-radius: 18px;
    }


    .card-content {
      padding: 24px;
    }


    .card-top h3 {
      font-size: 27px;
    }


    .weather-icon {
      width: 54px;
      height: 54px;
      border-radius: 15px;
      font-size: 27px;
    }


    .temperature-area {
      margin-top: 55px;
    }


    .weather-temperature {
      font-size: 5rem;
    }


    .documentation-grid {
      grid-template-columns: 1fr;
    }
  }


  /* ============================================================ */
  /* REDUCED MOTION */
  /* ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .weather-card,
    .card-glow,
    .forecast-button,
    .forecast-item,
    .back-link {
      transition: none;
    }


