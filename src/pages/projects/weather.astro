---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Weather Dashboard">

  <main class="weather-page">

```
<!-- =========================================================
     INTERACTIVE BACKGROUND
     ========================================================= -->

<canvas
  id="weather-canvas"
  class="weather-canvas"
  aria-hidden="true"
></canvas>

<div class="blue-atmosphere atmosphere-one"></div>
<div class="blue-atmosphere atmosphere-two"></div>

<!-- =========================================================
     DOCUMENTATION HEADER
     ========================================================= -->

<section class="weather-shell">

  <header class="documentation-header">

    <div class="eyebrow">
      <span class="status-dot"></span>
      LIVE WEATHER SYSTEM
    </div>

    <div class="header-grid">

      <div>

        <h1>
          Weather
          <span>Dashboard.</span>
        </h1>

        <p class="header-description">
          Real-time atmospheric conditions for
          <strong>Alcoi</strong> and
          <strong>Valencia</strong>, powered by
          live meteorological data.
        </p>

      </div>

      <div class="system-info">

        <div>
          <span>DATA SOURCE</span>
          <strong>Open-Meteo</strong>
        </div>

        <div>
          <span>UPDATE MODE</span>
          <strong>REALTIME</strong>
        </div>

        <div>
          <span>TIMEZONE</span>
          <strong>Europe/Madrid</strong>
        </div>

      </div>

    </div>

  </header>


  <!-- =======================================================
       LOCATION SWITCHER
       ======================================================= -->

  <nav class="location-nav">

    <button
      class="location-button active"
      data-location="alcoi"
      type="button"
    >
      <span class="location-indicator"></span>
      Alcoi
    </button>

    <button
      class="location-button"
      data-location="valencia"
      type="button"
    >
      <span class="location-indicator"></span>
      Valencia
    </button>

  </nav>


  <!-- =======================================================
       MAIN WEATHER PANEL
       ======================================================= -->

  <section class="weather-panel">

    <div class="panel-top">

      <div>

        <div class="section-label">
          CURRENT CONDITIONS
        </div>

        <h2 id="location-name">
          Alcoi
        </h2>

        <p
          id="location-region"
          class="location-region"
        >
          Alicante, Spain
        </p>

      </div>

      <div class="updated">

        <span>LAST UPDATE</span>

        <strong id="updated-time">
          --
        </strong>

      </div>

    </div>


    <!-- =====================================================
         CURRENT WEATHER
         ===================================================== -->

    <div class="current-weather">

      <div class="temperature-block">

        <div
          id="weather-icon"
          class="weather-icon"
        >
          ☀
        </div>

        <div>

          <div
            id="temperature"
            class="temperature"
          >
            --
          </div>

          <div
            id="description"
            class="weather-description"
          >
            Loading conditions...
          </div>

        </div>

      </div>


      <div class="temperature-details">

        <div>
          <span>FEELS LIKE</span>
          <strong id="feels-like">--</strong>
        </div>

        <div>
          <span>HIGH</span>
          <strong id="high-temperature">--</strong>
        </div>

        <div>
          <span>LOW</span>
          <strong id="low-temperature">--</strong>
        </div>

      </div>

    </div>


    <!-- =====================================================
         WEATHER METRICS
         ===================================================== -->

    <div class="metrics-grid">

      <div class="metric">

        <span class="metric-label">
          PRECIPITATION
        </span>

        <strong id="precipitation">
          --
        </strong>

        <small>
          probability
        </small>

      </div>


      <div class="metric">

        <span class="metric-label">
          HUMIDITY
        </span>

        <strong id="humidity">
          --
        </strong>

        <small>
          relative humidity
        </small>

      </div>


      <div class="metric">

        <span class="metric-label">
          WIND
        </span>

        <strong id="wind">
          --
        </strong>

        <small>
          km/h
        </small>

      </div>


      <div class="metric">

        <span class="metric-label">
          PRESSURE
        </span>

        <strong id="pressure">
          --
        </strong>

        <small>
          hPa
        </small>

      </div>


      <div class="metric">

        <span class="metric-label">
          VISIBILITY
        </span>

        <strong id="visibility">
          --
        </strong>

        <small>
          km
        </small>

      </div>


      <div class="metric">

        <span class="metric-label">
          CLOUD COVER
        </span>

        <strong id="cloud-cover">
          --
        </strong>

        <small>
          percentage
        </small>

      </div>

    </div>

  </section>


  <!-- =======================================================
       TODAY'S OUTLOOK
       ======================================================= -->

  <section class="documentation-section">

    <div class="section-heading">

      <div>

        <span class="section-number">
          01
        </span>

        <h3>
          Today's outlook
        </h3>

      </div>

      <p>
        Hourly atmospheric evolution
      </p>

    </div>


    <div
      id="hourly-forecast"
      class="hourly-scroll"
    >

      <div class="forecast-loading">
        Loading forecast...
      </div>

    </div>

  </section>


  <!-- =======================================================
       DAILY FORECAST
       ======================================================= -->

  <section class="documentation-section">

    <div class="section-heading">

      <div>

        <span class="section-number">
          02
        </span>

        <h3>
          Daily forecast
        </h3>

      </div>

      <p>
        Seven-day projection
      </p>

    </div>


    <div
      id="daily-forecast"
      class="daily-list"
    >

      <div class="forecast-loading">
        Loading forecast...
      </div>

    </div>

  </section>


  <!-- =======================================================
       TECHNICAL INFORMATION
       ======================================================= -->

  <section class="documentation-section technical-section">

    <div class="section-heading">

      <div>

        <span class="section-number">
          03
        </span>

        <h3>
          Technical details
        </h3>

      </div>

      <p>
        API configuration
      </p>

    </div>


    <div class="technical-grid">

      <div class="technical-item">

        <span>
          API
        </span>

        <strong>
          Open-Meteo Forecast API
        </strong>

      </div>

      <div class="technical-item">

        <span>
          REQUEST
        </span>

        <strong>
          HTTPS / REST
        </strong>

      </div>

      <div class="technical-item">

        <span>
          FORMAT
        </span>

        <strong>
          JSON
        </strong>

      </div>

      <div class="technical-item">

        <span>
          REFRESH
        </span>

        <strong>
          On page load
        </strong>

      </div>

    </div>

  </section>


  <!-- =======================================================
       FOOTER
       ======================================================= -->

  <footer class="weather-footer">

    <div>

      <span class="footer-dot"></span>

      <span>
        WEATHER SYSTEM ONLINE
      </span>

    </div>

    <a href="/#projects">
      ← Back to projects
    </a>

  </footer>

</section>
```

  </main>

  <!-- ===========================================================
       WEATHER LOGIC
       =========================================================== -->

  <script>
    interface CurrentWeather {
      temperature_2m: number;
      relative_humidity_2m: number;
      apparent_temperature: number;
      precipitation_probability: number;
      weather_code: number;
      wind_speed_10m: number;
      surface_pressure: number;
      visibility: number;
      cloud_cover: number;
    }

    interface HourlyWeather {
      time: string[];
      temperature_2m: number[];
      weather_code: number[];
      precipitation_probability: number[];
    }

    interface DailyWeather {
      time: string[];
      weather_code: number[];
      temperature_2m_max: number[];
      temperature_2m_min: number[];
      precipitation_probability_max: number[];
    }

    interface WeatherResponse {
      current: CurrentWeather;
      hourly: HourlyWeather;
      daily: DailyWeather;
    }

    interface LocationConfig {
      name: string;
      region: string;
      latitude: number;
      longitude: number;
    }

    const locations: Record<string, LocationConfig> = {
      alcoi: {
        name: "Alcoi",
        region: "Alicante, Spain",
        latitude: 38.6983,
        longitude: -0.4743
      },

      valencia: {
        name: "Valencia",
        region: "Valencia, Spain",
        latitude: 39.4699,
        longitude: -0.3763
      }
    };

    let selectedLocation = "alcoi";

    const locationName =
      document.querySelector<HTMLElement>("#location-name");

    const locationRegion =
      document.querySelector<HTMLElement>("#location-region");

    const temperature =
      document.querySelector<HTMLElement>("#temperature");

    const description =
      document.querySelector<HTMLElement>("#description");

    const weatherIcon =
      document.querySelector<HTMLElement>("#weather-icon");

    const feelsLike =
      document.querySelector<HTMLElement>("#feels-like");

    const highTemperature =
      document.querySelector<HTMLElement>("#high-temperature");

    const lowTemperature =
      document.querySelector<HTMLElement>("#low-temperature");

    const precipitation =
      document.querySelector<HTMLElement>("#precipitation");

    const humidity =
      document.querySelector<HTMLElement>("#humidity");

    const wind =
      document.querySelector<HTMLElement>("#wind");

    const pressure =
      document.querySelector<HTMLElement>("#pressure");

    const visibility =
      document.querySelector<HTMLElement>("#visibility");

    const cloudCover =
      document.querySelector<HTMLElement>("#cloud-cover");

    const updatedTime =
      document.querySelector<HTMLElement>("#updated-time");

    const hourlyForecast =
      document.querySelector<HTMLElement>("#hourly-forecast");

    const dailyForecast =
      document.querySelector<HTMLElement>("#daily-forecast");


    const getDescription = (
      code: number
    ): string => {

      const descriptions: Record<number, string> = {
        0: "Clear sky",
        1: "Mainly clear",
        2: "Partly cloudy",
        3: "Overcast",
        45: "Fog",
        48: "Rime fog",
        51: "Light drizzle",
        53: "Moderate drizzle",
        55: "Dense drizzle",
        56: "Freezing drizzle",
        57: "Dense freezing drizzle",
        61: "Light rain",
        63: "Moderate rain",
        65: "Heavy rain",
        66: "Freezing rain",
        67: "Heavy freezing rain",
        71: "Light snow",
        73: "Moderate snow",
        75: "Heavy snow",
        77: "Snow grains",
        80: "Light rain showers",
        81: "Moderate rain showers",
        82: "Heavy rain showers",
        85: "Light snow showers",
        86: "Heavy snow showers",
        95: "Thunderstorm",
        96: "Thunderstorm with hail",
        99: "Thunderstorm with heavy hail"
      };

      return descriptions[code] ?? "Unknown conditions";
    };


    const getIcon = (
      code: number
    ): string => {

      if (code === 0) return "☀";

      if (code <= 3) return "◐";

      if (code <= 48) return "≋";

      if (code <= 67) return "☂";

      if (code <= 77) return "❄";

      if (code <= 82) return "◒";

      return "ϟ";
    };


    const formatHour = (
      value: string
    ): string => {

      return new Date(
        value
      ).toLocaleTimeString(
        "en-GB",
        {
          hour: "2-digit",
          minute: "2-digit"
        }
      );
    };


    const formatDay = (
      value: string,
      index: number
    ): string => {

      if (index === 0) {
        return "Today";
      }

      return new Date(
        `${value}T12:00:00`
      ).toLocaleDateString(
        "en-GB",
        {
          weekday: "short"
        }
      );
    };


    const updateMainWeather = (
      data: WeatherResponse
    ) => {

      const current = data.current;

      if (temperature) {
        temperature.textContent =
          `${Math.round(current.temperature_2m)}°`;
      }

      if (description) {
        description.textContent =
          getDescription(current.weather_code);
      }

      if (weatherIcon) {
        weatherIcon.textContent =
          getIcon(current.weather_code);
      }

      if (feelsLike) {
        feelsLike.textContent =
          `${Math.round(current.apparent_temperature)}°`;
      }

      if (humidity) {
        humidity.textContent =
          `${Math.round(current.relative_humidity_2m)}%`;
      }

      if (wind) {
        wind.textContent =
          `${Math.round(current.wind_speed_10m)}`;
      }

      if (pressure) {
        pressure.textContent =
          `${Math.round(current.surface_pressure)}`;
      }

      if (visibility) {
        visibility.textContent =
          `${Math.round(current.visibility / 1000)}`;
      }

      if (cloudCover) {
        cloudCover.textContent =
          `${Math.round(current.cloud_cover)}%`;
      }

      if (precipitation) {
        precipitation.textContent =
          `${Math.round(current.precipitation_probability)}%`;
      }

      if (updatedTime) {
        updatedTime.textContent =
          new Date().toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit"
            }
          );
      }

      if (
        highTemperature &&
        data.daily.temperature_2m_max.length
      ) {
        highTemperature.textContent =
          `${Math.round(
            data.daily.temperature_2m_max[0]
          )}°`;
      }

      if (
        lowTemperature &&
        data.daily.temperature_2m_min.length
      ) {
        lowTemperature.textContent =
          `${Math.round(
            data.daily.temperature_2m_min[0]
          )}°`;
      }
    };


    const renderHourly = (
      data: WeatherResponse
    ) => {

      if (!hourlyForecast) {
        return;
      }

      hourlyForecast.innerHTML = "";

      const currentHour =
        new Date().getHours();

      let startIndex = 0;

      for (
        let i = 0;
        i < data.hourly.time.length;
        i++
      ) {

        const hour =
          new Date(
            data.hourly.time[i]
          ).getHours();

        if (hour >= currentHour) {
          startIndex = i;
          break;
        }
      }

      const endIndex =
        Math.min(
          startIndex + 12,
          data.hourly.time.length
        );

      for (
        let i = startIndex;
        i < endIndex;
        i++
      ) {

        const item =
          document.createElement("div");

        item.className =
          "hour-card";

        item.innerHTML = `
          <span class="hour-time">
            ${i === startIndex
              ? "NOW"
              : formatHour(data.hourly.time[i])}
          </span>

          <span class="hour-icon">
            ${getIcon(data.hourly.weather_code[i])}
          </span>

          <strong class="hour-temperature">
            ${Math.round(data.hourly.temperature_2m[i])}°
          </strong>

          <span class="hour-rain">
            ${Math.round(
              data.hourly.precipitation_probability[i]
            )}%
          </span>
        `;

        hourlyForecast.appendChild(item);
      }
    };


    const renderDaily = (
      data: WeatherResponse
    ) => {

      if (!dailyForecast) {
        return;
      }

      dailyForecast.innerHTML = "";

      for (
        let i = 0;
        i < data.daily.time.length;
        i++
      ) {

        const item =
          document.createElement("div");

        item.className =
          "daily-row";

        item.innerHTML = `
          <div class="daily-name">
            <span class="daily-day">
              ${formatDay(
                data.daily.time[i],
                i
              )}
            </span>

            <span class="daily-condition">
              ${getDescription(
                data.daily.weather_code[i]
              )}
            </span>
          </div>

          <div class="daily-weather-icon">
            ${getIcon(
              data.daily.weather_code[i]
            )}
          </div>

          <div class="daily-rain">
            ${Math.round(
              data.daily.precipitation_probability_max[i]
            )}%
          </div>

          <div class="daily-temperatures">
            <strong>
              ${Math.round(
                data.daily.temperature_2m_max[i]
              )}°
            </strong>

            <span>
              ${Math.round(
                data.daily.temperature_2m_min[i]
              )}°
            </span>
          </div>
        `;

        dailyForecast.appendChild(item);
      }
    };


    const loadWeather = async (
      key: string
    ) => {

      const location =
        locations[key];

      if (!location) {
        return;
      }

      if (locationName) {
        locationName.textContent =
          location.name;
      }

      if (locationRegion) {
        locationRegion.textContent =
          location.region;
      }

      if (description) {
        description.textContent =
          "Loading conditions...";
      }

      try {

        const url =
          "https://api.open-meteo.com/v1/forecast" +
          `?latitude=${location.latitude}` +
          `&longitude=${location.longitude}` +
          "&current=" +
          "temperature_2m," +
          "relative_humidity_2m," +
          "apparent_temperature," +
          "precipitation_probability," +
          "weather_code," +
          "wind_speed_10m," +
          "surface_pressure," +
          "visibility," +
          "cloud_cover" +
          "&hourly=" +
          "temperature_2m," +
          "weather_code," +
          "precipitation_probability" +
          "&daily=" +
          "weather_code," +
          "temperature_2m_max," +
          "temperature_2m_min," +
          "precipitation_probability_max" +
          "&forecast_days=7" +
          "&timezone=Europe%2FMadrid";

        const response =
          await fetch(url);

        if (!response.ok) {
          throw new Error(
            "Weather API request failed"
          );
        }

        const data =
          await response.json() as WeatherResponse;

        updateMainWeather(data);
        renderHourly(data);
        renderDaily(data);

      } catch (error) {

        console.error(
          "Weather loading error:",
          error
        );

        if (description) {
          description.textContent =
            "Unable to load weather data";
        }
      }
    };


    const buttons =
      document.querySelectorAll<HTMLButtonElement>(
        ".location-button"
      );

    buttons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const location =
              button.dataset.location;

            if (!location) {
              return;
            }

            selectedLocation =
              location;

            buttons.forEach(
              (item) => {
                item.classList.remove(
                  "active"
                );
              }
            );

            button.classList.add(
              "active"
            );

            loadWeather(
              selectedLocation
            );
          }
        );
      }
    );


    loadWeather(selectedLocation);
  </script>

  <!-- ===========================================================
       REACT-BITS-INSPIRED INTERACTIVE EFFECT
       =========================================================== -->

  <script>
    const canvas =
      document.querySelector<HTMLCanvasElement>(
        "#weather-canvas"
      );

    if (canvas) {

      const ctx =
        canvas.getContext("2d");

      if (ctx) {

        interface Particle {
          x: number;
          y: number;
          vx: number;
          vy: number;
          radius: number;
          alpha: number;
        }

        const particles: Particle[] = [];

        let width = 0;
        let height = 0;

        let mouseX = 0;
        let mouseY = 0;

        let targetMouseX = 0;
        let targetMouseY = 0;

        let animationFrame = 0;

        const isMobile =
          window.innerWidth < 768;

        const particleCount =
          isMobile ? 55 : 105;


        const resize = () => {

          const ratio =
            Math.min(
              window.devicePixelRatio || 1,
              2
            );

          width =
            window.innerWidth;

          height =
            window.innerHeight;

          canvas.width =
            width * ratio;

          canvas.height =
            height * ratio;

          canvas.style.width =
            `${width}px`;

          canvas.style.height =
            `${height}px`;

          ctx.setTransform(
            ratio,
            0,
            0,
            ratio,
            0,
            0
          );
        };


        const createParticle =
          (): Particle => {

            return {
              x:
                Math.random() * width,

              y:
                Math.random() * height,

              vx:
                (Math.random() - 0.5) *
                0.35,

              vy:
                (Math.random() - 0.5) *
                0.35,

              radius:
                Math.random() * 1.8 +
                0.6,

              alpha:
                Math.random() * 0.55 +
                0.15
            };
          };


        const initialize = () => {

          particles.length = 0;

          for (
            let i = 0;
            i < particleCount;
            i++
          ) {
            particles.push(
              createParticle()
            );
          }
        };


        const drawGlow = () => {

          const gradient =
            ctx.createRadialGradient(
              mouseX,
              mouseY,
              0,
              mouseX,
              mouseY,
              420
            );

          gradient.addColorStop(
            0,
            "rgba(0,145,255,0.16)"
          );

          gradient.addColorStop(
            0.35,
            "rgba(0,115,255,0.07)"
          );

          gradient.addColorStop(
            1,
            "rgba(0,115,255,0)"
          );

          ctx.fillStyle =
            gradient;

          ctx.fillRect(
            0,
            0,
            width,
            height
          );
        };


        const drawAmbientWaves = () => {

          ctx.save();

          ctx.globalAlpha =
            0.11;

          for (
            let i = 0;
            i < 4;
            i++
          ) {

            const y =
              height *
                (0.22 + i * 0.2) +
              Math.sin(
                performance.now() *
                  0.00025 +
                  i
              ) *
                30;

            const gradient =
              ctx.createLinearGradient(
                0,
                y,
                width,
                y
              );

            gradient.addColorStop(
              0,
              "rgba(0,140,255,0)"
            );

            gradient.addColorStop(
              0.5,
              "rgba(0,140,255,0.6)"
            );

            gradient.addColorStop(
              1,
              "rgba(0,140,255,0)"
            );

            ctx.strokeStyle =
              gradient;

            ctx.lineWidth =
              1.2;

            ctx.beginPath();

            for (
              let x = 0;
              x <= width;
              x += 16
            ) {

              const wave =
                Math.sin(
                  x * 0.008 +
                  performance.now() *
                    0.0004 +
                  i
                ) *
                12;

              if (x === 0) {
                ctx.moveTo(
                  x,
                  y + wave
                );
              } else {
                ctx.lineTo(
                  x,
                  y + wave
                );
              }
            }

            ctx.stroke();
          }

          ctx.restore();
        };


        const drawParticles = () => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;

            particle.y +=
              particle.vy;


            if (
              particle.x < -20
            ) {
              particle.x =
                width + 20;
            }

            if (
              particle.x >
              width + 20
            ) {
              particle.x = -20;
            }


            if (
              particle.y < -20
            ) {
              particle.y =
                height + 20;
            }

            if (
              particle.y >
              height + 20
            ) {
              particle.y = -20;
            }


            const dx =
              targetMouseX -
              particle.x;

            const dy =
              targetMouseY -
              particle.y;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance < 220
            ) {

              const force =
                (1 -
                  distance / 220) *
                0.018;

              particle.vx +=
                dx * force;

              particle.vy +=
                dy * force;
            }


            particle.vx *=
              0.992;

            particle.vy *=
              0.992;


            ctx.beginPath();

            ctx.arc(
              particle.x,
              particle.y,
              particle.radius,
              0,
              Math.PI * 2
            );

            ctx.fillStyle =
              `rgba(0,130,255,${particle.alpha})`;

            ctx.shadowBlur =
              12;

            ctx.shadowColor =
              "rgba(0,130,255,0.8)";

            ctx.fill();

            ctx.shadowBlur =
              0;
          }
        };


        const drawConnections = () => {

          const maxDistance =
            145;

          for (
            let i = 0;
            i < particles.length;
            i++
          ) {

            for (
              let j = i + 1;
              j < particles.length;
              j++
            ) {

              const a =
                particles[i];

              const b =
                particles[j];

              const dx =
                a.x - b.x;

              const dy =
                a.y - b.y;

              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (1 -
                    distance /
                      maxDistance) *
                  0.18;

                ctx.beginPath();

                ctx.moveTo(
                  a.x,
                  a.y
                );

                ctx.lineTo(
                  b.x,
                  b.y
                );

                ctx.strokeStyle =
                  `rgba(0,125,255,${opacity})`;

                ctx.lineWidth =
                  0.7;

                ctx.stroke();
              }
            }
          }
        };


        const drawCursorConnections = () => {

          for (
            const particle of particles
          ) {

            const dx =
              particle.x -
              mouseX;

            const dy =
              particle.y -
              mouseY;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );

            if (
              distance <
              190
            ) {

              const opacity =
                (1 -
                  distance / 190) *
                0.38;

              ctx.beginPath();

              ctx.moveTo(
                mouseX,
                mouseY
              );

              ctx.lineTo(
                particle.x,
                particle.y
              );

              ctx.strokeStyle =
                `rgba(0,150,255,${opacity})`;

              ctx.lineWidth =
                1;

              ctx.stroke();
            }
          }
        };


        const animate = () => {

          mouseX +=
            (targetMouseX -
              mouseX) *
            0.055;

          mouseY +=
            (targetMouseY -
              mouseY) *
            0.055;


          ctx.clearRect(
            0,
            0,
            width,
            height
          );


          drawGlow();

          drawAmbientWaves();

          drawConnections();

          drawCursorConnections();

          drawParticles();


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


        window.addEventListener(
          "resize",
          resize,
          {
            passive: true
          }
        );


        window.addEventListener(
          "mousemove",
          (event) => {

            targetMouseX =
              event.clientX;

            targetMouseY =
              event.clientY;

          },
          {
            passive: true
          }
        );


        window.addEventListener(
          "mouseleave",
          () => {

            targetMouseX =
              width / 2;

            targetMouseY =
              height / 2;

          }
        );


        resize();

        targetMouseX =
          width / 2;

        targetMouseY =
          height / 2;

        mouseX =
          width / 2;

        mouseY =
          height / 2;

        initialize();

        animate();


        window.addEventListener(
          "pagehide",
          () => {
            cancelAnimationFrame(
              animationFrame
            );
          }
        );
      }
    }
  </script>

</Layout>

