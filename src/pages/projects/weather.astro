  .daily-row {
    min-height: 75px;
    padding: 13px 20px;

    display: grid;
    grid-template-columns: 95px 50px 1fr auto;
    align-items: center;
    gap: 18px;

    border-bottom: 1px solid #edf2f7;
  }

  .daily-row:last-child {
    border-bottom: 0;
  }

  .daily-row:hover {
    background: var(--blue-soft);
  }

  .daily-day {
    color: var(--black);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .daily-icon {
    font-size: 1.45rem;
  }

  .daily-condition {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .daily-temperatures {
    min-width: 105px;

    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .daily-high {
    color: var(--black);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .daily-low {
    color: #93a1b1;
    font-size: 0.8rem;
  }

  /* ==========================================================
     DETAILS
  ========================================================== */

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .detail-card {
    min-height: 150px;

    padding: 20px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    border: 1px solid var(--border);
    border-radius: 9px;

    background: rgba(255, 255, 255, 0.8);

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .detail-card:hover {
    transform: translateY(-3px);
    border-color: rgba(22, 135, 255, 0.35);
    box-shadow: 0 12px 30px rgba(22, 135, 255, 0.06);
  }

  .detail-icon {
    color: var(--blue);
    font-size: 1.25rem;
  }

  .detail-content {
    margin-top: 12px;

    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .detail-content span {
    color: var(--muted);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.57rem;
    letter-spacing: 0.11em;
  }

  .detail-content strong {
    color: var(--black);
    font-size: 1rem;
    font-weight: 600;
  }

  .detail-card small {
    color: #9aa8b8;
    font-size: 0.64rem;
  }

  /* ==========================================================
     DATA SOURCE
  ========================================================== */

  .data-source {
    margin-top: 75px;
  }

  .source-line {
    width: 100%;
    height: 1px;
    background: var(--border);
  }

  .source-content {
    padding-top: 15px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #8a99aa;

    font-family:
      ui-monospace,
