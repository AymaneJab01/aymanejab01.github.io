  </div>
</main>

<script>
  type WeatherCurrent = {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    wind_speed_10m: number;
    surface_pressure: number;
    visibility: number;
    weather_code: number;
  };

  type WeatherHourly = {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  };

  type WeatherDaily = {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  };

  type WeatherResponse = {
    current: WeatherCurrent;
    hourly: WeatherHourly;
    daily: WeatherDaily;
  };

  type ClientLocation = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  const clientLocations: Record<string, ClientLocation> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },
    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },
    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let selectedLocation = "Alcoi";
  let weatherData: WeatherResponse | null = null;
  let hourlyStartIndex = 0;

  function getElement<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function updateElement(id: string, value: string): void {
    const element = getElement(id);

    if (element) {
      element.textContent = value;
    }
  }

  function getWeatherIcon(code: number, isNight = false): string {
    if (isNight) {
      if (code === 0) return "☾";
      if (code === 1 || code === 2 || code === 3) return "☁";
    }

    if (code === 0) return "☀";
    if (code === 1) return "◐";
    if (code === 2) return "◒";
    if (code === 3) return "☁";
    if (code === 45 || code === 48) return "≋";
    if (code >= 51 && code <= 57) return "☂";
    if (code >= 61 && code <= 67) return "☂";
    if (code >= 71 && code <= 77) return "❄";
    if (code >= 80 && code <= 82) return "☂";
    if (code >= 85 && code <= 86) return "❄";
    if (code >= 95 && code <= 99) return "ϟ";

    return "☀";
  }

  function getWeatherDescription(code: number): string {
    if (code === 0) return "Clear sky";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Overcast";
    if (code === 45 || code === 48) return "Fog";
    if (code >= 51 && code <= 57) return "Drizzle";
    if (code >= 61 && code <= 67) return "Rain";
    if (code >= 71 && code <= 77) return "Snow";
    if (code >= 80 && code <= 82) return "Rain showers";
    if (code >= 85 && code <= 86) return "Snow showers";
    if (code >= 95 && code <= 99) return "Thunderstorm";

    return "Unknown conditions";
  }

  function formatHour(value: string): string {
    const date = new Date(value);

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  function formatDay(value: string, index: number): string {
    if (index === 0) return "Today";

    const date = new Date(`${value}T12:00:00`);

    return date.toLocaleDateString("en-GB", {
      weekday: "short",
    });
  }

  function formatUpdatedTime(): string {
    return new Date().toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  function getIsNight(
    sunrise: string,
    sunset: string,
  ): boolean {
    const now = Date.now();
    const rise = new Date(sunrise).getTime();
    const set = new Date(sunset).getTime();

    return now < rise || now > set;
  }

  function renderCurrent(data: WeatherResponse): void {
    const location = clientLocations[selectedLocation];

    if (!location) return;

    const current = data.current;
    const sunrise = data.daily.sunrise[0];
    const sunset = data.daily.sunset[0];

    updateElement("location-name", location.name);
    updateElement("location-region", location.region);
    updateElement("footer-location", location.name);

    updateElement(
      "temperature",
      `${Math.round(current.temperature_2m)}°`,
    );

    updateElement(
      "feels-like",
      `${Math.round(current.apparent_temperature)}°`,
    );

    updateElement(
      "feels-detail",
      `${Math.round(current.apparent_temperature)}°C`,
    );

    updateElement(
      "description",
      getWeatherDescription(current.weather_code),
    );

    updateElement(
      "weather-icon",
      getWeatherIcon(
        current.weather_code,
        getIsNight(sunrise, sunset),
      ),
    );

    const humidity = Math.round(
      current.relative_humidity_2m,
    );

    updateElement("humidity", `${humidity}%`);
    updateElement("hero-humidity", `${humidity}%`);

    const wind = Math.round(current.wind_speed_10m);

    updateElement("wind", `${wind} km/h`);
    updateElement("wind-detail", `${wind} km/h`);

    const pressure = Math.round(current.surface_pressure);

    updateElement("pressure", `${pressure} hPa`);
    updateElement("pressure-detail", `${pressure} hPa`);

    const visibilityKm = current.visibility / 1000;
    const visibility = `${Math.round(visibilityKm)} km`;

    updateElement("visibility", visibility);
    updateElement("visibility-card", visibility);
    updateElement("visibility-detail", visibility);

    updateElement(
      "rain-detail",
      `${data.daily.precipitation_probability_max[0] ?? 0}%`,
    );

    updateElement("sunrise", formatHour(sunrise));
    updateElement("sunset", formatHour(sunset));
    updateElement("last-updated", formatUpdatedTime());
  }

  function createHourlyCard(
    data: WeatherResponse,
    index: number,
    isCurrent: boolean,
  ): HTMLElement {
    const card = document.createElement("article");

    card.className = isCurrent
      ? "hour-card current"
      : "hour-card";

    const time = data.hourly.time[index] ?? "";
    const temperature = data.hourly.temperature_2m[index] ?? 0;
    const rain =
      data.hourly.precipitation_probability[index] ?? 0;
    const code = data.hourly.weather_code[index] ?? 0;

    card.innerHTML = `
      <span class="hour-time">
        ${isCurrent ? "NOW" : formatHour(time)}
      </span>

      <span class="hour-icon">
        ${getWeatherIcon(code)}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;

    return card;
  }

  function renderHourly(
    data: WeatherResponse,
    requestedStart?: number,
  ): void {
    const container =
      getElement<HTMLDivElement>("hourly-container");

    if (!container) return;

    let startIndex = requestedStart;

    if (startIndex === undefined) {
      const now = Date.now();

      startIndex = data.hourly.time.findIndex(
        (time) => new Date(time).getTime() >= now,
      );

      if (startIndex < 0) {
        startIndex = 0;
      }
    }

    hourlyStartIndex = startIndex;

    const endIndex = Math.min(
      startIndex + 12,
      data.hourly.time.length,
    );

    container.innerHTML = "";

    for (let i = startIndex; i < endIndex; i += 1) {
      container.appendChild(
        createHourlyCard(
          data,
          i,
          i === startIndex,
        ),
      );
    }
  }

  function renderDaily(data: WeatherResponse): void {
    const container =
      getElement<HTMLDivElement>("daily-container");

    if (!container) return;

    container.innerHTML = "";

    const days = Math.min(
      data.daily.time.length,
      7,
    );

    for (let i = 0; i < days; i += 1) {
      const code =
        data.daily.weather_code[i] ?? 0;

      const high =
        data.daily.temperature_2m_max[i] ?? 0;

      const low =
        data.daily.temperature_2m_min[i] ?? 0;

      const rain =
        data.daily.precipitation_probability_max[i] ?? 0;

      const row = document.createElement("article");

      row.className = "daily-row";

      row.innerHTML = `
        <div class="daily-day">
          <strong>
            ${formatDay(data.daily.time[i] ?? "", i)}
          </strong>

          <span>
            ${data.daily.time[i] ?? ""}
          </span>
        </div>

        <div class="daily-icon">
          ${getWeatherIcon(code)}
        </div>

        <div class="daily-condition">
          <strong>
            ${getWeatherDescription(code)}
          </strong>

          <span>
            ${rain}% precipitation
          </span>
        </div>

        <div class="daily-temperatures">
          <strong>${Math.round(high)}°</strong>
          <span>${Math.round(low)}°</span>
        </div>
      `;

      container.appendChild(row);
    }
  }

  function setLoadingState(): void {
    updateElement("header-status", "Loading...");
    updateElement("description", "Loading weather...");
  }

  function setErrorState(): void {
    updateElement("header-status", "Offline");
    updateElement(
      "description",
      "Unable to load weather data.",
    );
    updateElement("last-updated", "Error");
  }

  async function fetchWeather(
    location: ClientLocation,
  ): Promise<WeatherResponse> {
    const params = new URLSearchParams({
      latitude: String(location.latitude),
      longitude: String(location.longitude),
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,surface_pressure,visibility,weather_code",
      hourly:
        "temperature_2m,precipitation_probability,weather_code",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset",
      timezone: "auto",
      forecast_days: "7",
    });

    const response = await fetch(
      `https://api.open-meteo.com/v1/forecast?${params.toString()}`,
    );

    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`,
      );
    }

    return (await response.json()) as WeatherResponse;
  }

  async function loadWeather(
    locationName: string,
  ): Promise<void> {
    const location =
      clientLocations[locationName];

    if (!location) return;

    selectedLocation = locationName;

    setLoadingState();

    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-tab",
      )
      .forEach((button) => {
        button.classList.toggle(
          "active",
          button.dataset.location === locationName,
        );
      });

    try {
      const response = await fetchWeather(location);

      weatherData = response;

      renderCurrent(response);
      renderHourly(response);
      renderDaily(response);

      updateElement("header-status", "Live data");
    } catch (error) {
      console.error("Weather error:", error);
      setErrorState();
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-tab",
    )
    .forEach((button) => {
      button.addEventListener("click", () => {
        const locationName =
          button.dataset.location;

        if (locationName) {
          loadWeather(locationName);
        }
      });
    });

  getElement<HTMLButtonElement>(
    "hourly-prev",
  )?.addEventListener("click", () => {
    if (!weatherData) return;

    hourlyStartIndex = Math.max(
      0,
      hourlyStartIndex - 6,
    );

    renderHourly(
      weatherData,
      hourlyStartIndex,
    );
  });

  getElement<HTMLButtonElement>(
    "hourly-next",
  )?.addEventListener("click", () => {
    if (!weatherData) return;

    const maxStart = Math.max(
      0,
      weatherData.hourly.time.length - 12,
    );

    hourlyStartIndex = Math.min(
      maxStart,
      hourlyStartIndex + 6,
    );

    renderHourly(
      weatherData,
      hourlyStartIndex,
    );
  });

  loadWeather("Alcoi");
</script>

<style>
  :global(html) {
    background: #080a0d;
    color-scheme: dark;
  }

  :global(body) {
    margin: 0;
    background: #080a0d;
    color: #f4f7fb;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .weather-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(30, 144, 255, 0.13),
        transparent 35rem
      ),
      radial-gradient(
        circle at 0% 50%,
        rgba(0, 119, 255, 0.04),
        transparent 30rem
      ),
      linear-gradient(
        180deg,
        #080a0d 0%,
        #0a0d11 100%
      );
  }

  .weather-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom: 1px solid
      rgba(255, 255, 255, 0.07);

    background:
      rgba(8, 10, 13, 0.82);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    width: min(
      calc(100% - 40px),
      1200px
    );

    min-height: 72px;
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    color: rgba(
      244,
      247,
      251,
      0.65
    );

    text-decoration: none;

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.1em;
    text-transform: uppercase;

    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #3da9ff;
  }

  .back-arrow {
    font-size: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 0.72rem;
    font-weight: 800;

    letter-spacing: 0.2em;
  }

  .brand-mark {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    border: 1px solid
      rgba(61, 169, 255, 0.55);

    border-radius: 7px;

    color: #3da9ff;

    font-size: 0.7rem;

    box-shadow:
      0 0 20px
      rgba(61, 169, 255, 0.12);
  }

  .header-live {
    display: flex;
    align-items: center;
    gap: 8px;

    color: rgba(
      244,
      247,
      251,
      0.42
    );

    font-size: 0.66rem;
  }

  .live-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #3da9ff;

    box-shadow:
      0 0 12px
      rgba(61, 169, 255, 0.9);

    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.45;
    }
  }

  .weather-container {
    width: min(
      calc(100% - 40px),
      1200px
    );

    margin-inline: auto;

    padding-top: 38px;
    padding-bottom: 80px;
  }

  .location-selector-heading {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-bottom: 12px;

    color: rgba(
      244,
      247,
      251,
      0.3
    );

    font-size: 0.58rem;
    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .location-selector-line {
    height: 1px;
    flex: 1;

    background:
      rgba(255, 255, 255, 0.06);
  }

  .location-tabs {
    display: grid;
    grid-template-columns:
      repeat(3, 1fr);

    gap: 8px;
  }

  .location-tab {
    position: relative;

    min-height: 72px;

    padding: 15px 18px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    gap: 5px;

    border: 1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.025);

    color: #f4f7fb;

    cursor: pointer;
    text-align: left;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
