  .forecast-container { margin-top: 26px; overflow: hidden; border: 1px solid rgba(13,20,32,.13); border-radius: 24px; background: rgba(255,255,255,.84); box-shadow: 0 18px 42px rgba(15,42,76,.08), inset 0 1px rgba(255,255,255,.8); }
  .forecast-item + .forecast-item { border-top: 1px solid var(--border); }
  .forecast-summary { display: grid; grid-template-columns: 104px minmax(180px,1.2fr) 86px minmax(210px,1fr) 22px; align-items: center; gap: 20px; width: 100%; min-height: 88px; padding: 17px 24px; border: 0; color: var(--ink); background: transparent; font: inherit; text-align: left; cursor: pointer; transition: background .2s ease; }
