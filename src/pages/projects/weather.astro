<!-- ============================================================= -->

<!-- WEATHER LOGIC -->

<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  const descriptions: Record<number, string> = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Light rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Light snow",
    73: "Moderate snow",
    75: "Heavy snow",
    77: "Snow grains",
    80: "Light rain showers",
    81: "Moderate rain showers",
    82: "Heavy rain showers",
    85: "Light snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with hail",
    99: "Thunderstorm with heavy hail",
  };


  const getDescription = (
    code: number
  ): string => {
    return descriptions[code] ?? "Unknown conditions";
  };


  const getIcon = (
    code: number
  ): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 86) {
      return "🌦️";
    }

    return "⛈️";
  };


  const formatDay = (
    dateString: string
  ): string => {

    return new Date(
      `${dateString}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );
  };


  const buildWeatherUrl = (
    latitude: string,
    longitude: string
  ): string => {

    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${encodeURIComponent(latitude)}` +
      `&longitude=${encodeURIComponent(longitude)}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  };


  const loadWeather = async (
    card: HTMLElement
  ): Promise<void> => {

    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }

    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );

      if (!response.ok) {
        throw new Error(
          "Weather API request failed"
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      const current =
        data.current;


      const temperature =
        card.querySelector<HTMLElement>(
          ".weather-temperature"
        );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      const feels =
        card.querySelector<HTMLElement>(
          ".weather-feels"
        );

      const wind =
        card.querySelector<HTMLElement>(
          ".weather-wind"
        );

      const humidity =
        card.querySelector<HTMLElement>(
          ".weather-humidity"
        );

      const time =
        card.querySelector<HTMLElement>(
          ".weather-time"
        );

      const icon =
        card.querySelector<HTMLElement>(
          ".weather-icon"
        );


      if (temperature) {
        temperature.textContent =
          String(
            Math.round(
              current.temperature_2m
            )
          );
      }


      if (description) {
        description.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (feels) {
        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°C`;
      }


      if (wind) {
        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (humidity) {
        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (time) {
        time.textContent =
          new Date(
            current.time
          ).toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit",
            }
          );
      }


      if (icon) {
        icon.textContent =
          getIcon(
            current.weather_code
          );
      }

    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      if (description) {
        description.textContent =
          "Unable to load weather";
      }
    }
  };


  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );


  weatherCards.forEach(
    (card) => {
      void loadWeather(card);
    }
  );


  /* ============================================================= */
  /* FORECAST */
  /* ============================================================= */

  const forecastContainer =
    document.querySelector<HTMLElement>(
      "#forecast-container"
    );


  const forecastButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );


  const loadForecast = async (
    latitude: string,
    longitude: string
  ): Promise<void> => {

    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML =
      `<div class="forecast-loading">
        Loading forecast...
      </div>`;


    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          "Forecast API request failed"
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const daily =
        data.daily;


      forecastContainer.innerHTML = "";


      daily.time.forEach(
        (
          date,
          index
        ) => {

          const item =
            document.createElement(
              "article"
            );

          item.className =
            "forecast-item";


          const day =
            document.createElement(
              "span"
            );

          day.className =
            "forecast-day";

          day.textContent =
            index === 0
              ? "Today"
              : formatDay(date);


          const icon =
            document.createElement(
              "span"
            );

          icon.className =
            "forecast-icon";

          icon.textContent =
            getIcon(
              daily.weather_code[index]
            );


          const maximum =
            document.createElement(
              "strong"
            );

          maximum.textContent =
            `${Math.round(
              daily.temperature_2m_max[index]
            )}°`;


          const minimum =
            document.createElement(
              "span"
            );

          minimum.className =
            "forecast-min";

          minimum.textContent =
            `${Math.round(
              daily.temperature_2m_min[index]
            )}°`;


          const temperatures =
            document.createElement(
              "div"
            );

          temperatures.className =
            "forecast-temperatures";


          temperatures.append(
            maximum,
            minimum
          );


          item.append(
            day,
            icon,
            temperatures
          );


          forecastContainer.appendChild(
            item
          );
        }
      );

    } catch (error) {

      console.error(
        "Forecast loading error:",
        error
      );

      forecastContainer.innerHTML =
        `<div class="forecast-loading">
          Unable to load forecast.
        </div>`;
    }
  };


  const defaultForecast =
    forecastButtons[0]?.dataset
      .forecastLocation;


  if (defaultForecast) {

    const [
      latitude,
      longitude
    ] =
      defaultForecast.split(",");


    if (latitude && longitude) {
      void loadForecast(
        latitude,
        longitude
      );
    }
  }


  forecastButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          forecastButtons.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          button.classList.add(
            "active"
          );


          const location =
            button.dataset
              .forecastLocation;


          if (!location) {
            return;
          }


          const [
            latitude,
            longitude
          ] =
            location.split(",");


          if (
            !latitude ||
            !longitude
          ) {
            return;
          }


          void loadForecast(
            latitude,
            longitude
          );
        }
      );
    }
  );
</script>

<!-- ============================================================= -->

<!-- INTERACTIVE CANVAS -->

<!-- ============================================================= -->

<script>
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        opacity: number;
      }


      const particles: Particle[] = [];

      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;


      const getParticleCount =
        (): number =>
          window.innerWidth < 768
            ? 30
            : 60;


      let particleCount =
        getParticleCount();


      const resize = (): void => {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;

        height =
          window.innerHeight;


        canvas.width =
          width * ratio;

        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;

        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particleCount =
          getParticleCount();
      };


      const createParticle =
        (): Particle => ({
          x:
            Math.random() *
            width,

          y:
            Math.random() *
            height,

          vx:
            (Math.random() - 0.5) *
            0.08,

          vy:
            (Math.random() - 0.5) *
            0.08,

          size:
            Math.random() *
            1.4 +
            0.4,

          opacity:
            Math.random() *
            0.18 +
            0.04,
        });


      const initialize =
        (): void => {

          particles.length = 0;

          for (
            let i = 0;
            i < particleCount;
            i += 1
          ) {
            particles.push(
              createParticle()
            );
          }
        };


      const drawConnections =
        (): void => {

          const maxDistance = 130;

          for (
            let i = 0;
            i < particles.length;
            i += 1
          ) {

            for (
              let j = i + 1;
              j < particles.length;
              j += 1
            ) {

              const first =
                particles[i];

              const second =
                particles[j];


              if (!first || !second) {
                continue;
              }


              const dx =
                first.x -
                second.x;

              const dy =
                first.y -
                second.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (1 -
                    distance /
                      maxDistance) *
                  0.08;


                context.beginPath();

                context.moveTo(
                  first.x,
                  first.y
                );

                context.lineTo(
                  second.x,
                  second.y
                );


                context.strokeStyle =
                  `rgba(0, 153, 255, ${opacity})`;

                context.lineWidth = 1;

                context.stroke();
              }
            }
          }
        };


      const drawParticles =
        (): void => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;

            particle.y +=
              particle.vy;


            if (
              particle.x <
              -10
            ) {
              particle.x =
                width + 10;
            }


            if (
              particle.x >
              width + 10
            ) {
              particle.x = -10;
            }


            if (
              particle.y <
              -10
            ) {
              particle.y =
                height + 10;
            }


            if (
              particle.y >
              height + 10
            ) {
              particle.y = -10;
            }


            const dx =
              targetMouseX -
              particle.x;

            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              180
            ) {

              const force =
                (1 -
                  distance /
                    180) *
                0.003;


              particle.vx +=
                dx * force;

              particle.vy +=
                dy * force;
            }


            particle.vx *=
              0.995;

            particle.vy *=
              0.995;


            context.beginPath();

            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(0, 153, 255, ${particle.opacity})`;

            context.fill();
          }
        };


      const drawGlow =
        (): void => {

          const gradient =
            context.createRadialGradient(
              targetMouseX,
              targetMouseY,
              0,
              targetMouseX,
              targetMouseY,
              260
            );


          gradient.addColorStop(
            0,
            "rgba(0,153,255,0.055)"
          );

          gradient.addColorStop(
            0.45,
            "rgba(0,153,255,0.018)"
          );

          gradient.addColorStop(
            1,
            "rgba(0,153,255,0)"
          );


          context.fillStyle =
            gradient;

          context.fillRect(
            0,
            0,
            width,
            height
          );
        };


      const animate =
        (): void => {

          mouseX +=
            (targetMouseX -
              mouseX) *
            0.04;

          mouseY +=
            (targetMouseY -
              mouseY) *
            0.04;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawGlow();

          drawConnections();

          drawParticles();


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


      const handleResize =
        (): void => {

          resize();

          initialize();
        };


      const handleMouseMove =
        (
          event: MouseEvent
        ): void => {

          targetMouseX =
            event.clientX;

          targetMouseY =
            event.clientY;
        };


      const handleMouseLeave =
        (): void => {

          targetMouseX =
            width / 2;

          targetMouseY =
            height / 2;
        };


      window.addEventListener(
        "resize",
        handleResize
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      resize();


      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;

      mouseX =
        width / 2;

      mouseY =
        height / 2;


      initialize();


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {

        animationFrame =
          requestAnimationFrame(
            animate
          );

      } else {

        drawParticles();
      }


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            handleResize
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>

