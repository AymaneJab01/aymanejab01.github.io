interface WeatherLocation {
  name: string;
  region: string;
  latitude: number;
  longitude: number;
}

const locations: Record<string, WeatherLocation> = {
  Alcoi: {
    name: "Alcoi",
    region: "Alicante, España",
    latitude: 38.6986,
    longitude: -0.4731,
  },

  Torrevieja: {
    name: "Torrevieja",
    region: "Alicante, España",
    latitude: 37.978,
    longitude: -0.682,
  },

  Valencia: {
    name: "Valencia",
    region: "Valencia, España",
    latitude: 39.4699,
    longitude: -0.3763,
  },
};

const defaultLocation = "Alcoi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Weather | Aymane Jabrane</title>

    <meta
      name="description"
      content="Weather dashboard for Alcoi, Torrevieja and Valencia."
    />
  </head>

  <body>
    <main class="weather-page">

      <!-- ===================================================== -->
      <!-- TOP NAVIGATION -->
      <!-- ===================================================== -->

      <header class="weather-header">
        <div class="header-inner">

          <a href="/" class="brand">
            <span class="brand-mark">AJ</span>

            <span class="brand-text">
              <strong>AYMANE JABRANE</strong>
              <small>WEATHER SYSTEM</small>
            </span>
          </a>

          <nav class="main-nav" aria-label="Weather navigation">
            <button class="nav-item active" type="button">
              Today
            </button>

            <button class="nav-item" type="button" id="nav-hourly">
              Hourly
            </button>

            <button class="nav-item" type="button" id="nav-daily">
              7 Days
            </button>
          </nav>

          <a href="/" class="portfolio-link">
            ← Portfolio
          </a>

        </div>
      </header>


      <!-- ===================================================== -->
      <!-- LOCATION BAR -->
      <!-- ===================================================== -->

      <div class="location-bar">
        <div class="content-width location-bar-inner">

          <div class="location-selector">
            <span class="location-pin">⌖</span>

            <div>
              <span class="location-label">LOCATION</span>

              <strong id="location-name-top">
                Alcoi
              </strong>
            </div>
          </div>

          <div class="live-indicator">
            <span class="live-dot"></span>
            <span id="header-status">LIVE DATA</span>
          </div>

        </div>
      </div>


      <!-- ===================================================== -->
      <!-- LOCATION SELECTOR -->
      <!-- ===================================================== -->

      <section class="locations-section content-width">

        <div class="locations-heading">
          <div>
            <span class="section-kicker">YOUR LOCATIONS</span>

            <h2>
              Weather overview
            </h2>
          </div>
        </div>

        <div class="location-tabs" aria-label="Weather locations">

          {
            Object.values(locations).map((location) => (
              <button
                class:list={[
                  "location-tab",
                  location.name === defaultLocation && "active",
                ]}
                data-location={location.name}
                type="button"
              >
                <span class="location-tab-name">
                  {location.name}
                </span>

                <span class="location-tab-region">
                  {location.region}
                </span>

                <span class="location-tab-arrow">
                  →
                </span>
              </button>
            ))
          }

        </div>

      </section>


      <!-- ===================================================== -->
      <!-- MAIN WEATHER -->
      <!-- ===================================================== -->

      <section class="content-width weather-main">

        <div class="weather-heading">

          <div>
            <span class="section-kicker">
              CURRENT CONDITIONS
            </span>

            <h1 id="location-name">
              Alcoi
            </h1>

            <p id="location-region">
              Alicante, España
            </p>
          </div>

          <div class="updated-block">
            <span>UPDATED</span>

            <strong id="last-updated">
              —
            </strong>
          </div>

        </div>


        <!-- ================================================= -->
        <!-- HERO WEATHER CARD -->
        <!-- ================================================= -->

        <article class="current-weather-card">

          <div class="current-glow"></div>

          <div class="current-left">

            <div class="weather-condition-icon" id="weather-icon">
              ☀️
            </div>

            <div class="current-temperature">
              <span id="temperature">
                —
              </span>

              <sup>°C</sup>
            </div>

            <div class="current-condition">

              <h2 id="description">
                Loading...
              </h2>

              <p>
                Feels like
                <strong id="feels-like">—°</strong>
              </p>

              <p>
                Humidity
                <strong id="hero-humidity">—%</strong>
              </p>

            </div>

          </div>


          <div class="current-right">

            <div class="hero-stat">
              <span>HIGH</span>
              <strong id="today-high">—°</strong>
            </div>

            <div class="hero-stat">
              <span>LOW</span>
              <strong id="today-low">—°</strong>
            </div>

            <div class="hero-stat">
              <span>RAIN</span>
              <strong id="hero-rain">—%</strong>
            </div>

          </div>

        </article>


        <!-- ================================================= -->
        <!-- QUICK DATA -->
        <!-- ================================================= -->

        <section class="quick-data">

          <div class="quick-data-heading">
            <span class="section-kicker">
              TODAY'S CONDITIONS
            </span>

            <span class="data-line"></span>
          </div>

          <div class="metrics-grid">

            <article class="metric-card">
              <span class="metric-icon">↗</span>

              <div>
                <span>WIND</span>
                <strong id="wind">— km/h</strong>
              </div>
            </article>


            <article class="metric-card">
              <span class="metric-icon">◌</span>

              <div>
                <span>HUMIDITY</span>
                <strong id="humidity">—%</strong>
              </div>
            </article>


            <article class="metric-card">
              <span class="metric-icon">◎</span>

              <div>
                <span>PRESSURE</span>
                <strong id="pressure">— hPa</strong>
              </div>
            </article>


            <article class="metric-card">
              <span class="metric-icon">◉</span>

              <div>
                <span>VISIBILITY</span>
                <strong id="visibility">— km</strong>
              </div>
            </article>


            <article class="metric-card">
              <span class="metric-icon">◇</span>

              <div>
                <span>FEELS LIKE</span>
                <strong id="feels-detail">—°C</strong>
              </div>
            </article>


            <article class="metric-card">
              <span class="metric-icon">△</span>

              <div>
                <span>RAIN CHANCE</span>
                <strong id="rain-detail">—%</strong>
              </div>
            </article>

          </div>

        </section>


        <!-- ================================================= -->
        <!-- HOURLY -->
        <!-- ================================================= -->

        <section
          class="forecast-section"
          id="hourly-section"
        >

          <div class="forecast-heading">

            <div>
              <span class="section-kicker">
                HOURLY FORECAST
              </span>

              <h2>
                Next 24 hours
              </h2>
            </div>

            <div class="forecast-controls">

              <button
                class="forecast-arrow"
                id="hourly-prev"
                type="button"
                aria-label="Previous hours"
              >
                ←
              </button>

              <button
                class="forecast-arrow"
                id="hourly-next"
                type="button"
                aria-label="Next hours"
              >
                →
              </button>

            </div>

          </div>


          <div class="hourly-frame">

            <div
              class="hourly-container"
              id="hourly-container"
            ></div>

          </div>

        </section>


        <!-- ================================================= -->
        <!-- DAILY -->
        <!-- ================================================= -->

        <section
          class="forecast-section"
          id="daily-section"
        >

          <div class="forecast-heading">

            <div>
              <span class="section-kicker">
                EXTENDED FORECAST
              </span>

              <h2>
                Next 7 days
              </h2>
            </div>

          </div>


          <div
            class="daily-container"
            id="daily-container"
          ></div>

        </section>


        <!-- ================================================= -->
        <!-- SUN -->
        <!-- ================================================= -->

        <section class="sun-section">

          <div class="forecast-heading">

            <div>
              <span class="section-kicker">
                SOLAR DATA
              </span>

              <h2>
                Sun today
              </h2>
            </div>
          </div>


          <div class="sun-card">

            <div class="sun-time">
              <span>SUNRISE</span>
              <strong id="sunrise">—</strong>
            </div>

            <div class="sun-trajectory">

              <div class="sun-trajectory-line"></div>

              <div class="sun-position"></div>

            </div>

            <div class="sun-time right">
              <span>SUNSET</span>
              <strong id="sunset">—</strong>
            </div>

          </div>

        </section>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <footer class="weather-footer">

          <div class="footer-brand">
            <span class="footer-mark">AJ</span>

            <div>
              <strong>WEATHER SYSTEM</strong>

              <span>
                Data powered by Open-Meteo
              </span>
            </div>
          </div>

          <div class="footer-location">
            <span>ACTIVE LOCATION</span>
            <strong id="footer-location">
              Alcoi
            </strong>
          </div>

        </footer>

      </section>

    </main>
  </body>
</html>


<script>
  type LocationData = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  type WeatherCurrent = {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    wind_speed_10m: number;
    surface_pressure: number;
    visibility: number;
    weather_code: number;
  };

  type WeatherHourly = {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  };

  type WeatherDaily = {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  };

  type WeatherResponse = {
    current: WeatherCurrent;
    hourly: WeatherHourly;
    daily: WeatherDaily;
  };

  const locations: Record<string, LocationData> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let selectedLocation = "Alcoi";
  let weatherData: WeatherResponse | null = null;
  let hourlyStartIndex = 0;


  /* ========================================================= */
  /* DOM HELPERS */
  /* ========================================================= */

  function getElement<T extends HTMLElement>(
    id: string,
  ): T | null {
    return document.getElementById(id) as T | null;
  }


  function updateElement(
    id: string,
    value: string,
  ): void {
    const element = document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }


  /* ========================================================= */
  /* WEATHER ICONS */
  /* ========================================================= */

  function getWeatherIcon(
    code: number,
    isNight = false,
  ): string {

    if (isNight) {
      if (code === 0) return "☾";
      if (code >= 1 && code <= 3) return "☁";
    }

    if (code === 0) return "☀";

    if (code === 1) return "◐";

    if (code === 2) return "◑";

    if (code === 3) return "☁";

    if (code === 45 || code === 48) {
      return "≋";
    }

    if (code >= 51 && code <= 57) {
      return "☂";
    }

    if (code >= 61 && code <= 67) {
      return "☂";
    }

    if (code >= 71 && code <= 77) {
      return "❄";
    }

    if (code >= 80 && code <= 82) {
      return "☂";
    }

    if (code >= 85 && code <= 86) {
      return "❄";
    }

    if (code >= 95 && code <= 99) {
      return "ϟ";
    }

    return "☀";
  }


  /* ========================================================= */
  /* WEATHER DESCRIPTION */
  /* ========================================================= */

  function getWeatherDescription(
    code: number,
  ): string {

    if (code === 0) return "Clear sky";

    if (code === 1) return "Mainly clear";

    if (code === 2) return "Partly cloudy";

    if (code === 3) return "Overcast";

    if (code === 45 || code === 48) {
      return "Fog";
    }

    if (code >= 51 && code <= 57) {
      return "Drizzle";
    }

    if (code >= 61 && code <= 67) {
      return "Rain";
    }

    if (code >= 71 && code <= 77) {
      return "Snow";
    }

    if (code >= 80 && code <= 82) {
      return "Rain showers";
    }

    if (code >= 85 && code <= 86) {
      return "Snow showers";
    }

    if (code >= 95 && code <= 99) {
      return "Thunderstorm";
    }

    return "Unknown";
  }


  /* ========================================================= */
  /* DATE HELPERS */
  /* ========================================================= */

  function formatHour(
    value: string,
  ): string {

    const date = new Date(value);

    return date.toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }


  function formatDay(
    value: string,
    index: number,
  ): string {

    if (index === 0) {
      return "Today";
    }

    const date =
      new Date(`${value}T12:00:00`);

    return date.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      },
    );
  }


  function formatDateTime(): string {

    return new Date().toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }


  function getIsNight(
    time: string,
    sunrise: string,
    sunset: string,
  ): boolean {

    const current =
      new Date(time).getTime();

    const rise =
      new Date(sunrise).getTime();

    const set =
      new Date(sunset).getTime();

    return current < rise || current > set;
  }


  /* ========================================================= */
  /* CURRENT WEATHER */
  /* ========================================================= */

  function renderCurrent(
    data: WeatherResponse,
  ): void {

    const location =
      locations[selectedLocation];

    const current =
      data.current;

    const todaySunrise =
      data.daily.sunrise[0];

    const todaySunset =
      data.daily.sunset[0];

    const isNight =
      getIsNight(
        new Date().toISOString(),
        todaySunrise,
        todaySunset,
      );


    updateElement(
      "location-name",
      location.name,
    );

    updateElement(
      "location-name-top",
      location.name,
    );

    updateElement(
      "location-region",
      location.region,
    );

    updateElement(
      "footer-location",
      location.name,
    );


    updateElement(
      "temperature",
      `${Math.round(current.temperature_2m)}`,
    );


    updateElement(
      "feels-like",
      `${Math.round(current.apparent_temperature)}°`,
    );


    updateElement(
      "feels-detail",
      `${Math.round(current.apparent_temperature)}°C`,
    );


    updateElement(
      "description",
      getWeatherDescription(
        current.weather_code,
      ),
    );


    updateElement(
      "weather-icon",
      getWeatherIcon(
        current.weather_code,
        isNight,
      ),
    );


    updateElement(
      "humidity",
      `${Math.round(current.relative_humidity_2m)}%`,
    );


    updateElement(
      "hero-humidity",
      `${Math.round(current.relative_humidity_2m)}%`,
    );


    updateElement(
      "wind",
      `${Math.round(current.wind_speed_10m)} km/h`,
    );


    updateElement(
      "pressure",
      `${Math.round(current.surface_pressure)} hPa`,
    );


    updateElement(
      "visibility",
      `${Math.round(current.visibility / 1000)} km`,
    );


    updateElement(
      "rain-detail",
      `${data.daily.precipitation_probability_max[0] ?? 0}%`,
    );


    updateElement(
      "hero-rain",
      `${data.daily.precipitation_probability_max[0] ?? 0}%`,
    );


    updateElement(
      "today-high",
      `${Math.round(data.daily.temperature_2m_max[0] ?? 0)}°`,
    );


    updateElement(
      "today-low",
      `${Math.round(data.daily.temperature_2m_min[0] ?? 0)}°`,
    );


    updateElement(
      "sunrise",
      formatHour(todaySunrise),
    );


    updateElement(
      "sunset",
      formatHour(todaySunset),
    );


    updateElement(
      "last-updated",
      formatDateTime(),
    );
  }


  /* ========================================================= */
  /* HOURLY FORECAST */
  /* ========================================================= */

  function renderHourly(
    data: WeatherResponse,
  ): void {

    const container =
      getElement<HTMLDivElement>(
        "hourly-container",
      );

    if (!container) return;


    const now =
      new Date();

    let startIndex =
      data.hourly.time.findIndex(
        (time) =>
          new Date(time) >= now,
      );


    if (startIndex < 0) {
      startIndex = 0;
    }


    hourlyStartIndex =
      Math.max(0, startIndex);


    renderHourlyWindow(
      data,
      hourlyStartIndex,
    );
  }


  function renderHourlyWindow(
    data: WeatherResponse,
    startIndex: number,
  ): void {

    const container =
      getElement<HTMLDivElement>(
        "hourly-container",
      );

    if (!container) return;


    container.innerHTML = "";


    const endIndex =
      Math.min(
        startIndex + 12,
        data.hourly.time.length,
      );


    for (
      let i = startIndex;
      i < endIndex;
      i += 1
    ) {

      const time =
        data.hourly.time[i];

      const temperature =
        data.hourly.temperature_2m[i] ?? 0;

      const rain =
        data.hourly
          .precipitation_probability[i] ?? 0;

      const code =
        data.hourly.weather_code[i] ?? 0;


      const card =
        document.createElement(
          "article",
        );


      card.className =
        i === startIndex
          ? "hour-card current"
          : "hour-card";


      card.innerHTML = `
        <span class="hour-time">
          ${
            i === startIndex
              ? "NOW"
              : formatHour(time)
          }
        </span>

        <span class="hour-icon">
          ${getWeatherIcon(code)}
        </span>

        <strong class="hour-temperature">
          ${Math.round(temperature)}°
        </strong>

        <span class="hour-rain">
          ${rain}% rain
        </span>
      `;


      container.appendChild(card);
    }
  }


  /* ========================================================= */
  /* DAILY FORECAST */
  /* ========================================================= */

  function renderDaily(
    data: WeatherResponse,
  ): void {

    const container =
      getElement<HTMLDivElement>(
        "daily-container",
      );

    if (!container) return;


    container.innerHTML = "";


    const days =
      Math.min(
        data.daily.time.length,
        7,
      );


    for (
      let i = 0;
      i < days;
      i += 1
    ) {

      const code =
        data.daily.weather_code[i] ?? 0;

      const high =
        data.daily.temperature_2m_max[i] ?? 0;

      const low =
        data.daily.temperature_2m_min[i] ?? 0;

      const rain =
        data.daily
          .precipitation_probability_max[i] ?? 0;


      const row =
        document.createElement(
          "article",
        );


      row.className =
        i === 0
          ? "daily-row today"
          : "daily-row";


      row.innerHTML = `
        <div class="daily-day">
          <strong>
            ${formatDay(
              data.daily.time[i],
              i,
            )}
          </strong>

          <span>
            ${data.daily.time[i]}
          </span>
        </div>

        <div class="daily-icon">
          ${getWeatherIcon(code)}
        </div>

        <div class="daily-condition">
          <strong>
            ${getWeatherDescription(code)}
          </strong>

          <span>
            ${rain}% chance of rain
          </span>
        </div>

        <div class="daily-temperature">
          <strong>
            ${Math.round(high)}°
          </strong>

          <span>
            ${Math.round(low)}°
          </span>
        </div>
      `;


      container.appendChild(row);
    }
  }


  /* ========================================================= */
  /* LOADING / ERROR */
  /* ========================================================= */

  function setLoadingState(): void {

    updateElement(
      "header-status",
      "LOADING DATA",
    );

    updateElement(
      "description",
      "Loading weather...",
    );
  }


  function setErrorState(
    message: string,
  ): void {

    updateElement(
      "header-status",
      "OFFLINE",
    );

    updateElement(
      "description",
      message,
    );

    updateElement(
      "last-updated",
      "Error",
    );
  }


  /* ========================================================= */
  /* API */
  /* ========================================================= */

  async function fetchWeather(
    location: LocationData,
  ): Promise<WeatherResponse> {

    const url =
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${location.latitude}` +
      `&longitude=${location.longitude}` +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,surface_pressure,visibility,weather_code" +
      "&hourly=temperature_2m,precipitation_probability,weather_code" +
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset" +
      "&timezone=auto" +
      "&forecast_days=7";


    const response =
      await fetch(url);


    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`,
      );
    }


    return
      (await response.json()) as WeatherResponse;
  }


  /* ========================================================= */
  /* LOAD WEATHER */
  /* ========================================================= */

  async function loadWeather(
    locationName: string,
  ): Promise<void> {

    const location =
      locations[locationName];


    if (!location) return;


    selectedLocation =
      locationName;


    setLoadingState();


    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-tab",
      )
      .forEach((button) => {

        button.classList.toggle(
          "active",
          button.dataset.location ===
            locationName,
        );

      });


    try {

      const response =
        await fetchWeather(location);


      weatherData =
        response;


      renderCurrent(response);

      renderHourly(response);

      renderDaily(response);


      updateElement(
        "header-status",
        "LIVE DATA",
      );

    } catch (error) {

      console.error(error);

      setErrorState(
        "Unable to load weather data.",
      );
    }
  }


  /* ========================================================= */
  /* LOCATION BUTTONS */
  /* ========================================================= */

  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-tab",
    )
    .forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const locationName =
            button.dataset.location;


          if (!locationName) return;


          loadWeather(
            locationName,
          );
        },
      );
    });


  /* ========================================================= */
  /* HOURLY NAVIGATION */
  /* ========================================================= */

  getElement<HTMLButtonElement>(
    "hourly-prev",
  )?.addEventListener(
    "click",
    () => {

      if (!weatherData) return;


      hourlyStartIndex =
        Math.max(
          0,
          hourlyStartIndex - 6,
        );


      renderHourlyWindow(
        weatherData,
        hourlyStartIndex,
      );
    },
  );


  getElement<HTMLButtonElement>(
    "hourly-next",
  )?.addEventListener(
    "click",
    () => {

      if (!weatherData) return;


      const maxStart =
        Math.max(
          0,
          weatherData.hourly.time.length - 12,
        );


      hourlyStartIndex =
        Math.min(
          maxStart,
          hourlyStartIndex + 6,
        );


      renderHourlyWindow(
        weatherData,
        hourlyStartIndex,
      );
    },
  );


  /* ========================================================= */
  /* TOP NAVIGATION */
  /* ========================================================= */

  getElement<HTMLButtonElement>(
    "nav-hourly",
  )?.addEventListener(
    "click",
    () => {

      document
        .getElementById(
          "hourly-section",
        )
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
    },
  );


  getElement<HTMLButtonElement>(
    "nav-daily",
  )?.addEventListener(
    "click",
    () => {

      document
        .getElementById(
          "daily-section",
        )
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
    },
  );


  /* ========================================================= */
  /* START */
  /* ========================================================= */

  loadWeather("Alcoi");
</script>


<style>

  /* ========================================================= */
  /* VARIABLES */
  /* ========================================================= */

  :global(html) {
    background: #070b12;
    scroll-behavior: smooth;
  }


  :global(body) {
    margin: 0;
    background: #070b12;
    color: #f5f7fb;
  }


  :root {
    --blue: #1687ff;
    --blue-bright: #42a5ff;
    --blue-soft: rgba(22, 135, 255, 0.12);
    --blue-border: rgba(22, 135, 255, 0.35);

    --white: #f5f7fb;
    --muted: rgba(245, 247, 251, 0.55);
    --dim: rgba(245, 247, 251, 0.32);

    --background: #070b12;
    --surface: #0c121c;
    --surface-light: #101925;

    --border: rgba(255, 255, 255, 0.08);
  }


  /* ========================================================= */
  /* PAGE */
  /* ========================================================= */

  .weather-page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(22, 135, 255, 0.16),
        transparent 35rem
      ),
      radial-gradient(
        circle at 0% 45%,
        rgba(22, 135, 255, 0.05),
        transparent 30rem
      ),
      var(--background);

    color: var(--white);
  }


  .content-width {
    width: min(
      calc(100% - 40px),
      1180px
    );

    margin-inline: auto;
  }


  /* ========================================================= */
  /* HEADER */
  /* ========================================================= */

  .weather-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom:
      1px solid var(--border);

    background:
      rgba(7, 11, 18, 0.86);

    backdrop-filter:
      blur(20px);
  }


  .header-inner {
    width: min(
      calc(100% - 40px),
      1180px
    );

    min-height: 76px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
  }


  .brand {
    display: flex;
    align-items: center;

    gap: 12px;

    color: var(--white);

    text-decoration: none;
  }


  .brand-mark {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border:
      1px solid var(--blue-border);

    border-radius: 9px;

    background:
      rgba(22, 135, 255, 0.1);

    color: var(--blue-bright);

    font-size: 0.65rem;
    font-weight: 900;

    letter-spacing: -0.04em;
  }


  .brand-text {
    display: flex;
    flex-direction: column;

    gap: 3px;
  }


  .brand-text strong {
    font-size: 0.72rem;

    letter-spacing: 0.08em;
  }


  .brand-text small {
    color: var(--dim);

    font-size: 0.5rem;

    letter-spacing: 0.16em;
  }


  .main-nav {
    display: flex;
    align-items: center;

    gap: 4px;

    padding: 4px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.025);
  }


  .nav-item {
    border: 0;

    border-radius: 7px;

    padding:
      8px 15px;

    background: transparent;

    color: var(--muted);

    cursor: pointer;

    font-family: inherit;

    font-size: 0.68rem;

    font-weight: 700;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }


  .nav-item:hover,
  .nav-item.active {
    background:
      var(--blue-soft);

    color:
      var(--blue-bright);
  }


  .portfolio-link {
    color: var(--muted);

    text-decoration: none;

    font-size: 0.68rem;

    font-weight: 700;

    transition:
      color 0.2s ease;
  }


  .portfolio-link:hover {
    color: var(--blue-bright);
  }


  /* ========================================================= */
  /* LOCATION BAR */
  /* ========================================================= */

  .location-bar {
    border-bottom:
      1px solid var(--border);

    background:
      rgba(255, 255, 255, 0.015);
  }


  .location-bar-inner {
    min-height: 55px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  .location-selector {
    display: flex;
    align-items: center;

    gap: 10px;
  }


  .location-pin {
    color: var(--blue-bright);

    font-size: 1.15rem;
  }


  .location-selector > div {
    display: flex;
    flex-direction: column;

    gap: 2px;
  }


  .location-label,
  .live-indicator {
    color: var(--dim);

    font-size: 0.52rem;

    font-weight: 800;

    letter-spacing: 0.13em;
  }


  .location-selector strong {
    font-size: 0.72rem;
  }


  .live-indicator {
    display: flex;
    align-items: center;

    gap: 7px;

    color: var(--muted);
  }


  .live-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
      var(--blue-bright);

    box-shadow:
      0 0 12px
      rgba(66, 165, 255, 0.9);

    animation:
      pulse 2s infinite;
  }


  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.4;
    }
  }


  /* ========================================================= */
  /* LOCATIONS */
  /* ========================================================= */

  .locations-section {
    padding-top: 40px;
  }


  .locations-heading {
    margin-bottom: 16px;
  }


  .section-kicker {
    display: block;

    color: var(--blue-bright);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.18em;
  }


  .locations-heading h2 {
    margin: 7px 0 0;

    font-size: 1.35rem;

    letter-spacing: -0.04em;
  }


  .location-tabs {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 10px;
  }


  .location-tab {
    position: relative;

    min-height: 82px;

    padding: 17px;

    display: flex;
    flex-direction: column;

    align-items: flex-start;

    justify-content: center;

    border:
      1px solid var(--border);

    border-radius: 12px;

    background:
      rgba(255, 255, 255, 0.025);

    color: var(--white);

    cursor: pointer;

    font-family: inherit;

    text-align: left;

    overflow: hidden;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .location-tab::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 2px;

    background:
      var(--blue);

    opacity: 0;

    transition:
      opacity 0.2s ease;
  }


  .location-tab:hover {
    transform:
      translateY(-2px);

    border-color:
      var(--blue-border);
  }


  .location-tab.active {
    border-color:
      var(--blue-border);

    background:
      linear-gradient(
        135deg,
        rgba(22, 135, 255, 0.12),
        rgba(22, 135, 255, 0.025)
      );
  }


  .location-tab.active::before {
    opacity: 1;
  }


  .location-tab-name {
    font-size: 0.9rem;

    font-weight: 750;
  }


  .location-tab-region {
    margin-top: 4px;

    color: var(--dim);

    font-size: 0.58rem;
  }


  .location-tab-arrow {
    position: absolute;

    right: 17px;
    top: 50%;

    transform:
      translateY(-50%);

    color: var(--blue);

    font-size: 1rem;
  }


  /* ========================================================= */
  /* WEATHER MAIN */
  /* ========================================================= */

  .weather-main {
    padding-top: 55px;
    padding-bottom: 70px;
  }


  .weather-heading {
    display: flex;

    justify-content: space-between;

    align-items: flex-end;

    gap: 20px;
  }


  .weather-heading h1 {
    margin: 6px 0 0;

    font-size:
      clamp(2.8rem, 7vw, 5rem);

    line-height: 0.9;

    letter-spacing:
      -0.075em;
  }


  .weather-heading p {
    margin: 12px 0 0;

    color: var(--muted);

    font-size: 0.72rem;
  }


  .updated-block {
    display: flex;
    flex-direction: column;

    align-items: flex-end;

    gap: 5px;

    color: var(--dim);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.14em;
  }


  .updated-block strong {
    color: var(--muted);

    font-size: 0.68rem;

    letter-spacing: 0;
  }


  /* ========================================================= */
  /* HERO */
  /* ========================================================= */

  .current-weather-card {
    position: relative;

    min-height: 300px;

    margin-top: 35px;

    padding: 42px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      260px;

    align-items: center;

    gap: 30px;

    overflow: hidden;

    border:
      1px solid
      rgba(66, 165, 255, 0.25);

    border-radius: 20px;

    background:
      linear-gradient(
        135deg,
        #0e1826,
        #0a1019
      );

    box-shadow:
      0 25px 80px
      rgba(0, 0, 0, 0.25);
  }


  .current-glow {
    position: absolute;

    width: 400px;
    height: 400px;

    left: -150px;
    top: -180px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(22, 135, 255, 0.17),
        transparent 68%
      );

    pointer-events: none;
  }


  .current-left {
    position: relative;

    display: flex;

    align-items: center;

    gap: 30px;
  }


  .weather-condition-icon {
    width: 100px;
    height: 100px;

    flex: 0 0 100px;

    display: grid;
    place-items: center;

    color: var(--blue-bright);

    font-size: 5.3rem;

    line-height: 1;

    text-shadow:
      0 0 35px
      rgba(66, 165, 255, 0.3);
  }


  .current-temperature {
    display: flex;

    align-items: flex-start;

    font-size:
      clamp(5rem, 10vw, 8rem);

    font-weight: 650;

    line-height: 0.78;

    letter-spacing:
      -0.1em;
  }


  .current-temperature sup {
    margin-top: 5px;

    margin-left: 5px;

    color: var(--blue-bright);

    font-size: 1.2rem;

    font-weight: 700;

    letter-spacing: 0;
  }


  .current-condition {
    margin-left: 5px;
  }


  .current-condition h2 {
    margin: 0;

    font-size: 1rem;

    font-weight: 650;
  }


  .current-condition p {
    margin: 8px 0 0;

    color: var(--muted);

    font-size: 0.64rem;
  }


  .current-condition strong {
    color: var(--white);
  }


  .current-right {
    position: relative;

    padding-left: 30px;

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 10px;

    border-left:
      1px solid var(--border);
  }


  .hero-stat {
    display: flex;

    flex-direction: column;

    gap: 8px;
  }


  .hero-stat span {
    color: var(--dim);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.14em;
  }


  .hero-stat strong {
    font-size: 1.25rem;
  }


  /* ========================================================= */
  /* QUICK DATA */
  /* ========================================================= */

  .quick-data {
    margin-top: 42px;
  }


  .quick-data-heading {
    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 14px;
  }


  .data-line {
    height: 1px;

    flex: 1;

    background:
      var(--border);
  }


  .metrics-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 10px;
  }


  .metric-card {
    min-height: 105px;

    padding: 20px;

    display: flex;

    align-items: center;

    gap: 15px;

    border:
      1px solid var(--border);

    border-radius: 12px;

    background:
      rgba(255, 255, 255, 0.022);

    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .metric-card:hover {
    border-color:
      rgba(66, 165, 255, 0.3);

    background:
      rgba(22, 135, 255, 0.045);
  }


  .metric-icon {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background:
      var(--blue-soft);

    color:
      var(--blue-bright);

    font-size: 1.1rem;
  }


  .metric-card div {
    display: flex;

    flex-direction: column;

    gap: 6px;
  }


  .metric-card div span {
    color: var(--dim);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.12em;
  }


  .metric-card strong {
    font-size: 0.85rem;
  }


  /* ========================================================= */
  /* FORECAST SECTIONS */
  /* ========================================================= */

  .forecast-section,
  .sun-section {
    margin-top: 65px;

    scroll-margin-top: 100px;
  }


  .forecast-heading {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 17px;
  }


  .forecast-heading h2 {
    margin: 6px 0 0;

    font-size: 1.5rem;

    letter-spacing: -0.045em;
  }


  .forecast-controls {
    display: flex;

    gap: 5px;
  }


  .forecast-arrow {
    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    border:
      1px solid var(--border);

    border-radius: 8px;

    background:
      rgba(255, 255, 255, 0.025);

    color: var(--white);

    cursor: pointer;

    font-family: inherit;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }


  .forecast-arrow:hover {
    border-color:
      var(--blue-border);

    background:
      var(--blue-soft);

    color:
      var(--blue-bright);
  }


  /* ========================================================= */
  /* HOURLY */
  /* ========================================================= */

  .hourly-frame {
    padding: 1px;

    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 14px;

    background:
      rgba(255, 255, 255, 0.02);
  }


  .hourly-container {
    display: flex;

    gap: 1px;

    overflow-x: auto;

    scrollbar-width: thin;

    scrollbar-color:
      var(--blue)
      transparent;
  }


  .hour-card {
    min-width: 115px;

    min-height: 170px;

    padding: 20px 12px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 12px;

    border-right:
      1px solid var(--border);

    background:
      rgba(255, 255, 255, 0.012);
  }


  .hour-card.current {
    background:
      linear-gradient(
        180deg,
        rgba(22, 135, 255, 0.15),
        rgba(22, 135, 255, 0.035)
      );

    box-shadow:
      inset 0 2px 0
      var(--blue);
  }


  .hour-time {
    color: var(--muted);

    font-size: 0.55rem;

    font-weight: 800;

    letter-spacing: 0.08em;
  }


  .hour-card.current .hour-time {
    color:
      var(--blue-bright);
  }


  .hour-icon {
    color:
      var(--blue-bright);

    font-size: 2rem;

    line-height: 1;
  }


  .hour-temperature {
    font-size: 1.15rem;
  }


  .hour-rain {
    color:
      rgba(66, 165, 255, 0.85);

    font-size: 0.52rem;
  }


  /* ========================================================= */
  /* DAILY */
  /* ========================================================= */

  .daily-container {
    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 14px;
  }


  .daily-row {
    min-height: 86px;

    padding:
      14px 22px;

    display: grid;

    grid-template-columns:
      100px
      55px
      1fr
      auto;

    align-items: center;

    gap: 18px;

    border-bottom:
      1px solid var(--border);

    background:
      rgba(255, 255, 255, 0.018);
  }


  .daily-row:last-child {
    border-bottom: 0;
  }


  .daily-row.today {
    background:
      linear-gradient(
        90deg,
        rgba(22, 135, 255, 0.11),
        rgba(22, 135, 255, 0.025)
      );
  }


  .daily-day {
    display: flex;

    flex-direction: column;

    gap: 4px;
  }


  .daily-day strong {
    font-size: 0.72rem;
  }


  .daily-day span {
    color: var(--dim);

    font-size: 0.5rem;
  }


  .daily-icon {
    color:
      var(--blue-bright);

    font-size: 1.7rem;

    line-height: 1;
  }


  .daily-condition {
    display: flex;

    flex-direction: column;

    gap: 5px;
  }


  .daily-condition strong {
    font-size: 0.7rem;
  }


  .daily-condition span {
    color:
      rgba(66, 165, 255, 0.75);

    font-size: 0.52rem;
  }


  .daily-temperature {
    display: flex;

    align-items: center;

    gap: 12px;
  }


  .daily-temperature strong {
    font-size: 1rem;
  }


  .daily-temperature span {
    color: var(--dim);

    font-size: 0.8rem;
  }


  /* ========================================================= */
  /* SUN */
  /* ========================================================= */

  .sun-card {
    min-height: 130px;

    padding: 25px;

    display: grid;

    grid-template-columns:
      110px
      1fr
      110px;

    align-items: center;

    gap: 30px;

    border:
      1px solid var(--border);

    border-radius: 14px;

    background:
      linear-gradient(
        135deg,
        rgba(22, 135, 255, 0.06),
        rgba(255, 255, 255, 0.015)
      );
  }


  .sun-time {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }


  .sun-time.right {
    align-items: flex-end;
  }


  .sun-time span {
    color: var(--dim);

    font-size: 0.5rem;

    font-weight: 800;

    letter-spacing: 0.14em;
  }


  .sun-time strong {
    font-size: 1rem;
  }


  .sun-trajectory {
    position: relative;

    height: 65px;

    display: flex;

    align-items: center;
  }


  .sun-trajectory-line {
    width: 100%;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--blue),
        transparent
      );
  }


  .sun-position {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 14px;
    height: 14px;

    transform:
      translate(-50%, -50%);

    border-radius: 50%;

    background:
      var(--blue-bright);

    box-shadow:
      0 0 25px
      rgba(66, 165, 255, 0.9);
  }


  /* ========================================================= */
  /* FOOTER */
  /* ========================================================= */

  .weather-footer {
    margin-top: 75px;

    padding-top: 25px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    border-top:
      1px solid var(--border);
  }


  .footer-brand {
    display: flex;

    align-items: center;

    gap: 10px;
  }


  .footer-mark {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    border-radius: 7px;

    background:
      var(--blue-soft);

    color:
      var(--blue-bright);

    font-size: 0.5rem;

    font-weight: 900;
  }


  .footer-brand div {
    display: flex;

    flex-direction: column;

    gap: 3px;
  }


  .footer-brand strong {
    font-size: 0.55rem;

    letter-spacing: 0.1em;
  }


  .footer-brand span {
    color: var(--dim);

    font-size: 0.48rem;
  }


  .footer-location {
    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 4px;
  }


  .footer-location span {
    color: var(--dim);

    font-size: 0.48rem;

    letter-spacing: 0.12em;
  }


  .footer-location strong {
    color: var(--blue-bright);

    font-size: 0.6rem;
  }


  /* ========================================================= */
  /* TABLET */
  /* ========================================================= */

  @media (max-width: 900px) {

    .current-weather-card {
      grid-template-columns: 1fr;
    }


    .current-right {
      padding-left: 0;

      padding-top: 25px;

      border-left: 0;

      border-top:
        1px solid var(--border);
    }


