<!-- ELECTRIC BLUE INTERACTIVE BACKGROUND -->

<!-- ============================================================= -->

<script>
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        opacity: number;
      }


      const particles: Particle[] =
        [];


      let width = 0;
      let height = 0;


      let mouseX = 0;
      let mouseY = 0;


      let targetMouseX = 0;
      let targetMouseY = 0;


      let animationFrame = 0;


      const getParticleCount =
        (): number =>
          window.innerWidth < 768
            ? 38
            : 72;


      let particleCount =
        getParticleCount();


      const resize = (): void => {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;


        height =
          window.innerHeight;


        canvas.width =
          width * ratio;


        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;


        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particleCount =
          getParticleCount();
      };


      const createParticle =
        (): Particle => {

          return {
            x:
              Math.random() *
              width,

            y:
              Math.random() *
              height,

            vx:
              (Math.random() - 0.5) *
              0.12,

            vy:
              (Math.random() - 0.5) *
              0.12,

            size:
              Math.random() *
              1.5 +
              0.35,

            opacity:
              Math.random() *
              0.35 +
              0.05,
          };
        };


      const initialize =
        (): void => {

          particles.length = 0;


          for (
            let index = 0;
            index < particleCount;
            index += 1
          ) {

            particles.push(
              createParticle()
            );
          }
        };


      const drawGrid =
        (): void => {

          const spacing = 72;


          const offsetX =
            (mouseX - width / 2) *
            0.018;


          const offsetY =
            (mouseY - height / 2) *
            0.018;


          context.save();


          context.strokeStyle =
            "rgba(0,170,255,0.045)";


          context.lineWidth = 1;


          for (
            let x =
              -spacing +
              (offsetX % spacing);

            x < width + spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();
          }


          for (
            let y =
              -spacing +
              (offsetY % spacing);

            y < height + spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();
          }


          context.restore();
        };


      const drawConnections =
        (): void => {

          const maxDistance = 125;


          for (
            let i = 0;
            i < particles.length;
            i += 1
          ) {

            for (
              let j = i + 1;
              j < particles.length;
              j += 1
            ) {

              const first =
                particles[i];

              const second =
                particles[j];


              if (!first || !second) {
                continue;
              }


              const dx =
                first.x -
                second.x;


              const dy =
                first.y -
                second.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (1 -
                    distance /
                      maxDistance) *
                  0.08;


                context.beginPath();


                context.moveTo(
                  first.x,
                  first.y
                );


                context.lineTo(
                  second.x,
                  second.y
                );


                context.strokeStyle =
                  `rgba(0,170,255,${opacity})`;


                context.lineWidth = 1;


                context.stroke();
              }
            }
          }
        };


      const drawParticles =
        (): void => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;


            particle.y +=
              particle.vy;


            if (
              particle.x <
              -10
            ) {

              particle.x =
                width + 10;
            }


            if (
              particle.x >
              width + 10
            ) {

              particle.x = -10;
            }


            if (
              particle.y <
              -10
            ) {

              particle.y =
                height + 10;
            }


            if (
              particle.y >
              height + 10
            ) {

              particle.y = -10;
            }


            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              190
            ) {

              const force =
                (1 -
                  distance /
                    190) *
                0.006;


              particle.vx +=
                dx * force;


              particle.vy +=
                dy * force;
            }


            particle.vx *=
              0.995;


            particle.vy *=
              0.995;


            context.beginPath();


            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(0,190,255,${particle.opacity})`;


            context.fill();
          }
        };


      const drawMouseGlow =
        (): void => {

          const gradient =
            context.createRadialGradient(
              targetMouseX,
              targetMouseY,
              0,
              targetMouseX,
              targetMouseY,
              240
            );


          gradient.addColorStop(
            0,
            "rgba(0,170,255,0.075)"
          );


          gradient.addColorStop(
            0.45,
            "rgba(0,170,255,0.025)"
          );


          gradient.addColorStop(
            1,
            "rgba(0,170,255,0)"
          );


          context.fillStyle =
            gradient;


          context.fillRect(
            0,
            0,
            width,
            height
          );
        };


      const animate =
        (): void => {

          mouseX +=
            (targetMouseX -
              mouseX) *
            0.045;


          mouseY +=
            (targetMouseY -
              mouseY) *
            0.045;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawMouseGlow();

          drawGrid();

          drawConnections();

          drawParticles();


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


      const handleResize =
        (): void => {

          resize();

          initialize();
        };


      const handleMouseMove =
        (
          event: MouseEvent
        ): void => {

          targetMouseX =
            event.clientX;


          targetMouseY =
            event.clientY;
        };


      const handleMouseLeave =
        (): void => {

          targetMouseX =
            width / 2;


          targetMouseY =
            height / 2;
        };


      window.addEventListener(
        "resize",
        handleResize
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      resize();


      targetMouseX =
        width / 2;


      targetMouseY =
        height / 2;


      mouseX =
        width / 2;


      mouseY =
        height / 2;


      initialize();


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {

        animationFrame =
          requestAnimationFrame(
            animate
          );

      } else {

        drawGrid();

        drawParticles();
      }


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            handleResize
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>

