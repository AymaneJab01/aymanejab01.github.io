---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">

  <main class="weather-page">

    <!-- ========================================================= -->
    <!-- ELECTRIC BLUE REACTBITS-INSPIRED BACKGROUND -->
    <!-- ========================================================= -->

    <canvas
      id="weather-canvas"
      class="weather-canvas"
      aria-hidden="true"
    ></canvas>

    <div class="blue-atmosphere" aria-hidden="true"></div>

    <div class="blue-orb blue-orb-one" aria-hidden="true"></div>
    <div class="blue-orb blue-orb-two" aria-hidden="true"></div>
    <div class="blue-orb blue-orb-three" aria-hidden="true"></div>


    <!-- ========================================================= -->
    <!-- DOCUMENTATION LAYOUT -->
    <!-- ========================================================= -->

    <div class="documentation-layout">

      <!-- ======================================================= -->
      <!-- SIDEBAR -->
      <!-- ======================================================= -->

      <aside class="documentation-sidebar">

        <div class="sidebar-sticky">

          <div class="sidebar-label">
            PROJECT 03
          </div>

          <h2 class="sidebar-title">
            Weather
          </h2>

          <nav class="documentation-nav">

            <a href="#overview" class="active">
              <span>01</span>
              Overview
            </a>

            <a href="#current">
              <span>02</span>
              Current weather
            </a>

            <a href="#outlook">
              <span>03</span>
              Today's outlook
            </a>

            <a href="#forecast">
              <span>04</span>
              Daily forecast
            </a>

            <a href="#technology">
              <span>05</span>
              Technologies
            </a>

          </nav>


          <div class="sidebar-status">

            <span class="status-dot"></span>

            <span>
              Live weather data
            </span>

          </div>

        </div>

      </aside>


      <!-- ======================================================= -->
      <!-- MAIN DOCUMENTATION -->
      <!-- ======================================================= -->

      <div class="documentation-content">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <section
          id="overview"
          class="documentation-header"
        >

          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            PROJECT / 03
          </div>

          <h1>
            Weather Dashboard<span>.</span>
          </h1>

          <p>
            A live weather interface for
            <strong>Alcoi</strong> and
            <strong>Valencia</strong>,
            combining real-time meteorological data
            with an interactive electric-blue visual system.
          </p>

          <div class="header-meta">

            <span>
              <strong>API</strong>
              Open-Meteo
            </span>

            <span>
              <strong>UI</strong>
              Astro
            </span>

            <span>
              <strong>DATA</strong>
              Live
            </span>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- LOCATION SELECTOR -->
        <!-- ===================================================== -->

        <section
          id="current"
          class="weather-section"
        >

          <div class="section-heading">

            <div>
              <span class="section-number">
                02
              </span>

              <h2>
                Current weather
              </h2>
            </div>

            <span class="section-description">
              Real-time conditions
            </span>

          </div>


          <!-- =================================================== -->
          <!-- LOCATION TABS -->
          <!-- =================================================== -->

          <div class="location-tabs">

            <button
              class="location-tab active"
              data-location="alcoi"
              type="button"
            >
              <span class="tab-indicator"></span>
              Alcoi
            </button>

            <button
              class="location-tab"
              data-location="valencia"
              type="button"
            >
              <span class="tab-indicator"></span>
              Valencia
            </button>

          </div>


          <!-- =================================================== -->
          <!-- WEATHER HERO -->
          <!-- =================================================== -->

          <div
            class="weather-hero"
            data-weather-location="alcoi"
          >

            <div class="weather-hero-glow"></div>

            <div class="weather-hero-content">


              <!-- LOCATION -->

              <div class="weather-location">

                <div>

                  <span class="location-label">
                    LOCATION
                  </span>

                  <h3 class="location-name">
                    Alcoi
                  </h3>

                  <p class="location-region">
                    Alicante, Spain
                  </p>

                </div>


                <div class="weather-icon-large">
                  ⛅
                </div>

              </div>


              <!-- CURRENT TEMPERATURE -->

              <div class="current-weather">

                <div>

                  <span class="now-label">
                    NOW
                  </span>

                  <div
                    class="current-temperature"
                    data-current-temperature
                  >
                    --
                  </div>

                  <div
                    class="current-description"
                    data-current-description
                  >
                    Loading weather...
                  </div>

                </div>

              </div>


              <!-- WEATHER METRICS -->

              <div class="weather-metrics">

                <div class="metric">

                  <span class="metric-label">
                    FEELS LIKE
                  </span>

                  <strong data-feels>
                    --
                  </strong>

                </div>


                <div class="metric">

                  <span class="metric-label">
                    HIGH
                  </span>

                  <strong data-high>
                    --
                  </strong>

                </div>


                <div class="metric">

                  <span class="metric-label">
                    LOW
                  </span>

                  <strong data-low>
                    --
                  </strong>

                </div>


                <div class="metric">

                  <span class="metric-label">
                    RAIN
                  </span>

                  <strong data-rain>
                    --
                  </strong>

                </div>

              </div>


              <!-- UPDATED -->

              <div class="weather-updated">

                <span class="live-pulse"></span>

                <span>
                  Updated
                  <span data-updated>
                    --
                  </span>
                </span>

                <span class="separator">
                  /
                </span>

                <span>
                  Open-Meteo
                </span>

              </div>

            </div>

          </div>


          <!-- =================================================== -->
          <!-- DETAIL GRID -->
          <!-- =================================================== -->

          <div class="weather-detail-grid">

            <div class="detail-card">

              <span class="detail-label">
                HUMIDITY
              </span>

              <strong data-humidity>
                --
              </strong>

              <span class="detail-unit">
                relative humidity
              </span>

            </div>


            <div class="detail-card">

              <span class="detail-label">
                WIND
              </span>

              <strong data-wind>
                --
              </strong>

              <span class="detail-unit">
                km/h
              </span>

            </div>


            <div class="detail-card">

              <span class="detail-label">
                CONDITION
              </span>

              <strong data-condition-short>
                --
              </strong>

              <span class="detail-unit">
                current sky
              </span>

            </div>


            <div class="detail-card">

              <span class="detail-label">
                OBSERVATION
              </span>

              <strong data-observation>
                LIVE
              </strong>

              <span class="detail-unit">
                automatic update
              </span>

            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- OUTLOOK -->
        <!-- ===================================================== -->

        <section
          id="outlook"
          class="weather-section"
        >

          <div class="section-heading">

            <div>
              <span class="section-number">
                03
              </span>

              <h2>
                Today's outlook
              </h2>
            </div>

            <span class="section-description">
              Atmospheric overview
            </span>

          </div>


          <div class="outlook-card">

            <div class="outlook-visual">

              <div class="sun-core"></div>

              <div class="sun-ring sun-ring-one"></div>
              <div class="sun-ring sun-ring-two"></div>
              <div class="sun-ring sun-ring-three"></div>

            </div>


            <div class="outlook-content">

              <span class="outlook-label">
                CURRENT CONDITION
              </span>

              <h3 data-outlook-title>
                Loading conditions...
              </h3>

              <p data-outlook-description>
                Weather information is being retrieved
                from the live weather service.
              </p>


              <div class="outlook-data">

                <div>
                  <span>
                    Temperature
                  </span>

                  <strong data-outlook-temperature>
                    --
                  </strong>
                </div>

                <div>
                  <span>
                    Humidity
                  </span>

                  <strong data-outlook-humidity>
                    --
                  </strong>
                </div>

                <div>
                  <span>
                    Wind
                  </span>

                  <strong data-outlook-wind>
                    --
                  </strong>
                </div>

              </div>

            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- DAILY FORECAST -->
        <!-- ===================================================== -->

        <section
          id="forecast"
          class="weather-section"
        >

          <div class="section-heading">

            <div>
              <span class="section-number">
                04
              </span>

              <h2>
                Daily forecast
              </h2>
            </div>

            <span class="section-description">
              Next 7 days
            </span>

          </div>


          <div
            class="forecast-list"
            data-forecast-list
          >

            <div class="forecast-loading">
              Loading forecast...
            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- TECHNOLOGY -->
        <!-- ===================================================== -->

        <section
          id="technology"
          class="documentation-section"
        >

          <div class="section-heading">

            <div>
              <span class="section-number">
                05
              </span>

              <h2>
                Technologies
              </h2>
            </div>

          </div>


          <div class="technology-grid">

            <div class="technology-card">

              <span class="tech-number">
                01
              </span>

              <strong>
                Astro
              </strong>

              <p>
                Static-first architecture with
                client-side weather logic.
              </p>

            </div>


            <div class="technology-card">

              <span class="tech-number">
                02
              </span>

              <strong>
                TypeScript
              </strong>

              <p>
                Typed weather data and
                predictable UI updates.
              </p>

            </div>


            <div class="technology-card">

              <span class="tech-number">
                03
              </span>

              <strong>
                Open-Meteo
              </strong>

              <p>
                Live weather and forecast
                information.
              </p>

            </div>


            <div class="technology-card">

              <span class="tech-number">
                04
              </span>

              <strong>
                Canvas
              </strong>

              <p>
                Interactive particles,
                connections and electric-blue
                atmospheric effects.
              </p>

            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- DOCUMENTATION FOOTER -->
        <!-- ===================================================== -->

        <div class="documentation-footer">

          <a href="/#projects">
            <span>←</span>
            Back to projects
          </a>

          <span>
            WEATHER / PROJECT 03
          </span>

        </div>

      </div>

    </div>

  </main>

</Layout>


<!-- ============================================================= -->
<!-- WEATHER + INTERACTIVE ENGINE -->
<!-- ============================================================= -->

<script>

  /* ============================================================= */
  /* TYPES */
  /* ============================================================= */

  interface CurrentWeather {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    precipitation_probability: number;
    time: string;
  }

  interface DailyWeather {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
  }

  interface WeatherResponse {
    current: CurrentWeather;
    daily: DailyWeather;
  }


  interface LocationConfig {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  }


  /* ============================================================= */
  /* LOCATIONS */
  /* ============================================================= */

  const locations: Record<
    string,
    LocationConfig
  > = {

    alcoi: {
      name: "Alcoi",
      region: "Alicante, Spain",
      latitude: 38.6983,
      longitude: -0.4743,
    },

    valencia: {
      name: "Valencia",
      region: "Valencia, Spain",
      latitude: 39.4699,
      longitude: -0.3763,
    },

  };


  /* ============================================================= */
  /* WEATHER DESCRIPTIONS */
  /* ============================================================= */

  const getDescription = (
    code: number
  ): string => {

    const descriptions: Record<
      number,
      string
    > = {

      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",

      45: "Fog",
      48: "Rime fog",

      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",

      56: "Freezing drizzle",
      57: "Dense freezing drizzle",

      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",

      66: "Freezing rain",
      67: "Heavy freezing rain",

      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",

      77: "Snow grains",

      80: "Light rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",

      85: "Light snow showers",
      86: "Heavy snow showers",

      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",

    };

    return (
      descriptions[code] ??
      "Unknown conditions"
    );

  };


  /* ============================================================= */
  /* WEATHER ICON */
  /* ============================================================= */

  const getIcon = (
    code: number
  ): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 82) {
      return "🌦️";
    }

    if (code <= 86) {
      return "🌨️";
    }

    return "⛈️";

  };


  /* ============================================================= */
  /* DOM */
  /* ============================================================= */

  const tabs =
    document.querySelectorAll<HTMLButtonElement>(
      ".location-tab"
    );


  const hero =
    document.querySelector<HTMLElement>(
      "[data-weather-location]"
    );


  const temperature =
    document.querySelector<HTMLElement>(
      "[data-current-temperature]"
    );


  const description =
    document.querySelector<HTMLElement>(
      "[data-current-description]"
    );


  const locationName =
    document.querySelector<HTMLElement>(
      ".location-name"
    );


  const locationRegion =
    document.querySelector<HTMLElement>(
      ".location-region"
    );


  const icon =
    document.querySelector<HTMLElement>(
      ".weather-icon-large"
    );


  const feels =
    document.querySelector<HTMLElement>(
      "[data-feels]"
    );


  const high =
    document.querySelector<HTMLElement>(
      "[data-high]"
    );


  const low =
    document.querySelector<HTMLElement>(
      "[data-low]"
    );


  const rain =
    document.querySelector<HTMLElement>(
      "[data-rain]"
    );


  const humidity =
    document.querySelector<HTMLElement>(
      "[data-humidity]"
    );


  const wind =
    document.querySelector<HTMLElement>(
      "[data-wind]"
    );


  const conditionShort =
    document.querySelector<HTMLElement>(
      "[data-condition-short]"
    );


  const updated =
    document.querySelector<HTMLElement>(
      "[data-updated]"
    );


  const outlookTitle =
    document.querySelector<HTMLElement>(
      "[data-outlook-title]"
    );


  const outlookDescription =
    document.querySelector<HTMLElement>(
      "[data-outlook-description]"
    );


  const outlookTemperature =
    document.querySelector<HTMLElement>(
      "[data-outlook-temperature]"
    );


  const outlookHumidity =
    document.querySelector<HTMLElement>(
      "[data-outlook-humidity]"
    );


  const outlookWind =
    document.querySelector<HTMLElement>(
      "[data-outlook-wind]"
    );


  const forecastList =
    document.querySelector<HTMLElement>(
      "[data-forecast-list]"
    );


  /* ============================================================= */
  /* WEATHER URL */
  /* ============================================================= */

  const buildWeatherUrl = (
    location: LocationConfig
  ): string => {

    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${location.latitude}` +
      `&longitude=${location.longitude}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m," +
      "precipitation_probability" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min," +
      "precipitation_probability_max" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );

  };


  /* ============================================================= */
  /* DATE */
  /* ============================================================= */

  const formatDay = (
    date: string,
    index: number
  ): string => {

    if (index === 0) {
      return "Today";
    }

    const parsed =
      new Date(`${date}T12:00:00`);

    return parsed.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );

  };


  /* ============================================================= */
  /* LOAD WEATHER */
  /* ============================================================= */

  const loadWeather = async (
    locationKey: string
  ): Promise<void> => {

    const location =
      locations[locationKey];

    if (!location) {
      return;
    }


    if (locationName) {
      locationName.textContent =
        location.name;
    }


    if (locationRegion) {
      locationRegion.textContent =
        location.region;
    }


    if (hero) {
      hero.dataset.weatherLocation =
        locationKey;
    }


    if (temperature) {
      temperature.textContent =
        "--";
    }


    if (description) {
      description.textContent =
        "Loading weather...";
    }


    try {

      const response =
        await fetch(
          buildWeatherUrl(location)
        );


      if (!response.ok) {
        throw new Error(
          "Weather API request failed"
        );
      }


      const data =
        await response.json() as WeatherResponse;


      const current =
        data.current;


      const daily =
        data.daily;


      /* ========================================================= */
      /* MAIN WEATHER */
      /* ========================================================= */

      if (temperature) {
        temperature.textContent =
          `${Math.round(
            current.temperature_2m
          )}°`;
      }


      if (description) {
        description.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (icon) {
        icon.textContent =
          getIcon(
            current.weather_code
          );
      }


      if (feels) {
        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°`;
      }


      if (high) {
        high.textContent =
          `${Math.round(
            daily.temperature_2m_max[0]
          )}°`;
      }


      if (low) {
        low.textContent =
          `${Math.round(
            daily.temperature_2m_min[0]
          )}°`;
      }


      if (rain) {
        rain.textContent =
          `${Math.round(
            current.precipitation_probability
          )}%`;
      }


      if (humidity) {
        humidity.textContent =
          `${Math.round(
            current.relative_humidity_2m
          )}%`;
      }


      if (wind) {
        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )}`;
      }


      if (conditionShort) {
        conditionShort.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (updated) {

        const currentDate =
          new Date(
            current.time
          );


        updated.textContent =
          currentDate.toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit",
            }
          );

      }


      /* ========================================================= */
      /* OUTLOOK */
      /* ========================================================= */

      if (outlookTitle) {
        outlookTitle.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (outlookDescription) {

        outlookDescription.textContent =
          `Current conditions in ${location.name}. ` +
          `The dashboard is displaying live meteorological ` +
          `data retrieved directly from the weather API.`;

      }


      if (outlookTemperature) {

        outlookTemperature.textContent =
          `${Math.round(
            current.temperature_2m
          )}°C`;

      }


      if (outlookHumidity) {

        outlookHumidity.textContent =
          `${Math.round(
            current.relative_humidity_2m
          )}%`;

      }


      if (outlookWind) {

        outlookWind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;

      }


      /* ========================================================= */
      /* FORECAST */
      /* ========================================================= */

      if (forecastList) {

        forecastList.innerHTML = "";


        daily.time.forEach(
          (
            date,
            index
          ) => {

            const item =
              document.createElement(
                "article"
              );


            item.className =
              "forecast-row";


            const day =
              formatDay(
                date,
                index
              );


            const weatherCode =
              daily.weather_code[index];


            const max =
              Math.round(
                daily.temperature_2m_max[index]
              );


            const min =
              Math.round(
                daily.temperature_2m_min[index]
              );


            const probability =
              Math.round(
                daily
                  .precipitation_probability_max[index]
              );


            item.innerHTML = `

              <div class="forecast-day">
                ${day}
              </div>

              <div class="forecast-condition">

                <span class="forecast-icon">
                  ${getIcon(weatherCode)}
                </span>

                <span>
                  ${getDescription(weatherCode)}
                </span>

              </div>

              <div class="forecast-rain">
                ${probability}% rain
              </div>

              <div class="forecast-temperature">

                <strong>
                  ${max}°
                </strong>

                <span>
                  ${min}°
                </span>

              </div>

            `;


            forecastList.appendChild(
              item
            );

          }
        );

      }

    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );


      if (description) {
        description.textContent =
          "Unable to load weather data";
      }


      if (forecastList) {
        forecastList.innerHTML =
          `
            <div class="forecast-loading">
              Weather service unavailable.
              Please try again later.
            </div>
          `;
      }

    }

  };


  /* ============================================================= */
  /* LOCATION SWITCHING */
  /* ============================================================= */

  tabs.forEach(
    (tab) => {

      tab.addEventListener(
        "click",
        () => {

          tabs.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          tab.classList.add(
            "active"
          );


          const location =
            tab.dataset.location;


          if (location) {
            loadWeather(
              location
            );
          }

        }
      );

    }
  );


  /* ============================================================= */
  /* INITIAL WEATHER */
  /* ============================================================= */

  loadWeather(
    "alcoi"
  );


  /* ============================================================= */
  /* ELECTRIC BLUE CANVAS */
  /* ============================================================= */

  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-canvas"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        alpha: number;
        pulse: number;
        pulseSpeed: number;
      }


      const particles: Particle[] =
        [];


      let width =
        window.innerWidth;


      let height =
        window.innerHeight;


      let pixelRatio =
        Math.min(
          window.devicePixelRatio || 1,
          2
        );


      let mouseX =
        width / 2;


      let mouseY =
        height / 2;


      let targetMouseX =
        width / 2;


      let targetMouseY =
        height / 2;


      const particleCount =
        window.innerWidth < 768
          ? 85
          : 150;


      /* ========================================================= */
      /* RESIZE */
      /* ========================================================= */

      const resizeCanvas =
        (): void => {

          width =
            window.innerWidth;


          height =
            window.innerHeight;


          pixelRatio =
            Math.min(
              window.devicePixelRatio || 1,
              2
            );


          canvas.width =
            width * pixelRatio;


          canvas.height =
            height * pixelRatio;


          canvas.style.width =
            `${width}px`;


          canvas.style.height =
            `${height}px`;


          context.setTransform(
            pixelRatio,
            0,
            0,
            pixelRatio,
            0,
            0
          );

        };


      /* ========================================================= */
      /* PARTICLE CREATION */
      /* ========================================================= */

      const createParticle =
        (): Particle => {

          return {

            x:
              Math.random() *
              width,

            y:
              Math.random() *
              height,

            vx:
              (Math.random() - 0.5) *
              0.35,

            vy:
              (Math.random() - 0.5) *
              0.35,

            size:
              Math.random() *
              2.4 +
              0.5,

            alpha:
              Math.random() *
              0.55 +
              0.12,

            pulse:
              Math.random() *
              Math.PI *
              2,

            pulseSpeed:
              Math.random() *
              0.025 +
              0.008,

          };

        };


      const initializeParticles =
        (): void => {

          particles.length =
            0;


          for (
            let i = 0;
            i < particleCount;
            i++
          ) {

            particles.push(
              createParticle()
            );

          }

        };


      /* ========================================================= */
      /* GRID */
      /* ========================================================= */

      const drawGrid =
        (): void => {

          const spacing =
            85;


          context.save();


          const offsetX =
            (
              mouseX -
              width / 2
            ) *
            0.035;


          const offsetY =
            (
              mouseY -
              height / 2
            ) *
            0.035;


          context.lineWidth =
            1;


          context.strokeStyle =
            "rgba(0,115,255,0.095)";


          for (
            let x =
              -spacing +
              (
                offsetX %
                spacing
              );

            x <
            width +
            spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();

          }


          for (
            let y =
              -spacing +
              (
                offsetY %
                spacing
              );

            y <
            height +
            spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();

          }


          context.restore();

        };


      /* ========================================================= */
      /* ELECTRIC WAVES */
      /* ========================================================= */

      const drawWaves =
        (time: number): void => {

          context.save();


          for (
            let wave = 0;
            wave < 4;
            wave++
          ) {

            context.beginPath();


            const amplitude =
              35 +
              wave * 12;


            const frequency =
              0.003 -
              wave * 0.0002;


            const speed =
              time *
              (
                0.00015 +
                wave * 0.00003
              );


            for (
              let x = 0;
              x <= width;
              x += 8
            ) {

              const y =
                height * 0.58 +
                Math.sin(
                  x * frequency +
                  speed
                ) *
                amplitude +
                Math.sin(
                  x * frequency * 2.3 +
                  speed * 1.5
                ) *
                12;


              if (x === 0) {
                context.moveTo(
                  x,
                  y
                );
              } else {
                context.lineTo(
                  x,
                  y
                );
              }

            }


            context.strokeStyle =
              `rgba(0,125,255,${
                0.045 -
                wave * 0.006
              })`;


            context.lineWidth =
              wave === 0
                ? 2
                : 1;


            context.stroke();

          }


          context.restore();

        };


      /* ========================================================= */
      /* PARTICLES */
      /* ========================================================= */

      const drawParticles =
        (time: number): void => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;


            particle.y +=
              particle.vy;


            particle.pulse +=
              particle.pulseSpeed;


            if (
              particle.x <
              -20
            ) {
              particle.x =
                width + 20;
            }


            if (
              particle.x >
              width + 20
            ) {
              particle.x =
                -20;
            }


            if (
              particle.y <
              -20
            ) {
              particle.y =
                height + 20;
            }


            if (
              particle.y >
              height + 20
            ) {
              particle.y =
                -20;
            }


            /* ================================================= */
            /* MOUSE MAGNETIC FIELD */
            /* ================================================= */

            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              260
            ) {

              const force =
                (
                  1 -
                  distance / 260
                ) *
                0.012;


              particle.vx +=
                dx *
                force;


              particle.vy +=
                dy *
                force;

            }


            particle.vx *=
              0.992;


            particle.vy *=
              0.992;


            const pulse =
              (
                Math.sin(
                  particle.pulse
                ) +
                1
              ) *
              0.5;


            const alpha =
              particle.alpha *
              (
                0.65 +
                pulse *
                0.65
              );


            /* ================================================= */
            /* GLOW */
            /* ================================================= */

            const gradient =
              context.createRadialGradient(
                particle.x,
                particle.y,
                0,
                particle.x,
                particle.y,
                particle.size * 8
              );


            gradient.addColorStop(
              0,
              `rgba(0,130,255,${alpha})`
            );


            gradient.addColorStop(
              0.35,
              `rgba(0,110,255,${alpha * 0.35})`
            );


            gradient.addColorStop(
              1,
              "rgba(0,110,255,0)"
            );


            context.beginPath();


            context.fillStyle =
              gradient;


            context.arc(
              particle.x,
              particle.y,
              particle.size * 8,
              0,
              Math.PI * 2
            );


            context.fill();


            /* ================================================= */
            /* CORE */
            /* ================================================= */

            context.beginPath();


            context.fillStyle =
              `rgba(0,105,255,${alpha})`;


            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fill();

          }

        };


      /* ========================================================= */
      /* PARTICLE CONNECTIONS */
      /* ========================================================= */

      const drawConnections =
        (): void => {

          const maxDistance =
            155;


          for (
            let i = 0;
            i <
            particles.length;
            i++
          ) {

            const a =
              particles[i];


            for (
              let j = i + 1;
              j <
              particles.length;
              j++
            ) {

              const b =
                particles[j];


              const dx =
                a.x -
                b.x;


              const dy =
                a.y -
                b.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (
                    1 -
                    distance /
                    maxDistance
                  ) *
                  0.16;


                context.beginPath();


                context.moveTo(
                  a.x,
                  a.y
                );


                context.lineTo(
                  b.x,
                  b.y
                );


                context.strokeStyle =
                  `rgba(0,120,255,${opacity})`;


                context.lineWidth =
                  1;


                context.stroke();

              }

            }

          }

        };


      /* ========================================================= */
      /* MOUSE ENERGY FIELD */
      /* ========================================================= */

      const drawMouseField =
        (): void => {

          const gradient =
            context.createRadialGradient(
              mouseX,
              mouseY,
              0,
              mouseX,
              mouseY,
              360
            );


          gradient.addColorStop(
            0,
            "rgba(0,120,255,0.15)"
          );


          gradient.addColorStop(
            0.25,
            "rgba(0,120,255,0.08)"
          );


          gradient.addColorStop(
            0.6,
            "rgba(0,120,255,0.025)"
          );


          gradient.addColorStop(
            1,
            "rgba(0,120,255,0)"
          );


          context.fillStyle =
            gradient;


          context.fillRect(
            0,
            0,
            width,
            height
          );

        };


      /* ========================================================= */
      /* ANIMATION */
      /* ========================================================= */

      let animationFrame =
        0;


      const animate =
        (time: number): void => {

          mouseX +=
            (
              targetMouseX -
              mouseX
            ) *
            0.055;


          mouseY +=
            (
              targetMouseY -
              mouseY
            ) *
            0.055;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawGrid();

          drawWaves(
            time
          );

          drawConnections();

          drawParticles(
            time
          );

          drawMouseField();


          animationFrame =
            requestAnimationFrame(
              animate
            );

        };


      /* ========================================================= */
      /* EVENTS */
      /* ========================================================= */

      window.addEventListener(
        "resize",
        () => {

          resizeCanvas();

          initializeParticles();

        }
      );


      window.addEventListener(
        "mousemove",
        (
          event: MouseEvent
        ) => {

          targetMouseX =
            event.clientX;


          targetMouseY =
            event.clientY;

        },
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        () => {

          targetMouseX =
            width / 2;


          targetMouseY =
            height / 2;

        }
      );


      /* ========================================================= */
      /* START */
      /* ========================================================= */

      resizeCanvas();

      initializeParticles();

      animationFrame =
        requestAnimationFrame(
          animate
        );


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );

        }
      );

    }

  }

</script>


