---

## import Layout from "../../layouts/Layout.astro";

<Layout title="Weather Dashboard">
  <main class="weather-page">

```
<!-- ========================================================= -->
<!-- BACKGROUND -->
<!-- ========================================================= -->

<canvas
  id="weather-background"
  class="weather-canvas"
  aria-hidden="true"
></canvas>

<div class="weather-background-glow" aria-hidden="true"></div>

<!-- ========================================================= -->
<!-- MAIN -->
<!-- ========================================================= -->

<section class="weather-content">

  <div class="weather-wrapper">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header class="weather-header">

      <div class="project-label">
        <span class="status-dot"></span>
        <span>PROJECT 03 / WEATHER</span>
      </div>

      <h1>
        Weather Dashboard<span>.</span>
      </h1>

      <p>
        Real-time weather conditions and forecasts for Alcoi
        and Valencia, powered by Open-Meteo.
      </p>

      <div class="technology-tags">
        <span>Astro</span>
        <span>TypeScript</span>
        <span>Open-Meteo</span>
        <span>Canvas</span>
        <span>REST API</span>
      </div>

    </header>


    <!-- ===================================================== -->
    <!-- CURRENT WEATHER -->
    <!-- ===================================================== -->

    <section
      class="current-section"
      aria-labelledby="current-weather-title"
    >

      <div class="section-heading">

        <div>
          <span class="section-kicker">
            LIVE CONDITIONS
          </span>

          <h2 id="current-weather-title">
            Current weather
          </h2>
        </div>

        <span class="live-indicator">
          <span></span>
          LIVE
        </span>

      </div>


      <!-- =================================================== -->
      <!-- WEATHER CARDS -->
      <!-- =================================================== -->

      <div class="weather-grid">

        <!-- ALCOI -->

        <article
          class="weather-card"
          data-lat="38.6983"
          data-lon="-0.4743"
          data-city="Alcoi"
        >

          <div class="card-top">

            <div>
              <span class="location-label">
                LOCATION
              </span>

              <h3>
                Alcoi
              </h3>

              <p>
                Alicante, Spain
              </p>
            </div>

            <div
              class="current-icon weather-icon"
              aria-hidden="true"
            >
              ⛅
            </div>

          </div>


          <div class="current-condition">

            <div class="temperature-row">

              <span class="temperature weather-temperature">
                --
              </span>

              <span class="degree">
                °C
              </span>

            </div>

            <div class="weather-description">
              Loading weather...
            </div>

          </div>


          <div class="weather-details">

            <div>
              <span>FEELS LIKE</span>
              <strong class="weather-feels">--</strong>
            </div>

            <div>
              <span>WIND</span>
              <strong class="weather-wind">--</strong>
            </div>

            <div>
              <span>HUMIDITY</span>
              <strong class="weather-humidity">--</strong>
            </div>

            <div>
              <span>UPDATED</span>
              <strong class="weather-time">--</strong>
            </div>

          </div>

        </article>


        <!-- VALENCIA -->

        <article
          class="weather-card"
          data-lat="39.4699"
          data-lon="-0.3763"
          data-city="Valencia"
        >

          <div class="card-top">

            <div>
              <span class="location-label">
                LOCATION
              </span>

              <h3>
                Valencia
              </h3>

              <p>
                Valencia, Spain
              </p>
            </div>

            <div
              class="current-icon weather-icon"
              aria-hidden="true"
            >
              ☀️
            </div>

          </div>


          <div class="current-condition">

            <div class="temperature-row">

              <span class="temperature weather-temperature">
                --
              </span>

              <span class="degree">
                °C
              </span>

            </div>

            <div class="weather-description">
              Loading weather...
            </div>

          </div>


          <div class="weather-details">

            <div>
              <span>FEELS LIKE</span>
              <strong class="weather-feels">--</strong>
            </div>

            <div>
              <span>WIND</span>
              <strong class="weather-wind">--</strong>
            </div>

            <div>
              <span>HUMIDITY</span>
              <strong class="weather-humidity">--</strong>
            </div>

            <div>
              <span>UPDATED</span>
              <strong class="weather-time">--</strong>
            </div>

          </div>

        </article>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- FORECAST -->
    <!-- ===================================================== -->

    <section
      class="forecast-section"
      aria-labelledby="forecast-title"
    >

      <div class="section-heading forecast-heading">

        <div>
          <span class="section-kicker">
            FORECAST
          </span>

          <h2 id="forecast-title">
            Seven day outlook
          </h2>
        </div>

      </div>


      <div class="location-switcher">

        <button
          type="button"
          class="forecast-button active"
          data-forecast-location="38.6983,-0.4743"
        >
          Alcoi
        </button>

        <button
          type="button"
          class="forecast-button"
          data-forecast-location="39.4699,-0.3763"
        >
          Valencia
        </button>

      </div>


      <div
        id="forecast-container"
        class="forecast-container"
      >
        <div class="forecast-loading">
          Loading forecast...
        </div>
      </div>

    </section>


    <!-- ===================================================== -->
    <!-- PROJECT DOCUMENTATION -->
    <!-- ===================================================== -->

    <section class="documentation">

      <div class="documentation-header">

        <span class="section-kicker">
          PROJECT
        </span>

        <h2>
          Live data meets interactive UI.
        </h2>

        <p>
          This weather dashboard combines Astro with
          client-side TypeScript to retrieve live meteorological
          information and present it through a responsive,
          developer-oriented interface.
        </p>

      </div>


      <div class="documentation-grid">

        <article>
          <span>01</span>

          <h3>
            Data source
          </h3>

          <p>
            Weather information comes from the Open-Meteo API
            using geographic coordinates for Alcoi and Valencia.
          </p>
        </article>


        <article>
          <span>02</span>

          <h3>
            Client rendering
          </h3>

          <p>
            The browser retrieves the weather data using the
            native Fetch API and updates the interface dynamically.
          </p>
        </article>


        <article>
          <span>03</span>

          <h3>
            Interactive background
          </h3>

          <p>
            A lightweight Canvas system creates subtle particles,
            connections and an electric-blue atmospheric effect.
          </p>
        </article>


        <article>
          <span>04</span>

          <h3>
            Responsive design
          </h3>

          <p>
            The dashboard adapts from a compact mobile layout
            to a spacious two-column desktop interface.
          </p>
        </article>

      </div>


      <div class="technology-section">

        <span class="section-kicker">
          TECHNOLOGIES
        </span>

        <div class="technology-tags">

          <span>Astro</span>
          <span>TypeScript</span>
          <span>Open-Meteo API</span>
          <span>Fetch API</span>
          <span>HTML</span>
          <span>CSS</span>
          <span>Canvas API</span>

        </div>

      </div>

    </section>


    <!-- ===================================================== -->
    <!-- API -->
    <!-- ===================================================== -->

    <section class="api-section">

      <div class="api-box">

        <div class="api-title">
          <span></span>
          API ENDPOINT
