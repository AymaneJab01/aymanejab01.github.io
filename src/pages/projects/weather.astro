                </span>

                <span class="weather-wind weather-data-value">
                  --
                </span>

              </div>


              <div class="weather-data-item">

                <span class="weather-data-label">
                  Humidity
                </span>

                <span class="weather-humidity weather-data-value">
                  --
                </span>

              </div>


              <div class="weather-data-item">

                <span class="weather-data-label">
                  Updated
