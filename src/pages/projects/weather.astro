      min-height: 65px;
    }
  }

  @media (max-width: 650px) {
    .header-inner,
    .weather-container {
      width: min(100% - 28px, 1200px);
    }

    .weather-container {
      padding-top: 35px;
      padding-bottom: 55px;
    }

    .header-inner {
      min-height: 70px;
    }

    .header-status {
      display: none;
    }

    .location-heading {
      margin-top: 45px;

      align-items: flex-start;
      flex-direction: column;
    }

    .location-heading h1 {
