          data-lon="-0.3763"
          data-city="Valencia"
        >

          <div class="weather-card-glow"></div>

          <div class="weather-card-line"></div>

          <div class="relative z-10">

            <div class="flex items-start justify-between gap-6">

              <div>

                <span class="weather-label">
