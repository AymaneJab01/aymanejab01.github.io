            <!-- Temperature -->

            <div class="mt-12">

              <div class="flex items-end gap-4">

                <span class="weather-temperature">
                  --
                </span>

                <span class="temperature-unit">
                  °C
                </span>

              </div>


              <p class="weather-description mt-3">
                Loading weather...
              </p>

            </div>


            <!-- Weather data -->

            <div class="weather-data-grid">

              <div class="weather-data-item">

                <span class="weather-data-label">
