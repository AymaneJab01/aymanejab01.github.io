    background: white;

    color: var(--muted);
    font-size: 0.75rem;
  }

  .loading-spinner {
    width: 14px;
    height: 14px;

    border: 2px solid #dceaf8;
    border-top-color: var(--blue);
    border-radius: 50%;

    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ==========================================================
     ERROR
  ========================================================== */

  .error-message {
    margin-top: 25px;
    padding: 18px 20px;

    display: flex;
    align-items: center;
    gap: 15px;

    border: 1px solid #ffd6d6;
