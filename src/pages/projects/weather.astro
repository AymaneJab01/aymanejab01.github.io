<!-- WEATHER LOGIC -->

<!-- ============================================================= -->

<script lang="ts">

  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    surface_pressure: number;
    time: string;
  }


  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }


  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  interface LocationData {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  }


  const locations: Record<string, LocationData> = {

    alcoi: {
      name: "Alcoi",
      region: "Alicante, Spain",
      latitude: 38.6983,
      longitude: -0.4743
    },

    valencia: {
      name: "Valencia",
      region: "Valencia, Spain",
      latitude: 39.4699,
      longitude: -0.3763
    }

  };


  let selectedLocation = "alcoi";


  /* ============================================================= */
  /* WEATHER DESCRIPTIONS */
  /* ============================================================= */

  const getDescription = (code: number): string => {

    const descriptions: Record<number, string> = {

      0: "Clear sky",

      1: "Mainly clear",

      2: "Partly cloudy",

      3: "Overcast",

      45: "Fog",

      48: "Rime fog",

      51: "Light drizzle",

      53: "Moderate drizzle",

      55: "Dense drizzle",

      56: "Light freezing drizzle",

      57: "Dense freezing drizzle",

      61: "Light rain",

      63: "Moderate rain",

      65: "Heavy rain",

      66: "Light freezing rain",

      67: "Heavy freezing rain",

      71: "Light snow",

      73: "Moderate snow",

      75: "Heavy snow",

      77: "Snow grains",

      80: "Light rain showers",

      81: "Moderate rain showers",

      82: "Heavy rain showers",

      85: "Light snow showers",

      86: "Heavy snow showers",

      95: "Thunderstorm",

      96: "Thunderstorm with hail",

      99: "Thunderstorm with heavy hail"

    };

    return descriptions[code] ?? "Unknown conditions";
  };


  /* ============================================================= */
  /* WEATHER ICONS */
  /* ============================================================= */

  const getIcon = (code: number): string => {

    if (code === 0) {
      return "☀";
    }

    if (code <= 3) {
      return "☁";
    }

    if (code <= 48) {
      return "≋";
    }

    if (code <= 67) {
      return "☂";
    }

    if (code <= 77) {
      return "❄";
    }

    if (code <= 86) {
      return "☂";
    }

    return "⚡";
  };


  /* ============================================================= */
  /* URL */
  /* ============================================================= */

  const buildWeatherUrl = (
    latitude: number,
    longitude: number
  ): string => {

    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${encodeURIComponent(latitude)}` +
      `&longitude=${encodeURIComponent(longitude)}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m," +
      "surface_pressure" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  };


  /* ============================================================= */
  /* ELEMENTS */
  /* ============================================================= */

  const currentLocation =
    document.querySelector<HTMLElement>(".current-location h2");

  const currentRegion =
    document.querySelector<HTMLElement>(".current-region");

  const currentTemperature =
    document.querySelector<HTMLElement>("#current-temperature");

  const currentIcon =
    document.querySelector<HTMLElement>("#current-icon");

  const currentDescription =
    document.querySelector<HTMLElement>("#current-description");

  const currentFeels =
    document.querySelector<HTMLElement>("#current-feels");

  const currentHumidity =
    document.querySelector<HTMLElement>("#current-humidity");

  const currentWind =
    document.querySelector<HTMLElement>("#current-wind");

  const currentPressure =
    document.querySelector<HTMLElement>("#current-pressure");

  const currentTime =
    document.querySelector<HTMLElement>("#current-time");

  const forecastLocation =
    document.querySelector<HTMLElement>("#forecast-location");

  const forecastContainer =
    document.querySelector<HTMLElement>("#forecast-container");

  const locationButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-location-button]"
    );


  /* ============================================================= */
  /* FORMAT DATE */
  /* ============================================================= */

  const formatDay = (
    dateString: string,
    index: number
  ): string => {

    if (index === 0) {
      return "Today";
    }

    return new Date(
      `${dateString}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short"
      }
    );
  };


  /* ============================================================= */
  /* LOAD WEATHER */
  /* ============================================================= */

  const loadWeather = async (
    locationKey: string
  ): Promise<void> => {

    const location = locations[locationKey];

    if (!location) {
      return;
    }


    if (currentLocation) {
      currentLocation.textContent =
        location.name;
    }


    if (currentRegion) {
      currentRegion.textContent =
        location.region;
    }


    if (forecastLocation) {
      forecastLocation.textContent =
        location.name;
    }


    if (currentDescription) {
      currentDescription.textContent =
        "Loading weather...";
    }


    try {

      const response = await fetch(
        buildWeatherUrl(
          location.latitude,
          location.longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          "Weather request failed"
        );
      }


      const data =
        await response.json() as WeatherResponse;


      const current =
        data.current;


      if (currentTemperature) {

        currentTemperature.textContent =
          String(
            Math.round(
              current.temperature_2m
            )
          );
      }


      if (currentIcon) {

        currentIcon.textContent =
          getIcon(
            current.weather_code
          );
      }


      if (currentDescription) {

        currentDescription.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (currentFeels) {

        currentFeels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°`;
      }


      if (currentHumidity) {

        currentHumidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (currentWind) {

        currentWind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (currentPressure) {

        currentPressure.textContent =
          `${Math.round(
            current.surface_pressure
          )} hPa`;
      }


      if (currentTime) {

        currentTime.textContent =
          new Date(
            current.time
          ).toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit"
            }
          );
      }


      renderForecast(
        data.daily
      );

    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );


      if (currentDescription) {

        currentDescription.textContent =
          "Unable to load weather";
      }


      if (forecastContainer) {

        forecastContainer.innerHTML =
          `<div class="forecast-loading">
            Unable to load forecast.
          </div>`;
      }
    }
  };


  /* ============================================================= */
  /* FORECAST */
  /* ============================================================= */

  const renderForecast = (
    daily: WeatherDaily
  ): void => {

    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML = "";


    daily.time.forEach(
      (
        date,
        index
      ) => {

        const item =
          document.createElement("article");

        item.className =
          "forecast-item";


        const day =
          document.createElement("span");

        day.className =
          "forecast-day";

        day.textContent =
          formatDay(
            date,
            index
          );


        const icon =
          document.createElement("span");

        icon.className =
          "forecast-icon";

        icon.textContent =
          getIcon(
            daily.weather_code[index] ?? 0
          );


        const description =
          document.createElement("span");

        description.className =
          "forecast-description";

        description.textContent =
          getDescription(
            daily.weather_code[index] ?? 0
          );


        const temperatures =
          document.createElement("div");

        temperatures.className =
          "forecast-temperatures";


        const maximum =
          document.createElement("strong");

        maximum.textContent =
          `${Math.round(
            daily.temperature_2m_max[index] ?? 0
          )}°`;


        const minimum =
          document.createElement("span");

        minimum.textContent =
          `${Math.round(
            daily.temperature_2m_min[index] ?? 0
          )}°`;


        temperatures.append(
          maximum,
          minimum
        );


        item.append(
          day,
          icon,
          description,
          temperatures
        );


        forecastContainer.appendChild(
          item
        );
      }
    );
  };


  /* ============================================================= */
  /* LOCATION SWITCHING */
  /* ============================================================= */

  locationButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          const locationKey =
            button.dataset.locationButton;


          if (!locationKey) {
            return;
          }


          selectedLocation =
            locationKey;


          locationButtons.forEach(
            (item) => {

              item.classList.remove(
                "active"
              );
            }
          );


          button.classList.add(
            "active"
          );


          void loadWeather(
            selectedLocation
          );

        }
      );

    }
  );


  /* ============================================================= */
  /* INITIAL LOAD */
  /* ============================================================= */

  void loadWeather(
    selectedLocation
  );

</script>

