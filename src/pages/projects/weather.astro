  .forecast-temperature { gap: 10px; justify-content:end; }.forecast-temperature > strong { color:var(--ink-muted); font-size:15px; font-weight:550; }.forecast-temperature > b { font-size:15px; }.temperature-track { position:relative; width:min(100%,116px); height:6px; overflow:hidden; border-radius:999px; background:linear-gradient(90deg,#d6e8ff,#ffe4b0); }.temperature-track i { position:absolute; top:0; bottom:0; display:block; min-width:9px; border-radius:inherit; background:linear-gradient(90deg,#2389ff,#ffb13b); }.forecast-chevron { color:var(--ink-muted); font-size:20px; transition:transform .2s ease; }.forecast-item.is-open .forecast-chevron{transform:rotate(180deg);}
  .forecast-details { display:none; grid-template-columns:repeat(4,1fr); gap:1px; border-top:1px solid var(--border); background:var(--border); }.forecast-item.is-open .forecast-details { display:grid; }.forecast-details > span { display:grid; gap:5px; padding:15px 24px 18px; background:rgba(248,251,255,.88); }.forecast-details strong { color:var(--ink-soft); font-size:12px; font-weight:600; }.forecast-loading { padding:45px 20px; color:var(--ink-muted); text-align:center; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-size:11px; }

