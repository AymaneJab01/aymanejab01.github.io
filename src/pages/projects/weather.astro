```astro
---
/*
 * WEATHER PAGE
 * ------------------------------------------------------------
 * Live weather powered by Open-Meteo
 * Default location: Alcoi
 *
 * Locations:
 *   - Alcoi
 *   - Torrevieja
 *   - Valencia
 * ------------------------------------------------------------
 */

const locations = {
  Alcoi: {
    name: "Alcoi",
    region: "Alicante, España",
    latitude: 38.6986,
    longitude: -0.4731,
  },
  Torrevieja: {
    name: "Torrevieja",
    region: "Alicante, España",
    latitude: 37.978,
    longitude: -0.682,
  },
  Valencia: {
    name: "Valencia",
    region: "Valencia, España",
    latitude: 39.4699,
    longitude: -0.3763,
  },
} as const;

type LocationKey = keyof typeof locations;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Weather dashboard for Alcoi, Torrevieja and Valencia."
    />
    <title>Weather · Alcoi</title>
  </head>

  <body>
    <main class="weather-page">
      <!-- =====================================================
           BACKGROUND
      ====================================================== -->

      <div class="background-grid"></div>

      <div class="blue-glow blue-glow-one"></div>
      <div class="blue-glow blue-glow-two"></div>

      <!-- =====================================================
           TOP BAR
      ====================================================== -->

      <header class="weather-header">
        <div class="header-inner">
          <a href="/" class="brand">
            <span class="brand-mark">
              <span></span>
              <span></span>
              <span></span>
            </span>

            <span class="brand-text">
              <strong>WEATHER</strong>
              <small>LIVE CONDITIONS</small>
            </span>
          </a>

          <div class="header-status">
            <span class="status-dot"></span>
            <span>LIVE DATA</span>
          </div>
        </div>
      </header>

      <!-- =====================================================
           CONTENT
      ====================================================== -->

      <div class="weather-container">

        <!-- ===================================================
             LOCATION NAVIGATION
        ==================================================== -->

        <section class="location-section">
          <div class="section-label">
            <span class="label-line"></span>
            <span>SELECT LOCATION</span>
          </div>

          <div class="location-tabs" id="locationTabs">
            <button
              type="button"
              class="location-tab active"
              data-location="Alcoi"
            >
              <span class="location-number">01</span>
              <span>
                <strong>Alcoi</strong>
                <small>Alicante</small>
              </span>
              <span class="location-arrow">→</span>
            </button>

            <button
              type="button"
              class="location-tab"
              data-location="Torrevieja"
            >
              <span class="location-number">02</span>
              <span>
                <strong>Torrevieja</strong>
                <small>Alicante</small>
              </span>
              <span class="location-arrow">→</span>
            </button>

            <button
              type="button"
              class="location-tab"
              data-location="Valencia"
            >
              <span class="location-number">03</span>
              <span>
                <strong>Valencia</strong>
                <small>Valencia</small>
              </span>
              <span class="location-arrow">→</span>
            </button>
          </div>
        </section>

        <!-- ===================================================
             LOCATION TITLE
        ==================================================== -->

        <section class="location-heading">
          <div>
            <p class="eyebrow">CURRENT CONDITIONS</p>

            <h1 id="locationName">Alcoi</h1>

            <p class="location-region" id="locationRegion">
              Alicante, España
            </p>
          </div>

          <div class="last-updated">
            <span class="last-updated-label">UPDATED</span>
            <strong id="updatedTime">--:--</strong>
          </div>
        </section>

        <!-- ===================================================
             MAIN WEATHER CARD
        ==================================================== -->

        <section class="hero-weather-card">

          <div class="hero-main">

            <div class="weather-icon-container">
              <div
                class="weather-icon"
                id="mainWeatherIcon"
                aria-label="Weather condition"
              >
                ☀
              </div>
            </div>

            <div class="temperature-area">
              <div class="temperature">
                <span id="currentTemperature">--</span>
                <sup>°C</sup>
              </div>

              <div class="weather-description" id="weatherDescription">
                Loading weather...
              </div>

              <div class="feels-like">
                FEELS LIKE
                <strong id="feelsLike">--°C</strong>
              </div>
            </div>

          </div>

          <div class="hero-side">

            <div class="high-low">
              <div>
                <span>HIGH</span>
                <strong id="todayHigh">--°</strong>
              </div>

              <div class="high-low-divider"></div>

              <div>
                <span>LOW</span>
                <strong id="todayLow">--°</strong>
              </div>
            </div>

            <div class="rain-probability">
              <div class="rain-header">
                <span>PRECIPITATION</span>
                <strong id="rainChance">--%</strong>
              </div>

              <div class="rain-bar">
                <span id="rainBar"></span>
              </div>
            </div>

          </div>

        </section>

        <!-- ===================================================
             HOURLY FORECAST
        ==================================================== -->

        <section class="weather-section">

          <div class="section-heading">
            <div>
              <p class="eyebrow">NEXT HOURS</p>
              <h2>Hourly forecast</h2>
            </div>

            <span class="section-index">01 / 03</span>
          </div>

          <div
            class="hourly-scroll"
            id="hourlyForecast"
            aria-live="polite"
          >
            <div class="loading-card">
              <span class="loading-spinner"></span>
              Loading hourly forecast...
            </div>
          </div>

        </section>

        <!-- ===================================================
             DAILY FORECAST
        ==================================================== -->

        <section class="weather-section">

          <div class="section-heading">
            <div>
              <p class="eyebrow">EXTENDED OUTLOOK</p>
              <h2>7-day forecast</h2>
            </div>

            <span class="section-index">02 / 03</span>
          </div>

          <div
            class="daily-forecast"
            id="dailyForecast"
            aria-live="polite"
          >
            <div class="loading-card">
              <span class="loading-spinner"></span>
              Loading forecast...
            </div>
          </div>

        </section>

        <!-- ===================================================
             WEATHER DETAILS
        ==================================================== -->

        <section class="weather-section">

          <div class="section-heading">
            <div>
              <p class="eyebrow">ATMOSPHERIC DATA</p>
              <h2>Weather details</h2>
            </div>

            <span class="section-index">03 / 03</span>
          </div>

          <div class="details-grid">

            <article class="detail-card">
              <div class="detail-icon">💧</div>
              <div class="detail-content">
                <span>HUMIDITY</span>
                <strong id="humidity">--%</strong>
              </div>
              <small>Relative humidity</small>
            </article>

            <article class="detail-card">
              <div class="detail-icon">↗</div>
              <div class="detail-content">
                <span>WIND</span>
                <strong id="wind">-- km/h</strong>
              </div>
              <small id="windDirection">--</small>
            </article>

            <article class="detail-card">
              <div class="detail-icon">◉</div>
              <div class="detail-content">
                <span>PRESSURE</span>
                <strong id="pressure">-- hPa</strong>
              </div>
              <small>Surface pressure</small>
            </article>

            <article class="detail-card">
              <div class="detail-icon">◎</div>
              <div class="detail-content">
                <span>VISIBILITY</span>
                <strong id="visibility">-- km</strong>
              </div>
              <small>Current visibility</small>
            </article>

            <article class="detail-card">
              <div class="detail-icon">☀</div>
              <div class="detail-content">
                <span>SUNRISE</span>
                <strong id="sunrise">--:--</strong>
              </div>
              <small>Local time</small>
            </article>

            <article class="detail-card">
              <div class="detail-icon">☾</div>
              <div class="detail-content">
                <span>SUNSET</span>
                <strong id="sunset">--:--</strong>
              </div>
              <small>Local time</small>
            </article>

          </div>

        </section>

        <!-- ===================================================
             DATA SOURCE
        ==================================================== -->

        <section class="data-source">
          <div class="source-line"></div>

          <div class="source-content">
            <span class="source-status">
              <span class="status-dot"></span>
              WEATHER SERVICE ONLINE
            </span>

            <span>
              DATA PROVIDED BY OPEN-METEO
            </span>
          </div>
        </section>

        <!-- ===================================================
             ERROR
        ==================================================== -->

        <div
          class="error-message"
          id="errorMessage"
          role="alert"
          hidden
        >
          <strong>Unable to load weather data.</strong>
          <span>Please check your connection and try again.</span>
          <button type="button" id="retryButton">
            RETRY
          </button>
        </div>

      </div>
    </main>
  </body>
</html>

<style>
  /* ==========================================================
     VARIABLES
  ========================================================== */

  :global(:root) {
    --blue: #1687ff;
    --blue-bright: #2995ff;
    --blue-light: #eaf4ff;
    --blue-soft: #f3f8ff;

    --white: #ffffff;
    --black: #07111f;
    --text: #132238;
    --muted: #65758a;
    --border: #dbe7f3;

    --shadow: 0 20px 60px rgba(18, 75, 130, 0.08);
  }

  /* ==========================================================
     RESET
  ========================================================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #f8fbff;
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  button {
    font: inherit;
  }

  /* ==========================================================
     PAGE
  ========================================================== */

  .weather-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 5%,
        rgba(22, 135, 255, 0.09),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f7fbff 55%,
        #ffffff 100%
      );
  }

  .background-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      linear-gradient(
        rgba(22, 135, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(22, 135, 255, 0.035) 1px,
        transparent 1px
      );
    background-size: 50px 50px;
    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 85%
    );
  }

  .blue-glow {
    position: absolute;
    pointer-events: none;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: rgba(22, 135, 255, 0.06);
    filter: blur(80px);
  }

  .blue-glow-one {
    top: 350px;
    right: -200px;
  }

  .blue-glow-two {
    top: 1100px;
    left: -250px;
  }

  /* ==========================================================
     HEADER
  ========================================================== */

  .weather-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid rgba(219, 231, 243, 0.8);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
  }

  .header-inner {
    width: min(1200px, calc(100% - 40px));
    min-height: 82px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;

    color: var(--black);
    text-decoration: none;
  }

  .brand-mark {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }

  .brand-mark span {
    display: block;
    width: 7px;
    border-radius: 2px;
    background: var(--blue);
  }

  .brand-mark span:nth-child(1) {
    height: 13px;
    opacity: 0.45;
  }

  .brand-mark span:nth-child(2) {
    height: 23px;
    opacity: 0.72;
  }

  .brand-mark span:nth-child(3) {
    height: 32px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-text strong {
    font-size: 0.95rem;
    letter-spacing: 0.16em;
  }

  .brand-text small {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.52rem;
    letter-spacing: 0.2em;
  }

  .header-status {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    display: inline-block;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 4px rgba(22, 135, 255, 0.1);
  }

  /* ==========================================================
     CONTAINER
  ========================================================== */

  .weather-container {
    position: relative;
    z-index: 1;
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
    padding: 55px 0 80px;
  }

  /* ==========================================================
     SECTION LABEL
  ========================================================== */

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 17px;

    color: var(--blue);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .label-line {
    width: 28px;
    height: 1px;
    background: var(--blue);
  }

  /* ==========================================================
     LOCATION TABS
  ========================================================== */

  .location-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .location-tab {
    position: relative;

    min-height: 75px;
    padding: 14px 17px;

    display: flex;
    align-items: center;
    gap: 13px;

    border: 1px solid var(--border);
    border-radius: 8px;

    background: rgba(255, 255, 255, 0.75);
    color: var(--text);

    text-align: left;
    cursor: pointer;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .location-tab:hover {
    transform: translateY(-2px);
    border-color: rgba(22, 135, 255, 0.35);
    box-shadow: 0 10px 30px rgba(22, 135, 255, 0.08);
  }

  .location-tab.active {
    border-color: var(--blue);
    background: var(--blue);
    color: white;
    box-shadow: 0 12px 30px rgba(22, 135, 255, 0.18);
  }

  .location-number {
    color: var(--blue);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.62rem;
    font-weight: 700;
  }

  .location-tab.active .location-number {
    color: rgba(255, 255, 255, 0.65);
  }

  .location-tab > span:nth-child(2) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
  }

  .location-tab strong {
    font-size: 0.9rem;
  }

  .location-tab small {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .location-tab.active small {
    color: rgba(255, 255, 255, 0.7);
  }

  .location-arrow {
    font-size: 1rem;
    opacity: 0.7;
    transition: transform 180ms ease;
  }

  .location-tab:hover .location-arrow {
    transform: translateX(4px);
  }

  /* ==========================================================
     LOCATION HEADING
  ========================================================== */

  .location-heading {
    margin-top: 60px;
    margin-bottom: 25px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .eyebrow {
    margin: 0 0 10px;

    color: var(--blue);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .location-heading h1 {
    margin: 0;

    color: var(--black);
    font-size: clamp(2.7rem, 7vw, 5.5rem);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .location-region {
    margin: 12px 0 0;

    color: var(--muted);
    font-size: 0.9rem;
  }

  .last-updated {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 10px 13px;

    border: 1px solid var(--border);
    border-radius: 5px;

    background: rgba(255, 255, 255, 0.75);
  }

  .last-updated-label {
    color: var(--muted);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.57rem;
    letter-spacing: 0.1em;
  }

  .last-updated strong {
    color: var(--blue);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.75rem;
  }

  /* ==========================================================
     HERO WEATHER CARD
  ========================================================== */

  .hero-weather-card {
    position: relative;
    min-height: 330px;

    display: grid;
    grid-template-columns: 1.4fr 0.8fr;

    overflow: hidden;

    border: 1px solid rgba(22, 135, 255, 0.16);
    border-radius: 14px;

    background:
      radial-gradient(
        circle at 18% 40%,
        rgba(22, 135, 255, 0.12),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f5faff 100%
      );

    box-shadow: var(--shadow);
  }

  .hero-weather-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;

    width: 4px;
    height: 100%;

    background: var(--blue);
  }

  .hero-main {
    display: flex;
    align-items: center;
    gap: clamp(25px, 6vw, 75px);

    padding: 50px 55px;
  }

  .weather-icon-container {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 150px;
    height: 150px;

    flex: 0 0 150px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(22, 135, 255, 0.13),
        rgba(22, 135, 255, 0.025) 65%,
        transparent 66%
      );

    border: 1px solid rgba(22, 135, 255, 0.12);
  }

  .weather-icon {
    font-size: 5.4rem;
    line-height: 1;
    filter: drop-shadow(0 10px 25px rgba(22, 135, 255, 0.12));
  }

  .temperature {
    display: flex;
    align-items: flex-start;

    color: var(--black);
    font-size: clamp(5rem, 10vw, 8.2rem);
    font-weight: 250;
    letter-spacing: -0.09em;
    line-height: 0.9;
  }

  .temperature sup {
    margin-top: 12px;
    margin-left: 5px;

    color: var(--blue);
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .weather-description {
    margin-top: 22px;

    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
  }

  .feels-like {
    margin-top: 9px;

    color: var(--muted);
    font-size: 0.67rem;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    letter-spacing: 0.08em;
  }

  .feels-like strong {
    color: var(--text);
    margin-left: 5px;
  }

  .hero-side {
    padding: 45px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 45px;

    border-left: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.45);
  }

  .high-low {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .high-low > div:not(.high-low-divider) {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .high-low span,
  .rain-header span {
    color: var(--muted);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.57rem;
    letter-spacing: 0.13em;
  }

  .high-low strong {
    color: var(--black);
    font-size: 1.65rem;
    font-weight: 500;
  }

  .high-low-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  .rain-probability {
    width: 100%;
  }

  .rain-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .rain-header strong {
    color: var(--blue);
    font-size: 0.9rem;
  }

  .rain-bar {
    width: 100%;
    height: 7px;
    overflow: hidden;
    border-radius: 10px;
    background: #e5eef7;
  }

  .rain-bar span {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: var(--blue);
    transition: width 500ms ease;
  }

  /* ==========================================================
     SECTIONS
  ========================================================== */

  .weather-section {
    margin-top: 80px;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;

    color: var(--black);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .section-index {
    color: #9aaabc;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  /* ==========================================================
     HOURLY
  ========================================================== */

  .hourly-scroll {
    display: flex;
    gap: 9px;

    overflow-x: auto;
    padding: 4px 2px 15px;

    scrollbar-width: thin;
    scrollbar-color: var(--blue) transparent;
  }

  .hour-card {
    min-width: 105px;
    flex: 0 0 auto;

    padding: 17px 12px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;

    border: 1px solid var(--border);
    border-radius: 8px;

    background: white;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
