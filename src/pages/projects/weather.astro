},
};
--

<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Weather dashboard for Alcoi and Torrevieja."
    />
    <title>Weather — Alcoi</title>
  </head>

  <body>
    <main class="weather-page">
      <!-- ========================================================= -->
      <!-- BACKGROUND -->
      <!-- ========================================================= -->

```
  <div class="background">
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="grid-background"></div>
  </div>

  <!-- ========================================================= -->
  <!-- HEADER -->
  <!-- ========================================================= -->

  <header class="weather-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-mark">
          <span></span>
          <span></span>
          <span></span>
        </span>

        <span class="brand-text">
          <strong>WEATHER</strong>
          <small>LOCAL FORECAST</small>
        </span>
      </a>

      <div class="header-status">
        <span class="status-dot"></span>
        <span>LIVE DATA</span>
      </div>
    </div>
  </header>

  <!-- ========================================================= -->
  <!-- CONTENT -->
  <!-- ========================================================= -->

  <section class="weather-shell">

    <!-- LOCATION SELECTOR -->

    <div class="location-bar">
      <div>
        <span class="eyebrow">CURRENT LOCATION</span>

        <h1 id="location-name">
          Alcoi
        </h1>

        <p id="location-region">
          Alicante, España
        </p>
      </div>

      <div class="location-controls">
        <button
          class="location-button active"
          data-location="Alcoi"
          type="button"
        >
          Alcoi
        </button>

        <button
          class="location-button"
          data-location="Torrevieja"
          type="button"
        >
          Torrevieja
        </button>
      </div>
    </div>

    <!-- ======================================================= -->
    <!-- CURRENT WEATHER -->
    <!-- ======================================================= -->

    <section class="current-section">

      <div class="current-card">

        <div class="current-top">
          <div>
            <span class="eyebrow">TODAY</span>

            <div
              id="current-date"
              class="current-date"
            >
              Cargando...
            </div>
          </div>

          <div
            id="current-time"
            class="current-time"
          >
            --:--
          </div>
        </div>

        <div class="current-main">

          <div class="weather-icon-wrap">
            <div
              id="weather-icon"
              class="weather-icon"
            >
              ☀
            </div>
          </div>

          <div class="temperature">
            <span id="temperature">--</span>
            <sup>°C</sup>
          </div>

          <div class="current-description">
            <strong id="description">
              Cargando...
            </strong>

            <span>
              Sensación de
              <b id="feels-like">--</b>°
            </span>
          </div>
        </div>

        <div class="current-details">

          <div class="detail">
            <span class="detail-icon">💧</span>

            <div>
              <small>HUMEDAD</small>
              <strong>
                <span id="humidity">--</span>%
              </strong>
            </div>
          </div>

          <div class="detail">
            <span class="detail-icon">☁</span>

            <div>
              <small>NUBES</small>
              <strong>
                <span id="clouds">--</span>%
              </strong>
            </div>
          </div>

          <div class="detail">
            <span class="detail-icon">☔</span>

            <div>
              <small>PRECIPITACIÓN</small>
              <strong>
                <span id="rain">--</span>%
              </strong>
            </div>
          </div>

          <div class="detail">
            <span class="detail-icon">💨</span>

            <div>
              <small>VIENTO</small>
              <strong>
                <span id="wind">--</span>
                km/h
              </strong>
            </div>
          </div>

        </div>
      </div>

    </section>

    <!-- ======================================================= -->
    <!-- HOURLY -->
    <!-- ======================================================= -->

    <section class="forecast-section">

      <div class="section-heading">
        <div>
          <span class="eyebrow">NEXT HOURS</span>
          <h2>Previsión horaria</h2>
        </div>

        <span class="section-line"></span>
      </div>

      <div
        id="hourly-forecast"
        class="hourly-grid"
      >
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
      </div>

    </section>

    <!-- ======================================================= -->
    <!-- DAILY -->
    <!-- ======================================================= -->

    <section class="forecast-section">

      <div class="section-heading">
        <div>
          <span class="eyebrow">THIS WEEK</span>
          <h2>Previsión de 7 días</h2>
        </div>

        <span class="section-line"></span>
      </div>

      <div
        id="daily-forecast"
        class="daily-grid"
      >
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
        <div class="loading-card"></div>
      </div>

    </section>

    <!-- ======================================================= -->
    <!-- FOOTER -->
    <!-- ======================================================= -->

    <footer class="weather-footer">

      <div>
        <span class="footer-logo">
          WEATHER
        </span>

        <span>
          Local weather dashboard
        </span>
      </div>

      <span>
        DATA · OPEN-METEO
      </span>

    </footer>

  </section>

  <!-- ERROR -->

  <div
    id="error-message"
    class="error-message"
    hidden
  >
    <div class="error-inner">
      <strong>No se pudo cargar el tiempo.</strong>
      <span>
        Inténtalo de nuevo en unos segundos.
      </span>

      <button
        id="retry-button"
        type="button"
      >
        Reintentar
      </button>
    </div>
  </div>
</main>

<script>
  const locations = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },
  };

  let selectedLocation = "Alcoi";

  const locationName =
    document.querySelector("#location-name");

  const locationRegion =
    document.querySelector("#location-region");

  const currentDate =
    document.querySelector("#current-date");

  const currentTime =
    document.querySelector("#current-time");

  const temperature =
    document.querySelector("#temperature");

  const feelsLike =
    document.querySelector("#feels-like");

  const description =
    document.querySelector("#description");

  const weatherIcon =
    document.querySelector("#weather-icon");

  const humidity =
    document.querySelector("#humidity");

  const clouds =
    document.querySelector("#clouds");

  const rain =
    document.querySelector("#rain");

  const wind =
    document.querySelector("#wind");

  const hourlyForecast =
    document.querySelector("#hourly-forecast");

  const dailyForecast =
    document.querySelector("#daily-forecast");

  const errorMessage =
    document.querySelector("#error-message");

  const retryButton =
    document.querySelector("#retry-button");

  /*
   * ------------------------------------------------------------
   * WEATHER CODE
   * ------------------------------------------------------------
   */

  function getWeatherInfo(code) {
    const weather = {
      0: {
        icon: "☀",
        description: "Despejado",
      },

      1: {
        icon: "🌤",
        description: "Principalmente despejado",
      },

      2: {
        icon: "⛅",
        description: "Parcialmente nublado",
      },

      3: {
        icon: "☁",
        description: "Nublado",
      },

      45: {
        icon: "🌫",
        description: "Niebla",
      },

      48: {
        icon: "🌫",
        description: "Niebla",
      },

      51: {
        icon: "🌦",
        description: "Llovizna ligera",
      },

      53: {
        icon: "🌦",
        description: "Llovizna",
      },

      55: {
        icon: "🌧",
        description: "Llovizna intensa",
      },

      61: {
        icon: "🌧",
        description: "Lluvia ligera",
      },

      63: {
        icon: "🌧",
        description: "Lluvia",
      },

      65: {
        icon: "🌧",
        description: "Lluvia intensa",
      },

      71: {
        icon: "🌨",
        description: "Nieve ligera",
      },

      73: {
        icon: "❄",
        description: "Nieve",
      },

      75: {
        icon: "❄",
        description: "Nieve intensa",
      },

      80: {
        icon: "🌦",
        description: "Chubascos ligeros",
      },

      81: {
        icon: "🌧",
        description: "Chubascos",
      },

      82: {
        icon: "⛈",
        description: "Chubascos intensos",
      },

      95: {
        icon: "⛈",
        description: "Tormenta",
      },

      96: {
        icon: "⛈",
        description: "Tormenta con granizo",
      },

      99: {
        icon: "⛈",
        description: "Tormenta intensa",
      },
    };

    return (
      weather[code] || {
        icon: "☁",
        description: "Condiciones variables",
      }
    );
  }

  /*
   * ------------------------------------------------------------
   * DATE HELPERS
   * ------------------------------------------------------------
   */

  function formatHour(value) {
    const date = new Date(value);

    return date.toLocaleTimeString("es-ES", {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function formatDay(value, index) {
    if (index === 0) {
      return "Hoy";
    }

    const date = new Date(`${value}T12:00:00`);

    return date.toLocaleDateString("es-ES", {
      weekday: "short",
    });
  }

  function formatDate(value) {
    const date = new Date(`${value}T12:00:00`);

    return date.toLocaleDateString("es-ES", {
      weekday: "long",
      day: "numeric",
      month: "long",
    });
  }

  /*
   * ------------------------------------------------------------
   * UPDATE CLOCK
   * ------------------------------------------------------------
   */

  function updateClock() {
    const now = new Date();

    currentTime.textContent =
      now.toLocaleTimeString("es-ES", {
        hour: "2-digit",
        minute: "2-digit",
      });
  }

  updateClock();

  setInterval(updateClock, 1000);

  /*
   * ------------------------------------------------------------
   * API
   * ------------------------------------------------------------
   */

  async function loadWeather(locationKey) {
    const location = locations[locationKey];

    if (!location) {
      return;
    }

    errorMessage.hidden = true;

    locationName.textContent = location.name;
    locationRegion.textContent = location.region;

    const url =
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${location.latitude}` +
      `&longitude=${location.longitude}` +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation_probability,cloud_cover,wind_speed_10m,weather_code" +
      "&hourly=temperature_2m,precipitation_probability,weather_code" +
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max" +
      "&timezone=auto" +
      "&forecast_days=7";

    try {
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Weather request failed");
      }

      const data = await response.json();

      renderCurrent(data);
      renderHourly(data);
      renderDaily(data);

      document.title =
        `Weather — ${location.name}`;

    } catch (error) {
      console.error(error);
      errorMessage.hidden = false;
    }
  }

  /*
   * ------------------------------------------------------------
   * CURRENT
   * ------------------------------------------------------------
   */

  function renderCurrent(data) {
    const current = data.current;

    const weather =
      getWeatherInfo(current.weather_code);

    temperature.textContent =
      Math.round(current.temperature_2m);

    feelsLike.textContent =
      Math.round(current.apparent_temperature);

    humidity.textContent =
      Math.round(current.relative_humidity_2m);

    clouds.textContent =
      Math.round(current.cloud_cover);

    rain.textContent =
      Math.round(current.precipitation_probability);

    wind.textContent =
      Math.round(current.wind_speed_10m);

    weatherIcon.textContent =
      weather.icon;

    description.textContent =
      weather.description;

    currentDate.textContent =
      formatDate(
        new Date().toISOString().split("T")[0]
      );
  }

  /*
   * ------------------------------------------------------------
   * HOURLY
   * ------------------------------------------------------------
   */

  function renderHourly(data) {
    const times =
      data.hourly.time;

    const temperatures =
      data.hourly.temperature_2m;

    const precipitation =
      data.hourly.precipitation_probability;

    const codes =
      data.hourly.weather_code;

    const now =
      new Date();

    let startIndex = 0;

    for (
      let i = 0;
      i < times.length;
      i++
    ) {
      if (
        new Date(times[i]) >= now
      ) {
        startIndex = i;
        break;
      }
    }

    hourlyForecast.innerHTML = "";

    const endIndex =
      Math.min(
        startIndex + 8,
        times.length
      );

    for (
      let i = startIndex;
      i < endIndex;
      i++
    ) {
      const weather =
        getWeatherInfo(codes[i]);

      const card =
        document.createElement("article");

      card.className =
        "hour-card";

      if (i === startIndex) {
        card.classList.add("current");
      }

      card.innerHTML = `
        <span class="hour-time">
          ${
            i === startIndex
              ? "Ahora"
              : formatHour(times[i])
          }
        </span>

        <span class="hour-icon">
          ${weather.icon}
        </span>

        <strong class="hour-temperature">
          ${Math.round(temperatures[i])}°
        </strong>

        <span class="hour-rain">
          ${Math.round(precipitation[i])}% lluvia
        </span>
      `;

      hourlyForecast.appendChild(card);
    }
  }

  /*
   * ------------------------------------------------------------
   * DAILY
   * ------------------------------------------------------------
   */

  function renderDaily(data) {
    const days =
      data.daily.time;

    const maxTemps =
      data.daily.temperature_2m_max;

    const minTemps =
      data.daily.temperature_2m_min;

    const rainProbability =
      data.daily.precipitation_probability_max;

    const codes =
      data.daily.weather_code;

    dailyForecast.innerHTML = "";

    for (
      let i = 0;
      i < days.length;
      i++
    ) {
      const weather =
        getWeatherInfo(codes[i]);

      const card =
        document.createElement("article");

      card.className =
        "daily-card";

      card.innerHTML = `
        <div class="daily-day">
          <strong>
            ${formatDay(days[i], i)}
          </strong>

          <span>
            ${formatDate(days[i])}
          </span>
        </div>

        <div class="daily-icon">
          ${weather.icon}
        </div>

        <div class="daily-description">
          ${weather.description}
        </div>

        <div class="daily-temperature">
          <strong>
            ${Math.round(maxTemps[i])}°
          </strong>

          <span>
            ${Math.round(minTemps[i])}°
          </span>
        </div>

        <div class="daily-rain">
          ☔ ${Math.round(rainProbability[i])}%
        </div>
      `;

      dailyForecast.appendChild(card);
    }
  }

  /*
   * ------------------------------------------------------------
   * LOCATION BUTTONS
   * ------------------------------------------------------------
   */

  document
    .querySelectorAll(".location-button")
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const location =
            button.dataset.location;

          if (!location) {
            return;
          }

          selectedLocation =
            location;

          document
            .querySelectorAll(
              ".location-button"
            )
            .forEach((item) => {
              item.classList.remove(
                "active"
              );
            });

          button.classList.add("active");

          loadWeather(
            selectedLocation
          );
        }
      );
    });

  /*
   * ------------------------------------------------------------
   * RETRY
   * ------------------------------------------------------------
   */

  retryButton.addEventListener(
    "click",
    () => {
      loadWeather(
        selectedLocation
      );
    }
  );

  /*
   * ------------------------------------------------------------
   * INITIAL LOCATION
   * ------------------------------------------------------------
   */

  loadWeather("Alcoi");
</script>
```

  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #f5faff;
    color: #102033;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(button) {
    font: inherit;
  }

  .weather-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 10% 0%,
        rgba(0, 145, 255, 0.12),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 15%,
        rgba(0, 102, 255, 0.1),
        transparent 25%
      ),
      #f7fbff;
  }

  /* ============================================================= */
  /* BACKGROUND */
  /* ============================================================= */

  .background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .grid-background {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        rgba(0, 130, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 130, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 80%
      );
  }

  .orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
    opacity: 0.4;
    animation: floatingOrb 12s ease-in-out infinite;
  }

  .orb-one {
    width: 420px;
    height: 420px;
    top: -180px;
    left: -160px;
    background: rgba(0, 153, 255, 0.2);
  }

  .orb-two {
    width: 360px;
    height: 360px;
    right: -140px;
    top: 360px;
    background: rgba(0, 100, 255, 0.14);
    animation-delay: -5s;
  }

  @keyframes floatingOrb {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(30px, -25px, 0);
    }
  }

  /* ============================================================= */
  /* HEADER */
  /* ============================================================= */

  .weather-header {
    position: relative;
    z-index: 2;
    height: 82px;

    border-bottom:
      1px solid rgba(0, 115, 230, 0.1);

    background:
      rgba(255, 255, 255, 0.72);

    backdrop-filter: blur(18px);
  }

  .header-inner {
    width:
      min(1380px, calc(100% - 48px));

    height: 100%;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;

    text-decoration: none;
    color: #0c1b2a;
  }

  .brand-mark {
    position: relative;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;

    border-radius: 10px;

    background:
      linear-gradient(
        135deg,
        #008cff,
        #0066ff
      );

    box-shadow:
      0 8px 24px
      rgba(0, 119, 255, 0.24);
  }

  .brand-mark span {
    width: 3px;
    border-radius: 5px;
    background: white;
  }

  .brand-mark span:nth-child(1) {
    height: 10px;
  }

  .brand-mark span:nth-child(2) {
    height: 17px;
  }

  .brand-mark span:nth-child(3) {
    height: 13px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .brand-text strong {
    font-size: 13px;
    letter-spacing: 0.15em;
  }

  .brand-text small {
    color: #71869a;
    font-size: 8px;
    letter-spacing: 0.2em;
  }

  .header-status {
    display: flex;
    align-items: center;
    gap: 8px;

    color: #6b8298;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #008cff;

    box-shadow:
      0 0 0 5px
      rgba(0, 140, 255, 0.08),
      0 0 18px
      rgba(0, 140, 255, 0.5);

    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.45;
    }
  }

  /* ============================================================= */
  /* SHELL */
  /* ============================================================= */

  .weather-shell {
    position: relative;
    z-index: 1;

    width:
      min(1380px, calc(100% - 48px));

    margin: 0 auto;
    padding: 50px 0 80px;
  }

  /* ============================================================= */
  /* LOCATION */
  /* ============================================================= */

  .location-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 28px;
  }

  .eyebrow {
    display: block;

    margin-bottom: 8px;

    color: #0788ed;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .location-bar h1 {
    margin: 0;

    color: #0c1c2d;

    font-size: clamp(38px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .location-bar p {
    margin: 10px 0 0;

    color: #75899c;

    font-size: 14px;
  }

  .location-controls {
    display: flex;
    gap: 7px;

    padding: 5px;

    border:
      1px solid rgba(0, 120, 240, 0.12);

    border-radius: 14px;

    background:
      rgba(255, 255, 255, 0.78);

    box-shadow:
      0 10px 35px
      rgba(33, 82, 125, 0.06);
  }

  .location-button {
    border: 0;
    border-radius: 10px;

    padding: 11px 18px;

    background: transparent;

    color: #71869a;

    cursor: pointer;

    font-size: 12px;
    font-weight: 700;

    transition:
