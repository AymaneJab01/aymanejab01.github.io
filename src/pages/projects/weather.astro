    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header class="mb-14 md:mb-20">

      <div class="mb-6 flex items-center gap-3">

        <span
          class="h-2 w-2 rounded-full bg-[#35baff] shadow-[0_0_18px_rgba(53,186,255,0.8)]"
        ></span>

        <span class="project-label">
          Project 03 / Weather
        </span>

      </div>


      <h1
        class="max-w-4xl text-4xl font-medium tracking-tight md:text-6xl lg:text-7xl"
      >
        Weather Dashboard<span class="electric-dot">.</span>
      </h1>


      <p class="hero-description">
        A real-time weather interface for Alcoi and Valencia,
        combining live meteorological data with an interactive
        developer-oriented visual system.
      </p>


      <div class="mt-8 flex flex-wrap gap-2">

        <span class="doc-tag">Astro</span>

        <span class="doc-tag">TypeScript</span>

        <span class="doc-tag">Open-Meteo</span>

        <span class="doc-tag">Canvas</span>

        <span class="doc-tag">REST API</span>

      </div>

    </header>


    <!-- ===================================================== -->
    <!-- LIVE WEATHER -->
    <!-- ===================================================== -->

    <section aria-labelledby="live-weather-title">

      <div class="mb-7">

