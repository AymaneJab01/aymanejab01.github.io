<!doctype html>

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Weather dashboard for Alcoi and Torrevieja."
    />
    <title>Weather — Alcoi</title>
  </head>

  <body>
    <main class="weather-page">
      <!-- ===================================================== -->
      <!-- BACKGROUND -->
      <!-- ===================================================== -->

```
  <div class="weather-background" aria-hidden="true">
    <div class="blue-orb orb-one"></div>
    <div class="blue-orb orb-two"></div>
    <div class="blue-orb orb-three"></div>

    <div class="blue-grid"></div>
    <div class="blue-glow"></div>
  </div>

  <!-- ===================================================== -->
  <!-- HEADER -->
  <!-- ===================================================== -->

  <header class="weather-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-mark">
          <span></span>
          <span></span>
          <span></span>
        </span>

        <span class="brand-text">
          <strong>WEATHER</strong>
          <small>LIVE CONDITIONS</small>
        </span>
      </a>

      <div class="header-actions">
        <div class="live-indicator">
          <span></span>
          LIVE
        </div>

        <div class="location-selector">
          <button
            id="locationButton"
            class="location-button"
            type="button"
            aria-expanded="false"
          >
            <span class="location-pin">⌖</span>
            <span id="headerLocation">Alcoi</span>
            <span class="chevron">⌄</span>
          </button>

          <div
            id="locationMenu"
            class="location-menu"
            aria-hidden="true"
          >
            <button
              type="button"
              class="location-option active"
              data-location="Alcoi"
            >
              <span>Alcoi</span>
              <small>Alicante</small>
            </button>

            <button
              type="button"
              class="location-option"
              data-location="Torrevieja"
            >
              <span>Torrevieja</span>
              <small>Alicante</small>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ===================================================== -->
  <!-- MAIN -->
  <!-- ===================================================== -->

  <section class="weather-shell">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <span>Weather</span>
      <span class="breadcrumb-arrow">/</span>
      <span id="breadcrumbLocation">Alcoi</span>
    </div>

    <!-- =================================================== -->
    <!-- CURRENT WEATHER -->
    <!-- =================================================== -->

    <section class="current-section">

      <div class="current-main">

        <div class="location-heading">
          <span class="eyebrow">CURRENT CONDITIONS</span>

          <h1 id="locationTitle">
            Alcoi
          </h1>

          <p id="locationRegion">
            Alicante, España
          </p>
        </div>

        <div class="temperature-row">

          <div
            id="weatherIcon"
            class="weather-icon"
            aria-hidden="true"
          >
            ☀
          </div>

          <div class="temperature">
            <span id="temperature">--</span>
            <sup>°C</sup>
          </div>

        </div>

        <div class="condition" id="condition">
          Cargando condiciones...
        </div>

        <div class="feels-like">
          Sensación térmica
          <strong id="feelsLike">--°</strong>
        </div>

        <div class="updated">
          Actualizado
          <span id="updatedTime">--:--</span>
        </div>

      </div>

      <!-- Current details -->

      <div class="current-details">

        <div class="detail-card">
          <span class="detail-icon">💧</span>
          <div>
            <small>HUMEDAD</small>
            <strong id="humidity">--%</strong>
          </div>
        </div>

        <div class="detail-card">
          <span class="detail-icon">↗</span>
          <div>
            <small>VIENTO</small>
            <strong>
              <span id="wind">--</span>
              <small class="unit">km/h</small>
            </strong>
          </div>
        </div>

        <div class="detail-card">
          <span class="detail-icon">◉</span>
          <div>
            <small>PRESIÓN</small>
            <strong>
              <span id="pressure">--</span>
              <small class="unit">hPa</small>
            </strong>
          </div>
        </div>

        <div class="detail-card">
          <span class="detail-icon">◌</span>
          <div>
            <small>VISIBILIDAD</small>
            <strong>
              <span id="visibility">--</span>
              <small class="unit">km</small>
            </strong>
          </div>
        </div>

        <div class="detail-card">
          <span class="detail-icon">☁</span>
          <div>
            <small>NUBOSIDAD</small>
            <strong id="cloudCover">--%</strong>
          </div>
        </div>

        <div class="detail-card">
          <span class="detail-icon">☂</span>
          <div>
            <small>PRECIPITACIÓN</small>
            <strong id="precipitation">--%</strong>
          </div>
        </div>

      </div>
    </section>

    <!-- =================================================== -->
    <!-- HOURLY -->
    <!-- =================================================== -->

    <section class="forecast-section">

      <div class="section-heading">
        <div>
          <span class="eyebrow">FORECAST</span>
          <h2>Hourly weather</h2>
        </div>

        <span class="section-meta">
          Próximas horas
        </span>
      </div>

      <div
        id="hourlyList"
        class="hourly-list"
      >
        <div class="loading-card">
          <div class="loading-line"></div>
          <div class="loading-line short"></div>
        </div>

        <div class="loading-card">
          <div class="loading-line"></div>
          <div class="loading-line short"></div>
        </div>

        <div class="loading-card">
          <div class="loading-line"></div>
          <div class="loading-line short"></div>
        </div>
      </div>

    </section>

    <!-- =================================================== -->
    <!-- DAILY -->
    <!-- =================================================== -->

    <section class="forecast-section daily-section">

      <div class="section-heading">
        <div>
          <span class="eyebrow">OUTLOOK</span>
          <h2>7-day forecast</h2>
        </div>

        <span class="section-meta">
          Próximos 7 días
        </span>
      </div>

      <div
        id="dailyList"
        class="daily-list"
      >
        <div class="daily-loading"></div>
        <div class="daily-loading"></div>
        <div class="daily-loading"></div>
      </div>

    </section>

    <!-- =================================================== -->
    <!-- FOOTER INFO -->
    <!-- =================================================== -->

    <section class="weather-info">

      <div class="info-left">
        <span class="info-dot"></span>

        <div>
          <strong>LIVE WEATHER DATA</strong>
          <p>
            Datos meteorológicos actualizados automáticamente.
          </p>
        </div>
      </div>

      <div class="info-right">
        <span>ALCOI</span>
        <span class="info-separator">•</span>
        <span>TORREVIEJA</span>
      </div>

    </section>

  </section>
</main>
```

  </body>
</html>

<style>
  /* ============================================================
     VARIABLES
     ============================================================ */

  :root {
    --blue: #008cff;
    --blue-dark: #006edc;
    --blue-light: #42b5ff;
    --blue-pale: #eaf7ff;

    --ink: #102033;
    --muted: #6f8195;
    --border: #dfe9f2;

    --white: #ffffff;
    --surface: #f7fbff;

    --shadow:
      0 20px 60px rgba(0, 105, 190, 0.08);

    --radius: 24px;
  }

  /* ============================================================
     RESET
     ============================================================ */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    color: var(--ink);
    background: #ffffff;
  }

  button,
  a {
    font: inherit;
  }

  button {
    border: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ============================================================
     PAGE
     ============================================================ */

  .weather-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(0, 140, 255, 0.09),
        transparent 42%
      ),
      #ffffff;
  }

  /* ============================================================
     BLUE ATMOSPHERE
     ============================================================ */

  .weather-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .blue-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
    opacity: 0.5;
    will-change: transform;
  }

  .orb-one {
    width: 480px;
    height: 480px;
    top: -270px;
    left: 12%;
    background:
      radial-gradient(
        circle,
        rgba(0, 140, 255, 0.26) 0%,
        rgba(0, 140, 255, 0.11) 35%,
        transparent 70%
      );
    animation: floatOne 12s ease-in-out infinite;
  }

  .orb-two {
    width: 620px;
    height: 620px;
    top: 170px;
    right: -350px;
    background:
      radial-gradient(
        circle,
        rgba(0, 153, 255, 0.18),
        transparent 68%
      );
    animation: floatTwo 16s ease-in-out infinite;
  }

  .orb-three {
    width: 420px;
    height: 420px;
    bottom: -300px;
    left: 30%;
    background:
      radial-gradient(
        circle,
        rgba(0, 111, 255, 0.13),
        transparent 68%
      );
    animation: floatThree 14s ease-in-out infinite;
  }

  .blue-grid {
    position: absolute;
    inset: 0;

    opacity: 0.26;

    background-image:
      linear-gradient(
        rgba(0, 140, 255, 0.07) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 140, 255, 0.07) 1px,
        transparent 1px
      );

    background-size: 80px 80px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 80%
      );
  }

  .blue-glow {
    position: absolute;

    width: 70%;
    height: 240px;

    top: 0;
    left: 15%;

    background:
      radial-gradient(
        ellipse,
        rgba(0, 140, 255, 0.11),
        transparent 70%
      );

    filter: blur(25px);
  }

  @keyframes floatOne {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(50px, 25px, 0);
    }
  }

  @keyframes floatTwo {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(-45px, -25px, 0);
    }
  }

  @keyframes floatThree {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(35px, -35px, 0);
    }
  }

  /* ============================================================
     HEADER
     ============================================================ */

  .weather-header {
    position: relative;
    z-index: 10;

    border-bottom: 1px solid
      rgba(215, 228, 239, 0.85);

    background:
      rgba(255, 255, 255, 0.86);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    width: min(1380px, calc(100% - 48px));
    margin: 0 auto;

    min-height: 82px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    position: relative;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;

    border-radius: 10px;

    background:
      linear-gradient(
        145deg,
        var(--blue),
        #005dcc
      );

    box-shadow:
      0 8px 25px
      rgba(0, 140, 255, 0.28);
  }

  .brand-mark span {
    width: 3px;
    border-radius: 4px;
    background: white;
  }

  .brand-mark span:nth-child(1) {
    height: 9px;
  }

  .brand-mark span:nth-child(2) {
    height: 16px;
  }

  .brand-mark span:nth-child(3) {
    height: 12px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-text strong {
    font-size: 13px;
    letter-spacing: 0.12em;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 7px;

    color: #607487;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .live-indicator span {
    width: 7px;
    height: 7px;

    border-radius: 50%;
    background: #14c97b;

    box-shadow:
      0 0 0 4px rgba(20, 201, 123, 0.11);
  }

  .location-selector {
    position: relative;
  }

  .location-button {
    min-width: 165px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    padding: 11px 15px;

    cursor: pointer;

    color: var(--ink);
    background: #ffffff;

    border: 1px solid var(--border);
    border-radius: 12px;

    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .location-button:hover {
    border-color: rgba(0, 140, 255, 0.45);

    box-shadow:
      0 8px 25px
      rgba(0, 120, 220, 0.09);

    transform: translateY(-1px);
  }

  .location-pin {
    color: var(--blue);
    font-size: 18px;
  }

  .location-button #headerLocation {
    flex: 1;
    text-align: left;

    font-size: 12px;
    font-weight: 750;
  }

  .chevron {
    color: #7e91a5;
    font-size: 15px;
  }

  .location-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;

    width: 220px;

    padding: 7px;

    opacity: 0;
    visibility: hidden;
    transform: translateY(-7px);

    background: rgba(255, 255, 255, 0.98);

    border: 1px solid var(--border);
    border-radius: 15px;

    box-shadow:
      0 18px 50px
      rgba(30, 80, 120, 0.14);

    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 180ms ease;
  }

  .location-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .location-option {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 12px;

    cursor: pointer;

    text-align: left;

    color: var(--ink);
    background: transparent;

    border-radius: 10px;

    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .location-option:hover,
  .location-option.active {
    color: var(--blue);
    background: var(--blue-pale);
  }

  .location-option span {
    font-size: 12px;
    font-weight: 750;
  }

  .location-option small {
    color: #8ca0b2;
    font-size: 9px;
  }

  /* ============================================================
     CONTENT SHELL
     ============================================================ */

  .weather-shell {
    position: relative;
    z-index: 2;

    width: min(1380px, calc(100% - 48px));

    margin: 0 auto;
    padding: 34px 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 38px;

    color: #91a1b1;

    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .breadcrumb-arrow {
    color: #b9c6d2;
  }

  #breadcrumbLocation {
    color: var(--blue);
  }

  /* ============================================================
     CURRENT SECTION
     ============================================================ */

  .current-section {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(360px, 0.8fr);

    gap: 45px;

    padding: 50px;

    background:
      rgba(255, 255, 255, 0.82);

    border: 1px solid
      rgba(215, 228, 239, 0.9);

    border-radius: 30px;

    box-shadow:
      0 30px 90px
      rgba(0, 100, 190, 0.07);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .current-main {
    min-width: 0;
  }

  .eyebrow {
    display: block;

    margin-bottom: 10px;

    color: var(--blue);

    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.17em;
  }

  .location-heading h1 {
    margin: 0;

    color: var(--ink);

    font-size:
      clamp(42px, 5vw, 72px);

    line-height: 0.95;

    letter-spacing: -0.055em;
  }

  .location-heading p {
    margin: 13px 0 0;

    color: var(--muted);

    font-size: 14px;
    font-weight: 550;
  }

  .temperature-row {
    display: flex;
    align-items: center;
    gap: 25px;

    margin-top: 42px;
  }

  .weather-icon {
    width: 105px;
    height: 105px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--blue);

    font-size: 64px;

    background:
      radial-gradient(
        circle,
        rgba(0, 140, 255, 0.13),
        rgba(0, 140, 255, 0.025) 65%,
        transparent 70%
      );

    border-radius: 50%;

    filter:
      drop-shadow(
        0 12px 25px
        rgba(0, 140, 255, 0.12)
      );

    animation:
      iconFloat 4s ease-in-out infinite;
  }

  @keyframes iconFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }
  }

  .temperature {
    color: var(--ink);

    font-size:
      clamp(82px, 10vw, 145px);

    font-weight: 250;

    line-height: 0.85;

    letter-spacing: -0.075em;
  }

  .temperature sup {
    position: relative;
    top: -0.75em;

    margin-left: 4px;

    color: var(--blue);

    font-size: 0.27em;
    font-weight: 650;

    letter-spacing: 0;
  }

  .condition {
    margin-top: 28px;

    color: var(--ink);

    font-size: 19px;
    font-weight: 700;
  }

  .feels-like {
    margin-top: 7px;

    color: var(--muted);

    font-size: 12px;
  }

  .feels-like strong {
    margin-left: 5px;

    color: var(--ink);
  }

  .updated {
    margin-top: 28px;

    color: #91a1b1;

    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.03em;
  }

  .updated span {
    color: var(--blue);
  }

  /* ============================================================
     DETAILS
     ============================================================ */

  .current-details {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    align-content: center;

    gap: 12px;
  }

  .detail-card {
    min-height: 115px;

    display: flex;
    align-items: center;

    gap: 13px;

    padding: 18px;

    background:
      rgba(248, 252, 255, 0.82);

    border: 1px solid
      rgba(220, 232, 241, 0.95);

    border-radius: 17px;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .detail-card:hover {
    transform: translateY(-3px);

    border-color:
      rgba(0, 140, 255, 0.25);

    box-shadow:
      0 14px 35px
      rgba(0, 110, 210, 0.08);
  }

  .detail-icon {
    width: 39px;
    height: 39px;

    flex: 0 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--blue);

    background: #eaf7ff;

    border-radius: 11px;

    font-size: 17px;
  }

  .detail-card div {
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .detail-card div > small {
    color: #91a2b2;

    font-size: 8px;
    font-weight: 850;
    letter-spacing: 0.13em;
  }

  .detail-card strong {
    color: var(--ink);

    font-size: 17px;
    font-weight: 720;
  }

  .detail-card .unit {
    color: #899bad;

    font-size: 9px;
    font-weight: 650;
  }

  /* ============================================================
     FORECAST
     ============================================================ */

  .forecast-section {
    margin-top: 75px;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 25px;
  }

  .section-heading .eyebrow {
    margin-bottom: 7px;
  }

  .section-heading h2 {
    margin: 0;

    color: var(--ink);

    font-size: 28px;
    font-weight: 650;

    letter-spacing: -0.035em;
  }

  .section-meta {
    color: #8b9dad;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ============================================================
     HOURLY
     ============================================================ */

  .hourly-list {
    display: grid;

    grid-template-columns:
      repeat(8, minmax(100px, 1fr));

    overflow-x: auto;

    background: rgba(255, 255, 255, 0.9);

    border: 1px solid var(--border);
    border-radius: 23px;

    box-shadow: var(--shadow);
  }

  .hour-card {
    min-height: 180px;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 22px 12px;

    border-right: 1px solid
      #e6eef5;

    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .hour-card:last-child {
    border-right: 0;
  }

  .hour-card:hover {
    background: #f4faff;
    transform: translateY(-2px);
  }

  .hour-card.current {
    background:
      linear-gradient(
        180deg,
        #eaf7ff,
        #ffffff
      );
  }

  .hour-time {
    color: #8a9bab;

    font-size: 10px;
    font-weight: 750;
    text-transform: uppercase;
  }

  .hour-card.current .hour-time {
    color: var(--blue);
  }

  .hour-icon {
    height: 62px;

    display: flex;
    align-items: center;

    margin: 12px 0;

    color: var(--blue);

    font-size: 34px;
  }

  .hour-temp {
    color: var(--ink);

    font-size: 22px;
    font-weight: 680;
  }

  .hour-rain {
    margin-top: 7px;

    color: #76a8c9;

    font-size: 9px;
    font-weight: 700;
  }

  /* ============================================================
     DAILY
     ============================================================ */

  .daily-list {
    overflow: hidden;

    background: rgba(255, 255, 255, 0.92);

    border: 1px solid var(--border);
    border-radius: 23px;

    box-shadow: var(--shadow);
  }

  .daily-card {
    min-height: 85px;

    display: grid;

    grid-template-columns:
      1.2fr
      0.8fr
      0.8fr
      0.8fr
      0.8fr;

    align-items: center;

    gap: 20px;

    padding: 17px 25px;

    border-bottom: 1px solid
      #e7eef4;
  }

  .daily-card:last-child {
    border-bottom: 0;
  }

  .daily-card:hover {
    background: #f9fcff;
  }

  .daily-day {
    color: var(--ink);

    font-size: 12px;
    font-weight: 750;
  }

  .daily-date {
    display: block;

    margin-top: 4px;

    color: #91a0ae;

    font-size: 9px;
    font-weight: 600;
  }

  .daily-condition {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .daily-icon {
    color: var(--blue);
    font-size: 24px;
  }

  .daily-description {
    color: #718395;

    font-size: 10px;
    font-weight: 650;
  }

  .daily-rain {
    color: #65a4ca;

    font-size: 10px;
    font-weight: 700;
  }

  .daily-temps {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .daily-high {
    color: var(--ink);

    font-size: 15px;
    font-weight: 750;
  }

  .daily-low {
    color: #8c9eaf;

    font-size: 13px;
  }

  .temperature-bar {
    position: relative;

    width: 100%;
    max-width: 130px;
    height: 5px;

    overflow: hidden;

    background: #e8f0f6;

    border-radius: 10px;
  }

  .temperature-fill {
    position: absolute;

    height: 100%;

    border-radius: inherit;

    background:
      linear-gradient(
        90deg,
        #66c3ff,
        var(--blue)
      );
  }

  /* ============================================================
     LOADING
     ============================================================ */

  .loading-card {
    min-width: 130px;

    min-height: 180px;

    padding: 25px;

    border-right: 1px solid var(--border);
  }

  .loading-line,
  .daily-loading {
    overflow: hidden;

    background:
      linear-gradient(
        90deg,
        #edf3f8,
        #f9fcff,
        #edf3f8
      );

    background-size: 200% 100%;

    animation: loading 1.5s linear infinite;
  }

  .loading-line {
    width: 55px;
    height: 8px;

    margin-bottom: 35px;

    border-radius: 5px;
  }

  .loading-line.short {
    width: 35px;
    margin-top: 50px;
  }

  .daily-loading {
    height: 85px;

    border-bottom: 1px solid white;
  }

  @keyframes loading {
    to {
      background-position: -200% 0;
    }
  }

  /* ============================================================
     INFO
     ============================================================ */

  .weather-info {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 50px;
    padding-top: 25px;

    border-top: 1px solid
      rgba(220, 230, 238, 0.9);
  }

  .info-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .info-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--blue);

    box-shadow:
      0 0 0 5px
      rgba(0, 140, 255, 0.08);
  }

  .info-left strong {
    display: block;

    color: var(--ink);

    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .info-left p {
    margin: 4px 0 0;

    color: #8d9cab;

    font-size: 9px;
  }

  .info-right {
    display: flex;
    align-items: center;
    gap: 9px;

    color: #93a2b0;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .info-right span:first-child {
    color: var(--blue);
  }

  .info-separator {
    color: #c2cdd6;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */

  @media (max-width: 1050px) {
    .current-section {
      grid-template-columns: 1fr;
    }

    .current-details {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

    .hourly-list {
      grid-template-columns:
        repeat(8, 125px);
    }
  }

  @media (max-width: 720px) {
    .header-inner,
    .weather-shell {
      width: min(100% - 28px, 1380px);
    }

    .header-inner {
      min-height: 72px;
    }

    .brand-text {
      display: none;
    }

    .live-indicator {
      display: none;
    }

    .location-button {
      min-width: 145px;
    }

    .weather-shell {
      padding-top: 24px;
    }

    .breadcrumb {
      margin-bottom: 24px;
    }

    .current-section {
      padding: 28px 22px;
      border-radius: 22px;
    }

    .temperature-row {
      gap: 15px;
      margin-top: 30px;
    }

    .weather-icon {
      width: 75px;
      height: 75px;
      font-size: 45px;
    }

    .temperature {
      font-size: clamp(68px, 22vw, 100px);
    }

    .current-details {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .detail-card {
      min-height: 100px;
      padding: 14px;
    }

    .forecast-section {
      margin-top: 50px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hourly-list {
      grid-template-columns:
        repeat(8, 110px);
      overflow-x: auto;
    }

    .daily-card {
      grid-template-columns:
        1fr auto;

      gap: 12px;
    }

    .daily-condition {
      grid-column: 1 / -1;
    }

    .daily-rain {
      display: none;
    }

    .temperature-bar {
      display: none;
    }

    .weather-info {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
  }

  @media (max-width: 430px) {
    .current-details {
      grid-template-columns: 1fr;
    }

    .location-heading h1 {
      font-size: 48px;
    }

    .weather-icon {
      width: 65px;
      height: 65px;
      font-size: 38px;
    }

    .temperature-row {
      align-items: flex-end;
    }

    .detail-card {
      min-height: 85px;
    }
  }

  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const LOCATIONS = {
      Alcoi: {
        latitude: 38.6986,
        longitude: -0.4736,
        region: "Alicante, España"
      },

      Torrevieja: {
        latitude: 37.978,
        longitude: -0.682,
        region: "Alicante, España"
      }
    };

    let selectedLocation = "Alcoi";

    const locationButton =
      document.getElementById("locationButton");

    const locationMenu =
      document.getElementById("locationMenu");

    const headerLocation =
      document.getElementById("headerLocation");

    const breadcrumbLocation =
      document.getElementById("breadcrumbLocation");

    const locationTitle =
      document.getElementById("locationTitle");

    const locationRegion =
      document.getElementById("locationRegion");

    const weatherIcon =
      document.getElementById("weatherIcon");

    const temperature =
      document.getElementById("temperature");

    const condition =
      document.getElementById("condition");

    const feelsLike =
      document.getElementById("feelsLike");

    const updatedTime =
      document.getElementById("updatedTime");

    const humidity =
      document.getElementById("humidity");

    const wind =
      document.getElementById("wind");

    const pressure =
      document.getElementById("pressure");

    const visibility =
      document.getElementById("visibility");

    const cloudCover =
      document.getElementById("cloudCover");

    const precipitation =
      document.getElementById("precipitation");

    const hourlyList =
      document.getElementById("hourlyList");

    const dailyList =
      document.getElementById("dailyList");

    const WEATHER_CODES = {
      0: {
        description: "Despejado",
        icon: "☀"
      },

      1: {
        description: "Principalmente despejado",
        icon: "🌤"
      },

      2: {
        description: "Parcialmente nublado",
        icon: "⛅"
      },

      3: {
        description: "Nublado",
        icon: "☁"
      },

      45: {
        description: "Niebla",
        icon: "🌫"
      },

      48: {
        description: "Niebla",
        icon: "🌫"
      },

      51: {
        description: "Llovizna ligera",
        icon: "🌦"
      },

      53: {
        description: "Llovizna",
        icon: "🌦"
      },

      55: {
        description: "Llovizna intensa",
        icon: "🌧"
      },

      61: {
        description: "Lluvia ligera",
        icon: "🌦"
      },

      63: {
        description: "Lluvia",
        icon: "🌧"
      },

      65: {
        description: "Lluvia intensa",
        icon: "🌧"
      },

      71: {
        description: "Nieve ligera",
        icon: "🌨"
      },

      73: {
        description: "Nieve",
        icon: "❄"
      },

      75: {
        description: "Nieve intensa",
        icon: "❄"
      },

      80: {
        description: "Chubascos ligeros",
        icon: "🌦"
      },

      81: {
        description: "Chubascos",
        icon: "🌧"
      },

      82: {
        description: "Chubascos intensos",
        icon: "🌧"
      },

      95: {
        description: "Tormenta",
        icon: "⛈"
      },

      96: {
        description: "Tormenta con granizo",
        icon: "⛈"
      },

      99: {
        description: "Tormenta intensa",
        icon: "⛈"
      }
    };

    function getWeather(code) {
      return (
        WEATHER_CODES[code] || {
          description: "Condiciones variables",
          icon: "☁"
        }
      );
    }

    function formatHour(value) {
      const date = new Date(value);

      return date.toLocaleTimeString("es-ES", {
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function formatDay(value, index) {
      const date = new Date(`${value}T12:00:00`);

      if (index === 0) {
        return "Hoy";
      }

      if (index === 1) {
        return "Mañana";
      }

      return date.toLocaleDateString("es-ES", {
        weekday: "long"
      }).replace(/^./, function(char) {
        return char.toUpperCase();
      });
    }

    function formatDate(value) {
      const date = new Date(`${value}T12:00:00`);

      return date.toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short"
      });
    }

    function setText(element, value) {
      if (element) {
        element.textContent = String(value);
      }
    }

    function renderCurrentWeather(data) {
      const current = data.current;
      const daily = data.daily;

      const weather = getWeather(current.weather_code);

      setText(
        temperature,
        Math.round(current.temperature_2m)
      );

      setText(
        weatherIcon,
        weather.icon
      );

      setText(
        condition,
        weather.description
      );

      setText(
        feelsLike,
        `${Math.round(current.apparent_temperature)}°`
      );

      setText(
        humidity,
        `${Math.round(current.relative_humidity_2m)}%`
      );

      setText(
        wind,
        Math.round(current.wind_speed_10m)
      );

      setText(
        pressure,
        Math.round(current.surface_pressure)
      );

      setText(
        visibility,
        Math.round(current.visibility / 1000)
      );

      setText(
        cloudCover,
        `${Math.round(current.cloud_cover)}%`
      );

      setText(
        precipitation,
        `${Math.round(current.precipitation_probability)}%`
      );

      setText(
        updatedTime,
        formatHour(current.time)
      );

      setText(
        document.getElementById("highTemperature"),
        Math.round(daily.temperature_2m_max[0])
      );
    }

    function renderHourly(data) {
      const times = data.hourly.time;
      const temperatures =
        data.hourly.temperature_2m;

      const codes =
        data.hourly.weather_code;

      const rain =
        data.hourly.precipitation_probability;

      const currentTime =
        new Date(data.current.time).getTime();

      let startIndex = 0;

      for (let i = 0; i < times.length; i++) {
        const time =
          new Date(times[i]).getTime();

        if (time >= currentTime) {
          startIndex = i;
          break;
        }
      }

      const cards = [];

      for (
        let i = startIndex;
        i < Math.min(startIndex + 8, times.length);
        i++
      ) {
        const weather =
          getWeather(codes[i]);

        cards.push(`
          <article class="hour-card ${i === startIndex ? "current" : ""}">
            <span class="hour-time">
              ${i === startIndex ? "Ahora" : formatHour(times[i])}
            </span>

            <span class="hour-icon">
              ${weather.icon}
            </span>

            <strong class="hour-temp">
              ${Math.round(temperatures[i])}°
            </strong>

            <span class="hour-rain">
              ${Math.round(rain[i])}% lluvia
            </span>
          </article>
        `);
      }

      hourlyList.innerHTML = cards.join("");
    }

    function renderDaily(data) {
      const daily = data.daily;

      const minTemps =
        daily.temperature_2m_min;

      const maxTemps =
        daily.temperature_2m_max;

      const codes =
        daily.weather_code;

      const rain =
        daily.precipitation_probability_max;

      const days =
        daily.time;

      const highest =
        Math.max(...maxTemps);

      const lowest =
        Math.min(...minTemps);

      const range =
        Math.max(highest - lowest, 1);

      const cards = [];

      for (
        let i = 0;
        i < Math.min(7, days.length);
        i++
      ) {
        const weather =
          getWeather(codes[i]);

        const left =
          ((minTemps[i] - lowest) / range) * 100;

        const width =
          ((maxTemps[i] - minTemps[i]) / range) * 100;

        cards.push(`
          <article class="daily-card">

            <div>
              <strong class="daily-day">
                ${formatDay(days[i], i)}
              </strong>

              <span class="daily-date">
                ${formatDate(days[i])}
              </span>
            </div>

            <div class="daily-condition">

              <span class="daily-icon">
                ${weather.icon}
              </span>

              <span class="daily-description">
                ${weather.description}
              </span>

            </div>

            <div class="daily-rain">
              ${Math.round(rain[i])}% precip.
            </div>

            <div class="temperature-bar">
              <span
                class="temperature-fill"
                style="
                  left: ${left}%;
                  width: ${Math.max(width, 8)}%;
                "
              ></span>
            </div>

            <div class="daily-temps">
              <strong class="daily-high">
                ${Math.round(maxTemps[i])}°
              </strong>

              <span class="daily-low">
                ${Math.round(minTemps[i])}°
              </span>
            </div>

          </article>
        `);
      }

      dailyList.innerHTML =
        cards.join("");
    }

    async function loadWeather(locationName) {
      const location =
        LOCATIONS[locationName];

      if (!location) {
        return;
      }

      selectedLocation = locationName;

      setText(
        headerLocation,
        locationName
      );

      setText(
        breadcrumbLocation,
        locationName
      );

      setText(
        locationTitle,
        locationName
      );

      setText(
        locationRegion,
        location.region
      );

      setText(
        condition,
        "Cargando condiciones..."
      );

      try {
        const url =
          "https://api.open-meteo.com/v1/forecast" +
          `?latitude=${location.latitude}` +
          `&longitude=${location.longitude}` +
          "&current=" +
          [
            "temperature_2m",
            "relative_humidity_2m",
            "apparent_temperature",
            "is_day",
            "precipitation_probability",
            "rain",
            "weather_code",
            "cloud_cover",
            "surface_pressure",
            "wind_speed_10m",
            "visibility"
          ].join(",") +
          "&hourly=" +
          [
            "temperature_2m",
            "weather_code",
            "precipitation_probability"
          ].join(",") +
          "&daily=" +
          [
            "weather_code",
            "temperature_2m_max",
            "temperature_2m_min",
            "precipitation_probability_max"
          ].join(",") +
          "&timezone=auto" +
          "&forecast_days=7";

        const response =
          await fetch(url);

        if (!response.ok) {
          throw new Error(
            "Weather request failed"
          );
        }

        const data =
          await response.json();

        renderCurrentWeather(data);
        renderHourly(data);
        renderDaily(data);

        document.title =
          `Weather — ${locationName}`;

      } catch (error) {
        console.error(error);

        setText(
          condition,
          "No se pudieron cargar los datos"
        );

        setText(
          temperature,
          "--"
        );

        hourlyList.innerHTML = `
          <div
            style="
              grid-column: 1 / -1;
              padding: 35px;
              color: #718395;
              text-align: center;
            "
          >
            No se pudo conectar con el servicio meteorológico.
          </div>
        `;

        dailyList.innerHTML = `
          <div
            style="
              padding: 35px;
              color: #718395;
              text-align: center;
            "
          >
            Inténtalo de nuevo en unos segundos.
          </div>
        `;
      }
    }

    function closeLocationMenu() {
      if (!locationMenu || !locationButton) {
        return;
      }

      locationMenu.classList.remove("open");
      locationMenu.setAttribute(
        "aria-hidden",
        "true"
      );

      locationButton.setAttribute(
        "aria-expanded",
        "false"
      );
    }

    if (locationButton && locationMenu) {
      locationButton.addEventListener(
        "click",
        function(event) {
          event.stopPropagation();

          const open =
            locationMenu.classList.toggle("open");

          locationMenu.setAttribute(
            "aria-hidden",
            String(!open)
          );

          locationButton.setAttribute(
            "aria-expanded",
            String(open)
          );
        }
      );

      document.addEventListener(
        "click",
        function(event) {
          const target =
            event.target;

          if (
            target instanceof Node &&
            !locationMenu.contains(target) &&
            !locationButton.contains(target)
          ) {
            closeLocationMenu();
          }
        }
      );
    }

    const locationOptions =
      document.querySelectorAll(
        ".location-option"
      );

    locationOptions.forEach(
      function(button) {
        button.addEventListener(
          "click",
          function() {
            const locationName =
              button.getAttribute(
                "data-location"
              );

            if (!locationName) {
              return;
            }

            locationOptions.forEach(
              function(option) {
                option.classList.toggle(
                  "active",
                  option === button
                );
              }
            );

            closeLocationMenu();

            loadWeather(locationName);
          }
        );
      }
    );

    loadWeather("Alcoi");
  })();
</script>
