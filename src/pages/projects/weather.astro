## import Layout from "../../layouts/Layout.astro";

<Layout title="Weather Dashboard">

  <main class="weather-page">

```
<!-- ========================================================= -->
<!-- HEADER -->
<!-- ========================================================= -->

<header class="site-header">
  <div class="header-inner">

    <a href="/#projects" class="brand">
      <span class="brand-mark"></span>
      <span>Weather</span>
    </a>

    <div class="header-project">
      <span class="status-dot"></span>
      <span>PROJECT 03</span>
    </div>

  </div>
</header>


<!-- ========================================================= -->
<!-- MAIN CONTENT -->
<!-- ========================================================= -->

<div class="page-container">

  <!-- ======================================================= -->
  <!-- INTRO -->
  <!-- ======================================================= -->

  <section class="intro">

    <div class="intro-label">
      <span>LIVE WEATHER</span>
      <span class="intro-line"></span>
      <span>SPAIN</span>
    </div>

    <h1>
      Weather
      <span>Dashboard</span>
    </h1>

    <p>
      Real-time weather conditions and a seven-day forecast
      for Alcoi and Valencia, powered by Open-Meteo.
    </p>

  </section>


  <!-- ======================================================= -->
  <!-- LOCATION SELECTOR -->
  <!-- ======================================================= -->

  <div class="location-switcher">

    <button
      type="button"
      class="location-button active"
      data-location-button="alcoi"
    >
      <span class="location-button-dot"></span>
      Alcoi
    </button>

    <button
      type="button"
      class="location-button"
      data-location-button="valencia"
    >
      <span class="location-button-dot"></span>
      Valencia
    </button>

  </div>


  <!-- ======================================================= -->
  <!-- CURRENT WEATHER -->
  <!-- ======================================================= -->

  <section
    class="current-weather"
    aria-labelledby="current-weather-title"
  >

    <div class="current-main">

      <div class="current-location">

        <span class="eyebrow">
          CURRENT CONDITIONS
        </span>

        <h2 id="current-weather-title">
          Alcoi
        </h2>

        <p class="current-region">
          Alicante, Spain
        </p>

        <p class="current-updated">
          Updated <span id="current-time">--:--</span>
        </p>

      </div>


      <div class="current-condition">

        <div
          id="current-icon"
          class="current-icon"
          aria-hidden="true"
        >
          ☀
        </div>

        <div class="current-temperature">
          <span id="current-temperature">--</span>
          <sup>°</sup>
        </div>

        <div
          id="current-description"
          class="current-description"
        >
          Loading weather...
        </div>

      </div>

    </div>


    <!-- ===================================================== -->
    <!-- WEATHER METRICS -->
    <!-- ===================================================== -->

    <div class="metrics">

      <div class="metric">

        <span class="metric-label">
          FEELS LIKE
        </span>

        <strong id="current-feels">
          --°
        </strong>

      </div>


      <div class="metric">

        <span class="metric-label">
          HUMIDITY
        </span>

        <strong id="current-humidity">
          --%
        </strong>

      </div>


      <div class="metric">

        <span class="metric-label">
          WIND
        </span>

        <strong id="current-wind">
          -- km/h
        </strong>

      </div>


      <div class="metric">

        <span class="metric-label">
          PRESSURE
        </span>

        <strong id="current-pressure">
          -- hPa
        </strong>

      </div>

    </div>

  </section>


  <!-- ======================================================= -->
  <!-- FORECAST -->
  <!-- ======================================================= -->

  <section
    class="forecast-section"
    aria-labelledby="forecast-title"
  >

    <div class="section-heading">

      <div>
        <span class="eyebrow">
          OUTLOOK
        </span>

        <h2 id="forecast-title">
          7-day forecast
        </h2>
      </div>

      <span class="section-location" id="forecast-location">
        Alcoi
      </span>

    </div>


    <div
      id="forecast-container"
      class="forecast-container"
    >

      <div class="forecast-loading">
        <span class="loading-spinner"></span>
        Loading forecast...
      </div>

    </div>

  </section>


  <!-- ======================================================= -->
  <!-- PROJECT INFORMATION -->
  <!-- ======================================================= -->

  <section class="project-section">

    <div class="project-heading">

      <span class="eyebrow">
        ABOUT THIS PROJECT
      </span>

      <h2>
        Live data.
        <span>Clean interface.</span>
      </h2>

      <p>
        A lightweight weather experience built with Astro and
        TypeScript. Weather information is retrieved directly
        from the Open-Meteo API using geographic coordinates.
      </p>

    </div>


    <div class="technology-grid">

      <article class="technology-card">

        <span class="technology-number">
          01
        </span>

        <h3>
          Open-Meteo
        </h3>

        <p>
          Live meteorological data is retrieved through a
          public weather API without requiring a backend.
        </p>

      </article>


      <article class="technology-card">

        <span class="technology-number">
          02
        </span>

        <h3>
          Astro
        </h3>

        <p>
          The page is rendered as a lightweight Astro
          experience with client-side weather updates.
        </p>

      </article>


      <article class="technology-card">

        <span class="technology-number">
          03
        </span>

        <h3>
          TypeScript
        </h3>

        <p>
          Weather responses are handled with typed
          interfaces and browser-side interaction.
        </p>

      </article>


      <article class="technology-card">

        <span class="technology-number">
          04
        </span>

        <h3>
          Responsive
        </h3>

        <p>
          The interface adapts from mobile screens to
          large desktop displays.
        </p>

      </article>

    </div>

  </section>


  <!-- ======================================================= -->
  <!-- TECHNOLOGY TAGS -->
  <!-- ======================================================= -->

  <section class="technology-section">

    <span class="eyebrow">
      TECHNOLOGIES
    </span>

    <div class="technology-tags">

      <span>Astro</span>
      <span>TypeScript</span>
      <span>Open-Meteo API</span>
      <span>Fetch API</span>
      <span>CSS</span>
      <span>Responsive UI</span>

    </div>

  </section>


  <!-- ======================================================= -->
  <!-- API -->
  <!-- ======================================================= -->

  <section class="api-section">

    <div class="api-status">
      <span></span>
      LIVE API
    </div>

    <code>
      api.open-meteo.com/v1/forecast
    </code>

  </section>


  <!-- ======================================================= -->
  <!-- BACK -->
  <!-- ======================================================= -->

  <div class="back-section">

    <a href="/#projects" class="back-link">
      <span class="back-arrow">←</span>
      Back to projects
    </a>

  </div>

</div>
