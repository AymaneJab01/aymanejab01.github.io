---
const locations = {
  Barcelona: {
    latitude: 41.3874,
    longitude: 2.1686,
    region: "Catalunya",
  },
  Valencia: {
    latitude: 39.4699,
    longitude: -0.3763,
    region: "Comunitat Valenciana",
  },
  Madrid: {
    latitude: 40.4168,
    longitude: -3.7038,
    region: "Comunidad de Madrid",
  },
  Alcoi: {
    latitude: 38.6983,
    longitude: -0.4736,
    region: "Alacant",
  },
};

const defaultLocation = "Barcelona";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Interactive weather dashboard"
    />
    <title>Weather — {defaultLocation}</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        min-width: 320px;
        background: #ffffff;
        color: #101828;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      :global(button),
      :global(input),
      :global(select) {
        font: inherit;
      }

      .weather-page {
        position: relative;
        min-height: 100vh;
        overflow-x: hidden;
        background: #ffffff;
      }

      /* =========================================================
         INTERACTIVE BACKGROUND
         ========================================================= */

      .effect-layer {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }

      #weather-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.95;
      }

      .effect-glow {
        position: absolute;
        width: 650px;
        height: 650px;
        left: 50%;
        top: 20%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background:
          radial-gradient(
            circle,
            rgba(0, 136, 255, 0.11) 0%,
            rgba(0, 136, 255, 0.055) 25%,
            rgba(0, 136, 255, 0.02) 48%,
            transparent 72%
          );
        filter: blur(20px);
      }

      .effect-grid {
        position: absolute;
        inset: 0;
        opacity: 0.3;
        background-image:
          linear-gradient(
            rgba(0, 132, 255, 0.045) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(0, 132, 255, 0.045) 1px,
            transparent 1px
          );
        background-size: 48px 48px;
        mask-image: linear-gradient(
          to bottom,
          black,
          rgba(0, 0, 0, 0.4),
          transparent 88%
        );
      }

      .content {
        position: relative;
        z-index: 2;
      }

      /* =========================================================
         HEADER
         ========================================================= */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid rgba(16, 24, 40, 0.08);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .topbar-inner {
        width: min(1220px, calc(100% - 40px));
        min-height: 64px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #101828;
        font-weight: 800;
        letter-spacing: -0.03em;
        text-decoration: none;
      }

      .brand-mark {
        width: 31px;
        height: 31px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        color: white;
        background: linear-gradient(
          135deg,
          #0077ff,
          #00b7ff
        );
        box-shadow:
          0 0 20px rgba(0, 132, 255, 0.28),
          inset 0 1px 0 rgba(255, 255, 255, 0.4);
        font-size: 16px;
      }

      .brand-text {
        font-size: 16px;
      }

      .top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .location-control {
        position: relative;
      }

      .location-button {
        border: 1px solid rgba(16, 24, 40, 0.12);
        background: white;
        color: #344054;
        min-height: 38px;
        padding: 0 13px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition:
          border-color 180ms ease,
          box-shadow 180ms ease,
          transform 180ms ease;
      }

      .location-button:hover {
        border-color: rgba(0, 132, 255, 0.35);
        box-shadow: 0 5px 20px rgba(0, 132, 255, 0.1);
        transform: translateY(-1px);
      }

      .location-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        width: 210px;
        padding: 7px;
        border: 1px solid rgba(16, 24, 40, 0.1);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.97);
        box-shadow:
          0 20px 60px rgba(16, 24, 40, 0.14),
          0 0 30px rgba(0, 132, 255, 0.05);
        backdrop-filter: blur(20px);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-5px);
        transition:
          opacity 160ms ease,
          visibility 160ms ease,
          transform 160ms ease;
      }

      .location-menu.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .location-option {
        width: 100%;
        border: 0;
        background: transparent;
        text-align: left;
        padding: 10px 11px;
        border-radius: 8px;
        cursor: pointer;
        color: #344054;
      }

      .location-option:hover {
        background: #eef7ff;
        color: #0077ff;
      }

      /* =========================================================
         MAIN CONTAINER
         ========================================================= */

      .shell {
        width: min(1220px, calc(100% - 40px));
        margin: 0 auto;
        padding: 34px 0 80px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 25px;
        color: #667085;
        font-size: 13px;
      }

      .breadcrumb strong {
        color: #344054;
      }

      /* =========================================================
         WEATHER HERO
         ========================================================= */

      .weather-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(16, 24, 40, 0.1);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow:
          0 10px 40px rgba(16, 24, 40, 0.06),
          0 0 60px rgba(0, 132, 255, 0.055);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }

      .weather-card::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 3px;
        background: linear-gradient(
          90deg,
          transparent,
          #0077ff,
          #00b7ff,
          #0077ff,
          transparent
        );
        opacity: 0.9;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
        gap: 30px;
        padding: 34px;
      }

      .hero-location {
        color: #667085;
        font-size: 14px;
        margin-bottom: 7px;
      }

      .hero-location strong {
        color: #101828;
      }

      .hero-title {
        margin: 0;
        font-size: clamp(30px, 5vw, 54px);
        line-height: 1;
        letter-spacing: -0.055em;
        color: #101828;
      }

      .hero-date {
        margin-top: 10px;
        color: #667085;
        font-size: 14px;
      }

      .temperature-row {
        margin-top: 27px;
        display: flex;
        align-items: center;
        gap: 25px;
      }

      .weather-symbol {
        width: 92px;
        height: 92px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background:
          radial-gradient(
            circle at 35% 30%,
            #ffffff,
            #e9f5ff 48%,
            #d8edff
          );
        border: 1px solid rgba(0, 132, 255, 0.16);
        box-shadow:
          0 10px 30px rgba(0, 132, 255, 0.12),
          0 0 45px rgba(0, 132, 255, 0.1);
        font-size: 46px;
      }

      .temperature {
        margin: 0;
        font-size: clamp(64px, 9vw, 105px);
        line-height: 0.86;
        letter-spacing: -0.08em;
        font-weight: 750;
        color: #101828;
      }

      .condition {
        margin-top: 11px;
        color: #344054;
        font-size: 17px;
        font-weight: 600;
      }

      .feels {
        margin-top: 4px;
        color: #667085;
        font-size: 14px;
      }

      .hero-side {
        align-self: stretch;
        display: flex;
        align-items: center;
      }

      .stats-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border: 1px solid rgba(16, 24, 40, 0.08);
        border-radius: 14px;
        overflow: hidden;
        background: rgba(248, 250, 252, 0.7);
      }

      .stat {
        min-height: 95px;
        padding: 18px;
        border-right: 1px solid rgba(16, 24, 40, 0.08);
        border-bottom: 1px solid rgba(16, 24, 40, 0.08);
      }

      .stat:nth-child(2n) {
        border-right: 0;
      }

      .stat:nth-last-child(-n + 2) {
        border-bottom: 0;
      }

      .stat-label {
        color: #667085;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .stat-value {
        margin-top: 8px;
        color: #101828;
        font-size: 20px;
        font-weight: 750;
      }

      .stat-unit {
        color: #667085;
        font-size: 12px;
        font-weight: 500;
      }

      /* =========================================================
         SECTION
         ========================================================= */

      .section {
        margin-top: 26px;
        border: 1px solid rgba(16, 24, 40, 0.1);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.93);
        box-shadow: 0 10px 35px rgba(16, 24, 40, 0.045);
        overflow: hidden;
      }

      .section-header {
        padding: 20px 24px;
        border-bottom: 1px solid rgba(16, 24, 40, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
      }

      .section-title {
        margin: 0;
        color: #101828;
        font-size: 18px;
        letter-spacing: -0.025em;
      }

      .section-description {
        color: #667085;
        font-size: 13px;
      }

      /* =========================================================
         HOURLY
         ========================================================= */

      .hourly-scroll {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(0, 132, 255, 0.35) transparent;
      }

      .hourly-list {
        min-width: 850px;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
      }

      .hour {
        min-height: 150px;
        padding: 19px 11px;
        text-align: center;
        border-right: 1px solid rgba(16, 24, 40, 0.06);
        transition:
          background 180ms ease,
          transform 180ms ease;
      }

      .hour:last-child {
        border-right: 0;
      }

      .hour:hover {
        background: #f5faff;
        transform: translateY(-2px);
      }

      .hour-time {
        color: #667085;
        font-size: 12px;
        font-weight: 600;
      }

      .hour-time.active {
        color: #0077ff;
      }

      .hour-icon {
        margin: 14px 0;
        font-size: 26px;
      }

      .hour-temperature {
        color: #101828;
        font-size: 16px;
        font-weight: 750;
      }

      .rain {
        margin-top: 8px;
        color: #0077ff;
        font-size: 11px;
        font-weight: 650;
      }

      /* =========================================================
         DAILY
         ========================================================= */

      .daily-list {
        display: flex;
        flex-direction: column;
      }

      .day {
        display: grid;
        grid-template-columns: 1.2fr 80px 100px 100px 1fr;
        align-items: center;
        gap: 15px;
        padding: 17px 24px;
        border-bottom: 1px solid rgba(16, 24, 40, 0.07);
        transition: background 160ms ease;
      }

      .day:last-child {
        border-bottom: 0;
      }

      .day:hover {
        background: #f8fbff;
      }

      .day-name {
        color: #101828;
        font-size: 14px;
        font-weight: 700;
      }

      .day-date {
        display: block;
        margin-top: 3px;
        color: #667085;
        font-size: 12px;
        font-weight: 500;
      }

      .day-icon {
        font-size: 28px;
        text-align: center;
      }

      .day-condition {
        color: #475467;
        font-size: 13px;
      }

      .day-temp {
        color: #101828;
        font-size: 14px;
        font-weight: 700;
      }

      .day-temp span {
        color: #667085;
        font-weight: 500;
      }

      .rain-bar {
        position: relative;
        height: 5px;
        overflow: hidden;
        border-radius: 10px;
        background: #e7f3ff;
      }

      .rain-bar span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          #008cff,
          #00c2ff
        );
      }

      /* =========================================================
         DETAILS
         ========================================================= */

      .details-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .detail {
        padding: 23px;
        border-right: 1px solid rgba(16, 24, 40, 0.07);
      }

      .detail:last-child {
        border-right: 0;
      }

      .detail-label {
        color: #667085;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 650;
      }

      .detail-value {
        margin-top: 7px;
        color: #101828;
        font-size: 21px;
        font-weight: 750;
      }

      /* =========================================================
         DOCUMENTATION PANEL
         ========================================================= */

      .documentation {
        margin-top: 50px;
        display: grid;
        grid-template-columns: 230px minmax(0, 1fr);
        gap: 35px;
      }

      .docs-nav {
        position: sticky;
        top: 90px;
        align-self: start;
      }

      .docs-label {
        color: #98a2b3;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .docs-nav a {
        display: block;
        margin-top: 9px;
        padding: 7px 10px;
        border-left: 2px solid transparent;
        color: #667085;
        text-decoration: none;
        font-size: 13px;
        transition: all 160ms ease;
      }

      .docs-nav a:hover {
        color: #0077ff;
        border-left-color: #0077ff;
        background: #f5faff;
      }

      .docs-content {
        max-width: 820px;
      }

      .docs-kicker {
        color: #0077ff;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .docs-title {
        margin: 8px 0 14px;
        color: #101828;
        font-size: clamp(32px, 5vw, 48px);
        line-height: 1.02;
        letter-spacing: -0.05em;
      }

      .docs-text {
        max-width: 690px;
        color: #667085;
        line-height: 1.8;
        font-size: 15px;
      }

      .code-card {
        margin-top: 25px;
        overflow: hidden;
        border: 1px solid rgba(16, 24, 40, 0.1);
        border-radius: 13px;
        background: #0b1220;
        box-shadow:
          0 20px 60px rgba(16, 24, 40, 0.12),
          0 0 40px rgba(0, 132, 255, 0.07);
      }

      .code-header {
        height: 40px;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .code-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #475467;
      }

      .code-title {
        margin-left: 7px;
        color: #98a2b3;
        font-size: 11px;
      }

      .code {
        margin: 0;
        padding: 22px;
        overflow-x: auto;
        color: #dbeafe;
        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;
        font-size: 12px;
        line-height: 1.8;
      }

      .code-blue {
        color: #4db8ff;
      }

      .code-green {
        color: #67e8a5;
      }

      .code-purple {
        color: #c4b5fd;
      }

      /* =========================================================
         LOADING / ERROR
         ========================================================= */

      .loading {
        color: #667085;
        font-size: 13px;
      }

      .error-message {
        display: none;
        margin-top: 15px;
        padding: 12px 14px;
        border: 1px solid rgba(239, 68, 68, 0.15);
        border-radius: 9px;
        background: #fff5f5;
        color: #b42318;
        font-size: 13px;
      }

      /* =========================================================
         RESPONSIVE
         ========================================================= */

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .hero-side {
          max-width: none;
        }

        .details-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .detail:nth-child(2) {
          border-right: 0;
        }

        .detail:nth-child(-n + 2) {
          border-bottom: 1px solid rgba(16, 24, 40, 0.07);
        }

        .documentation {
          grid-template-columns: 1fr;
        }

        .docs-nav {
          position: static;
          display: flex;
          flex-wrap: wrap;
          gap: 5px;
        }

        .docs-nav a {
          border-left: 0;
          border-bottom: 2px solid transparent;
        }

        .docs-nav a:hover {
          border-left: 0;
          border-bottom-color: #0077ff;
        }
      }

      @media (max-width: 650px) {
        .topbar-inner,
        .shell {
          width: min(100% - 24px, 1220px);
        }

        .topbar-inner {
          min-height: 58px;
        }

        .brand-text {
          display: none;
        }

        .hero {
          padding: 23px;
        }

        .temperature-row {
          gap: 15px;
        }

        .weather-symbol {
          width: 68px;
          height: 68px;
          font-size: 34px;
        }

        .temperature {
          font-size: 68px;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .stat {
          min-height: 82px;
          padding: 14px;
        }

        .stat-value {
          font-size: 17px;
        }

        .section-header {
          padding: 17px;
        }

        .day {
          grid-template-columns: 1fr 55px 80px;
          padding: 15px 17px;
        }

        .day-condition,
        .rain-bar {
          display: none;
        }

        .details-grid {
          grid-template-columns: 1fr 1fr;
        }

        .detail {
          padding: 17px;
        }

        .docs-title {
          font-size: 34px;
        }
      }
    </style>
  </head>

  <body>
    <div class="weather-page">
      <!-- =======================================================
           INTERACTIVE BACKGROUND
           ======================================================= -->

      <div class="effect-layer" aria-hidden="true">
        <canvas id="weather-canvas"></canvas>
        <div class="effect-glow"></div>
        <div class="effect-grid"></div>
      </div>

      <!-- =======================================================
           HEADER
           ======================================================= -->

      <header class="topbar">
        <div class="topbar-inner">
          <a class="brand" href="/#projects">
            <span class="brand-mark">W</span>
            <span class="brand-text">Weather</span>
          </a>

          <div class="top-actions">
            <div class="location-control">
              <button
                class="location-button"
                id="location-button"
                type="button"
                aria-expanded="false"
              >
                <span>⌖</span>
                <span id="header-location">Barcelona</span>
                <span>⌄</span>
              </button>

              <div
                class="location-menu"
                id="location-menu"
              >
                {
                  Object.keys(locations).map((location) => (
                    <button
                      class="location-option"
                      type="button"
                      data-location={location}
                    >
                      {location}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="content">
        <div class="shell">
          <!-- =====================================================
               BREADCRUMB
               ===================================================== -->

          <div class="breadcrumb">
            <span>Weather</span>
            <span>/</span>
            <strong id="breadcrumb-location">Barcelona</strong>
          </div>

          <!-- =====================================================
               CURRENT WEATHER
               ===================================================== -->

          <section class="weather-card">
            <div class="hero">
              <div>
                <div class="hero-location">
                  Current conditions in
                  <strong id="location-name">Barcelona</strong>
                </div>

                <h1 class="hero-title">
                  Today's Weather
                </h1>

                <div
                  class="hero-date"
                  id="current-date"
                >
                  Loading...
                </div>

                <div class="temperature-row">
                  <div
                    class="weather-symbol"
                    id="weather-icon"
                    aria-label="Weather"
                  >
                    ☀️
                  </div>

                  <div>
                    <p
                      class="temperature"
                      id="temperature"
                    >
                      --
                    </p>

                    <div
                      class="condition"
                      id="condition"
                    >
                      Loading weather...
                    </div>

                    <div class="feels">
                      Feels like
                      <strong id="feels-like">--</strong>
                    </div>
                  </div>
                </div>

                <div
                  class="error-message"
                  id="error-message"
                >
                  Weather data could not be loaded. Please try again.
                </div>
              </div>

              <div class="hero-side">
                <div class="stats-grid">
                  <div class="stat">
                    <div class="stat-label">
                      High
                    </div>
                    <div
                      class="stat-value"
                      id="high-temperature"
                    >
                      --
                    </div>
                  </div>

                  <div class="stat">
                    <div class="stat-label">
                      Low
                    </div>
                    <div
                      class="stat-value"
                      id="low-temperature"
                    >
                      --
                    </div>
                  </div>

                  <div class="stat">
                    <div class="stat-label">
                      Humidity
                    </div>
                    <div
                      class="stat-value"
                      id="humidity"
                    >
                      --
                    </div>
                  </div>

                  <div class="stat">
                    <div class="stat-label">
                      Wind
                    </div>
                    <div class="stat-value">
                      <span id="wind">--</span>
                      <span class="stat-unit">km/h</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- =====================================================
               HOURLY FORECAST
               ===================================================== -->

          <section class="section">
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Hourly Forecast
                </h2>

                <div class="section-description">
                  Weather conditions over the next several hours
                </div>
              </div>

              <span
                class="loading"
                id="hourly-status"
              >
                Live
              </span>
            </div>

            <div class="hourly-scroll">
              <div
                class="hourly-list"
                id="hourly-list"
              >
                <div class="hour">
                  <div class="loading">
                    Loading forecast...
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- =====================================================
               10 DAY FORECAST
               ===================================================== -->

          <section class="section">
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  10-Day Forecast
                </h2>

                <div class="section-description">
                  Extended forecast for the selected location
                </div>
              </div>
            </div>

            <div
              class="daily-list"
              id="daily-list"
            >
              <div class="day">
                <div class="loading">
                  Loading forecast...
                </div>
              </div>
            </div>
          </section>

          <!-- =====================================================
               DETAILS
               ===================================================== -->

          <section class="section">
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Weather Details
                </h2>

                <div class="section-description">
                  More information about current conditions
                </div>
              </div>
            </div>

            <div class="details-grid">
              <div class="detail">
                <div class="detail-label">
                  Pressure
                </div>
                <div
                  class="detail-value"
                  id="pressure"
                >
                  --
                </div>
              </div>

              <div class="detail">
                <div class="detail-label">
                  Visibility
                </div>
                <div
                  class="detail-value"
                  id="visibility"
                >
                  --
                </div>
              </div>

              <div class="detail">
                <div class="detail-label">
                  Cloud Cover
                </div>
                <div
                  class="detail-value"
                  id="cloud-cover"
                >
                  --
                </div>
              </div>

              <div class="detail">
                <div class="detail-label">
                  Precipitation
                </div>
                <div
                  class="detail-value"
                  id="precipitation"
                >
                  --
                </div>
              </div>
            </div>
          </section>

          <!-- =====================================================
               DOCUMENTATION STYLE SECTION
               ===================================================== -->

          <section class="documentation">
            <aside class="docs-nav">
              <div class="docs-label">
                On this page
              </div>

              <a href="#overview">Overview</a>
              <a href="#forecast">Forecast</a>
              <a href="#interaction">Interaction</a>
            </aside>

            <div class="docs-content">
              <div
                class="docs-kicker"
                id="overview"
              >
                Weather Dashboard
              </div>

              <h2 class="docs-title">
                Weather data,
                <br />
                presented clearly.
              </h2>

              <p class="docs-text">
                A clean weather interface combining a
                weather.com-inspired information hierarchy
                with an interactive electric-blue visual
                layer. The background responds to cursor
                movement while keeping the forecast readable.
              </p>

              <div
                id="forecast"
                class="code-card"
              >
                <div class="code-header">
                  <span class="code-dot"></span>
                  <span class="code-dot"></span>
                  <span class="code-dot"></span>
                  <span class="code-title">
                    weather-api
                  </span>
                </div>

                <pre class="code"><code><span class="code-purple">const</span> weather =
  <span class="code-blue">await</span> fetch(
    <span class="code-green">"api.open-meteo.com"</span>
  );

<span class="code-purple">const</span> forecast =
  <span class="code-purple">await</span> weather.json();

<span class="code-blue">render</span>(forecast);</code></pre>
              </div>

              <p
                class="docs-text"
                id="interaction"
                style="margin-top: 25px;"
              >
                Move your cursor across the page to interact
                with the electric-blue particle field. The
                particles react to the pointer and form a
                subtle network around the active area.
              </p>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script is:inline>
      // @ts-nocheck

      /* ==========================================================
         WEATHER APPLICATION
         ========================================================== */

      const LOCATIONS = {
        Barcelona: {
          latitude: 41.3874,
          longitude: 2.1686,
          region: "Catalunya",
        },

        Valencia: {
          latitude: 39.4699,
          longitude: -0.3763,
          region: "Comunitat Valenciana",
        },

        Madrid: {
          latitude: 40.4168,
          longitude: -3.7038,
          region: "Comunidad de Madrid",
        },

        Alcoi: {
          latitude: 38.6983,
          longitude: -0.4736,
          region: "Alacant",
        },
      };

      let selectedLocation = "Barcelona";

      const $ = (id) =>
        document.getElementById(id);

      const elements = {
        headerLocation: $("header-location"),
        breadcrumbLocation: $("breadcrumb-location"),
        locationName: $("location-name"),
        currentDate: $("current-date"),
        temperature: $("temperature"),
        condition: $("condition"),
        weatherIcon: $("weather-icon"),
        feelsLike: $("feels-like"),
        highTemperature: $("high-temperature"),
        lowTemperature: $("low-temperature"),
        humidity: $("humidity"),
        wind: $("wind"),
        pressure: $("pressure"),
        visibility: $("visibility"),
        cloudCover: $("cloud-cover"),
        precipitation: $("precipitation"),
        hourlyList: $("hourly-list"),
        dailyList: $("daily-list"),
        errorMessage: $("error-message"),
        locationButton: $("location-button"),
        locationMenu: $("location-menu"),
      };

      function getWeatherDescription(code) {
        const descriptions = {
          0: "Clear sky",
          1: "Mainly clear",
          2: "Partly cloudy",
          3: "Overcast",
          45: "Fog",
          48: "Depositing rime fog",
          51: "Light drizzle",
          53: "Moderate drizzle",
          55: "Dense drizzle",
          56: "Light freezing drizzle",
          57: "Dense freezing drizzle",
          61: "Slight rain",
          63: "Moderate rain",
          65: "Heavy rain",
          66: "Light freezing rain",
          67: "Heavy freezing rain",
          71: "Slight snow",
          73: "Moderate snow",
          75: "Heavy snow",
          77: "Snow grains",
          80: "Slight rain showers",
          81: "Moderate rain showers",
          82: "Violent rain showers",
          85: "Slight snow showers",
          86: "Heavy snow showers",
          95: "Thunderstorm",
          96: "Thunderstorm with hail",
          99: "Thunderstorm with heavy hail",
        };

        return descriptions[code] || "Variable conditions";
      }

      function getWeatherIcon(code, isDay = true) {
        if (code === 0) {
          return isDay ? "☀️" : "🌙";
        }

        if (code === 1) {
          return isDay ? "🌤️" : "🌙";
        }

        if (code === 2) {
          return "⛅";
        }

        if (code === 3) {
          return "☁️";
        }

        if (code === 45 || code === 48) {
          return "🌫️";
        }

        if (code >= 51 && code <= 57) {
          return "🌦️";
        }

        if (code >= 61 && code <= 67) {
          return "🌧️";
        }

        if (code >= 71 && code <= 77) {
          return "🌨️";
        }

        if (code >= 80 && code <= 82) {
          return "🌦️";
        }

        if (code >= 85 && code <= 86) {
          return "🌨️";
        }

        if (code >= 95) {
          return "⛈️";
        }

        return "🌤️";
      }

      function formatHour(value) {
        const date = new Date(value);

        return date.toLocaleTimeString(
          "en-GB",
          {
            hour: "2-digit",
            minute: "2-digit",
          }
        );
      }

      function formatDay(value, index) {
        const date = new Date(
          value + "T12:00:00"
        );

        if (index === 0) {
          return "Today";
        }

        if (index === 1) {
          return "Tomorrow";
        }

        return date.toLocaleDateString(
          "en-GB",
          {
            weekday: "short",
          }
        );
      }

      function formatDate() {
        return new Intl.DateTimeFormat(
          "en-GB",
          {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric",
          }
        ).format(new Date());
      }

      function renderCurrentWeather(data) {
        const current = data.current;

        elements.temperature.textContent =
          `${Math.round(current.temperature_2m)}°`;

        elements.condition.textContent =
          getWeatherDescription(
            current.weather_code
          );

        elements.weatherIcon.textContent =
          getWeatherIcon(
            current.weather_code,
            current.is_day === 1
          );

        elements.feelsLike.textContent =
          `${Math.round(current.apparent_temperature)}°C`;

        elements.highTemperature.textContent =
          `${Math.round(
            data.daily.temperature_2m_max[0]
          )}°C`;

        elements.lowTemperature.textContent =
          `${Math.round(
            data.daily.temperature_2m_min[0]
          )}°C`;

        elements.humidity.textContent =
          `${Math.round(
            current.relative_humidity_2m
          )}%`;

        elements.wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )}`;

        elements.pressure.textContent =
          `${Math.round(
            current.surface_pressure
          )} hPa`;

        elements.visibility.textContent =
          `${Math.round(
            current.visibility / 1000
          )} km`;

        elements.cloudCover.textContent =
          `${Math.round(
            current.cloud_cover
          )}%`;

        elements.precipitation.textContent =
          `${Math.round(
            current.precipitation
          )} mm`;

        elements.currentDate.textContent =
          formatDate();
      }

      function renderHourly(data) {
        const currentHour = new Date()
          .getHours();

        const html = data.hourly.time
          .slice(0, 12)
          .map((time, index) => {
            const date = new Date(time);

            const hour =
              date.getHours();

            const temperature =
              Math.round(
                data.hourly.temperature_2m[index]
              );

            const precipitation =
              Math.round(
                data.hourly.precipitation_probability[
                  index
                ]
              );

            const icon =
              getWeatherIcon(
                data.hourly.weather_code[index],
                true
              );

            return `
              <div class="hour">
                <div class="hour-time ${
                  hour === currentHour
                    ? "active"
                    : ""
                }">
                  ${
                    index === 0
                      ? "Now"
                      : formatHour(time)
                  }
                </div>

                <div class="hour-icon">
                  ${icon}
                </div>

                <div class="hour-temperature">
                  ${temperature}°
                </div>

                <div class="rain">
                  ${precipitation}% rain
                </div>
              </div>
            `;
          })
          .join("");

        elements.hourlyList.innerHTML =
          html;
      }

      function renderDaily(data) {
        const html = data.daily.time
          .map((date, index) => {
            const code =
              data.daily.weather_code[index];

            const max =
              Math.round(
                data.daily.temperature_2m_max[index]
              );

            const min =
              Math.round(
                data.daily.temperature_2m_min[index]
              );

            const precipitation =
              Math.round(
                data.daily.precipitation_probability_max[
                  index
                ]
              );

            const icon =
              getWeatherIcon(code, true);

            return `
              <div class="day">
                <div>
                  <div class="day-name">
                    ${formatDay(date, index)}
                  </div>

                  <span class="day-date">
                    ${date}
                  </span>
                </div>

                <div class="day-icon">
                  ${icon}
                </div>

                <div class="day-condition">
                  ${getWeatherDescription(code)}
                </div>

                <div class="day-temp">
                  ${max}°
                  <span>/ ${min}°</span>
                </div>

                <div class="rain-bar">
                  <span
                    style="width: ${Math.max(
                      precipitation,
                      4
                    )}%"
                  ></span>
                </div>
              </div>
            `;
          })
          .join("");

        elements.dailyList.innerHTML =
          html;
      }

      async function loadWeather(
        locationName
      ) {
        const location =
          LOCATIONS[locationName];

        if (!location) {
          return;
        }

        selectedLocation =
          locationName;

        elements.headerLocation.textContent =
          locationName;

        elements.breadcrumbLocation.textContent =
          locationName;

        elements.locationName.textContent =
          locationName;

        elements.errorMessage.style.display =
          "none";

        const params = new URLSearchParams({
          latitude: String(
            location.latitude
          ),

          longitude: String(
            location.longitude
          ),

          current:
            [
              "temperature_2m",
              "relative_humidity_2m",
              "apparent_temperature",
              "precipitation",
              "weather_code",
              "cloud_cover",
              "surface_pressure",
              "visibility",
              "wind_speed_10m",
              "is_day",
            ].join(","),

          hourly:
            [
              "temperature_2m",
              "weather_code",
              "precipitation_probability",
            ].join(","),

          daily:
            [
              "weather_code",
              "temperature_2m_max",
              "temperature_2m_min",
              "precipitation_probability_max",
            ].join(","),

          timezone: "auto",

          forecast_days: "10",
        });

        try {
          const response =
            await fetch(
              `https://api.open-meteo.com/v1/forecast?${params.toString()}`
            );

          if (!response.ok) {
            throw new Error(
              "Weather request failed"
            );
          }

          const data =
            await response.json();

          renderCurrentWeather(data);
          renderHourly(data);
          renderDaily(data);
        } catch (error) {
          console.error(error);

          elements.errorMessage.style.display =
            "block";
        }
      }

      /* ==========================================================
         LOCATION MENU
         ========================================================== */

      elements.locationButton.addEventListener(
        "click",
        () => {
          const isOpen =
            elements.locationMenu.classList.toggle(
              "open"
            );

          elements.locationButton.setAttribute(
            "aria-expanded",
            String(isOpen)
          );
        }
      );

      document
        .querySelectorAll(
          ".location-option"
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              const location =
                button.dataset.location;

              if (!location) {
                return;
              }

              elements.locationMenu.classList.remove(
                "open"
              );

              elements.locationButton.setAttribute(
                "aria-expanded",
                "false"
              );

              loadWeather(location);
            }
          );
        });

      document.addEventListener(
        "click",
        (event) => {
          if (
            !elements.locationButton.contains(
              event.target
            ) &&
            !elements.locationMenu.contains(
              event.target
            )
          ) {
            elements.locationMenu.classList.remove(
              "open"
            );

            elements.locationButton.setAttribute(
              "aria-expanded",
              "false"
            );
          }
        }
      );

      loadWeather("Barcelona");

      /* ==========================================================
         REACT-BITS-INSPIRED ELECTRIC BLUE PARTICLE FIELD
         ========================================================== */

      const canvas =
        document.getElementById(
          "weather-canvas"
        );

      const ctx =
        canvas.getContext("2d");

      let width = 0;
      let height = 0;
      let dpr = 1;

      let mouseX = -1000;
      let mouseY = -1000;

      let targetMouseX = -1000;
      let targetMouseY = -1000;

      let particles = [];

      const PARTICLE_COUNT = 115;
      const CONNECTION_DISTANCE = 135;
      const MOUSE_RADIUS = 190;

      function resizeCanvas() {
        dpr = Math.min(
          window.devicePixelRatio || 1,
          2
        );

        width =
          window.innerWidth;

        height =
          window.innerHeight;

        canvas.width =
          width * dpr;

        canvas.height =
          height * dpr;

        canvas.style.width =
          `${width}px`;

        canvas.style.height =
          `${height}px`;

        ctx.setTransform(
          dpr,
          0,
          0,
          dpr,
          0,
          0
        );
      }

      function createParticle() {
        return {
          x:
            Math.random() *
            width,

          y:
            Math.random() *
            height,

          vx:
            (Math.random() - 0.5) *
            0.22,

          vy:
            (Math.random() - 0.5) *
            0.22,

          radius:
            Math.random() * 1.7 +
            0.7,

          alpha:
            Math.random() * 0.35 +
            0.15,

          pulse:
            Math.random() * Math.PI * 2,
        };
      }

      function resetParticles() {
        particles =
          [];

        for (
          let i = 0;
          i < PARTICLE_COUNT;
          i++
        ) {
          particles.push(
            createParticle()
          );
        }
      }

      function drawGlow(
        x,
        y,
        radius,
        alpha
      ) {
        const gradient =
          ctx.createRadialGradient(
            x,
            y,
            0,
            x,
            y,
            radius
          );

        gradient.addColorStop(
          0,
          `rgba(0, 140, 255, ${alpha})`
        );

        gradient.addColorStop(
          0.3,
          `rgba(0, 140, 255, ${
            alpha * 0.4
          })`
        );

        gradient.addColorStop(
          1,
          "rgba(0, 140, 255, 0)"
        );

        ctx.fillStyle =
          gradient;

        ctx.fillRect(
          x - radius,
          y - radius,
          radius * 2,
          radius * 2
        );
      }

      function animate(time) {
        mouseX +=
          (targetMouseX -
            mouseX) *
          0.08;

        mouseY +=
          (targetMouseY -
            mouseY) *
          0.08;

        ctx.clearRect(
          0,
          0,
          width,
          height
        );

        /* Main cursor glow */

        if (
          mouseX > -500 &&
          mouseY > -500
        ) {
          drawGlow(
            mouseX,
            mouseY,
            MOUSE_RADIUS,
            0.12
          );
        }

        /* Particles */

        for (
          let i = 0;
          i < particles.length;
          i++
        ) {
          const particle =
            particles[i];

          particle.pulse +=
            0.015;

          particle.x +=
            particle.vx;

          particle.y +=
            particle.vy;

          if (
            particle.x < -20
          ) {
            particle.x =
              width + 20;
          }

          if (
            particle.x >
            width + 20
          ) {
            particle.x = -20;
          }

          if (
            particle.y < -20
          ) {
            particle.y =
              height + 20;
          }

          if (
            particle.y >
            height + 20
          ) {
            particle.y = -20;
          }

          const dx =
            mouseX -
            particle.x;

          const dy =
            mouseY -
            particle.y;

          const distance =
            Math.sqrt(
              dx * dx +
                dy * dy
            );

          if (
            distance <
            MOUSE_RADIUS
          ) {
            const force =
              (1 -
                distance /
                  MOUSE_RADIUS) *
              0.014;

            particle.vx +=
              dx * force;

            particle.vy +=
              dy * force;

            particle.vx *=
              0.992;

            particle.vy *=
              0.992;
          }

          const pulse =
            Math.sin(
              particle.pulse
            ) *
            0.15;

          ctx.beginPath();

          ctx.arc(
            particle.x,
            particle.y,
            particle.radius +
              pulse,
            0,
            Math.PI * 2
          );

          ctx.fillStyle =
            `rgba(0, 132, 255, ${
              particle.alpha
            })`;

          ctx.shadowColor =
            "rgba(0, 132, 255, 0.8)";

          ctx.shadowBlur = 8;

          ctx.fill();

          ctx.shadowBlur = 0;
        }

        /* Network connections */

        for (
          let i = 0;
          i < particles.length;
          i++
        ) {
          const a =
            particles[i];

          for (
            let j = i + 1;
            j < particles.length;
            j++
          ) {
            const b =
              particles[j];

            const dx =
              a.x - b.x;

            const dy =
              a.y - b.y;

            const distance =
              Math.sqrt(
                dx * dx +
                  dy * dy
              );

            if (
              distance <
              CONNECTION_DISTANCE
            ) {
              let alpha =
                (1 -
                  distance /
                    CONNECTION_DISTANCE) *
                0.15;

              const nearMouseA =
                Math.sqrt(
                  (a.x -
                    mouseX) **
                    2 +
                    (a.y -
                      mouseY) **
                      2
                );

              const nearMouseB =
                Math.sqrt(
                  (b.x -
                    mouseX) **
                    2 +
                    (b.y -
                      mouseY) **
                      2
                );

              if (
                nearMouseA <
                  MOUSE_RADIUS ||
                nearMouseB <
                  MOUSE_RADIUS
              ) {
                alpha += 0.28;
              }

              ctx.beginPath();

              ctx.moveTo(
                a.x,
                a.y
              );

              ctx.lineTo(
                b.x,
                b.y
              );

              ctx.strokeStyle =
                `rgba(0, 132, 255, ${alpha})`;

              ctx.lineWidth = 0.8;

              ctx.stroke();
            }
          }
        }

        /* Strong cursor ring */

        if (
          mouseX > -500 &&
          mouseY > -500
        ) {
          const ringSize =
            25 +
            Math.sin(
              time * 0.002
            ) *
              5;

          ctx.beginPath();

          ctx.arc(
            mouseX,
            mouseY,
            ringSize,
            0,
            Math.PI * 2
          );

          ctx.strokeStyle =
            "rgba(0, 132, 255, 0.16)";

          ctx.lineWidth = 1;

          ctx.stroke();

          ctx.beginPath();

          ctx.arc(
            mouseX,
            mouseY,
            4,
            0,
            Math.PI * 2
          );

          ctx.fillStyle =
            "rgba(0, 132, 255, 0.55)";

          ctx.shadowColor =
            "#008cff";

          ctx.shadowBlur = 15;

          ctx.fill();

          ctx.shadowBlur = 0;
        }

        requestAnimationFrame(
          animate
        );
      }

      window.addEventListener(
        "resize",
        () => {
          resizeCanvas();
          resetParticles();
        }
      );

      window.addEventListener(
        "pointermove",
        (event) => {
          targetMouseX =
            event.clientX;

          targetMouseY =
            event.clientY;
        },
        { passive: true }
      );

      window.addEventListener(
        "pointerleave",
        () => {
          targetMouseX = -1000;
          targetMouseY = -1000;
        }
      );

      resizeCanvas();
      resetParticles();

      requestAnimationFrame(
        animate
      );
    </script>
  </body>
</html>