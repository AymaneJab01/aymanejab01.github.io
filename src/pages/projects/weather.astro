    font-size: 0.65rem;
    font-weight: 700;
  }

  .hour-card.current .hour-time {
    color: rgba(255, 255, 255, 0.72);
  }

  .hour-icon {
    font-size: 1.7rem;
  }

  .hour-temperature {
    color: var(--black);
    font-size: 1rem;
    font-weight: 650;
  }

  .hour-card.current .hour-temperature {
    color: white;
