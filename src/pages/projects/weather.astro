---

import Layout from "../layouts/Layout.astro";

interface WeatherLocation {
name: string;
region: string;
latitude: number;
longitude: number;
}

interface WeatherCurrent {
temperature_2m: number;
apparent_temperature: number;
relative_humidity_2m: number;
wind_speed_10m: number;
surface_pressure: number;
visibility: number;
weather_code: number;
}

interface WeatherHourly {
time: string[];
temperature_2m: number[];
precipitation_probability: number[];
weather_code: number[];
}

interface WeatherDaily {
time: string[];
weather_code: number[];
temperature_2m_max: number[];
temperature_2m_min: number[];
precipitation_probability_max: number[];
sunrise: string[];
sunset: string[];
}

interface WeatherResponse {
current: WeatherCurrent;
hourly: WeatherHourly;
daily: WeatherDaily;
}

const locations: Record<string, WeatherLocation> = {
Alcoi: {
name: "Alcoi",
region: "Alicante, España",
latitude: 38.6986,
longitude: -0.4731,
},

Torrevieja: {
name: "Torrevieja",
region: "Alicante, España",
latitude: 37.978,
longitude: -0.682,
},

Valencia: {
name: "Valencia",
region: "Valencia, España",
latitude: 39.4699,
longitude: -0.3763,
},
};

## const defaultLocation = "Alcoi";

<Layout title="Weather">
  <main class="weather-page">
    <!-- HEADER -->
    <header class="weather-header">
      <div class="header-inner">
        <a href="/" class="back-link">
          ← Portfolio
        </a>

```
    <div class="header-title">
      <span class="status-dot"></span>
      <span>WEATHER</span>
    </div>

    <div class="header-status" id="header-status">
      Live data
    </div>
  </div>
</header>

<div class="weather-container">
  <!-- LOCATION TABS -->
  <nav class="location-tabs" aria-label="Weather locations">
    {
      Object.values(locations).map((location) => (
        <button
          class:list={[
            "location-tab",
            location.name === defaultLocation && "active",
          ]}
          data-location={location.name}
          type="button"
        >
          <span>{location.name}</span>
          <small>{location.region}</small>
        </button>
      ))
    }
  </nav>

  <!-- LOCATION -->
  <section class="location-heading">
    <div>
      <p class="eyebrow">CURRENT CONDITIONS</p>

      <h1 id="location-name">
        {locations[defaultLocation].name}
      </h1>

      <p id="location-region">
        {locations[defaultLocation].region}
      </p>
    </div>

    <div class="last-updated">
      <span>LAST UPDATED</span>
      <strong id="last-updated">—</strong>
    </div>
  </section>

  <!-- CURRENT WEATHER -->
  <section class="hero-weather" aria-live="polite">
    <div class="hero-main">
      <div class="weather-icon-container">
        <div class="weather-icon" id="weather-icon">
          ☀️
        </div>
      </div>

      <div class="hero-temperature">
        <div class="temperature" id="temperature">
          —°
        </div>

        <div class="feels-like">
          Feels like
          <strong id="feels-like">—°</strong>
        </div>
      </div>

      <div class="hero-description">
        <h2 id="description">
          Loading weather...
        </h2>

        <p>
          Humidity
          <strong id="hero-humidity">—%</strong>
        </p>
      </div>
    </div>

    <div class="hero-side">
      <div class="metric">
        <span class="metric-label">WIND</span>
        <strong id="wind">— km/h</strong>
      </div>

      <div class="metric">
        <span class="metric-label">PRESSURE</span>
        <strong id="pressure">— hPa</strong>
      </div>

      <div class="metric">
        <span class="metric-label">VISIBILITY</span>
        <strong id="visibility">— km</strong>
      </div>
    </div>
  </section>

  <!-- HOURLY -->
  <section class="weather-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">NEXT 24 HOURS</p>
        <h2>Hourly forecast</h2>
      </div>
    </div>

    <div class="hourly-wrapper">
      <button
        class="forecast-arrow"
        id="hourly-prev"
        type="button"
        aria-label="Previous hours"
      >
        ←
      </button>

      <div
        class="hourly-scroll"
        id="hourly-container"
      ></div>

      <button
        class="forecast-arrow"
        id="hourly-next"
        type="button"
        aria-label="Next hours"
      >
        →
      </button>
    </div>
  </section>

  <!-- DAILY -->
  <section class="weather-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">UPCOMING</p>
        <h2>7-day forecast</h2>
      </div>
    </div>

    <div
      class="daily-container"
      id="daily-container"
    ></div>
  </section>

  <!-- DETAILS -->
  <section class="weather-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">ADDITIONAL DATA</p>
        <h2>Weather details</h2>
      </div>
    </div>

    <div class="details-grid">
      <article class="detail-card">
        <span class="detail-icon">💧</span>

        <div>
          <span class="detail-label">Humidity</span>
          <strong id="humidity">—%</strong>
        </div>
      </article>

      <article class="detail-card">
        <span class="detail-icon">💨</span>

        <div>
          <span class="detail-label">Wind speed</span>
          <strong id="wind-detail">— km/h</strong>
        </div>
      </article>

      <article class="detail-card">
        <span class="detail-icon">🌡️</span>

        <div>
          <span class="detail-label">Feels like</span>
          <strong id="feels-detail">—°C</strong>
        </div>
      </article>

      <article class="detail-card">
        <span class="detail-icon">🔵</span>

        <div>
          <span class="detail-label">Pressure</span>
          <strong id="pressure-detail">— hPa</strong>
        </div>
      </article>

      <article class="detail-card">
        <span class="detail-icon">👁️</span>

        <div>
          <span class="detail-label">Visibility</span>
          <strong id="visibility-detail">— km</strong>
        </div>
      </article>

      <article class="detail-card">
        <span class="detail-icon">🌧️</span>

        <div>
          <span class="detail-label">Rain probability</span>
          <strong id="rain-detail">—%</strong>
        </div>
      </article>
    </div>
  </section>

  <!-- SUN -->
  <section class="weather-section">
    <div class="sun-card">
      <div>
        <span class="sun-label">SUNRISE</span>
        <strong id="sunrise">—</strong>
      </div>

      <div class="sun-line">
        <span class="sun-ball"></span>
      </div>

      <div>
        <span class="sun-label">SUNSET</span>
        <strong id="sunset">—</strong>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="weather-footer">
    <span>Weather data powered by Open-Meteo</span>
    <span>•</span>
    <span id="footer-location">{defaultLocation}</span>
  </footer>
</div>
```

  </main>
</Layout>

<script>
  type LocationData = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  type WeatherCurrentData = {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    wind_speed_10m: number;
    surface_pressure: number;
    visibility: number;
    weather_code: number;
  };

  type WeatherHourlyData = {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  };

  type WeatherDailyData = {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  };

  type WeatherData = {
    current: WeatherCurrentData;
    hourly: WeatherHourlyData;
    daily: WeatherDailyData;
  };

  const locations: Record<string, LocationData> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let selectedLocation = "Alcoi";
  let weatherData: WeatherData | null = null;

  let hourlyStartIndex = 0;
  let currentHourIndex = 0;

  function getElement<T extends HTMLElement>(
    id: string,
  ): T | null {
    return document.getElementById(id) as T | null;
  }

  function updateElement(
    id: string,
    value: string,
  ): void {
    const element = document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }

  function getWeatherIcon(
    code: number,
    isNight = false,
  ): string {
    if (isNight) {
      if (code === 0) return "🌙";

      if (code === 1 || code === 2 || code === 3) {
        return "☁️";
      }
    }

    if (code === 0) return "☀️";
    if (code === 1) return "🌤️";
    if (code === 2) return "⛅";
    if (code === 3) return "☁️";

    if (code === 45 || code === 48) return "🌫️";

    if (code >= 51 && code <= 57) return "🌦️";

    if (code >= 61 && code <= 67) return "🌧️";

    if (code >= 71 && code <= 77) return "❄️";

    if (code >= 80 && code <= 82) return "🌦️";

    if (code >= 85 && code <= 86) return "🌨️";

    if (code >= 95 && code <= 99) return "⛈️";

    return "🌤️";
  }

  function getWeatherDescription(code: number): string {
    if (code === 0) return "Clear sky";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Overcast";

    if (code === 45 || code === 48) return "Fog";

    if (code >= 51 && code <= 57) return "Drizzle";

    if (code >= 61 && code <= 67) return "Rain";

    if (code >= 71 && code <= 77) return "Snow";

    if (code >= 80 && code <= 82) return "Rain showers";

    if (code >= 85 && code <= 86) return "Snow showers";

    if (code >= 95 && code <= 99) return "Thunderstorm";

    return "Unknown conditions";
  }

  function parseLocalDate(value: string): Date {
    return new Date(value);
  }

  function formatHour(value: string): string {
    const date = parseLocalDate(value);

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  function formatDay(
    value: string,
    index: number,
  ): string {
    if (index === 0) {
      return "Today";
    }

    const date = new Date(`${value}T12:00:00`);

    return date.toLocaleDateString("en-GB", {
      weekday: "short",
    });
  }

  function formatDateTime(): string {
    return new Date().toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  function getIsNight(
    currentTime: Date,
    sunrise: string,
    sunset: string,
  ): boolean {
    const current = currentTime.getTime();
    const rise = parseLocalDate(sunrise).getTime();
    const set = parseLocalDate(sunset).getTime();

    return current < rise || current > set;
  }

  function renderCurrent(
    data: WeatherData,
  ): void {
    const location = locations[selectedLocation];
    const current = data.current;

    const todaySunrise = data.daily.sunrise[0];
    const todaySunset = data.daily.sunset[0];

    const isNight = getIsNight(
      new Date(),
      todaySunrise,
      todaySunset,
    );

    updateElement(
      "location-name",
      location.name,
    );

    updateElement(
      "location-region",
      location.region,
    );

    updateElement(
      "footer-location",
      location.name,
    );

    updateElement(
      "temperature",
      `${Math.round(current.temperature_2m)}°`,
    );

    updateElement(
      "feels-like",
      `${Math.round(current.apparent_temperature)}°`,
    );

    updateElement(
      "description",
      getWeatherDescription(current.weather_code),
    );

    updateElement(
      "weather-icon",
      getWeatherIcon(
        current.weather_code,
        isNight,
      ),
    );

    updateElement(
      "humidity",
      `${Math.round(current.relative_humidity_2m)}%`,
    );

    updateElement(
      "hero-humidity",
      `${Math.round(current.relative_humidity_2m)}%`,
    );

    updateElement(
      "wind",
      `${Math.round(current.wind_speed_10m)} km/h`,
    );

    updateElement(
      "wind-detail",
      `${Math.round(current.wind_speed_10m)} km/h`,
    );

    updateElement(
      "pressure",
      `${Math.round(current.surface_pressure)} hPa`,
    );

    updateElement(
      "pressure-detail",
      `${Math.round(current.surface_pressure)} hPa`,
    );

    updateElement(
      "visibility",
      `${Math.round(current.visibility / 1000)} km`,
    );

    updateElement(
      "visibility-detail",
      `${Math.round(current.visibility / 1000)} km`,
    );

    updateElement(
      "feels-detail",
      `${Math.round(current.apparent_temperature)}°C`,
    );

    updateElement(
      "rain-detail",
      `${data.daily.precipitation_probability_max[0] ?? 0}%`,
    );

    updateElement(
      "sunrise",
      formatHour(todaySunrise),
    );

    updateElement(
      "sunset",
      formatHour(todaySunset),
    );

    updateElement(
      "last-updated",
      formatDateTime(),
    );
  }

  function createHourlyCard(
    data: WeatherData,
    index: number,
  ): HTMLElement {
    const time = data.hourly.time[index];

    const temperature =
      data.hourly.temperature_2m[index] ?? 0;

    const rain =
      data.hourly.precipitation_probability[index] ?? 0;

    const code =
      data.hourly.weather_code[index] ?? 0;

    const item = document.createElement("article");

    item.className =
      index === currentHourIndex
        ? "hour-card current"
        : "hour-card";

    const timeLabel =
      index === currentHourIndex
        ? "NOW"
        : formatHour(time);

    item.innerHTML = `
      <span class="hour-time">${timeLabel}</span>

      <span class="hour-icon">
        ${getWeatherIcon(code)}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;

    return item;
  }

  function renderHourly(
    data: WeatherData,
  ): void {
    const container =
      getElement<HTMLDivElement>(
        "hourly-container",
      );

    if (!container) return;

    const endIndex = Math.min(
      hourlyStartIndex + 12,
      data.hourly.time.length,
    );

    container.innerHTML = "";

    for (
      let i = hourlyStartIndex;
      i < endIndex;
      i += 1
    ) {
      container.appendChild(
        createHourlyCard(data, i),
      );
    }

    updateHourlyButtons();
  }

  function updateHourlyButtons(): void {
    const previousButton =
      getElement<HTMLButtonElement>(
        "hourly-prev",
      );

    const nextButton =
      getElement<HTMLButtonElement>(
        "hourly-next",
      );

    if (!weatherData) {
      if (previousButton) {
        previousButton.disabled = true;
      }

      if (nextButton) {
        nextButton.disabled = true;
      }

      return;
    }

    const maxStart = Math.max(
      0,
      weatherData.hourly.time.length - 12,
    );

    if (previousButton) {
      previousButton.disabled =
        hourlyStartIndex <= 0;
    }

    if (nextButton) {
      nextButton.disabled =
        hourlyStartIndex >= maxStart;
    }
  }

  function renderDaily(
    data: WeatherData,
  ): void {
    const container =
      getElement<HTMLDivElement>(
        "daily-container",
      );

    if (!container) return;

    container.innerHTML = "";

    const days = Math.min(
      data.daily.time.length,
      7,
    );

    for (
      let i = 0;
      i < days;
      i += 1
    ) {
      const day = data.daily.time[i];

      const code =
        data.daily.weather_code[i] ?? 0;

      const high =
        data.daily.temperature_2m_max[i] ?? 0;

      const low =
        data.daily.temperature_2m_min[i] ?? 0;

      const rain =
        data.daily.precipitation_probability_max[i] ?? 0;

      const row =
        document.createElement("article");

      row.className = "daily-row";

      row.innerHTML = `
        <div class="daily-day">
          ${formatDay(day, i)}
        </div>

        <div class="daily-icon">
          ${getWeatherIcon(code)}
        </div>

        <div class="daily-condition">
          <strong>
            ${getWeatherDescription(code)}
          </strong>

          <span>
            ${rain}% rain
          </span>
        </div>

        <div class="daily-temperatures">
          <strong>${Math.round(high)}°</strong>
          <span>${Math.round(low)}°</span>
        </div>
      `;

      container.appendChild(row);
    }
  }

  function setLoadingState(): void {
    updateElement(
      "header-status",
      "Loading...",
    );

    updateElement(
      "description",
      "Loading weather...",
    );
  }

  function setErrorState(
    message: string,
  ): void {
    updateElement(
      "header-status",
      "Offline",
    );

    updateElement(
      "description",
      message,
    );

    updateElement(
      "last-updated",
      "Error",
    );
  }

  async function fetchWeather(
    location: LocationData,
  ): Promise<WeatherData> {
    const params = new URLSearchParams({
      latitude: String(location.latitude),
      longitude: String(location.longitude),

      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,surface_pressure,visibility,weather_code",

      hourly:
        "temperature_2m,precipitation_probability,weather_code",

      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset",

      timezone: "auto",

      forecast_days: "7",
    });

    const response = await fetch(
      `https://api.open-meteo.com/v1/forecast?${params.toString()}`,
    );

    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`,
      );
    }

    const data =
      (await response.json()) as WeatherData;

    if (
      !data.current ||
      !data.hourly ||
      !data.daily
    ) {
      throw new Error(
        "Invalid weather response.",
      );
    }

    return data;
  }

  async function loadWeather(
    locationName: string,
  ): Promise<void> {
    const location = locations[locationName];

    if (!location) return;

    selectedLocation = locationName;

    weatherData = null;

    hourlyStartIndex = 0;
    currentHourIndex = 0;

    setLoadingState();

    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-tab",
      )
      .forEach((button) => {
        button.classList.toggle(
          "active",
          button.dataset.location === locationName,
        );
      });

    try {
      const response =
        await fetchWeather(location);

      weatherData = response;

      /*
       * Open-Meteo returns hourly timestamps in
       * the requested location's local timezone
       * because timezone=auto is used.
       *
       * Find the first forecast hour that is
       * equal to or later than the current hour.
       */
      const now = new Date();

      let foundIndex =
        response.hourly.time.findIndex(
          (time) => {
            const forecastDate =
              new Date(time);

            return (
              forecastDate.getTime() >=
              now.getTime()
            );
          },
        );

      /*
       * Some browsers parse timezone-less
       * Open-Meteo timestamps differently.
       *
       * If no matching hour is found,
       * use the current hour based on the
       * returned hourly array.
       */
      if (foundIndex < 0) {
        foundIndex = 0;
      }

      currentHourIndex = foundIndex;

      hourlyStartIndex = foundIndex;

      renderCurrent(response);
      renderHourly(response);
      renderDaily(response);

      updateElement(
        "header-status",
        "Live data",
      );
    } catch (error) {
      console.error(
        "Weather loading error:",
        error,
      );

      setErrorState(
        "Unable to load weather data.",
      );
    }
  }

  /*
   * Location buttons
   */
  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-tab",
    )
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const locationName =
            button.dataset.location;

          if (!locationName) return;

          void loadWeather(locationName);
        },
      );
    });

  /*
   * Previous hourly forecast
   */
  getElement<HTMLButtonElement>(
    "hourly-prev",
  )?.addEventListener(
    "click",
    () => {
      if (!weatherData) return;

      hourlyStartIndex =
        Math.max(
          0,
          hourlyStartIndex - 6,
        );

      renderHourly(weatherData);
    },
  );

  /*
   * Next hourly forecast
   */
  getElement<HTMLButtonElement>(
    "hourly-next",
  )?.addEventListener(
    "click",
    () => {
      if (!weatherData) return;

      const maxStart =
        Math.max(
          0,
          weatherData.hourly.time.length - 12,
        );

      hourlyStartIndex =
        Math.min(
          maxStart,
          hourlyStartIndex + 6,
        );

      renderHourly(weatherData);
    },
  );

  /*
   * Initial request
   */
  void loadWeather("Alcoi");
</script>

<style>
  :global(html) {
    background: var(--background);
  }

  :global(body) {
    background: var(--background);
    color: var(--white);
  }

  .weather-page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(164, 118, 255, 0.16),
        transparent 35rem
      ),
      var(--background);

    color: var(--white);
  }

  /* HEADER */

  .weather-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom: 1px solid
      rgba(255, 255, 255, 0.08);

    background: rgba(16, 16, 16, 0.88);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    width: min(
      100% - 28px,
      1200px
    );

    min-height: 68px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .back-link {
    color: var(--sec);

    text-decoration: none;

    font-size: 0.72rem;
    font-weight: 800;

    letter-spacing: 0.1em;
    text-transform: uppercase;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.75;
    transform: translateX(-2px);
  }

  .header-title {
    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 0.75rem;
    font-weight: 800;

