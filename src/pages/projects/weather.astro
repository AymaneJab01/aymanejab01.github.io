<style>
  /* ============================================================ */
  /* PAGE */
  /* ============================================================ */

  .weather-page {
    --electric-blue: #00aeff;
    --electric-blue-bright: #37c5ff;
    --electric-blue-soft: rgba(0, 174, 255, 0.1);
    --white-main: #ffffff;
    --white-soft: rgba(255, 255, 255, 0.68);
    --white-muted: rgba(255, 255, 255, 0.4);
    --border: rgba(255, 255, 255, 0.1);
    --border-blue: rgba(0, 174, 255, 0.32);

    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--white-main);
    background:
      linear-gradient(
        180deg,
        #0b0d10 0%,
        #0d1014 45%,
        #090b0e 100%
      );
  }


  .weather-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }


  .weather-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(0, 174, 255, 0.09),
        transparent 38%
      ),
      radial-gradient(
        circle at 0% 45%,
        rgba(0, 120, 255, 0.035),
        transparent 32%
      ),
      radial-gradient(
        circle at 100% 65%,
        rgba(0, 200, 255, 0.025),
        transparent 35%
      );
  }


  .weather-content {
    position: relative;
    z-index: 2;
  }


  .weather-wrapper {
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 120px 24px 80px;
  }


  /* ============================================================ */
  /* HEADER */
  /* ============================================================ */

  .weather-header {
    margin-bottom: 100px;
  }


  .project-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    color: var(--electric-blue);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }


  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--electric-blue);
    box-shadow:
      0 0 8px var(--electric-blue),
      0 0 20px rgba(0, 174, 255, 0.45);
  }


  .weather-header h1 {
    max-width: 900px;
    margin: 0;
    color: var(--white-main);
    font-size: clamp(3.2rem, 8vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.065em;
  }


  .weather-header h1 span {
    color: var(--electric-blue);
    text-shadow:
      0 0 25px rgba(0, 174, 255, 0.4);
  }


  .header-description {
    max-width: 700px;
    margin-top: 30px;
    color: var(--white-soft);
    font-size: 16px;
    line-height: 1.9;
  }


  .technology-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 30px;
  }


  .technology-tags span,
  .technology-list span {
    padding: 7px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--white-soft);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 11px;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }


  .technology-tags span:hover,
  .technology-list span:hover {
    border-color: var(--border-blue);
    color: var(--electric-blue-bright);
    background: rgba(0, 174, 255, 0.035);
  }


  /* ============================================================ */
  /* SECTIONS */
  /* ============================================================ */

  .weather-section {
    margin-top: 90px;
  }


  .section-heading > span,
  .technologies > span {
    display: inline-block;
    color: var(--electric-blue);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }


  .section-heading h2 {
    margin-top: 12px;
    color: var(--white-main);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }


  .section-heading p {
    max-width: 680px;
    margin-top: 14px;
    color: var(--white-soft);
    font-size: 14px;
    line-height: 1.8;
  }


  .section-divider {
    height: 1px;
    margin-bottom: 40px;
    background: var(--border);
  }


  /* ============================================================ */
  /* WEATHER CARDS */
  /* ============================================================ */

  .weather-cards {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }


  .weather-card {
    position: relative;
    min-height: 460px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.045),
        rgba(255, 255, 255, 0.012)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 25px 80px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(18px);
    transition:
      transform 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }


  .weather-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-blue);
    box-shadow:
      0 0 0 1px rgba(0, 174, 255, 0.04),
      0 25px 90px rgba(0, 130, 255, 0.1);
  }


  .card-glow {
    position: absolute;
    top: -180px;
    right: -150px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(0, 174, 255, 0.2),
        rgba(0, 174, 255, 0)
      );
    filter: blur(15px);
    pointer-events: none;
    transition:
      transform 0.7s ease,
      opacity 0.5s ease;
  }


  .weather-card:hover .card-glow {
    transform:
      scale(1.3)
      translate(-20px, 25px);
  }


  .card-content {
    position: relative;
    z-index: 2;
    padding: 32px;
  }


  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }


  .location-label {
    display: block;
    color: var(--electric-blue);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }


  .card-top h3 {
    margin-top: 8px;
    color: var(--white-main);
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }


  .card-top h3 span {
    color: var(--electric-blue);
  }


  .card-top p {
    margin-top: 5px;
    color: var(--white-muted);
    font-size: 13px;
  }


  .weather-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border: 1px solid var(--border-blue);
    border-radius: 18px;
    color: var(--electric-blue-bright);
    background:
      rgba(0, 174, 255, 0.045);
    font-size: 32px;
    text-shadow:
      0 0 20px rgba(0, 174, 255, 0.45);
  }


  /* ============================================================ */
  /* TEMPERATURE */
  /* ============================================================ */

  .temperature-area {
    margin-top: 70px;
  }


  .temperature-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }


  .weather-temperature {
    color: var(--white-main);
    font-size: clamp(4.5rem, 9vw, 7rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.08em;
  }


  .temperature-unit {
    margin-bottom: 7px;
    color: var(--electric-blue);
    font-size: 16px;
  }


  .weather-description {
    margin-top: 18px;
    color: var(--white-soft);
    font-size: 14px;
  }


  /* ============================================================ */
  /* WEATHER DATA */
  /* ============================================================ */

  .weather-data {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 35px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }


  .data-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }


  .data-item span {
    color: var(--white-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }


  .data-item strong {
    color: var(--white-main);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 14px;
    font-weight: 500;
  }


  /* ============================================================ */
  /* FORECAST */
  /* ============================================================ */

  .forecast-controls {
    display: flex;
    gap: 8px;
    margin-top: 28px;
  }


  .forecast-button {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 9px 16px;
    color: var(--white-soft);
    background: rgba(255, 255, 255, 0.015);
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }


  .forecast-button:hover,
  .forecast-button.active {
    border-color: var(--border-blue);
    color: var(--electric-blue-bright);
    background: rgba(0, 174, 255, 0.07);
    box-shadow:
      0 0 20px rgba(0, 174, 255, 0.06);
  }


  .forecast-container {
    display: grid;
    grid-template-columns:
      repeat(7, minmax(0, 1fr));
    margin-top: 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
      rgba(255, 255, 255, 0.018);
    backdrop-filter: blur(15px);
  }


  .forecast-item {
    min-width: 0;
    padding: 22px 10px;
    border-right: 1px solid var(--border);
    text-align: center;
    transition: background 0.25s ease;
  }


  .forecast-item:last-child {
    border-right: 0;
  }


  .forecast-item:hover {
    background:
      rgba(0, 174, 255, 0.035);
  }


  .forecast-day {
    display: block;
    color: var(--white-soft);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  .forecast-icon {
    display: block;
    margin: 20px 0 10px;
    color: var(--electric-blue-bright);
    font-size: 27px;
    text-shadow:
      0 0 15px rgba(0, 174, 255, 0.3);
  }


  .forecast-description {
    display: block;
    min-height: 28px;
    color: var(--white-muted);
    font-size: 8px;
    line-height: 1.4;
  }


  .forecast-temperatures {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 18px;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 12px;
  }


  .forecast-temperatures strong {
    color: var(--white-main);
    font-weight: 500;
  }


  .forecast-temperatures span {
    color: var(--white-muted);
  }


  .forecast-loading {
    grid-column: 1 / -1;
    padding: 45px 20px;
    color: var(--white-muted);
    text-align: center;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 11px;
  }


  /* ============================================================ */
  /* DOCUMENTATION */
  /* ============================================================ */

  .documentation-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 38px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--border);
  }


  .documentation-card {
    padding: 28px;
    background:
      rgba(255, 255, 255, 0.025);
    transition: background 0.25s ease;
  }


  .documentation-card:hover {
    background:
      rgba(0, 174, 255, 0.025);
  }


  .documentation-card > span {
    color: var(--electric-blue);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 10px;
  }


  .documentation-card h3 {
    margin-top: 16px;
    color: var(--white-main);
    font-size: 17px;
    font-weight: 500;
  }


  .documentation-card p {
    margin-top: 10px;
    color: var(--white-soft);
    font-size: 13px;
    line-height: 1.8;
  }


  .technologies {
    margin-top: 45px;
  }


  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }


  /* ============================================================ */
  /* API */
  /* ============================================================ */

  .api-section {
    margin-top: 70px;
  }


  .api-box {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background:
      rgba(255, 255, 255, 0.02);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.025);
