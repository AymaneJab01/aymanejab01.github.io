---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">
  <main class="weather-page">
    <!-- Interactive background -->
    <canvas
      id="weather-background"
      class="weather-background"
      aria-hidden="true"
    ></canvas>

    <div class="weather-atmosphere" aria-hidden="true"></div>

    <section class="weather-content">
      <div class="weather-wrapper">

        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <header class="weather-header">
          <div class="project-label">
            <span class="status-dot"></span>
            <span>PROJECT 03 / WEATHER</span>
          </div>

          <h1>
            Weather Dashboard<span>.</span>
          </h1>

          <p class="header-description">
            A real-time weather interface for Alcoi and Valencia,
            combining live meteorological data with an interactive
            developer-oriented visual system.
          </p>

          <div class="technology-tags">
            <span>Astro</span>
            <span>TypeScript</span>
            <span>Open-Meteo</span>
            <span>Canvas</span>
            <span>REST API</span>
          </div>
        </header>


        <!-- ====================================================== -->
        <!-- CURRENT WEATHER -->
        <!-- ====================================================== -->

        <section class="weather-section" aria-labelledby="current-title">
          <div class="section-heading">
            <span>LIVE CONDITIONS</span>

            <h2 id="current-title">
              Current weather
            </h2>

            <p>
              Live meteorological conditions retrieved directly
              from the Open-Meteo API.
            </p>
          </div>


          <div class="weather-cards">

            <!-- ALCOI -->

            <article
              class="weather-card"
              data-lat="38.6983"
              data-lon="-0.4743"
              data-city="Alcoi"
            >
              <div class="card-glow"></div>

              <div class="card-content">
                <div class="card-top">
                  <div>
                    <span class="location-label">
                      LOCATION
                    </span>

                    <h3>
                      Alcoi<span>.</span>
                    </h3>

                    <p>
                      Alicante, Spain
                    </p>
                  </div>

                  <div
                    class="weather-icon"
                    aria-hidden="true"
                  >
                    —
                  </div>
                </div>

                <div class="temperature-area">
                  <div class="temperature-row">
                    <span class="weather-temperature">--</span>
                    <span class="temperature-unit">°C</span>
                  </div>

                  <p class="weather-description">
                    Loading weather...
                  </p>
                </div>

                <div class="weather-data">
                  <div class="data-item">
                    <span>FEELS LIKE</span>
                    <strong class="weather-feels">--</strong>
                  </div>

                  <div class="data-item">
                    <span>WIND</span>
                    <strong class="weather-wind">--</strong>
                  </div>

                  <div class="data-item">
                    <span>HUMIDITY</span>
                    <strong class="weather-humidity">--</strong>
                  </div>

                  <div class="data-item">
                    <span>UPDATED</span>
                    <strong class="weather-time">--</strong>
                  </div>
                </div>
              </div>
            </article>


            <!-- VALENCIA -->

            <article
              class="weather-card"
              data-lat="39.4699"
              data-lon="-0.3763"
              data-city="Valencia"
            >
              <div class="card-glow"></div>

              <div class="card-content">
                <div class="card-top">
                  <div>
                    <span class="location-label">
                      LOCATION
                    </span>

                    <h3>
                      Valencia<span>.</span>
                    </h3>

                    <p>
                      Valencia, Spain
                    </p>
                  </div>

                  <div
                    class="weather-icon"
                    aria-hidden="true"
                  >
                    —
                  </div>
                </div>

                <div class="temperature-area">
                  <div class="temperature-row">
                    <span class="weather-temperature">--</span>
                    <span class="temperature-unit">°C</span>
                  </div>

                  <p class="weather-description">
                    Loading weather...
                  </p>
                </div>

                <div class="weather-data">
                  <div class="data-item">
                    <span>FEELS LIKE</span>
                    <strong class="weather-feels">--</strong>
                  </div>

                  <div class="data-item">
                    <span>WIND</span>
                    <strong class="weather-wind">--</strong>
                  </div>

                  <div class="data-item">
                    <span>HUMIDITY</span>
                    <strong class="weather-humidity">--</strong>
                  </div>

                  <div class="data-item">
                    <span>UPDATED</span>
                    <strong class="weather-time">--</strong>
                  </div>
                </div>
              </div>
            </article>

          </div>
        </section>


        <!-- ====================================================== -->
        <!-- FORECAST -->
        <!-- ====================================================== -->

        <section
          class="weather-section forecast-section"
          aria-labelledby="forecast-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>FORECAST</span>

            <h2 id="forecast-title">
              Seven day outlook
            </h2>

            <p>
              A seven-day forecast generated from the same live
              weather service.
            </p>
          </div>


          <div class="forecast-controls">
            <button
              type="button"
              class="forecast-button active"
              data-forecast-location="38.6983,-0.4743"
            >
              Alcoi
            </button>

            <button
              type="button"
              class="forecast-button"
              data-forecast-location="39.4699,-0.3763"
            >
              Valencia
            </button>
          </div>


          <div
            id="forecast-container"
            class="forecast-container"
          >
            <div class="forecast-loading">
              Loading forecast...
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- DOCUMENTATION -->
        <!-- ====================================================== -->

        <section
          class="weather-section documentation-section"
          aria-labelledby="documentation-title"
        >
          <div class="section-divider"></div>

          <div class="section-heading">
            <span>DOCUMENTATION</span>

            <h2 id="documentation-title">
              Live data meets interactive UI.
            </h2>

            <p>
              This project combines a lightweight Astro page with
              client-side TypeScript to retrieve and display live
              meteorological information.
            </p>
          </div>


          <div class="documentation-grid">

            <article class="documentation-card">
              <span>01</span>

              <h3>
                Data source
              </h3>

              <p>
                Weather information is retrieved from Open-Meteo
                using geographic coordinates for Alcoi and Valencia.
              </p>
            </article>


            <article class="documentation-card">
              <span>02</span>

              <h3>
                Client rendering
              </h3>

              <p>
                TypeScript fetches weather information in the
                browser and updates the interface dynamically.
              </p>
            </article>


            <article class="documentation-card">
              <span>03</span>

              <h3>
                Interactive background
              </h3>

              <p>
                Canvas particles, connections and a subtle grid
                create an electric-blue technological atmosphere.
              </p>
            </article>


            <article class="documentation-card">
              <span>04</span>

              <h3>
                Responsive design
              </h3>

              <p>
                The dashboard adapts between mobile and desktop
                layouts while preserving the visual hierarchy.
              </p>
            </article>

          </div>


          <div class="technologies">
            <span>TECHNOLOGIES</span>

            <div class="technology-list">
              <span>Astro</span>
              <span>TypeScript</span>
              <span>Open-Meteo API</span>
              <span>Fetch API</span>
              <span>HTML</span>
              <span>CSS</span>
              <span>Canvas API</span>
            </div>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- API -->
        <!-- ====================================================== -->

        <section class="api-section">
          <div class="api-box">
            <div class="api-header">
              <span class="api-dot"></span>
              <span>API ENDPOINT</span>
            </div>

            <code>
              api.open-meteo.com/v1/forecast
            </code>
          </div>
        </section>


        <!-- ====================================================== -->
        <!-- BACK -->
        <!-- ====================================================== -->

        <div class="back-section">
          <a
            href="/#projects"
            class="back-link"
          >
            <span>←</span>
            <span>Back to projects</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }

 }


  /* ============================================================ */
  /* WEATHER DESCRIPTION */
  /* ============================================================ */

  function getWeatherDescription(code: number): string {
    switch (code) {
      case 0:
        return "Clear sky";

      case 1:
        return "Mainly clear";

      case 2:
        return "Partly cloudy";

      case 3:
        return "Overcast";

      case 45:
        return "Fog";

      case 48:
        return "Rime fog";

      case 51:
        return "Light drizzle";

      case 53:
        return "Moderate drizzle";

      case 55:
        return "Dense drizzle";

      case 56:
        return "Light freezing drizzle";

      case 57:
        return "Dense freezing drizzle";

      case 61:
        return "Light rain";

      case 63:
        return "Moderate rain";

      case 65:
        return "Heavy rain";

      case 66:
        return "Light freezing rain";

      case 67:
        return "Heavy freezing rain";

      case 71:
        return "Light snow";

      case 73:
        return "Moderate snow";

      case 75:
        return "Heavy snow";

      case 77:
        return "Snow grains";

      case 80:
        return "Light rain showers";

      case 81:
        return "Moderate rain showers";

      case 82:
        return "Heavy rain showers";

      case 85:
        return "Light snow showers";

      case 86:
        return "Heavy snow showers";

      case 95:
        return "Thunderstorm";

      case 96:
        return "Thunderstorm with hail";

      case 99:
        return "Thunderstorm with heavy hail";

      default:
        return "Unknown conditions";
    }
  }


  /* ============================================================ */
  /* WEATHER ICON */
  /* ============================================================ */

  function getWeatherIcon(code: number): string {
    if (code === 0) {
      return "☀";
    }

    if (code <= 3) {
      return "◐";
    }

    if (code <= 48) {
      return "≋";
    }

    if (code <= 67) {
      return "∿";
    }

    if (code <= 77) {
      return "❄";
    }

    if (code <= 86) {
      return "◒";
    }

    return "ϟ";
  }


  /* ============================================================ */
  /* API URL */
  /* ============================================================ */

  function buildWeatherUrl(
    latitude: string,
    longitude: string
  ): string {
    const base =
      "https://api.open-meteo.com/v1/forecast";

    const params = new URLSearchParams({
      latitude,
      longitude,
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min",
      timezone: "Europe/Madrid",
      forecast_days: "7"
    });

    return `${base}?${params.toString()}`;
  }


  /* ============================================================ */
  /* FORMAT TIME */
  /* ============================================================ */

  function formatTime(value: string): string {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }


  /* ============================================================ */
  /* FORMAT DAY */
  /* ============================================================ */

  function formatDay(value: string): string {
    const date = new Date(`${value}T12:00:00`);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleDateString("en-GB", {
      weekday: "short"
    });
  }


  /* ============================================================ */
  /* LOAD CURRENT WEATHER */
  /* ============================================================ */

  async function loadCurrentWeather(
    card: HTMLElement
  ): Promise<void> {
    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }

    const temperature =
      card.querySelector<HTMLElement>(
        ".weather-temperature"
      );

    const description =
      card.querySelector<HTMLElement>(
        ".weather-description"
      );

    const feels =
      card.querySelector<HTMLElement>(
        ".weather-feels"
      );

    const wind =
      card.querySelector<HTMLElement>(
        ".weather-wind"
      );

    const humidity =
      card.querySelector<HTMLElement>(
        ".weather-humidity"
      );

    const time =
      card.querySelector<HTMLElement>(
        ".weather-time"
      );

    const icon =
      card.querySelector<HTMLElement>(
        ".weather-icon"
      );


    try {
      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );

      if (!response.ok) {
        throw new Error(
          `Weather request failed: ${response.status}`
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      const current =
        data.current;


      if (temperature) {
        temperature.textContent =
          Math.round(
            current.temperature_2m
          ).toString();
      }


      if (description) {
        description.textContent =
          getWeatherDescription(
            current.weather_code
          );
      }


      if (feels) {
        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°C`;
      }


      if (wind) {
        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (humidity) {
        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (time) {
        time.textContent =
          formatTime(
            current.time
          );
      }


      if (icon) {
        icon.textContent =
          getWeatherIcon(
            current.weather_code
          );
      }

    } catch (error) {
      console.error(
        "Current weather error:",
        error
      );

      if (description) {
        description.textContent =
          "Unable to load weather";
      }

      if (temperature) {
        temperature.textContent =
          "--";
      }
    }
  }


  /* ============================================================ */
  /* WEATHER CARDS */
  /* ============================================================ */

  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );

  weatherCards.forEach(
    (card: HTMLElement) => {
      void loadCurrentWeather(card);
    }
  );


  /* ============================================================ */
  /* FORECAST */
  /* ============================================================ */

  const forecastContainer =
    document.getElementById(
      "forecast-container"
    ) as HTMLElement | null;


  const forecastButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );


  async function loadForecast(
    latitude: string,
    longitude: string
  ): Promise<void> {
    if (!forecastContainer) {
      return;
    }

    forecastContainer.innerHTML =
      '<div class="forecast-loading">Loading forecast...</div>';


    try {
      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );

      if (!response.ok) {
        throw new Error(
          `Forecast request failed: ${response.status}`
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      const daily =
        data.daily;


      forecastContainer.innerHTML = "";


      for (
        let index = 0;
        index < daily.time.length;
        index += 1
      ) {
        const date =
          daily.time[index];

        const weatherCode =
          daily.weather_code[index];

        const maximum =
          daily.temperature_2m_max[index];

        const minimum =
          daily.temperature_2m_min[index];


        if (
          date === undefined ||
          weatherCode === undefined ||
          maximum === undefined ||
          minimum === undefined
        ) {
          continue;
        }


        const item =
          document.createElement(
            "article"
          );

        item.className =
          "forecast-item";


        const day =
          document.createElement(
            "span"
          );

        day.className =
          "forecast-day";

        day.textContent =
          index === 0
            ? "Today"
            : formatDay(date);


        const icon =
          document.createElement(
            "span"
          );

        icon.className =
          "forecast-icon";

        icon.textContent =
          getWeatherIcon(
            weatherCode
          );


        const description =
          document.createElement(
            "span"
          );

        description.className =
          "forecast-description";

        description.textContent =
          getWeatherDescription(
            weatherCode
          );


        const temperatures =
          document.createElement(
            "div"
          );

        temperatures.className =
          "forecast-temperatures";


        const high =
          document.createElement(
            "strong"
          );

        high.textContent =
          `${Math.round(maximum)}°`;


        const low =
          document.createElement(
            "span"
          );

        low.textContent =
          `${Math.round(minimum)}°`;


        temperatures.append(
          high,
          low
        );


        item.append(
          day,
          icon,
          description,
          temperatures
        );


        forecastContainer.appendChild(
          item
        );
      }

    } catch (error) {
      console.error(
        "Forecast error:",
        error
      );

      forecastContainer.innerHTML =
        '<div class="forecast-loading">Unable to load forecast.</div>';
    }
  }


  const firstForecastButton =
    forecastButtons.item(0);


  if (firstForecastButton) {
    const location =
      firstForecastButton.dataset.forecastLocation;

    if (location) {
      const parts =
        location.split(",");

      const latitude =
        parts[0];

      const longitude =
        parts[1];

      if (latitude && longitude) {
        void loadForecast(
          latitude,
          longitude
        );
      }
    }
  }


  forecastButtons.forEach(
    (button: HTMLButtonElement) => {
      button.addEventListener(
        "click",
        () => {
          forecastButtons.forEach(
            (otherButton: HTMLButtonElement) => {
              otherButton.classList.remove(
                "active"
              );
            }
          );

          button.classList.add(
            "active"
          );


          const location =
            button.dataset.forecastLocation;

          if (!location) {
            return;
          }


          const parts =
            location.split(",");

          const latitude =
            parts[0];

          const longitude =
            parts[1];

          if (!latitude || !longitude) {
            return;
          }


          void loadForecast(
            latitude,
            longitude
          );
        }
      );
    }
  );
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE CANVAS -->
<!-- ============================================================= -->

<script>
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    opacity: number;
  }


  const canvas =
    document.getElementById(
      "weather-background"
    ) as HTMLCanvasElement | null;


  if (canvas) {
    const context =
      canvas.getContext("2d");


    if (context) {
      const particles: Particle[] = [];


      let width = 0;
      let height = 0;

      let mouseX = 0;
      let mouseY = 0;

      let targetMouseX = 0;
      let targetMouseY = 0;

      let animationFrame = 0;


      function getParticleCount(): number {
        return window.innerWidth < 768
          ? 28
          : 55;
      }


      let particleCount =
        getParticleCount();


      function resize(): void {
        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;

        height =
          window.innerHeight;


        canvas.width =
          width * ratio;

        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;

        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particleCount =
          getParticleCount();
      }


      function createParticle(): Particle {
        return {
          x:
            Math.random() * width,

          y:
            Math.random() * height,

          vx:
            (Math.random() - 0.5) * 0.08,

          vy:
            (Math.random() - 0.5) * 0.08,

          size:
            Math.random() * 1.3 + 0.4,

          opacity:
            Math.random() * 0.35 + 0.08
        };
      }


      function initializeParticles(): void {
        particles.length = 0;

        for (
          let index = 0;
          index < particleCount;
          index += 1
        ) {
          particles.push(
            createParticle()
          );
        }
      }


      function drawGrid(): void {
        const spacing = 80;

        const offsetX =
          (mouseX - width / 2) *
          0.012;

        const offsetY =
          (mouseY - height / 2) *
          0.012;


        context.save();

        context.strokeStyle =
          "rgba(0, 174, 255, 0.035)";

        context.lineWidth = 1;


        for (
          let x =
            -spacing +
            (offsetX % spacing);

          x < width + spacing;

          x += spacing
        ) {
          context.beginPath();

          context.moveTo(
            x,
            0
          );

          context.lineTo(
            x,
            height
          );

          context.stroke();
        }


        for (
          let y =
            -spacing +
            (offsetY % spacing);

          y < height + spacing;

          y += spacing
        ) {
          context.beginPath();

          context.moveTo(
            0,
            y
          );

          context.lineTo(
            width,
            y
          );

          context.stroke();
        }


        context.restore();
      }


      function drawConnections(): void {
        const maxDistance = 135;


        for (
          let i = 0;
          i < particles.length;
          i += 1
        ) {
          const first =
            particles[i];

          if (!first) {
            continue;
          }


          for (
            let j = i + 1;
            j < particles.length;
            j += 1
          ) {
            const second =
              particles[j];

            if (!second) {
              continue;
            }


            const dx =
              first.x - second.x;

            const dy =
              first.y - second.y;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              maxDistance
            ) {
              const opacity =
                (1 -
                  distance /
                    maxDistance) *
                0.075;


              context.beginPath();

              context.moveTo(
                first.x,
                first.y
              );

              context.lineTo(
                second.x,
                second.y
              );


              context.strokeStyle =
                `rgba(0,174,255,${opacity})`;

              context.lineWidth = 1;

              context.stroke();
            }
          }
        }
      }


      function drawParticles(): void {
        for (
          const particle of particles
        ) {
          particle.x +=
            particle.vx;

          particle.y +=
            particle.vy;


          if (particle.x < -10) {
            particle.x =
              width + 10;
          }

          if (particle.x > width + 10) {
            particle.x = -10;
          }

          if (particle.y < -10) {
            particle.y =
              height + 10;
          }

          if (particle.y > height + 10) {
            particle.y = -10;
          }


          const dx =
            targetMouseX -
            particle.x;

          const dy =
            targetMouseY -
            particle.y;

          const distance =
            Math.sqrt(
              dx * dx +
              dy * dy
            );


          if (
            distance < 180 &&
            distance > 0
          ) {
            const force =
              (1 -
                distance / 180) *
              0.004;


            particle.vx +=
              dx * force;

            particle.vy +=
              dy * force;
          }


          particle.vx *= 0.996;
          particle.vy *= 0.996;


          context.beginPath();

          context.arc(
            particle.x,
            particle.y,
            particle.size,
            0,
            Math.PI * 2
          );


          context.fillStyle =
            `rgba(0,190,255,${particle.opacity})`;

          context.fill();
        }
      }


      function drawMouseGlow(): void {
        const gradient =
          context.createRadialGradient(
            targetMouseX,
            targetMouseY,
            0,
            targetMouseX,
            targetMouseY,
            260
          );


        gradient.addColorStop(
          0,
          "rgba(0,174,255,0.065)"
        );

        gradient.addColorStop(
          0.45,
          "rgba(0,174,255,0.022)"
        );

        gradient.addColorStop(
          1,
          "rgba(0,174,255,0)"
        );


        context.fillStyle =
          gradient;

        context.fillRect(
          0,
          0,
          width,
          height
        );
      }


      function animate(): void {
        mouseX +=
          (targetMouseX - mouseX) *
          0.045;

        mouseY +=
          (targetMouseY - mouseY) *
          0.045;


        context.clearRect(
          0,
          0,
          width,
          height
        );


        drawMouseGlow();
        drawGrid();
        drawConnections();
        drawParticles();


        animationFrame =
          window.requestAnimationFrame(
            animate
          );
      }


      function handleResize(): void {
        resize();
        initializeParticles();
      }


      function handleMouseMove(
        event: MouseEvent
      ): void {
        targetMouseX =
          event.clientX;

        targetMouseY =
          event.clientY;
      }


      function handleMouseLeave(): void {
        targetMouseX =
          width / 2;

        targetMouseY =
          height / 2;
      }


      resize();


      targetMouseX =
        width / 2;

      targetMouseY =
        height / 2;

      mouseX =
        width / 2;

      mouseY =
        height / 2;


      initializeParticles();


      window.addEventListener(
        "resize",
        handleResize
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        { passive: true }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {
        animationFrame =
          window.requestAnimationFrame(
            animate
          );
      } else {
        drawGrid();
        drawConnections();
        drawParticles();
      }


      window.addEventListener(
        "pagehide",
        () => {
          window.cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            handleResize
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>


