---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">

  <main
    class="weather-page relative min-h-screen overflow-hidden text-[var(--white)]"
  >

    <!-- ========================================================= -->
    <!-- INTERACTIVE BACKGROUND -->
    <!-- ========================================================= -->

    <canvas
      id="weather-background"
      class="pointer-events-none fixed inset-0 -z-20 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div class="weather-background-glow"></div>

    <div class="weather-noise"></div>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <div class="relative z-10">

      <!-- ======================================================= -->
      <!-- HEADER -->
      <!-- ======================================================= -->

      <section class="weather-header">

        <div class="weather-container">

          <div class="doc-label">
            <span class="status-dot"></span>
            PROJECT 03 / WEATHER
          </div>

          <h1 class="weather-title">
            Weather Dashboard<span>.</span>
          </h1>

          <p class="weather-intro">
            Real-time weather conditions and forecasts for
            <strong>Alcoi</strong> and <strong>Valencia</strong>,
            presented through an interactive developer-oriented interface.
          </p>

        </div>

      </section>


      <!-- ======================================================= -->
      <!-- LOCATION SWITCHER -->
      <!-- ======================================================= -->

      <section class="weather-container">

        <div class="location-tabs">

          <button
            class="location-tab active"
            data-location="Alcoi"
            type="button"
          >
            <span class="tab-indicator"></span>
            Alcoi
          </button>

          <button
            class="location-tab"
            data-location="Valencia"
            type="button"
          >
            <span class="tab-indicator"></span>
            Valencia
          </button>

        </div>

      </section>


      <!-- ======================================================= -->
      <!-- MAIN WEATHER -->
      <!-- ======================================================= -->

      <section class="weather-container weather-main">

        <!-- ===================================================== -->
        <!-- ALCOI -->
        <!-- ===================================================== -->

        <article
          class="weather-location active-location"
