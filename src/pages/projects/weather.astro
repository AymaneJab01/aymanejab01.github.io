---
const locations = {
  Valencia: {
    latitude: 39.4699,
    longitude: -0.3763,
    region: "Comunitat Valenciana",
  },
  Alcoi: {
    latitude: 38.6986,
    longitude: -0.4727,
    region: "Alcoi, Alacant",
  },
};

const initialLocation = "Valencia";
const initial = locations[initialLocation];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Interactive weather dashboard"
    />
    <title>Weather — Valencia</title>
  </head>

  <body>
    <main class="weather-page">
      <!-- ========================================================= -->
      <!-- INTERACTIVE ELECTRIC BLUE BACKGROUND                      -->
      <!-- ========================================================= -->

      <canvas id="weather-effect" aria-hidden="true"></canvas>

      <div class="background-wash" aria-hidden="true"></div>

      <!-- ========================================================= -->
      <!-- TOP NAVIGATION                                             -->
      <!-- ========================================================= -->

      <header class="weather-header">
        <div class="header-inner">
          <a href="/" class="brand">
            <span class="brand-mark">
              <span></span>
              <span></span>
              <span></span>
            </span>

            <span class="brand-text">
              WEATHER
            </span>
          </a>

          <div class="header-center">
            <span class="live-dot"></span>
            <span>LIVE WEATHER</span>
          </div>

          <div class="header-actions">
            <button
              id="location-button"
              class="location-button"
              type="button"
            >
              <span class="location-pin">⌖</span>
              <span id="header-location">Valencia</span>
              <span class="chevron">⌄</span>
            </button>
          </div>
        </div>
      </header>

      <!-- ========================================================= -->
      <!-- LOCATION SWITCHER                                          -->
      <!-- ========================================================= -->

      <div id="location-menu" class="location-menu">
        <button type="button" data-location="Valencia">
          <span>Valencia</span>
          <small>39.4699° N · 0.3763° W</small>
        </button>

        <button type="button" data-location="Alcoi">
          <span>Alcoi</span>
          <small>38.6986° N · 0.4727° W</small>
        </button>
      </div>

      <!-- ========================================================= -->
      <!-- MAIN WEATHER CONTAINER                                     -->
      <!-- ========================================================= -->

      <div class="weather-shell">

        <!-- ======================================================= -->
        <!-- BREADCRUMB                                               -->
        <!-- ======================================================= -->

        <div class="breadcrumb">
          <span>Weather</span>
          <span>/</span>
          <strong id="breadcrumb-location">Valencia</strong>
        </div>

        <!-- ======================================================= -->
        <!-- HERO                                                     -->
        <!-- ======================================================= -->

        <section class="hero">

          <div class="hero-top">

            <div>
              <div class="eyebrow">
                CURRENT CONDITIONS
              </div>

              <h1 id="location-title">
                Valencia
              </h1>

              <p id="location-region">
                Comunitat Valenciana
              </p>
            </div>

            <div class="updated">
              <span class="updated-dot"></span>
              Updated <span id="updated-time">--:--</span>
            </div>

          </div>

          <div class="current-weather">

            <div class="temperature-block">

              <div class="weather-icon-large" id="weather-icon">
                ☀
              </div>

              <div class="temperature">
                <span id="temperature">--</span>
                <sup>°</sup>
              </div>

              <div class="condition">
                <strong id="condition">
                  Loading weather
                </strong>

                <span>
                  Feels like
                  <strong id="feels-like">--°</strong>
                </span>
              </div>

            </div>

            <div class="high-low">
              <div>
                <span>HIGH</span>
                <strong id="high-temperature">--°</strong>
              </div>

              <div class="high-low-divider"></div>

              <div>
                <span>LOW</span>
                <strong id="low-temperature">--°</strong>
              </div>
            </div>

          </div>

        </section>

        <!-- ======================================================= -->
        <!-- WEATHER METRICS                                          -->
        <!-- ======================================================= -->

        <section class="metrics">

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">💧</span>
              HUMIDITY
            </div>

            <strong id="humidity">--%</strong>

            <span class="metric-description">
              Relative humidity
            </span>
          </article>

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">〰</span>
              WIND
            </div>

            <strong>
              <span id="wind">--</span>
              <small>km/h</small>
            </strong>

            <span class="metric-description">
              Current wind speed
            </span>
          </article>

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">◌</span>
              PRESSURE
            </div>

            <strong>
              <span id="pressure">--</span>
              <small>hPa</small>
            </strong>

            <span class="metric-description">
              Surface pressure
            </span>
          </article>

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">◉</span>
              VISIBILITY
            </div>

            <strong>
              <span id="visibility">--</span>
              <small>km</small>
            </strong>

            <span class="metric-description">
              Current visibility
            </span>
          </article>

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">☁</span>
              CLOUD COVER
            </div>

            <strong id="cloud-cover">--%</strong>

            <span class="metric-description">
              Sky coverage
            </span>
          </article>

          <article class="metric-card">
            <div class="metric-label">
              <span class="metric-icon">⌁</span>
              PRECIPITATION
            </div>

            <strong id="precipitation">--%</strong>

            <span class="metric-description">
              Probability
            </span>
          </article>

        </section>

        <!-- ======================================================= -->
        <!-- HOURLY FORECAST                                          -->
        <!-- ======================================================= -->

        <section class="weather-section">

          <div class="section-heading">
            <div>
              <span class="section-kicker">
                FORECAST
              </span>

              <h2>Hourly</h2>
            </div>

            <span class="section-meta">
              NEXT 24 HOURS
            </span>
          </div>

          <div class="hourly-wrapper">
            <div id="hourly-list" class="hourly-list">
              <div class="loading-message">
                Loading hourly forecast...
              </div>
            </div>
          </div>

        </section>

        <!-- ======================================================= -->
        <!-- DAILY FORECAST                                           -->
        <!-- ======================================================= -->

        <section class="weather-section">

          <div class="section-heading">
            <div>
              <span class="section-kicker">
                EXTENDED FORECAST
              </span>

              <h2>7 Day Forecast</h2>
            </div>

            <span class="section-meta">
              DAILY
            </span>
          </div>

          <div id="daily-list" class="daily-list">
            <div class="loading-message">
              Loading forecast...
            </div>
          </div>

        </section>

        <!-- ======================================================= -->
        <!-- DOCUMENTATION STYLE INFO                                 -->
        <!-- ======================================================= -->

        <section class="documentation">

          <div class="documentation-sidebar">

            <div class="doc-label">
              WEATHER DATA
            </div>

            <nav>
              <a href="#current" class="active">
                Current conditions
              </a>

              <a href="#hourly">
                Hourly forecast
              </a>

              <a href="#daily">
                7 day forecast
              </a>

              <a href="#details">
                Weather details
              </a>
            </nav>

          </div>

          <div class="documentation-content">

            <div class="doc-heading">
              <span class="section-kicker">
                WEATHER API
              </span>

              <h2>Weather information</h2>
            </div>

            <p>
              Live weather data is loaded dynamically for the selected
              location. The dashboard combines current conditions,
              hourly forecasts and daily predictions in a compact
              developer-oriented interface.
            </p>

            <div class="code-document">

              <div class="code-header">
                <span>
                  weather.config
                </span>

                <span class="code-status">
                  ● LIVE
                </span>
              </div>

              <pre><code>{
  location: "<span id="code-location">Valencia</span>",
  units: "metric",
  forecast: "7 days",
  hourly: true,
  realtime: true
}</code></pre>

            </div>

          </div>

        </section>

        <!-- ======================================================= -->
        <!-- FOOTER                                                   -->
        <!-- ======================================================= -->

        <footer class="weather-footer">

          <div>
            <strong>WEATHER</strong>
            <span>Interactive weather dashboard</span>
          </div>

          <div class="footer-right">
            <span>
              DATA · OPEN-METEO
            </span>

            <span>
              ELECTRIC BLUE EDITION
            </span>
          </div>

        </footer>

      </div>

      <!-- ========================================================= -->
      <!-- JAVASCRIPT                                                 -->
      <!-- ========================================================= -->

      <script>
        const LOCATIONS = {
          Valencia: {
            latitude: 39.4699,
            longitude: -0.3763,
            region: "Comunitat Valenciana"
          },

          Alcoi: {
            latitude: 38.6986,
            longitude: -0.4727,
            region: "Alcoi, Alacant"
          }
        };

        let selectedLocation = "Valencia";

        const locationTitle =
          document.getElementById("location-title");

        const locationRegion =
          document.getElementById("location-region");

        const headerLocation =
          document.getElementById("header-location");

        const breadcrumbLocation =
          document.getElementById("breadcrumb-location");

        const temperature =
          document.getElementById("temperature");

        const feelsLike =
          document.getElementById("feels-like");

        const condition =
          document.getElementById("condition");

        const weatherIcon =
          document.getElementById("weather-icon");

        const highTemperature =
          document.getElementById("high-temperature");

        const lowTemperature =
          document.getElementById("low-temperature");

        const humidity =
          document.getElementById("humidity");

        const wind =
          document.getElementById("wind");

        const pressure =
          document.getElementById("pressure");

        const visibility =
          document.getElementById("visibility");

        const cloudCover =
          document.getElementById("cloud-cover");

        const precipitation =
          document.getElementById("precipitation");

        const updatedTime =
          document.getElementById("updated-time");

        const hourlyList =
          document.getElementById("hourly-list");

        const dailyList =
          document.getElementById("daily-list");

        const codeLocation =
          document.getElementById("code-location");

        const locationButton =
          document.getElementById("location-button");

        const locationMenu =
          document.getElementById("location-menu");

        function getWeatherDescription(code) {
          if (code === 0) return "Clear sky";

          if ([1, 2, 3].includes(code)) {
            return "Partly cloudy";
          }

          if ([45, 48].includes(code)) {
            return "Fog";
          }

          if ([51, 53, 55, 56, 57].includes(code)) {
            return "Drizzle";
          }

          if ([61, 63, 65, 66, 67].includes(code)) {
            return "Rain";
          }

          if ([71, 73, 75, 77].includes(code)) {
            return "Snow";
          }

          if ([80, 81, 82].includes(code)) {
            return "Rain showers";
          }

          if ([85, 86].includes(code)) {
            return "Snow showers";
          }

          if ([95, 96, 99].includes(code)) {
            return "Thunderstorm";
          }

          return "Unknown";
        }

        function getWeatherIcon(code, isDay = true) {
          if (code === 0) {
            return isDay ? "☀" : "☾";
          }

          if ([1, 2].includes(code)) {
            return isDay ? "◐" : "☾";
          }

          if (code === 3) {
            return "☁";
          }

          if ([45, 48].includes(code)) {
            return "≋";
          }

          if (
            [51, 53, 55, 56, 57].includes(code)
          ) {
            return "☂";
          }

          if (
            [61, 63, 65, 66, 67].includes(code)
          ) {
            return "☂";
          }

          if (
            [71, 73, 75, 77].includes(code)
          ) {
            return "❄";
          }

          if (
            [80, 81, 82].includes(code)
          ) {
            return "☂";
          }

          if (
            [85, 86].includes(code)
          ) {
            return "❄";
          }

          if (
            [95, 96, 99].includes(code)
          ) {
            return "⚡";
          }

          return "○";
        }

        function formatHour(value) {
          const date = new Date(value);

          return date.toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit"
            }
          );
        }

        function formatDay(value, index) {
          if (index === 0) {
            return "Today";
          }

          const date = new Date(
            `${value}T12:00:00`
          );

          return date.toLocaleDateString(
            "en-GB",
            {
              weekday: "short"
            }
          );
        }

        function updateTime() {
          const now = new Date();

          updatedTime.textContent =
            now.toLocaleTimeString(
              "en-GB",
              {
                hour: "2-digit",
                minute: "2-digit"
              }
            );
        }

        async function loadWeather(locationName) {
          const location =
            LOCATIONS[locationName];

          if (!location) return;

          selectedLocation = locationName;

          locationTitle.textContent =
            locationName;

          locationRegion.textContent =
            location.region;

          headerLocation.textContent =
            locationName;

          breadcrumbLocation.textContent =
            locationName;

          codeLocation.textContent =
            locationName;

          condition.textContent =
            "Loading weather...";

          try {
            const url =
              "https://api.open-meteo.com/v1/forecast" +
              `?latitude=${location.latitude}` +
              `&longitude=${location.longitude}` +
              "&current=" +
              [
                "temperature_2m",
                "relative_humidity_2m",
                "apparent_temperature",
                "is_day",
                "precipitation",
                "rain",
                "weather_code",
                "cloud_cover",
                "surface_pressure",
                "wind_speed_10m",
                "visibility"
              ].join(",") +
              "&hourly=" +
              [
                "temperature_2m",
                "weather_code",
                "precipitation_probability",
                "is_day"
              ].join(",") +
              "&daily=" +
              [
                "weather_code",
                "temperature_2m_max",
                "temperature_2m_min",
                "precipitation_probability_max",
                "sunrise",
                "sunset"
              ].join(",") +
              "&timezone=auto" +
              "&forecast_days=7";

            const response =
              await fetch(url);

            if (!response.ok) {
              throw new Error(
                "Weather request failed"
              );
            }

            const data =
              await response.json();

            renderCurrentWeather(data);
            renderHourly(data);
            renderDaily(data);

            updateTime();
          } catch (error) {
            console.error(error);

            condition.textContent =
              "Unable to load weather";

            hourlyList.innerHTML =
              '<div class="loading-message">Weather data unavailable.</div>';

            dailyList.innerHTML =
              '<div class="loading-message">Please try again later.</div>';
          }
        }

        function renderCurrentWeather(data) {
          const current =
            data.current;

          const daily =
            data.daily;

          temperature.textContent =
            Math.round(
              current.temperature_2m
            );

          feelsLike.textContent =
            `${Math.round(
              current.apparent_temperature
            )}°`;

          condition.textContent =
            getWeatherDescription(
              current.weather_code
            );

          weatherIcon.textContent =
            getWeatherIcon(
              current.weather_code,
              current.is_day === 1
            );

          highTemperature.textContent =
            `${Math.round(
              daily.temperature_2m_max[0]
            )}°`;

          lowTemperature.textContent =
            `${Math.round(
              daily.temperature_2m_min[0]
            )}°`;

          humidity.textContent =
            `${Math.round(
              current.relative_humidity_2m
            )}%`;

          wind.textContent =
            Math.round(
              current.wind_speed_10m
            );

          pressure.textContent =
            Math.round(
              current.surface_pressure
            );

          visibility.textContent =
            Math.round(
              current.visibility / 1000
            );

          cloudCover.textContent =
            `${Math.round(
              current.cloud_cover
            )}%`;

          precipitation.textContent =
            `${Math.round(
              current.precipitation
            )}%`;
        }

        function renderHourly(data) {
          const hourly =
            data.hourly;

          const now =
            new Date(
              data.current.time
            );

          let startIndex = 0;

          for (
            let i = 0;
            i < hourly.time.length;
            i++
          ) {
            if (
              new Date(hourly.time[i]) >= now
            ) {
              startIndex = i;
              break;
            }
          }

          const count = 24;

          let html = "";

          for (
            let i = startIndex;
            i < startIndex + count &&
            i < hourly.time.length;
            i++
          ) {
            const hour =
              formatHour(
                hourly.time[i]
              );

            const icon =
              getWeatherIcon(
                hourly.weather_code[i],
                hourly.is_day[i] === 1
              );

            const temp =
              Math.round(
                hourly.temperature_2m[i]
              );

            const rain =
              Math.round(
                hourly
                  .precipitation_probability[i]
              );

            html += `
              <div class="hour-card ${
                i === startIndex
                  ? "current-hour"
                  : ""
              }">
                <span class="hour-time">
                  ${
                    i === startIndex
                      ? "NOW"
                      : hour
                  }
                </span>

                <span class="hour-icon">
                  ${icon}
                </span>

                <strong class="hour-temperature">
                  ${temp}°
                </strong>

                <span class="hour-rain">
                  ${rain}%
                </span>
              </div>
            `;
          }

          hourlyList.innerHTML = html;
        }

        function renderDaily(data) {
          const daily =
            data.daily;

          let html = "";

          for (
            let i = 0;
            i < daily.time.length;
            i++
          ) {
            const day =
              formatDay(
                daily.time[i],
                i
              );

            const icon =
              getWeatherIcon(
                daily.weather_code[i]
              );

            const description =
              getWeatherDescription(
                daily.weather_code[i]
              );

            const max =
              Math.round(
                daily.temperature_2m_max[i]
              );

            const min =
              Math.round(
                daily.temperature_2m_min[i]
              );

            const rain =
              Math.round(
                daily
                  .precipitation_probability_max[i]
              );

            html += `
              <article class="daily-row">

                <div class="daily-day">
                  <strong>${day}</strong>
                  <span>
                    ${daily.time[i]}
                  </span>
                </div>

                <div class="daily-condition">
                  <span class="daily-icon">
                    ${icon}
                  </span>

                  <span>
                    ${description}
                  </span>
                </div>

                <div class="daily-rain">
                  <span class="rain-symbol">
                    ◦
                  </span>

                  ${rain}%
                </div>

                <div class="daily-temperatures">
                  <strong>
                    ${max}°
                  </strong>

                  <span>
                    ${min}°
                  </span>
                </div>

              </article>
            `;
          }

          dailyList.innerHTML = html;
        }

        locationButton.addEventListener(
          "click",
          () => {
            locationMenu.classList.toggle(
              "open"
            );
          }
        );

        document
          .querySelectorAll(
            "[data-location]"
          )
          .forEach((button) => {
            button.addEventListener(
              "click",
              () => {
                const value =
                  button.dataset.location;

                if (!value) return;

                locationMenu.classList.remove(
                  "open"
                );

                loadWeather(value);
              }
            );
          });

        document.addEventListener(
          "click",
          (event) => {
            const target =
              event.target;

            if (
              target instanceof Node &&
              !locationMenu.contains(target) &&
              !locationButton.contains(target)
            ) {
              locationMenu.classList.remove(
                "open"
              );
            }
          }
        );

        updateTime();

        loadWeather("Valencia");

        /* =========================================================
           STRONG ELECTRIC BLUE INTERACTIVE EFFECT
           ========================================================= */

        const canvas =
          document.getElementById(
            "weather-effect"
          );

        if (
          canvas instanceof HTMLCanvasElement
        ) {
          const ctx =
            canvas.getContext("2d");

          if (ctx) {
            let width = 0;
            let height = 0;
            let dpr = 1;

            let mouseX = 0.5;
            let mouseY = 0.5;

            let targetMouseX = 0.5;
            let targetMouseY = 0.5;

            const particles = [];

            const particleCount = 95;

            function resizeCanvas() {
              dpr = Math.min(
                window.devicePixelRatio || 1,
                2
              );

              width =
                window.innerWidth;

              height =
                window.innerHeight;

              canvas.width =
                width * dpr;

              canvas.height =
                height * dpr;

              canvas.style.width =
                `${width}px`;

              canvas.style.height =
                `${height}px`;

              ctx.setTransform(
                dpr,
                0,
                0,
                dpr,
                0,
                0
              );
            }

            function randomParticle() {
              return {
                x:
                  Math.random() *
                  width,

                y:
                  Math.random() *
                  height,

                vx:
                  (Math.random() - 0.5) *
                  0.35,

                vy:
                  (Math.random() - 0.5) *
                  0.35,

                size:
                  Math.random() *
                    2.2 +
                  0.7,

                alpha:
                  Math.random() *
                    0.55 +
                  0.15,

                phase:
                  Math.random() *
                  Math.PI *
                  2
              };
            }

            function createParticles() {
              particles.length = 0;

              for (
                let i = 0;
                i < particleCount;
                i++
              ) {
                particles.push(
                  randomParticle()
                );
              }
            }

            function drawGlow(
              x,
              y,
              radius,
              alpha
            ) {
              const gradient =
                ctx.createRadialGradient(
                  x,
                  y,
                  0,
                  x,
                  y,
                  radius
                );

              gradient.addColorStop(
                0,
                `rgba(0, 132, 255, ${alpha})`
              );

              gradient.addColorStop(
                0.28,
                `rgba(0, 102, 255, ${
                  alpha * 0.55
                })`
              );

              gradient.addColorStop(
                0.65,
                `rgba(30, 110, 255, ${
                  alpha * 0.18
                })`
              );

              gradient.addColorStop(
                1,
                "rgba(0, 100, 255, 0)"
              );

              ctx.fillStyle =
                gradient;

              ctx.fillRect(
                x - radius,
                y - radius,
                radius * 2,
                radius * 2
              );
            }

            function drawWave(
              time
            ) {
              ctx.beginPath();

              const baseY =
                height *
                  (0.32 +
                    mouseY *
                      0.18);

              const amplitude =
                30 +
                mouseX * 45;

              for (
                let x = 0;
                x <= width;
                x += 12
              ) {
                const normalized =
                  x / width;

                const wave =
                  Math.sin(
                    normalized *
                      Math.PI *
                      4 +
                      time *
                        0.00035
                  ) *
                  amplitude;

                const secondary =
                  Math.sin(
                    normalized *
                      Math.PI *
                      9 -
                      time *
                        0.0002
                  ) *
                  14;

                const y =
                  baseY +
                  wave +
                  secondary;

                if (x === 0) {
                  ctx.moveTo(x, y);
                } else {
                  ctx.lineTo(x, y);
                }
              }

              ctx.strokeStyle =
                "rgba(0, 132, 255, 0.16)";

              ctx.lineWidth = 2;

              ctx.shadowColor =
                "rgba(0, 132, 255, 0.5)";

              ctx.shadowBlur = 18;

              ctx.stroke();

              ctx.shadowBlur = 0;
            }

            function drawParticles(
              time
            ) {
              for (
                let i = 0;
                i < particles.length;
                i++
              ) {
                const particle =
                  particles[i];

                const dx =
                  mouseX * width -
                  particle.x;

                const dy =
                  mouseY * height -
                  particle.y;

                const distance =
                  Math.sqrt(
                    dx * dx +
                    dy * dy
                  );

                const force =
                  Math.max(
                    0,
                    1 -
                      distance /
                        500
                  );

                particle.vx +=
                  dx *
                  force *
                  0.00008;

                particle.vy +=
                  dy *
                  force *
                  0.00008;

                particle.vx *= 0.995;
                particle.vy *= 0.995;

                particle.x +=
                  particle.vx;

                particle.y +=
                  particle.vy;

                if (
                  particle.x < -20
                ) {
                  particle.x =
                    width + 20;
                }

                if (
                  particle.x >
                  width + 20
                ) {
                  particle.x = -20;
                }

                if (
                  particle.y < -20
                ) {
                  particle.y =
                    height + 20;
                }

                if (
                  particle.y >
                  height + 20
                ) {
                  particle.y = -20;
                }

                const pulse =
                  0.75 +
                  Math.sin(
                    time *
                      0.001 +
                      particle.phase
                  ) *
                    0.25;

                ctx.beginPath();

                ctx.arc(
                  particle.x,
                  particle.y,
                  particle.size,
                  0,
                  Math.PI * 2
                );

                ctx.fillStyle =
                  `rgba(0, 132, 255, ${
                    particle.alpha *
                    pulse
                  })`;

                ctx.shadowColor =
                  "rgba(0, 132, 255, 0.9)";

                ctx.shadowBlur = 8;

                ctx.fill();

                ctx.shadowBlur = 0;
              }
            }

            function drawConnections() {
              const maxDistance = 125;

              for (
                let i = 0;
                i < particles.length;
                i++
              ) {
                for (
                  let j = i + 1;
                  j < particles.length;
                  j++
                ) {
                  const a =
                    particles[i];

                  const b =
                    particles[j];

                  const dx =
                    a.x - b.x;

                  const dy =
                    a.y - b.y;

                  const distance =
                    Math.sqrt(
                      dx * dx +
                      dy * dy
                    );

                  if (
                    distance <
                    maxDistance
                  ) {
                    const opacity =
                      (1 -
                        distance /
                          maxDistance) *
                      0.11;

                    ctx.beginPath();

                    ctx.moveTo(
                      a.x,
                      a.y
                    );

                    ctx.lineTo(
                      b.x,
                      b.y
                    );

                    ctx.strokeStyle =
                      `rgba(0, 132, 255, ${opacity})`;

                    ctx.lineWidth = 1;

                    ctx.stroke();
                  }
                }
              }
            }

            function animate(time) {
              mouseX +=
                (targetMouseX -
                  mouseX) *
                0.035;

              mouseY +=
                (targetMouseY -
                  mouseY) *
                0.035;

              ctx.clearRect(
                0,
                0,
                width,
                height
              );

              /*
               * Large electric-blue atmospheric
               * glow following the pointer.
               */

              drawGlow(
                width *
                  mouseX,
                height *
                  mouseY,
                Math.min(
                  width,
                  height
                ) * 0.55,
                0.13
              );

              /*
               * Secondary fixed glows create
               * the depth seen in modern
               * interactive portfolio effects.
               */

              drawGlow(
                width * 0.15,
                height * 0.2,
                260,
                0.055
              );

              drawGlow(
                width * 0.82,
                height * 0.72,
                320,
                0.045
              );

              drawWave(time);

              drawConnections();

              drawParticles(time);

              requestAnimationFrame(
                animate
              );
            }

            window.addEventListener(
              "resize",
              () => {
                resizeCanvas();
                createParticles();
              }
            );

            window.addEventListener(
              "pointermove",
              (event) => {
                targetMouseX =
                  event.clientX /
                  width;

                targetMouseY =
                  event.clientY /
                  height;
              },
              {
                passive: true
              }
            );

            resizeCanvas();
            createParticles();

            requestAnimationFrame(
              animate
            );
          }
        }
      </script>
    </main>
  </body>
</html>

<style>
