---
const locations = {
  Alcoi: {
    label: "Alcoi",
    region: "Alicante, España",
    latitude: 38.6986,
    longitude: -0.4731,
  },
  Torrevieja: {
    label: "Torrevieja",
    region: "Alicante, España",
    latitude: 37.978,
    longitude: -0.682,
  },
  Valencia: {
    label: "Valencia",
    region: "Valencia, España",
    latitude: 39.4699,
    longitude: -0.3763,
  },
};

const defaultLocation = "Alcoi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Live weather dashboard for Alcoi, Torrevieja and Valencia."
    />
    <title>Weather | Aymane Jabrane</title>
  </head>

  <body>
    <main class="weather-page">
      <!-- ========================================================= -->
      <!-- TOP HEADER                                                -->
      <!-- ========================================================= -->

      <header class="weather-header">
        <div class="header-inner">
          <a class="brand" href="/" aria-label="Aymane Jabrane home">
            <span class="brand-mark">AJ</span>

            <span class="brand-copy">
              <strong>WEATHER</strong>
              <span>AYMANE JABRANE</span>
            </span>
          </a>

          <div class="header-status">
            <span class="status-dot"></span>
            <span id="header-status">Live data</span>
          </div>
        </div>
      </header>

      <!-- ========================================================= -->
      <!-- MAIN CONTENT                                               -->
      <!-- ========================================================= -->

      <div class="weather-container">
        <!-- ======================================================= -->
        <!-- LOCATION SELECTOR                                        -->
        <!-- ======================================================= -->

        <section class="location-section">
          <div>
            <p class="eyebrow">LOCAL WEATHER</p>
            <h1 id="location-name">Alcoi</h1>
            <p id="location-region">Alicante, España</p>
          </div>

          <div class="location-buttons" aria-label="Select location">
            {
              Object.entries(locations).map(([key, location]) => (
                <button
                  type="button"
                  class={`location-button ${key === defaultLocation ? "active" : ""}`}
                  data-location={key}
                >
                  {location.label}
                </button>
              ))
            }
          </div>
        </section>

        <!-- ======================================================= -->
        <!-- CURRENT WEATHER                                         -->
        <!-- ======================================================= -->

        <section class="hero-weather">
          <div class="hero-main">
            <div class="hero-icon" id="hero-icon" aria-hidden="true">
              ☀
            </div>

            <div class="hero-temperature">
              <span id="temperature">--</span>
              <span class="degree">°</span>
            </div>

            <div class="hero-description">
              <strong id="condition">Loading weather...</strong>
              <span id="feels-like">Feels like --°</span>
            </div>
          </div>

          <div class="hero-side">
            <div class="hero-side-item">
              <span class="metric-label">HUMIDITY</span>
              <strong id="hero-humidity">--%</strong>
            </div>

            <div class="hero-side-item">
              <span class="metric-label">WIND</span>
              <strong id="wind">-- km/h</strong>
            </div>

            <div class="hero-side-item">
              <span class="metric-label">PRESSURE</span>
              <strong id="pressure">-- hPa</strong>
            </div>
          </div>
        </section>

        <!-- ======================================================= -->
        <!-- HOURLY FORECAST                                          -->
        <!-- ======================================================= -->

        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">FORECAST</p>
              <h2>Hourly weather</h2>
            </div>

            <div class="hourly-controls">
              <button
                type="button"
                id="hourly-prev"
                class="control-button"
                aria-label="Previous hours"
              >
                ‹
              </button>

              <button
                type="button"
                id="hourly-next"
                class="control-button"
                aria-label="Next hours"
              >
                ›
              </button>
            </div>
          </div>

          <div class="hourly-wrapper">
            <div id="hourly-container" class="hourly-grid">
              <div class="loading-card">Loading hourly forecast...</div>
            </div>
          </div>
        </section>

        <!-- ======================================================= -->
        <!-- DAILY FORECAST                                           -->
        <!-- ======================================================= -->

        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">NEXT DAYS</p>
              <h2>10-day forecast</h2>
            </div>
          </div>

          <div id="daily-container" class="daily-grid">
            <div class="loading-card">Loading daily forecast...</div>
          </div>
        </section>

        <!-- ======================================================= -->
        <!-- WEATHER DETAILS                                          -->
        <!-- ======================================================= -->

        <section class="weather-section details-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">CURRENT CONDITIONS</p>
              <h2>Weather details</h2>
            </div>
          </div>

          <div class="details-grid">
            <article class="detail-card">
              <span class="detail-icon">💧</span>
              <div>
                <span class="detail-label">Humidity</span>
                <strong id="humidity">--%</strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">💨</span>
              <div>
                <span class="detail-label">Wind</span>
                <strong id="wind-detail">-- km/h</strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">◉</span>
              <div>
                <span class="detail-label">Pressure</span>
                <strong id="pressure-detail">-- hPa</strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">👁</span>
              <div>
                <span class="detail-label">Visibility</span>
                <strong id="visibility">-- km</strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌅</span>
              <div>
                <span class="detail-label">Sunrise</span>
                <strong id="sunrise">--:--</strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌇</span>
              <div>
                <span class="detail-label">Sunset</span>
                <strong id="sunset">--:--</strong>
              </div>
            </article>
          </div>
        </section>

        <!-- ======================================================= -->
        <!-- FOOTER                                                    -->
        <!-- ======================================================= -->

        <footer class="weather-footer">
          <div>
            <span>Weather data provided by</span>
            <strong>Open-Meteo</strong>
          </div>

          <span id="last-updated">Updating...</span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script>
  const weatherLocations = {
    Alcoi: {
      label: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      label: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      label: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let currentLocation = "Alcoi";
  let currentData = null;
  let hourlyStartIndex = 0;

  const $ = (id) => document.getElementById(id);

  function updateElement(id, value) {
    const element = $(id);

    if (element) {
      element.textContent = value;
    }
  }

  function getWeatherDescription(code) {
    const descriptions = {
      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",
      45: "Fog",
      48: "Depositing rime fog",
      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",
      56: "Light freezing drizzle",
      57: "Dense freezing drizzle",
      61: "Slight rain",
      63: "Moderate rain",
      65: "Heavy rain",
      66: "Light freezing rain",
      67: "Heavy freezing rain",
      71: "Slight snowfall",
      73: "Moderate snowfall",
      75: "Heavy snowfall",
      77: "Snow grains",
      80: "Slight rain showers",
      81: "Moderate rain showers",
      82: "Violent rain showers",
      85: "Slight snow showers",
      86: "Heavy snow showers",
      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",
    };

    return descriptions[code] || "Unknown conditions";
  }

  function getWeatherIcon(code, isDay = true) {
    if (code === 0) {
      return isDay ? "☀" : "☾";
    }

    if (code === 1) {
      return isDay ? "🌤" : "☾";
    }

    if (code === 2) {
      return "⛅";
    }

    if (code === 3) {
      return "☁";
    }

    if (code === 45 || code === 48) {
      return "🌫";
    }

    if (code >= 51 && code <= 67) {
      return "🌧";
    }

    if (code >= 71 && code <= 77) {
      return "❄";
    }

    if (code >= 80 && code <= 82) {
      return "🌦";
    }

    if (code >= 85 && code <= 86) {
      return "🌨";
    }

    if (code >= 95) {
      return "⛈";
    }

    return "☀";
  }

  function formatHour(value) {
    if (!value) {
      return "--:--";
    }

    const date = new Date(value);

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function formatDay(value, index = 0) {
    if (!value) {
      return "--";
    }

    if (index === 0) {
      return "Today";
    }

    if (index === 1) {
      return "Tomorrow";
    }

    const date = new Date(`${value}T12:00:00`);

    return date.toLocaleDateString("en-GB", {
      weekday: "short",
    });
  }

  function formatDateTime(value) {
    if (!value) {
      return "";
    }

    const date = new Date(value);

    return date.toLocaleString("en-GB", {
      day: "2-digit",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function createHourlyCard(data, index, startIndex) {
    const time = data.hourly.time[index];
    const temperature = data.hourly.temperature_2m[index];
    const code = data.hourly.weather_code[index];
    const rain =
      data.hourly.precipitation_probability[index] ?? 0;
    const isCurrent = index === startIndex;

    const card = document.createElement("article");

    card.className = `hour-card ${isCurrent ? "current" : ""}`;

    card.innerHTML = `
      <span class="hour-time">
        ${isCurrent ? "NOW" : formatHour(time)}
      </span>

      <span class="hour-icon">
        ${getWeatherIcon(code, true)}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-condition">
        ${getWeatherDescription(code)}
      </span>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;

    return card;
  }

  function renderHourly() {
    const container = $("hourly-container");

    if (!container || !currentData?.hourly) {
      return;
    }

    container.innerHTML = "";

    const totalHours = currentData.hourly.time.length;
    const visibleHours = 8;

    if (hourlyStartIndex < 0) {
      hourlyStartIndex = 0;
    }

    if (hourlyStartIndex > totalHours - visibleHours) {
      hourlyStartIndex = Math.max(0, totalHours - visibleHours);
    }

    for (
      let i = hourlyStartIndex;
      i < Math.min(hourlyStartIndex + visibleHours, totalHours);
      i += 1
    ) {
      container.appendChild(
        createHourlyCard(currentData, i, hourlyStartIndex)
      );
    }
  }

  function createDailyCard(data, index) {
    const date = data.daily.time[index];
    const code = data.daily.weather_code[index];

    const high = data.daily.temperature_2m_max[index];
    const low = data.daily.temperature_2m_min[index];

    const rain =
      data.daily.precipitation_probability_max[index] ?? 0;

    const sunrise = data.daily.sunrise[index];
    const sunset = data.daily.sunset[index];

    const card = document.createElement("article");

    card.className = `daily-card ${index === 0 ? "today" : ""}`;

    card.innerHTML = `
      <div class="daily-date">
        <strong>${formatDay(date, index)}</strong>
        <span>${date}</span>
      </div>

      <div class="daily-icon">
        ${getWeatherIcon(code, true)}
      </div>

      <div class="daily-condition">
        ${getWeatherDescription(code)}
      </div>

      <div class="daily-temperatures">
        <strong>${Math.round(high)}°</strong>
        <span>${Math.round(low)}°</span>
      </div>

      <div class="daily-rain">
        ${rain}% precipitation
      </div>

      <div class="daily-sun">
        <span>↑ ${formatHour(sunrise)}</span>
        <span>↓ ${formatHour(sunset)}</span>
      </div>
    `;

    return card;
  }

  function renderDaily() {
    const container = $("daily-container");

    if (!container || !currentData?.daily) {
      return;
    }

    container.innerHTML = "";

    const days = Math.min(10, currentData.daily.time.length);

    for (let i = 0; i < days; i += 1) {
      container.appendChild(createDailyCard(currentData, i));
    }
  }

  function updateCurrentWeather(data) {
    const current = data.current;

    if (!current) {
      return;
    }

    const temperature = Math.round(current.temperature_2m);
    const feelsLike = Math.round(current.apparent_temperature);
    const humidity = Math.round(current.relative_humidity_2m);
    const wind = Math.round(current.wind_speed_10m);
    const pressure = Math.round(current.surface_pressure);
    const code = current.weather_code;

    updateElement("temperature", temperature);
    updateElement("condition", getWeatherDescription(code));
    updateElement("feels-like", `Feels like ${feelsLike}°`);
    updateElement("hero-humidity", `${humidity}%`);
    updateElement("humidity", `${humidity}%`);
    updateElement("wind", `${wind} km/h`);
    updateElement("wind-detail", `${wind} km/h`);
    updateElement("pressure", `${pressure} hPa`);
    updateElement("pressure-detail", `${pressure} hPa`);

    const icon = $("hero-icon");

    if (icon) {
      icon.textContent = getWeatherIcon(
        code,
        current.is_day === 1
      );
    }

    const visibilityMeters = current.visibility ?? 0;
    const visibilityKm = visibilityMeters / 1000;

    updateElement(
      "visibility",
      `${Math.round(visibilityKm)} km`
    );
  }

  function updateSunData(data) {
    if (!data.daily) {
      return;
    }

    updateElement(
      "sunrise",
      formatHour(data.daily.sunrise[0])
    );

    updateElement(
      "sunset",
      formatHour(data.daily.sunset[0])
    );
  }

  async function fetchWeather(locationName) {
    const location = weatherLocations[locationName];

    if (!location) {
      throw new Error("Unknown location");
    }

    const params = new URLSearchParams({
      latitude: String(location.latitude),
      longitude: String(location.longitude),
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,surface_pressure,wind_speed_10m,is_day,visibility",
      hourly:
        "temperature_2m,precipitation_probability,weather_code",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset",
      timezone: "auto",
      forecast_days: "10",
    });

    const response = await fetch(
      `https://api.open-meteo.com/v1/forecast?${params.toString()}`
    );

    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`
      );
    }

    return response.json();
  }

  async function loadWeather(locationName) {
    updateElement("header-status", "Loading...");

    const location = weatherLocations[locationName];

    if (!location) {
      return;
    }

    updateElement("location-name", location.label);
    updateElement("location-region", location.region);

    document
      .querySelectorAll(".location-button")
      .forEach((button) => {
        const buttonLocation =
          button.getAttribute("data-location");

        button.classList.toggle(
          "active",
          buttonLocation === locationName
        );
      });

    try {
      const data = await fetchWeather(locationName);

      currentLocation = locationName;
      currentData = data;
      hourlyStartIndex = 0;

      updateCurrentWeather(data);
      updateSunData(data);
      renderHourly();
      renderDaily();

      updateElement("header-status", "Live data");

      updateElement(
        "last-updated",
        `Updated ${formatDateTime(new Date().toISOString())}`
      );
    } catch (error) {
      console.error("Weather error:", error);

      updateElement("header-status", "Offline");
      updateElement(
        "condition",
        "Unable to load weather"
      );
      updateElement(
        "last-updated",
        "Weather service unavailable"
      );
    }
  }

  document
    .querySelectorAll(".location-button")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const locationName =
          button.getAttribute("data-location");

        if (locationName) {
          loadWeather(locationName);
        }
      });
    });

  const previousButton = $("hourly-prev");

  if (previousButton) {
    previousButton.addEventListener("click", () => {
      hourlyStartIndex -= 8;
      renderHourly();
    });
  }

  const nextButton = $("hourly-next");

  if (nextButton) {
    nextButton.addEventListener("click", () => {
      hourlyStartIndex += 8;
      renderHourly();
    });
  }

  loadWeather(currentLocation);
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f5f9fd;
    color: #101820;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(button) {
    font: inherit;
  }

  .weather-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 85% 8%,
        rgba(61, 169, 255, 0.12),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f5f9fd 45%,
        #eef5fb 100%
      );
  }

  /* ============================================================= */
  /* HEADER                                                        */
  /* ============================================================= */

  .weather-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom: 1px solid rgba(12, 74, 110, 0.1);

    background: rgba(255, 255, 255, 0.9);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(1180px, calc(100% - 48px));
    min-height: 76px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: #0d8ff0;
    color: white;

    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: -0.03em;

    box-shadow:
      0 8px 24px rgba(13, 143, 240, 0.24);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-copy strong {
    color: #101820;

    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.15em;
  }

  .brand-copy span {
    color: #718096;

    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.12em;
  }

  .header-status {
    display: flex;
    align-items: center;
    gap: 8px;

    color: #607386;

    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;
    background: #19b56b;

    box-shadow:
      0 0 0 5px rgba(25, 181, 107, 0.1);

    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.45;
    }
  }

  /* ============================================================= */
  /* CONTAINER                                                      */
  /* ============================================================= */

  .weather-container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 54px 0 80px;
  }

  /* ============================================================= */
  /* LOCATION                                                       */
  /* ============================================================= */

  .location-section {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 24px;
  }

  .eyebrow {
    margin: 0 0 8px;

    color: #138fe8;

    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .location-section h1 {
    margin: 0;

    color: #101820;

    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .location-section p:last-child {
    margin: 10px 0 0;

    color: #75869a;

    font-size: 0.92rem;
  }

  .location-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .location-button {
    min-height: 40px;
    padding: 0 15px;

    border: 1px solid #dce7f0;
    border-radius: 10px;

    background: rgba(255, 255, 255, 0.85);
    color: #64778b;

    cursor: pointer;

    font-size: 0.75rem;
    font-weight: 750;

    transition:
      color 160ms ease,
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .location-button:hover {
    border-color: #9bcff4;
    color: #0d8ff0;
    transform: translateY(-1px);
  }

  .location-button.active {
    border-color: #0d8ff0;
    background: #0d8ff0;
    color: #ffffff;

    box-shadow:
      0 8px 22px rgba(13, 143, 240, 0.2);
  }

  /* ============================================================= */
  /* HERO                                                           */
  /* ============================================================= */

  .hero-weather {
    position: relative;
    overflow: hidden;

    min-height: 300px;
    padding: 40px;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px;

    border: 1px solid rgba(61, 169, 255, 0.18);
    border-radius: 24px;

    background:
      radial-gradient(
        circle at 20% 10%,
        rgba(61, 169, 255, 0.14),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f7fbff 60%,
        #eef8ff 100%
      );

    box-shadow:
      0 22px 55px rgba(25, 77, 112, 0.08);
  }

  .hero-weather::after {
    content: "";

    position: absolute;
    width: 240px;
    height: 240px;

    right: -90px;
    top: -90px;

    border-radius: 50%;

    border: 1px solid rgba(61, 169, 255, 0.15);
    box-shadow:
