  }

  /* ==========================================================
     LOADING
  ========================================================== */

  .loading-card {
    width: 100%;
    min-height: 100px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border: 1px solid var(--border);
