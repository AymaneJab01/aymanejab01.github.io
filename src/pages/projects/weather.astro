Here is the complete `weather.astro` file. Replace your existing file at `src/pages/projects/weather.astro` with this:

```astro
---
import Layout from "../../layouts/Layout.astro";

const cities = [
  { lat: "38.6983", lon: "-0.4743", city: "Alcoi", region: "Alicante, Spain", primary: true },
  { lat: "39.4699", lon: "-0.3763", city: "Valencia", region: "Valencia, Spain", primary: false },
  { lat: "37.9787", lon: "-0.6822", city: "Torrevieja", region: "Alicante, Spain", primary: false },
];
---

<Layout title="Weather">
  <main class="weather-app" id="weather-app">
    <div class="sky-layer" id="sky-layer" aria-hidden="true"></div>
    <div class="sky-vignette" aria-hidden="true"></div>

    <div class="app-layout">
      <!-- Sidebar: saved cities -->
      <aside class="sidebar" aria-label="Saved locations">
        <div class="sidebar-search" role="search">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <input type="search" placeholder="Search cities" disabled aria-label="Search cities" />
        </div>

        <ul class="city-list" id="city-list" role="list">
          {cities.map((loc, i) => (
            <li>
              <button
                type="button"
                class:list={["city-card", { active: i === 0 }]}
                data-lat={loc.lat}
                data-lon={loc.lon}
                data-city={loc.city}
                data-region={loc.region}
                data-primary={loc.primary ? "true" : "false"}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span class="city-card-top">
                  <span class="city-name">{loc.city}</span>
                  <span class="city-time" data-city-time>--</span>
                </span>
                <span class="city-card-body">
                  <span class="city-temp" data-city-temp>--°</span>
                  <span class="city-meta">
                    <span class="city-condition" data-city-condition>Loading</span>
                    <span class="city-hilo">
                      H: <span data-city-high>--</span> L: <span data-city-low>--</span>
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <a href="/#projects" class="sidebar-back">
          <span aria-hidden="true">&larr;</span> Back to projects
        </a>
      </aside>

      <!-- Main dashboard -->
      <div class="dashboard" id="dashboard">
        <header class="location-header">
          <p class="location-label" id="location-label">MY LOCATION</p>
          <h1 id="main-city">Alcoi</h1>
          <p class="location-summary">
            <span id="main-temp">--</span>
            <span class="summary-divider">|</span>
            <span id="main-condition">Loading</span>
          </p>
        </header>

        <!-- Today view -->
        <section class="panel-section" id="today-section" aria-label="Today">
          <article class="glass-card hourly-card">
            <div class="hourly-strip" id="hourly-strip">
              <p class="loading-text">Loading hourly forecast…</p>
            </div>
          </article>

          <article class="glass-card forecast-card" aria-labelledby="forecast-heading">
            <header class="card-heading">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <rect x="2" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/>
                <path d="M2 7h14M6 2v3M12 2v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              <h2 id="forecast-heading">10-DAY FORECAST</h2>
            </header>
            <div class="forecast-list" id="forecast-list">
              <p class="loading-text">Loading forecast…</p>
            </div>
          </article>
        </section>

        <!-- Details widgets -->
        <section class="panel-section details-section" id="details-section" aria-label="Weather details">
          <div class="widget-grid" id="widget-grid">
            <article class="glass-card widget widget-moon" aria-labelledby="moon-title">
              <h3 id="moon-title" class="widget-label">MOON</h3>
              <div class="widget-moon-body">
                <div class="moon-data">
                  <p class="moon-phase" id="moon-phase">--</p>
                  <dl class="moon-stats">
                    <div><dt>Illumination</dt><dd id="moon-illum">--</dd></div>
                    <div><dt>Rise</dt><dd id="moon-rise">--</dd></div>
                    <div><dt>Next full moon</dt><dd id="moon-next">--</dd></div>
                  </dl>
                </div>
                <div class="moon-visual" id="moon-visual" aria-hidden="true"></div>
              </div>
            </article>

            <article class="glass-card widget" aria-labelledby="wind-title">
              <h3 id="wind-title" class="widget-label">WIND</h3>
              <div class="widget-wind">
                <div class="wind-stats">
                  <p class="widget-value" id="wind-speed">--</p>
                  <p class="widget-sub">km/h</p>
                  <p class="widget-detail">Gusts <strong id="wind-gusts">--</strong> km/h</p>
                  <p class="widget-detail" id="wind-direction">--</p>
                </div>
                <div class="wind-compass" aria-hidden="true">
                  <svg viewBox="0 0 100 100" class="compass-svg">
                    <circle cx="50" cy="50" r="44" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="50" y="14" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="8">N</text>
                    <text x="88" y="53" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="8">E</text>
                    <text x="50" y="92" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="8">S</text>
                    <text x="12" y="53" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="8">W</text>
                    <g id="wind-needle" transform="rotate(0 50 50)">
                      <path d="M50 22 L54 50 L50 46 L46 50 Z" fill="rgba(255,255,255,0.85)"/>
                    </g>
                    <text id="compass-speed" x="50" y="54" text-anchor="middle" fill="white" font-size="11" font-weight="600">--</text>
                  </svg>
                </div>
              </div>
            </article>

            <article class="glass-card widget" aria-labelledby="uv-title">
              <h3 id="uv-title" class="widget-label">UV INDEX</h3>
              <p class="widget-value" id="uv-value">--</p>
              <p class="widget-sub" id="uv-label">--</p>
              <div class="uv-bar" aria-hidden="true">
                <div class="uv-gradient"></div>
                <div class="uv-marker" id="uv-marker" style="left: 0%"></div>
              </div>
              <p class="widget-detail" id="uv-advice">--</p>
            </article>

            <article class="glass-card widget" aria-labelledby="sun-title">
              <h3 id="sun-title" class="widget-label">SUNSET</h3>
              <p class="widget-value" id="sun-event-time">--</p>
              <div class="sun-arc" aria-hidden="true">
                <svg viewBox="0 0 200 80" preserveAspectRatio="xMidYMid meet">
                  <path d="M10 60 Q100 -10 190 60" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
                  <line x1="10" y1="60" x2="190" y2="60" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                  <circle id="sun-dot" cx="10" cy="60" r="6" fill="#ffd56b"/>
                </svg>
              </div>
              <p class="widget-detail" id="sun-other">Sunrise: --</p>
            </article>

            <article class="glass-card widget widget-sm" aria-labelledby="feels-title">
              <h3 id="feels-title" class="widget-label">FEELS LIKE</h3>
              <p class="widget-value" id="feels-value">--</p>
              <p class="widget-detail" id="feels-note">--</p>
            </article>

            <article class="glass-card widget widget-sm" aria-labelledby="precip-title">
              <h3 id="precip-title" class="widget-label">PRECIPITATION</h3>
              <p class="widget-value widget-value-sm" id="precip-value">--</p>
              <p class="widget-detail" id="precip-note">--</p>
            </article>

            <article class="glass-card widget widget-sm" aria-labelledby="vis-title">
              <h3 id="vis-title" class="widget-label">VISIBILITY</h3>
              <p class="widget-value" id="vis-value">--</p>
              <p class="widget-detail" id="vis-note">--</p>
            </article>

            <article class="glass-card widget widget-sm" aria-labelledby="humid-title">
              <h3 id="humid-title" class="widget-label">HUMIDITY</h3>
              <p class="widget-value" id="humid-value">--</p>
              <p class="widget-detail">Dew point <strong id="dew-value">--</strong></p>
            </article>

            <article class="glass-card widget widget-sm" aria-labelledby="pressure-title">
              <h3 id="pressure-title" class="widget-label">PRESSURE</h3>
              <div class="pressure-gauge" aria-hidden="true">
                <svg viewBox="0 0 120 70">
                  <path d="M15 60 A45 45 0 0 1 105 60" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="4" stroke-linecap="round"/>
                  <path id="pressure-arc" d="M15 60 A45 45 0 0 1 105 60" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="4" stroke-linecap="round" stroke-dasharray="141 141" stroke-dashoffset="70"/>
                </svg>
              </div>
              <p class="widget-value widget-value-sm" id="pressure-value">--</p>
            </article>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  interface WeatherCurrent {
    time: string;
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    wind_direction_10m: number;
    pressure_msl: number;
    visibility?: number;
    dewpoint_2m?: number;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    precipitation_sum: number[];
    wind_speed_10m_max: number[];
    wind_gusts_10m_max: number[];
    uv_index_max: number[];
    sunrise: string[];
    sunset: string[];
  }

  interface WeatherHourly {
    time: string[];
    temperature_2m: number[];
    weather_code: number[];
    precipitation_probability: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
    hourly: WeatherHourly;
    timezone_abbreviation?: string;
  }

  const degree = String.fromCharCode(176);
  const cache = new Map<string, WeatherResponse>();

  const cityCards = document.querySelectorAll<HTMLButtonElement>(".city-card");
  const skyLayer = document.getElementById("sky-layer");
  const locationLabel = document.getElementById("location-label");
  const mainCity = document.getElementById("main-city");
  const mainTemp = document.getElementById("main-temp");
  const mainCondition = document.getElementById("main-condition");
  const hourlyStrip = document.getElementById("hourly-strip");
  const forecastList = document.getElementById("forecast-list");

  function getWeatherDescription(code: number): string {
    const map: Record<number, string> = {
      0: "Clear", 1: "Mostly Clear", 2: "Partly Cloudy", 3: "Cloudy",
      45: "Fog", 48: "Fog", 51: "Drizzle", 53: "Drizzle", 55: "Drizzle",
      61: "Light Rain", 63: "Rain", 65: "Heavy Rain",
      71: "Snow", 73: "Snow", 75: "Heavy Snow",
      80: "Showers", 81: "Showers", 82: "Heavy Showers",
      95: "Thunderstorm", 96: "Thunderstorm", 99: "Thunderstorm",
    };
    return map[code] ?? "Unknown";
  }

  function getWeatherIcon(code: number, size = "md"): string {
    const cls = size === "sm" ? "icon-sm" : size === "lg" ? "icon-lg" : "";
    const c = `class="weather-icon ${cls}" viewBox="0 0 48 48" fill="none" aria-hidden="true"`;
    if (code === 0) return `<svg ${c}><circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2.5"/><path d="M24 6v5m0 26v5M6 24h5m26 0h5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    if (code <= 3) return `<svg ${c}><circle cx="17" cy="18" r="5.5" stroke="currentColor" stroke-width="2.5"/><path d="M14 36h24a6 6 0 0 0 0-12 9 9 0 0 0-17-1.5A7 7 0 0 0 14 36Z" stroke="currentColor" stroke-width="2.5"/></svg>`;
    if (code <= 48) return `<svg ${c}><path d="M8 20h32M6 26h28M10 32h30" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    if (code <= 67 || (code >= 80 && code <= 86)) return `<svg ${c}><path d="M12 30h26a6 6 0 0 0 0-12 9 9 0 0 0-17-1.5A7 7 0 0 0 12 30Z" stroke="currentColor" stroke-width="2.5"/><path d="m18 34-1.5 5m8-5-1.5 5m8-5-1.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
    if (code <= 77) return `<svg ${c}><path d="M24 14v20M16 20l16 10M16 30l16-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    return `<svg ${c}><path d="M12 28h24a6 6 0 0 0 0-12 9 9 0 0 0-17-1.5A7 7 0 0 0 12 28Z" stroke="currentColor" stroke-width="2.5"/><path d="m26 29-4 8h5l-3 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
  }

  function buildWeatherUrl(lat: string, lon: string): string {
    const params = new URLSearchParams({
      latitude: lat,
      longitude: lon,
      current: "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,pressure_msl,visibility,dewpoint_2m",
      hourly: "temperature_2m,weather_code,precipitation_probability",
      daily: "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,wind_speed_10m_max,wind_gusts_10m_max,uv_index_max,sunrise,sunset",
      timezone: "Europe/Madrid",
      forecast_days: "10",
    });
    return `https://api.open-meteo.com/v1/forecast?${params}`;
  }

  function cityKey(lat: string, lon: string): string {
    return `${lat},${lon}`;
  }

  function formatTime(value: string): string {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "--";
    return d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }).replace(" ", " ");
  }

  function formatHour(value: string): string {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "--";
    return d.toLocaleTimeString("en-US", { hour: "numeric" }).replace(" ", "").toLowerCase();
  }

  function formatDay(value: string, index: number): string {
    if (index === 0) return "Today";
    const d = new Date(`${value}T12:00:00`);
    return d.toLocaleDateString("en-US", { weekday: "short" });
  }

  function windCompass(deg: number): string {
    const dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
    return dirs[Math.round(deg / 22.5) % 16] ?? "N";
  }

  function uvLabel(v: number): string {
    if (v < 3) return "Low";
    if (v < 6) return "Moderate";
    if (v < 8) return "High";
    if (v < 11) return "Very High";
    return "Extreme";
  }

  function getMoonPhase(date: Date): { name: string; illumination: number; daysToFull: number } {
    const synodic = 29.530588853;
    const ref = new Date("2000-01-06T18:14:00Z").getTime();
    const days = (date.getTime() - ref) / 86400000;
    const phase = ((days % synodic) + synodic) % synodic;
    const illum = Math.round((1 - Math.cos((phase / synodic) * Math.PI * 2)) / 2 * 100);
    const daysToFull = Math.round(((synodic / 2 - phase + synodic) % synodic) * 10) / 10;

    let name = "New Moon";
    if (phase < 1.85) name = "New Moon";
    else if (phase < 7.38) name = "Waxing Crescent";
    else if (phase < 9.23) name = "First Quarter";
    else if (phase < 14.77) name = "Waxing Gibbous";
    else if (phase < 16.61) name = "Full Moon";
    else if (phase < 22.15) name = "Waning Gibbous";
    else if (phase < 23.99) name = "Last Quarter";
    else name = "Waning Crescent";

    return { name, illumination: illum, daysToFull };
  }

  function renderMoonVisual(illumination: number): string {
    const shadow = Math.max(0, Math.min(100, 100 - illumination));
    return `<div class="moon-disc" style="--shadow:${shadow}%"></div>`;
  }

  function setSkyTheme(code: number, isNight: boolean): void {
    if (!skyLayer) return;
    skyLayer.className = "sky-layer";
    if (isNight) {
      skyLayer.classList.add("sky-night");
    } else if (code === 0 || code === 1) {
      skyLayer.classList.add("sky-clear");
    } else if (code <= 3) {
      skyLayer.classList.add("sky-cloudy");
    } else if (code <= 67 || (code >= 80 && code <= 82)) {
      skyLayer.classList.add("sky-rain");
    } else {
      skyLayer.classList.add("sky-cloudy");
    }
  }

  function isNightTime(sunrise: string, sunset: string, now: string): boolean {
    const t = new Date(now).getTime();
    const sr = new Date(sunrise).getTime();
    const ss = new Date(sunset).getTime();
    return t < sr || t > ss;
  }

  function updateSidebarCard(card: HTMLButtonElement, data: WeatherResponse): void {
    const current = data.current;
    const high = data.daily.temperature_2m_max[0];
    const low = data.daily.temperature_2m_min[0];
    const tempEl = card.querySelector("[data-city-temp]");
    const condEl = card.querySelector("[data-city-condition]");
    const highEl = card.querySelector("[data-city-high]");
    const lowEl = card.querySelector("[data-city-low]");
    const timeEl = card.querySelector("[data-city-time]");

    if (tempEl) tempEl.textContent = `${Math.round(current.temperature_2m)}${degree}`;
    if (condEl) condEl.textContent = getWeatherDescription(current.weather_code);
    if (highEl && high !== undefined) highEl.textContent = `${Math.round(high)}${degree}`;
    if (lowEl && low !== undefined) lowEl.textContent = `${Math.round(low)}${degree}`;
    if (timeEl) {
      timeEl.textContent = card.dataset.primary === "true"
        ? "My Location"
        : formatTime(current.time).replace(/\s/g, "");
    }
  }

  function renderHourly(data: WeatherResponse): void {
    if (!hourlyStrip) return;
    const hourly = data.hourly;
    const now = new Date(data.current.time).getTime();
    let start = hourly.time.findIndex((t) => new Date(t).getTime() >= now);
    if (start === -1) start = 0;

    const sunset = data.daily.sunset[0];
    const sunsetMs = sunset ? new Date(sunset).getTime() : 0;
    hourlyStrip.innerHTML = "";

    hourly.time.slice(start, start + 24).forEach((time, offset) => {
      const i = start + offset;
      const temp = hourly.temperature_2m[i];
      const code = hourly.weather_code[i];
      if (temp === undefined || code === undefined) return;

      const tMs = new Date(time).getTime();
      let label = offset === 0 ? "Now" : formatHour(time);
      if (sunsetMs && Math.abs(tMs - sunsetMs) < 1800000) label = "Sunset";

      const el = document.createElement("div");
      el.className = "hourly-item";
      el.innerHTML = `
        <span class="hourly-time">${label}</span>
        <span class="hourly-icon">${getWeatherIcon(code, "sm")}</span>
        <span class="hourly-temp">${Math.round(temp)}${degree}</span>`;
      hourlyStrip.appendChild(el);
    });
  }

  function renderForecast(data: WeatherResponse): void {
    if (!forecastList) return;
    const daily = data.daily;
    const rangeMin = Math.min(...daily.temperature_2m_min);
    const rangeMax = Math.max(...daily.temperature_2m_max);
    const span = Math.max(rangeMax - rangeMin, 1);
    forecastList.innerHTML = "";

    daily.time.forEach((date, index) => {
      const code = daily.weather_code[index];
      const high = daily.temperature_2m_max[index];
      const low = daily.temperature_2m_min[index];
      if (code === undefined || high === undefined || low === undefined) return;

      const left = ((low - rangeMin) / span) * 100;
      const width = Math.max(((high - low) / span) * 100, 6);

      const row = document.createElement("div");
      row.className = "forecast-row";
      row.innerHTML = `
        <span class="forecast-day">${formatDay(date, index)}</span>
        <span class="forecast-icon">${getWeatherIcon(code, "sm")}</span>
        <span class="forecast-low">${Math.round(low)}${degree}</span>
        <span class="forecast-bar"><i style="left:${left}%;width:${width}%"></i></span>
        <span class="forecast-high">${Math.round(high)}${degree}</span>`;
      forecastList.appendChild(row);
    });
  }

  function renderWidgets(data: WeatherResponse): void {
    const c = data.current;
    const d = data.daily;
    const today = 0;

    const setText = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    setText("wind-speed", String(Math.round(c.wind_speed_10m)));
    setText("wind-gusts", String(Math.round(d.wind_gusts_10m_max[today] ?? 0)));
    setText("wind-direction", `${Math.round(c.wind_direction_10m)}${degree} ${windCompass(c.wind_direction_10m)}`);
    const needle = document.getElementById("wind-needle");
    const compassSpeed = document.getElementById("compass-speed");
    if (needle) needle.setAttribute("transform", `rotate(${c.wind_direction_10m} 50 50)`);
    if (compassSpeed) compassSpeed.textContent = String(Math.round(c.wind_speed_10m));

    const uv = d.uv_index_max[today] ?? 0;
    setText("uv-value", String(Math.round(uv)));
    setText("uv-label", uvLabel(uv));
    const uvMarker = document.getElementBy