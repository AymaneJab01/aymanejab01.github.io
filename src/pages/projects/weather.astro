        145deg,
        #e9f7ff 0%,
        #e9efff 49%,
        #f8f7ff 100%
      );

    scroll-behavior: smooth;
  }


  * {
    box-sizing: border-box;
  }


  .sr-only {
    position: absolute;

    width: 1px;
    height: 1px;

