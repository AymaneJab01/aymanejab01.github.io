<!-- WEATHER LOGIC -->

<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  const getDescription = (code: number): string => {

    const descriptions: Record<number, string> = {
      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",
      45: "Fog",
      48: "Rime fog",
      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",
      56: "Light freezing drizzle",
      57: "Dense freezing drizzle",
      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",
      66: "Light freezing rain",
      67: "Heavy freezing rain",
      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",
      77: "Snow grains",
      80: "Light rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",
      85: "Light snow showers",
      86: "Heavy snow showers",
      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",
    };

    return descriptions[code] ?? "Unknown conditions";
  };


  const getIcon = (code: number): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 86) {
      return "🌦️";
    }

    return "⛈️";
  };


  const formatDay = (dateString: string): string => {

    return new Date(
      `${dateString}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );
  };


  const buildWeatherUrl = (
    latitude: string,
    longitude: string
  ): string => {

    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${encodeURIComponent(latitude)}` +
      `&longitude=${encodeURIComponent(longitude)}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  };


  const loadWeather = async (
    card: HTMLElement
  ): Promise<void> => {

    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }


    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          "Weather API request failed"
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const current =
        data.current;


      const temperature =
        card.querySelector<HTMLElement>(
          ".weather-temperature"
        );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      const feels =
        card.querySelector<HTMLElement>(
          ".weather-feels"
        );

      const wind =
        card.querySelector<HTMLElement>(
          ".weather-wind"
        );

      const humidity =
        card.querySelector<HTMLElement>(
          ".weather-humidity"
        );

      const time =
        card.querySelector<HTMLElement>(
          ".weather-time"
        );

      const icon =
        card.querySelector<HTMLElement>(
          ".weather-icon"
        );


      if (temperature) {

        temperature.textContent =
          String(
            Math.round(
              current.temperature_2m
            )
          );
      }


      if (description) {

        description.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (feels) {

        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°C`;
      }


      if (wind) {

        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (humidity) {

        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (time) {

        time.textContent =
          new Date(
            current.time
          ).toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit",
            }
          );
      }


      if (icon) {

        icon.textContent =
          getIcon(
            current.weather_code
          );
      }

    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );


      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );


      if (description) {

        description.textContent =
          "Unable to load weather";
      }
    }
  };


  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );


  weatherCards.forEach(
    (card) => {
      void loadWeather(card);
    }
  );


  /* ============================================================= */
  /* FORECAST */
  /* ============================================================= */

  const forecastContainer =
    document.querySelector<HTMLElement>(
      "#forecast-container"
    );


  const forecastButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );


  const loadForecast = async (
    latitude: string,
    longitude: string
  ): Promise<void> => {

    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML =
      `<div class="forecast-loading">Loading forecast...</div>`;


    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {

        throw new Error(
          "Forecast API request failed"
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const daily =
        data.daily;


      forecastContainer.innerHTML =
        "";


      daily.time.forEach(
        (
          date,
          index
        ) => {

          const item =
            document.createElement(
              "article"
            );


          item.className =
            "forecast-item";


          const day =
            document.createElement(
              "span"
            );


          day.className =
            "forecast-day";


          day.textContent =
            index === 0
              ? "Today"
              : formatDay(date);


          const weatherIcon =
            document.createElement(
              "span"
            );


          weatherIcon.className =
            "forecast-icon";


          weatherIcon.textContent =
            getIcon(
              daily.weather_code[index]
            );


          const temperatures =
            document.createElement(
              "div"
            );


          temperatures.className =
            "forecast-temperatures";


          const maximum =
            document.createElement(
              "span"
            );


          maximum.className =
            "forecast-max";


          maximum.textContent =
            `${Math.round(
              daily.temperature_2m_max[index]
            )}°`;


          const minimum =
            document.createElement(
              "span"
            );


          minimum.className =
            "forecast-min";


          minimum.textContent =
            `${Math.round(
              daily.temperature_2m_min[index]
            )}°`;


          temperatures.append(
            maximum,
            minimum
          );


          item.append(
            day,
            weatherIcon,
            temperatures
          );


          forecastContainer.appendChild(
            item
          );
        }
      );

    } catch (error) {

      console.error(
        "Forecast loading error:",
        error
      );


      forecastContainer.innerHTML =
        `<div class="forecast-loading">
          Unable to load forecast.
        </div>`;
    }
  };


  const defaultForecast =
    forecastButtons[0]?.dataset
      .forecastLocation;


  if (defaultForecast) {

    const [
      latitude,
      longitude
    ] =
      defaultForecast.split(",");


    if (latitude && longitude) {

      void loadForecast(
        latitude,
        longitude
      );
    }
  }


  forecastButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          forecastButtons.forEach(
            (item) => {

              item.classList.remove(
                "active"
              );
            }
          );


          button.classList.add(
            "active"
          );


          const location =
            button.dataset
              .forecastLocation;


          if (!location) {
            return;
          }


          const [
            latitude,
            longitude
          ] =
            location.split(",");


          if (
            !latitude ||
            !longitude
          ) {
            return;
          }


          void loadForecast(
            latitude,
            longitude
          );
        }
      );
    }
  );
</script>

