  }

  .hour-card:hover {
    transform: translateY(-3px);
    border-color: rgba(22, 135, 255, 0.4);
    box-shadow: 0 10px 25px rgba(22, 135, 255, 0.07);
  }

  .hour-card.current {
    border-color: var(--blue);
    background: var(--blue);
