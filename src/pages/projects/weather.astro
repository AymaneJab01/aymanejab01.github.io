      flex-basis: 100px;
    }

    .weather-icon {
      font-size: 3.6rem;
    }

    .temperature {
      font-size: 5.4rem;
    }

    .hero-side {
      padding: 30px 25px;
      gap: 30px;
    }

    .weather-section {
      margin-top: 60px;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }

    .detail-card {
      min-height: 125px;
    }

    .daily-row {
      grid-template-columns: 70px 38px 1fr auto;
      gap: 10px;
      padding: 13px 12px;
    }

    .daily-condition {
      font-size: 0.68rem;
    }

    .daily-temperatures {
      min-width: 75px;
      gap: 7px;
    }

    .source-content {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }

  @media (max-width: 420px) {
    .location-heading h1 {
      font-size: 3rem;
    }

    .temperature {
      font-size: 4.7rem;
    }

    .daily-condition {
      display: none;
    }

    .daily-row {
      grid-template-columns: 70px 38px 1fr;
    }

    .daily-temperatures {
      grid-column: 3;
      justify-content: flex-start;
    }
  }
</style>

<script>
  /*
   * ============================================================
   * WEATHER LOGIC
   * ============================================================
   */

  type WeatherLocation = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  type WeatherResponse = {
    current: {
      temperature_2m: number;
      relative_humidity_2m: number;
      apparent_temperature: number;
      precipitation: number;
      rain: number;
      weather_code: number;
      wind_speed_10m: number;
      wind_direction_10m: number;
      surface_pressure: number;
      visibility: number;
    };

    hourly: {
      time: string[];
      temperature_2m: number[];
      precipitation_probability: number[];
      weather_code: number[];
    };

    daily: {
      time: string[];
      weather_code: number[];
      temperature_2m_max: number[];
      temperature_2m_min: number[];
      precipitation_probability_max: number[];
      sunrise: string[];
      sunset: string[];
    };
  };

  const locations: Record<string, WeatherLocation> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let activeLocation = "Alcoi";

  /*
   * ------------------------------------------------------------
   * DOM HELPERS
   * ------------------------------------------------------------
   */

  function getElement(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  function setText(
    id: string,
    value: string
  ): void {
    const element = getElement(id);

    if (element) {
      element.textContent = value;
    }
  }

  /*
   * ------------------------------------------------------------
   * WEATHER DESCRIPTION
   * ------------------------------------------------------------
   */

  function weatherDescription(code: number): string {
    if (code === 0) return "Clear sky";

    if (code === 1) return "Mainly clear";

    if (code === 2) return "Partly cloudy";

    if (code === 3) return "Overcast";

    if (code >= 45 && code <= 48) {
      return "Fog";
    }

    if (code >= 51 && code <= 57) {
      return "Drizzle";
    }

    if (code >= 61 && code <= 67) {
      return "Rain";
    }

    if (code >= 71 && code <= 77) {
      return "Snow";
    }

    if (code >= 80 && code <= 82) {
      return "Rain showers";
    }

    if (code >= 85 && code <= 86) {
      return "Snow showers";
    }

    if (code >= 95 && code <= 99) {
      return "Thunderstorm";
    }

    return "Unknown";
  }

  /*
   * ------------------------------------------------------------
   * WEATHER ICON
   * ------------------------------------------------------------
   */

  function weatherIcon(code: number): string {
    if (code === 0) return "☀️";

    if (code === 1) return "🌤️";

    if (code === 2) return "⛅";

    if (code === 3) return "☁️";

    if (code >= 45 && code <= 48) {
      return "🌫️";
    }

    if (code >= 51 && code <= 57) {
      return "🌦️";
    }

    if (code >= 61 && code <= 67) {
      return "🌧️";
    }

    if (code >= 71 && code <= 77) {
      return "❄️";
    }

    if (code >= 80 && code <= 82) {
      return "🌦️";
    }

    if (code >= 85 && code <= 86) {
      return "🌨️";
    }

    if (code >= 95 && code <= 99) {
      return "⛈️";
    }

    return "🌤️";
  }

  /*
   * ------------------------------------------------------------
   * WIND DIRECTION
   * ------------------------------------------------------------
   */

  function windDirection(degrees: number): string {
    const directions = [
      "N",
      "NE",
      "E",
      "SE",
      "S",
      "SW",
      "W",
      "NW",
    ];

    const index = Math.round(degrees / 45) % 8;

    return directions[index];
  }

  /*
   * ------------------------------------------------------------
   * TIME FORMATTERS
   * ------------------------------------------------------------
   */

  function formatHour(dateString: string): string {
    const date = new Date(dateString);

    return date.toLocaleTimeString("es-ES", {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function formatDay(
    dateString: string,
    index: number
  ): string {
    if (index === 0) {
      return "Today";
    }

    const date = new Date(`${dateString}T12:00:00`);

    return date.toLocaleDateString("es-ES", {
      weekday: "short",
    });
  }

  function formatUpdatedTime(): string {
    return new Date().toLocaleTimeString("es-ES", {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  /*
   * ------------------------------------------------------------
   * HOURLY FORECAST
   * ------------------------------------------------------------
   */

  function renderHourly(
    data: WeatherResponse
  ): void {
    const container = getElement("hourlyForecast");

    if (!container) {
      return;
    }

    const now = new Date();

    let startIndex = data.hourly.time.findIndex(
      (time) => new Date(time) >= now
    );

    if (startIndex < 0) {
      startIndex = 0;
    }

    const endIndex = Math.min(
      startIndex + 12,
      data.hourly.time.length
    );

    let html = "";

    for (
      let i = startIndex;
      i < endIndex;
      i++
    ) {
      const isCurrent = i === startIndex;

      const time = isCurrent
        ? "Now"
        : formatHour(data.hourly.time[i]);

      const temperature = Math.round(
        data.hourly.temperature_2m[i]
      );

      const rain =
        data.hourly.precipitation_probability[i];

      const icon = weatherIcon(
        data.hourly.weather_code[i]
      );

      html += `
        <article class="hour-card ${
          isCurrent ? "current" : ""
        }">
          <span class="hour-time">
            ${time}
          </span>

          <span class="hour-icon">
            ${icon}
          </span>

          <strong class="hour-temperature">
            ${temperature}°
          </strong>

          <span class="hour-rain">
            ${rain}% rain
          </span>
        </article>
      `;
    }

    container.innerHTML = html;
  }

  /*
   * ------------------------------------------------------------
   * DAILY FORECAST
   * ------------------------------------------------------------
   */

  function renderDaily(
    data: WeatherResponse
  ): void {
    const container = getElement("dailyForecast");

    if (!container) {
      return;
    }

    const numberOfDays = Math.min(
      data.daily.time.length,
      7
    );

    let html = "";

    for (
      let i = 0;
      i < numberOfDays;
      i++
    ) {
      const day = formatDay(
        data.daily.time[i],
        i
      );

      const icon = weatherIcon(
        data.daily.weather_code[i]
      );

      const description =
        weatherDescription(
          data.daily.weather_code[i]
        );

      const high = Math.round(
        data.daily.temperature_2m_max[i]
      );

      const low = Math.round(
        data.daily.temperature_2m_min[i]
      );

      const rain =
        data.daily.precipitation_probability_max[i];

      html += `
        <div class="daily-row">

          <strong class="daily-day">
            ${day}
          </strong>

          <span class="daily-icon">
            ${icon}
          </span>

          <span class="daily-condition">
            ${description}
            · ${rain}% rain
          </span>

          <span class="daily-temperatures">
            <strong class="daily-high">
              ${high}°
            </strong>

            <span class="daily-low">
              ${low}°
            </span>
          </span>

        </div>
      `;
    }

    container.innerHTML = html;
  }

  /*
   * ------------------------------------------------------------
   * MAIN WEATHER UPDATE
   * ------------------------------------------------------------
   */

  async function loadWeather(
    locationKey: string
  ): Promise<void> {
    const location = locations[locationKey];

    if (!location) {
      return;
    }

    const errorMessage =
      getElement("errorMessage");

    if (errorMessage) {
      errorMessage.hidden = true;
    }

    setText(
      "weatherDescription",
      "Loading weather..."
    );

    const url =
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${location.latitude}` +
      `&longitude=${location.longitude}` +
      "&current=" +
      [
        "temperature_2m",
        "relative_humidity_2m",
        "apparent_temperature",
        "precipitation",
        "rain",
        "weather_code",
        "wind_speed_10m",
        "wind_direction_10m",
        "surface_pressure",
        "visibility",
      ].join(",") +
      "&hourly=" +
      [
        "temperature_2m",
        "precipitation_probability",
        "weather_code",
      ].join(",") +
      "&daily=" +
      [
        "weather_code",
        "temperature_2m_max",
        "temperature_2m_min",
        "precipitation_probability_max",
        "sunrise",
        "sunset",
      ].join(",") +
      "&timezone=auto" +
      "&forecast_days=7";

    try {
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(
          `Weather API error: ${response.status}`
        );
      }

      const data =
        (await response.json()) as WeatherResponse;

      const current = data.current;

      /*
       * Location
       */

      setText(
        "locationName",
        location.name
      );

      setText(
        "locationRegion",
        location.region
      );

      /*
       * Main weather
       */

      setText(
        "currentTemperature",
        Math.round(
          current.temperature_2m
        ).toString()
      );

      setText(
        "weatherDescription",
        weatherDescription(
          current.weather_code
        )
      );

      setText(
        "feelsLike",
        `${Math.round(
          current.apparent_temperature
        )}°C`
      );

      const mainIcon =
        getElement("mainWeatherIcon");

      if (mainIcon) {
        mainIcon.textContent =
          weatherIcon(
            current.weather_code
          );
      }

      /*
       * High / low
       */

      const todayHigh =
        data.daily.temperature_2m_max[0];

      const todayLow =
        data.daily.temperature_2m_min[0];

      setText(
        "todayHigh",
        `${Math.round(todayHigh)}°`
      );

      setText(
        "todayLow",
        `${Math.round(todayLow)}°`
      );

      /*
       * Rain
       */

      const rainChance =
        data.daily
          .precipitation_probability_max[0];

      setText(
        "rainChance",
        `${rainChance}%`
      );

      const rainBar =
        getElement("rainBar");

      if (rainBar) {
        rainBar.style.width =
          `${Math.min(
            rainChance,
            100
          )}%`;
      }

      /*
       * Details
       */

      setText(
        "humidity",
        `${current.relative_humidity_2m}%`
      );

      setText(
        "wind",
        `${Math.round(
          current.wind_speed_10m
        )} km/h`
      );

      setText(
        "windDirection",
        windDirection(
          current.wind_direction_10m
        )
      );

      setText(
        "pressure",
        `${Math.round(
          current.surface_pressure
        )} hPa`
      );

      setText(
        "visibility",
        `${Math.round(
          current.visibility / 1000
        )} km`
      );

      /*
       * Sunrise / sunset
       */

      setText(
        "sunrise",
        formatHour(
          data.daily.sunrise[0]
        )
      );

      setText(
        "sunset",
        formatHour(
          data.daily.sunset[0]
        )
      );

      /*
       * Updated time
       */

      setText(
        "updatedTime",
        formatUpdatedTime()
      );

      /*
       * Forecasts
       */

      renderHourly(data);
      renderDaily(data);

    } catch (error) {
      console.error(
        "Unable to load weather:",
        error
      );

      if (errorMessage) {
        errorMessage.hidden = false;
      }

      setText(
        "weatherDescription",
        "Weather unavailable"
      );
    }
  }

  /*
   * ------------------------------------------------------------
   * LOCATION BUTTONS
   * ------------------------------------------------------------
   */

  const locationButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-location]"
    );

  locationButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          const location =
            button.dataset.location;

          if (!location) {
            return;
          }

          activeLocation = location;

          locationButtons.forEach(
            (item) => {
              item.classList.toggle(
                "active",
                item.dataset.location ===
                  activeLocation
              );
            }
          );

          void loadWeather(
            activeLocation
          );
        }
      );
    }
  );

  /*
   * ------------------------------------------------------------
   * RETRY BUTTON
   * ------------------------------------------------------------
   */

  const retryButton =
    document.getElementById(
      "retryButton"
    );

  retryButton?.addEventListener(
    "click",
    () => {
      void loadWeather(
        activeLocation
      );
    }
  );

  /*
   * ------------------------------------------------------------
   * INITIAL LOAD
   * ------------------------------------------------------------
   */

  void loadWeather("Alcoi");
</script>
