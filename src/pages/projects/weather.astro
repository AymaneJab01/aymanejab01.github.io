<style>
  .location-button {
    background: transparent;
    color: #617084;
  }

  .location-button:hover {
    color: #07111f;
    background: #f1f7ff;
  }

  .active-location {
    background: #1687ff !important;
    color: white !important;
    box-shadow: 0 4px 14px rgba(22, 135, 255, 0.2);
  }

  .weather-nav {
    flex: 0 0 auto;
    border-radius: 0.75rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #617084;
    transition: all 0.25s ease;
  }

  .weather-nav:hover {
    color: #1687ff;
    background: #f1f7ff;
  }

  .active-nav {
    background: #eaf4ff;
    color: #1687ff;
    font-weight: 600;
  }

  .detail-card {
    display: flex;
    min-height: 125px;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 1rem;
    border: 1px solid rgba(22, 135, 255, 0.1);
    background: white;
    padding: 1.25rem;
    box-shadow: 0 5px 20px rgba(20, 100, 180, 0.04);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .detail-card:hover {
    transform: translateY(-2px);
    border-color: rgba(22, 135, 255, 0.25);
    box-shadow: 0 10px 30px rgba(20, 100, 180, 0.08);
  }

  .detail-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8b98a9;
  }

  .detail-card strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.05rem;
    font-weight: 600;
    color: #07111f;
  }

  .hour-card {
    min-width: 105px;
    flex: 0 0 105px;
    border-radius: 1rem;
    border: 1px solid #e3edf8;
    background: #f8fbff;
    padding: 1rem 0.75rem;
    text-align: center;
    transition: all 0.25s ease;
  }

  .hour-card:hover {
    transform: translateY(-3px);
    border-color: rgba(22, 135, 255, 0.25);
    background: #f1f7ff;
  }

  .hour-card.current {
    border-color: rgba(22, 135, 255, 0.4);
    background: #eaf4ff;
    box-shadow: 0 8px 25px rgba(22, 135, 255, 0.1);
  }

  .daily-row {
    display: grid;
    grid-template-columns: 90px 55px 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .daily-day {
    font-size: 0.9rem;
    font-weight: 600;
    color: #07111f;
  }

  .daily-condition {
    font-size: 0.8rem;
    color: #617084;
  }

  .temperature-bar {
    height: 7px;
    min-width: 100px;
    overflow: hidden;
    border-radius: 999px;
    background: #e7f1fc;
  }

  .temperature-bar-inner {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #5b7cff, #1687ff);
  }

  @media (max-width: 640px) {
    .daily-row {
      grid-template-columns: 70px 45px 1fr auto;
      gap: 0.5rem;
    }

    .temperature-bar {
      min-width: 55px;
    }
  }
</style>

<script>
  interface LocationData {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  }

  interface WeatherResponse {
    current: {
      temperature_2m: number;
      relative_humidity_2m: number;
      apparent_temperature: number;
      precipitation: number;
      rain: number;
      weather_code: number;
      wind_speed_10m: number;
      surface_pressure: number;
      visibility: number;
      uv_index: number;
    };

    hourly: {
      time: string[];
      temperature_2m: number[];
      apparent_temperature: number[];
      precipitation_probability: number[];
      weather_code: number[];
      wind_speed_10m: number[];
    };

    daily: {
      time: string[];
      weather_code: number[];
      temperature_2m_max: number[];
      temperature_2m_min: number[];
      precipitation_probability_max: number[];
      sunrise: string[];
      sunset: string[];
      uv_index_max: number[];
    };
  }


  const locations: Record<string, LocationData> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };


  let activeLocation = "Alcoi";


  function weatherDescription(code: number): string {
    if (code === 0) return "Clear sky";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Overcast";

    if (code === 45 || code === 48) {
      return "Fog";
    }

    if (code >= 51 && code <= 57) {
      return "Drizzle";
    }

    if (code >= 61 && code <= 67) {
      return "Rain";
    }

    if (code >= 71 && code <= 77) {
      return "Snow";
    }

    if (code >= 80 && code <= 82) {
      return "Rain showers";
    }

    if (code >= 85 && code <= 86) {
      return "Snow showers";
    }

    if (code >= 95 && code <= 99) {
      return "Thunderstorm";
    }

    return "Unknown";
  }


  function weatherIcon(code: number): string {
    if (code === 0) return "☀️";
    if (code === 1 || code === 2) return "🌤️";
    if (code === 3) return "☁️";

    if (code === 45 || code === 48) {
      return "🌫️";
    }

    if (code >= 51 && code <= 57) {
      return "🌦️";
    }

    if (code >= 61 && code <= 67) {
      return "🌧️";
    }

    if (code >= 71 && code <= 77) {
      return "❄️";
    }

    if (code >= 80 && code <= 82) {
      return "🌦️";
    }

    if (code >= 85 && code <= 86) {
      return "🌨️";
    }

    if (code >= 95 && code <= 99) {
      return "⛈️";
    }

    return "🌤️";
  }


  function uvDescription(value: number): string {
    if (value <= 2) return "Low";
    if (value <= 5) return "Moderate";
    if (value <= 7) return "High";
    if (value <= 10) return "Very high";
    return "Extreme";
  }


  function formatHour(dateString: string): string {
    const date = new Date(dateString);

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "Europe/Madrid",
    });
  }


  function formatDay(
    dateString: string,
    index: number
  ): string {
    if (index === 0) return "Today";

    const date = new Date(`${dateString}T12:00:00`);

    return date.toLocaleDateString("en-GB", {
      weekday: "short",
      timeZone: "Europe/Madrid",
    });
  }


  function setText(
    id: string,
    value: string
  ): void {
    const element = document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }


  function updateLocationButtons(): void {
    document
      .querySelectorAll<HTMLButtonElement>(".location-button")
      .forEach((button) => {
        const isActive =
          button.dataset.location === activeLocation;

        button.classList.toggle(
          "active-location",
          isActive
        );

        if (isActive) {
          button.classList.remove("text-[#617084]");
        } else {
          button.classList.add("text-[#617084]");
        }
      });
  }


  function renderHourly(
    data: WeatherResponse
  ): void {
    const container =
      document.getElementById("hourly-container");

    if (!container) return;

    const now = new Date();

    let startIndex = data.hourly.time.findIndex(
      (time) => new Date(time) >= now
    );

    if (startIndex < 0) {
      startIndex = 0;
    }

    const endIndex = Math.min(
      startIndex + 12,
      data.hourly.time.length
    );

    container.innerHTML = "";

    for (
      let i = startIndex;
      i < endIndex;
      i++
    ) {
      const card =
        document.createElement("div");

      card.className =
        `hour-card ${
          i === startIndex ? "current" : ""
        }`;

      card.innerHTML = `
        <p class="text-xs font-medium text-[#617084]">
          ${i === startIndex ? "Now" : formatHour(data.hourly.time[i])}
        </p>

        <div class="mt-3 text-2xl">
          ${weatherIcon(data.hourly.weather_code[i])}
        </div>

        <p class="mt-3 font-mono text-base font-semibold text-[#07111f]">
          ${Math.round(data.hourly.temperature_2m[i])}°
        </p>

        <p class="mt-2 text-[10px] text-[#1687ff]">
          ${data.hourly.precipitation_probability[i]}% rain
        </p>
      `;

      container.appendChild(card);
    }
  }


  function renderDaily(
    data: WeatherResponse
  ): void {
    const container =
      document.getElementById("daily-container");

    if (!container) return;

    container.innerHTML = "";

    const highs = data.daily.temperature_2m_max
      .slice(0, 10);

    const lows = data.daily.temperature_2m_min
      .slice(0, 10);

    const minTemp = Math.min(...lows);
    const maxTemp = Math.max(...highs);

    for (let i = 0; i < 10; i++) {
      const row =
        document.createElement("div");

      const high = highs[i];
      const low = lows[i];

      const width =
        ((high - minTemp) /
          Math.max(1, maxTemp - minTemp)) *
          65 +
        25;

      row.className = "daily-row";

      row.innerHTML = `
        <div>
          <p class="daily-day">
            ${formatDay(data.daily.time[i], i)}
          </p>

          <p class="daily-condition">
            ${weatherDescription(data.daily.weather_code[i])}
          </p>
        </div>

        <div class="text-2xl">
          ${weatherIcon(data.daily.weather_code[i])}
        </div>

        <div class="temperature-bar">
          <div
            class="temperature-bar-inner"
            style="width:${width}%"
          ></div>
        </div>

        <div class="text-right font-mono text-sm">
          <span class="font-semibold text-[#07111f]">
            ${Math.round(high)}°
          </span>

          <span class="ml-2 text-[#8b98a9]">
            ${Math.round(low)}°
          </span>
        </div>
      `;

      container.appendChild(row);
    }
  }


  async function loadWeather(
    locationKey: string
  ): Promise<void> {
    const location =
      locations[locationKey];

    if (!location) return;

    activeLocation = locationKey;

    updateLocationButtons();

    setText(
      "location-name",
      location.name
    );

    setText(
      "location-region",
      location.region
    );

    setText(
      "current-condition",
      "Loading weather..."
    );

    try {
      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${location.latitude}` +
        `&longitude=${location.longitude}` +
        `&current=` +
        `temperature_2m,relative_humidity_2m,` +
        `apparent_temperature,precipitation,rain,` +
        `weather_code,wind_speed_10m,` +
        `surface_pressure,visibility,uv_index` +
        `&hourly=` +
        `temperature_2m,apparent_temperature,` +
        `precipitation_probability,weather_code,` +
        `wind_speed_10m` +
        `&daily=` +
        `weather_code,temperature_2m_max,` +
        `temperature_2m_min,precipitation_probability_max,` +
        `sunrise,sunset,uv_index_max` +
        `&timezone=Europe%2FMadrid` +
        `&forecast_days=10`;

      const response =
        await fetch(url);

      if (!response.ok) {
        throw new Error(
          "Weather request failed"
        );
      }

      const data =
        (await response.json()) as WeatherResponse;


      // -----------------------------------------------------------
      // Current
      // -----------------------------------------------------------

      const current =
        data.current;

      const todayHigh =
        data.daily.temperature_2m_max[0];

      const todayLow =
        data.daily.temperature_2m_min[0];

      const rainChance =
        data.daily.precipitation_probability_max[0];

      setText(
        "current-temperature",
        Math.round(current.temperature_2m).toString()
      );

      setText(
        "current-condition",
        weatherDescription(
          current.weather_code
        )
      );

      setText(
        "weather-icon",
        weatherIcon(
          current.weather_code
        )
      );

      setText(
        "feels-like",
        `Feels like ${Math.round(
          current.apparent_temperature
        )}°C`
      );

      setText(
        "today-high",
        `${Math.round(todayHigh)}°C`
      );

      setText(
        "today-low",
        `${Math.round(todayLow)}°C`
      );

      setText(
        "rain-chance",
        `${rainChance}%`
      );

      setText(
        "outlook-rain",
        `${rainChance}%`
      );

      setText(
        "current-wind",
        `${Math.round(
          current.wind_speed_10m
        )} km/h`
      );

      setText(
        "current-humidity",
        `${current.relative_humidity_2m}%`
      );

      setText(
        "uv-index",
        current.uv_index.toFixed(1)
      );

      setText(
        "uv-description",
        uvDescription(
          current.uv_index
        )
      );


      // -----------------------------------------------------------
      // Details
      // -----------------------------------------------------------

      setText(
        "detail-feels",
        `${Math.round(
          current.apparent_temperature
        )}°C`
      );

      setText(
        "detail-humidity",
        `${current.relative_humidity_2m}%`
      );

      setText(
        "detail-wind",
        `${Math.round(
          current.wind_speed_10m
        )} km/h`
      );

      setText(
        "detail-uv",
        current.uv_index.toFixed(1)
      );

      setText(
        "sunrise",
        formatHour(
          data.daily.sunrise[0]
        )
      );

      setText(
        "sunset",
        formatHour(
          data.daily.sunset[0]
        )
      );

      setText(
        "pressure",
        `${Math.round(
          current.surface_pressure
        )} hPa`
      );

      setText(
        "visibility",
        `${Math.round(
          current.visibility / 1000
        )} km`
      );


      // -----------------------------------------------------------
      // Rain progress
      // -----------------------------------------------------------

      const rainBar =
        document.getElementById(
          "rain-bar"
        );

      if (rainBar) {
        rainBar.style.width =
          `${Math.min(
            100,
            rainChance
          )}%`;
      }


      // -----------------------------------------------------------
      // Updated time
      // -----------------------------------------------------------

      const now =
        new Date();

      setText(
        "updated-time",
        now.toLocaleTimeString(
          "en-GB",
          {
            hour: "2-digit",
            minute: "2-digit",
            timeZone: "Europe/Madrid",
          }
        )
      );


      // -----------------------------------------------------------
      // Forecasts
      // -----------------------------------------------------------

      renderHourly(data);
      renderDaily(data);

    } catch (error) {
      console.error(
        "Weather error:",
        error
      );

      setText(
        "current-temperature",
        "--"
      );

      setText(
        "current-condition",
        "Weather unavailable"
      );

      setText(
        "feels-like",
        "Unable to retrieve current conditions"
      );
    }
  }


  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-button"
    )
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const location =
            button.dataset.location;

          if (location) {
            void loadWeather(location);
          }
        }
      );
    });


  void loadWeather("Alcoi");
</script>
