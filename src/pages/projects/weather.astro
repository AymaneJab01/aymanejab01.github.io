<script>
  interface CurrentWeather {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface DailyWeather {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: CurrentWeather;
    daily: DailyWeather;
  }

  const API_URL = "https://api.open-meteo.com/v1/forecast";

  const descriptions: Record<number, string> = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Light rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Light snow",
    73: "Moderate snow",
    75: "Heavy snow",
    77: "Snow grains",
    80: "Light rain showers",
    81: "Moderate rain showers",
    82: "Heavy rain showers",
    85: "Light snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with hail",
    99: "Thunderstorm with heavy hail"
  };

  function getDescription(code: number): string {
    return descriptions[code] ?? "Unknown conditions";
  }

  function getIcon(code: number): string {
    if (code === 0) return "☀";
    if (code === 1) return "🌤";
    if (code === 2) return "⛅";
    if (code === 3) return "☁";
    if (code === 45 || code === 48) return "🌫";
    if (code >= 51 && code <= 67) return "🌧";
    if (code >= 71 && code <= 77) return "❄";
    if (code >= 80 && code <= 82) return "🌦";
    if (code >= 85 && code <= 86) return "🌨";
    return "⛈";
  }

  function buildUrl(latitude: string, longitude: string): string {
    const params = new URLSearchParams();

    params.set("latitude", latitude);
    params.set("longitude", longitude);

    params.set(
      "current",
      "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m"
    );

    params.set(
      "daily",
      "weather_code,temperature_2m_max,temperature_2m_min"
    );

    params.set("timezone", "Europe/Madrid");
    params.set("forecast_days", "7");

    return `${API_URL}?${params.toString()}`;
  }

  function formatTime(value: string): string {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function formatDay(value: string, index: number): string {
    if (index === 0) {
      return "Today";
    }

    const date = new Date(`${value}T12:00:00`);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleDateString("en-GB", {
      weekday: "short"
    });
  }

  async function loadCurrentWeather(
    card: HTMLElement
  ): Promise<void> {
    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }

    const description = card.querySelector<HTMLElement>(".description");

    try {
      const response = await fetch(
        buildUrl(latitude, longitude)
      );

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = (await response.json()) as WeatherResponse;
      const current = data.current;

      const temperature =
        card.querySelector<HTMLElement>(".temperature");

      const feels =
        card.querySelector<HTMLElement>(".feels");

      const wind =
        card.querySelector<HTMLElement>(".wind");

      const humidity =
        card.querySelector<HTMLElement>(".humidity");

      const updated =
        card.querySelector<HTMLElement>(".updated");

      const icon =
        card.querySelector<HTMLElement>(".weather-icon");

      if (temperature) {
        temperature.textContent =
          Math.round(current.temperature_2m).toString();
      }

      if (feels) {
        feels.textContent =
          `${Math.round(current.apparent_temperature)}°C`;
      }

      if (wind) {
        wind.textContent =
          `${Math.round(current.wind_speed_10m)} km/h`;
      }

      if (humidity) {
        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }

      if (updated) {
        updated.textContent = formatTime(current.time);
      }

      if (icon) {
        icon.textContent = getIcon(current.weather_code);
      }

      if (description) {
        description.textContent =
          getDescription(current.weather_code);
      }
    } catch (error) {
      console.error("Weather request failed:", error);

      if (description) {
        description.textContent = "Unable to load weather";
      }
    }
  }

  async function loadForecast(
    latitude: string,
    longitude: string
  ): Promise<void> {
    const container =
      document.querySelector<HTMLElement>("#forecast-container");

    if (!container) {
      return;
    }

    container.innerHTML =
      '<div class="forecast-loading">Loading forecast...</div>';

    try {
      const response = await fetch(
        buildUrl(latitude, longitude)
      );

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = (await response.json()) as WeatherResponse;

      container.innerHTML = "";

      data.daily.time.forEach((date, index) => {
        const item = document.createElement("article");
        item.className = "forecast-item";

        const day = document.createElement("div");
        day.className = "forecast-day";
        day.textContent = formatDay(date, index);

        const icon = document.createElement("div");
        icon.className = "forecast-icon";
        icon.textContent = getIcon(
          data.daily.weather_code[index] ?? 0
        );

        const temperatures = document.createElement("div");
        temperatures.className = "forecast-temperatures";

        const maximum = document.createElement("strong");
        maximum.textContent =
          `${Math.round(data.daily.temperature_2m_max[index] ?? 0)}°`;

        const minimum = document.createElement("span");
        minimum.textContent =
          `${Math.round(data.daily.temperature_2m_min[index] ?? 0)}°`;

        temperatures.append(maximum, minimum);
        item.append(day, icon, temperatures);
        container.appendChild(item);
      });
    } catch (error) {
      console.error("Forecast request failed:", error);

      container.innerHTML =
        '<div class="forecast-loading">Unable to load forecast.</div>';
    }
  }

  const cards =
    document.querySelectorAll<HTMLElement>(".weather-card");

  cards.forEach((card) => {
    void loadCurrentWeather(card);
  });

  const buttons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((item) => {
        item.classList.remove("active");
      });

      button.classList.add("active");

      const latitude = button.dataset.lat;
      const longitude = button.dataset.lon;

      if (latitude && longitude) {
        void loadForecast(latitude, longitude);
      }
    });
  });

  const firstButton = buttons[0];

  if (firstButton) {
    const latitude = firstButton.dataset.lat;
    const longitude = firstButton.dataset.lon;

    if (latitude && longitude) {
      void loadForecast(latitude, longitude);
    }
  }

  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );

  if (canvas) {
    const context = canvas.getContext("2d");

    if (context) {
      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        opacity: number;
      }

      const particles: Particle[] = [];

      let width = 0;
      let height = 0;
      let mouseX = 0;
      let mouseY = 0;
      let targetX = 0;
      let targetY = 0;
      let animationFrame = 0;

      function resize(): void {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);

        width = window.innerWidth;
        height = window.innerHeight;

        canvas.width = width * ratio;
        canvas.height = height * ratio;

        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );
      }

      function createParticle(): Particle {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.12,
          vy: (Math.random() - 0.5) * 0.12,
          size: Math.random() * 1.4 + 0.4,
          opacity: Math.random() * 0.35 + 0.05
        };
      }

      function initializeParticles(): void {
        particles.length = 0;

        const count = window.innerWidth < 768 ? 25 : 55;

        for (let i = 0; i < count; i += 1) {
          particles.push(createParticle());
        }
      }

      function drawGrid(): void {
        const spacing = 80;

        context.save();

        context.strokeStyle =
          "rgba(0, 170, 255, 0.035)";

        context.lineWidth = 1;

        for (let x = 0; x < width; x += spacing) {
          context.beginPath();
          context.moveTo(x, 0);
          context.lineTo(x, height);
          context.stroke();
        }

        for (let y = 0; y < height; y += spacing) {
          context.beginPath();
          context.moveTo(0, y);
          context.lineTo(width, y);
          context.stroke();
        }

        context.restore();
      }

      function drawParticles(): void {
        for (const particle of particles) {
          particle.x += particle.vx;
          particle.y += particle.vy;

          if (particle.x < -10) particle.x = width + 10;
          if (particle.x > width + 10) particle.x = -10;
          if (particle.y < -10) particle.y = height + 10;
          if (particle.y > height + 10) particle.y = -10;

          const dx = targetX - particle.x;
          const dy = targetY - particle.y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < 180) {
            const force = (1 - distance / 180) * 0.004;

            particle.vx += dx * force;
            particle.vy += dy * force;
          }

          particle.vx *= 0.995;
          particle.vy *= 0.995;

          context.beginPath();

          context.arc(
            particle.x,
            particle.y,
            particle.size,
            0,
            Math.PI * 2
          );

          context.fillStyle =
            `rgba(0, 170, 255, ${particle.opacity})`;

          context.fill();
        }
      }

      function drawConnections(): void {
        const maxDistance = 120;

        for (let i = 0; i < particles.length; i += 1) {
          const first = particles[i];

          if (!first) continue;

          for (let j = i + 1; j < particles.length; j += 1) {
            const second = particles[j];

            if (!second) continue;

            const dx = first.x - second.x;
            const dy = first.y - second.y;

            const distance =
              Math.sqrt(dx * dx + dy * dy);

            if (distance < maxDistance) {
              const opacity =
                (1 - distance / maxDistance) * 0.06;

              context.beginPath();
              context.moveTo(first.x, first.y);
              context.lineTo(second.x, second.y);

              context.strokeStyle =
                `rgba(0, 170, 255, ${opacity})`;

              context.lineWidth = 1;
              context.stroke();
            }
          }
        }
      }

      function drawGlow(): void {
        const gradient =
          context.createRadialGradient(
            targetX,
            targetY,
            0,
            targetX,
            targetY,
            240
          );

        gradient.addColorStop(
          0,
          "rgba(0, 170, 255, 0.07)"
        );

        gradient.addColorStop(
          1,
          "rgba(0, 170, 255, 0)"
        );

        context.fillStyle = gradient;
        context.fillRect(0, 0, width, height);
      }

      function animate(): void {
        mouseX += (targetX - mouseX) * 0.04;
        mouseY += (targetY - mouseY) * 0.04;

        context.clearRect(0, 0, width, height);

        drawGlow();
        drawGrid();
        drawConnections();
        drawParticles();

        animationFrame =
          requestAnimationFrame(animate);
      }

      function handleResize(): void {
        resize();
        initializeParticles();
      }

      function handleMouseMove(event: MouseEvent): void {
        targetX = event.clientX;
        targetY = event.clientY;
      }

      resize();

      targetX = width / 2;
      targetY = height / 2;
      mouseX = targetX;
      mouseY = targetY;

      initializeParticles();

      window.addEventListener("resize", handleResize);
      window.addEventListener(
        "mousemove",
        handleMouseMove,
        { passive: true }
      );

      if (
        !window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches
      ) {
        animationFrame =
          requestAnimationFrame(animate);
      } else {
        drawGrid();
        drawParticles();
      }

      window.addEventListener("pagehide", () => {
        cancelAnimationFrame(animationFrame);
        window.removeEventListener("resize", handleResize);
        window.removeEventListener("mousemove", handleMouseMove);
      });
    }
  }
</script>

<style>
  .weather-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #f8fbff;
    color: #0c1726;
  }

  #weather-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 0%, rgba(0, 174, 255, 0.12), transparent 42%),
      radial-gradient(circle at 10% 70%, rgba(0, 119, 255, 0.055), transparent 32%),
      radial-gradient(circle at 90% 65%, rgba(0, 190, 255, 0.045), transparent 30%);
  }

  .weather-content {
    position: relative;
    z-index: 2;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 110px 0 80px;
  }

  .weather-header {
    max-width: 900px;
    margin-bottom: 90px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    color: #008fd4;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00aaff;
    box-shadow: 0 0 14px rgba(0, 170, 255, 0.75);
  }

  .weather-header h1 {
    color: #081421;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .weather-header h1 span {
    color: #00aaff;
  }

  .intro {
    max-width: 720px;
    margin-top: 28px;
    color: #536274;
    font-size: 17px;
    line-height: 1.9;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tags span {
    display: inline-flex;
    padding: 7px 12px;
    border: 1px solid rgba(0, 145, 220, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.65);
    color: #526174;
    font-family: monospace;
    font-size: 11px;
  }

  .weather-section {
    margin-top: 30px;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 28px;
    padding-top: 45px;
    border-top: 1px solid rgba(9, 44, 75, 0.1);
  }

  .section-label {
    display: block;
    color: #0099df;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .section-heading h2 {
    margin-top: 9px;
    color: #0b1827;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .section-heading p {
    max-width: 650px;
    margin-top: 10px;
    color: #657386;
    font-size: 14px;
    line-height: 1.8;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #008fd4;
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .live-indicator span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00aaff;
    box-shadow: 0 0 10px rgba(0, 170, 255, 0.7);
  }

  .weather-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .weather-card {
    position: relative;
    min-height: 450px;
    overflow: hidden;
