---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">

  <main
    class="weather-page relative min-h-screen overflow-hidden text-[var(--white)]"
  >

    <!-- ========================================================= -->
    <!-- INTERACTIVE BACKGROUND -->
    <!-- ========================================================= -->

    <canvas
      id="weather-background"
      class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div
      class="pointer-events-none fixed inset-0 -z-[9] weather-atmosphere"
      aria-hidden="true"
    ></div>


    <!-- ========================================================= -->
    <!-- DOCUMENTATION PAGE -->
    <!-- ========================================================= -->

    <section class="relative py-24 md:py-32">

      <div class="mx-auto max-w-6xl px-6">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <header class="mb-14 md:mb-20">

          <div class="mb-6 flex items-center gap-3">

            <span
              class="h-2 w-2 rounded-full bg-[var(--sec)] shadow-[0_0_18px_var(--sec)]"
            ></span>

            <span
              class="text-xs uppercase tracking-[0.24em] text-[var(--sec)]"
            >
              Project 03 / Weather
            </span>

          </div>


          <h1
            class="max-w-4xl text-4xl font-medium tracking-tight md:text-6xl lg:text-7xl"
          >
            Weather Dashboard<span class="text-[var(--sec)]">.</span>
          </h1>


          <p
            class="mt-6 max-w-3xl text-base leading-8 text-[var(--white-icon)] md:text-lg"
          >
            A real-time weather interface for Alcoi and Valencia,
            combining live meteorological data with an interactive
            developer-oriented visual system.
          </p>


          <div
            class="mt-8 flex flex-wrap gap-2"
          >

            <span class="doc-tag">
              Astro
            </span>

            <span class="doc-tag">
              TypeScript
            </span>

            <span class="doc-tag">
              Open-Meteo
            </span>

            <span class="doc-tag">
              Canvas
            </span>

            <span class="doc-tag">
              REST API
            </span>

          </div>

        </header>


        <!-- ===================================================== -->
        <!-- LIVE WEATHER -->
        <!-- ===================================================== -->

        <section
          aria-labelledby="live-weather-title"
        >

          <div class="mb-7">

            <span class="doc-kicker">
              Live conditions
            </span>

            <h2
              id="live-weather-title"
              class="mt-3 text-2xl font-medium md:text-3xl"
            >
              Current weather
            </h2>

            <p
              class="mt-3 max-w-2xl text-sm leading-7 text-[var(--white-icon)] md:text-base"
            >
              Current conditions are retrieved dynamically from
              the weather API and updated directly in the browser.
            </p>

          </div>


          <!-- =================================================== -->
          <!-- LOCATION CARDS -->
          <!-- =================================================== -->

          <div
            class="grid grid-cols-1 gap-6 lg:grid-cols-2"
          >

            <!-- ================================================= -->
            <!-- ALCOI -->
            <!-- ================================================= -->

            <article
              class="weather-card"
              data-lat="38.6983"
              data-lon="-0.4743"
              data-city="Alcoi"
            >

              <div class="weather-card-glow"></div>

              <div class="relative z-10">

                <div class="flex items-start justify-between gap-6">

                  <div>

                    <span class="weather-label">
                      Location
                    </span>

                    <h3 class="weather-city">
                      Alcoi<span class="text-[var(--sec)]">.</span>
                    </h3>

                    <p class="mt-2 text-sm text-[var(--white-icon)]">
                      Alicante, Spain
                    </p>

                  </div>


                  <div
                    class="weather-icon"
                    aria-hidden="true"
                  >
                    ⛅
                  </div>

                </div>


                <!-- Temperature -->

                <div class="mt-12">

                  <div class="flex items-end gap-4">

                    <span
                      class="weather-temperature"
                    >
                      --
                    </span>

                    <span
                      class="mb-2 text-sm text-[var(--white-icon)]"
                    >
                      °C
                    </span>

                  </div>


                  <p
                    class="weather-description mt-3"
                  >
                    Loading weather...
                  </p>

                </div>


                <!-- Weather data -->

                <div class="weather-data-grid">

                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Feels like
                    </span>

                    <span class="weather-feels weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Wind
                    </span>

                    <span class="weather-wind weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Humidity
                    </span>

                    <span class="weather-humidity weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Updated
                    </span>

                    <span class="weather-time weather-data-value">
                      --
                    </span>

                  </div>

                </div>

              </div>

            </article>


            <!-- ================================================= -->
            <!-- VALENCIA -->
            <!-- ================================================= -->

            <article
              class="weather-card"
              data-lat="39.4699"
              data-lon="-0.3763"
              data-city="Valencia"
            >

              <div class="weather-card-glow"></div>

              <div class="relative z-10">

                <div class="flex items-start justify-between gap-6">

                  <div>

                    <span class="weather-label">
                      Location
                    </span>

                    <h3 class="weather-city">
                      Valencia<span class="text-[var(--sec)]">.</span>
                    </h3>

                    <p class="mt-2 text-sm text-[var(--white-icon)]">
                      Valencia, Spain
                    </p>

                  </div>


                  <div
                    class="weather-icon"
                    aria-hidden="true"
                  >
                    ☀️
                  </div>

                </div>


                <!-- Temperature -->

                <div class="mt-12">

                  <div class="flex items-end gap-4">

                    <span
                      class="weather-temperature"
                    >
                      --
                    </span>

                    <span
                      class="mb-2 text-sm text-[var(--white-icon)]"
                    >
                      °C
                    </span>

                  </div>


                  <p
                    class="weather-description mt-3"
                  >
                    Loading weather...
                  </p>

                </div>


                <!-- Weather data -->

                <div class="weather-data-grid">

                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Feels like
                    </span>

                    <span class="weather-feels weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Wind
                    </span>

                    <span class="weather-wind weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Humidity
                    </span>

                    <span class="weather-humidity weather-data-value">
                      --
                    </span>

                  </div>


                  <div class="weather-data-item">

                    <span class="weather-data-label">
                      Updated
                    </span>

                    <span class="weather-time weather-data-value">
                      --
                    </span>

                  </div>

                </div>

              </div>

            </article>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- FORECAST -->
        <!-- ===================================================== -->

        <section
          class="mt-20 md:mt-28"
          aria-labelledby="forecast-title"
        >

          <div
            class="mb-7 border-t border-[var(--white-icon-tr)] pt-10"
          >

            <span class="doc-kicker">
              Forecast
            </span>

            <h2
              id="forecast-title"
              class="mt-3 text-2xl font-medium md:text-3xl"
            >
              Seven day outlook
            </h2>

            <p
              class="mt-3 max-w-2xl text-sm leading-7 text-[var(--white-icon)] md:text-base"
            >
              A compact forecast generated from the same live
              weather service used by the current conditions.
            </p>

          </div>


          <!-- Forecast location selector -->

          <div
            class="mb-6 flex flex-wrap gap-2"
          >

            <button
              type="button"
              class="forecast-button active"
              data-forecast-location="38.6983,-0.4743"
            >
              Alcoi
            </button>

            <button
              type="button"
              class="forecast-button"
              data-forecast-location="39.4699,-0.3763"
            >
              Valencia
            </button>

          </div>


          <!-- Forecast container -->

          <div
            id="forecast-container"
            class="forecast-container"
          >

            <div class="forecast-loading">
              Loading forecast...
            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- DOCUMENTATION -->
        <!-- ===================================================== -->

        <section
          class="mt-20 md:mt-28"
          aria-labelledby="documentation-title"
        >

          <div
            class="border-t border-[var(--white-icon-tr)] pt-10"
          >

            <span class="doc-kicker">
              Documentation
            </span>

            <h2
              id="documentation-title"
              class="mt-3 text-2xl font-medium md:text-3xl"
            >
              Live data meets interactive UI.
            </h2>

            <p
              class="mt-5 max-w-3xl text-base leading-8 text-[var(--white-icon)]"
            >
              This project combines a lightweight Astro page with
              client-side TypeScript to retrieve current weather
              conditions. The interface intentionally follows a
              documentation-oriented structure, separating the
              live data, forecast, implementation details and
              technologies used.
            </p>

          </div>


          <!-- =================================================== -->
          <!-- IMPLEMENTATION -->
          <!-- =================================================== -->

          <div
            class="documentation-grid mt-12"
          >

            <article class="documentation-block">

              <span class="documentation-number">
                01
              </span>

              <h3>
                Data source
              </h3>

              <p>
                Weather information is retrieved from Open-Meteo
                using geographic coordinates for Alcoi and Valencia.
              </p>

            </article>


            <article class="documentation-block">

              <span class="documentation-number">
                02
              </span>

              <h3>
                Client rendering
              </h3>

              <p>
                TypeScript fetches the data in the browser and
                updates the weather interface without requiring a
                backend server.
              </p>

            </article>


            <article class="documentation-block">

              <span class="documentation-number">
                03
              </span>

              <h3>
                Interactive background
              </h3>

              <p>
                Canvas particles, connections, a moving grid and
                mouse interaction create a subtle electric-blue
                atmosphere inspired by modern interactive component
                showcases.
              </p>

            </article>


            <article class="documentation-block">

              <span class="documentation-number">
                04
              </span>

              <h3>
                Responsive design
              </h3>

              <p>
                The layout adapts from a single-column mobile
                presentation to a two-column desktop weather
                dashboard.
              </p>

            </article>

          </div>


          <!-- =================================================== -->
          <!-- TECHNOLOGIES -->
          <!-- =================================================== -->

          <div class="mt-14">

            <span class="doc-kicker">
              Technologies
            </span>


            <div class="mt-5 flex flex-wrap gap-2">

              <span class="doc-tag">
                Astro
              </span>

              <span class="doc-tag">
                TypeScript
              </span>

              <span class="doc-tag">
                Open-Meteo API
              </span>

              <span class="doc-tag">
                Fetch API
              </span>

              <span class="doc-tag">
                HTML
              </span>

              <span class="doc-tag">
                Tailwind CSS
              </span>

              <span class="doc-tag">
                Canvas API
              </span>

              <span class="doc-tag">
                CSS Animation
              </span>

            </div>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- API ENDPOINT -->
        <!-- ===================================================== -->

        <section class="mt-16">

          <div class="api-box">

            <div class="flex items-center gap-3">

              <span
                class="h-2 w-2 rounded-full bg-[var(--sec)] shadow-[0_0_12px_var(--sec)]"
              ></span>

              <span class="text-xs uppercase tracking-[0.18em] text-[var(--white-icon)]">
                Endpoint
              </span>

            </div>


            <code class="mt-4 block break-all font-mono text-xs leading-6 text-[var(--sec)] md:text-sm">
              api.open-meteo.com/v1/forecast
            </code>

          </div>

        </section>


        <!-- ===================================================== -->
        <!-- BACK -->
        <!-- ===================================================== -->

        <div class="mt-16 border-t border-[var(--white-icon-tr)] pt-8">

          <a
            href="/#projects"
            class="back-link"
          >
            <span>←</span>
            <span>Back to projects</span>
          </a>

        </div>

      </div>

    </section>

  </main>

</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- IMPORTANT: THIS SCRIPT ENDS BEFORE HTML/STYLE -->
<!-- ============================================================= -->

<script>
  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    weather_code: number;
    wind_speed_10m: number;
    time: string;
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
  }

  interface WeatherResponse {
    current: WeatherCurrent;
    daily: WeatherDaily;
  }


  const getDescription = (code: number): string => {

    const descriptions: Record<number, string> = {
      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",
      45: "Fog",
      48: "Rime fog",
      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",
      56: "Light freezing drizzle",
      57: "Dense freezing drizzle",
      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",
      66: "Light freezing rain",
      67: "Heavy freezing rain",
      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",
      77: "Snow grains",
      80: "Light rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",
      85: "Light snow showers",
      86: "Heavy snow showers",
      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail",
    };

    return descriptions[code] ?? "Unknown conditions";
  };


  const getIcon = (code: number): string => {

    if (code === 0) {
      return "☀️";
    }

    if (code <= 3) {
      return "⛅";
    }

    if (code <= 48) {
      return "🌫️";
    }

    if (code <= 67) {
      return "🌧️";
    }

    if (code <= 77) {
      return "❄️";
    }

    if (code <= 86) {
      return "🌦️";
    }

    return "⛈️";
  };


  const formatDay = (dateString: string): string => {

    return new Date(
      `${dateString}T12:00:00`
    ).toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );
  };


  const buildWeatherUrl = (
    latitude: string,
    longitude: string
  ): string => {

    return (
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${encodeURIComponent(latitude)}` +
      `&longitude=${encodeURIComponent(longitude)}` +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  };


  const loadWeather = async (
    card: HTMLElement
  ): Promise<void> => {

    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }


    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          "Weather API request failed"
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const current =
        data.current;


      const temperature =
        card.querySelector<HTMLElement>(
          ".weather-temperature"
        );

      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );

      const feels =
        card.querySelector<HTMLElement>(
          ".weather-feels"
        );

      const wind =
        card.querySelector<HTMLElement>(
          ".weather-wind"
        );

      const humidity =
        card.querySelector<HTMLElement>(
          ".weather-humidity"
        );

      const time =
        card.querySelector<HTMLElement>(
          ".weather-time"
        );

      const icon =
        card.querySelector<HTMLElement>(
          ".weather-icon"
        );


      if (temperature) {
        temperature.textContent =
          String(
            Math.round(
              current.temperature_2m
            )
          );
      }


      if (description) {
        description.textContent =
          getDescription(
            current.weather_code
          );
      }


      if (feels) {
        feels.textContent =
          `${Math.round(
            current.apparent_temperature
          )}°C`;
      }


      if (wind) {
        wind.textContent =
          `${Math.round(
            current.wind_speed_10m
          )} km/h`;
      }


      if (humidity) {
        humidity.textContent =
          `${current.relative_humidity_2m}%`;
      }


      if (time) {

        time.textContent =
          new Date(
            current.time
          ).toLocaleTimeString(
            "en-GB",
            {
              hour: "2-digit",
              minute: "2-digit",
            }
          );
      }


      if (icon) {
        icon.textContent =
          getIcon(
            current.weather_code
          );
      }

    } catch (error) {

      console.error(
        "Weather loading error:",
        error
      );


      const description =
        card.querySelector<HTMLElement>(
          ".weather-description"
        );


      if (description) {
        description.textContent =
          "Unable to load weather";
      }
    }
  };


  const weatherCards =
    document.querySelectorAll<HTMLElement>(
      ".weather-card"
    );


  weatherCards.forEach(
    (card) => {
      void loadWeather(card);
    }
  );


  /* ============================================================= */
  /* FORECAST */
  /* ============================================================= */

  const forecastContainer =
    document.querySelector<HTMLElement>(
      "#forecast-container"
    );


  const forecastButtons =
    document.querySelectorAll<HTMLButtonElement>(
      ".forecast-button"
    );


  const loadForecast = async (
    latitude: string,
    longitude: string
  ): Promise<void> => {

    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML =
      `<div class="forecast-loading">Loading forecast...</div>`;


    try {

      const response = await fetch(
        buildWeatherUrl(
          latitude,
          longitude
        )
      );


      if (!response.ok) {
        throw new Error(
          "Forecast API request failed"
        );
      }


      const data =
        (await response.json()) as WeatherResponse;


      const daily =
        data.daily;


      forecastContainer.innerHTML =
        "";


      daily.time.forEach(
        (
          date,
          index
        ) => {

          const item =
            document.createElement(
              "article"
            );


          item.className =
            "forecast-item";


          const day =
            document.createElement(
              "span"
            );


          day.className =
            "forecast-day";


          day.textContent =
            index === 0
              ? "Today"
              : formatDay(date);


          const weatherIcon =
            document.createElement(
              "span"
            );


          weatherIcon.className =
            "forecast-icon";


          weatherIcon.textContent =
            getIcon(
              daily.weather_code[index]
            );


          const temperatures =
            document.createElement(
              "div"
            );


          temperatures.className =
            "forecast-temperatures";


          const maximum =
            document.createElement(
              "span"
            );


          maximum.textContent =
            `${Math.round(
              daily.temperature_2m_max[index]
            )}°`;


          const minimum =
            document.createElement(
              "span"
            );


          minimum.className =
            "forecast-min";


          minimum.textContent =
            `${Math.round(
              daily.temperature_2m_min[index]
            )}°`;


          temperatures.append(
            maximum,
            minimum
          );


          item.append(
            day,
            weatherIcon,
            temperatures
          );


          forecastContainer.appendChild(
            item
          );
        }
      );

    } catch (error) {

      console.error(
        "Forecast loading error:",
        error
      );


      forecastContainer.innerHTML =
        `<div class="forecast-loading">
          Unable to load forecast.
        </div>`;
    }
  };


  const defaultForecast =
    forecastButtons[0]?.dataset
      .forecastLocation;


  if (defaultForecast) {

    const [
      latitude,
      longitude
    ] =
      defaultForecast.split(",");


    if (latitude && longitude) {
      void loadForecast(
        latitude,
        longitude
      );
    }
  }


  forecastButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          forecastButtons.forEach(
            (item) => {
              item.classList.remove(
                "active"
              );
            }
          );


          button.classList.add(
            "active"
          );


          const location =
            button.dataset
              .forecastLocation;


          if (!location) {
            return;
          }


          const [
            latitude,
            longitude
          ] =
            location.split(",");


          if (
            !latitude ||
            !longitude
          ) {
            return;
          }


          void loadForecast(
            latitude,
            longitude
          );
        }
      );
    }
  );
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE INTERACTIVE BACKGROUND -->
<!-- ============================================================= -->

<script>
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#weather-background"
    );


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        opacity: number;
      }


      const particles: Particle[] =
        [];


      let width = 0;
      let height = 0;


      let mouseX = 0;
      let mouseY = 0;


      let targetMouseX = 0;
      let targetMouseY = 0;


      let animationFrame = 0;


      const getParticleCount =
        (): number =>
          window.innerWidth < 768
            ? 38
            : 72;


      let particleCount =
        getParticleCount();


      const resize = (): void => {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;


        height =
          window.innerHeight;


        canvas.width =
          width * ratio;


        canvas.height =
          height * ratio;


        canvas.style.width =
          `${width}px`;


        canvas.style.height =
          `${height}px`;


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particleCount =
          getParticleCount();
      };


      const createParticle =
        (): Particle => {

          return {
            x:
              Math.random() *
              width,

            y:
              Math.random() *
              height,

            vx:
              (Math.random() - 0.5) *
              0.12,

            vy:
              (Math.random() - 0.5) *
              0.12,

            size:
              Math.random() *
              1.5 +
              0.35,

            opacity:
              Math.random() *
              0.35 +
              0.05,
          };
        };


      const initialize =
        (): void => {

          particles.length = 0;


          for (
            let index = 0;
            index < particleCount;
            index += 1
          ) {

            particles.push(
              createParticle()
            );
          }
        };


      const drawGrid =
        (): void => {

          const spacing = 72;


          const offsetX =
            (mouseX - width / 2) *
            0.018;


          const offsetY =
            (mouseY - height / 2) *
            0.018;


          context.save();


          context.strokeStyle =
            "rgba(0,170,255,0.045)";


          context.lineWidth = 1;


          for (
            let x =
              -spacing +
              (offsetX % spacing);

            x < width + spacing;

            x += spacing
          ) {

            context.beginPath();

            context.moveTo(
              x,
              0
            );

            context.lineTo(
              x,
              height
            );

            context.stroke();
          }


          for (
            let y =
              -spacing +
              (offsetY % spacing);

            y < height + spacing;

            y += spacing
          ) {

            context.beginPath();

            context.moveTo(
              0,
              y
            );

            context.lineTo(
              width,
              y
            );

            context.stroke();
          }


          context.restore();
        };


      const drawConnections =
        (): void => {

          const maxDistance = 125;


          for (
            let i = 0;
            i < particles.length;
            i += 1
          ) {

            for (
              let j = i + 1;
              j < particles.length;
              j += 1
            ) {

              const first =
                particles[i];

              const second =
                particles[j];


              if (!first || !second) {
                continue;
              }


              const dx =
                first.x -
                second.x;


              const dy =
                first.y -
                second.y;


              const distance =
                Math.sqrt(
                  dx * dx +
                  dy * dy
                );


              if (
                distance <
                maxDistance
              ) {

                const opacity =
                  (1 -
                    distance /
                      maxDistance) *
                  0.08;


                context.beginPath();


                context.moveTo(
                  first.x,
                  first.y
                );


                context.lineTo(
                  second.x,
                  second.y
                );


                context.strokeStyle =
                  `rgba(0,170,255,${opacity})`;


                context.lineWidth = 1;


                context.stroke();
              }
            }
          }
        };


      const drawParticles =
        (): void => {

          for (
            const particle of particles
          ) {

            particle.x +=
              particle.vx;


            particle.y +=
              particle.vy;


            if (
              particle.x <
              -10
            ) {

              particle.x =
                width + 10;
            }


            if (
              particle.x >
              width + 10
            ) {

              particle.x = -10;
            }


            if (
              particle.y <
              -10
            ) {

              particle.y =
                height + 10;
            }


            if (
              particle.y >
              height + 10
            ) {

              particle.y = -10;
            }


            const dx =
              targetMouseX -
              particle.x;


            const dy =
              targetMouseY -
              particle.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance <
              190
            ) {

              const force =
                (1 -
                  distance /
                    190) *
                0.006;


              particle.vx +=
                dx * force;


              particle.vy +=
                dy * force;
            }


            particle.vx *=
              0.995;


            particle.vy *=
              0.995;


            context.beginPath();


            context.arc(
              particle.x,
              particle.y,
              particle.size,
              0,
              Math.PI * 2
            );


            context.fillStyle =
              `rgba(0,190,255,${particle.opacity})`;


            context.fill();
          }
        };


      const drawMouseGlow =
        (): void => {

          const gradient =
            context.createRadialGradient(
              targetMouseX,
              targetMouseY,
              0,
              targetMouseX,
              targetMouseY,
              240
            );


          gradient.addColorStop(
            0,
            "rgba(0,170,255,0.075)"
          );


          gradient.addColorStop(
            0.45,
            "rgba(0,170,255,0.025)"
          );


          gradient.addColorStop(
            1,
            "rgba(0,170,255,0)"
          );


          context.fillStyle =
            gradient;


          context.fillRect(
            0,
            0,
            width,
            height
          );
        };


      const animate =
        (): void => {

          mouseX +=
            (targetMouseX -
              mouseX) *
            0.045;


          mouseY +=
            (targetMouseY -
              mouseY) *
            0.045;


          context.clearRect(
            0,
            0,
            width,
            height
          );


          drawMouseGlow();

          drawGrid();

          drawConnections();

          drawParticles();


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


      const handleResize =
        (): void => {

          resize();

          initialize();
        };


      const handleMouseMove =
        (
          event: MouseEvent
        ): void => {

          targetMouseX =
            event.clientX;


          targetMouseY =
            event.clientY;
        };


      const handleMouseLeave =
        (): void => {

          targetMouseX =
            width / 2;


          targetMouseY =
            height / 2;
        };


      window.addEventListener(
        "resize",
        handleResize
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        {
          passive: true,
        }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      resize();


      targetMouseX =
        width / 2;


      targetMouseY =
        height / 2;


      mouseX =
        width / 2;


      mouseY =
        height / 2;


      initialize();


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (!reducedMotion) {

        animationFrame =
          requestAnimationFrame(
            animate
          );

      } else {

        drawGrid();

        drawParticles();
      }


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            handleResize
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );
        }
      );
    }
  }
</script>


