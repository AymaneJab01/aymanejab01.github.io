<!-- STYLES -->

<!-- ============================================================= -->

<style>

  /* =========================================================== */
  /* BASE */
  /* =========================================================== */

  :global(html) {
    background: #f7f9fc;
  }


  :global(body) {
    margin: 0;
    background: #f7f9fc;
  }


  .weather-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 80% 5%,
        rgba(0, 145, 255, 0.08),
        transparent 28%
      ),
      #f7f9fc;
    color: #101828;
  }


  /* =========================================================== */
  /* HEADER */
  /* =========================================================== */

  .site-header {
    width: 100%;
    background: rgba(255, 255, 255, 0.88);
    border-bottom: 1px solid #e6ebf2;
    backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    z-index: 20;
  }


  .header-inner {
    width: min(1180px, calc(100% - 40px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #101828;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }


  .brand-mark {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #008cff;
    box-shadow:
      0 0 0 5px rgba(0, 140, 255, 0.1),
      0 0 18px rgba(0, 140, 255, 0.35);
  }


  .header-project {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #667085;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }


  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #008cff;
  }


  /* =========================================================== */
  /* CONTAINER */
  /* =========================================================== */

  .page-container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }


  /* =========================================================== */
  /* INTRO */
  /* =========================================================== */

  .intro {
    padding: 76px 0 34px;
  }


  .intro-label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #008cff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }


  .intro-line {
    width: 32px;
    height: 1px;
    background: #008cff;
  }


  .intro h1 {
    margin: 22px 0 0;
    max-width: 800px;
    color: #101828;
    font-size: clamp(3rem, 7vw, 6.3rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.065em;
  }


  .intro h1 span {
    display: block;
    color: #008cff;
  }


  .intro p {
    max-width: 620px;
    margin: 28px 0 0;
    color: #667085;
    font-size: 1rem;
    line-height: 1.8;
  }


  /* =========================================================== */
  /* LOCATION SWITCHER */
  /* =========================================================== */

  .location-switcher {
    display: inline-flex;
    padding: 5px;
    margin: 22px 0 22px;
    border: 1px solid #e1e7ef;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 5px 20px rgba(16, 24, 40, 0.04);
  }


  .location-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    border-radius: 999px;
    padding: 10px 18px;
    background: transparent;
    color: #667085;
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }


  .location-button:hover {
    color: #008cff;
  }


  .location-button.active {
    background: #008cff;
    color: #ffffff;
    box-shadow:
      0 5px 18px rgba(0, 140, 255, 0.25);
  }


  .location-button-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }


  /* =========================================================== */
  /* CURRENT WEATHER */
  /* =========================================================== */

  .current-weather {
    overflow: hidden;
    border: 1px solid #e1e7ef;
    border-radius: 24px;
    background: #ffffff;
    box-shadow:
      0 20px 60px rgba(16, 24, 40, 0.07);
  }


  .current-main {
    min-height: 370px;
    padding: 42px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    background:
      radial-gradient(
        circle at 85% 45%,
        rgba(0, 140, 255, 0.12),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #ffffff 0%,
        #fbfdff 100%
      );
  }


  .eyebrow {
    display: inline-block;
    color: #008cff;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .current-location h2 {
    margin: 10px 0 0;
    color: #101828;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }


  .current-region {
    margin: 5px 0 0;
    color: #667085;
    font-size: 0.95rem;
  }


  .current-updated {
    margin: 25px 0 0;
    color: #98a2b3;
    font-size: 0.72rem;
  }


  .current-condition {
    min-width: 330px;
    text-align: right;
  }


  .current-icon {
    color: #008cff;
    font-size: 4.8rem;
    line-height: 1;
    text-shadow:
      0 8px 28px rgba(0, 140, 255, 0.22);
  }


  .current-temperature {
    margin-top: 4px;
    color: #101828;
    font-size: clamp(5rem, 10vw, 8.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.09em;
  }


  .current-temperature sup {
    color: #008cff;
    font-size: 0.35em;
    vertical-align: top;
    position: relative;
    top: 0.15em;
    letter-spacing: -0.02em;
  }


  .current-description {
    margin-top: 16px;
    color: #475467;
    font-size: 1rem;
    font-weight: 600;
  }


  /* =========================================================== */
  /* METRICS */
  /* =========================================================== */

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
