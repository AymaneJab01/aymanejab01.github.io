          <div class="weather-card-main">

            <div class="weather-card-top">

              <div>

                <div class="location-kicker">
                  CURRENT CONDITIONS
                </div>

                <h2 class="location-title">
                  Alcoi<span>.</span>
                </h2>

                <p class="location-region">
                  Alicante, Valencian Community
