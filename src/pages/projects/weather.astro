      </div>

    </section>


    <!-- ===================================================== -->
    <!-- BACK -->
    <!-- ===================================================== -->

    <div class="back-section">

      <a
        href="/#projects"
        class="back-link"
      >
        <span>←</span>
        <span>Back to projects</span>
      </a>

    </div>

  </div>

</section>
```

