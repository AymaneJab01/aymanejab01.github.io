---
interface WeatherLocation {
  name: string;
  region: string;
  latitude: number;
  longitude: number;
}

interface WeatherCurrent { 
  temperature_2m: number;
  apparent_temperature: number;
  relative_humidity_2m: number;
  wind_speed_10m: number;
  surface_pressure: number;
  visibility: number;
  weather_code: number;
}

interface WeatherHourly {
  time: string[];
  temperature_2m: number[];
  precipitation_probability: number[];
  weather_code: number[];
}

interface WeatherDaily {
  time: string[];
  weather_code: number[];
  temperature_2m_max: number[];
  temperature_2m_min: number[];
  precipitation_probability_max: number[];
  sunrise: string[];
  sunset: string[];
}

interface WeatherResponse {
  current: WeatherCurrent;
  hourly: WeatherHourly;
  daily: WeatherDaily;
}

const locations: Record<string, WeatherLocation> = {
  Alcoi: {
    name: "Alcoi",
    region: "Alicante, España",
    latitude: 38.6986,
    longitude: -0.4731,
  },

  Torrevieja: {
    name: "Torrevieja",
    region: "Alicante, España",
    latitude: 37.978,
    longitude: -0.682,
  },

  Valencia: {
    name: "Valencia",
    region: "Valencia, España",
    latitude: 39.4699,
    longitude: -0.3763,
  },
};

const defaultLocation = "Alcoi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Weather Dashboard</title>

    <meta
      name="description"
      content="Interactive weather dashboard for Alcoi, Torrevieja and Valencia."
    />

    <link rel="icon" type="image/png" href="/icon.png" />
  </head>

  <body>
    <main class="weather-page">
      <!-- HEADER -->
      <header class="weather-header">
        <div class="header-inner">
          <a href="/" class="back-link">
            ← Portfolio
          </a>

          <div class="header-title">
            <span class="status-dot"></span>
            <span>WEATHER</span>
          </div>

          <div
            class="header-status"
            id="header-status"
          >
            Live data
          </div>
        </div>
      </header>

      <div class="weather-container">
        <!-- LOCATION TABS -->
        <nav
          class="location-tabs"
          aria-label="Weather locations"
        >
          {
            Object.values(locations).map((location) => (
              <button
                class:list={[
                  "location-tab",
                  location.name === defaultLocation && "active",
                ]}
                data-location={location.name}
                type="button"
              >
                <span>{location.name}</span>
                <small>{location.region}</small>
              </button>
            ))
          }
        </nav>

        <!-- LOCATION HEADING -->
        <section class="location-heading">
          <div>
            <p class="eyebrow">CURRENT CONDITIONS</p>

            <h1 id="location-name">
              {locations[defaultLocation].name}
            </h1>

            <p id="location-region">
              {locations[defaultLocation].region}
            </p>
          </div>

          <div class="last-updated">
            <span>LAST UPDATED</span>
            <strong id="last-updated">—</strong>
          </div>
        </section>

        <!-- CURRENT WEATHER -->
        <section
          class="hero-weather"
          aria-live="polite"
        >
          <div class="hero-main">
            <div class="weather-icon-container">
              <div
                class="weather-icon"
                id="weather-icon"
              >
                ☀️
              </div>
            </div>

            <div class="hero-temperature">
              <div
                class="temperature"
                id="temperature"
              >
                —°
              </div>

              <div class="feels-like">
                Feels like
                <strong id="feels-like">—°</strong>
              </div>
            </div>

            <div class="hero-description">
              <h2 id="description">
                Loading...
              </h2>

              <p>
                Humidity
                <strong id="hero-humidity">—%</strong>
              </p>
            </div>
          </div>

          <div class="hero-side">
            <div class="metric">
              <span class="metric-label">
                WIND
              </span>

              <strong id="wind">
                — km/h
              </strong>
            </div>

            <div class="metric">
              <span class="metric-label">
                PRESSURE
              </span>

              <strong id="pressure">
                — hPa
              </strong>
            </div>

            <div class="metric">
              <span class="metric-label">
                VISIBILITY
              </span>

              <strong id="visibility">
                — km
              </strong>
            </div>
          </div>
        </section>

        <!-- HOURLY -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                NEXT 24 HOURS
              </p>

              <h2>Hourly forecast</h2>
            </div>
          </div>

          <div class="hourly-wrapper">
            <button
              class="forecast-arrow"
              id="hourly-prev"
              type="button"
              aria-label="Previous hours"
            >
              ←
            </button>

            <div
              class="hourly-scroll"
              id="hourly-container"
            ></div>

            <button
              class="forecast-arrow"
              id="hourly-next"
              type="button"
              aria-label="Next hours"
            >
              →
            </button>
          </div>
        </section>

        <!-- DAILY -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                UPCOMING
              </p>

              <h2>7-day forecast</h2>
            </div>
          </div>

          <div
            class="daily-container"
            id="daily-container"
          ></div>
        </section>

        <!-- DETAILS -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                ADDITIONAL DATA
              </p>

              <h2>Weather details</h2>
            </div>
          </div>

          <div class="details-grid">
            <article class="detail-card">
              <span class="detail-icon">💧</span>

              <div>
                <span class="detail-label">
                  Humidity
                </span>

                <strong id="humidity">
                  —%
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">💨</span>

              <div>
                <span class="detail-label">
                  Wind speed
                </span>

                <strong id="wind-detail">
                  — km/h
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌡️</span>

              <div>
                <span class="detail-label">
                  Feels like
                </span>

                <strong id="feels-detail">
                  —°C
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🔵</span>

              <div>
                <span class="detail-label">
                  Pressure
                </span>

                <strong id="pressure-detail">
                  — hPa
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">👁️</span>

              <div>
                <span class="detail-label">
                  Visibility
                </span>

                <strong id="visibility-detail">
                  — km
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌧️</span>

              <div>
                <span class="detail-label">
                  Rain probability
                </span>

                <strong id="rain-detail">
                  —%
                </strong>
              </div>
            </article>
          </div>
        </section>

        <!-- SUN -->
        <section class="weather-section sun-section">
          <div class="sun-card">
            <div>
              <span class="sun-label">
                SUNRISE
              </span>

              <strong id="sunrise">—</strong>
            </div>

            <div class="sun-line">
              <span class="sun-ball"></span>
            </div>

            <div>
              <span class="sun-label">
                SUNSET
              </span>

              <strong id="sunset">—</strong>
            </div>
          </div>
        </section>

        <!-- FOOTER -->
        <footer class="weather-footer">
          <span>
            Weather data powered by Open-Meteo
          </span>

          <span>•</span>

          <span id="footer-location">
            {defaultLocation}
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script>
  type LocationData = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  type WeatherCurrentData = {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    wind_speed_10m: number;
    surface_pressure: number;
    visibility: number;
    weather_code: number;
  };

  type WeatherHourlyData = {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  };

  type WeatherDailyData = {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  };

  type WeatherData = {
    current: WeatherCurrentData;
    hourly: WeatherHourlyData;
    daily: WeatherDailyData;
  };

  const locations: Record<string, LocationData> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let selectedLocation = "Alcoi";
  let weatherData: WeatherData | null = null;

  /*
   * This represents the first hour currently displayed.
   * We keep the real "current hour" separately so
   * navigation does not incorrectly label another hour
   * as NOW.
   */
  let hourlyStartIndex = 0;
  let currentHourIndex = 0;

  const getElement = <T extends HTMLElement>(
    id: string,
  ): T | null => {
    return document.getElementById(id) as T | null;
  };

  function getWeatherIcon(
    code: number,
    isNight = false,
  ): string {
    if (isNight) {
      if (code === 0) return "🌙";

      if (
        code === 1 ||
        code === 2 ||
        code === 3
      ) {
        return "☁️";
      }
    }

    if (code === 0) return "☀️";
    if (code === 1) return "🌤️";
    if (code === 2) return "⛅";
    if (code === 3) return "☁️";

    if (code === 45 || code === 48) {
      return "🌫️";
    }

    if (code >= 51 && code <= 57) {
      return "🌦️";
    }

    if (code >= 61 && code <= 67) {
      return "🌧️";
    }

    if (code >= 71 && code <= 77) {
      return "❄️";
    }

    if (code >= 80 && code <= 82) {
      return "🌦️";
    }

    if (code >= 85 && code <= 86) {
      return "🌨️";
    }

    if (code >= 95 && code <= 99) {
      return "⛈️";
    }

    return "🌤️";
  }

  function getWeatherDescription(
    code: number,
  ): string {
    if (code === 0) return "Clear sky";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Overcast";

    if (code === 45 || code === 48) {
      return "Fog";
    }

    if (code >= 51 && code <= 57) {
      return "Drizzle";
    }

    if (code >= 61 && code <= 67) {
      return "Rain";
    }

    if (code >= 71 && code <= 77) {
      return "Snow";
    }

    if (code >= 80 && code <= 82) {
      return "Rain showers";
    }

    if (code >= 85 && code <= 86) {
      return "Snow showers";
    }

    if (code >= 95 && code <= 99) {
      return "Thunderstorm";
    }

    return "Unknown conditions";
  }

  function formatHour(
    value: string,
  ): string {
    const date = new Date(value);

    return date.toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }

  function formatDay(
    value: string,
    index: number,
  ): string {
    if (index === 0) {
      return "Today";
    }

    const date = new Date(
      `${value}T12:00:00`,
    );

    return date.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      },
    );
  }

  function formatDateTime(): string {
    return new Date().toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }

  function getIsNight(
    time: string,
    sunrise: string,
    sunset: string,
  ): boolean {
    const current = new Date(time).getTime();
    const rise = new Date(sunrise).getTime();
    const set = new Date(sunset).getTime();

    return current < rise || current > set;
  }

  function updateElement(
    id: string,
    value: string,
  ): void {
    const element =
      document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }

  function renderCurrent(
    data: WeatherData,
  ): void {
    const location =
      locations[selectedLocation];

    const current = data.current;

    const todaySunrise =
      data.daily.sunrise[0];

    const todaySunset =
      data.daily.sunset[0];

    const isNight = getIsNight(
      new Date().toISOString(),
      todaySunrise,
      todaySunset,
    );

    updateElement(
      "location-name",
      location.name,
    );

    updateElement(
      "location-region",
      location.region,
    );

    updateElement(
      "footer-location",
      location.name,
    );

    updateElement(
      "temperature",
      `${Math.round(
        current.temperature_2m,
      )}°`,
    );

    updateElement(
      "feels-like",
      `${Math.round(
        current.apparent_temperature,
      )}°`,
    );

    updateElement(
      "description",
      getWeatherDescription(
        current.weather_code,
      ),
    );

    updateElement(
      "weather-icon",
      getWeatherIcon(
        current.weather_code,
        isNight,
      ),
    );

    updateElement(
      "humidity",
      `${Math.round(
        current.relative_humidity_2m,
      )}%`,
    );

    updateElement(
      "hero-humidity",
      `${Math.round(
        current.relative_humidity_2m,
      )}%`,
    );

    updateElement(
      "wind",
      `${Math.round(
        current.wind_speed_10m,
      )} km/h`,
    );

    updateElement(
      "wind-detail",
      `${Math.round(
        current.wind_speed_10m,
      )} km/h`,
    );

    updateElement(
      "pressure",
      `${Math.round(
        current.surface_pressure,
      )} hPa`,
    );

    updateElement(
      "pressure-detail",
      `${Math.round(
        current.surface_pressure,
      )} hPa`,
    );

    updateElement(
      "visibility",
      `${Math.round(
        current.visibility / 1000,
      )} km`,
    );

    updateElement(
      "visibility-detail",
      `${Math.round(
        current.visibility / 1000,
      )} km`,
    );

    updateElement(
      "feels-detail",
      `${Math.round(
        current.apparent_temperature,
      )}°C`,
    );

    updateElement(
      "rain-detail",
      `${data.daily
        .precipitation_probability_max[0] ?? 0}%`,
    );

    updateElement(
      "sunrise",
      formatHour(todaySunrise),
    );

    updateElement(
      "sunset",
      formatHour(todaySunset),
    );

    updateElement(
      "last-updated",
      formatDateTime(),
    );
  }

  function createHourlyCard(
    data: WeatherData,
    index: number,
  ): HTMLElement {
    const time =
      data.hourly.time[index];

    const temperature =
      data.hourly.temperature_2m[index] ?? 0;

    const rain =
      data.hourly
        .precipitation_probability[index] ?? 0;

    const code =
      data.hourly.weather_code[index] ?? 0;

    const item =
      document.createElement("article");

    item.className =
      index === currentHourIndex
        ? "hour-card current"
        : "hour-card";

    const timeLabel =
      index === currentHourIndex
        ? "NOW"
        : formatHour(time);

    item.innerHTML = `
      <span class="hour-time">
        ${timeLabel}
      </span>

      <span class="hour-icon">
        ${getWeatherIcon(code)}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;

    return item;
  }

  function renderHourly(
    data: WeatherData,
  ): void {
    const container =
      getElement<HTMLDivElement>(
        "hourly-container",
      );

    if (!container) return;

    const endIndex = Math.min(
      hourlyStartIndex + 12,
      data.hourly.time.length,
    );

    container.innerHTML = "";

    for (
      let i = hourlyStartIndex;
      i < endIndex;
      i += 1
    ) {
      container.appendChild(
        createHourlyCard(data, i),
      );
    }

    updateHourlyButtons();
  }

  function updateHourlyButtons(): void {
    const previousButton =
      getElement<HTMLButtonElement>(
        "hourly-prev",
      );

    const nextButton =
      getElement<HTMLButtonElement>(
        "hourly-next",
      );

    if (!weatherData) {
      if (previousButton) {
        previousButton.disabled = true;
      }

      if (nextButton) {
        nextButton.disabled = true;
      }

      return;
    }

    const maxStart = Math.max(
      0,
      weatherData.hourly.time.length - 12,
    );

    if (previousButton) {
      previousButton.disabled =
        hourlyStartIndex <= 0;
    }

    if (nextButton) {
      nextButton.disabled =
        hourlyStartIndex >= maxStart;
    }
  }

  function renderDaily(
    data: WeatherData,
  ): void {
    const container =
      getElement<HTMLDivElement>(
        "daily-container",
      );

    if (!container) return;

    container.innerHTML = "";

    const days = Math.min(
      data.daily.time.length,
      7,
    );

    for (
      let i = 0;
      i < days;
      i += 1
    ) {
      const day =
        data.daily.time[i];

      const code =
        data.daily.weather_code[i] ?? 0;

      const high =
        data.daily.temperature_2m_max[i] ?? 0;

      const low =
        data.daily.temperature_2m_min[i] ?? 0;

      const rain =
        data.daily
          .precipitation_probability_max[i] ?? 0;

      const row =
        document.createElement("article");

      row.className = "daily-row";

      row.innerHTML = `
        <div class="daily-day">
          ${formatDay(day, i)}
        </div>

        <div class="daily-icon">
          ${getWeatherIcon(code)}
        </div>

        <div class="daily-condition">
          <strong>
            ${getWeatherDescription(code)}
          </strong>

          <span>
            ${rain}% rain
          </span>
        </div>

        <div class="daily-temperatures">
          <strong>
            ${Math.round(high)}°
          </strong>

          <span>
            ${Math.round(low)}°
          </span>
        </div>
      `;

      container.appendChild(row);
    }
  }

  function setLoadingState(): void {
    updateElement(
      "header-status",
      "Loading...",
    );

    updateElement(
      "description",
      "Loading weather...",
    );
  }

  function setErrorState(
    message: string,
  ): void {
    updateElement(
      "header-status",
      "Offline",
    );

    updateElement(
      "description",
      message,
    );

    updateElement(
      "last-updated",
      "Error",
    );
  }

  async function fetchWeather(
    location: LocationData,
  ): Promise<WeatherData> {
    const url =
      "https://api.open-meteo.com/v1/forecast" +
      `?latitude=${location.latitude}` +
      `&longitude=${location.longitude}` +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,surface_pressure,visibility,weather_code" +
      "&hourly=temperature_2m,precipitation_probability,weather_code" +
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset" +
      "&timezone=auto" +
      "&forecast_days=7";

    const response =
      await fetch(url);

    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`,
      );
    }

    return (await response.json()) as WeatherData;
  }

  async function loadWeather(
    locationName: string,
  ): Promise<void> {
    const location =
      locations[locationName];

    if (!location) return;

    selectedLocation =
      locationName;

    weatherData = null;
    hourlyStartIndex = 0;
    currentHourIndex = 0;

    setLoadingState();

    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-tab",
      )
      .forEach((button) => {
        button.classList.toggle(
          "active",
          button.dataset.location ===
            locationName,
        );
      });

    try {
      const response =
        await fetchWeather(location);

      weatherData = response;

      /*
       * Find the first forecast hour that is
       * equal to or later than the current time.
       */
      const now = new Date();

      const foundIndex =
        response.hourly.time.findIndex(
          (time) =>
            new Date(time).getTime() >=
            now.getTime(),
        );

      currentHourIndex =
        foundIndex >= 0
          ? foundIndex
          : 0;

      hourlyStartIndex =
        currentHourIndex;

      renderCurrent(response);
      renderHourly(response);
      renderDaily(response);

      updateElement(
        "header-status",
        "Live data",
      );
    } catch (error) {
      console.error(
        "Weather loading error:",
        error,
      );

      setErrorState(
        "Unable to load weather data.",
      );
    }
  }

  /*
   * Location buttons
   */
  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-tab",
    )
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const locationName =
            button.dataset.location;

          if (!locationName) return;

          void loadWeather(
            locationName,
          );
        },
      );
    });

  /*
   * Previous hourly forecast
   */
  getElement<HTMLButtonElement>(
    "hourly-prev",
  )?.addEventListener(
    "click",
    () => {
      if (!weatherData) return;

      hourlyStartIndex =
        Math.max(
          0,
          hourlyStartIndex - 6,
        );

      renderHourly(weatherData);
    },
  );

  /*
   * Next hourly forecast
   */
  getElement<HTMLButtonElement>(
    "hourly-next",
  )?.addEventListener(
    "click",
    () => {
      if (!weatherData) return;

      const maxStart =
        Math.max(
          0,
          weatherData.hourly.time.length -
            12,
        );

      hourlyStartIndex =
        Math.min(
          maxStart,
          hourlyStartIndex + 6,
        );

      renderHourly(weatherData);
    },
  );

  /*
   * Initial weather request
   */
  void loadWeather("Alcoi");
</script>

<style>
  :global(html) {
    background: #101010;
  }

  :global(body) {
    margin: 0;
    background: #101010;
    color: #dfdfdf;
  }

  .weather-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 20% 0%,
        rgba(164, 118, 255, 0.09),
        transparent 32rem
      ),
      #101010;
    color: #dfdfdf;
  }

  .weather-header {
    border-bottom: 1px solid
      rgba(255, 255, 255, 0.08);

    background: rgba(16, 16, 16, 0.88);

    backdrop-filter: blur(18px);

    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner,
  .weather-container {
    width: min(
      100% - 28px,
      1200px
    );

    margin-inline: auto;
  }

  .header-inner {
    min-height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .back-link {
    color: #a476ff;

    text-decoration: none;

    font-size: 0.78rem;
    font-weight: 700;

    letter-spacing: 0.08em;
    text-transform: uppercase;

    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  .header-title {
    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 0.78rem;
    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #a476ff;

    box-shadow:
      0 0 12px
      rgba(164, 118, 255, 0.8);
  }

  .header-status {
    color: rgba(
      223,
      223,
      223,
      0.5
    );

    font-size: 0.7rem;
  }

  .weather-container {
    padding-top: 35px;
    padding-bottom: 70px;
  }

  .location-tabs {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 8px;
  }

  .location-tab {
    min-height: 65px;

    border: 1px solid
      rgba(255, 255, 255, 0.09);

    border-radius: 14px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );

    color: #dfdfdf;

    cursor: pointer;

    padding: 12px 16px;

    display: flex;
    flex-direction: column;

    align-items: flex-start;
    justify-content: center;

    gap: 5px;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .location-tab:hover {
    transform: translateY(-1px);

    border-color:
      rgba(164, 118, 255, 0.4);
  }

  .location-tab.active {
    border-color:
      rgba(164, 118, 255, 0.65);

    background:
      rgba(164, 118, 255, 0.1);
  }

  .location-tab span {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .location-tab small {
    color: rgba(
      223,
      223,
      223,
      0.45
    );

    font-size: 0.65rem;
  }

  .location-heading {
    margin-top: 45px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;
  }

  .eyebrow {
    margin: 0 0 8px;

    color: #a476ff;

    font-size: 0.65rem;
    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .location-heading h1 {
    margin: 0;

    font-size: clamp(
      2.6rem,
      6vw,
      4.8rem
    );

    line-height: 0.95;

    letter-spacing: -0.06em;
  }

  #location-region {
    margin-top: 12px;

    color: rgba(
      223,
      223,
      223,
      0.45
    );

    font-size: 0.8rem;
  }

  .last-updated {
    display: flex;
    flex-direction: column;

    align-items: flex-end;

    gap: 5px;

    color: rgba(
      223,
      223,
      223,
      0.4
    );

    font-size: 0.6rem;

    letter-spacing: 0.12em;
  }

  .last-updated strong {
    color: #dfdfdf;

    font-size: 0.8rem;

    letter-spacing: 0;
  }

  .hero-weather {
    margin-top: 45px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      240px;

    gap: 25px;
  }

  .hero-main,
  .hero-side {
    border: 1px solid
      rgba(255, 255, 255, 0.08);

    border-radius: 22px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );
  }

  .hero-main {
    min-height: 310px;

    padding: 40px 35px;

    display: flex;
    align-items: center;

    gap: 30px;
  }

  .weather-icon-container {
    width: 100px;
    height: 100px;

    flex: 0 0 100px;

    display: grid;
    place-items: center;
  }

  .weather-icon {
    font-size: 5.4rem;

    line-height: 1;

    filter:
      drop-shadow(
        0 10px 25px
        rgba(164, 118, 255, 0.15)
      );
  }

  .hero-temperature {
    min-width: 170px;
  }

  .temperature {
    font-size: clamp(
      3.6rem,
      8vw,
      6.5rem
    );

    font-weight: 700;

    letter-spacing: -0.08em;

    line-height: 0.9;
  }

  .feels-like {
    margin-top: 12px;

    color: rgba(
      223,
      223,
      223,
      0.45
    );

    font-size: 0.75rem;
  }

  .feels-like strong {
    color: #dfdfdf;
  }

  .hero-description {
    margin-left: auto;
  }

  .hero-description h2 {
    margin: 0;

    font-size: 1.15rem;

    font-weight: 600;
  }

  .hero-description p {
    margin-top: 9px;

    color: rgba(
      223,
      223,
      223,
      0.45
    );

    font-size: 0.72rem;
  }

  .hero-description strong {
    color: #dfdfdf;
  }

  .hero-side {
    padding: 30px 25px;

    display: flex;
    flex-direction: column;

    justify-content: center;

    gap: 30px;
  }

  .metric {
    display: flex;
    flex-direction: column;

    gap: 7px;
  }

  .metric-label,
  .detail-label,
  .sun-label {
    color: rgba(
      223,
      223,
      223,
      0.38
    );

    font-size: 0.62rem;

    font-weight: 700;

    letter-spacing: 0.12em;
  }

  .metric strong {
    font-size: 1rem;
  }

  .weather-section {
    margin-top: 60px;
  }

  .section-heading {
    display: flex;

    justify-content: space-between;
    align-items: flex-end;

    margin-bottom: 18px;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 1.6rem;

    letter-spacing: -0.04em;
  }

  .hourly-wrapper {
    display: grid;

    grid-template-columns:
      40px
      minmax(0, 1fr)
      40px;

    gap: 8px;

    align-items: stretch;
  }

  .hourly-scroll {
    display: flex;

    gap: 8px;

    overflow-x: auto;

    scrollbar-width: none;

    scroll-behavior: smooth;
  }

  .hourly-scroll::-webkit-scrollbar {
    display: none;
  }

  .forecast-arrow {
    border: 1px solid
      rgba(255, 255, 255, 0.08);

    border-radius: 12px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );

    color: #dfdfdf;

    cursor: pointer;

    font-size: 1.1rem;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .forecast-arrow:hover:not(:disabled) {
    background:
      rgba(164, 118, 255, 0.1);

    border-color:
      rgba(164, 118, 255, 0.45);
  }

  .forecast-arrow:disabled {
    cursor: not-allowed;
    opacity: 0.25;
  }

  .hour-card {
    min-width: 120px;

    padding: 16px 12px;

    border: 1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 15px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 9px;
  }

  .hour-card.current {
    border-color:
      rgba(164, 118, 255, 0.5);

    background:
      rgba(164, 118, 255, 0.08);
  }

  .hour-time {
    color: rgba(
      223,
      223,
      223,
      0.5
    );

    font-size: 0.62rem;

    font-weight: 700;
  }

  .hour-icon {
    font-size: 1.7rem;
  }

  .hour-temperature {
    font-size: 1.2rem;
  }

  .hour-rain {
    color: rgba(
      164,
      118,
      255,
      0.9
    );

    font-size: 0.58rem;
  }

  .daily-container {
    border: 1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 18px;

    overflow: hidden;
  }

  .daily-row {
    min-height: 100px;

    padding: 13px 18px;

    display: grid;

    grid-template-columns:
      70px
      50px
      1fr
      auto;

    gap: 15px;

    align-items: center;

    border-bottom: 1px solid
      rgba(255, 255, 255, 0.06);

    background: rgba(
      255,
      255,
      255,
      0.02
    );
  }

  .daily-row:last-child {
    border-bottom: 0;
  }

  .daily-day {
    font-size: 0.72rem;
    font-weight: 700;
  }

  .daily-icon {
    font-size: 1.8rem;
  }

  .daily-condition {
    display: flex;
    flex-direction: column;

    gap: 5px;
  }

  .daily-condition strong {
    font-size: 0.78rem;
  }

  .daily-condition span {
    color: rgba(
      164,
      118,
      255,
      0.8
    );

    font-size: 0.62rem;
  }

  .daily-temperatures {
    display: flex;

    gap: 12px;

    align-items: center;
  }

  .daily-temperatures strong {
    font-size: 1rem;
  }

  .daily-temperatures span {
    color: rgba(
      223,
      223,
      223,
      0.35
    );

    font-size: 0.85rem;
  }

  .details-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 10px;
  }

  .detail-card {
    min-height: 125px;

    padding: 22px;

    border: 1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 16px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );

    display: flex;

    align-items: center;

    gap: 15px;
  }

  .detail-icon {
    font-size: 1.7rem;
  }

  .detail-card div {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }

  .detail-card strong {
    font-size: 1rem;
  }

  .sun-card {
    min-height: 120px;

    padding: 25px;

    border: 1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 18px;

    background: rgba(
      255,
      255,
      255,
      0.025
    );

    display: grid;

    grid-template-columns:
      auto
      1fr
      auto;

    gap: 25px;

    align-items: center;
  }

  .sun-card > div:not(.sun-line) {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }

  .sun-line {
    height: 1px;

    background: linear-gradient(
      90deg,
      rgba(164, 118, 255, 0.15),
      rgba(164, 118, 255, 0.8),
      rgba(164, 118, 255, 0.15)
    );

    position: relative;
  }

  .sun-ball {
    position: absolute;

    width: 14px;
    height: 14px;

    border-radius: 50%;

    background: #a476ff;

    box-shadow:
      0 0 18px
      rgba(164, 118, 255, 0.8);

    left: 50%;
    top: 50%;

    transform:
      translate(-50%, -50%);
  }

  .weather-footer {
    margin-top: 65px;

    padding-top: 25px;

    border-top: 1px solid
      rgba(255, 255, 255, 0.07);

    display: flex;

    justify-content: center;

    gap: 10px;

    color: rgba(
      223,
      223,
      223,
      0.3
    );

    font-size: 0.62rem;
  }

  @media (max-width: 850px) {
    .hero-weather {
      grid-template-columns: 1fr;
    }

    .hero-side {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);
    }

    .details-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .header-inner,
    .weather-container {
      width: min(
        100% - 20px,
        1200px
      );
    }

    .header-status {
      display: none;
    }

    .location-tabs {
      grid-template-columns: 1fr;
    }

    .location-heading {
      align-items: flex-start;

      flex-direction: column;
    }

    .last-updated {
      align-items: flex-start;
    }

    .hero-main {
      padding: 30px 20px;

      flex-direction: column;

      align-items: flex-start;
    }

    .weather-icon-container {
      width: 75px;
      height: 75px;

      flex-basis: 75px;
    }

    .weather-icon {
      font-size: 4rem;
    }

    .hero-description {
      margin-left: 0;
    }

    .hero-side {
      grid-template-columns: 1fr;

      gap: 18px;
    }

    .daily-row {
      grid-template-columns:
        55px
        38px
        1fr;
    }

    .daily-temperatures {
      grid-column: 3;

      justify-content: flex-start;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }

    .sun-card {
      grid-template-columns: 1fr;

      text-align: center;
    }

    .sun-card > div:not(.sun-line) {
      align-items: center;
    }

    .sun-line {
      width: 100%;
    }

    .weather-footer {
      flex-wrap: wrap;
    }
  }
</style>