---
const locations = {
  Alcoi: {
    label: "Alcoi",
    region: "Alicante, España",
    latitude: 38.6986,
    longitude: -0.4731,
  },
  Torrevieja: {
    label: "Torrevieja",
    region: "Alicante, España",
    latitude: 37.978,
    longitude: -0.682,
  },
  Valencia: {
    label: "Valencia",
    region: "Valencia, España",
    latitude: 39.4699,
    longitude: -0.3763,
  },
} as const;

const defaultLocation = "Alcoi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Weather | Aymane Jabrane</title>

    <meta
      name="description"
      content="Live weather dashboard for Alcoi, Torrevieja and Valencia."
    />
  </head>

  <body>
    <main class="weather-page">
      <!-- HEADER -->
      <header class="weather-header">
        <div class="header-inner">
          <a
            class="brand"
            href="/"
            aria-label="Return to portfolio"
          >
            <span class="brand-mark">AJ</span>

            <span class="brand-copy">
              <strong>WEATHER</strong>
              <span>AYMANE JABRANE</span>
            </span>
          </a>

          <div class="header-status">
            <span class="status-dot"></span>
            <span id="header-status">Live data</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <div class="weather-container">
        <!-- LOCATION -->
        <section class="location-section">
          <div class="location-heading-copy">
            <p class="eyebrow">LOCAL WEATHER</p>

            <h1 id="location-name">
              Alcoi
            </h1>

            <p id="location-region">
              Alicante, España
            </p>
          </div>

          <div
            class="location-buttons"
            aria-label="Select location"
          >
            {
              Object.entries(locations).map(
                ([key, location]) => (
                  <button
                    type="button"
                    class={`location-button ${
                      key === defaultLocation
                        ? "active"
                        : ""
                    }`}
                    data-location={key}
                  >
                    {location.label}
                  </button>
                )
              )
            }
          </div>
        </section>

        <!-- CURRENT WEATHER -->
        <section class="hero-weather">
          <div class="hero-main">
            <div
              class="hero-icon"
              id="hero-icon"
              aria-hidden="true"
            >
              ☀
            </div>

            <div class="hero-temperature">
              <span id="temperature">
                --
              </span>

              <span class="degree">°</span>
            </div>

            <div class="hero-description">
              <strong id="condition">
                Loading weather...
              </strong>

              <span id="feels-like">
                Feels like --°
              </span>
            </div>
          </div>

          <div class="hero-side">
            <div class="hero-side-item">
              <span class="metric-label">
                HUMIDITY
              </span>

              <strong id="hero-humidity">
                --%
              </strong>
            </div>

            <div class="hero-side-item">
              <span class="metric-label">
                WIND
              </span>

              <strong id="wind">
                -- km/h
              </strong>
            </div>

            <div class="hero-side-item">
              <span class="metric-label">
                PRESSURE
              </span>

              <strong id="pressure">
                -- hPa
              </strong>
            </div>
          </div>
        </section>

        <!-- HOURLY -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">FORECAST</p>

              <h2>Hourly weather</h2>
            </div>

            <div class="hourly-controls">
              <button
                type="button"
                id="hourly-prev"
                class="control-button"
                aria-label="Previous hours"
              >
                ‹
              </button>

              <button
                type="button"
                id="hourly-next"
                class="control-button"
                aria-label="Next hours"
              >
                ›
              </button>
            </div>
          </div>

          <div class="hourly-wrapper">
            <div
              id="hourly-container"
              class="hourly-grid"
            >
              <div class="loading-card">
                Loading hourly forecast...
              </div>
            </div>
          </div>
        </section>

        <!-- DAILY -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">NEXT DAYS</p>

              <h2>10-day forecast</h2>
            </div>
          </div>

          <div
            id="daily-container"
            class="daily-grid"
          >
            <div class="loading-card">
              Loading daily forecast...
            </div>
          </div>
        </section>

        <!-- DETAILS -->
        <section class="weather-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                CURRENT CONDITIONS
              </p>

              <h2>Weather details</h2>
            </div>
          </div>

          <div class="details-grid">
            <article class="detail-card">
              <span class="detail-icon">💧</span>

              <div>
                <span class="detail-label">
                  Humidity
                </span>

                <strong id="humidity">
                  --%
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">💨</span>

              <div>
                <span class="detail-label">
                  Wind
                </span>

                <strong id="wind-detail">
                  -- km/h
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">◉</span>

              <div>
                <span class="detail-label">
                  Pressure
                </span>

                <strong id="pressure-detail">
                  -- hPa
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">👁</span>

              <div>
                <span class="detail-label">
                  Visibility
                </span>

                <strong id="visibility">
                  -- km
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌅</span>

              <div>
                <span class="detail-label">
                  Sunrise
                </span>

                <strong id="sunrise">
                  --:--
                </strong>
              </div>
            </article>

            <article class="detail-card">
              <span class="detail-icon">🌇</span>

              <div>
                <span class="detail-label">
                  Sunset
                </span>

                <strong id="sunset">
                  --:--
                </strong>
              </div>
            </article>
          </div>
        </section>

        <!-- FOOTER -->
        <footer class="weather-footer">
          <div>
            <span>Weather data provided by</span>

            <strong>Open-Meteo</strong>
          </div>

          <span id="last-updated">
            Updating...
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script lang="ts">
  type LocationName =
    | "Alcoi"
    | "Torrevieja"
    | "Valencia";

  interface WeatherLocation {
    label: string;
    region: string;
    latitude: number;
    longitude: number;
  }

  interface WeatherCurrent {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    precipitation: number;
    weather_code: number;
    surface_pressure: number;
    wind_speed_10m: number;
    is_day: number;
    visibility: number;
  }

  interface WeatherHourly {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  }

  interface WeatherDaily {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  }

  interface WeatherApiResponse {
    current: WeatherCurrent;
    hourly: WeatherHourly;
    daily: WeatherDaily;
  }

  const weatherLocations: Record<
    LocationName,
    WeatherLocation
  > = {
    Alcoi: {
      label: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      label: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      label: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };

  let currentLocation: LocationName = "Alcoi";

  let currentData: WeatherApiResponse | null = null;

  let hourlyStartIndex = 0;

  const getElement = (
    id: string
  ): HTMLElement | null =>
    document.getElementById(id);

  function updateElement(
    id: string,
    value: string | number
  ): void {
    const element = getElement(id);

    if (element) {
      element.textContent = String(value);
    }
  }

  const weatherDescriptions: Record<
    number,
    string
  > = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Depositing rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Slight snowfall",
    73: "Moderate snowfall",
    75: "Heavy snowfall",
    77: "Snow grains",
    80: "Slight rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",
    85: "Slight snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with hail",
    99: "Thunderstorm with heavy hail",
  };

  function getWeatherDescription(
    code: number
  ): string {
    return (
      weatherDescriptions[code] ??
      "Unknown conditions"
    );
  }

  function getWeatherIcon(
    code: number,
    isDay = true
  ): string {
    if (code === 0) {
      return isDay ? "☀" : "☾";
    }

    if (code === 1) {
      return isDay ? "🌤" : "☾";
    }

    if (code === 2) {
      return "⛅";
    }

    if (code === 3) {
      return "☁";
    }

    if (code === 45 || code === 48) {
      return "🌫";
    }

    if (code >= 51 && code <= 67) {
      return "🌧";
    }

    if (code >= 71 && code <= 77) {
      return "❄";
    }

    if (code >= 80 && code <= 82) {
      return "🌦";
    }

    if (code >= 85 && code <= 86) {
      return "🌨";
    }

    if (code >= 95 && code <= 99) {
      return "⛈";
    }

    return "☀";
  }

  function formatHour(
    value: string | undefined
  ): string {
    if (!value) {
      return "--:--";
    }

    const date = new Date(value);

    return date.toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }
    );
  }

  function formatDay(
    value: string | undefined,
    index: number
  ): string {
    if (!value) {
      return "--";
    }

    if (index === 0) {
      return "Today";
    }

    if (index === 1) {
      return "Tomorrow";
    }

    const date = new Date(
      `${value}T12:00:00`
    );

    return date.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      }
    );
  }

  function formatDateTime(
    value: string
  ): string {
    const date = new Date(value);

    return date.toLocaleString(
      "en-GB",
      {
        day: "2-digit",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }

  function createHourlyCard(
    data: WeatherApiResponse,
    index: number,
    startIndex: number
  ): HTMLElement {
    const time =
      data.hourly.time[index];

    const temperature =
      data.hourly.temperature_2m[index] ?? 0;

    const code =
      data.hourly.weather_code[index] ?? 0;

    const rain =
      data.hourly
        .precipitation_probability[index] ?? 0;

    const isCurrent =
      index === startIndex;

    const card =
      document.createElement("article");

    card.className = isCurrent
      ? "hour-card current"
      : "hour-card";

    const timeLabel = isCurrent
      ? "NOW"
      : formatHour(time);

    const icon =
      getWeatherIcon(code, true);

    const description =
      getWeatherDescription(code);

    card.innerHTML = `
      <span class="hour-time">
        ${timeLabel}
      </span>

      <span class="hour-icon">
        ${icon}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-condition">
        ${description}
      </span>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;

    return card;
  }

  function renderHourly(): void {
    const container =
      getElement("hourly-container");

    if (!(container instanceof HTMLElement)) {
      return;
    }

    if (!currentData) {
      return;
    }

    const totalHours =
      currentData.hourly.time.length;

    const visibleHours = 8;

    if (totalHours === 0) {
      container.innerHTML = `
        <div class="loading-card">
          No hourly forecast available.
        </div>
      `;

      return;
    }

    if (hourlyStartIndex < 0) {
      hourlyStartIndex = 0;
    }

    const maxStart = Math.max(
      0,
      totalHours - visibleHours
    );

    if (hourlyStartIndex > maxStart) {
      hourlyStartIndex = maxStart;
    }

    container.innerHTML = "";

    const endIndex = Math.min(
      hourlyStartIndex + visibleHours,
      totalHours
    );

    for (
      let i = hourlyStartIndex;
      i < endIndex;
      i += 1
    ) {
      container.appendChild(
        createHourlyCard(
          currentData,
          i,
          hourlyStartIndex
        )
      );
    }
  }

  function createDailyCard(
    data: WeatherApiResponse,
    index: number
  ): HTMLElement {
    const date =
      data.daily.time[index];

    const code =
      data.daily.weather_code[index] ?? 0;

    const high =
      data.daily.temperature_2m_max[index] ?? 0;

    const low =
      data.daily.temperature_2m_min[index] ?? 0;

    const rain =
      data.daily
        .precipitation_probability_max[index] ?? 0;

    const sunrise =
      data.daily.sunrise[index];

    const sunset =
      data.daily.sunset[index];

    const card =
      document.createElement("article");

    card.className =
      index === 0
        ? "daily-card today"
        : "daily-card";

    card.innerHTML = `
      <div class="daily-date">
        <strong>
          ${formatDay(date, index)}
        </strong>

        <span>
          ${date ?? ""}
        </span>
      </div>

      <div class="daily-icon">
        ${getWeatherIcon(code, true)}
      </div>

      <div class="daily-condition">
        ${getWeatherDescription(code)}
      </div>

      <div class="daily-temperatures">
        <strong>
          ${Math.round(high)}°
        </strong>

        <span>
          ${Math.round(low)}°
        </span>
      </div>

      <div class="daily-rain">
        ${rain}% precipitation
      </div>

      <div class="daily-sun">
        <span>
          ↑ ${formatHour(sunrise)}
        </span>

        <span>
          ↓ ${formatHour(sunset)}
        </span>
      </div>
    `;

    return card;
  }

  function renderDaily(): void {
    const container =
      getElement("daily-container");

    if (!(container instanceof HTMLElement)) {
      return;
    }

    if (!currentData) {
      return;
    }

    container.innerHTML = "";

    const days = Math.min(
      10,
      currentData.daily.time.length
    );

    for (
      let i = 0;
      i < days;
      i += 1
    ) {
      container.appendChild(
        createDailyCard(currentData, i)
      );
    }
  }

  function updateCurrentWeather(
    data: WeatherApiResponse
  ): void {
    const current = data.current;

    const temperature = Math.round(
      current.temperature_2m
    );

    const feelsLike = Math.round(
      current.apparent_temperature
    );

    const humidity = Math.round(
      current.relative_humidity_2m
    );

    const wind = Math.round(
      current.wind_speed_10m
    );

    const pressure = Math.round(
      current.surface_pressure
    );

    const visibilityKm =
      current.visibility / 1000;

    updateElement(
      "temperature",
      temperature
    );

    updateElement(
      "condition",
      getWeatherDescription(
        current.weather_code
      )
    );

    updateElement(
      "feels-like",
      `Feels like ${feelsLike}°`
    );

    updateElement(
      "hero-humidity",
      `${humidity}%`
    );

    updateElement(
      "humidity",
      `${humidity}%`
    );

    updateElement(
      "wind",
      `${wind} km/h`
    );

    updateElement(
      "wind-detail",
      `${wind} km/h`
    );

    updateElement(
      "pressure",
      `${pressure} hPa`
    );

    updateElement(
      "pressure-detail",
      `${pressure} hPa`
    );

    updateElement(
      "visibility",
      `${Math.round(
        visibilityKm
      )} km`
    );

    const icon =
      getElement("hero-icon");

    if (icon) {
      icon.textContent =
        getWeatherIcon(
          current.weather_code,
          current.is_day === 1
        );
    }
  }

  function updateSunData(
    data: WeatherApiResponse
  ): void {
    const sunrise =
      data.daily.sunrise[0];

    const sunset =
      data.daily.sunset[0];

    updateElement(
      "sunrise",
      formatHour(sunrise)
    );

    updateElement(
      "sunset",
      formatHour(sunset)
    );

    const rain =
      data.daily
        .precipitation_probability_max[0] ?? 0;

    updateElement(
      "last-updated",
      `Updated ${formatDateTime(
        new Date().toISOString()
      )} · ${rain}% rain chance`
    );
  }

  async function fetchWeather(
    locationName: LocationName
  ): Promise<WeatherApiResponse> {
    const location =
      weatherLocations[locationName];

    const params =
      new URLSearchParams({
        latitude: String(
          location.latitude
        ),

        longitude: String(
          location.longitude
        ),

        current:
          "temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,surface_pressure,wind_speed_10m,is_day,visibility",

        hourly:
          "temperature_2m,precipitation_probability,weather_code",

        daily:
          "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset",

        timezone: "auto",

        forecast_days: "10",
      });

    const url =
      `https://api.open-meteo.com/v1/forecast?${params.toString()}`;

    const response =
      await fetch(url);

    if (!response.ok) {
      throw new Error(
        `Weather API error: ${response.status}`
      );
    }

    return (
      await response.json()
    ) as WeatherApiResponse;
  }

  async function loadWeather(
    locationName: LocationName
  ): Promise<void> {
    const location =
      weatherLocations[locationName];

    updateElement(
      "header-status",
      "Loading..."
    );

    updateElement(
      "location-name",
      location.label
    );

    updateElement(
      "location-region",
      location.region
    );

    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-button"
      )
      .forEach((button) => {
        button.classList.toggle(
          "active",
          button.dataset.location ===
            locationName
        );
      });

    try {
      const data =
        await fetchWeather(
          locationName
        );

      currentLocation =
        locationName;

      currentData = data;

      hourlyStartIndex = 0;

      updateCurrentWeather(data);

      updateSunData(data);

      renderHourly();

      renderDaily();

      updateElement(
        "header-status",
        "Live data"
      );
    } catch (error) {
      console.error(
        "Weather error:",
        error
      );

      updateElement(
        "header-status",
        "Offline"
      );

      updateElement(
        "condition",
        "Unable to load weather"
      );

      updateElement(
        "last-updated",
        "Weather service unavailable"
      );
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-button"
    )
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const locationName =
            button.dataset.location;

          if (
            locationName === "Alcoi" ||
            locationName ===
              "Torrevieja" ||
            locationName === "Valencia"
          ) {
            void loadWeather(
              locationName
            );
          }
        }
      );
    });

  const previousButton =
    getElement("hourly-prev");

  if (
    previousButton instanceof
    HTMLButtonElement
  ) {
    previousButton.addEventListener(
      "click",
      () => {
        hourlyStartIndex -= 8;
        renderHourly();
      }
    );
  }

  const nextButton =
    getElement("hourly-next");

  if (
    nextButton instanceof
    HTMLButtonElement
  ) {
    nextButton.addEventListener(
      "click",
      () => {
        hourlyStartIndex += 8;
        renderHourly();
      }
    );
  }

  void loadWeather(
    currentLocation
  );
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;

    background: #f4f8fc;
    color: #101820;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(button) {
    font: inherit;
  }

  .weather-page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 82% 8%,
        rgba(61, 169, 255, 0.11),
        transparent 32rem
      ),
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f7fbff 42%,
        #eef5fa 100%
      );
  }

  /* HEADER */

  .weather-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom: 1px solid
      rgba(17, 72, 105, 0.08);

    background:
      rgba(255, 255, 255, 0.9);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(
      1180px,
      calc(100% - 48px)
    );

    min-height: 76px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: #0d8ff0;
    color: #ffffff;

    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: -0.03em;

    box-shadow:
      0 8px 24px
