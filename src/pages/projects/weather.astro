---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Weather Dashboard">
  <main class="weather-page">
    <!-- ========================================================= -->
    <!-- BACKGROUND -->
    <!-- ========================================================= -->

    <canvas
      id="weather-background"
      class="weather-canvas"
      aria-hidden="true"
    ></canvas>

    <div class="weather-background"></div>

    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <div class="weather-content">

      <!-- ======================================================= -->
      <!-- HEADER -->
      <!-- ======================================================= -->

      <header class="weather-header">

        <div class="project-label">
          <span class="status-dot"></span>
          <span>PROJECT 03 / WEATHER</span>
        </div>

        <h1>
          Weather Dashboard<span>.</span>
        </h1>

        <p class="intro">
          A real-time weather interface for Alcoi and Valencia,
          combining live meteorological data with a clean,
          developer-oriented visual system.
        </p>

        <div class="technology-list">
          <span>Astro</span>
          <span>TypeScript</span>
          <span>Open-Meteo</span>
          <span>REST API</span>
          <span>Canvas</span>
        </div>

      </header>


      <!-- ======================================================= -->
      <!-- CURRENT WEATHER -->
      <!-- ======================================================= -->

      <section class="section">

        <div class="section-heading">

          <div>
            <span class="section-label">
              LIVE CONDITIONS
            </span>

            <h2>
              Current weather
            </h2>

            <p>
              Live meteorological data retrieved directly from
              the Open-Meteo API.
            </p>
          </div>

          <div class="live-indicator">
            <span></span>
            LIVE
          </div>

        </div>


        <!-- ===================================================== -->
        <!-- WEATHER CARDS -->
        <!-- ===================================================== -->

        <div class="weather-grid">

          <!-- ALCOI -->

          <article
            class="weather-card"
            data-lat="38.6983"
            data-lon="-0.4743"
            data-city="Alcoi"
          >

            <div class="card-light"></div>

            <div class="card-content">

              <div class="card-top">

                <div>
                  <span class="location-label">
                    LOCATION
                  </span>

                  <h3>
                    Alcoi<span>.</span>
                  </h3>

                  <p>
                    Alicante, Spain
                  </p>
                </div>

                <div
                  class="weather-icon"
                  aria-hidden="true"
                >
                  —
                </div>

              </div>


              <div class="temperature-area">

                <div class="temperature-row">

                  <span class="temperature">
                    --
                  </span>

                  <span class="temperature-unit">
                    °C
                  </span>

                </div>

                <p class="weather-description">
                  Loading weather...
                </p>

              </div>


              <div class="weather-details">

                <div>
                  <span>FEELS LIKE</span>
                  <strong class="weather-feels">--</strong>
                </div>

                <div>
                  <span>WIND</span>
                  <strong class="weather-wind">--</strong>
                </div>

                <div>
                  <span>HUMIDITY</span>
                  <strong class="weather-humidity">--</strong>
                </div>

                <div>
                  <span>UPDATED</span>
                  <strong class="weather-time">--</strong>
                </div>

              </div>

            </div>

          </article>


          <!-- VALENCIA -->

          <article
            class="weather-card"
            data-lat="39.4699"
            data-lon="-0.3763"
            data-city="Valencia"
          >

            <div class="card-light"></div>

            <div class="card-content">

              <div class="card-top">

                <div>
                  <span class="location-label">
                    LOCATION
                  </span>

                  <h3>
                    Valencia<span>.</span>
                  </h3>

                  <p>
                    Valencia, Spain
                  </p>
                </div>

                <div
                  class="weather-icon"
                  aria-hidden="true"
                >
                  —
                </div>

              </div>


              <div class="temperature-area">

                <div class="temperature-row">

                  <span class="temperature">
                    --
                  </span>

                  <span class="temperature-unit">
                    °C
                  </span>

                </div>

                <p class="weather-description">
                  Loading weather...
                </p>

              </div>


              <div class="weather-details">

                <div>
                  <span>FEELS LIKE</span>
                  <strong class="weather-feels">--</strong>
                </div>

                <div>
                  <span>WIND</span>
                  <strong class="weather-wind">--</strong>
                </div>

                <div>
                  <span>HUMIDITY</span>
                  <strong class="weather-humidity">--</strong>
                </div>

                <div>
                  <span>UPDATED</span>
                  <strong class="weather-time">--</strong>
                </div>

              </div>

            </div>

          </article>

        </div>

      </section>


      <!-- ======================================================= -->
      <!-- FORECAST -->
      <!-- ======================================================= -->

      <section class="section forecast-section">

        <div class="section-heading">

          <div>
            <span class="section-label">
              FORECAST
            </span>

            <h2>
              Seven day outlook
            </h2>

            <p>
              Seven days of forecast data from the same live
              weather service.
            </p>
          </div>

        </div>


        <div class="location-switcher">

          <button
            type="button"
            class="forecast-button active"
            data-location="38.6983,-0.4743"
          >
            Alcoi
          </button>

          <button
            type="button"
            class="forecast-button"
            data-location="39.4699,-0.3763"
          >
            Valencia
          </button>

        </div>


        <div
          id="forecast-container"
          class="forecast-container"
        >
          <div class="forecast-loading">
            Loading forecast...
          </div>
        </div>

      </section>


      <!-- ======================================================= -->
      <!-- PROJECT INFORMATION -->
      <!-- ======================================================= -->

      <section class="section information-section">

        <div class="section-heading">

          <div>
            <span class="section-label">
              PROJECT
            </span>

            <h2>
              Live data meets interface.
            </h2>

            <p>
              A lightweight weather application designed around
              live data, responsive presentation and interactive
              visual feedback.
            </p>
          </div>

        </div>


        <div class="information-grid">

          <article>
            <span>01</span>

            <h3>
              Data source
            </h3>

            <p>
              Weather information is retrieved from Open-Meteo
              using geographic coordinates for Alcoi and Valencia.
            </p>
          </article>


          <article>
            <span>02</span>

            <h3>
              Client-side rendering
            </h3>

            <p>
              The browser requests the weather data and updates
              the interface dynamically without a dedicated backend.
            </p>
          </article>


          <article>
            <span>03</span>

            <h3>
              Interactive system
            </h3>

            <p>
              A subtle electric-blue particle field and moving grid
              create depth while keeping the weather information
              readable.
            </p>
          </article>


          <article>
            <span>04</span>

            <h3>
              Responsive design
            </h3>

            <p>
              The interface adapts from a compact mobile layout
              to a spacious two-column desktop dashboard.
            </p>
          </article>

        </div>

      </section>


      <!-- ======================================================= -->
      <!-- TECHNOLOGIES -->
      <!-- ======================================================= -->

      <section class="technologies">

        <span class="section-label">
          TECHNOLOGIES
        </span>

        <div class="technology-list technology-list-bottom">

          <span>Astro</span>
          <span>TypeScript</span>
          <span>Open-Meteo API</span>
          <span>Fetch API</span>
          <span>HTML</span>
          <span>CSS</span>
          <span>Canvas API</span>

        </div>

      </section>


      <!-- ======================================================= -->
      <!-- API -->
      <!-- ======================================================= -->

      <section class="api-section">

        <div class="api-header">
          <span class="status-dot"></span>
          <span>API ENDPOINT</span>
        </div>

        <code>
          https://api.open-meteo.com/v1/forecast
        </code>

      </section>


      <!-- ======================================================= -->
      <!-- BACK -->
      <!-- ======================================================= -->

      <div class="back-section">

        <a href="/#projects" class="back-link">
          <span>←</span>
          <span>Back to projects</span>
        </a>

      </div>

    </div>
  </main>
</Layout>


<!-- ============================================================= -->
<!-- WEATHER LOGIC -->
<!-- ============================================================= -->

<script>
  const API_URL = "https://api.open-meteo.com/v1/forecast";

  function getWeatherDescription(code) {
    const descriptions = {
      0: "Clear sky",
      1: "Mainly clear",
      2: "Partly cloudy",
      3: "Overcast",
      45: "Fog",
      48: "Rime fog",
      51: "Light drizzle",
      53: "Moderate drizzle",
      55: "Dense drizzle",
      56: "Light freezing drizzle",
      57: "Dense freezing drizzle",
      61: "Light rain",
      63: "Moderate rain",
      65: "Heavy rain",
      66: "Light freezing rain",
      67: "Heavy freezing rain",
      71: "Light snow",
      73: "Moderate snow",
      75: "Heavy snow",
      77: "Snow grains",
      80: "Light rain showers",
      81: "Moderate rain showers",
      82: "Heavy rain showers",
      85: "Light snow showers",
      86: "Heavy snow showers",
      95: "Thunderstorm",
      96: "Thunderstorm with hail",
      99: "Thunderstorm with heavy hail"
    };

    return descriptions[code] || "Unknown conditions";
  }


  function getWeatherIcon(code) {
    if (code === 0) return "☀";

    if (code === 1 || code === 2) return "◐";

    if (code === 3) return "☁";

    if (code === 45 || code === 48) return "≋";

    if (code >= 51 && code <= 67) return "⌁";

    if (code >= 71 && code <= 77) return "❄";

    if (code >= 80 && code <= 86) return "⌁";

    return "⚡";
  }


  function buildUrl(latitude, longitude) {
    return (
      API_URL +
      "?latitude=" +
      encodeURIComponent(latitude) +
      "&longitude=" +
      encodeURIComponent(longitude) +
      "&current=" +
      "temperature_2m," +
      "relative_humidity_2m," +
      "apparent_temperature," +
      "weather_code," +
      "wind_speed_10m" +
      "&daily=" +
      "weather_code," +
      "temperature_2m_max," +
      "temperature_2m_min" +
      "&timezone=Europe%2FMadrid" +
      "&forecast_days=7"
    );
  }


  function formatTime(value) {
    if (!value) return "--";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }


  function formatDay(value) {
    if (!value) return "--";

    const date = new Date(value + "T12:00:00");

    if (Number.isNaN(date.getTime())) {
      return "--";
    }

    return date.toLocaleDateString("en-GB", {
      weekday: "short"
    });
  }


  async function loadCurrentWeather(card) {
    const latitude = card.dataset.lat;
    const longitude = card.dataset.lon;

    if (!latitude || !longitude) {
      return;
    }

    const description =
      card.querySelector(".weather-description");

    const temperature =
      card.querySelector(".temperature");

    const feels =
      card.querySelector(".weather-feels");

    const wind =
      card.querySelector(".weather-wind");

    const humidity =
      card.querySelector(".weather-humidity");

    const time =
      card.querySelector(".weather-time");

    const icon =
      card.querySelector(".weather-icon");


    try {
      const response = await fetch(
        buildUrl(latitude, longitude)
      );

      if (!response.ok) {
        throw new Error("Weather API request failed");
      }

      const data = await response.json();

      if (!data.current) {
        throw new Error("Current weather data unavailable");
      }

      const current = data.current;


      if (temperature) {
        temperature.textContent =
          Math.round(current.temperature_2m);
      }


      if (description) {
        description.textContent =
          getWeatherDescription(current.weather_code);
      }


      if (feels) {
        feels.textContent =
          Math.round(current.apparent_temperature) + "°C";
      }


      if (wind) {
        wind.textContent =
          Math.round(current.wind_speed_10m) + " km/h";
      }


      if (humidity) {
        humidity.textContent =
          current.relative_humidity_2m + "%";
      }


      if (time) {
        time.textContent =
          formatTime(current.time);
      }


      if (icon) {
        icon.textContent =
          getWeatherIcon(current.weather_code);
      }

    } catch (error) {
      console.error(
        "Weather loading error:",
        error
      );

      if (description) {
        description.textContent =
          "Unable to load weather";
      }

      if (temperature) {
        temperature.textContent = "--";
      }

      if (icon) {
        icon.textContent = "!";
      }
    }
  }


  const weatherCards =
    document.querySelectorAll(".weather-card");


  weatherCards.forEach((card) => {
    loadCurrentWeather(card);
  });


  // =============================================================
  // FORECAST
  // =============================================================

  const forecastContainer =
    document.querySelector("#forecast-container");

  const forecastButtons =
    document.querySelectorAll(".forecast-button");


  async function loadForecast(latitude, longitude) {
    if (!forecastContainer) {
      return;
    }


    forecastContainer.innerHTML =
      '<div class="forecast-loading">Loading forecast...</div>';


    try {
      const response = await fetch(
        buildUrl(latitude, longitude)
      );

      if (!response.ok) {
        throw new Error("Forecast API request failed");
      }

      const data = await response.json();

      if (!data.daily) {
        throw new Error("Forecast data unavailable");
      }

      const daily = data.daily;


      forecastContainer.innerHTML = "";


      for (
        let index = 0;
        index < daily.time.length;
        index++
      ) {
        const item =
          document.createElement("article");

        item.className =
          "forecast-item";


        const day =
          document.createElement("span");

        day.className =
          "forecast-day";

        day.textContent =
          index === 0
            ? "Today"
            : formatDay(daily.time[index]);


        const icon =
          document.createElement("span");

        icon.className =
          "forecast-icon";

        icon.textContent =
          getWeatherIcon(
            daily.weather_code[index]
          );


        const description =
          document.createElement("span");

        description.className =
          "forecast-description";

        description.textContent =
          getWeatherDescription(
            daily.weather_code[index]
          );


        const temperatures =
          document.createElement("div");

        temperatures.className =
          "forecast-temperatures";


        const maximum =
          document.createElement("strong");

        maximum.textContent =
          Math.round(
            daily.temperature_2m_max[index]
          ) + "°";


        const minimum =
          document.createElement("span");

        minimum.textContent =
          Math.round(
            daily.temperature_2m_min[index]
          ) + "°";


        temperatures.append(
          maximum,
          minimum
        );


        item.append(
          day,
          icon,
          description,
          temperatures
        );


        forecastContainer.appendChild(item);
      }

    } catch (error) {
      console.error(
        "Forecast loading error:",
        error
      );

      forecastContainer.innerHTML =
        '<div class="forecast-loading">Unable to load forecast.</div>';
    }
  }


  const firstButton =
    forecastButtons[0];


  if (firstButton) {
    const location =
      firstButton.dataset.location;

    if (location) {
      const parts =
        location.split(",");

      if (parts.length === 2) {
        loadForecast(
          parts[0],
          parts[1]
        );
      }
    }
  }


  forecastButtons.forEach((button) => {

    button.addEventListener("click", () => {

      forecastButtons.forEach((item) => {
        item.classList.remove("active");
      });

      button.classList.add("active");


      const location =
        button.dataset.location;

      if (!location) {
        return;
      }


      const parts =
        location.split(",");


      if (parts.length !== 2) {
        return;
      }


      loadForecast(
        parts[0],
        parts[1]
      );
    });

  });
</script>


<!-- ============================================================= -->
<!-- ELECTRIC BLUE BACKGROUND -->
<!-- ============================================================= -->

<script>
  const canvas =
    document.querySelector("#weather-background");


  if (canvas) {

    const context =
      canvas.getContext("2d");


    if (context) {

      const particles = [];

      let width = window.innerWidth;
      let height = window.innerHeight;

      let mouseX = width / 2;
      let mouseY = height / 2;

      let targetMouseX = mouseX;
      let targetMouseY = mouseY;

      let animationFrame = 0;


      function getParticleCount() {
        return window.innerWidth < 768
          ? 28
          : 55;
      }


      function createParticle() {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.18,
          size: Math.random() * 1.4 + 0.4,
          opacity: Math.random() * 0.35 + 0.08
        };
      }


      function resizeCanvas() {

        const ratio =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );


        width =
          window.innerWidth;

        height =
          window.innerHeight;


        canvas.width =
          width * ratio;

        canvas.height =
          height * ratio;


        canvas.style.width =
          width + "px";

        canvas.style.height =
          height + "px";


        context.setTransform(
          ratio,
          0,
          0,
          ratio,
          0,
          0
        );


        particles.length = 0;


        const count =
          getParticleCount();


        for (
          let i = 0;
          i < count;
          i++
        ) {
          particles.push(
            createParticle()
          );
        }
      }


      function drawBackground() {

        context.clearRect(
          0,
          0,
          width,
          height
        );


        // Mouse glow

        const glow =
          context.createRadialGradient(
            targetMouseX,
            targetMouseY,
            0,
            targetMouseX,
            targetMouseY,
            300
          );


        glow.addColorStop(
          0,
          "rgba(0,170,255,0.065)"
        );


        glow.addColorStop(
          0.5,
          "rgba(0,170,255,0.018)"
        );


        glow.addColorStop(
          1,
          "rgba(0,170,255,0)"
        );


        context.fillStyle =
          glow;


        context.fillRect(
          0,
          0,
          width,
          height
        );


        // Moving grid

        const spacing = 80;

        const offsetX =
          (mouseX - width / 2) * 0.015;

        const offsetY =
          (mouseY - height / 2) * 0.015;


        context.strokeStyle =
          "rgba(0,170,255,0.035)";

        context.lineWidth = 1;


        for (
          let x =
            -spacing +
            (offsetX % spacing);

          x < width + spacing;

          x += spacing
        ) {

          context.beginPath();

          context.moveTo(x, 0);

          context.lineTo(
            x,
            height
          );

          context.stroke();
        }


        for (
          let y =
            -spacing +
            (offsetY % spacing);

          y < height + spacing;

          y += spacing
        ) {

          context.beginPath();

          context.moveTo(
            0,
            y
          );

          context.lineTo(
            width,
            y
          );

          context.stroke();
        }


        // Connections

        const maxDistance = 135;


        for (
          let i = 0;
          i < particles.length;
          i++
        ) {

          const first =
            particles[i];


          for (
            let j = i + 1;
            j < particles.length;
            j++
          ) {

            const second =
              particles[j];


            const dx =
              first.x - second.x;

            const dy =
              first.y - second.y;


            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            if (
              distance < maxDistance
            ) {

              const opacity =
                (1 - distance / maxDistance) *
                0.065;


              context.beginPath();

              context.moveTo(
                first.x,
                first.y
              );

              context.lineTo(
                second.x,
                second.y
              );


              context.strokeStyle =
                "rgba(0,170,255," +
                opacity +
                ")";


              context.stroke();
            }
          }
        }


        // Particles

        for (const particle of particles) {

          particle.x += particle.vx;
          particle.y += particle.vy;


          if (particle.x < -10) {
            particle.x = width + 10;
          }

          if (particle.x > width + 10) {
            particle.x = -10;
          }

          if (particle.y < -10) {
            particle.y = height + 10;
          }

          if (particle.y > height + 10) {
            particle.y = -10;
          }


          const dx =
            targetMouseX -
            particle.x;

          const dy =
            targetMouseY -
            particle.y;


          const distance =
            Math.sqrt(
              dx * dx +
              dy * dy
            );


          if (distance < 180) {

            const force =
              (1 - distance / 180) *
              0.004;


            particle.vx +=
              dx * force;

            particle.vy +=
              dy * force;
          }


          particle.vx *= 0.996;
          particle.vy *= 0.996;


          context.beginPath();


          context.arc(
            particle.x,
            particle.y,
            particle.size,
            0,
            Math.PI * 2
          );


          context.fillStyle =
            "rgba(0,190,255," +
            particle.opacity +
            ")";


          context.fill();
        }
      }


      function animate() {

        mouseX +=
          (targetMouseX - mouseX) *
          0.045;

        mouseY +=
          (targetMouseY - mouseY) *
          0.045;


        drawBackground();


        animationFrame =
          requestAnimationFrame(
            animate
          );
      }


      function handleMouseMove(event) {

        targetMouseX =
          event.clientX;

        targetMouseY =
          event.clientY;
      }


      function handleMouseLeave() {

        targetMouseX =
          width / 2;

        targetMouseY =
          height / 2;
      }


      resizeCanvas();


      window.addEventListener(
        "resize",
        resizeCanvas
      );


      window.addEventListener(
        "mousemove",
        handleMouseMove,
        { passive: true }
      );


      window.addEventListener(
        "mouseleave",
        handleMouseLeave
      );


      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (reducedMotion) {

        drawBackground();

      } else {

        animationFrame =
          requestAnimationFrame(
            animate
          );
      }


      window.addEventListener(
        "pagehide",
        () => {

          cancelAnimationFrame(
            animationFrame
          );

          window.removeEventListener(
            "resize",
            resizeCanvas
          );

          window.removeEventListener(
            "mousemove",
            handleMouseMove
          );

          window.removeEventListener(
            "mouseleave",
            handleMouseLeave
          );

        }
      );

    }
  }
</script>


<!-- ============================================================= -->
<!-- STYLES -->
<!-- ============================================================= -->

<style>

  /* =========================================================== */
  /* PAGE */
  /* =========================================================== */

  .weather-page {

    --weather-blue: #00aaff;
    --weather-blue-bright: #38c8ff;

    --weather-white: #ffffff;
    --weather-muted: rgba(255,255,255,0.62);
    --weather-soft: rgba(255,255,255,0.38);

    --weather-border: rgba(255,255,255,0.10);
    --weather-border-blue: rgba(0,170,255,0.30);

    --weather-card: rgba(15,18,22,0.82);

    position: relative;

    min-height: 100vh;

    overflow: hidden;

    color: var(--weather-white);

