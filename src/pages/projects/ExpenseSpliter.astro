---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Expense Splitter">
  <section class="ex-page text-[var(--white)] py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6">

      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors duration-300 mb-14"
      >
        <span class="text-lg">&larr;</span>
        <span>Back to home</span>
      </a>

      <div class="mb-16 md:mb-20">
        <div class="flex items-center gap-3 mb-5">
          <span class="h-2 w-2 rounded-full bg-[var(--sec)] shadow-[0_0_12px_var(--sec)]"></span>
          <span class="text-sm tracking-[0.25em] uppercase text-[var(--sec)] shiny-sec">
            Project 07 &middot; Flutter Mobile
          </span>
        </div>

        <h1 class="text-4xl md:text-6xl font-medium tracking-tight text-[var(--white)]">
          Splitting the bill, fairly<span class="text-[var(--sec)]">.</span>
        </h1>

        <p class="mt-5 max-w-2xl text-lg text-[var(--white-icon)] leading-relaxed">
          A Flutter-inspired expense splitting experience. Add people, record
          expenses, and calculate who owes whom with the minimum number of transfers.
        </p>

        <p class="mt-3 max-w-2xl text-sm text-[var(--white-icon)] leading-relaxed opacity-70">
          This page is the interactive web preview of the application's state model.
          The production mobile version is intended for Flutter and Dart on iOS/Android.
        </p>

        <div class="mt-7 flex flex-wrap gap-2">
          <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs font-mono text-[var(--white-icon)]">Flutter &amp; Dart</span>
          <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs font-mono text-[var(--white-icon)]">State Management</span>
          <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs font-mono text-[var(--white-icon)]">Local Storage</span>
          <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs font-mono text-[var(--white-icon)]">Settlement Algorithm</span>
        </div>
      </div>

      <div class="ex-card">
        <div class="ex-card-header">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs tracking-[0.2em] text-[var(--sec)]">01</span>
            <span class="h-px w-12 bg-[var(--sec)] opacity-40"></span>
            <span class="text-xs uppercase tracking-widest text-[var(--white-icon)]">Interactive demo</span>
          </div>

          <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-[var(--white)] mt-4">
            Expense splitter
          </h2>

          <p class="mt-2 text-base text-[var(--white-icon)] leading-relaxed max-w-2xl">
            Add people, log what everyone paid, and the settlement engine calculates
            the transfers required to balance the group.
          </p>
        </div>

        <div class="ex-summary" aria-live="polite">
          <div>
            <span>Total spent</span>
            <strong id="ex-total">$0.00</strong>
          </div>
          <div>
            <span>People</span>
            <strong id="ex-count">0</strong>
          </div>
          <div>
            <span>Expenses</span>
            <strong id="ex-expense-count">0</strong>
          </div>
          <div>
            <span>Transfers</span>
            <strong id="ex-transfer-count">0</strong>
          </div>
        </div>

        <div class="ex-layout mt-6">

          <div class="ex-panel">
            <div class="ex-panel-title">People</div>

            <div class="mt-3 flex gap-2">
              <input
                id="ex-person-name"
                type="text"
                placeholder="name"
                class="ex-input flex-1"
                maxlength="18"
                autocomplete="off"
              />
              <button id="ex-add-person" type="button" class="ex-btn ex-btn-primary">
                Add
              </button>
            </div>

            <div id="ex-people-list" class="ex-people mt-3"></div>
          </div>

          <div class="ex-panel">
            <div class="ex-panel-title">New expense</div>

            <div class="mt-3 flex flex-col gap-2">
              <input
                id="ex-expense-desc"
                type="text"
                placeholder="what was it for"
                class="ex-input"
                maxlength="30"
                autocomplete="off"
              />

              <div class="flex gap-2">
                <input
                  id="ex-expense-amount"
                  type="number"
                  min="0.01"
                  step="0.01"
                  inputmode="decimal"
                  placeholder="amount"
                  class="ex-input flex-1"
                />

                <select id="ex-expense-payer" class="ex-select flex-1">
                  <option value="">payer</option>
                </select>
              </div>

              <button id="ex-add-expense" type="button" class="ex-btn ex-btn-primary self-start">
                Add expense
              </button>

              <p id="ex-form-message" class="ex-form-message" role="status"></p>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <div class="ex-section-heading">
            <div class="ex-panel-title">Expenses</div>
            <span id="ex-expense-total" class="ex-section-value">$0.00</span>
          </div>

          <div id="ex-expenses-list" class="ex-expenses mt-2"></div>
        </div>

        <div class="mt-6">
          <div class="ex-section-heading">
            <div class="ex-panel-title">Settlement &mdash; who pays who</div>
            <span class="ex-section-value">MINIMUM TRANSFERS</span>
          </div>

          <div id="ex-settlement" class="ex-settlement mt-2"></div>
        </div>

        <div class="ex-actions mt-6">
          <button id="ex-reset" type="button" class="ex-btn">Reset demo</button>
          <button id="ex-load-example" type="button" class="ex-btn ex-btn-secondary">
            Load example
          </button>
        </div>
      </div>

      <div class="ex-card ex-info-card">
        <div class="ex-card-header">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs tracking-[0.2em] text-[var(--sec)]">02</span>
            <span class="h-px w-12 bg-[var(--sec)] opacity-40"></span>
            <span class="text-xs uppercase tracking-widest text-[var(--white-icon)]">How it works</span>
          </div>

          <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-[var(--white)] mt-4">
            From expenses to balances.
          </h2>

          <div class="ex-concepts mt-6">
            <div>
              <span>01</span>
              <strong>Calculate the equal share</strong>
              <p>Total expenses are divided equally between all active people.</p>
            </div>
            <div>
              <span>02</span>
              <strong>Calculate each balance</strong>
              <p>Paid more than the share? You are owed money. Paid less? You owe money.</p>
            </div>
            <div>
              <span>03</span>
              <strong>Settle efficiently</strong>
              <p>Debtors are matched with creditors until every balance reaches zero.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .ex-page :global(.shiny-sec) {
    background: linear-gradient(90deg, var(--sec), #6ee7b7, var(--sec));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ex-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--white-icon-tr);
    background: #1414149c;
    backdrop-filter: blur(6px);
    padding: 1.75rem;
  }

  @media (min-width: 768px) {
    .ex-card {
      padding: 2.5rem;
    }
  }

  .ex-card-header {
    max-width: 48rem;
  }

  .ex-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 800px) {
    .ex-layout {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .ex-panel {
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.75rem;
    background: #10101080;
    padding: 1.25rem;
  }

  .ex-panel-title {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--white-icon);
    opacity: 0.7;
  }

  .ex-input,
  .ex-select {
    min-height: 38px;
    padding: 0.5rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--white-icon-tr);
    background: #0a0a0a80;
    color: var(--white);
    font-size: 0.85rem;
    outline: none;
  }

  .ex-input::placeholder {
    color: var(--white-icon);
    opacity: 0.45;
  }

  .ex-input:focus,
  .ex-select:focus {
    border-color: var(--sec);
    box-shadow: 0 0 0 3px rgba(164, 118, 255, 0.1);
  }

  .ex-select option {
    background: #101010;
    color: var(--white);
  }

  .ex-btn {
    min-height: 38px;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--white-icon-tr);
    color: var(--white-icon);
    font-size: 0.8rem;
    font-family: monospace;
    background: transparent;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .ex-btn:hover {
    border-color: var(--sec);
    color: var(--white);
    transform: translateY(-1px);
  }

  .ex-btn:active {
    transform: translateY(0);
  }

  .ex-btn-primary {
    border-color: var(--sec);
    color: var(--sec);
  }

  .ex-btn-primary:hover {
    background: rgba(164, 118, 255, 0.1);
  }

  .ex-btn-secondary {
    border-color: rgba(110, 231, 183, 0.3);
    color: #6ee7b7;
  }

  .ex-people {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 30px;
  }

  .ex-person-chip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border-radius: 9999px;
    border: 1px solid var(--white-icon-tr);
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.8rem;
    color: var(--white);
  }

  .ex-person-remove {
    cursor: pointer;
    color: var(--white-icon);
    opacity: 0.6;
    font-size: 0.9rem;
    line-height: 1;
  }

  .ex-person-remove:hover {
    color: #ef4444;
    opacity: 1;
  }

  .ex-empty {
    width: 100%;
    padding: 0.7rem;
    border: 1px dashed var(--white-icon-tr);
    border-radius: 0.6rem;
    font-size: 0.75rem;
    color: var(--white-icon);
    opacity: 0.5;
    font-family: monospace;
  }

  .ex-form-message {
    min-height: 1.1rem;
    color: #fca5a5;
    font-size: 0.72rem;
    font-family: monospace;
  }

  .ex-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .ex-summary > div {
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.7rem;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .ex-summary span {
    display: block;
    color: var(--white-icon);
    opacity: 0.55;
    font-family: monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ex-summary strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--sec);
    font-family: monospace;
    font-size: 1rem;
  }

  .ex-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ex-section-value {
    color: var(--white-icon);
    opacity: 0.5;
    font-family: monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
  }

  .ex-expenses {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 260px;
    overflow-y: auto;
  }

  .ex-expense-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.6rem;
    background: #10101080;
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
  }

  .ex-expense-desc {
    color: var(--white);
    word-break: break-word;
  }

  .ex-expense-meta {
    margin-top: 0.2rem;
    font-family: monospace;
    font-size: 0.68rem;
    color: var(--white-icon);
    opacity: 0.65;
  }

  .ex-expense-amount {
    flex: 0 0 auto;
    font-family: monospace;
    color: var(--sec);
  }

  .ex-settlement {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ex-settlement-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgba(110, 231, 183, 0.25);
    background: rgba(110, 231, 183, 0.06);
    border-radius: 0.6rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
    color: var(--white);
  }

  .ex-settlement-arrow {
    color: #6ee7b7;
  }

  .ex-settlement-amount {
    font-family: monospace;
    color: #6ee7b7;
    margin-left: auto;
  }

  .ex-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .ex-info-card {
    margin-top: 1.5rem;
  }

  .ex-concepts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    border: 1px solid var(--white-icon-tr);
    background: var(--white-icon-tr);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  @media (min-width: 800px) {
    .ex-concepts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ex-concepts > div {
    background: #101010;
    padding: 1.2rem;
  }

  .ex-concepts span {
    color: var(--sec);
    font-family: monospace;
    font-size: 0.55rem;
  }

  .ex-concepts strong {
    display: block;
    margin-top: 0.5rem;
    color: var(--white);
    font-size: 0.8rem;
  }

  .ex-concepts p {
    margin-top: 0.45rem;
    color: var(--white-icon);
    opacity: 0.65;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .ex-summary {
      grid-template-columns: repeat(2, 1fr);
    }

    .ex-expense-row,
    .ex-settlement-row {
      align-items: flex-start;
    }

    .ex-card {
      padding: 1.1rem;
    }
  }
</style>

<script>
  (() => {
    type Person = {
      id: number;
      name: string;
    };

    type Expense = {
      id: number;
      desc: string;
      amountCents: number;
      payerId: number;
    };

    type Balance = {
      id: number;
      name: string;
      cents: number;
    };

    type Transfer = {
      from: string;
      to: string;
      cents: number;
    };

    const $ = <T extends HTMLElement>(id: string) =>
      document.getElementById(id) as T | null;

    const personNameInput = $<HTMLInputElement>("ex-person-name");
    const addPersonBtn = $<HTMLButtonElement>("ex-add-person");
    const peopleListEl = $<HTMLDivElement>("ex-people-list");

    const descInput = $<HTMLInputElement>("ex-expense-desc");
    const amountInput = $<HTMLInputElement>("ex-expense-amount");
    const payerSelect = $<HTMLSelectElement>("ex-expense-payer");
    const addExpenseBtn = $<HTMLButtonElement>("ex-add-expense");
    const expensesListEl = $<HTMLDivElement>("ex-expenses-list");

    const settlementEl = $<HTMLDivElement>("ex-settlement");
    const resetBtn = $<HTMLButtonElement>("ex-reset");
    const loadExampleBtn = $<HTMLButtonElement>("ex-load-example");
    const formMessageEl = $<HTMLParagraphElement>("ex-form-message");

    const totalEl = $<HTMLElement>("ex-total");
    const countEl = $<HTMLElement>("ex-count");
    const expenseCountEl = $<HTMLElement>("ex-expense-count");
    const transferCountEl = $<HTMLElement>("ex-transfer-count");
    const expenseTotalEl = $<HTMLElement>("ex-expense-total");

    if (
      !personNameInput ||
      !addPersonBtn ||
      !peopleListEl ||
      !descInput ||
      !amountInput ||
      !payerSelect ||
      !addExpenseBtn ||
      !expensesListEl ||
      !settlementEl ||
      !resetBtn ||
      !loadExampleBtn ||
      !formMessageEl ||
      !totalEl ||
      !countEl ||
      !expenseCountEl ||
      !transferCountEl ||
      !expenseTotalEl
    ) {
      return;
    }

    let people: Person[] = [];
    let expenses: Expense[] = [];
    let nextPersonId = 1;
    let nextExpenseId = 1;

    const currency = new Intl.NumberFormat(undefined, {
      style: "currency",
      currency: "USD",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;",
      }[char] || char));

    const formatCents = (cents: number) => currency.format(cents / 100);

    const parseAmountToCents = (value: string) => {
      const normalized = value.trim().replace(",", ".");
      if (!normalized || !/^\d+(\.\d{1,2})?$/.test(normalized)) return null;

      const amount = Number(normalized);
      if (!Number.isFinite(amount) || amount <= 0) return null;

      return Math.round(amount * 100);
    };

    const showMessage = (message = "") => {
      formMessageEl.textContent = message;
    };

    const getTotalCents = () =>
      expenses.reduce((sum, expense) => sum + expense.amountCents, 0);

    function renderPeople() {
      if (people.length === 0) {
        peopleListEl.innerHTML =
          `<div class="ex-empty">No one added yet.</div>`;
      } else {
        peopleListEl.innerHTML = people
          .map(
            (person) => `
              <div class="ex-person-chip">
                <span>${escapeHtml(person.name)}</span>
                <button
                  type="button"
                  class="ex-person-remove"
                  data-person-id="${person.id}"
                  aria-label="Remove ${escapeHtml(person.name)}"
                  title="Remove ${escapeHtml(person.name)}"
                >&times;</button>
              </div>
            `,
          )
          .join("");
      }

      payerSelect.innerHTML =
        `<option value="">Choose payer</option>` +
        people
          .map(
            (person) =>
              `<option value="${person.id}">${escapeHtml(person.name)}</option>`,
          )
          .join("");
    }

    function renderExpenses() {
      if (expenses.length === 0) {
        expensesListEl.innerHTML =
          `<div class="ex-empty">No expenses logged yet.</div>`;
        return;
      }

      expensesListEl.innerHTML = expenses
        .map((expense) => {
          const payer = people.find((person) => person.id === expense.payerId);

          return `
            <div class="ex-expense-row">
              <div>
                <div class="ex-expense-desc">${escapeHtml(expense.desc)}</div>
                <div class="ex-expense-meta">
                  paid by ${escapeHtml(payer?.name ?? "Unknown")}
                </div>
              </div>
              <div class="ex-expense-amount">
                ${formatCents(expense.amountCents)}
              </div>
            </div>
          `;
        })
        .join("");
    }

    function calculateBalances(): Balance[] {
      if (people.length === 0) return [];

      const totalCents = getTotalCents();
      const baseShare = Math.floor(totalCents / people.length);
      const remainder = totalCents % people.length;

      const paidByPerson = new Map<number, number>();

      for (const person of people) {
        paidByPerson.set(person.id, 0);
      }

      for (const expense of expenses) {
        paidByPerson.set(
          expense.payerId,
          (paidByPerson.get(expense.payerId) ?? 0) + expense.amountCents,
        );
      }

      return people.map((person, index) => {
        // Distribute leftover cents deterministically so the total always
        // balances exactly to the cent.
        const share = baseShare + (index < remainder ? 1 : 0);

        return {
          id: person.id,
          name: person.name,
          cents: (paidByPerson.get(person.id) ?? 0) - share,
        };
      });
    }

    function calculateTransfers(): Transfer[] {
      const balances = calculateBalances();

      const creditors = balances
        .filter((balance) => balance.cents > 0)
        .sort((a, b) => b.cents - a.cents);

      const debtors = balances
        .filter((balance) => balance.cents < 0)
        .sort((a, b) => a.cents - b.cents);

      const transfers: Transfer[] = [];
      let creditorIndex = 0;
      let debtorIndex = 0;

      while (
        creditorIndex < creditors.length &&
        debtorIndex < debtors.length
      ) {
        const creditor = creditors[creditorIndex];
        const debtor = debtors[debtorIndex];
        const amount = Math.min(creditor.cents, -debtor.cents);

        if (amount > 0) {
          transfers.push({
            from: debtor.name,
            to: creditor.name,
            cents: amount,
          });
        }

        creditor.cents -= amount;
        debtor.cents += amount;

        if (creditor.cents === 0) creditorIndex++;
        if (debtor.cents === 0) debtorIndex++;
      }

      return transfers;
    }

    function renderSettlement() {
      if (people.length === 0) {
        settlementEl.innerHTML =
          `<div class="ex-empty">Add people to calculate a settlement.</div>`;
        return 0;
      }

      if (expenses.length === 0) {
        settlementEl.innerHTML =
          `<div class="ex-empty">Add an expense to calculate a settlement.</div>`;
        return 0;
      }

      const transfers = calculateTransfers();

      if (transfers.length === 0) {
        settlementEl.innerHTML =
          `<div class="ex-empty">Everyone is even — no transfers needed.</div>`;
        return 0;
      }

      settlementEl.innerHTML = transfers
        .map(
          (transfer) => `
            <div class="ex-settlement-row">
              <span>${escapeHtml(transfer.from)}</span>
              <span class="ex-settlement-arrow">&rarr;</span>
              <span>${escapeHtml(transfer.to)}</span>
              <span class="ex-settlement-amount">
                ${formatCents(transfer.cents)}
              </span>
            </div>
          `,
        )
        .join("");

      return transfers.length;
    }

    function renderSummary(transferCount: number) {
      const totalCents = getTotalCents();

      totalEl.textContent = formatCents(totalCents);
      expenseTotalEl.textContent = formatCents(totalCents);
      countEl.textContent = String(people.length);
      expenseCountEl.textContent = String(expenses.length);
      transferCountEl.textContent = String(transferCount);
    }

    function renderAll() {
      renderPeople();
      renderExpenses();
      const transferCount = renderSettlement();
      renderSummary(transferCount);
    }

    function addPerson() {
      const name = personNameInput.value.trim();

      if (!name) {
        showMessage("Enter a person's name.");
        personNameInput.focus();
        return;
      }

      if (
        people.some(
          (person) => person.name.toLowerCase() === name.toLowerCase(),
        )
      ) {
        showMessage("That person is already in the group.");
        personNameInput.select();
        return;
      }

      people.push({
        id: nextPersonId++,
        name,
      });

      personNameInput.value = "";
      showMessage("");
      renderAll();
      personNameInput.focus();
    }

    function addExpense() {
      const desc = descInput.value.trim();
      const amountCents = parseAmountToCents(amountInput.value);
      const payerId = Number(payerSelect.value);

      if (!people.length) {
        showMessage("Add at least one person first.");
        return;
      }

      if (!desc) {
        showMessage("Enter a description.");
        descInput.focus();
        return;
      }

      if (amountCents === null) {
        showMessage("Enter a valid amount, for example 24.50.");
        amountInput.focus();
        return;
      }

      if (!payerId || !people.some((person) => person.id === payerId)) {
        showMessage("Choose who paid the expense.");
        payerSelect.focus();
        return;
      }

      expenses.push({
        id: nextExpenseId++,
        desc,
        amountCents,
        payerId,
      });

      descInput.value = "";
      amountInput.value = "";
      showMessage("");
      renderAll();
      descInput.focus();
    }

    function removePerson(id: number) {
      people = people.filter((person) => person.id !== id);

      // Keep the data model consistent: expenses belonging to a removed
      // payer are removed as well.
      expenses = expenses.filter((expense) => expense.payerId !== id);

      renderAll();
    }

    function resetDemo() {
      people = [];
      expenses = [];
      nextPersonId = 1;
      nextExpenseId = 1;
      showMessage("");
      renderAll();
    }

    function loadExample() {
      people = [
        { id: 1, name: "Alex" },
        { id: 2, name: "Sam" },
        { id: 3, name: "Jo" },
        { id: 4, name: "Mia" },
      ];

      expenses = [
        { id: 1, desc: "Dinner", amountCents: 6000, payerId: 1 },
        { id: 2, desc: "Taxi", amountCents: 1800, payerId: 2 },
        { id: 3, desc: "Tickets", amountCents: 4000, payerId: 3 },
      ];

      nextPersonId = 5;
      nextExpenseId = 4;
      showMessage("");
      renderAll();
    }

    addPersonBtn.addEventListener("click", addPerson);

    personNameInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") addPerson();
    });

    addExpenseBtn.addEventListener("click", addExpense);

    descInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") addExpense();
    });

    amountInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") addExpense();
    });

    peopleListEl.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest<HTMLButtonElement>("[data-person-id]");

      if (!button) return;

      const id = Number(button.dataset.personId);
      if (Number.isInteger(id)) removePerson(id);
    });

    resetBtn.addEventListener("click", resetDemo);
    loadExampleBtn.addEventListener("click", loadExample);

    loadExample();
  })();
</script>
