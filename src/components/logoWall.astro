```astro
---
const technologies = [
  "astro",
  "Java",
  "C",
  "C++",
  "Python",
  "Azure",
  "vue",
  "react",
  "typeScript",
  "tailwindcss",
  "next",
  "nodejs",
  "HTML5",
  "CSS3",
  "javaScript",
  "git",
  "supabase",
  "mysql",
  "bash",
];

const technologyNames: Record<string, string> = {
  astro: "Astro",
  Java: "Java",
  C: "C",
  "C++": "C++",
  Python: "Python",
  Azure: "Azure",
  vue: "Vue.js",
  react: "React",
  typeScript: "TypeScript",
  tailwindcss: "Tailwind CSS",
  next: "Next.js",
  nodejs: "Node.js",
  HTML5: "HTML5",
  CSS3: "CSS3",
  javaScript: "JavaScript",
  git: "Git",
  supabase: "Supabase",
  mysql: "MySQL",
  bash: "Bash",
};

const getIconPath = (tech: string) => {
  return `/svg/${tech.includes(".") ? tech : `${tech}.svg`}`;
};

const getTechnologyName = (tech: string) => {
  return technologyNames[tech] ?? tech;
};
---

<!-- ========================================================= -->
<!-- TECHNOLOGIES -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-10"
  aria-label="Technologies and tools"
>
  <!-- Section title -->
  <div class="mx-auto mb-8 max-w-6xl px-6">
    <div class="flex items-center justify-center gap-4">
      <div class="h-px w-12 bg-white/10"></div>

      <p
        class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
      >
        Technologies
      </p>

      <div class="h-px w-12 bg-white/10"></div>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- TECHNOLOGY WALL -->
  <!-- ========================================================= -->

  <div class="technology-wall relative overflow-x-hidden py-6">

    <!-- Left fade -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-20 w-24 bg-gradient-to-r from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- Right fade -->
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-20 w-24 bg-gradient-to-l from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- ======================================================= -->
    <!-- MARQUEE -->
    <!-- ======================================================= -->

    <div class="flex w-max animate-scroll will-change-transform">

      {
        [...technologies, ...technologies].map((tech, index) => (
          <div
            class="group flex shrink-0 items-center gap-3 pr-12 transition-all duration-300 md:pr-20"
            aria-hidden={
              index >= technologies.length ? "true" : "false"
            }
          >
            <!-- Technology icon -->
            <div class="flex h-8 w-8 items-center justify-center">
              <img
                src={getIconPath(tech)}
                alt={
                  index < technologies.length
                    ? getTechnologyName(tech)
                    : ""
                }
                class="h-7 w-7 object-contain opacity-60 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100"
                width="28"
                height="28"
                loading={
                  index < technologies.length
                    ? "eager"
                    : "lazy"
                }
                decoding="async"
              />
            </div>

            <!-- Technology name -->
            <span
              class="whitespace-nowrap text-lg font-medium text-[var(--white-icon)] opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            >
              {getTechnologyName(tech)}
            </span>
          </div>
        ))
      }

    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ORGANIZATIONS -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-16 md:py-24"
  aria-label="Organizations"
>
  <div class="mx-auto max-w-7xl px-6">

    <!-- ===================================================== -->
    <!-- SECTION HEADER -->
    <!-- ===================================================== -->

    <div class="mb-12 text-center">
      <div class="mb-4 flex items-center justify-center gap-4">
        <div class="h-px w-12 bg-white/10"></div>

        <p
          class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
        >
          Organizations
        </p>

        <div class="h-px w-12 bg-white/10"></div>
      </div>

      <p
        class="mx-auto max-w-xl text-sm leading-relaxed text-[var(--white-icon)] opacity-40"
      >
        Organizations and institutions I'm part of.
      </p>
    </div>

    <!-- ===================================================== -->
    <!-- UPV CARD -->
    <!-- ===================================================== -->

    <div class="flex justify-center">

      <div
        class="
          upv-card
          group
          relative
          flex
          w-full
          max-w-6xl
          items-center
          gap-16
          overflow-hidden
          rounded-[2rem]
          border
          border-white/10
          bg-white/[0.035]
          px-10
          py-10
          backdrop-blur-2xl
          transition-all
          duration-500
          hover:border-white/20
          hover:bg-white/[0.06]
          hover:shadow-[0_30px_100px_rgba(0,0,0,0.30)]
          md:gap-24
          md:px-16
          md:py-12
          lg:px-20
          lg:py-14
        "
      >

        <!-- ================================================= -->
        <!-- BLUE AMBIENT GLOW -->
        <!-- ================================================= -->

        <div
          class="
            pointer-events-none
            absolute
            -left-40
            -top-40
            h-[32rem]
            w-[32rem]
            rounded-full
            bg-blue-500/10
            blur-[100px]
            opacity-0
            transition-opacity
            duration-700
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

        <div
          class="
            pointer-events-none
            absolute
            -bottom-40
            -right-40
            h-[28rem]
            w-[28rem]
            rounded-full
            bg-indigo-500/[0.07]
            blur-[100px]
            opacity-0
            transition-opacity
            duration-700
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

        <!-- ================================================= -->
        <!-- MASSIVE UPV LOGO -->
        <!-- ================================================= -->

        <div
          class="
            upv-logo-wrapper
            relative
            flex
            h-72
            w-[26rem]
            shrink-0
            items-center
            justify-center
            transition-transform
            duration-700
            group-hover:scale-[1.04]
            md:h-80
            md:w-[30rem]
            lg:h-96
            lg:w-[34rem]
          "
        >

          <img
            src="/svg/UPV.jpg"
            alt="Universitat Politècnica de València"
            class="
              upv-logo
              block
              h-full
              w-full
              object-contain
              transition-transform
              duration-700
              group-hover:scale-[1.10]
            "
            width="544"
            height="384"
            loading="lazy"
            decoding="async"
          />

        </div>

        <!-- ================================================= -->
        <!-- UPV INFORMATION -->
        <!-- ================================================= -->

        <div class="relative min-w-0 flex-1">

          <p
            class="
              mb-3
              text-xs
              font-semibold
              uppercase
              tracking-[0.25em]
              text-[var(--white-icon)]
              opacity-40
            "
          >
            University
          </p>

          <h3
            class="
              text-3xl
              font-semibold
              leading-[1.15]
              tracking-tight
              text-[var(--white)]
              md:text-4xl
              lg:text-5xl
            "
          >
            Universitat Politècnica
            <br class="hidden sm:block" />
            de València
          </h3>

          <p
            class="
              mt-5
              text-base
              font-medium
              tracking-wide
              text-[var(--white-icon)]
              opacity-50
              md:text-lg
            "
          >
            UPV
          </p>

        </div>

        <!-- ================================================= -->
        <!-- SUBTLE HIGHLIGHT -->
        <!-- ================================================= -->

        <div
          class="
            pointer-events-none
            absolute
            inset-x-0
            top-0
            h-px
            bg-gradient-to-r
            from-transparent
            via-white/20
            to-transparent
            opacity-0
            transition-opacity
            duration-500
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

      </div>
    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ANIMATIONS -->
<!-- ========================================================= -->

<style is:global>

  /* ========================================================= */
  /* TECHNOLOGY MARQUEE */
  /* ========================================================= */

  @keyframes scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  /* Pause when cursor enters technology wall */
  .technology-wall:hover .animate-scroll {
    animation-play-state: paused;
  }

  /* Keep normal/default cursor */
  .technology-wall,
  .technology-wall * {
    cursor: default !important;
  }

  /* ========================================================= */
  /* DESKTOP */
  /* ========================================================= */

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }

  /* ========================================================= */
  /* REDUCED MOTION */
  /* ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation-play-state: paused;
    }
  }

  /* ========================================================= */
  /* MOBILE */
  /* ========================================================= */

  @media (max-width: 767px) {

    .upv-card {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
      padding: 2rem 1.5rem 2.5rem;
    }

    .upv-logo-wrapper {
      width: 100%;
      height: 18rem;
    }

    .upv-card h3 {
      font-size: 2rem;
    }

    .upv-card p {
      text-align: center;
    }
  }

  /* ========================================================= */
  /* SMALL MOBILE */
  /* ========================================================= */

  @media (max-width: 480px) {

    .upv-logo-wrapper {
      height: 15rem;
    }

    .upv-card h3 {
      font-size: 1.7rem;
    }
  }

</style>
```
