---
const technologies = [
  "astro",
  "Java",
  "C",
  "C++",
  "Python",
  "Azure",
  "vue",
  "react",
  "typeScript",
  "tailwindcss",
  "next",
  "nodejs",
  "HTML5",
  "CSS3",
  "javaScript",
  "git",
  "supabase",
  "mysql",
  "bash",
];

const technologyNames: Record<string, string> = {
  astro: "Astro",
  Java: "Java",
  C: "C",
  "C++": "C++",
  Python: "Python",
  Azure: "Azure",
  vue: "Vue.js",
  react: "React",
  typeScript: "TypeScript",
  tailwindcss: "Tailwind CSS",
  next: "Next.js",
  nodejs: "Node.js",
  HTML5: "HTML5",
  CSS3: "CSS3",
  javaScript: "JavaScript",
  git: "Git",
  supabase: "Supabase",
  mysql: "MySQL",
  bash: "Bash",
};

const getIconPath = (tech: string) => {
  return `/svg/${tech.includes(".") ? tech : `${tech}.svg`}`;
};

const getTechnologyName = (tech: string) => {
  return technologyNames[tech] ?? tech;
};
---

<!-- ========================================================= -->
<!-- TECHNOLOGIES -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-10"
  aria-label="Technologies and tools"
>
  <div class="mx-auto mb-8 max-w-6xl px-6">
    <div class="flex items-center justify-center gap-4">
      <div class="h-px w-12 bg-white/10"></div>

      <p
        class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
      >
        Technologies
      </p>

      <div class="h-px w-12 bg-white/10"></div>
    </div>
  </div>

  <div class="technology-wall relative overflow-x-hidden py-6">

    <!-- Left fade -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-20 w-24 bg-gradient-to-r from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- Right fade -->
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-20 w-24 bg-gradient-to-l from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- Scrolling content -->
    <div class="flex w-max animate-scroll will-change-transform">
      {
        [...technologies, ...technologies].map((tech, index) => (
          <div
            class="group flex shrink-0 items-center gap-3 pr-12 transition-all duration-300 md:pr-20"
            aria-hidden={
              index >= technologies.length ? "true" : "false"
            }
          >
            <!-- Icon -->
            <div class="flex h-8 w-8 items-center justify-center">
              <img
                src={getIconPath(tech)}
                alt={
                  index < technologies.length
                    ? getTechnologyName(tech)
                    : ""
                }
                class="h-7 w-7 object-contain opacity-60 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100"
                width="28"
                height="28"
                loading={
                  index < technologies.length
                    ? "eager"
                    : "lazy"
                }
                decoding="async"
              />
            </div>

            <!-- Name -->
            <span
              class="whitespace-nowrap text-lg font-medium text-[var(--white-icon)] opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            >
              {getTechnologyName(tech)}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ORGANIZATIONS -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-14 md:py-20"
  aria-label="Organizations"
>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="mb-10 text-center">
      <div class="mb-4 flex items-center justify-center gap-4">
        <div class="h-px w-12 bg-white/10"></div>

        <p
          class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
        >
          Organizations
        </p>

        <div class="h-px w-12 bg-white/10"></div>
      </div>

      <p
        class="mx-auto max-w-xl text-sm leading-relaxed text-[var(--white-icon)] opacity-40"
      >
        Organizations and institutions I'm part of.
      </p>
    </div>

    <!-- ===================================================== -->
    <!-- UPV CARD -->
    <!-- ===================================================== -->

    <div class="flex justify-center">
      <div
        class="
          group relative
          flex w-full max-w-2xl
          items-center
          gap-8
          overflow-hidden
          rounded-3xl
          border border-white/10
          bg-white/[0.035]
          px-7 py-8
          backdrop-blur-2xl
          transition-all duration-500
          hover:border-white/20
          hover:bg-white/[0.06]
          hover:shadow-[0_20px_70px_rgba(0,0,0,0.25)]
          md:gap-10
          md:px-10
          md:py-9
        "
      >

        <!-- Blue glow -->
        <div
          class="
            pointer-events-none
            absolute
            -left-24
            -top-24
            h-56
            w-56
            rounded-full
            bg-blue-500/10
            blur-3xl
            opacity-0
            transition-opacity
            duration-500
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

        <!-- ================================================= -->
        <!-- UPV LOGO -->
        <!-- ================================================= -->

        <div
          class="
            relative
            flex
            h-36
            w-44
            shrink-0
            items-center
            justify-center
            overflow-hidden
            rounded-2xl
            border
            border-white/10
            bg-white/[0.06]
            p-2
            transition-all
            duration-500
            group-hover:scale-[1.03]
            group-hover:border-white/20
            group-hover:bg-white/[0.09]
          "
        >
          <img
            src="/svg/UPV.jpg"
            alt="Universitat Politècnica de València"
            class="
              block
              h-full
              w-full
              object-contain
              transition-transform
              duration-500
              group-hover:scale-105
            "
            width="176"
            height="144"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- ================================================= -->
        <!-- UPV INFORMATION -->
        <!-- ================================================= -->

        <div class="relative min-w-0 pr-4">

          <p
            class="
              mb-2
              text-xs
              font-semibold
              uppercase
              tracking-[0.2em]
              text-[var(--white-icon)]
              opacity-40
            "
          >
            University
          </p>

          <h3
            class="
              text-xl
              font-semibold
              leading-snug
              text-[var(--white)]
              md:text-2xl
            "
          >
            Universitat Politècnica
            <br class="hidden sm:block" />
            de València
          </h3>

          <p
            class="
              mt-2
              text-sm
              font-medium
              text-[var(--white-icon)]
              opacity-50
            "
          >
            UPV
          </p>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ANIMATIONS -->
<!-- ========================================================= -->

<style is:global>
  @keyframes scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  /* Pause carousel on hover */
  .technology-wall:hover .animate-scroll {
    animation-play-state: paused;
  }

  /* Normal cursor — no pointer arrow */
  .technology-wall,
  .technology-wall * {
    cursor: default !important;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation-play-state: paused;
    }
  }

  /* ========================================================= */
  /* MOBILE */
  /* ========================================================= */

  @media (max-width: 640px) {
    .group.relative.flex {
      gap: 1rem;
    }
  }
</style>