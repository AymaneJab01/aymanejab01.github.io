
---
const technologies = [
  "astro",
  "Java",
  "C",
  "C++",
  "Python",
  "Azure",
  "vue",
  "react",
  "typeScript",
  "tailwindcss",
  "next",
  "nodejs",
  "HTML5",
  "CSS3",
  "javaScript",
  "git",
  "supabase",
  "mysql",
  "bash",
];

const technologyNames: Record<string, string> = {
  astro: "Astro",
  Java: "Java",
  C: "C",
  "C++": "C++",
  Python: "Python",
  Azure: "Azure",
  vue: "Vue.js",
  react: "React",
  typeScript: "TypeScript",
  tailwindcss: "Tailwind CSS",
  next: "Next.js",
  nodejs: "Node.js",
  HTML5: "HTML5",
  CSS3: "CSS3",
  javaScript: "JavaScript",
  git: "Git",
  supabase: "Supabase",
  mysql: "MySQL",
  bash: "Bash",
};

const getIconPath = (tech: string) => {
  return `/svg/${tech}.svg`;
};

const getTechnologyName = (tech: string) => {
  return technologyNames[tech] ?? tech;
};
---

<!-- ========================================================= -->
<!-- TECHNOLOGIES -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-10"
  aria-label="Technologies and tools"
>
  <!-- Section title -->
  <div class="mx-auto mb-8 max-w-6xl px-6">
    <div class="flex items-center justify-center gap-4">
      <div class="h-px w-12 bg-white/10"></div>

      <p
        class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
      >
        Technologies
      </p>

      <div class="h-px w-12 bg-white/10"></div>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- TECHNOLOGY WALL -->
  <!-- ========================================================= -->

  <div
    class="technology-wall relative overflow-x-hidden py-6"
  >
    <!-- Left fade -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-20 w-24 bg-gradient-to-r from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- Right fade -->
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-20 w-24 bg-gradient-to-l from-[var(--background)] via-[var(--background)]/80 to-transparent md:w-40"
      aria-hidden="true"
    ></div>

    <!-- Scrolling content -->
    <div class="flex w-max animate-scroll will-change-transform">
      {
        [...technologies, ...technologies].map((tech, index) => (
          <div
            class="group flex shrink-0 items-center gap-3 pr-12 transition-all duration-300 md:pr-20"
            aria-hidden={index >= technologies.length ? "true" : "false"}
          >
            <!-- Technology icon -->
            <div class="flex h-8 w-8 items-center justify-center">
              <img
                src={getIconPath(tech)}
                alt={
                  index < technologies.length
                    ? getTechnologyName(tech)
                    : ""
                }
                class="h-7 w-7 object-contain opacity-60 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100"
                width="28"
                height="28"
                loading={index < technologies.length ? "eager" : "lazy"}
                decoding="async"
              />
            </div>

            <!-- Technology name -->
            <span
              class="whitespace-nowrap text-lg font-medium text-[var(--white-icon)] opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            >
              {getTechnologyName(tech)}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ORGANIZATIONS -->
<!-- ========================================================= -->

<section
  class="relative overflow-hidden py-14 md:py-20"
  aria-label="Organizations"
>
  <div class="mx-auto max-w-6xl px-6">

    <!-- ===================================================== -->
    <!-- SECTION HEADER -->
    <!-- ===================================================== -->

    <div class="mb-10 text-center">
      <div class="mb-4 flex items-center justify-center gap-4">
        <div class="h-px w-12 bg-white/10"></div>

        <p
          class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--white-icon)] opacity-50"
        >
          Organizations
        </p>

        <div class="h-px w-12 bg-white/10"></div>
      </div>

      <p
        class="mx-auto max-w-xl text-sm leading-relaxed text-[var(--white-icon)] opacity-40"
      >
        Organizations and institutions I'm part of.
      </p>
    </div>

    <!-- ===================================================== -->
    <!-- UPV CARD -->
    <!-- ===================================================== -->

    <div class="flex justify-center">
      <div
        class="
          upv-card
          group
          relative
          flex
          w-full
          max-w-4xl
          items-center
          gap-12
          overflow-hidden
          rounded-3xl
          border
          border-white/10
          bg-white/[0.035]
          px-8
          py-8
          backdrop-blur-2xl
          transition-all
          duration-500
          hover:border-white/20
          hover:bg-white/[0.06]
          hover:shadow-[0_20px_70px_rgba(0,0,0,0.25)]
          md:gap-16
          md:px-12
          md:py-10
        "
      >

        <!-- ================================================= -->
        <!-- LARGE AMBIENT BLUE GLOW -->
        <!-- ================================================= -->

        <div
          class="
            pointer-events-none
            absolute
            -left-32
            -top-32
            h-80
            w-80
            rounded-full
            bg-blue-500/10
            blur-3xl
            opacity-0
            transition-all
            duration-700
            group-hover:scale-125
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

        <!-- ================================================= -->
        <!-- SECONDARY BLUE LIGHT -->
        <!-- ================================================= -->

        <div
          class="
            pointer-events-none
            absolute
            left-1/4
            top-1/2
            h-40
            w-72
            -translate-y-1/2
            rounded-full
            bg-blue-400/[0.04]
            blur-3xl
            opacity-0
            transition-opacity
            duration-700
            group-hover:opacity-100
          "
          aria-hidden="true"
        ></div>

        <!-- ================================================= -->
        <!-- PREMIUM UPV LOGO -->
        <!-- ================================================= -->

        <div
          class="
            upv-logo-area
            relative
            flex
            h-60
            w-80
            shrink-0
            items-center
            justify-center
          "
        >

          <!-- Main logo glow -->
          <div
            class="
              pointer-events-none
              absolute
              left-1/2
              top-1/2
              h-44
              w-64
              -translate-x-1/2
              -translate-y-1/2
              rounded-full
              bg-blue-500/10
              blur-3xl
              opacity-60
              transition-all
              duration-700
              group-hover:scale-125
              group-hover:bg-blue-400/15
              group-hover:opacity-100
            "
            aria-hidden="true"
          ></div>

          <!-- Secondary white glow -->
          <div
            class="
              pointer-events-none
              absolute
              left-1/2
              top-1/2
              h-28
              w-56
              -translate-x-1/2
              -translate-y-1/2
              rounded-full
              bg-white/5
              blur-2xl
              opacity-50
              transition-all
              duration-700
              group-hover:scale-110
              group-hover:opacity-80
            "
            aria-hidden="true"
          ></div>

          <!-- UPV image -->
          <img
            src="/svg/UPV.jpg"
            alt="Universitat Politècnica de València"
            class="
              upv-logo
              relative
              z-10
              block
              h-full
              w-full
              object-contain
              opacity-90
              brightness-110
              contrast-105
              drop-shadow-[0_10px_30px_rgba(0,0,0,0.35)]
              transition-all
              duration-700
              group-hover:scale-105
              group-hover:opacity-100
              group-hover:brightness-110
              group-hover:drop-shadow-[0_16px_40px_rgba(30,100,255,0.25)]
            "
            width="320"
            height="240"
            loading="lazy"
            decoding="async"
          />

          <!-- Bottom reflection -->
          <div
            class="
              pointer-events-none
              absolute
              inset-x-8
              bottom-2
              z-20
              h-px
              bg-gradient-to-r
              from-transparent
              via-white/20
              to-transparent
              opacity-40
              transition-opacity
              duration-500
              group-hover:opacity-70
            "
            aria-hidden="true"
          ></div>

        </div>

        <!-- ================================================= -->
        <!-- UPV INFORMATION -->
        <!-- ================================================= -->

        <div class="relative min-w-0">

          <!-- Small category -->
          <p
            class="
              mb-3
              text-xs
              font-semibold
              uppercase
              tracking-[0.2em]
              text-[var(--white-icon)]
              opacity-40
            "
          >
            University
          </p>

          <!-- University name -->
          <h3
            class="
              text-2xl
              font-semibold
              leading-snug
              text-[var(--white)]
              md:text-3xl
            "
          >
            Universitat Politècnica
            <br class="hidden sm:block" />
            de València
          </h3>

          <!-- Short name -->
          <p
            class="
              mt-3
              text-sm
              font-medium
              text-[var(--white-icon)]
              opacity-50
            "
          >
            UPV
          </p>

          <!-- Small accent line -->
          <div
            class="
              mt-6
              h-px
              w-16
              bg-gradient-to-r
              from-blue-400/60
              to-transparent
              transition-all
              duration-500
              group-hover:w-24
            "
            aria-hidden="true"
          ></div>

        </div>

        <!-- ================================================= -->
        <!-- TOP GLASS HIGHLIGHT -->
        <!-- ================================================= -->

        <div
          class="
            pointer-events-none
            absolute
            inset-x-8
            top-0
            h-px
            bg-gradient-to-r
            from-transparent
            via-white/15
            to-transparent
            opacity-60
          "
          aria-hidden="true"
        ></div>

      </div>
    </div>
  </div>
</section>

<!-- ========================================================= -->
<!-- ANIMATIONS -->
<!-- ========================================================= -->

<style is:global>
  /* ========================================================= */
  /* TECHNOLOGY SCROLL */
  /* ========================================================= */

  @keyframes scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  /* Pause technology wall on hover */
  .technology-wall:hover .animate-scroll {
    animation-play-state: paused;
  }

  /* Normal cursor */
  .technology-wall,
  .technology-wall * {
    cursor: default !important;
  }

  /* ========================================================= */
  /* DESKTOP */
  /* ========================================================= */

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }

  /* ========================================================= */
  /* REDUCED MOTION */
  /* ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation-play-state: paused;
    }
  }

  /* ========================================================= */
  /* MOBILE */
  /* ========================================================= */

  @media (max-width: 640px) {
    section[aria-label="Organizations"] .upv-card {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
      padding: 2rem 1.5rem;
    }

    section[aria-label="Organizations"] .upv-logo-area {
      height: 14rem;
      width: 19rem;
    }

    section[aria-label="Organizations"] .upv-card > div:last-of-type {
      padding-right: 0;
    }

    section[aria-label="Organizations"] .upv-card .h-px.w-16 {
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* ========================================================= */
  /* SMALL MOBILE */
  /* ========================================================= */

  @media (max-width: 420px) {
    section[aria-label="Organizations"] .upv-logo-area {
      height: 12rem;
      width: 16rem;
    }

    section[aria-label="Organizations"] .upv-card {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>

