<script>
  interface WeatherData {
    current: {
      temperature_2m: number;
      weather_code: number;
    };
  }

  interface WeatherLocation {
    latitude: number;
    longitude: number;
    temperatureElement: string;
    statusElement: string;
  }

  const weatherLocations: WeatherLocation[] = [
    {
      latitude: 38.6983,
      longitude: -0.4743,
      temperatureElement: "weather-alcoi-temperature",
      statusElement: "weather-alcoi-status",
    },
    {
      latitude: 39.4699,
      longitude: -0.3763,
      temperatureElement: "weather-valencia-temperature",
      statusElement: "weather-valencia-status",
    },
  ];

  function getWeatherDescription(code: number): string {
    if (code === 0) return "Clear";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Cloudy";
    if (code === 45 || code === 48) return "Fog";
    if (code >= 51 && code <= 57) return "Drizzle";
    if (code >= 61 && code <= 67) return "Rain";
    if (code >= 71 && code <= 77) return "Snow";
    if (code >= 80 && code <= 82) return "Showers";
    if (code >= 85 && code <= 86) return "Snow showers";
    if (code >= 95 && code <= 99) return "Thunderstorm";

    return "Unknown";
  }

  async function loadWeather(location: WeatherLocation) {
    const temperatureElement = document.getElementById(
      location.temperatureElement
    );

    const statusElement = document.getElementById(
      location.statusElement
    );

    if (!temperatureElement || !statusElement) return;

    try {
      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${location.latitude}` +
        `&longitude=${location.longitude}` +
        `&current=temperature_2m,weather_code` +
        `&timezone=Europe%2FMadrid`;

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Weather request failed");
      }

      const data = (await response.json()) as WeatherData;

      const temperature = data.current.temperature_2m;
      const weatherCode = data.current.weather_code;

      temperatureElement.textContent =
        `${Math.round(temperature)}°C`;

      statusElement.textContent =
        getWeatherDescription(weatherCode);

    } catch {
      temperatureElement.textContent = "--°C";
      statusElement.textContent = "Unavailable";
    }
  }

  function loadAllWeather() {
    weatherLocations.forEach((location) => {
      void loadWeather(location);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadAllWeather);
  } else {
    loadAllWeather();
  }
</script>