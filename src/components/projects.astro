      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.085),
        rgba(255, 255, 255, 0.025) 48%,
        rgba(255, 255, 255, 0.045)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(255, 255, 255, 0.025),
      0 30px 90px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(32px) saturate(135%);
    -webkit-backdrop-filter: blur(32px) saturate(135%);
    transition:
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 400ms ease,
      box-shadow 500ms ease;
  }

  .project-card:hover {
    transform: translateY(-7px);
    border-color: rgba(52, 211, 153, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 40px 110px rgba(0, 0, 0, 0.34),
      0 0 70px rgba(52, 211, 153, 0.055);
  }

  .glass-reflection {
    position: absolute;
    z-index: 0;
    top: -80%;
    left: -20%;
    width: 70%;
    height: 180%;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 255, 255, 0.045) 47%,
      rgba(255, 255, 255, 0.09) 50%,
      rgba(255, 255, 255, 0.02) 54%,
      transparent 65%
    );
    transform: rotate(7deg);
    transition: transform 900ms ease;
  }

  .project-card:hover .glass-reflection {
    transform: translateX(35%) rotate(7deg);
  }

  .card-glow {
    position: absolute;
    z-index: 0;
    width: 320px;
    height: 320px;
    right: -150px;
    bottom: -170px;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.055);
    filter: blur(60px);
    transition: opacity 500ms ease, transform 700ms ease;
  }

  .project-card:hover .card-glow {
    opacity: 1.7;
    transform: scale(1.25);
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.8rem;
  }

  .project-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .project-label .number {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.045);
    color: #a7f3d0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
  }

  .label-line {
    width: 35px;
    height: 1px;
    background: rgba(52, 211, 153, 0.35);
  }

  .project-index {
    color: rgba(255, 255, 255, 0.25);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
  }

  .card-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.5fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
  }

  .project-info h2 {
    margin: 0;
    color: rgba(255, 255, 255, 0.96);
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.045em;
    transition: color 300ms ease;
  }

  .project-info h2 span {
    color: #34d399;
  }

  .project-card:hover .project-info h2 {
    color: #ecfdf5;
  }

  .project-info > p {
    max-width: 700px;
    margin-top: 1.3rem;
    color: rgba(226, 232, 230, 0.61);
    font-size: 1rem;
    line-height: 1.8;
  }

  .secondary-description {
    opacity: 0.55;
    font-size: 0.88rem !important;
  }

  /* ================================================================
     TAGS
  ================================================================= */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.8rem;
  }

  .tags span {
    padding: 0.48rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.095);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.52);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.63rem;
    letter-spacing: 0.02em;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      border-color 300ms ease,
      background 300ms ease,
      color 300ms ease;
  }

  .project-card:hover .tags span {
    border-color: rgba(52, 211, 153, 0.16);
    background: rgba(52, 211, 153, 0.045);
  }

  /* ================================================================
     ACTION
  ================================================================= */

  .project-action {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.5rem;
    padding: 0.7rem 0.85rem 0.7rem 1rem;
    border: 1px solid rgba(52, 211, 153, 0.18);
    border-radius: 999px;
    background: rgba(52, 211, 153, 0.055);
    color: #86efac;
    font-size: 0.78rem;
    font-weight: 500;
    transition:
      transform 300ms ease,
      background 300ms ease,
      border-color 300ms ease;
  }

  .project-action .arrow {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    font-size: 1rem;
    transition: transform 300ms ease;
  }

  .project-card:hover .project-action {
    transform: translateX(3px);
    border-color: rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.09);
  }

  .project-card:hover .project-action .arrow {
    transform: translate(2px, -2px);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* ================================================================
     ICONS
  ================================================================= */

  .mini-icon {
    display: grid;
    width: 48px;
    height: 48px;
    margin-bottom: 1.4rem;
    place-items: center;
    border: 1px solid rgba(52, 211, 153, 0.16);
    border-radius: 15px;
    background: rgba(52, 211, 153, 0.055);
    color: #6ee7b7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 10px 35px rgba(52, 211, 153, 0.05);
  }

  /* ================================================================
     VISUALS
  ================================================================= */

  .visual {
    position: relative;
    min-height: 250px;
    display: grid;
    place-items: center;
  }

  /* TERMINAL */

  .terminal-window {
    width: min(100%, 330px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;
    background: rgba(3, 10, 7, 0.55);
    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
  }

  .window-bar {
    display: flex;
    gap: 6px;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .window-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .terminal-body {
    padding: 1.3rem;
    color: rgba(255, 255, 255, 0.58);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    line-height: 2;
  }

  .terminal-body b {
    color: #a7f3d0;
    font-weight: 500;
  }

  .terminal-body .muted {
    color: rgba(255, 255, 255, 0.3);
  }

  .terminal-body .green {
    color: #34d399;
  }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 12px;
    vertical-align: middle;
    background: #34d399;
    animation: blink 1s steps(2) infinite;
  }

  /* MOVIE */

  .poster-glass {
    position: relative;
    width: 165px;
    height: 235px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.17);
    border-radius: 22px;
    background:
      radial-gradient(
        circle at 50% 25%,
        rgba(52, 211, 153, 0.25),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.12),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow:
      25px 30px 70px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: rotate(4deg);
  }

  .poster-shine {
    position: absolute;
    width: 100%;
    height: 70%;
    background: linear-gradient(
      125deg,
      transparent 35%,
      rgba(255, 255, 255, 0.12),
      transparent 62%
    );
  }

  .poster-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.2rem;
  }

  .poster-content small {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.5rem;
    letter-spacing: 0.18em;
  }

  .poster-content strong {
    font-size: 1.55rem;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .poster-content span {
    align-self: flex-end;
    color: #6ee7b7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }

  .movie-meta,
  .expense-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.7rem;
  }

  .movie-meta small,
  .expense-meta small,
  .feature-line small {
    display: block;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .movie-meta strong,
  .expense-meta strong,
  .feature-line strong {
    display: block;
    margin-top: 0.35rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .movie-meta .rating {
    color: #6ee7b7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .rating span {
    color: rgba(255, 255, 255, 0.3);
  }

  .meta-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* WEATHER */

  .weather-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    top: -200px;
    right: -100px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.08);
    filter: blur(80px);
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(110, 231, 183, 0.7);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
  }

  .live-indicator span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.8);
    animation: pulse 2s infinite;
  }

  .weather-locations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 1.7rem;
  }

  .weather-location {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(15px);
  }

  .weather-location small {
    display: block;
    color: rgba(255, 255, 255, 0.28);
    font-size: 0.5rem;
    letter-spacing: 0.15em;
  }

  .weather-location strong {
    display: block;
    margin-top: 0.3rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .weather-value {
    text-align: right;
  }

  .weather-value strong {
    color: #6ee7b7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .weather-value span {
    display: block;
    margin-top: 0.25rem;
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.55rem;
  }

  .weather-sphere {
    position: relative;
    width: 205px;
    height: 205px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 35% 28%,
        rgba(255, 255, 255, 0.3),
        transparent 10%
      ),
      radial-gradient(
        circle at 50% 50%,
        rgba(52, 211, 153, 0.14),
        rgba(3, 15, 10, 0.2) 60%,
        rgba(0, 0, 0, 0.3)
      );
    box-shadow:
      inset -20px -25px 50px rgba(0, 0, 0, 0.35),
      inset 10px 10px 25px rgba(255, 255, 255, 0.06),
      0 30px 80px rgba(0, 0, 0, 0.3);
  }

  .sun {
    position: absolute;
    width: 55px;
    height: 55px;
    top: 35px;
    left: 40px;
    border-radius: 50%;
    background: rgba(167, 243, 208, 0.85);
    box-shadow: 0 0 50px rgba(52, 211, 153, 0.5);
  }

  .cloud {
    position: absolute;
    width: 70px;
    height: 25px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    filter: blur(1px);
  }

  .cloud-one {
    right: 25px;
    bottom: 55px;
  }

  .cloud-two {
    bottom: 75px;
    left: 30px;
    transform: scale(0.7);
  }

  .orbit {
    position: absolute;
    inset: -15px;
    border: 1px solid rgba(110, 231, 183, 0.12);
    border-radius: 50%;
    transform: rotate(25deg);
  }

  .orbit-two {
    inset: 12px;
    transform: rotate(-35deg);
  }

  /* ================================================================
     ALGORITHM
  ================================================================= */

  .algorithm-grid,
  .circuit-grid {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px);
    background-size: 35px 35px;
    mask-image: radial-gradient(circle at 70% 50%, black, transparent 65%);
    -webkit-mask-image: radial-gradient(circle at 70% 50%, black, transparent 65%);
  }

  .feature-line {
    margin-top: 1.6rem;
  }

  .algorithm-bars {
    display: flex;
    width: 240px;
    height: 180px;
    align-items: end;
    justify-content: center;
    gap: 7px;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.12);
  }

  .algorithm-bars span {
    width: 14px;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(
      to top,
      rgba(52, 211, 153, 0.18),
      rgba(110, 231, 183, 0.75)
    );
    box-shadow: 0 0 18px rgba(52, 211, 153, 0.08);
    animation: bars 3s ease-in-out infinite alternate;
  }

  .algorithm-bars span:nth-child(2) { animation-delay: .2s; }
  .algorithm-bars span:nth-child(3) { animation-delay: .4s; }
  .algorithm-bars span:nth-child(4) { animation-delay: .6s; }
  .algorithm-bars span:nth-child(5) { animation-delay: .8s; }

  /* ================================================================
     NETWORK
  ================================================================= */

  .network-visual {
    height: 250px;
  }

  .network-node {
    position: absolute;
    z-index: 3;
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
    border: 1px solid rgba(110, 231, 183, 0.28);
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.07);
    color: #a7f3d0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 0 30px rgba(52, 211, 153, 0.06);
  }

  .node-a {
    top: 30px;
    left: 20px;
  }

  .node-b {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .node-c {
    right: 20px;
    bottom: 30px;
  }

  .connection {
    position: absolute;
    height: 1px;
    transform-origin: left center;
    background: linear-gradient(
      90deg,
      rgba(52, 211, 153, 0.08),
      rgba(110, 231, 183, 0.5),
      rgba(52, 211, 153, 0.08)
    );
  }

  .connection-one {
    top: 65px;
    left: 68px;
    width: 130px;
    transform: rotate(24deg);
  }

  .connection-two {
    top: 132px;
    left: 125px;
    width: 120px;
    transform: rotate(34deg);
  }

  .connection-three {
    top: 80px;
    left: 135px;
    width: 100px;
    transform: rotate(140deg);
    opacity: 0.35;
  }

  .packet {
    position: absolute;
    z-index: 4;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6ee7b7;
    box-shadow: 0 0 15px rgba(110, 231, 183, 0.8);
  }

  .packet-one {
    animation: packet-one 3s linear infinite;
  }

  .packet-two {
    animation: packet-two 3s linear infinite 1.2s;
  }

  /* ================================================================
     CPU
  ================================================================= */

  .cpu-visual {
    flex-direction: column;
    gap: 1rem;
  }

  .cpu-chip {
    position: relative;
    display: grid;
    width: 155px;
    height: 155px;
    place-items: center;
    border: 1px solid rgba(110, 231, 183, 0.25);
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        rgba(52, 211, 153, 0.1),
        rgba(255, 255, 255, 0.035)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 30px 70px rgba(0, 0, 0, 0.3);
  }

  .chip-core {
    display: grid;
    width: 78px;
    height: 78px;
    place-items: center;
    border: 1px solid rgba(110, 231, 183, 0.25);
    border-radius: 17px;
    background: rgba(0, 0, 0, 0.2);
    color: #a7f3d0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    box-shadow: 0 0 35px rgba(52, 211, 153, 0.08);
  }

  .pin {
    position: absolute;
    width: 16px;
    height: 2px;
    background: rgba(110, 231, 183, 0.35);
  }

  .p1 { top: 25px; left: -10px; }
  .p2 { top: 55px; left: -10px; }
  .p3 { top: 85px; left: -10px; }
  .p4 { top: 115px; left: -10px; }
  .p5 { top: 25px; right: -10px; }
  .p6 { top: 55px; right: -10px; }
  .p7 { top: 85px; right: -10px; }
  .p8 { top: 115px; right: -10px; }

  .registers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
    width: 155px;
  }

  .registers span {
    padding: 0.45rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.025);
    color: rgba(255, 255, 255, 0.35);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
  }

  /* ================================================================
     EXPENSE
  ================================================================= */

  .expense-orb {
    position: absolute;
    width: 350px;
    height: 350px;
    top: -180px;
    left: -160px;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.065);
    filter: blur(60px);
  }

  .phone-glass {
    width: 190px;
    min-height: 270px;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.1),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow:
      20px 30px 80px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    transform: rotate(-4deg);
    backdrop-filter: blur(20px);
  }

  .phone-header {
    display: flex;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.65rem;
  }

  .balance {
    margin: 1.5rem 0;
    padding: 1rem;
    border-radius: 16px;
    background: rgba(52, 211, 153, 0.06);
  }

  .balance small {
    display: block;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.5rem;
  }

  .balance strong {
    display: block;
    margin-top: 0.35rem;
    color: #a7f3d0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.25rem;
  }

  .expense-row {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.62rem;
  }

  .expense-row strong {
    color: rgba(255, 255, 255, 0.68);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 500;
  }

  /* ================================================================
     ANIMATIONS
  ================================================================= */

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
      transform: scale(0.7);
    }
  }

  @keyframes bars {
    from {
      transform: scaleY(0.88);
    }
    to {
      transform: scaleY(1.04);
    }
  }

  @keyframes packet-one {
    0% {
      top: 65px;
      left: 68px;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    50% {
      top: 125px;
      left: 125px;
