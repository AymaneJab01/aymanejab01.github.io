<script>
  interface WeatherData {
    current: {
      temperature_2m: number;
      weather_code: number;
    };
  }

  interface WeatherLocation {
    latitude: number;
    longitude: number;
    temperatureElement: string;
    statusElement: string;
  }

  const weatherLocations: WeatherLocation[] = [
    {
      latitude: 38.6983,
      longitude: -0.4743,
      temperatureElement: "weather-alcoi-temperature",
      statusElement: "weather-alcoi-status",
    },
    {
      latitude: 39.4699,
      longitude: -0.3763,
      temperatureElement: "weather-valencia-temperature",
      statusElement: "weather-valencia-status",
    },
  ];

  function getWeatherDescription(code: number): string {
    if (code === 0) return "Clear";
    if (code === 1) return "Mainly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Cloudy";
    if (code === 45 || code === 48) return "Fog";
    if (code >= 51 && code <= 57) return "Drizzle";
    if (code >= 61 && code <= 67) return "Rain";
    if (code >= 71 && code <= 77) return "Snow";
    if (code >= 80 && code <= 82) return "Showers";
    if (code >= 85 && code <= 86) return "Snow showers";
    if (code >= 95 && code <= 99) return "Thunderstorm";

    return "Unknown";
  }

  async function loadWeather(location: WeatherLocation) {
    const temperatureElement = document.getElementById(
      location.temperatureElement
    );

    const statusElement = document.getElementById(
      location.statusElement
    );

    if (!temperatureElement || !statusElement) return;

    try {
      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${location.latitude}` +
        `&longitude=${location.longitude}` +
        `&current=temperature_2m,weather_code` +
        `&timezone=Europe%2FMadrid`;

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Weather request failed");
      }

      const data = (await response.json()) as WeatherData;

      const temperature = data.current.temperature_2m;
      const weatherCode = data.current.weather_code;

      temperatureElement.textContent =
        `${Math.round(temperature)}°C`;

      statusElement.textContent =
        getWeatherDescription(weatherCode);

    } catch {
      temperatureElement.textContent = "--°C";
      statusElement.textContent = "Unavailable";
    }
  }

  function loadAllWeather() {
    weatherLocations.forEach((location) => {
      void loadWeather(location);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadAllWeather);
  } else {
    loadAllWeather();
  }
</script>

<!-- ============================================================= -->
<!-- INTERACTIVE BACKGROUND (pointer-reactive parallax + bokeh focus) -->
<!-- ============================================================= -->

<script>
  const bg = document.getElementById("projects-bg");
  const section = document.getElementById("projects");

  const reduceMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (bg && section && !reduceMotion) {

    const parallaxEls = Array.from(
      bg.querySelectorAll<HTMLElement>("[data-parallax]")
    );

    const cursorGlow =
      bg.querySelector<HTMLElement>(".cursor-glow-alt");

    const bokehEls = Array.from(
      bg.querySelectorAll<HTMLElement>(".bokeh-alt")
    );

    // Target = where the pointer actually is (normalized -1..1, and 0..1 for the glow).
    let targetNormX = 0;
    let targetNormY = 0;
    let targetGlowX = 0.3; // resting position — roughly where the green pool sits
    let targetGlowY = 0.55;

    // Current = the smoothed, lerped value actually applied to the DOM.
    let currentNormX = 0;
    let currentNormY = 0;
    let currentGlowX = targetGlowX;
    let currentGlowY = targetGlowY;

    let pointerActive = false;
    let rafId = 0;

    const lerp = (start: number, end: number, t: number): number =>
      start + (end - start) * t;

    const clamp01 = (value: number): number =>
      Math.min(1, Math.max(0, value));

    const handlePointerMove = (event: PointerEvent): void => {
      const rect = section.getBoundingClientRect();

      const relX = (event.clientX - rect.left) / rect.width;
      const relY = (event.clientY - rect.top) / rect.height;

      // Only react while the pointer is actually over this section.
      pointerActive =
        relX >= 0 && relX <= 1 && relY >= 0 && relY <= 1;

      if (!pointerActive) return;

      targetNormX = relX * 2 - 1; // -1 (left) .. 1 (right)
      targetNormY = relY * 2 - 1; // -1 (top)  .. 1 (bottom)

      targetGlowX = relX;
      targetGlowY = relY;
    };

    const handlePointerLeave = (): void => {
      pointerActive = false;

      targetNormX = 0;
      targetNormY = 0;
      targetGlowX = 0.3;
      targetGlowY = 0.55;
    };

    const tick = (): void => {
      const ease = 0.06;

      currentNormX = lerp(currentNormX, targetNormX, ease);
      currentNormY = lerp(currentNormY, targetNormY, ease);
      currentGlowX = lerp(currentGlowX, targetGlowX, ease);
      currentGlowY = lerp(currentGlowY, targetGlowY, ease);

      // Ambient aurora parallax.
      for (const el of parallaxEls) {
        const strength = Number(el.dataset.parallax ?? "1");

        const px = currentNormX * strength * 22;
        const py = currentNormY * strength * 22;

        el.style.setProperty("--px", `${px}px`);
        el.style.setProperty("--py", `${py}px`);
      }

      // Cursor spotlight.
      if (cursorGlow) {
        cursorGlow.style.setProperty(
          "--glow-x",
          `${(currentGlowX * 100).toFixed(2)}%`
        );

        cursorGlow.style.setProperty(
          "--glow-y",
          `${(currentGlowY * 100).toFixed(2)}%`
        );

        cursorGlow.style.opacity = pointerActive ? "1" : "0.5";
      }

      // Bokeh "rack focus": the closer the pointer is to a bokeh disc's
      // resting position, the sharper/brighter/larger it becomes.
      const glowXPct = currentGlowX * 100;
      const glowYPct = currentGlowY * 100;
      const influenceRadius = 34; // in the same 0-100 percentage space

      for (const el of bokehEls) {
        const bx = Number(el.dataset.x ?? "50");
        const by = Number(el.dataset.y ?? "50");

        const dx = bx - glowXPct;
        const dy = by - glowYPct;

        const dist = Math.sqrt(dx * dx + dy * dy);

        const raw = clamp01(1 - dist / influenceRadius);
        const focus = raw * raw; // ease the falloff so it feels soft, not linear

        el.style.setProperty("--focus", focus.toFixed(3));
      }

      rafId = requestAnimationFrame(tick);
    };

    section.addEventListener("pointermove", handlePointerMove);
    section.addEventListener("pointerleave", handlePointerLeave);

    rafId = requestAnimationFrame(tick);

    // Clean up if the section is ever removed (e.g. Astro view transitions).
    window.addEventListener(
      "pagehide",
      () => cancelAnimationFrame(rafId),
      { once: true }
    );
  }

  // --- Liquid glass: pointer-tracked specular highlight per card -------

  if (!reduceMotion) {
    const glassCards = Array.from(
      document.querySelectorAll<HTMLElement>(".liquid-glass")
    );

    for (const card of glassCards) {
      card.addEventListener("pointermove", (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();

        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;

        card.style.setProperty("--mx", `${x.toFixed(1)}%`);
        card.style.setProperty("--my", `${y.toFixed(1)}%`);
      });

      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--mx", "50%");
        card.style.setProperty("--my", "30%");
      });
    }
  }
</script>

