<script>
  type LocationData = {
    name: string;
    region: string;
    latitude: number;
    longitude: number;
  };

  type WeatherCurrentData = {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    wind_speed_10m: number;
    surface_pressure: number;
    visibility: number;
    weather_code: number;
  };

  type WeatherHourlyData = {
    time: string[];
    temperature_2m: number[];
    precipitation_probability: number[];
    weather_code: number[];
  };

  type WeatherDailyData = {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    sunrise: string[];
    sunset: string[];
  };

  type WeatherData = {
    current: WeatherCurrentData;
    hourly: WeatherHourlyData;
    daily: WeatherDailyData;
  };


  const weatherLocations: Record<string, LocationData> = {
    Alcoi: {
      name: "Alcoi",
      region: "Alicante, España",
      latitude: 38.6986,
      longitude: -0.4731,
    },

    Torrevieja: {
      name: "Torrevieja",
      region: "Alicante, España",
      latitude: 37.978,
      longitude: -0.682,
    },

    Valencia: {
      name: "Valencia",
      region: "Valencia, España",
      latitude: 39.4699,
      longitude: -0.3763,
    },
  };


  let selectedLocation = "Alcoi";

  let weatherData: WeatherData | null = null;

  let hourlyStartIndex = 0;

  let currentHourIndex = 0;


  const getElement = <T extends HTMLElement>(
    id: string,
  ): T | null => {
    return document.getElementById(id) as T | null;
  };


  function getWeatherIcon(
    code: number,
    isNight = false,
  ): string {

    if (isNight) {

      if (code === 0) {
        return "🌙";
      }

      if (
        code === 1 ||
        code === 2 ||
        code === 3
      ) {
        return "☁️";
      }
    }


    if (code === 0) return "☀️";
    if (code === 1) return "🌤️";
    if (code === 2) return "⛅";
    if (code === 3) return "☁️";

    if (
      code === 45 ||
      code === 48
    ) {
      return "🌫️";
    }

    if (
      code >= 51 &&
      code <= 57
    ) {
      return "🌦️";
    }

    if (
      code >= 61 &&
      code <= 67
    ) {
      return "🌧️";
    }

    if (
      code >= 71 &&
      code <= 77
    ) {
      return "❄️";
    }

    if (
      code >= 80 &&
      code <= 82
    ) {
      return "🌦️";
    }

    if (
      code >= 85 &&
      code <= 86
    ) {
      return "🌨️";
    }

    if (
      code >= 95 &&
      code <= 99
    ) {
      return "⛈️";
    }

    return "🌤️";
  }


  function getWeatherDescription(
    code: number,
  ): string {

    if (code === 0) {
      return "Clear sky";
    }

    if (code === 1) {
      return "Mainly clear";
    }

    if (code === 2) {
      return "Partly cloudy";
    }

    if (code === 3) {
      return "Overcast";
    }

    if (
      code === 45 ||
      code === 48
    ) {
      return "Fog";
    }

    if (
      code >= 51 &&
      code <= 57
    ) {
      return "Drizzle";
    }

    if (
      code >= 61 &&
      code <= 67
    ) {
      return "Rain";
    }

    if (
      code >= 71 &&
      code <= 77
    ) {
      return "Snow";
    }

    if (
      code >= 80 &&
      code <= 82
    ) {
      return "Rain showers";
    }

    if (
      code >= 85 &&
      code <= 86
    ) {
      return "Snow showers";
    }

    if (
      code >= 95 &&
      code <= 99
    ) {
      return "Thunderstorm";
    }

    return "Unknown conditions";
  }


  function formatHour(
    value: string,
  ): string {

    const date = new Date(value);

    return date.toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }


  function formatDay(
    value: string,
    index: number,
  ): string {

    if (index === 0) {
      return "Today";
    }

    const date = new Date(
      `${value}T12:00:00`,
    );

    return date.toLocaleDateString(
      "en-GB",
      {
        weekday: "short",
      },
    );
  }


  function formatDateTime(): string {

    return new Date().toLocaleTimeString(
      "en-GB",
      {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      },
    );
  }


  function getIsNight(
    time: string,
    sunrise: string,
    sunset: string,
  ): boolean {

    const current =
      new Date(time).getTime();

    const rise =
      new Date(sunrise).getTime();

    const set =
      new Date(sunset).getTime();

    return (
      current < rise ||
      current > set
    );
  }


  function updateElement(
    id: string,
    value: string,
  ): void {

    const element =
      document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }


  function renderCurrent(
    data: WeatherData,
  ): void {

    const location =
      weatherLocations[selectedLocation];

    const current =
      data.current;

    const todaySunrise =
      data.daily.sunrise[0];

    const todaySunset =
      data.daily.sunset[0];


    const isNight =
      getIsNight(
        new Date().toISOString(),
        todaySunrise,
        todaySunset,
      );


    updateElement(
      "location-name",
      location.name,
    );


    updateElement(
      "location-region",
      location.region,
    );


    updateElement(
      "footer-location",
      location.name,
    );


    updateElement(
      "temperature",
      `${Math.round(
        current.temperature_2m,
      )}°`,
    );


    updateElement(
      "feels-like",
      `${Math.round(
        current.apparent_temperature,
      )}°`,
    );


    updateElement(
      "description",
      getWeatherDescription(
        current.weather_code,
      ),
    );


    updateElement(
      "weather-icon",
      getWeatherIcon(
        current.weather_code,
        isNight,
      ),
    );


    updateElement(
      "humidity",
      `${Math.round(
        current.relative_humidity_2m,
      )}%`,
    );


    updateElement(
      "hero-humidity",
      `${Math.round(
        current.relative_humidity_2m,
      )}%`,
    );


    updateElement(
      "wind",
      `${Math.round(
        current.wind_speed_10m,
      )} km/h`,
    );


    updateElement(
      "wind-detail",
      `${Math.round(
        current.wind_speed_10m,
      )} km/h`,
    );


    updateElement(
      "pressure",
      `${Math.round(
        current.surface_pressure,
      )} hPa`,
    );


    updateElement(
      "pressure-detail",
      `${Math.round(
        current.surface_pressure,
      )} hPa`,
    );


    updateElement(
      "visibility",
      `${Math.round(
        current.visibility / 1000,
      )} km`,
    );


    updateElement(
      "visibility-detail",
      `${Math.round(
        current.visibility / 1000,
      )} km`,
    );


    updateElement(
      "feels-detail",
      `${Math.round(
        current.apparent_temperature,
      )}°C`,
    );


    updateElement(
      "feels-detail-side",
      `${Math.round(
        current.apparent_temperature,
      )}°C`,
    );


    const rainProbability =
      data.daily.precipitation_probability_max[0] ?? 0;


    updateElement(
      "rain-detail",
      `${rainProbability}%`,
    );


    updateElement(
      "rain-detail-side",
      `${rainProbability}%`,
    );


    updateElement(
      "sunrise",
      formatHour(todaySunrise),
    );


    updateElement(
      "sunset",
      formatHour(todaySunset),
    );


    updateElement(
      "last-updated",
      formatDateTime(),
    );
  }


  function createHourlyCard(
    data: WeatherData,
    index: number,
  ): HTMLElement {

    const time =
      data.hourly.time[index];

    const temperature =
      data.hourly.temperature_2m[index] ?? 0;

    const rain =
      data.hourly.precipitation_probability[index] ?? 0;

    const code =
      data.hourly.weather_code[index] ?? 0;


    const item =
      document.createElement("article");


    item.className =
      index === currentHourIndex
        ? "hour-card current"
        : "hour-card";


    const timeLabel =
      index === currentHourIndex
        ? "NOW"
        : formatHour(time);


    item.innerHTML = `
      <span class="hour-time">
        ${timeLabel}
      </span>

      <span class="hour-icon">
        ${getWeatherIcon(code)}
      </span>

      <strong class="hour-temperature">
        ${Math.round(temperature)}°
      </strong>

      <span class="hour-rain">
        ${rain}% rain
      </span>
    `;


    return item;
  }


  function renderHourly(
    data: WeatherData,
  ): void {

    const container =
      getElement<HTMLDivElement>(
        "hourly-container",
      );


    if (!container) {
      return;
    }


    const endIndex =
      Math.min(
        hourlyStartIndex + 12,
        data.hourly.time.length,
      );


    container.innerHTML = "";


    for (
      let i = hourlyStartIndex;
      i < endIndex;
      i += 1
    ) {

      container.appendChild(
        createHourlyCard(
          data,
          i,
        ),
      );
    }


    updateHourlyButtons();
  }


  function updateHourlyButtons(): void {

    const previousButton =
      getElement<HTMLButtonElement>(
        "hourly-prev",
      );

    const nextButton =
      getElement<HTMLButtonElement>(
        "hourly-next",
      );


    if (!weatherData) {

      if (previousButton) {
        previousButton.disabled = true;
      }

      if (nextButton) {
        nextButton.disabled = true;
      }

      return;
    }


    const maxStart =
      Math.max(
        0,
        weatherData.hourly.time.length - 12,
      );


    if (previousButton) {
      previousButton.disabled =
        hourlyStartIndex <= 0;
    }


    if (nextButton) {
      nextButton.disabled =
        hourlyStartIndex >= maxStart;
    }
  }


  function renderDaily(
    data: WeatherData,
  ): void {

    const container =
      getElement<HTMLDivElement>(
        "daily-container",
      );


    if (!container) {
      return;
    }


    container.innerHTML = "";


    const days =
      Math.min(
        data.daily.time.length,
        7,
      );


    for (
      let i = 0;
      i < days;
      i += 1
    ) {

      const day =
        data.daily.time[i];

      const code =
        data.daily.weather_code[i] ?? 0;

      const high =
        data.daily.temperature_2m_max[i] ?? 0;

      const low =
        data.daily.temperature_2m_min[i] ?? 0;

      const rain =
        data.daily.precipitation_probability_max[i] ?? 0;


      const row =
        document.createElement("article");


      row.className =
        "daily-row";


      row.innerHTML = `
        <div class="daily-day">
          ${formatDay(day, i)}
        </div>

        <div class="daily-icon">
          ${getWeatherIcon(code)}
        </div>

        <div class="daily-condition">
          <strong>
            ${getWeatherDescription(code)}
          </strong>

          <span>
            ${rain}% rain
          </span>
        </div>

        <div class="daily-temperatures">
          <strong>
            ${Math.round(high)}°
          </strong>

          <span>
            ${Math.round(low)}°
          </span>
        </div>
      `;


      container.appendChild(row);
    }
  }


  function setLoadingState(): void {

    updateElement(
      "header-status",
      "Loading...",
    );


    updateElement(
      "description",
      "Loading weather...",
    );
  }


  function setErrorState(
    message: string,
  ): void {

    updateElement(
      "header-status",
      "Offline",
    );


    updateElement(
      "description",
      message,
    );


    updateElement(
      "last-updated",
      "Error",
    );
  }


  async function fetchWeather(
    location: LocationData,
  ): Promise<WeatherData> {

    const params = new URLSearchParams({
      latitude: String(location.latitude),
      longitude: String(location.longitude),
      current:
        "temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,surface_pressure,visibility,weather_code",
      hourly:
        "temperature_2m,precipitation_probability,weather_code",
      daily:
        "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset",
      timezone: "auto",
      forecast_days: "7",
    });


    const url =
      `https://api.open-meteo.com/v1/forecast?${params.toString()}`;


    const response =
      await fetch(url);


    if (!response.ok) {

      throw new Error(
        `Weather API error: ${response.status}`,
      );
    }


    return (
      await response.json()
    ) as WeatherData;
  }


  async function loadWeather(
    locationName: string,
  ): Promise<void> {

    const location =
      weatherLocations[locationName];


    if (!location) {
      return;
    }


    selectedLocation =
      locationName;

    weatherData = null;

    hourlyStartIndex = 0;

    currentHourIndex = 0;


    setLoadingState();


    document
      .querySelectorAll<HTMLButtonElement>(
        ".location-tab",
      )
      .forEach((button) => {

        button.classList.toggle(
          "active",
          button.dataset.location ===
            locationName,
        );
      });


    try {

      const response =
        await fetchWeather(
          location,
        );


      weatherData =
        response;


      const now =
        Date.now();


      const foundIndex =
        response.hourly.time.findIndex(
          (time) =>
            new Date(time).getTime() >=
            now,
        );


      currentHourIndex =
        foundIndex >= 0
          ? foundIndex
          : 0;


      hourlyStartIndex =
        currentHourIndex;


      renderCurrent(
        response,
      );


      renderHourly(
        response,
      );


      renderDaily(
        response,
      );


      updateElement(
        "header-status",
        "Live data",
      );

    } catch (error) {

      console.error(
        "Weather loading error:",
        error,
      );


      setErrorState(
        "Unable to load weather data.",
      );
    }
  }


  document
    .querySelectorAll<HTMLButtonElement>(
      ".location-tab",
    )
    .forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const locationName =
            button.dataset.location;


          if (!locationName) {
            return;
          }


          void loadWeather(
            locationName,
          );
        },
      );
    });


  getElement<HTMLButtonElement>(
    "hourly-prev",
  )?.addEventListener(
    "click",
    () => {

      if (!weatherData) {
        return;
      }


      hourlyStartIndex =
        Math.max(
          0,
          hourlyStartIndex - 6,
        );


      renderHourly(
        weatherData,
      );
    },
  );


  getElement<HTMLButtonElement>(
    "hourly-next",
  )?.addEventListener(
    "click",
    () => {

      if (!weatherData) {
        return;
      }


      const maxStart =
        Math.max(
          0,
          weatherData.hourly.time.length - 12,
        );


      hourlyStartIndex =
        Math.min(
          maxStart,
          hourlyStartIndex + 6,
        );


      renderHourly(
        weatherData,
      );
    },
  );


  void loadWeather(
    "Alcoi",
  );
</script>

