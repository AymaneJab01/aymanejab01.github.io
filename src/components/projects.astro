---
---

<section
  id="projects"
  class="text-[var(--white)] py-24 md:py-36"
>
  <div class="max-w-5xl mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-2xl border border-[var(--white-icon-tr)]
      bg-[#1414149c] px-8 py-16 md:px-16 md:py-24
      text-center backdrop-blur-sm"
    >
      <!-- Subtle green glow -->
      <div
        class="absolute -top-24 left-1/2 h-48 w-48 -translate-x-1/2
        rounded-full bg-[var(--sec)] opacity-10 blur-3xl"
      ></div>

      <div class="relative">

        <!-- Status indicator -->
        <div class="mb-6 flex items-center justify-center gap-2">
          <span
            class="h-2 w-2 rounded-full bg-[var(--sec)]
            shadow-[0_0_12px_var(--sec)] animate-pulse"
          ></span>

          <span
            class="text-sm tracking-widest uppercase text-[var(--sec)] shiny-sec"
          >
            Projects
          </span>
        </div>

        <!-- Main title -->
        <h2
          class="text-3xl md:text-5xl font-medium tracking-tight
          text-[var(--white)]"
        >
          Selected projects<span class="text-[var(--sec)]">.</span>
        </h2>

        <p
          class="mt-4 text-lg md:text-xl text-[var(--white-icon)]
          max-w-xl mx-auto leading-relaxed"
        >
          A selection of projects I'm building and continuously improving.
        </p>

        <!-- ===================================================== -->
        <!-- PROJECTS -->
        <!-- ===================================================== -->

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 text-left">

          <!-- =================================================== -->
          <!-- PROJECT 01 — TERMINAL -->
          <!-- =================================================== -->

          <a
            href="/#terminal"
            class="group relative overflow-hidden rounded-2xl
            border border-[var(--white-icon-tr)]
            bg-[#0d0d0d]/70 p-6
            transition-all duration-300
            hover:-translate-y-1
            hover:border-[var(--sec)]
            hover:shadow-[0_0_30px_rgba(0,255,140,0.08)]"
          >
            <div
              class="absolute -top-16 -right-16 h-32 w-32
              rounded-full bg-[var(--sec)]
              opacity-5 blur-3xl
              transition-opacity duration-300
              group-hover:opacity-15"
            ></div>

            <div class="relative">

              <div class="flex items-center justify-between">
                <span
                  class="text-xs tracking-widest uppercase
                  text-[var(--white-icon)]"
                >
                  Project 01
                </span>

                <span
                  class="text-[var(--sec)]
                  transition-transform duration-300
                  group-hover:translate-x-1"
                >
                  ↗
                </span>
              </div>

              <h3
                class="mt-6 text-2xl font-medium
                text-[var(--white)]"
              >
                Interactive Terminal<span class="text-[var(--sec)]">.</span>
              </h3>

              <p
                class="mt-3 text-sm leading-relaxed
                text-[var(--white-icon)]"
              >
                An interactive terminal integrated into my portfolio,
                showcasing my skills, experience, projects, and background.
              </p>

              <p
                class="mt-3 text-sm leading-relaxed
                text-[var(--white-icon)]"
              >
                The terminal will keep evolving day after day as new
                commands, features, and information are added.
              </p>

              <div
                class="mt-6 flex items-center gap-2
                text-xs text-[var(--sec)]"
              >
                <span
                  class="h-2 w-2 rounded-full bg-[var(--sec)]
                  shadow-[0_0_10px_var(--sec)]"
                ></span>

                Continuously evolving
              </div>

            </div>
          </a>


          <!-- =================================================== -->
          <!-- PROJECT 02 — MOVIE RANKING -->
          <!-- =================================================== -->

          <a
            href="/movie-ranking"
            class="group relative overflow-hidden rounded-2xl
            border border-[var(--white-icon-tr)]
            bg-[#0d0d0d]/70 p-6
            transition-all duration-300
            hover:-translate-y-1
            hover:border-[var(--sec)]
            hover:shadow-[0_0_30px_rgba(0,255,140,0.08)]"
          >

            <div
              class="absolute -top-16 -right-16 h-32 w-32
              rounded-full bg-[var(--sec)]
              opacity-5 blur-3xl
              transition-opacity duration-300
              group-hover:opacity-15"
            ></div>

            <div class="relative">

              <div class="flex items-center justify-between">
                <span
                  class="text-xs tracking-widest uppercase
                  text-[var(--white-icon)]"
                >
                  Project 02
                </span>

                <span
                  class="text-[var(--sec)]
                  transition-transform duration-300
                  group-hover:translate-x-1"
                >
                  ↗
                </span>
              </div>

              <!-- Movie image -->

              <div
                class="mt-6 overflow-hidden rounded-xl
                border border-[var(--white-icon-tr)]"
              >
                <img
                  src="/svg/avg-inf.png"
                  alt="Avengers Infinity War"
                  class="block w-full aspect-video
                  object-cover
                  transition-transform duration-500
                  group-hover:scale-105"
                />
              </div>

              <!-- Movie information -->

              <div class="mt-6">

                <div
                  class="flex items-start justify-between gap-4"
                >
                  <h3
                    class="text-2xl font-medium
                    text-[var(--white)]"
                  >
                    Movie Ranking<span class="text-[var(--sec)]">.</span>
                  </h3>

                  <span
                    class="shrink-0 text-lg font-semibold
                    text-[var(--sec)]"
                  >
                    9/10
                  </span>
                </div>

                <p
                  class="mt-3 text-sm leading-relaxed
                  text-[var(--white-icon)]"
                >
                  A movie ranking page where movies are displayed
                  with their cover, rating, and personal review.
                </p>

                <div
                  class="mt-5 border-l-2 border-[var(--sec)]
                  pl-4"
                >
                  <p
                    class="text-sm font-medium
                    text-[var(--white)]"
                  >
                    Avengers: Infinity War
                  </p>

                  <p
                    class="mt-1 text-sm italic
                    leading-relaxed
                    text-[var(--white-icon)]"
                  >
                    A very solid movie in general and one of the
                    best superheroes movie.
                  </p>
                </div>

              </div>

              <div
                class="mt-6 flex items-center justify-between
                text-xs"
              >
                <span class="text-[var(--white-icon)]">
                  Movie collection
                </span>

                <span
                  class="text-[var(--sec)]
                  transition-transform duration-300
                  group-hover:translate-x-1"
                >
                  View project →
                </span>
              </div>

            </div>
          </a>

        </div>

        <!-- Decorative line -->

        <div
          class="mx-auto mt-12 h-px w-24
          bg-[var(--sec)] opacity-60"
        ></div>

      </div>
    </div>
  </div>
</section>