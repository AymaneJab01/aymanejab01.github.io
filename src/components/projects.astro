<section
  id="projects"
  class="text-[var(--white)] py-24 md:py-36"
>
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-12">
      <p
        class="text-sm uppercase tracking-[0.25em]
        text-[var(--sec)] shiny-sec mb-3"
      >
        Projects
      </p>

      <h2
        class="text-3xl md:text-5xl font-medium tracking-tight"
      >
        Things I'm building<span class="text-[var(--sec)]">.</span>
      </h2>

      <p
        class="mt-4 max-w-2xl
        text-[var(--white-icon)]
        text-base md:text-lg leading-relaxed"
      >
        A collection of projects, experiments and tools
        that evolve over time.
      </p>
    </div>


    <!-- ===================================================== -->
    <!-- PROJECT 01 — TERMINAL -->
    <!-- ===================================================== -->

    <a
      href="#terminal"
      class="group block"
      aria-label="Go to Terminal project"
    >
      <article
        class="
          relative overflow-hidden rounded-2xl
          border border-[var(--white-icon-tr)]
          bg-[#1414149c]
          backdrop-blur-sm

          transition-all duration-500

          hover:border-[var(--sec)]
          hover:-translate-y-1
          hover:shadow-[0_0_40px_rgba(0,255,140,0.08)]
        "
      >

        <!-- subtle glow -->
        <div
          class="
            pointer-events-none absolute
            -top-32 -right-32
            h-64 w-64
            rounded-full
            bg-[var(--sec)]
            opacity-[0.04]
            blur-3xl
            transition-opacity duration-500
            group-hover:opacity-[0.10]
          "
        ></div>


        <div
          class="
            relative
            p-7 md:p-10
            grid md:grid-cols-[1fr_auto]
            gap-8
            items-center
          "
        >

          <!-- Project information -->
          <div>

            <!-- Project number -->
            <div
              class="
                flex items-center gap-3
                mb-5
              "
            >
              <span
                class="
                  text-xs
                  uppercase
                  tracking-[0.25em]
                  text-[var(--sec)]
                  shiny-sec
                "
              >
                Project 01
              </span>

              <span
                class="
                  h-px w-10
                  bg-[var(--sec)]
                  opacity-50
                "
              ></span>

              <span
                class="
                  text-xs
                  uppercase
                  tracking-wider
                  text-[var(--white-icon)]
                "
              >
                Interactive
              </span>
            </div>


            <!-- Title -->
            <h3
              class="
                text-2xl md:text-4xl
                font-medium
                tracking-tight
                text-[var(--white)]
              "
            >
              Developer Terminal
              <span class="text-[var(--sec)]">.</span>
            </h3>


            <!-- Description -->
            <p
              class="
                mt-4
                max-w-2xl
                text-[var(--white-icon)]
                text-base md:text-lg
                leading-relaxed
              "
            >
              An interactive terminal built directly into this portfolio,
              showcasing commands, projects and developer experiments.
              It will continue evolving day after day as new features,
              commands and ideas are added.
            </p>


            <!-- Tech / status -->
            <div
              class="
                mt-6
                flex flex-wrap
                items-center
                gap-3
              "
            >
              <span
                class="
                  rounded-full
                  border border-[var(--white-icon-tr)]
                  px-3 py-1
                  text-xs
                  text-[var(--white-icon)]
                "
              >
                Astro
              </span>

              <span
                class="
                  rounded-full
                  border border-[var(--white-icon-tr)]
                  px-3 py-1
                  text-xs
                  text-[var(--white-icon)]
                "
              >
                Interactive UI
              </span>

              <span
                class="
                  rounded-full
                  border border-[var(--sec)]
                  px-3 py-1
                  text-xs
                  text-[var(--sec)]
                "
              >
                Evolving
              </span>
            </div>

          </div>


          <!-- Go to terminal -->
          <div
            class="
              flex items-center justify-center
              md:justify-end
            "
          >
            <div
              class="
                flex items-center gap-3
                text-[var(--white-icon)]
                transition-all duration-300
                group-hover:text-[var(--sec)]
              "
            >

              <span
                class="
                  text-sm
                  uppercase
                  tracking-widest
                "
              >
                Explore
              </span>

              <span
                class="
                  flex h-11 w-11
                  items-center justify-center
                  rounded-full
                  border border-[var(--white-icon-tr)]
                  transition-all duration-300

                  group-hover:border-[var(--sec)]
                  group-hover:translate-y-[-3px]
                "
              >
                ↑
              </span>

            </div>
          </div>

        </div>

      </article>
    </a>

  </div>
</section>