---

---

<section
  id="projects"
  class="relative overflow-hidden text-[var(--white)] py-24 md:py-36"
>

  <!-- ========================================================= -->
  <!-- BACKGROUND — JAPANESE GARDEN (forest green / amber / coral) -->
  <!-- ========================================================= -->

  <div id="projects-bg" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden bg-[#050b08]">
    <div class="nebula-field-alt" data-parallax="0.5" aria-hidden="true">
      <div class="nebula-ribbon-alt ribbon-back-alt"></div>
      <div class="nebula-ribbon-alt ribbon-mid-alt"></div>
      <div class="nebula-ribbon-alt ribbon-core-alt"></div>
    </div>

    <!-- Bokeh field — soft blurred discs echoing the maple-leaf bokeh in
         the reference photo. Green pools bottom-left (water/shadow),
         amber scattered across the top (canopy), coral-red clustered
         right (foreground maple leaves). Each one reacts to the pointer:
         the closer your cursor is, the more it "racks into focus". -->
    <div class="bokeh-field-alt" aria-hidden="true">

      <div class="bokeh-wrap-alt" style="--x:8;--y:70;--dur:17s;--delay:0s;">
        <div class="bokeh-alt bokeh-green-alt" data-x="8" data-y="70" style="--size:280px;--blur:44px;--base-opacity:0.5;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:20;--y:84;--dur:14s;--delay:-3s;">
        <div class="bokeh-alt bokeh-green-alt" data-x="20" data-y="84" style="--size:170px;--blur:32px;--base-opacity:0.46;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:33;--y:60;--dur:19s;--delay:-7s;">
        <div class="bokeh-alt bokeh-green-alt" data-x="33" data-y="60" style="--size:130px;--blur:26px;--base-opacity:0.38;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:30;--y:14;--dur:16s;--delay:-2s;">
        <div class="bokeh-alt bokeh-amber-alt" data-x="30" data-y="14" style="--size:230px;--blur:42px;--base-opacity:0.4;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:52;--y:9;--dur:20s;--delay:-9s;">
        <div class="bokeh-alt bokeh-amber-alt" data-x="52" data-y="9" style="--size:150px;--blur:30px;--base-opacity:0.36;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:66;--y:23;--dur:13s;--delay:-5s;">
        <div class="bokeh-alt bokeh-amber-alt" data-x="66" data-y="23" style="--size:100px;--blur:22px;--base-opacity:0.32;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:79;--y:37;--dur:15s;--delay:-1s;">
        <div class="bokeh-alt bokeh-red-alt" data-x="79" data-y="37" style="--size:200px;--blur:34px;--base-opacity:0.5;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:89;--y:55;--dur:18s;--delay:-6s;">
        <div class="bokeh-alt bokeh-red-alt" data-x="89" data-y="55" style="--size:150px;--blur:26px;--base-opacity:0.48;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:95;--y:29;--dur:12s;--delay:-4s;">
        <div class="bokeh-alt bokeh-red-alt" data-x="95" data-y="29" style="--size:95px;--blur:18px;--base-opacity:0.42;"></div>
      </div>

      <div class="bokeh-wrap-alt" style="--x:85;--y:76;--dur:21s;--delay:-10s;">
        <div class="bokeh-alt bokeh-red-alt" data-x="85" data-y="76" style="--size:120px;--blur:24px;--base-opacity:0.4;"></div>
      </div>

    </div>

    <div class="cursor-glow-alt" aria-hidden="true"></div>

    <div class="absolute inset-0 hero-dots-alt opacity-[0.5]"></div>

    <div class="absolute inset-0 noise-layer-alt opacity-[0.02]"></div>

    <div class="hero-vignette-alt"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">

    <!-- ========================================================= -->
    <!-- SECTION HEADER -->
    <!-- ========================================================= -->

    <div class="mb-16 md:mb-20">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="h-2 w-2 rounded-full bg-[var(--sec)]
          shadow-[0_0_12px_var(--sec)]"
        ></span>

        <span
          class="text-sm tracking-[0.25em] uppercase
          text-[var(--sec)] shiny-sec"
        >
          Projects
        </span>
      </div>

      <h2
        class="text-4xl md:text-6xl font-medium tracking-tight
        text-[var(--white)]"
      >
        Things I've built<span class="text-[var(--sec)]">.</span>
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg
        text-[var(--white-icon)] leading-relaxed"
      >
        A collection of projects, experiments and ideas that
        represent what I'm building and learning as a software developer.
      </p>
    </div>


    <!-- ========================================================= -->
    <!-- PROJECT 01 — TERMINAL -->
    <!-- ========================================================= -->

    <div
      class="group relative mb-10 overflow-hidden rounded-2xl
      border border-[var(--white-icon-tr)]
      liquid-glass
      transition-all duration-500
      hover:border-[var(--sec)]/40
      hover:shadow-[0_0_40px_rgba(21,128,61,0.1)]"
    >

      <div
        class="pointer-events-none absolute -right-32 -top-32
        h-64 w-64 rounded-full
        bg-[var(--sec)] opacity-[0.04] blur-3xl
        transition-opacity duration-500
        group-hover:opacity-[0.08]"
      ></div>

      <a
        href="/#terminal"
        class="relative block p-7 md:p-10"
      >

        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">

          <div class="flex-1">

            <div class="mb-5 flex items-center gap-3">
              <span
                class="font-mono text-xs tracking-[0.2em]
                text-[var(--sec)]"
              >
                PROJECT 01
              </span>

              <span
                class="h-px w-12 bg-[var(--sec)] opacity-40"
              ></span>

              <span
                class="text-xs uppercase tracking-widest
                text-[var(--white-icon)]"
              >
                Interactive
              </span>
            </div>

            <h3
              class="text-2xl md:text-4xl font-medium
              tracking-tight text-[var(--white)]
              transition-colors duration-300
              group-hover:text-[var(--sec)]"
            >
              Developer Terminal
              <span class="text-[var(--sec)]">.</span>
            </h3>

            <p
              class="mt-4 max-w-2xl text-base md:text-lg
              leading-relaxed text-[var(--white-icon)]"
            >
              An interactive terminal built directly into my portfolio,
              designed to provide a developer-style way of exploring
              my work, skills and information.
            </p>

            <p
              class="mt-3 max-w-2xl text-sm
              leading-relaxed text-[var(--white-icon)]
              opacity-70"
            >
              This terminal will keep evolving day after day as new
              commands, features and ideas are added.
            </p>

            <div class="mt-7 flex flex-wrap gap-2">

              <span
                class="rounded-full border border-[var(--white-icon-tr)]
                px-3 py-1 text-xs font-mono
                text-[var(--white-icon)]"
              >
                Astro
              </span>

              <span
                class="rounded-full border border-[var(--white-icon-tr)]
                px-3 py-1 text-xs font-mono
                text-[var(--white-icon)]"
              >
                TypeScript
              </span>

              <span
                class="rounded-full border border-[var(--white-icon-tr)]
                px-3 py-1 text-xs font-mono
                text-[var(--white-icon)]"
              >
                Interactive UI
              </span>

            </div>

          </div>

          <div
            class="flex md:flex-col items-center md:items-end
            justify-between gap-5 md:min-w-[150px]"
          >

            <div
              class="font-mono text-xs
              text-[var(--white-icon)] opacity-60"
            >
              01 / 07
            </div>

            <div
              class="flex items-center gap-2
              text-sm text-[var(--sec)]
              transition-transform duration-300
              group-hover:translate-x-1"
            >
              <span>Open terminal</span>
              <span class="text-lg">→</span>
            </div>

          </div>

        </div>

      </a>
    </div>


    <!-- ========================================================= -->
    <!-- PROJECT 02 — MOVIE RANKING -->
    <!-- ========================================================= -->

    <div
      class="group relative mb-10 overflow-hidden rounded-2xl
      border border-[var(--white-icon-tr)]
      liquid-glass
      transition-all duration-500
      hover:border-[var(--sec)]/40
      hover:shadow-[0_0_40px_rgba(21,128,61,0.1)]"
    >

      <a
        href="/projects/movie-ranking"
        class="relative block p-7 md:p-10"
      >

        <div class="flex flex-col md:flex-row gap-8">

          <div class="flex flex-1 flex-col justify-between">

            <div>

              <div class="mb-5 flex items-center gap-3">

                <span
                  class="font-mono text-xs tracking-[0.2em]
                  text-[var(--sec)]"
                >
                  PROJECT 02
                </span>

                <span
                  class="h-px w-12 bg-[var(--sec)] opacity-40"
                ></span>

                <span
                  class="text-xs uppercase tracking-widest
                  text-[var(--white-icon)]"
                >
                  Web App
                </span>

              </div>

              <h3
                class="text-2xl md:text-4xl font-medium
                tracking-tight text-[var(--white)]
                transition-colors duration-300
                group-hover:text-[var(--sec)]"
              >
                Movie Ranking
                <span class="text-[var(--sec)]">.</span>
              </h3>

              <p
                class="mt-4 max-w-2xl text-base md:text-lg
                leading-relaxed text-[var(--white-icon)]"
              >
                A movie ranking interface where films can be explored
                through their covers, ratings and personal reviews.
              </p>

              <div
                class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4"
              >

                <div>
                  <p
                    class="text-xs uppercase tracking-widest
                    text-[var(--white-icon)] opacity-60"
                  >
                    Featured movie
                  </p>

                  <p
                    class="mt-1 text-lg font-medium
                    text-[var(--white)]"
                  >
                    Avengers: Infinity War
                  </p>
                </div>

                <div
                  class="h-8 w-px bg-[var(--white-icon-tr)]
                  hidden sm:block"
                ></div>

                <div>
                  <p
                    class="text-xs uppercase tracking-widest
                    text-[var(--white-icon)] opacity-60"
                  >
                    Rating
                  </p>

                  <p
                    class="mt-1 font-mono text-lg
                    text-[var(--sec)]"
                  >
                    9<span class="text-[var(--white-icon)]">/10</span>
                  </p>
                </div>

              </div>

            </div>

            <div
              class="mt-8 flex flex-col sm:flex-row
              sm:items-center sm:justify-between gap-5"
            >

              <div class="flex flex-wrap gap-2">

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Astro
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  UI
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Movies
                </span>

              </div>

              <div
                class="flex items-center gap-2
                text-sm text-[var(--sec)]
                transition-transform duration-300
                group-hover:translate-x-1"
              >
                <span>View project</span>
                <span class="text-lg">→</span>
              </div>

            </div>

          </div>

        </div>

      </a>
    </div>


    <!-- ========================================================= -->
    <!-- PROJECT 03 — WEATHER -->
    <!-- ========================================================= -->

    <div
      class="group relative mb-10 overflow-hidden rounded-2xl
      border border-[var(--white-icon-tr)]
      liquid-glass
      transition-all duration-500
      hover:border-[var(--sec)]/40
      hover:shadow-[0_0_40px_rgba(21,128,61,0.1)]"
    >

      <div
        class="pointer-events-none absolute inset-0 overflow-hidden opacity-60"
      >

        <div
          class="absolute -right-32 -top-32
          h-72 w-72 rounded-full
          bg-[var(--sec)] opacity-[0.06]
          blur-3xl
          transition-all duration-700
          group-hover:opacity-[0.12]
          group-hover:scale-110"
        ></div>

        <div
          class="absolute -left-32 -bottom-40
          h-80 w-80 rounded-full
          bg-[#0f5132] opacity-[0.05]
          blur-3xl
          transition-all duration-700
          group-hover:opacity-[0.09]"
        ></div>

        <div
          class="absolute inset-0 opacity-[0.12]"
          style="
            background-image:
              linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
              linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: radial-gradient(circle at center, black, transparent 75%);
            -webkit-mask-image: radial-gradient(circle at center, black, transparent 75%);
          "
        ></div>

      </div>

      <a
        href="/projects/weather"
        class="relative block p-7 md:p-10"
      >

        <div class="flex flex-col md:flex-row gap-8">

          <div class="flex flex-1 flex-col justify-between">

            <div>

              <div class="mb-5 flex items-center gap-3">

                <span
                  class="font-mono text-xs tracking-[0.2em]
                  text-[var(--sec)]"
                >
                  PROJECT 03
                </span>

                <span
                  class="h-px w-12 bg-[var(--sec)] opacity-40"
                ></span>

                <span
                  class="text-xs uppercase tracking-widest
                  text-[var(--white-icon)]"
                >
                  Live Data
                </span>

              </div>

              <h3
                class="text-2xl md:text-4xl font-medium
                tracking-tight text-[var(--white)]
                transition-colors duration-300
                group-hover:text-[var(--sec)]"
              >
                Weather Dashboard
                <span class="text-[var(--sec)]">.</span>
              </h3>

              <p
                class="mt-4 max-w-2xl text-base md:text-lg
                leading-relaxed text-[var(--white-icon)]"
              >
                A dynamic weather dashboard displaying live weather
                conditions for Alcoi and Valencia through a clean
                developer-focused interface.
              </p>

              <div
                class="mt-7 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl"
              >

                <div
                  class="relative overflow-hidden rounded-xl
                  border border-[var(--white-icon-tr)]
                  bg-[#10101080] px-5 py-4
                  backdrop-blur-md"
                >

                  <div class="flex items-center justify-between gap-4">

                    <div>

                      <p
                        class="text-xs uppercase tracking-widest
                        text-[var(--white-icon)] opacity-60"
                      >
                        Location
                      </p>

                      <p
                        class="mt-1 text-lg font-medium
                        text-[var(--white)]"
                      >
                        Alcoi
                      </p>

                    </div>

                    <div class="text-right">

                      <p
                        id="weather-alcoi-temperature"
                        class="font-mono text-xl
                        text-[var(--sec)]"
                      >
                        --°C
                      </p>

                      <p
                        id="weather-alcoi-status"
                        class="mt-1 text-xs
                        text-[var(--white-icon)]"
                      >
                        Loading...
                      </p>

                    </div>

                  </div>

                </div>

                <div
                  class="relative overflow-hidden rounded-xl
                  border border-[var(--white-icon-tr)]
                  bg-[#10101080] px-5 py-4
                  backdrop-blur-md"
                >

                  <div class="flex items-center justify-between gap-4">

                    <div>

                      <p
                        class="text-xs uppercase tracking-widest
                        text-[var(--white-icon)] opacity-60"
                      >
                        Location
                      </p>

                      <p
                        class="mt-1 text-lg font-medium
                        text-[var(--white)]"
                      >
                        Valencia
                      </p>

                    </div>

                    <div class="text-right">

                      <p
                        id="weather-valencia-temperature"
                        class="font-mono text-xl
                        text-[var(--sec)]"
                      >
                        --°C
                      </p>

                      <p
                        id="weather-valencia-status"
                        class="mt-1 text-xs
                        text-[var(--white-icon)]"
                      >
                        Loading...
                      </p>

                    </div>

                  </div>

                </div>

              </div>

            </div>

            <div
              class="mt-8 flex flex-col sm:flex-row
              sm:items-center sm:justify-between gap-5"
            >

              <div class="flex flex-wrap gap-2">

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Astro
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  API
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Live Weather
                </span>

              </div>

              <div
                class="flex items-center gap-2
                text-sm text-[var(--sec)]
                transition-transform duration-300
                group-hover:translate-x-1"
              >
                <span>View weather</span>
                <span class="text-lg">→</span>
              </div>

            </div>

          </div>

        </div>

      </a>
    </div>


    <!-- ========================================================= -->
    <!-- PROJECT 04 — ALGORITHM VISUALIZER -->
    <!-- ========================================================= -->

    <div
      class="group relative mb-10 overflow-hidden rounded-2xl
      border border-[var(--white-icon-tr)]
      liquid-glass
      transition-all duration-500
      hover:border-[var(--sec)]/40
      hover:shadow-[0_0_40px_rgba(21,128,61,0.1)]"
    >

      <div
        class="pointer-events-none absolute -right-24 -bottom-32
        h-72 w-72 rounded-full
        bg-[var(--sec)] opacity-[0.045] blur-3xl
        transition-opacity duration-500
        group-hover:opacity-[0.09]"
      ></div>

      <a
        href="/projects/visualizer"
        class="relative block p-7 md:p-10"
      >

        <div class="flex flex-col md:flex-row gap-8">

          <div class="flex flex-1 flex-col justify-between">

            <div>

              <div class="mb-5 flex items-center gap-3">

                <span
                  class="font-mono text-xs tracking-[0.2em]
                  text-[var(--sec)]"
                >
                  PROJECT 04
                </span>

                <span
                  class="h-px w-12 bg-[var(--sec)] opacity-40"
                ></span>

                <span
                  class="text-xs uppercase tracking-widest
                  text-[var(--white-icon)]"
                >
                  CS Fundamentals
                </span>

              </div>

              <h3
                class="text-2xl md:text-4xl font-medium
                tracking-tight text-[var(--white)]
                transition-colors duration-300
                group-hover:text-[var(--sec)]"
              >
                Algorithm Visualizer
                <span class="text-[var(--sec)]">.</span>
              </h3>

              <p
                class="mt-4 max-w-2xl text-base md:text-lg
                leading-relaxed text-[var(--white-icon)]"
              >
                An interactive playground for watching data structures
                think: sorting algorithms step through comparisons and
                swaps, a hash table resolves collisions with live
                chaining, and a grid searches for the shortest path
                with Dijkstra and A*.
              </p>

              <div
                class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4"
              >

                <div>

                  <p
                    class="text-xs uppercase tracking-widest
                    text-[var(--white-icon)] opacity-60"
                  >
                    Covers
                  </p>

                  <p
                    class="mt-1 text-lg font-medium
                    text-[var(--white)]"
                  >
                    Sorting &middot; Hashing &middot; Pathfinding
                  </p>

                </div>

              </div>

            </div>

            <div
              class="mt-8 flex flex-col sm:flex-row
              sm:items-center sm:justify-between gap-5"
            >

              <div class="flex flex-wrap gap-2">

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Astro
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  TypeScript
                </span>

                <span
                  class="rounded-full border border-[var(--white-icon-tr)]
                  px-3 py-1 text-xs font-mono
                  text-[var(--white-icon)]"
                >
                  Data Structures &amp; Algorithms
                </span>

              </div>

              <div
                class="flex items-center gap-2
                text-sm text-[var(--sec)]
                transition-transform duration-300
                group-hover:translate-x-1"
              >
                <span>Open visualizer</span>
                <span class="text-lg">→</span>
              </div>

            </div>

          </div>

        </div>

      </a>
    </div>


    <!-- ========================================================= -->
    <!-- PROJECT 05 — NETWORK PROTOCOL SIMULATOR -->
    <!-- ========================================================= -->

    <div
      class="group relative mt-10 overflow-hidden rounded-2xl
      border border-[var(--white-icon-tr)]
      liquid-glass
      transition-all duration-500
      hover:border-[var(--sec)]/40
      hover:shadow-[0_0_40px_rgba(21,128,61,0.1)]"
    >

      <div
        class="pointer-events-none absolute -left-24 -top-24
        h-72 w-72 rounded-full
        bg-[var(--sec)] opacity-[0.045] blur-3xl
        transition-opacity duration-500
        group-hover:opacity-[0.09]"
      ></div>

      <a
        href="/projects/network"
        class="relative block p-7 md:p-10"
      >

        <div class="flex flex-col md:flex-row gap-8">

          <div class="flex flex-1 flex-col justify-between">

            <div>

              <div class="mb-5 flex items-center gap-3">

                <span
                  class="font-mono text-xs tracking-[0.2em]
                  text-[var(--sec)]"
                >
                  PROJECT 05
                </span>

                <span
                  class="h-px w-12 bg-[var(--sec)] opacity-40"
                ></span>

                <span
                  class="text-xs uppercase tracking-widest
                  text-[var(--white-icon)]"
                >
                  Networking
                </span>

              </div>

              <h3
                class="text-2xl md:text-4xl font-medium
                tracking-tight text-[var(--white)]
                transition-colors duration-300
                group-hover:text-[var(--sec)]"
              >
                Network Protocol Simulator
                <span class="text-[var(--sec)]">.</span>
              </h3>

              <p
                class="mt-4 max-w-2xl text-base md:text-lg
                leading-relaxed text-[var(--white-icon)]"
              >
                An interactive simulator for the TCP three-way handshake,
                TCP vs UDP packet loss and retransmission, and message
                framing over a byte stream &mdash; the transport layer,
                animated and stepped through by hand.
              </p>

              <div
                class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4"
              >

                <div>

                  <p
