<!-- ============================================================= -->
<!-- PROJECT 03 WEATHER PREVIEW SCRIPT -->
<!-- ============================================================= -->

<script>
  interface WeatherPreview {
    latitude: number;
    longitude: number;
    selector: string;
  }

  const weatherLocations: WeatherPreview[] = [
    {
      latitude: 38.6983,
      longitude: -0.4743,
      selector: ".weather-preview-temp-alcoi",
    },
    {
      latitude: 39.4699,
      longitude: -0.3763,
      selector: ".weather-preview-temp-valencia",
    },
  ];

  async function loadWeatherPreview(
    location: WeatherPreview
  ) {
    try {
      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${location.latitude}` +
        `&longitude=${location.longitude}` +
        `&current=temperature_2m` +
        `&timezone=Europe%2FMadrid`;

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Weather request failed");
      }

      const data = await response.json();

      const temperature =
        data.current?.temperature_2m;

      const element =
        document.querySelector<HTMLElement>(
          location.selector
        );

      if (element && typeof temperature === "number") {
        element.textContent =
          `${Math.round(temperature)}°C`;
      }

    } catch (error) {
      console.error(
        "Unable to load weather preview:",
        error
      );
    }
  }

  weatherLocations.forEach(
    loadWeatherPreview
  );
</script>


<!-- ============================================================= -->
<!-- PROJECT 03 BACKGROUND -->
<!-- ============================================================= -->

<style>
  .weather-orb {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.08;
    background: var(--sec);
    will-change: transform;
  }

  .weather-orb-one {
    top: -180px;
    right: -100px;
    animation:
      weatherFloatOne 12s ease-in-out infinite;
  }

  .weather-orb-two {
    bottom: -220px;
    left: 20%;
    width: 350px;
    height: 350px;
    opacity: 0.045;
    animation:
      weatherFloatTwo 15s ease-in-out infinite;
  }

  .weather-grid {
    position: absolute;
    inset: 0;
    opacity: 0.045;

    background-image:
      linear-gradient(
        rgba(164, 118, 255, 0.5) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(164, 118, 255, 0.5) 1px,
        transparent 1px
      );

    background-size: 45px 45px;

    mask-image:
      radial-gradient(
        ellipse at center,
        black 0%,
        transparent 75%
      );

    animation:
      weatherGridMove 18s linear infinite;
  }

  .weather-noise {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    pointer-events: none;

    background-image:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");

    mix-blend-mode: screen;
  }

  @keyframes weatherFloatOne {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(-80px, 55px, 0)
        scale(1.18);
    }
  }

  @keyframes weatherFloatTwo {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(100px, -60px, 0)
        scale(1.12);
    }
  }

  @keyframes weatherGridMove {
    from {
      background-position:
        0 0,
        0 0;
    }

    to {
      background-position:
        45px 45px,
        45px 45px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-orb,
    .weather-grid {
      animation: none;
    }
  }
</style>