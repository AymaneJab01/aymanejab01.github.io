<section
  id="projects"
  class="text-[var(--white)] py-24 md:py-36"
>
  <div class="max-w-6xl mx-auto px-6">

    <!-- ===================================================== -->
    <!-- SECTION HEADER -->
    <!-- ===================================================== -->

    <div class="mb-12">
      <p
        class="
          text-sm
          uppercase
          tracking-[0.25em]
          text-[var(--sec)]
          shiny-sec
          mb-3
        "
      >
        Projects
      </p>

      <h2
        class="
          text-3xl md:text-5xl
          font-medium
          tracking-tight
        "
      >
        Things I'm building<span class="text-[var(--sec)]">.</span>
      </h2>

      <p
        class="
          mt-4
          max-w-2xl
          text-[var(--white-icon)]
          text-base md:text-lg
          leading-relaxed
        "
      >
        A collection of projects, experiments and tools
        that evolve over time.
      </p>
    </div>


    <!-- ===================================================== -->
    <!-- PROJECT 01 — DEVELOPER TERMINAL -->
    <!-- ===================================================== -->

    <a
      href="#terminal"
      class="group block mb-8"
      aria-label="Go to Developer Terminal"
    >
      <article
        class="
          relative overflow-hidden
          rounded-2xl
          border border-[var(--white-icon-tr)]
          bg-[#1414149c]
          backdrop-blur-sm

          transition-all duration-500

          hover:border-[var(--sec)]
          hover:-translate-y-1
          hover:shadow-[0_0_40px_rgba(0,255,140,0.08)]
        "
      >

        <!-- Glow -->
        <div
          class="
            pointer-events-none
            absolute
            -top-32
            -right-32
            h-64
            w-64
            rounded-full
            bg-[var(--sec)]
            opacity-[0.04]
            blur-3xl
            transition-opacity
            duration-500
            group-hover:opacity-[0.10]
          "
        ></div>

        <div
          class="
            relative
            p-7 md:p-10
            grid md:grid-cols-[1fr_auto]
            gap-8
            items-center
          "
        >

          <!-- Project information -->
          <div>

            <!-- Project number -->
            <div class="flex items-center gap-3 mb-5">

              <span
                class="
                  text-xs
                  uppercase
                  tracking-[0.25em]
                  text-[var(--sec)]
                  shiny-sec
                "
              >
                Project 01
              </span>

              <span
                class="
                  h-px
                  w-10
                  bg-[var(--sec)]
                  opacity-50
                "
              ></span>

              <span
                class="
                  text-xs
                  uppercase
                  tracking-wider
                  text-[var(--white-icon)]
                "
              >
                Interactive
              </span>

            </div>

            <!-- Title -->
            <h3
              class="
                text-2xl md:text-4xl
                font-medium
                tracking-tight
                text-[var(--white)]
              "
            >
              Developer Terminal
              <span class="text-[var(--sec)]">.</span>
            </h3>

            <!-- Description -->
            <p
              class="
                mt-4
                max-w-2xl
                text-[var(--white-icon)]
                text-base md:text-lg
                leading-relaxed
              "
            >
              An interactive terminal built directly into this portfolio,
              showcasing commands, projects and developer experiments.
              It will continue evolving day after day as new features,
              commands and ideas are added.
            </p>

            <!-- Technologies -->
            <div
              class="
                mt-6
                flex flex-wrap
                items-center
                gap-3
              "
            >
              <span
                class="
                  rounded-full
                  border border-[var(--white-icon-tr)]
                  px-3 py-1
                  text-xs
                  text-[var(--white-icon)]
                "
              >
                Astro
              </span>

              <span
                class="
                  rounded-full
                  border border-[var(--white-icon-tr)]
                  px-3 py-1
                  text-xs
                  text-[var(--white-icon)]
                "
              >
                Interactive UI
              </span>

              <span
                class="
                  rounded-full
                  border border-[var(--sec)]
                  px-3 py-1
                  text-xs
                  text-[var(--sec)]
                "
              >
                Evolving
              </span>
            </div>

          </div>

          <!-- Explore -->
          <div
            class="
              flex
              items-center
              justify-center
              md:justify-end
            "
          >
            <div
              class="
                flex
                items-center
                gap-3
                text-[var(--white-icon)]
                transition-all
                duration-300
                group-hover:text-[var(--sec)]
              "
            >
              <span
                class="
                  text-sm
                  uppercase
                  tracking-widest
                "
              >
                Explore
              </span>

              <span
                class="
                  flex
                  h-11
                  w-11
                  items-center
                  justify-center
                  rounded-full
                  border
                  border-[var(--white-icon-tr)]
                  transition-all
                  duration-300

                  group-hover:border-[var(--sec)]
                  group-hover:translate-y-[-3px]
                "
              >
                ↑
              </span>
            </div>
          </div>

        </div>
      </article>
    </a>


    <!-- ===================================================== -->
    <!-- PROJECT 02 — MOVIE RANKING -->
    <!-- ===================================================== -->

    <a
      href="#movie-ranking"
      class="group block"
      aria-label="Open Movie Ranking project"
    >
      <article
        id="movie-ranking"
        class="
          relative
          overflow-hidden
          rounded-2xl
          border border-[var(--white-icon-tr)]
          bg-[#1414149c]
          backdrop-blur-sm

          transition-all
          duration-500

          hover:border-[var(--sec)]
          hover:-translate-y-1
          hover:shadow-[0_0_40px_rgba(0,255,140,0.08)]
        "
      >

        <!-- Background glow -->
        <div
          class="
            pointer-events-none
            absolute
            -bottom-32
            -left-32
            h-64
            w-64
            rounded-full
            bg-[var(--sec)]
            opacity-[0.04]
            blur-3xl
            transition-opacity
            duration-500
            group-hover:opacity-[0.10]
          "
        ></div>


        <div
          class="
            relative
            p-7 md:p-10
          "
        >

          <!-- Project number -->
          <div
            class="
              flex
              items-center
              gap-3
              mb-8
            "
          >

            <span
              class="
                text-xs
                uppercase
                tracking-[0.25em]
                text-[var(--sec)]
                shiny-sec
              "
            >
              Project 02
            </span>

            <span
              class="
                h-px
                w-10
                bg-[var(--sec)]
                opacity-50
              "
            ></span>

            <span
              class="
                text-xs
                uppercase
                tracking-wider
                text-[var(--white-icon)]
              "
            >
              Web Application
            </span>

          </div>


          <!-- ================================================= -->
          <!-- MOVIE APPLICATION PREVIEW -->
          <!-- ================================================= -->

          <div
            class="
              grid
              md:grid-cols-[220px_1fr]
              gap-8
              md:gap-10
              items-center
            "
          >

            <!-- Movie cover -->
            <div
              class="
                relative
                mx-auto
                w-full
                max-w-[220px]
                overflow-hidden
                rounded-xl
                border
                border-[var(--white-icon-tr)]
                bg-[#0b0b0b]
                shadow-2xl
              "
            >

              <img
                src="public/svg/avg-inf.png"
                alt="Avengers Infinity War movie poster"
                class="
                  block
                  w-full
                  aspect-[2/3]
                  object-cover
                  transition-transform
                  duration-700
                  group-hover:scale-[1.03]
                "
              />

              <!-- Poster overlay -->
              <div
                class="
                  pointer-events-none
                  absolute
                  inset-0
                  bg-gradient-to-t
                  from-black/40
                  via-transparent
                  to-transparent
                "
              ></div>

            </div>


            <!-- Movie information -->
            <div>

              <!-- Application title -->
              <h3
                class="
                  text-2xl md:text-4xl
                  font-medium
                  tracking-tight
                  text-[var(--white)]
                "
              >
                Movie Ranking
                <span class="text-[var(--sec)]">.</span>
              </h3>


              <p
                class="
                  mt-3
                  text-[var(--white-icon)]
                  text-base md:text-lg
                  leading-relaxed
                  max-w-2xl
                "
              >
                A personal movie-ranking application where films
                are presented through their covers, ratings and
                individual reviews.
              </p>


              <!-- Movie -->
              <div class="mt-7">

                <div
                  class="
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    gap-4
                  "
                >

                  <!-- Movie title -->
                  <h4
                    class="
                      text-xl
                      md:text-2xl
                      font-medium
                      text-[var(--white)]
                    "
                  >
                    Avengers: Infinity War
                  </h4>


                  <!-- Rating -->
                  <div
                    class="
                      inline-flex
                      w-fit
                      items-center
                      gap-2
                      rounded-full
                      border
                      border-[var(--sec)]
                      bg-[var(--sec)]
                      bg-opacity-5
                      px-4
                      py-2
                    "
                  >

                    <span
                      class="
                        text-[var(--sec)]
                        text-sm
                      "
                    >
                      ★
                    </span>

                    <span
                      class="
                        text-sm
                        font-semibold
                        text-[var(--sec)]
                      "
                    >
                      9 / 10
                    </span>

                  </div>

                </div>


                <!-- Review -->
                <div
                  class="
                    mt-5
                    border-l-2
                    border-[var(--sec)]
                    pl-5
                  "
                >

                  <p
                    class="
                      text-[var(--white-icon)]
                      leading-relaxed
                      italic
                    "
                  >
                    "A very solid movie in general and one of the
                    best superhero movies."
                  </p>

                </div>

              </div>


              <!-- Technology tags -->
              <div
                class="
                  mt-7
                  flex
                  flex-wrap
                  items-center
                  gap-3
                "
              >

                <span
                  class="
                    rounded-full
                    border
                    border-[var(--white-icon-tr)]
                    px-3
                    py-1
                    text-xs
                    text-[var(--white-icon)]
                  "
                >
                  Web App
                </span>

                <span
                  class="
                    rounded-full
                    border
                    border-[var(--white-icon-tr)]
                    px-3
                    py-1
                    text-xs
                    text-[var(--white-icon)]
                  "
                >
                  Movie Database
                </span>

                <span
                  class="
                    rounded-full
                    border
                    border-[var(--sec)]
                    px-3
                    py-1
                    text-xs
                    text-[var(--sec)]
                  "
                >
                  9 / 10
                </span>

              </div>

            </div>

          </div>


          <!-- Bottom project action -->
          <div
            class="
              mt-10
              pt-6
              border-t
              border-[var(--white-icon-tr)]
              flex
              items-center
              justify-between
            "
          >

            <span
              class="
                text-xs
                uppercase
                tracking-[0.2em]
                text-[var(--white-icon)]
              "
            >
              Movie collection
            </span>

            <span
              class="
                flex
                items-center
                gap-2
                text-sm
                uppercase
                tracking-widest
                text-[var(--white-icon)]
                transition-colors
                duration-300
                group-hover:text-[var(--sec)]
              "
            >
              View project

              <span
                class="
                  transition-transform
                  duration-300
                  group-hover:translate-x-1
                "
              >
                →
              </span>
            </span>

          </div>

        </div>
      </article>
    </a>

  </div>
</section>