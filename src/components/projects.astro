---
import Terminal from "../React/Terminal.tsx";
---

<section
  id="projects"
  class="text-[var(--white)] py-24 md:py-36"
>
  <div class="max-w-5xl mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-2xl border border-[var(--white-icon-tr)]
      bg-[#1414149c] px-6 py-8 md:px-10 md:py-10
      backdrop-blur-sm"
    >
      <!-- Subtle green glow -->
      <div
        class="absolute -top-24 left-1/2 h-48 w-48 -translate-x-1/2
        rounded-full bg-[var(--sec)] opacity-10 blur-3xl"
      ></div>

      <div class="relative">

        <!-- Project heading -->
        <div class="mb-8 text-center">
          <div class="mb-4 flex items-center justify-center gap-2">
            <span
              class="h-2 w-2 rounded-full bg-[var(--sec)]
              shadow-[0_0_12px_var(--sec)] animate-pulse"
            ></span>

            <span
              class="text-sm tracking-widest uppercase
              text-[var(--sec)] shiny-sec"
            >
              Interactive Project
            </span>
          </div>

          <h2
            class="text-3xl md:text-5xl font-medium tracking-tight
            text-[var(--white)]"
          >
            Portfolio<span class="text-[var(--sec)]"> Terminal.</span>
          </h2>

          <p
            class="mt-4 mx-auto max-w-2xl text-base md:text-lg
            text-[var(--white-icon)] leading-relaxed"
          >
            An interactive terminal where you can explore my background,
            skills, projects, education and contact information.
          </p>
        </div>

        <!-- Terminal -->
        <div class="w-full">
          <Terminal client:load />
        </div>

      </div>
    </div>
  </div>
</section>