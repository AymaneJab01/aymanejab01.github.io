<!-- ============================================================= -->
<!-- TERMINAL SCRIPT -->
<!-- ============================================================= -->

<script>
  const terminalInput =
    document.querySelector("#terminal-input") as HTMLInputElement | null;

  const terminalOutput =
    document.querySelector("#terminal-output") as HTMLDivElement | null;

  const terminalForm =
    document.querySelector("#terminal-form") as HTMLFormElement | null;

  const terminalWindow =
    document.querySelector("#portfolio-terminal") as HTMLDivElement | null;

  type TerminalCommand = () => string;

  const history: string[] = [];
  let historyIndex: number = -1;

  const escapeHTML = (value: string): string => {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  };

  const addCommand = (command: string): void => {
    if (!terminalOutput) return;

    const line = document.createElement("div");

    line.className = "terminal-command-line";

    line.innerHTML = `
      <span class="terminal-prompt-main">
        <span class="terminal-user">aymane</span>
        <span class="terminal-at">@</span>
        <span class="terminal-host">portfolio</span>
        <span class="terminal-colon">:</span>
        <span class="terminal-path">~</span>
        <span class="terminal-symbol">$</span>
      </span>

      <span class="terminal-command-text">
        ${escapeHTML(command)}
      </span>
    `;

    terminalOutput.appendChild(line);
  };

  const addResponse = (html: string): void => {
    if (!terminalOutput) return;

    const response = document.createElement("div");

    response.className = "terminal-response";
    response.innerHTML = html;

    terminalOutput.appendChild(response);

    terminalOutput.scrollTop = terminalOutput.scrollHeight;
  };

  const commands: Record<string, TerminalCommand> = {
    help: (): string => `
      <div class="terminal-help">

        <div class="terminal-response-title">
          Available commands
        </div>

        <div class="terminal-command-grid">

          <div>
            <span class="terminal-command-name">
              whoami
            </span>

            <span class="terminal-command-description">
              — about me
            </span>
          </div>

          <div>
            <span class="terminal-command-name">
              skills
            </span>

            <span class="terminal-command-description">
              — technologies & tools
            </span>
          </div>

          <div>
            <span class="terminal-command-name">
              projects
            </span>

            <span class="terminal-command-description">
              — view my projects
            </span>
          </div>

          <div>
            <span class="terminal-command-name">
              contact
            </span>

            <span class="terminal-command-description">
              — contact information
            </span>
          </div>

          <div>
            <span class="terminal-command-name">
