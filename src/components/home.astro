    position:
      relative;

    color:
      rgba(125,211,252,.55);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      9px;

    text-transform:
      uppercase;

