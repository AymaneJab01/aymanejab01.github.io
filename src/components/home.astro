---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import Terminal from "../React/Terminal.tsx";
---

<section
  id="home"
  class="relative overflow-hidden bg-transparent text-[var(--white)]"
>
  <!-- ========================================================= -->
  <!-- BACKGROUND -->
  <!-- ========================================================= -->

  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  >
    <div
      class="absolute inset-0 opacity-[0.08]"
    >
      <LetterGlitch
        client:load
        glitchSpeed={50}
        centerVignette={true}
        outerVignette={true}
        smooth={true}
      />
    </div>

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.35)_100%)]"
    ></div>
  </div>

  <!-- ========================================================= -->
  <!-- HERO -->
  <!-- ========================================================= -->

  <div
    class="mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 pb-20 pt-32 lg:px-10"
  >
    <div class="max-w-5xl">

      <!-- Small label -->
      <div
        class="mb-7 flex items-center gap-3 text-sm font-medium tracking-[0.25em] text-blue-400 uppercase"
      >
        <span
          class="h-px w-10 bg-blue-400"
        ></span>

        Computer Science
      </div>

      <!-- Main title -->
      <h1
        class="text-5xl font-bold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl"
      >
        Aymane
        <span class="text-blue-400">
          Jabrane
        </span>
      </h1>

      <!-- Description -->
      <p
        class="mt-8 max-w-2xl text-lg leading-8 text-white/60 sm:text-xl"
      >
        Software developer focused on building modern applications,
        solving complex problems, and turning ideas into reliable
        digital experiences.
      </p>

      <!-- CTA -->
      <div class="mt-10 flex flex-wrap gap-4">

        <a
          href="#projects"
          class="group relative overflow-hidden rounded-full border border-blue-400/40 bg-blue-500/10 px-7 py-3.5 text-sm font-semibold text-blue-300 transition-all duration-300 hover:border-blue-400 hover:bg-blue-500/20 hover:text-white"
        >
          <span class="relative z-10">
            View Projects
          </span>

          <span
            class="absolute inset-0 -translate-x-full bg-blue-400/10 transition-transform duration-500 group-hover:translate-x-0"
          ></span>
        </a>

        <a
          href="#contact"
          class="rounded-full border border-white/10 bg-white/[0.03] px-7 py-3.5 text-sm font-semibold text-white/80 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:text-white"
        >
          Let's build something together
        </a>

      </div>
    </div>

    <!-- ======================================================= -->
    <!-- SKILLS -->
    <!-- ======================================================= -->

    <div class="mt-24">
      <SkillsList client:load />
    </div>

    <!-- ======================================================= -->
    <!-- LOGOS -->
    <!-- ======================================================= -->

    <div class="mt-20">
      <LogoWall />
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- PROJECTS -->
  <!-- ========================================================= -->

  <section
    id="projects"
    class="mx-auto max-w-7xl px-6 py-32 lg:px-10"
  >

    <!-- Section heading -->
    <div class="mb-16">

      <div
        class="mb-5 flex items-center gap-3 text-sm font-medium tracking-[0.25em] text-blue-400 uppercase"
      >
        <span class="h-px w-10 bg-blue-400"></span>

        Projects
      </div>

      <h2
        class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
      >
        Things I've
        <span class="text-blue-400">
          built
        </span>
      </h2>

      <p
        class="mt-6 max-w-2xl text-base leading-7 text-white/50 sm:text-lg"
      >
        A selection of projects, experiments, and systems I've been
        working on.
      </p>

    </div>

    <!-- ======================================================= -->
    <!-- PROJECT GRID -->
    <!-- ======================================================= -->

    <div class="grid gap-8 lg:grid-cols-2">

      <!-- ===================================================== -->
      <!-- TERMINAL PROJECT -->
      <!-- ===================================================== -->

      <article
        class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.025] transition-all duration-500 hover:border-blue-400/30 hover:bg-white/[0.04]"
      >

        <!-- Glow -->
        <div
          class="pointer-events-none absolute -right-32 -top-32 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl transition-all duration-500 group-hover:bg-blue-500/20"
        ></div>

        <div class="relative p-6 sm:p-8">

          <!-- Project header -->
          <div
            class="mb-7 flex items-start justify-between gap-5"
          >

            <div>

              <div
                class="mb-3 inline-flex items-center gap-2 rounded-full border border-blue-400/20 bg-blue-400/5 px-3 py-1 text-xs font-medium text-blue-300"
              >
                <span
                  class="h-1.5 w-1.5 rounded-full bg-blue-400"
                ></span>

                In Progress
              </div>

              <h3
                class="text-2xl font-bold text-white sm:text-3xl"
              >
                Interactive Developer Terminal
              </h3>

            </div>

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-blue-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m4 17 6-6-6-6"></path>
                <path d="M12 19h8"></path>
              </svg>
            </div>

          </div>

          <!-- Project description -->
          <p
            class="mb-8 max-w-xl text-sm leading-7 text-white/50 sm:text-base"
          >
            A custom interactive terminal designed to showcase
            development skills, Linux commands, system concepts,
            and technical projects directly inside the portfolio.
          </p>

          <!-- ================================================= -->
          <!-- TERMINAL DISPLAY -->
          <!-- ================================================= -->

          <div
            class="overflow-hidden rounded-2xl border border-white/10 bg-black/60 shadow-2xl shadow-blue-950/20"
          >

            <!-- Terminal top bar -->
            <div
              class="flex h-10 items-center border-b border-white/10 bg-white/[0.025] px-4"
            >

              <div class="flex items-center gap-1.5">

                <span
                  class="h-2.5 w-2.5 rounded-full bg-red-400/70"
                ></span>

                <span
                  class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"
                ></span>

                <span
                  class="h-2.5 w-2.5 rounded-full bg-green-400/70"
                ></span>

              </div>

              <span
                class="ml-auto mr-auto -translate-x-7 font-mono text-[11px] text-white/30"
              >
                terminal
              </span>

            </div>

            <!-- Existing terminal component -->
            <div class="min-h-[320px]">
              <Terminal client:load />
            </div>

          </div>

          <!-- Technologies -->
          <div
            class="mt-7 flex flex-wrap gap-2"
          >

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              TypeScript
            </span>

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              React
            </span>

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              Linux
            </span>

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              Astro
            </span>

          </div>

        </div>
      </article>

      <!-- ===================================================== -->
      <!-- SECOND PROJECT -->
      <!-- ===================================================== -->

      <article
        class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.025] transition-all duration-500 hover:border-blue-400/30 hover:bg-white/[0.04]"
      >

        <div
          class="pointer-events-none absolute -left-32 -top-32 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl transition-all duration-500 group-hover:bg-blue-500/20"
        ></div>

        <div class="relative p-6 sm:p-8">

          <div
            class="mb-7 flex items-start justify-between gap-5"
          >

            <div>

              <div
                class="mb-3 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs font-medium text-white/40"
              >
                <span
                  class="h-1.5 w-1.5 rounded-full bg-white/30"
                ></span>

                Development
              </div>

              <h3
                class="text-2xl font-bold text-white sm:text-3xl"
              >
                Software Projects
              </h3>

            </div>

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-blue-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect
                  width="18"
                  height="18"
                  x="3"
                  y="3"
                  rx="2"
                ></rect>

                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
              </svg>
            </div>

          </div>

          <p
            class="mb-8 max-w-xl text-sm leading-7 text-white/50 sm:text-base"
          >
            Applications and experiments covering software
            engineering, computer science, algorithms, networking,
            and modern web development.
          </p>

          <!-- Project visual -->
          <div
            class="relative flex min-h-[320px] items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-black/30"
          >

            <div
              class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:35px_35px]"
            ></div>

            <div
              class="relative text-center"
            >

              <div
                class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl border border-blue-400/20 bg-blue-400/5 text-blue-400"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="30"
                  height="30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline
                    points="16 18 22 12 16 6"
                  ></polyline>

                  <polyline
                    points="8 6 2 12 8 18"
                  ></polyline>

                </svg>

              </div>

              <h4
                class="text-lg font-semibold text-white/80"
              >
                Building the future
              </h4>

              <p
                class="mt-2 text-sm text-white/35"
              >
                More projects coming soon.
              </p>

            </div>

          </div>

          <div
            class="mt-7 flex flex-wrap gap-2"
          >

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              Software Engineering
            </span>

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              Algorithms
            </span>

            <span
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-white/50"
            >
              Networking
            </span>

          </div>

        </div>
      </article>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- CONTACT -->
  <!-- ========================================================= -->

  <section
    id="contact"
    class="mx-auto max-w-7xl px-6 py-32 lg:px-10"
  >

    <div
      class="relative overflow-hidden rounded-3xl border border-blue-400/20 bg-blue-500/[0.04] px-6 py-20 text-center sm:px-10"
    >

      <div
        class="pointer-events-none absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/10 blur-3xl"
      ></div>

      <div class="relative">

        <p
          class="mb-5 text-sm font-medium tracking-[0.25em] text-blue-400 uppercase"
        >
          Have an idea?
        </p>

        <h2
          class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          Let's build something
          <span class="text-blue-400">
            together.
          </span>
        </h2>

        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-7 text-white/50 sm:text-lg"
        >
          Whether it's a software project, an experiment, or a
          challenging technical problem, let's turn it into
          something real.
        </p>

        <div class="mt-9">

          <a
            href="mailto:your-email@example.com"
            class="inline-flex rounded-full border border-blue-400/40 bg-blue-500/10 px-8 py-4 text-sm font-semibold text-blue-300 transition-all duration-300 hover:border-blue-400 hover:bg-blue-500/20 hover:text-white"
          >
            Get in touch
          </a>

        </div>

      </div>

    </div>
  </section>

</section>