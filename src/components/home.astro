          <div class="flex items-center gap-2">

            <!-- GitHub -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/AymaneJab01"
              aria-label="GitHub"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
