      rgba(37,99,235,.08);

    box-shadow:
      0 12px 30px
      rgba(37,99,235,.12);
  }

  /* ============================================================
     GLITCH CARD
     ============================================================ */

  .glitch-glow {
    position: absolute;

    inset:
      10% -10% -10% 10%;

    border-radius:
      40%;

    background:
      radial-gradient(
        ellipse,
        rgba(37,99,235,.2),
        rgba(76,29,149,.08) 45%,
        transparent 72%
      );

    filter:
      blur(50px);

    pointer-events:
      none;

    animation:
      pulseGlow 5s
      ease-in-out
      infinite alternate;
  }

  .glitch-card {
    border:
      1px solid
      rgba(255,255,255,.08);

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.07),
        rgba(255,255,255,.025)
      );

    box-shadow:
      0 40px 100px rgba(0,0,0,.35),
      inset 0 1px 0 rgba(255,255,255,.07);

    backdrop-filter:
      blur(30px);

    -webkit-backdrop-filter:
      blur(30px);

    transition:
      transform .6s cubic-bezier(.16,1,.3,1),
      border-color .4s ease,
      box-shadow .4s ease;
  }

  .glitch-card:hover {
    transform:
      translateY(-7px)
      rotateX(1deg)
      rotateY(-1deg);

    border-color:
      rgba(96,165,250,.18);

    box-shadow:
      0 50px 120px rgba(0,0,0,.45),
      0 0 50px rgba(37,99,235,.07),
      inset 0 1px 0 rgba(255,255,255,.1);
  }

  .glitch-card-titlebar {
