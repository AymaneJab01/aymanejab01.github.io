     ============================================================ */

  async function executeCommand(
    rawCommand
  ) {

    const command =
      rawCommand.trim();

    if (!command)
      return;

    if (
      command.toLowerCase() ===
      "clear"
    ) {

      terminalOutput.innerHTML = "";

      return;
    }

    const normalized =
      command.toLowerCase();

    /*
     * OPEN
     */

    if (
      normalized.startsWith(
        "open "
      )
    ) {

      const target =
        normalized
          .slice(5)
          .trim();

      const url =
        OPENABLE_TARGETS[target];

      if (!url) {

        addResponse(
          `
            <span class="terminal-error">
              Unknown target:
              ${escapeHTML(target)}
            </span>
          `,
          "error"
        );

        return;
      }

      addResponse(
        `
          Opening
          <span class="terminal-highlight">
            ${escapeHTML(target)}
          </span>
          ...
        `,
        "success-response"
      );

      goTo(url);

      return;
    }

    /*
     * WEATHER
     */

    if (
      normalized.startsWith(
        "weather "
      )
    ) {

      const city =
        command
          .slice(8)
          .trim();

      const normalizedCity =
        Object.keys(
          WEATHER_LOCATIONS
        ).find(
          (name) =>
            name.toLowerCase() ===
            city.toLowerCase()
        );

      if (!normalizedCity) {

        addResponse(
          `
            <span class="terminal-error">
              Available locations:
              Alcoi, Valencia, Torrevieja
            </span>
          `,
          "error"
        );

        return;
      }

      addResponse(
        `
          Fetching weather for
          <span class="terminal-highlight">
            ${escapeHTML(normalizedCity)}
          </span>
          ...
        `,
        "info"
      );

      const result =
        await fetchWeather(
          normalizedCity
        );

      addResponse(
        result
      );

      return;
    }

    /*
     * NORMAL COMMAND
     */

    const handler =
      commands[normalized];

    if (handler) {

      const result =
        handler();

      addResponse(
        result
      );

      return;
    }

    /*
     * DIRECT PROJECT OPEN
     */

    if (
      OPENABLE_TARGETS[
        normalized
      ]
    ) {

      addResponse(
        `
          Opening
          <span class="terminal-highlight">
            ${escapeHTML(normalized)}
          </span>
          ...
        `,
        "success-response"
      );

      goTo(
        OPENABLE_TARGETS[
          normalized
        ]
      );

      return;
    }

    /*
     * UNKNOWN COMMAND
     */

    addResponse(
      `
        <span class="terminal-error">
          Command not found:
          ${escapeHTML(command)}
        </span>

        <div class="terminal-small-gap"></div>

        <span class="terminal-muted">
          Type "help" to see available commands.
        </span>
      `,
      "error"
    );
  }

  /* ============================================================
