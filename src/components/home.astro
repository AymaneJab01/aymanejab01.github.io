    <div class="nebula-field">
      <div class="nebula-ribbon ribbon-back"></div>
      <div class="nebula-ribbon ribbon-mid"></div>
      <div class="nebula-ribbon ribbon-core"></div>

      <div class="nebula-glow glow-a"></div>
      <div class="nebula-glow glow-b"></div>
    </div>

    <!-- Cursor-reactive light -->
    <div id="cursor-glow" class="cursor-glow"></div>
    <div id="cursor-glow-secondary" class="cursor-glow-secondary"></div>

    <!-- Cursor distortion ring -->
    <div id="cursor-ring" class="cursor-ring"></div>

    <!-- Small particles -->
    <div id="cursor-particles" class="cursor-particles"></div>

    <!-- Grid -->
    <div class="absolute inset-0 hero-dots opacity-[0.5]"></div>

    <!-- Noise -->
    <div class="absolute inset-0 noise-layer opacity-[0.025]"></div>

    <!-- Vignette -->
    <div class="hero-vignette"></div>

    <!-- Cursor-following spotlight -->
    <div id="cursor-spotlight" class="cursor-spotlight"></div>
  </div>

