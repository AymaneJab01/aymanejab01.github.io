*---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<div class="apple-page">

  <!-- ========================================================= -->
  <!-- HERO -->
  <!-- ========================================================= -->

  <section id="home" class="hero">

    <div class="hero-inner">

      <div class="hero-copy">

        <div class="availability">
          <span class="availability-dot"></span>
          <span>Open to opportunities</span>
        </div>

        <h1>
          Hi, I’m Aymane.
          <span>Software Developer.</span>
        </h1>

        <p class="hero-lead">
          I build thoughtful software at the intersection of
          computer science, systems and creative ideas.
        </p>

        <div class="hero-actions">

          <a href="#projects" class="button button-primary">
            Explore my work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11" />
              <path d="m11 5 5 5-5 5" />
            </svg>
          </a>

          <a
            href="https://github.com/AymaneJab01"
            target="_blank"
            rel="noopener noreferrer"
            class="button button-secondary"
          >
            GitHub
          </a>

          <a
            href="https://www.linkedin.com/in/aymane-jabrane-73025726a/"
            target="_blank"
            rel="noopener noreferrer"
            class="button button-secondary"
          >
            LinkedIn
          </a>

        </div>

        <div class="hero-meta">
          <span>Computer Science</span>
          <i></i>
          <span>Software</span>
          <i></i>
          <span>Systems</span>
          <i></i>
          <span>Spain</span>
        </div>

      </div>

      <!-- Developer visual -->

      <div class="hero-visual">

        <div class="developer-card">

          <div class="developer-topbar">

            <div class="window-controls">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="developer-title">
              developer
            </div>

            <div></div>

          </div>

          <div class="developer-content">

            <div class="developer-label">
              <span></span>
              &lt; build /&gt;
            </div>

            <div class="glitch-wrapper">
              <LetterGlitch
                client:load
                glitchColors={["#1d4ed8", "#2563eb", "#172554"]}
                glitchSpeed={33}
                centerVignette={false}
                outerVignette={true}
                smooth={true}
              />
            </div>

            <div class="developer-footer">
              <span class="online-dot"></span>
              system ready
            </div>

          </div>

        </div>

      </div>

    </div>

    <div class="hero-scroll">
      <span>Scroll to explore</span>

      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 4v11" />
        <path d="m5 11 5 5 5-5" />
      </svg>
    </div>

  </section>


  <!-- ========================================================= -->
  <!-- TECHNOLOGIES -->
  <!-- ========================================================= -->

  <section id="technologies" class="section technologies-section">

    <div class="section-inner">

      <div class="section-intro">

        <p class="eyebrow">
          Technologies
        </p>

        <h2>
          The tools behind
          <span>the work.</span>
        </h2>

        <p>
          A practical stack built around modern web development,
          programming, systems and software engineering.
        </p>

      </div>

      <div class="technology-wall">
        <LogoWall />
      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- SKILLS -->
  <!-- ========================================================= -->

  <section id="skills" class="section skills-section">

    <div class="section-inner">

      <div class="section-intro">

        <p class="eyebrow">
          Capabilities
        </p>

        <h2>
          From an idea
          <span>to something real.</span>
        </h2>

        <p>
          I enjoy understanding how things work,
          solving difficult problems and turning those ideas
          into software people can actually use.
        </p>

      </div>

      <div class="skills-container">
        <SkillsList client:visible />
      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- NOTES -->
  <!-- ========================================================= -->

  <section id="notes" class="section notes-section">

    <div class="section-inner">

      <div class="section-intro">

        <p class="eyebrow">
          Notes
        </p>

        <h2>
          Always
          <span>learning.</span>
        </h2>

        <p>
          Notes and references from the subjects,
          technologies and concepts I’ve been exploring.
        </p>

      </div>


      <div class="notes-list">

        <a
          href="https://app.notion.com/p/Tablas-Hash-Vista-Practica-3a762e0580cb80de84eee02fade92863?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">01</span>

          <div class="note-main">
            <span>Data Structures</span>
            <h3>Hash Tables</h3>
          </div>

          <p>
            Hashing, collisions and efficient lookup.
          </p>

          <span class="note-arrow">↗</span>
        </a>


        <a
          href="https://app.notion.com/p/Computer-from-hardware-perspective-3a362e0580cb80cfbfa5f1228d060bcc?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">02</span>

          <div class="note-main">
            <span>Computer Architecture</span>
            <h3>Computer from Hardware Perspective</h3>
          </div>

          <p>
            Understanding computers from the hardware up.
          </p>

          <span class="note-arrow">↗</span>
        </a>


        <a
          href="https://app.notion.com/p/Tablas-Hash-Definiciones-3a662e0580cb80089dd9c287f8864a93?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">03</span>

          <div class="note-main">
            <span>Data Structures</span>
            <h3>Hash Tables — Definitions</h3>
          </div>

          <p>
            Core concepts behind hash-based structures.
          </p>

          <span class="note-arrow">↗</span>
        </a>


        <a
          href="https://app.notion.com/p/Git-Github-3a562e0580cb801089e5d47fbbaa221f?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">04</span>

          <div class="note-main">
            <span>Development</span>
            <h3>Git & GitHub</h3>
          </div>

          <p>
            Version control and modern workflows.
          </p>

          <span class="note-arrow">↗</span>
        </a>


        <a
          href="https://app.notion.com/p/Syst-me-Signaux-Analogue-vs-Digitale-3b062e0580cb80d3ba80cb3e8232dee1?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">05</span>

          <div class="note-main">
            <span>Systems</span>
            <h3>Analog vs Digital Signals</h3>
          </div>

          <p>
            How information is represented and transmitted.
          </p>

          <span class="note-arrow">↗</span>
        </a>


        <a
          href="https://app.notion.com/p/Java-3a262e0580cb8037bee0c0e9aa4b480c?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-row"
        >
          <span class="note-index">06</span>

          <div class="note-main">
            <span>Programming</span>
            <h3>Java</h3>
          </div>

          <p>
            Object-oriented programming and abstractions.
          </p>

          <span class="note-arrow">↗</span>
        </a>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- TERMINAL -->
  <!-- ========================================================= -->

  <section id="terminal" class="terminal-section">

    <div class="terminal-inner">

      <div class="terminal-copy">

        <p class="eyebrow">
          Interactive
        </p>

        <h2>
          A different way
          <span>to explore.</span>
        </h2>

        <p>
          Discover my projects, skills and background
          through an interactive developer terminal.
        </p>

        <a href="#terminal" class="terminal-link">
          Open terminal

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11" />
            <path d="m11 5 5 5-5 5" />
          </svg>
        </a>

      </div>


      <div class="terminal-window">

        <div class="terminal-bar">

          <div class="window-controls">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <span>aymane@portfolio</span>

          <div></div>

        </div>


        <div class="terminal-body">

          <div class="terminal-command">
            <span class="terminal-user">
              aymane@portfolio
            </span>

            <span class="terminal-colon">:</span>

            <span class="terminal-path">~</span>

            <span class="terminal-dollar">$</span>

            <span class="terminal-input">
              help
            </span>
          </div>

          <p>
            Welcome to Aymane's interactive terminal.
          </p>

          <p>
            Type
            <strong>"help"</strong>
            to explore available commands.
          </p>

          <div class="terminal-cursor"></div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- FINAL CTA -->
  <!-- ========================================================= -->

  <section id="contact" class="final-section">

    <div class="final-light"></div>

    <div class="final-inner">

      <p class="eyebrow final-eyebrow">
        Let’s build
      </p>

      <h2>
        Have an idea?
        <span>Let’s make it real.</span>
      </h2>

      <p class="final-description">
        Great software starts with a good idea.
        Whether it’s a project, an opportunity, or a problem worth solving,
        I’m interested in building something meaningful.
      </p>

      <a
        href="https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!"
        target="_blank"
        rel="noopener noreferrer"
        class="final-button"
      >
        <span>Let’s talk</span>

        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 10h11" />
          <path d="m11 5 5 5-5 5" />
        </svg>
      </a>

      <div class="final-meta">
        <span>Software Developer</span>
        <i></i>
        <span>Computer Science</span>
        <i></i>
        <span>Spain</span>
      </div>

    </div>

  </section>

</div>


<style>

  /* ========================================================= */
  /* APPLE DESIGN SYSTEM */
  /* ========================================================= */

  .apple-page {

    --black: #000000;
    --graphite: #050506;
    --graphite-2: #08090b;

    --white: #f5f5f7;
    --white-soft: #d2d2d7;

    --gray: #86868b;
    --gray-dark: #6e6e73;
    --gray-darker: #424245;

    --blue: #2997ff;
    --blue-light: #60a5fa;

    --line: rgba(255,255,255,0.09);
    --line-soft: rgba(255,255,255,0.055);

    min-height: 100vh;

    overflow: hidden;

    background: var(--black);

    color: var(--white);

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "SF Pro Display",
      "SF Pro Text",
      "Helvetica Neue",
      Arial,
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }


  /* ========================================================= */
  /* GLOBAL */
  /* ========================================================= */

  .apple-page *,
  .apple-page *::before,
  .apple-page *::after {
    box-sizing: border-box;
  }

  .apple-page a {
    color: inherit;
    text-decoration: none;
  }


  /* ========================================================= */
  /* HERO */
  /* ========================================================= */

  .hero {

    position: relative;

    min-height: 100vh;

    display: flex;

    align-items: center;

    background:

      radial-gradient(
        ellipse 70% 55% at 50% -10%,
        rgba(30, 64, 175, 0.18),
        transparent 65%
      ),

      linear-gradient(
        180deg,
        #050506 0%,
        #050506 70%,
        #000 100%
      );

    overflow: hidden;
  }


  .hero::after {

    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 220px;

    pointer-events: none;

    background:
      linear-gradient(
        to bottom,
        transparent,
        rgba(0,0,0,0.65)
      );
  }


  .hero-inner {

    position: relative;

    z-index: 2;

    width: min(1320px, calc(100% - 64px));

    margin: 0 auto;

    padding:
      150px 0
      120px;

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(420px, 0.95fr);

    align-items: center;

    gap: 100px;
  }


  /* ========================================================= */
  /* HERO COPY */
  /* ========================================================= */

  .hero-copy {
    max-width: 760px;
  }


  .availability {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 30px;

    color: var(--gray);

    font-size: 13px;

    font-weight: 500;

    letter-spacing: 0.01em;
  }


  .availability-dot {

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #30d158;

    box-shadow:
      0 0 0 4px rgba(48,209,88,0.08);
  }


  .hero h1 {

    margin: 0;

    max-width: 850px;

    color: var(--white);

    font-size: clamp(
      64px,
      8vw,
      122px
    );

    font-weight: 600;

    line-height: 0.94;

    letter-spacing: -0.065em;
  }


  .hero h1 span {

    display: block;

    margin-top: 10px;

    color: transparent;

    background:
      linear-gradient(
        105deg,
        #f5f5f7 0%,
        #cbd5e1 45%,
        #60a5fa 100%
      );

    background-clip: text;
    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
  }


  .hero-lead {

    max-width: 610px;

    margin:
      34px 0 0;

    color: var(--gray);

    font-size: clamp(
      20px,
      2vw,
      25px
    );

    line-height: 1.45;

    letter-spacing: -0.02em;
  }


  /* ========================================================= */
  /* BUTTONS */
  /* ========================================================= */

  .hero-actions {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 38px;
  }


  .button {

    min-height: 46px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding:
      0 20px;

    border-radius: 999px;

    font-size: 14px;

    font-weight: 500;

    letter-spacing: -0.01em;

    transition:
      transform 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease;
  }


  .button svg {

    width: 16px;
    height: 16px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.5;

    stroke-linecap: round;

    stroke-linejoin: round;
  }


  .button-primary {

    background: var(--white);

    color: #000;

    padding-left: 22px;
  }


  .button-primary:hover {

    transform: translateY(-2px);

    background: #fff;
  }


  .button-secondary {

    border:
      1px solid var(--line);

    background:
      rgba(255,255,255,0.04);

    color: var(--white-soft);

    backdrop-filter: blur(15px);
  }


  .button-secondary:hover {

    transform: translateY(-2px);

    border-color:
      rgba(255,255,255,0.18);

    background:
      rgba(255,255,255,0.075);
  }


  .hero-meta {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 11px;

    margin-top: 34px;

    color: #5f6065;

    font-size: 11px;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .hero-meta i,
  .final-meta i {

    width: 3px;
    height: 3px;

    border-radius: 50%;

    background: #3c3c40;
  }


  /* ========================================================= */
  /* DEVELOPER CARD */
  /* ========================================================= */

  .hero-visual {

    position: relative;

    display: flex;

    justify-content: center;
  }


  .developer-card {

    width: 100%;

    max-width: 610px;

    overflow: hidden;

    border:
      1px solid
      rgba(255,255,255,0.10);

    border-radius: 22px;

    background:
      rgba(20,20,22,0.68);

    box-shadow:
      0 40px 100px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.05);

    backdrop-filter:
      blur(30px)
      saturate(120%);

    -webkit-backdrop-filter:
      blur(30px)
      saturate(120%);

    transform:
      perspective(1400px)
      rotateY(-4deg);

    transition:
      transform 0.7s
      cubic-bezier(0.2,0.8,0.2,1);
  }


  .developer-card:hover {

    transform:
      perspective(1400px)
      rotateY(0deg)
      translateY(-4px);
  }


  .developer-topbar,
  .terminal-bar {

    height: 48px;

    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    padding: 0 17px;

    border-bottom:
      1px solid var(--line-soft);

    background:
      rgba(255,255,255,0.025);
  }


  .window-controls {

    display: flex;

    gap: 7px;
  }


  .window-controls span {

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: #3a3a3d;
  }


  .window-controls span:nth-child(1) {
    background: #ff5f57;
  }

  .window-controls span:nth-child(2) {
    background: #febc2e;
  }

  .window-controls span:nth-child(3) {
    background: #28c840;
  }


  .developer-title {

    color: #77777c;

    font-size: 12px;

    letter-spacing: -0.01em;
  }


  .developer-content {

    position: relative;

    height: 500px;

    overflow: hidden;
  }


  .developer-content::after {

    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        circle at center,
        transparent 35%,
        rgba(0,0,0,0.28) 100%
      );
  }


  .developer-label {

    position: absolute;

    z-index: 4;

    top: 20px;
    left: 22px;

    display: flex;

    align-items: center;

    gap: 8px;

    color: #70727a;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 11px;
  }


  .developer-label span {

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--blue);
  }


  .glitch-wrapper {

    position: absolute;

    inset: 0;
  }


  .developer-footer {

    position: absolute;

    z-index: 4;

    right: 20px;
    bottom: 18px;

    display: flex;

    align-items: center;

    gap: 7px;

    color: #64666c;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 10px;
  }


  .online-dot {

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #30d158;
  }


  /* ========================================================= */
  /* SCROLL */
  /* ========================================================= */

  .hero-scroll {

    position: absolute;

    z-index: 5;

    bottom: 32px;

    left: 50%;

    transform: translateX(-50%);

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 7px;

    color: #55565a;

    font-size: 10px;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .hero-scroll svg {

    width: 15px;
    height: 15px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.4;
  }


  /* ========================================================= */
  /* GENERIC SECTIONS */
  /* ========================================================= */

  .section {

    position: relative;

    background: var(--black);
  }


  .section-inner {

    width: min(
      1180px,
      calc(100% - 64px)
    );

    margin: 0 auto;

    padding:
      170px 0;
  }


  .section-intro {

    max-width: 780px;
  }


  .eyebrow {

    margin: 0 0 20px;

    color: var(--blue);

    font-size: 12px;

    font-weight: 500;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .section-intro h2,
  .terminal-copy h2 {

    margin: 0;

    color: var(--white);

    font-size: clamp(
      48px,
      6vw,
      78px
    );

    font-weight: 600;

    line-height: 0.98;

    letter-spacing: -0.055em;
  }


  .section-intro h2 span,
  .terminal-copy h2 span {

    color: var(--gray-dark);
  }


  .section-intro > p:last-child,
  .terminal-copy > p {

    max-width: 610px;

    margin-top: 25px;

    color: var(--gray);

    font-size: 19px;

    line-height: 1.55;

    letter-spacing: -0.015em;
  }


  /* ========================================================= */
  /* TECHNOLOGIES */
  /* ========================================================= */

  .technologies-section {

    border-top:
      1px solid var(--line-soft);
  }


  .technology-wall {

    margin-top: 90px;

    padding: 20px 0;
  }


  /* ========================================================= */
  /* SKILLS */
  /* ========================================================= */

  .skills-section {

    border-top:
      1px solid var(--line-soft);
  }


  .skills-container {

    margin-top: 90px;
  }


  /* ========================================================= */
  /* NOTES */
  /* ========================================================= */

  .notes-section {

    border-top:
      1px solid var(--line-soft);
  }


  .notes-list {

    margin-top: 80px;

    border-top:
      1px solid var(--line);
  }


  .note-row {

    position: relative;

    display: grid;

    grid-template-columns:
      60px
      minmax(280px, 1fr)
      minmax(220px, 0.7fr)
      30px;

    align-items: center;

    gap: 30px;

    min-height: 125px;

    padding: 24px 8px;

    border-bottom:
      1px solid var(--line);

    transition:
      background 0.35s ease,
      padding 0.35s ease;
  }


  .note-row:hover {

    padding-left: 18px;
    padding-right: 18px;

    background:
      rgba(255,255,255,0.025);
  }


  .note-index {

    color: #4d4e52;

    font-size: 12px;

    font-variant-numeric: tabular-nums;
  }


  .note-main > span {

    display: block;

    margin-bottom: 6px;

    color: var(--blue);

    font-size: 11px;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }


  .note-main h3 {

