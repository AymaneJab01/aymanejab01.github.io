<script>
  /* ============================================================
     TERMINAL
     ============================================================ */

  const terminalForm =
    document.querySelector<HTMLFormElement>(
      "#terminal-form"
    );

  const terminalInput =
    document.querySelector<HTMLInputElement>(
      "#terminal-input"
    );

  const terminalOutput =
    document.querySelector<HTMLDivElement>(
      "#terminal-output"
    );

  const terminalShell =
    document.querySelector<HTMLElement>(
      "#portfolio-terminal"
    );


  const commandHistory: string[] = [];

  let historyIndex = -1;


  function escapeHTML(value: string) {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  function addCommand(command: string) {

    if (!terminalOutput) return;

    const line =
      document.createElement("div");

    line.className =
      "terminal-line terminal-command";

    line.innerHTML = `
      <span class="terminal-prompt">
        aymane@portfolio:~$
      </span>
      <span>${escapeHTML(command)}</span>
    `;

    terminalOutput.appendChild(line);

    terminalOutput.scrollTop =
      terminalOutput.scrollHeight;
  }


  function addResponse(
    content: string,
    type:
      | "output"
      | "success"
      | "error"
      | "info" = "output"
  ) {

    if (!terminalOutput) return;

    const line =
      document.createElement("div");

    line.className =
      `terminal-line terminal-${type}`;

    line.innerHTML = content;

    terminalOutput.appendChild(line);

    requestAnimationFrame(() => {
      terminalOutput.scrollTop =
        terminalOutput.scrollHeight;
    });
  }


  function goTo(path: string) {
    window.location.href = path;
  }


  /* ============================================================
     WEATHER
     ============================================================ */

  const weatherDescriptions: Record<number, string> = {

    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",

    45: "Fog",
    48: "Depositing rime fog",

    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",

    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",

    71: "Slight snow",
    73: "Moderate snow",
    75: "Heavy snow",

    80: "Rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",

    95: "Thunderstorm",
    96: "Thunderstorm with hail",
    99: "Thunderstorm with heavy hail",
  };


  const WEATHER_LOCATIONS = {

    alcoi: {
      name: "Alcoi",
      latitude: 38.6983,
      longitude: -0.4743,
    },

    valencia: {
      name: "Valencia",
      latitude: 39.4699,
      longitude: -0.3763,
    },

    torrevieja: {
      name: "Torrevieja",
      latitude: 37.9787,
      longitude: -0.6822,
    },

  };


  async function getWeather(
    location:
      keyof typeof WEATHER_LOCATIONS
  ) {

    const place =
      WEATHER_LOCATIONS[location];


    addResponse(
      `<span class="terminal-muted">Fetching weather data for ${place.name}...</span>`,
      "info"
    );


    try {

      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${place.latitude}` +
        `&longitude=${place.longitude}` +
        `&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m` +
        `&timezone=Europe%2FMadrid`;


      const response =
        await fetch(url);


      if (!response.ok) {
        throw new Error(
          "Weather request failed"
        );
      }


      const data =
        await response.json();


      const current =
        data.current;


      const description =
        weatherDescriptions[
          current.weather_code
        ] ?? "Unknown conditions";


      addResponse(
        `
        <div class="terminal-weather">

          <div>
            <strong>
              ${escapeHTML(place.name)}
            </strong>

            <span>
              ${escapeHTML(description)}
            </span>
          </div>

          <div class="weather-temperature">
            ${Math.round(current.temperature_2m)}°C
          </div>

          <div class="weather-details">
            Feels like
            ${Math.round(current.apparent_temperature)}°C
            · Wind
            ${Math.round(current.wind_speed_10m)}
            km/h
          </div>

        </div>
        `,
        "success"
      );

    } catch {

      addResponse(
        "Unable to retrieve weather data right now.",
        "error"
      );

    }

  }


