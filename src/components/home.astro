  /* ============================================================
     COMMAND EXECUTION
     ============================================================ */

  function executeCommand(
    rawCommand: string
  ) {

    const command =
      rawCommand
        .trim()
        .toLowerCase();


    if (!command) return;


    if (command === "clear") {

      if (terminalOutput) {
        terminalOutput.innerHTML = "";
      }

      return;
    }


    if (command === "open visualizer") {
      goTo("/projects/visualizer");
      return;
    }


    if (command === "open weather") {
      goTo("/projects/weather");
      return;
    }


    if (command === "open movie-ranking") {
      goTo("/projects/movie-ranking");
      return;
    }


    if (command === "open cpu") {
      goTo("/projects/Cpu");
      return;
    }


    if (command === "open network") {
      goTo("/projects/network");
      return;
    }


    if (
      command ===
      "open expense-splitter"
    ) {
      goTo(
        "/projects/expense-splitter/"
      );

      return;
    }


    if (command === "open github") {

      window.open(
        "https://github.com/AymaneJab01",
        "_blank",
        "noopener,noreferrer"
      );

      return;
    }


    if (command === "open linkedin") {

      window.open(
        "https://www.linkedin.com/in/aymane-jabrane-73025726a/",
        "_blank",
        "noopener,noreferrer"
      );

      return;
    }


    if (command === "open email") {

      window.open(
        "https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!",
        "_blank",
        "noopener,noreferrer"
      );

      return;
    }


    if (
      command === "weather alcoi" ||
      command === "weather alcoy"
    ) {

      void getWeather("alcoi");

      return;
    }


    if (
      command === "weather valencia"
    ) {

      void getWeather("valencia");

      return;
    }


    if (
      command === "weather torrevieja"
    ) {

      void getWeather(
        "torrevieja"
      );

      return;
    }


    if (command === "weather") {

      addResponse(
        `
        Usage:

        <strong>
          weather valencia
        </strong>

        <br />

        <strong>
          weather alcoi
        </strong>

        <br />

        <strong>
          weather torrevieja
        </strong>
        `,
        "info"
      );

      return;
    }


    const handler =
      commands[command];


    if (handler) {

      handler();

      return;
    }


    addResponse(
      `
      Command not found:
      <strong>
        ${escapeHTML(rawCommand)}
      </strong>.

      Type
      <strong>help</strong>.
      `,
      "error"
    );

  }


  /* ============================================================
     FORM
     ============================================================ */

  terminalForm?.addEventListener(
    "submit",
    (event) => {

      event.preventDefault();


      const value =
        terminalInput?.value.trim() ?? "";


      if (!value) return;


      addCommand(value);


      commandHistory.push(value);

      historyIndex =
        commandHistory.length;


      executeCommand(value);


      if (terminalInput) {
        terminalInput.value = "";
      }

    }
  );


  /* ============================================================
     TERMINAL KEYBOARD
     ============================================================ */

  terminalInput?.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key ===
        "ArrowUp"
      ) {

        event.preventDefault();


        if (!commandHistory.length) {
          return;
        }


        historyIndex =
          Math.max(
            0,
            historyIndex - 1
          );


        terminalInput.value =
          commandHistory[
            historyIndex
          ] ?? "";

      }


      if (
        event.key ===
        "ArrowDown"
      ) {

        event.preventDefault();


        if (!commandHistory.length) {
          return;
        }


        historyIndex =
          Math.min(
            commandHistory.length,
            historyIndex + 1
          );


        terminalInput.value =
          commandHistory[
            historyIndex
          ] ?? "";

      }


      if (
        event.key ===
        "Escape"
      ) {

        terminalInput.value = "";

      }

    }
  );


  /* ============================================================
     TERMINAL FOCUS
     ============================================================ */

  terminalShell?.addEventListener(
    "click",
    () => {
      terminalInput?.focus();
    }
  );


  /* ============================================================
     "/" SHORTCUT
     ============================================================ */

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "/" &&
        document.activeElement !==
          terminalInput
      ) {

        event.preventDefault();

        terminalInput?.focus();

      }

    }
  );
</script>


