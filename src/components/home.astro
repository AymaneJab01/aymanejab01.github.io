    <div
      id="terminal"
      class="section-block border-t border-white/[0.06]"
    >

      <div class="mx-auto max-w-5xl">

        <div class="mb-10 text-center">
          <p class="section-eyebrow mb-4 text-violet-300/80">
            Interactive
