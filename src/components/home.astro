---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  id="home"
  class="relative overflow-hidden bg-transparent text-[var(--white)]"
>
  <!-- ========================================================= -->
  <!-- BACKGROUND — QUIET / EDITORIAL -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden bg-[#08090c]">

    <!-- very subtle atmospheric depth -->
    <div class="ambient-background" aria-hidden="true">
      <div class="ambient-wash ambient-wash-one"></div>
      <div class="ambient-wash ambient-wash-two"></div>
    </div>

    <!-- architectural grid -->
    <div class="absolute inset-0 hero-grid"></div>

    <!-- subtle paper/noise texture -->
    <div class="absolute inset-0 noise-layer"></div>

    <!-- edge vignette -->
