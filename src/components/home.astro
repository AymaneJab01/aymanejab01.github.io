        <!-- Terminal window -->
        <div class="terminal-shell">

          <!-- Terminal top bar -->
          <div class="terminal-header">

            <div class="terminal-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="terminal-title">
              aymane@portfolio:~
            </div>

            <div class="terminal-header-status">
              <span></span>
              online
            </div>

          </div>

          <!-- Terminal body -->
          <div
            id="portfolio-terminal"
            class="terminal-body"
            tabindex="0"
            aria-label="Interactive portfolio terminal"
          >

            <div
