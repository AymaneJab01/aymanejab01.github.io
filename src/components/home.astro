<script>
  /* ============================================================
     INTERACTIVE REACT-BITS-STYLE CURSOR FIELD
     ============================================================ */

  const hero = document.querySelector("#home");
  const field = document.querySelector("#hero-interactive-field");

  const cursorGlow = document.querySelector("#cursor-glow");
  const cursorGlowSecondary = document.querySelector(
    "#cursor-glow-secondary"
  );
  const cursorRing = document.querySelector("#cursor-ring");
  const cursorSpotlight = document.querySelector(
    "#cursor-spotlight"
  );
  const particleContainer = document.querySelector(
    "#cursor-particles"
  );

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;

  let smoothX = mouseX;
  let smoothY = mouseY;

  let secondaryX = mouseX;
  let secondaryY = mouseY;

  let previousX = mouseX;
  let previousY = mouseY;

  let velocity = 0;
  let targetVelocity = 0;

  let insideHero = false;

  const prefersReducedMotion =
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

  const isTouch =
    window.matchMedia(
      "(pointer: coarse)"
    ).matches;

  /*
   * Desktop only.
   */

  if (
    hero &&
    field &&
    cursorGlow &&
    cursorGlowSecondary &&
    cursorRing &&
    cursorSpotlight &&
    !prefersReducedMotion &&
    !isTouch
  ) {

    const setPointer = (event) => {
      const rect = hero.getBoundingClientRect();

      mouseX = event.clientX;
      mouseY = event.clientY;

      const localX = event.clientX - rect.left;
      const localY = event.clientY - rect.top;

      targetVelocity = Math.min(
        1,
        Math.hypot(
          mouseX - previousX,
          mouseY - previousY
        ) / 45
      );

      previousX = mouseX;
      previousY = mouseY;

      field.style.setProperty(
        "--pointer-x",
        `${localX}px`
      );

      field.style.setProperty(
        "--pointer-y",
        `${localY}px`
      );

      cursorSpotlight.style.transform =
        `translate3d(${localX}px, ${localY}px, 0)`;

      if (insideHero) {
        field.classList.add("cursor-active");
      }
    };

    hero.addEventListener(
      "pointermove",
      setPointer,
      { passive: true }
    );

    hero.addEventListener(
      "pointerenter",
      () => {
        insideHero = true;
        field.classList.add("cursor-active");
      }
    );

    hero.addEventListener(
      "pointerleave",
      () => {
        insideHero = false;
        field.classList.remove("cursor-active");
      }
    );

    /*
     * Interactive targets.
     */

    const targets =
      document.querySelectorAll(
        ".interactive-target"
      );

    targets.forEach((target) => {

      target.addEventListener(
        "pointerenter",
        () => {
          field.classList.add("cursor-hover");

          const type =
            target.getAttribute("data-cursor");

          if (type) {
            field.setAttribute(
              "data-cursor-mode",
              type
            );
          }
        }
      );

      target.addEventListener(
        "pointerleave",
        () => {
          field.classList.remove(
            "cursor-hover"
          );

          field.removeAttribute(
            "data-cursor-mode"
          );
        }
      );

    });

    /*
     * Animation loop.
     */

    const animate = () => {

      smoothX +=
        (mouseX - smoothX) * 0.12;

      smoothY +=
        (mouseY - smoothY) * 0.12;

      secondaryX +=
        (mouseX - secondaryX) * 0.045;

      secondaryY +=
        (mouseY - secondaryY) * 0.045;

      velocity +=
        (targetVelocity - velocity) * 0.08;

      targetVelocity *= 0.93;

      const rect =
        hero.getBoundingClientRect();

      const localSmoothX =
        smoothX - rect.left;

      const localSmoothY =
        smoothY - rect.top;

      const localSecondaryX =
        secondaryX - rect.left;

      const localSecondaryY =
        secondaryY - rect.top;

      cursorGlow.style.transform =
        `translate3d(${localSmoothX}px, ${localSmoothY}px, 0)`;

      cursorGlowSecondary.style.transform =
        `translate3d(${localSecondaryX}px, ${localSecondaryY}px, 0)`;

      cursorRing.style.transform =
        `translate3d(${localSmoothX}px, ${localSmoothY}px, 0)`;

      field.style.setProperty(
        "--cursor-speed",
        velocity.toFixed(3)
      );

      requestAnimationFrame(
        animate
      );
    };

    animate();

    /*
     * Click burst.
     */

    hero.addEventListener(
      "pointerdown",
      (event) => {

        const rect =
          hero.getBoundingClientRect();

        const x =
          event.clientX - rect.left;

        const y =
          event.clientY - rect.top;

        createBurst(
          x,
          y
        );
      }
    );

    function createBurst(
      x,
      y
    ) {

      if (!particleContainer)
        return;

      const count = 12;

      for (
        let i = 0;
        i < count;
        i++
      ) {

        const particle =
          document.createElement(
            "span"
          );

        particle.className =
          "cursor-particle";

        const angle =
          (Math.PI * 2 * i) /
          count +
          (Math.random() - 0.5) *
          0.5;

        const distance =
          35 +
          Math.random() * 60;

        const size =
          1 +
          Math.random() * 2.5;

        particle.style.width =
          `${size}px`;

        particle.style.height =
          `${size}px`;

        particle.style.left =
          `${x}px`;

        particle.style.top =
          `${y}px`;

        particle.style.setProperty(
          "--dx",
          `${Math.cos(angle) * distance}px`
        );

        particle.style.setProperty(
          "--dy",
          `${Math.sin(angle) * distance}px`
        );

        particleContainer.appendChild(
          particle
        );

        setTimeout(() => {
          particle.remove();
        }, 650);
      }
    }
  }

