\<script>
&#x20; const terminalInput =
&#x20;   document.querySelector("#terminal-input") as HTMLInputElement | null;

&#x20; const terminalOutput =
&#x20;   document.querySelector("#terminal-output") as HTMLDivElement | null;

&#x20; const terminalForm =
&#x20;   document.querySelector("#terminal-form") as HTMLFormElement | null;

&#x20; const terminalWindow =
&#x20;   document.querySelector("#portfolio-terminal") as HTMLDivElement | null;

&#x20; type TerminalCommand = () => string;

&#x20; const history: string[] = [];
&#x20; let historyIndex: number = -1;

&#x20; const escapeHTML = (value: string): string => {
&#x20;   return value
&#x20;     .replace(/&/g, "&amp;")
&#x20;     .replace(/\</g, "&lt;")
&#x20;     .replace(/>/g, "&gt;")
&#x20;     .replace(/"/g, "&quot;")
&#x20;     .replace(/'/g, "&#039;");
&#x20; };

&#x20; const addCommand = (command: string): void => {
&#x20;   if (!terminalOutput) return;

&#x20;   const line = document.createElement("div");

&#x20;   line.className = "terminal-command-line";

&#x20;   line.innerHTML = \`
&#x20;     \<span class="terminal-prompt-main">
&#x20;       \<span class="terminal-user">aymane\</span>
&#x20;       \<span class="terminal-at">@\</span>
&#x20;       \<span class="terminal-host">portfolio\</span>
&#x20;       \<span class="terminal-colon">:\</span>
&#x20;       \<span class="terminal-path">\~\</span>
&#x20;       \<span class="terminal-symbol">$\</span>
&#x20;     \</span>

&#x20;     \<span class="terminal-command-text">
&#x20;       ${escapeHTML(command)}
&#x20;     \</span>
&#x20;   \`;

&#x20;   terminalOutput.appendChild(line);
&#x20; };

&#x20; const addResponse = (html: string): void => {
&#x20;   if (!terminalOutput) return;

&#x20;   const response = document.createElement("div");

&#x20;   response.className = "terminal-response";
&#x20;   response.innerHTML = html;

&#x20;   terminalOutput.appendChild(response);

&#x20;   terminalOutput.scrollTop = terminalOutput.scrollHeight;
