    align-items:
      center;

    gap:
      12px;

    height:
      44px;

    padding:
      0 14px;

    border-bottom:
      1px solid
      rgba(255,255,255,.06);

    background:
      rgba(255,255,255,.025);
  }

  .glitch-card-dots {
    display:
      flex;

    gap:
      5px;
  }

  .glitch-card-dots span {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      rgba(255,255,255,.2);
  }

  .glitch-card-label {
    color:
      rgba(255,255,255,.35);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      9px;

    letter-spacing:
      .08em;
  }

  .glitch-card-tag {
    color:
      rgba(125,211,252,.7);

