    border-radius: 50%;

    filter: blur(100px);

    opacity: .2;

    animation:
      driftOne 20s ease-in-out infinite alternate;
  }

  .glow-a {
    left: 3%;
    top: 18%;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, .65),
        transparent 68%
      );
  }

  .glow-b {
    right: 2%;
    top: 38%;

    background:
      radial-gradient(
        circle,
        rgba(76, 29, 149, .55),
        transparent 68%
      );

    animation-name:
      driftTwo;
  }

  /* ============================================================
     CURSOR GLOW
     ============================================================ */

  .cursor-glow,
  .cursor-glow-secondary {
    position: absolute;

    left: 0;
    top: 0;

    width: 0;
    height: 0;

    border-radius: 50%;

    pointer-events: none;

    will-change:
      transform;

    opacity: 0;

    transition:
      opacity .6s ease;
  }

  .cursor-glow {
    width: 520px;
    height: 520px;

    margin-left: -260px;
    margin-top: -260px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, .16) 0%,
        rgba(37, 99, 235, .10) 22%,
        rgba(14, 165, 233, .05) 45%,
        transparent 72%
      );

    filter: blur(15px);

    mix-blend-mode:
      screen;
  }

  .cursor-glow-secondary {
    width: 300px;
    height: 300px;

    margin-left: -150px;
    margin-top: -150px;

    background:
      radial-gradient(
        circle,
        rgba(56, 189, 248, .14),
        rgba(37, 99, 235, .06) 32%,
        transparent 72%
      );

    filter:
      blur(10px);

    mix-blend-mode:
      screen;
  }

  .cursor-ring {
    position: absolute;

    width: 34px;
    height: 34px;

    margin-left: -17px;
    margin-top: -17px;

    border:
      1px solid
      rgba(125, 211, 252, .18);

    border-radius:
      50%;

    box-shadow:
      0 0 20px rgba(37, 99, 235, .08),
      inset 0 0 10px rgba(56, 189, 248, .04);

    opacity: 0;

    transform:
      translate3d(
        0,
        0,
        0
      );

    transition:
      opacity .5s ease,
      width .4s cubic-bezier(.16,1,.3,1),
      height .4s cubic-bezier(.16,1,.3,1),
      margin .4s cubic-bezier(.16,1,.3,1);
  }

  .cursor-spotlight {
    position: absolute;

    width: 850px;
    height: 850px;

    margin-left: -425px;
    margin-top: -425px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(255,255,255,.025),
        transparent 60%
      );

    mix-blend-mode:
      screen;

    opacity: 0;

    transition:
      opacity .5s ease;
  }

  .cursor-active .cursor-glow,
  .cursor-active .cursor-glow-secondary,
  .cursor-active .cursor-ring,
  .cursor-active .cursor-spotlight {
    opacity: 1;
  }

  /* ============================================================
     CURSOR INTERACTIVE STATES
     ============================================================ */

  .cursor-hover .cursor-ring {
    width: 58px;
    height: 58px;

    margin-left: -29px;
    margin-top: -29px;

    border-color:
      rgba(56,189,248,.35);

    box-shadow:
      0 0 28px rgba(37,99,235,.12),
      inset 0 0 15px rgba(56,189,248,.08);
  }

  #hero-interactive-field[data-cursor-mode="button"]
    .cursor-ring {
    width: 74px;
    height: 74px;

    margin-left: -37px;
    margin-top: -37px;

    border-color:
      rgba(96,165,250,.42);
  }

  #hero-interactive-field[data-cursor-mode="card"]
    .cursor-ring {
    width: 64px;
    height: 64px;

    margin-left: -32px;
    margin-top: -32px;
  }

  #hero-interactive-field[data-cursor-mode="social"]
    .cursor-ring {
    width: 48px;
    height: 48px;

    margin-left: -24px;
    margin-top: -24px;
  }

  /* ============================================================
     CLICK PARTICLES
     ============================================================ */

  .cursor-particles {
    position: absolute;
    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .cursor-particle {
    position: absolute;

    border-radius: 50%;

    background:
      rgba(125, 211, 252, .8);

    box-shadow:
      0 0 8px
      rgba(56,189,248,.7);

    animation:
      cursorParticle .65s
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  @keyframes cursorParticle {

    0% {
      opacity: 0;
      transform:
        translate3d(0,0,0)
        scale(.2);
    }

    15% {
      opacity: 1;
    }

    100% {
      opacity: 0;

      transform:
        translate3d(
          var(--dx),
          var(--dy),
          0
        )
        scale(0);
    }
  }

  /* ============================================================
     AURORA ANIMATIONS
     ============================================================ */

  @keyframes nebulaBreathe {

    0% {
      opacity: .35;
      transform:
        rotate(-12deg)
        scale(.95);
    }

    50% {
      opacity: .55;
      transform:
        rotate(-7deg)
        scale(1.05);
    }

    100% {
      opacity: .4;
      transform:
        rotate(-15deg)
        scale(1);
    }
  }

  @keyframes nebulaShimmer {

    0% {
      filter:
        blur(55px)
        hue-rotate(0deg);
    }

    50% {
      filter:
        blur(70px)
        hue-rotate(12deg);
    }

    100% {
      filter:
        blur(55px)
        hue-rotate(-8deg);
    }
  }

  @keyframes driftOne {

    0% {
      transform:
        translate3d(-5%, -2%, 0)
        scale(.95);
    }

    100% {
      transform:
        translate3d(8%, 6%, 0)
        scale(1.08);
    }
  }

  @keyframes driftTwo {

    0% {
      transform:
        translate3d(4%, -3%, 0)
        scale(1);
    }

    100% {
      transform:
        translate3d(-8%, 7%, 0)
        scale(1.12);
    }
  }

  .hero-vignette {
    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        ellipse at center,
        transparent 35%,
        rgba(5,6,10,.25) 70%,
        rgba(5,6,10,.82) 100%
      );
  }

  /* ============================================================
     STATUS
     ============================================================ */

  .status-badge {
    border:
      1px solid
      rgba(255,255,255,.09);

    background:
      rgba(255,255,255,.035);

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.05),
      0 10px 40px rgba(0,0,0,.18);

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);

    color:
      rgba(255,255,255,.58);

    font-size:
      11px;

    letter-spacing:
      .02em;
  }

  /* ============================================================
     NAME
     ============================================================ */

  .name-glow {
    color:
      rgba(255,255,255,.8);

    transition:
      color .3s ease,
      text-shadow .3s ease;
  }

  .name-glow:hover {
    color:
      rgba(125,211,252,.95);

    text-shadow:
      0 0 22px
      rgba(56,189,248,.35);
  }

  /* ============================================================
     TITLE
     ============================================================ */

  .hero-title {
    text-wrap:
      balance;
  }

  .title-gradient {
    background:
      linear-gradient(
        110deg,
        #ffffff 0%,
        #dbeafe 25%,
        #60a5fa 52%,
        #2563eb 76%,
        #93c5fd 100%
      );

    background-size:
      220% 100%;

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;

    animation:
      titleFlow 8s
      ease-in-out
      infinite alternate;
  }

  @keyframes titleFlow {

    0% {
      background-position:
        0% 50%;
    }

    100% {
      background-position:
        100% 50%;
    }
  }

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        rgba(255,255,255,.45),
        rgba(125,211,252,.95),
        rgba(255,255,255,.45)
      );

    background-size:
      200% 100%;

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;

    animation:
      shine 5s
      linear
      infinite;
  }

  @keyframes shine {

    from {
      background-position:
        200% 0;
    }

    to {
      background-position:
        -200% 0;
    }
  }

  /* ============================================================
     BUTTONS
     ============================================================ */

  .primary-button {
    border:
      1px solid
      rgba(125,211,252,.16);

    background:
      linear-gradient(
        135deg,
        rgba(37,99,235,.9),
