  const executeCommand = (rawCommand: string): void => {
    const command = rawCommand.trim().toLowerCase();

    if (!command) return;

    if (command === "clear") {
      if (terminalOutput) {
        terminalOutput.innerHTML = "";
      }

      return;
    }

    addCommand(command);

    if (command in commands) {
      const result = commands[command]();

      if (result instanceof Promise) {
        addResponse(`
          <div class="terminal-terminal-text">
            Fetching live data...
          </div>
        `);

        result.then((html) => {
          addResponse(html);
        });
      } else {
        addResponse(result);
      }

      return;
    }

    if (command.startsWith("open ")) {
      const target = command.slice(5).trim();

      addResponse(`
        <div class="terminal-error">
          No project matching
          <span>"${escapeHTML(target)}"</span>
        </div>

        <div class="terminal-terminal-text">
          Try: <strong>open ${OPENABLE_TARGETS.join("</strong>, <strong>open ")}</strong>
        </div>
      `);

      return;
    }

    addResponse(`
      <div class="terminal-error">
        command not found:
        <span>${escapeHTML(command)}</span>
      </div>

      <div class="terminal-terminal-text">
        Type <strong>help</strong> to see available commands.
      </div>
    `);
  };

  if (terminalForm && terminalInput) {
    terminalForm.addEventListener(
      "submit",
      (event: SubmitEvent) => {
        event.preventDefault();

        const command = terminalInput.value.trim();

        if (!command) {
          terminalInput.focus();
          return;
        }

        history.push(command);
        historyIndex = history.length;

        executeCommand(command);

        terminalInput.value = "";
        terminalInput.focus();
      }
    );

    terminalInput.addEventListener(
      "keydown",
      (event: KeyboardEvent) => {

        if (event.key === "ArrowUp") {
          event.preventDefault();

          if (history.length === 0) return;

          if (historyIndex > 0) {
            historyIndex--;
          }

          terminalInput.value =
            history[historyIndex] ?? "";

          return;
        }

        if (event.key === "ArrowDown") {
          event.preventDefault();

          if (history.length === 0) return;

          if (historyIndex < history.length - 1) {
            historyIndex++;

            terminalInput.value =
              history[historyIndex] ?? "";
          } else {
            historyIndex = history.length;
            terminalInput.value = "";
          }

          return;
        }

        if (event.key === "Escape") {
          terminalInput.value = "";
          historyIndex = history.length;
        }
      }
    );
  }

  if (terminalWindow) {
    terminalWindow.addEventListener("click", () => {
