  .terminal-body {
    position:
      relative;

    min-height:
      440px;

    max-height:
      540px;

    overflow-y:
      auto;

    padding:
      24px;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      12px;

    line-height:
