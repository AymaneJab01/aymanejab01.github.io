    justify-content:
      space-between;

    margin-top:
      35px;

    color:
      rgba(255,255,255,.3);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      10px;

    text-transform:
      uppercase;

    letter-spacing:
      .12em;
  }

  .note-arrow {
