<script>
  const terminal = document.querySelector("#portfolio-terminal");
  const terminalForm = document.querySelector("#terminal-form");
  const terminalInput = document.querySelector("#terminal-input");
  const terminalOutput = document.querySelector("#terminal-output");

  if (
    terminal instanceof HTMLElement &&
    terminalForm instanceof HTMLFormElement &&
    terminalInput instanceof HTMLInputElement &&
    terminalOutput instanceof HTMLElement
  ) {
    const history = [];
    let historyIndex = -1;

    const commands = {
      help: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">Available commands</div>

          <div class="terminal-response-row">
            <span>whoami</span>
            <small>about me</small>
          </div>

          <div class="terminal-response-row">
            <span>skills</span>
            <small>technologies & tools</small>
          </div>

          <div class="terminal-response-row">
            <span>projects</span>
            <small>view my projects</small>
          </div>

          <div class="terminal-response-row">
            <span>contact</span>
            <small>get in touch</small>
          </div>

          <div class="terminal-response-row">
            <span>status</span>
            <small>current availability</small>
          </div>

          <div class="terminal-response-row">
            <span>date</span>
            <small>current date</small>
          </div>

          <div class="terminal-response-row">
            <span>clear</span>
            <small>clear the terminal</small>
          </div>
        </div>
      `,

      whoami: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">
            Aymane Jabrane
          </div>

          <div class="terminal-response-text">
            Computer Science student & Software Developer.
          </div>

          <div class="terminal-response-text">
            Interested in software, systems, programming
            and building things with code.
          </div>
        </div>
      `,

      skills: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">
            ./skills
          </div>

          <div class="terminal-response-text">
            Languages:
            <span class="terminal-green-text">
              Java · Dart · JavaScript · TypeScript · HTML · CSS
            </span>
          </div>

          <div class="terminal-response-text">
            Frameworks:
            <span class="terminal-blue-text">
              Flutter · Astro · React
            </span>
          </div>

          <div class="terminal-response-text">
            Tools:
            <span class="terminal-green-text">
              Git · GitHub · VS Code · Figma · Linux
            </span>
          </div>

          <div class="terminal-response-text">
            Concepts:
            <span class="terminal-blue-text">
              Data Structures · Algorithms · Systems · Networking
            </span>
          </div>
        </div>
      `,

      projects: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">
            ./projects
          </div>

          <div class="terminal-project">
            <span>01</span>
            <strong>Portfolio</strong>
            <small>Astro · React · TypeScript</small>
          </div>

          <div class="terminal-project">
            <span>02</span>
            <strong>Flutter Applications</strong>
            <small>Dart · Flutter · UI/UX</small>
          </div>

          <div class="terminal-project">
            <span>03</span>
            <strong>Computer Science Projects</strong>
            <small>Algorithms · Systems · Data Structures</small>
          </div>

          <div class="terminal-link">
            Type
            <b>open github</b>
            to visit GitHub.
          </div>
        </div>
      `,

      contact: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">
            ./contact
          </div>

          <div class="terminal-response-text">
            Email:
            <span class="terminal-green-text">
              aymanejabranesm@gmail.com
            </span>
          </div>

          <div class="terminal-response-text">
            LinkedIn:
            <span class="terminal-blue-text">
              linkedin.com/in/aymane-jabrane-73025726a
            </span>
          </div>

          <div class="terminal-link">
            Type
            <b>open email</b>
            or
            <b>open linkedin</b>
            to continue.
          </div>
        </div>
      `,

      status: () => `
        <div class="terminal-response">
          <div class="terminal-response-title">
            SYSTEM STATUS
          </div>

          <div class="terminal-status-row">
            <span>availability</span>
            <strong>OPEN TO OPPORTUNITIES</strong>
          </div>

          <div class="terminal-status-row">
            <span>system</span>
            <strong>ONLINE</strong>
          </div>

          <div class="terminal-status-row">
            <span>coffee</span>
            <strong>REQUIRED</strong>
          </div>

          <div class="terminal-status-row">
            <span>building</span>
            <strong>IN PROGRESS</strong>
          </div>
        </div>
      `,

      date: () => {
        return `
          <div class="terminal-response">
            <div class="terminal-response-title">
              ${new Date().toString()}
            </div>
          </div>
        `;
      },

      "open github": () => {
        window.open(
          "https://github.com/AymaneJab01",
          "_blank",
          "noopener,noreferrer"
        );

        return `
          <div class="terminal-response">
            <span class="terminal-green-text">
              Opening GitHub...
            </span>
          </div>
        `;
      },

      "open email": () => {
        window.open(
          "https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!",
          "_blank",
          "noopener,noreferrer"
        );

        return `
          <div class="terminal-response">
            <span class="terminal-green-text">
              Opening email composer...
            </span>
          </div>
        `;
      },

      "open linkedin": () => {
        window.open(
          "https://www.linkedin.com/in/aymane-jabrane-73025726a/",
          "_blank",
          "noopener,noreferrer"
        );

        return `
          <div class="terminal-response">
            <span class="terminal-green-text">
              Opening LinkedIn...
            </span>
          </div>
        `;
      }
    };

    function escapeHTML(value) {
      const div = document.createElement("div");
      div.textContent = value;
      return div.innerHTML;
    }

    function clearTerminal() {
      terminalOutput.innerHTML = "";

      terminalInput.focus();
    }

    function addCommand(command) {
      const line = document.createElement("div");

      line.className = "terminal-line terminal-entered-command";

      line.innerHTML = `
        <span class="terminal-prompt">
          aymane@portfolio
        </span>

        <span class="terminal-symbol">:</span>

        <span class="terminal-path">~</span>

        <span class="terminal-symbol">$</span>

        <span class="terminal-command">
          ${escapeHTML(command)}
        </span>
      `;

      terminalOutput.appendChild(line);
    }

    function addResponse(html) {
      const response = document.createElement("div");

      response.className = "terminal-dynamic-response";

      response.innerHTML = html;

      terminalOutput.appendChild(response);
    }

    function scrollTerminal() {
      terminalOutput.scrollTop = terminalOutput.scrollHeight;
    }

    function executeCommand(rawCommand) {
      const command = rawCommand.trim().toLowerCase();

      if (!command) {
        return;
      }

      if (command === "clear") {
        clearTerminal();
        return;
      }

      addCommand(rawCommand);

      if (command === "open") {
        addResponse(`
          <div class="terminal-response terminal-error">
            Missing target.
            Try:
            <span>open github</span>,
            <span>open email</span>
            or
            <span>open linkedin</span>.
          </div>
        `);

        scrollTerminal();
        return;
      }

      if (commands[command]) {
        addResponse(commands[command]());
      } else {
        addResponse(`
          <div class="terminal-response terminal-error">
            command not found:
            <span>${escapeHTML(rawCommand)}</span>
          </div>

          <div class="terminal-response terminal-muted-response">
            Type
            <strong>help</strong>
            to see available commands.
          </div>
        `);
      }

      scrollTerminal();
    }

    terminalForm.addEventListener("submit", (event) => {
      event.preventDefault();

      const value = terminalInput.value.trim();

      if (!value) {
        return;
      }

      history.push(value);

      historyIndex = history.length;

      executeCommand(value);

      terminalInput.value = "";
    });

    terminalInput.addEventListener("keydown", (event) => {

      if (event.key === "ArrowUp") {
        event.preventDefault();

        if (history.length === 0) {
          return;
        }

        historyIndex = Math.max(
          0,
          historyIndex - 1
        );

        terminalInput.value =
          history[historyIndex] || "";

        requestAnimationFrame(() => {
          terminalInput.setSelectionRange(
            terminalInput.value.length,
            terminalInput.value.length
          );
        });
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();

        if (history.length === 0) {
          return;
        }

        historyIndex = Math.min(
          history.length,
          historyIndex + 1
        );

        terminalInput.value =
          history[historyIndex] || "";
      }

      if (
        event.ctrlKey &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();

        clearTerminal();
      }

    });

    terminal.addEventListener("click", () => {
      terminalInput.focus();
    });

    /*
     * Clicking one of the command names in the
     * initial help menu automatically runs it.
     */
    terminalOutput.addEventListener("click", (event) => {
      const target = event.target;

      if (
        target instanceof HTMLElement &&
        target.matches(".terminal-command-list span")
      ) {
        const command = target.textContent?.trim();

        if (command) {
          terminalInput.value = command;

          terminalForm.requestSubmit();

          terminalInput.focus();
        }
      }
    });

    /*
     * Focus terminal input when pressing any normal
     * key while the terminal itself is focused.
     */
    terminal.addEventListener("keydown", (event) => {
      if (
        document.activeElement !== terminalInput &&
        !event.ctrlKey &&
        !event.altKey &&
        !event.metaKey &&
        event.key.length === 1
      ) {
        terminalInput.focus();
      }
    });
  }
</script>


