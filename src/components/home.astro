              class="terminal-output"
            >

              <div class="terminal-line terminal-system">
                <span class="terminal-prompt">›</span>
                <span>
                  Initializing portfolio terminal...
                </span>
              </div>

              <div class="terminal-line terminal-success">
                <span class="terminal-prompt">✓</span>
