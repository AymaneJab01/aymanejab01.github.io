      flex;

    align-items:
      center;

    gap:
      6px;

    color:
      rgba(125,211,252,.45);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      9px;

    text-transform:
      uppercase;

    letter-spacing:
      .12em;
  }

  .terminal-header-status span {
    width:
      5px;

    height:
      5px;

    border-radius:
