---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  id="home"
  class="relative overflow-hidden bg-transparent text-[var(--white)]"
>
  <!-- ========================================================= -->
  <!-- BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <!-- Premium liquid-glass gradient field -->
    <div class="liquid-scene" aria-hidden="true">
      <div class="liquid-capsule capsule-1"></div>
      <div class="liquid-capsule capsule-2"></div>
      <div class="liquid-capsule capsule-3"></div>
      <div class="liquid-capsule capsule-4"></div>
      <div class="liquid-capsule capsule-5"></div>
      <div class="liquid-capsule capsule-6"></div>
      <div class="liquid-capsule capsule-7"></div>
      <div class="liquid-capsule capsule-8"></div>
    </div>

    <!-- Focused ambient light behind the hero -->
    <div class="hero-ambient"></div>

    <!-- Very subtle technical texture -->
    <div class="absolute inset-0 hero-grid opacity-[0.08]"></div>
    <div class="absolute inset-0 noise-layer opacity-[0.018]"></div>

    <!-- Keeps text and cards readable -->
    <div class="hero-vignette"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <div
      class="relative grid min-h-[780px] items-center gap-16 py-20 sm:py-24 lg:grid-cols-[1.08fr_.92fr] lg:gap-20 lg:py-28"
    >

      <!-- LEFT -->
      <div class="relative z-10 min-w-0">

        <!-- Available badge -->
        <div
          class="status-badge mb-8 inline-flex items-center gap-2.5 rounded-full px-3.5 py-2"
        >
          <span class="relative flex h-2 w-2 shrink-0">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50"
            ></span>

            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(74,222,128,.8)]"
            ></span>
          </span>

          <span>Open to opportunities</span>
        </div>

        <!-- Intro -->
        <div class="mb-5">
          <p
            class="text-xs font-medium uppercase tracking-[0.22em] text-white/45 sm:text-sm"
          >
            Hi, I'm
            <span class="name-glow"> Aymane Jabrane</span>
          </p>
        </div>

        <!-- Main title -->
        <h1
          class="hero-title max-w-5xl text-[3.8rem] font-semibold leading-[0.88] tracking-[-0.065em] sm:text-7xl lg:text-[6.6rem]"
        >
          Software
          <span class="block title-muted">Developer.</span>
        </h1>

        <!-- Description -->
        <p
          class="mt-8 max-w-xl text-base leading-[1.75] text-white/55 sm:text-lg lg:text-xl"
        >
          Building a
          <span class="shiny-sec font-medium"> computer science </span>
          journey through code, systems and creative ideas.
        </p>

        <!-- CTA -->
        <div class="mt-9 flex flex-wrap items-center gap-3">

          <a
            href="#projects"
            class="primary-button group inline-flex items-center gap-2.5 rounded-xl px-5 py-3.5 text-sm font-medium"
          >
            <span>View my work</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-4 transition-transform duration-300 group-hover:translate-x-1"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

          <div class="flex items-center gap-2">

            <!-- GitHub -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/AymaneJab01"
              aria-label="GitHub"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
                />
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.linkedin.com/in/aymane-jabrane-73025726a/"
              aria-label="LinkedIn"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3Z"
                />
              </svg>
            </a>

            <!-- Email -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!"
              aria-label="Email Me"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
                />
              </svg>
            </a>

          </div>
        </div>

        <!-- Small metadata -->
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-white/30">
          <span class="inline-flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400/70"></span>
            Computer Science
          </span>

          <span class="hidden h-3 w-px bg-white/10 sm:block"></span>

          <span>Software · Systems · Code</span>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="relative flex justify-center lg:justify-end">

        <!-- Outer glow -->
        <div class="glitch-glow"></div>

        <!-- Decorative ring -->
        <div class="absolute h-[390px] w-[390px] rounded-full border border-white/[0.035] sm:h-[470px] sm:w-[470px]"></div>

        <div class="absolute h-[320px] w-[320px] rounded-full border border-emerald-400/[0.035] sm:h-[400px] sm:w-[400px]"></div>

        <!-- Main card -->
        <div class="glitch-card relative aspect-square w-full max-w-[340px] overflow-hidden rounded-[2rem] p-2 sm:max-w-[420px]">

          <!-- Top shine -->
          <div class="absolute left-[15%] right-[15%] top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

          <div class="relative h-full w-full overflow-hidden rounded-[1.65rem]">

            <LetterGlitch
              client:load
              glitchColors={["#270d6d", "#1f0b81", "#241a38"]}
              glitchSpeed={33}
              centerVignette={false}
              outerVignette={true}
              smooth={true}
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
          </div>

          <!-- Terminal label -->
          <div class="absolute bottom-5 left-5 flex items-center gap-2 rounded-lg border border-white/10 bg-black/50 px-3 py-2 font-mono text-[10px] text-white/50 backdrop-blur-xl">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(74,222,128,.8)]"></span>
            {"< build />"}
          </div>

          <!-- Corner -->
          <div class="absolute right-5 top-5 font-mono text-[9px] uppercase tracking-[0.2em] text-white/25">
            01 / 01
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- TECH STRIP -->
    <!-- ========================================================= -->

    <div class="section-line">
      <div class="py-10 sm:py-12">

        <div class="mb-8 flex items-center justify-between gap-4">
          <p class="section-eyebrow">
            Technologies
          </p>

          <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-white/20">
            Tools I work with
          </span>
        </div>

        <LogoWall />
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- SKILLS -->
    <!-- ========================================================= -->

    <div class="section-block">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">

        <div>
          <p class="section-eyebrow mb-4">
            Skills & tools
          </p>

          <h2 class="section-title">
            Turning ideas into
            <span>working software.</span>
          </h2>

          <p class="section-description">
            A collection of technologies, tools and concepts I've been
            exploring throughout my development journey.
          </p>

          <div class="mt-8 hidden lg:block">
            <div class="skill-line">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>

        <div class="skills-panel">
          <SkillsList client:load />
        </div>

      </div>
    </div>

    <!-- ========================================================= -->
    <!-- FUNCTIONAL TERMINAL -->
    <!-- ========================================================= -->

    <div
      id="terminal"
      class="terminal-section section-block border-t border-white/[0.06]"
    >

      <div class="mb-10 max-w-2xl">
        <p class="section-eyebrow mb-4 text-emerald-400/80">
          Interactive
        </p>

        <h2 class="section-title">
          Explore through
          <span>the terminal.</span>
        </h2>

        <p class="section-description">
          A small interactive command line interface. Type
          <span class="terminal-inline-code">help</span>
          to see what you can do.
        </p>
      </div>

      <!-- Terminal -->
      <div class="terminal-wrapper">

        <!-- Terminal glow -->
        <div class="terminal-glow"></div>

        <div
          id="portfolio-terminal"
          class="portfolio-terminal"
          tabindex="0"
          aria-label="Interactive portfolio terminal"
        >

          <!-- Terminal top bar -->
          <div class="terminal-header">

            <div class="terminal-dots">
              <span class="terminal-dot terminal-red"></span>
              <span class="terminal-dot terminal-yellow"></span>
              <span class="terminal-dot terminal-green"></span>
            </div>

            <div class="terminal-title">
              aymane@portfolio — ~/home
            </div>

            <div class="terminal-status">
              <span></span>
              online
            </div>

          </div>

          <!-- Terminal body -->
          <div
            id="terminal-output"
            class="terminal-output"
            aria-live="polite"
          >
            <div class="terminal-line terminal-muted">
              Last login: portfolio.local
            </div>

            <div class="terminal-line terminal-muted">
              Welcome to Aymane Jabrane's portfolio.
            </div>

            <div class="terminal-line terminal-spacer"></div>

            <div class="terminal-line">
              <span class="terminal-prompt">aymane@portfolio</span>
              <span class="terminal-symbol">:</span>
              <span class="terminal-path">~</span>
              <span class="terminal-symbol">$</span>
              <span class="terminal-command">help</span>
            </div>

            <div class="terminal-line terminal-output-text">
              Available commands:
            </div>

            <div class="terminal-command-list">
              <div>
                <span>whoami</span>
                <small>— about me</small>
              </div>

              <div>
                <span>skills</span>
                <small>— technologies & tools</small>
              </div>

              <div>
                <span>projects</span>
                <small>— view my work</small>
              </div>

              <div>
                <span>contact</span>
                <small>— get in touch</small>
              </div>

              <div>
                <span>status</span>
                <small>— current availability</small>
              </div>

              <div>
                <span>date</span>
                <small>— current date</small>
              </div>

              <div>
                <span>clear</span>
                <small>— clear terminal</small>
              </div>
            </div>

            <div class="terminal-line terminal-spacer"></div>
          </div>

          <!-- Terminal input -->
          <form
            id="terminal-form"
            class="terminal-input-row"
            autocomplete="off"
          >

            <span class="terminal-prompt">
              aymane@portfolio
            </span>

            <span class="terminal-symbol">:</span>

            <span class="terminal-path">~</span>

            <span class="terminal-symbol">$</span>

            <input
              id="terminal-input"
              class="terminal-input"
              type="text"
              spellcheck="false"
              autocomplete="off"
              autocapitalize="off"
              aria-label="Terminal command"
              placeholder="type a command..."
            />

            <span class="terminal-cursor"></span>

          </form>

        </div>

        <!-- Terminal footer -->
        <div class="terminal-footer">

          <span>
            <kbd>ENTER</kbd> execute
          </span>

          <span>
            <kbd>↑</kbd><kbd>↓</kbd> history
          </span>

          <span>
            <kbd>CTRL</kbd> + <kbd>L</kbd> clear
          </span>

        </div>

      </div>

    </div>

    <!-- ========================================================= -->
    <!-- NOTES -->
    <!-- ========================================================= -->

    <div
      id="notes"
      class="section-block border-t border-white/[0.06]"
    >

      <div class="max-w-2xl">

        <p class="section-eyebrow mb-4 text-emerald-400/80">
          Things I've studied & explored
        </p>

        <h2 class="section-title">
          Notes, ideas &
          <span>things I've learned.</span>
        </h2>

        <p class="section-description">
          A collection of notes and concepts I've been studying along
          my computer science journey.
        </p>

      </div>

      <!-- Notes -->
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <a
          href="https://app.notion.com/p/Tablas-Hash-Vista-Practica-3a762e0580cb80de84eee02fade92863?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">01</div>
            <span class="note-label">Hash Tables</span>
            <h3>Tablas Hash — Vista Práctica</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

        <a
          href="https://app.notion.com/p/Computer-from-hardware-perspective-3a362e0580cb80cfbfa5f1228d060bcc?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">02</div>
            <span class="note-label">Computer Science</span>
            <h3>Computer from a Hardware Perspective</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

        <a
          href="https://app.notion.com/p/Tablas-Hash-Definiciones-3a662e0580cb80089dd9c287f8864a93?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">03</div>
            <span class="note-label">Data Structures</span>
            <h3>Tablas Hash — Definiciones</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

        <a
          href="https://app.notion.com/p/Git-Github-3a562e0580cb801089e5d47fbbaa221f?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">04</div>
            <span class="note-label">Development</span>
            <h3>Git & GitHub</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

        <a
          href="https://app.notion.com/p/Syst-me-Signaux-Analogue-vs-Digitale-3b062e0580cb80d3ba80cb3e8232dee1?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">05</div>
            <span class="note-label">Systems</span>
            <h3>Système — Signaux Analogues vs Digitaux</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

        <a
          href="https://app.notion.com/p/Java-3a262e0580cb8037bee0c0e9aa4b480c?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <div>
            <div class="note-number">06</div>
            <span class="note-label">Programming</span>
            <h3>Java</h3>
          </div>

          <div class="note-footer">
            <span>Open note</span>
            <span class="note-arrow">↗</span>
          </div>
        </a>

      </div>
    </div>

    <!-- ========================================================= -->
    <!-- CTA -->
    <!-- ========================================================= -->

    <div
      class="relative overflow-hidden border-t border-white/[0.06] py-24 text-center sm:py-32"
    >

      <!-- CTA glow -->
      <div
        class="absolute left-1/2 top-1/2 -z-10 h-[280px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/[0.045] blur-[120px]"
      ></div>

      <p class="section-eyebrow mb-5">
        Have an idea?
      </p>

      <h2
        class="mx-auto max-w-3xl text-4xl font-semibold leading-[0.95] tracking-[-0.055em] text-white sm:text-6xl"
      >
        Let's build
        <span class="shiny-sec"> something together.</span>
      </h2>

      <p class="mx-auto mt-6 max-w-lg text-base leading-[1.7] text-white/40 sm:text-lg">
        Whether it's a project, an idea or simply a conversation,
        I'd love to hear from you.
      </p>

      <a
        href="#contact"
        class="talk-button group mt-9 inline-flex items-center gap-2.5 rounded-xl px-6 py-3.5 text-sm font-medium"
      >
        <span>Let's talk</span>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-4 transition-transform duration-300 group-hover:translate-x-1"
        >
          <path
            fill-rule="evenodd"
            d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
            clip-rule="evenodd"
          />
        </svg>
      </a>

    </div>

  </div>
</section>


<style is:global>

  /* ============================================================= */
  /* BACKGROUND */
  /* ============================================================= */

  .hero-grid {
    background-image:
      linear-gradient(
        rgba(255,255,255,.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,.025) 1px,
        transparent 1px
      );

    background-size: 52px 52px;

    mask-image:
      radial-gradient(
        ellipse 70% 60% at 50% 25%,
        black 0%,
        transparent 75%
      );
  }

  .noise-layer {
    background-image:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.4'/%3E%3C/svg%3E");
  }

  /* ============================================================= */
  /* PREMIUM LIQUID GLASS BACKGROUND */
  /* ============================================================= */

  .liquid-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.25vw, 22px);
    padding: 4vh 7vw;
    opacity: .58;
    transform: translateZ(0);
    filter: saturate(1.08);

    mask-image:
      radial-gradient(
        ellipse 78% 82% at 50% 42%,
        black 35%,
        rgba(0,0,0,.86) 63%,
        transparent 100%
      );

    -webkit-mask-image:
      radial-gradient(
        ellipse 78% 82% at 50% 42%,
        black 35%,
        rgba(0,0,0,.86) 63%,
        transparent 100%
      );
  }

  .liquid-capsule {
    position: relative;
    width: clamp(46px, 7vw, 118px);
    height: 76%;
    flex: 0 1 clamp(46px, 7vw, 118px);
    border-radius: 999px;
    overflow: hidden;
    isolation: isolate;

    background:
      linear-gradient(
        180deg,
        #d8b4fe 0%,
        #a978f5 13%,
        #7049e9 28%,
        #3d36d9 43%,
        #3146e2 54%,
        #5b8eea 68%,
        #8bd8d0 82%,
        #b8edcf 94%,
        #d9f5df 100%
      );

    border: 1px solid rgba(255,255,255,.16);

    box-shadow:
      inset 7px 0 18px rgba(255,255,255,.08),
      inset -9px 0 22px rgba(21,17,74,.16),
      inset 0 1px 0 rgba(255,255,255,.34),
      0 24px 55px rgba(42,29,123,.14),
      0 0 35px rgba(86,73,226,.09);

    opacity: .88;
    transform-origin: center;

    animation:
      capsuleFloat
      13s
      cubic-bezier(.45,.05,.55,.95)
      infinite;
  }

  .liquid-capsule::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;

    background:
      radial-gradient(
        ellipse 70% 23% at 50% 16%,
        rgba(255,255,255,.27),
        transparent 72%
      ),
      radial-gradient(
        ellipse 95% 28% at 50% 77%,
        rgba(184,250,222,.20),
        transparent 72%
      );

    mix-blend-mode: screen;
    opacity: .9;
  }

  .liquid-capsule::after {
    content: "";
    position: absolute;
    top: 2%;
    left: 8%;
    width: 24%;
    height: 94%;
    border-radius: 999px;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.30),
        rgba(255,255,255,.08) 24%,
        rgba(255,255,255,.015) 58%,
        transparent 100%
      );

    filter: blur(5px);
    opacity: .75;
  }

  .capsule-1 {
    height: 92%;
    margin-top: -4%;
    animation-delay: -1s;
  }

  .capsule-2 {
    height: 72%;
    margin-top: 8%;
    animation-delay: -5s;
  }

  .capsule-3 {
    height: 86%;
    margin-top: -1%;
    animation-delay: -9s;
  }

  .capsule-4 {
    height: 64%;
    margin-top: 13%;
    animation-delay: -3s;
  }

  .capsule-5 {
    height: 95%;
    margin-top: -5%;
    animation-delay: -7s;
  }

  .capsule-6 {
    height: 78%;
    margin-top: 6%;
    animation-delay: -11s;
  }

  .capsule-7 {
    height: 89%;
    margin-top: -2%;
    animation-delay: -4s;
  }

  .capsule-8 {
    height: 68%;
    margin-top: 11%;
    animation-delay: -8s;
  }

  .hero-ambient {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(1000px, 92vw);
    height: 680px;
    transform: translate(-50%, -50%);

    background:
      radial-gradient(
        ellipse at 50% 48%,
        rgba(92,72,235,.16) 0%,
        rgba(67,92,230,.10) 28%,
        rgba(92,208,188,.055) 49%,
        transparent 73%
      );

    filter: blur(55px);
    opacity: .9;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(5,6,12,.48) 0%,
        transparent 26%,
        transparent 72%,
        rgba(5,6,12,.48) 100%
      ),
      radial-gradient(
        ellipse 72% 72% at 50% 45%,
        transparent 38%,
        rgba(5,6,12,.32) 100%
      );
  }

  @keyframes capsuleFloat {
    0%, 100% {
      transform:
        translate3d(0, -8px, 0)
        scaleY(.985);
    }

    50% {
      transform:
        translate3d(0, 13px, 0)
        scaleY(1.015);
    }
  }

  /* ============================================================= */
  /* STATUS */
  /* ============================================================= */

  .status-badge {
    border: 1px solid rgba(255,255,255,.08);

    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.055),
        rgba(255,255,255,.018)
      );

    color: rgba(255,255,255,.55);

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.04),
      0 10px 30px rgba(0,0,0,.08);

    backdrop-filter: blur(18px);
  }

  /* ============================================================= */
  /* NAME */
  /* ============================================================= */

  .name-glow {
    color: #86efac;

    text-shadow:
      0 0 8px rgba(74,222,128,.35),
      0 0 22px rgba(74,222,128,.14);

    transition:
      color 300ms ease,
      text-shadow 300ms ease;
  }

  .name-glow:hover {
    color: #bbf7d0;

    text-shadow:
      0 0 10px rgba(74,222,128,.65),
      0 0 28px rgba(74,222,128,.3);
  }

  /* ============================================================= */
  /* HERO TITLE */
  /* ============================================================= */

  .hero-title {
    text-wrap: balance;
  }

  .title-muted {
    color: rgba(255,255,255,.42);

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.58),
        rgba(255,255,255,.24)
      );

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ============================================================= */
  /* SHINY TEXT */
  /* ============================================================= */

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        #7667ff 0%,
        #a99cff 25%,
        #ffffff 50%,
        #6251ff 75%,
        #7667ff 100%
      );

    background-size: 250% 100%;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation:
      shine
      5s
      ease-in-out
      infinite;
  }

  @keyframes shine {
    0%, 100% {
      background-position: 100% 50%;
    }

    50% {
      background-position: 0% 50%;
    }
  }

  /* ============================================================= */
  /* BUTTONS */
  /* ============================================================= */

  .primary-button {
    color: #09090b;

    background:
      linear-gradient(
        135deg,
        #ffffff,
        #e9e9eb
      );

    box-shadow:
      0 10px 30px rgba(0,0,0,.2),
      inset 0 1px 0 rgba(255,255,255,.8);

    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .primary-button:hover {
    transform: translateY(-2px);

    box-shadow:
      0 15px 35px rgba(0,0,0,.25),
      0 0 30px rgba(255,255,255,.08);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    border: 1px solid rgba(255,255,255,.08);
    border-radius: 13px;

    color: rgba(255,255,255,.48);

    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.045),
        rgba(255,255,255,.015)
      );

    backdrop-filter: blur(14px);

    transition:
      color 300ms ease,
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .social-link:hover {
    color: white;

    border-color: rgba(74,222,128,.25);

    background:
      linear-gradient(
        135deg,
        rgba(74,222,128,.08),
        rgba(255,255,255,.025)
      );

    box-shadow:
      0 0 20px rgba(74,222,128,.06);

    transform: translateY(-3px);
  }

  /* ============================================================= */
  /* GLITCH CARD */
  /* ============================================================= */

  .glitch-glow {
    position: absolute;

    width: 270px;
    height: 270px;

    border-radius: 999px;

    background:
      radial-gradient(
        circle,
        rgba(88,58,220,.22),
        rgba(74,222,128,.025) 55%,
        transparent 72%
      );

    filter: blur(45px);

    animation:
      pulseGlow
      6s
      ease-in-out
      infinite;
  }

  .glitch-card {
    border: 1px solid rgba(255,255,255,.1);

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.065),
        rgba(255,255,255,.018)
      );

    box-shadow:
      0 35px 80px rgba(0,0,0,.35),
      inset 0 1px 0 rgba(255,255,255,.06);

    backdrop-filter: blur(20px);

    transition:
      transform 500ms cubic-bezier(.2,.8,.2,1),
      border-color 400ms ease;
  }

  .glitch-card:hover {
    transform:
      translateY(-6px)
      rotate(.35deg);

    border-color: rgba(255,255,255,.16);
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: .65;
      transform: scale(.95);
    }

    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  /* ============================================================= */
  /* SECTION */
  /* ============================================================= */

  .section-line {
    border-top: 1px solid rgba(255,255,255,.055);
    border-bottom: 1px solid rgba(255,255,255,.055);
  }

  .section-block {
    padding-top: 6.5rem;
    padding-bottom: 6.5rem;
  }

  .section-eyebrow {
    font-size: .7rem;
    font-weight: 500;

    text-transform: uppercase;
    letter-spacing: .22em;

    line-height: 1;

    color: rgba(255,255,255,.32);
  }

  .section-title {
    max-width: 650px;

    font-size: 2.25rem;
    font-weight: 600;

    line-height: 1.02;
    letter-spacing: -.045em;

    color: white;
  }

  .section-title span {
    display: block;
    color: rgba(255,255,255,.34);
  }

  .section-description {
    max-width: 550px;

    margin-top: 1.35rem;

    font-size: 1rem;
    line-height: 1.75;

    color: rgba(255,255,255,.4);
  }

  /* ============================================================= */
  /* SKILLS */
  /* ============================================================= */

  .skills-panel {
    position: relative;

    padding: 1.5rem;

    border: 1px solid rgba(255,255,255,.065);
    border-radius: 24px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.012)
      );

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.035),
      0 25px 60px rgba(0,0,0,.12);
  }

  .skill-line {
    display: flex;
    align-items: center;
    gap: .45rem;
  }

  .skill-line span {
    display: block;

    height: 3px;

    border-radius: 999px;

    background: rgba(255,255,255,.1);
  }

  .skill-line span:nth-child(1) {
    width: 42px;
    background: rgba(74,222,128,.5);
  }

  .skill-line span:nth-child(2) {
    width: 18px;
  }

  .skill-line span:nth-child(3) {
    width: 8px;
  }

  /* ============================================================= */
  /* TERMINAL */
  /* ============================================================= */

  .terminal-section {
    position: relative;
  }

  .terminal-inline-code {
    display: inline-flex;
    align-items: center;

    padding: .1rem .4rem;

    border: 1px solid rgba(74,222,128,.12);
    border-radius: 5px;

    background: rgba(74,222,128,.045);

    color: rgba(134,239,172,.8);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: .85em;
  }

  .terminal-wrapper {
    position: relative;
  }

  .terminal-glow {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 70%;
    height: 70%;

    transform: translate(-50%, -50%);

    border-radius: 999px;

    background:
      radial-gradient(
        ellipse,
        rgba(74,222,128,.075),
        rgba(68,80,220,.035) 45%,
        transparent 72%
      );

    filter: blur(70px);

    pointer-events: none;
  }

  .portfolio-terminal {
    position: relative;
    z-index: 1;

    overflow: hidden;

    width: 100%;

    min-height: 470px;

    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px;

    background:
      linear-gradient(
        145deg,
        rgba(15,17,25,.97),
        rgba(7,9,14,.98)
      );

    box-shadow:
      0 35px 90px rgba(0,0,0,.32),
      inset 0 1px 0 rgba(255,255,255,.045),
      0 0 0 1px rgba(74,222,128,.018);

    backdrop-filter: blur(25px);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      "Liberation Mono",
      monospace;

    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .portfolio-terminal:focus-within {
    border-color: rgba(74,222,128,.17);

    box-shadow:
      0 35px 90px rgba(0,0,0,.32),
      inset 0 1px 0 rgba(255,255,255,.045),
      0 0 45px rgba(74,222,128,.035);
  }

  .terminal-header {
    position: relative;

    display: flex;
    align-items: center;

    height: 52px;

    padding: 0 18px;

    border-bottom: 1px solid rgba(255,255,255,.055);

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.012)
      );
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 7px;

    width: 100px;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;

    border-radius: 999px;

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.18);
  }

  .terminal-red {
    background: rgba(248,113,113,.75);
  }

  .terminal-yellow {
    background: rgba(250,204,21,.75);
  }

  .terminal-green {
    background: rgba(74,222,128,.75);
  }

  .terminal-title {
    position: absolute;

    left: 50%;

    transform: translateX(-50%);

    white-space: nowrap;

    font-size: 10px;

    letter-spacing: .04em;

    color: rgba(255,255,255,.25);
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 7px;

    margin-left: auto;

    font-size: 9px;

    text-transform: uppercase;
    letter-spacing: .14em;

    color: rgba(255,255,255,.22);
  }

  .terminal-status span {
    width: 5px;
    height: 5px;

    border-radius: 999px;

    background: #86efac;

    box-shadow:
      0 0 8px rgba(74,222,128,.8);
  }

  .terminal-output {
    height: 360px;

    overflow-y: auto;

    padding: 25px 26px 10px;

    scrollbar-width: thin;
    scrollbar-color:
      rgba(255,255,255,.12)
      transparent;
  }

  .terminal-output::-webkit-scrollbar {
    width: 5px;
  }

  .terminal-output::-webkit-scrollbar-track {
    background: transparent;
  }

  .terminal-output::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(255,255,255,.12);
  }

  .terminal-line {
    min-height: 20px;

    font-size: 12px;
    line-height: 1.7;

    color: rgba(255,255,255,.7);
  }

  .terminal-muted {
    color: rgba(255,255,255,.25);
  }

  .terminal-output-text {
    color: rgba(255,255,255,.48);
  }

  .terminal-spacer {
    height: 12px;
  }

  .terminal-prompt {
    color: #86efac;
  }

  .terminal-symbol {
    color: rgba(255,255,255,.35);
  }

  .terminal-path {
    color: #93c5fd;
  }

  .terminal-command {
    margin-left: 8px;

    color: rgba(255,255,255,.82);
  }

  .terminal-command-list {
    display: grid;

    gap: 4px;

    margin-top: 7px;
    margin-bottom: 5px;

    padding-left: 18px;

    border-left: 1px solid rgba(74,222,128,.13);
  }

  .terminal-command-list div {
    display: flex;
    align-items: baseline;
    gap: 10px;

    min-height: 21px;

    font-size: 11px;
  }

  .terminal-command-list span {
    min-width: 75px;

    color: #86efac;

    cursor: pointer;

    transition:
      color 200ms ease,
      text-shadow 200ms ease;
  }

  .terminal-command-list span:hover {
    color: #bbf7d0;

    text-shadow:
      0 0 10px rgba(74,222,128,.35);
  }

  .terminal-command-list small {
    color: rgba(255,255,255,.25);

    font-size: 10px;
  }

  .terminal-input-row {
    display: flex;
    align-items: center;

    min-height: 58px;

    padding: 0 26px;

    border-top: 1px solid rgba(255,255,255,.05);

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.012),
        rgba(255,255,255,.025)
      );
  }

  .terminal-input {
    min-width: 0;
    flex: 1;

    margin-left: 8px;

    border: 0;
    outline: 0;

    background: transparent;

    color: rgba(255,255,255,.86);

    font-family: inherit;
    font-size: 12px;

    caret-color: #86efac;
  }

  .terminal-input::placeholder {
    color: rgba(255,255,255,.16);
  }

  .terminal-cursor {
    width: 7px;
    height: 15px;

    margin-left: 3px;

    background: #86efac;

    opacity: .8;

    animation:
      terminalCursor
      1s
      steps(1)
      infinite;
  }

  @keyframes terminalCursor {
    0%, 45% {
      opacity: .8;
    }

    46%, 100% {
      opacity: 0;
    }
  }

  .terminal-footer {
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 18px;

    padding: 11px 16px;

    border-top: 1px solid rgba(255,255,255,.04);

    color: rgba(255,255,255,.18);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 9px;

    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .terminal-footer kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 18px;

    margin-right: 3px;

    padding: 2px 4px;

    border: 1px solid rgba(255,255,255,.08);
    border-radius: 4px;

    background: rgba(255,255,255,.025);

    color: rgba(255,255,255,.32);

    font-family: inherit;
    font-size: 8px;
  }

  /* ============================================================= */
  /* NOTE CARDS */
  /* ============================================================= */

  .note-card {
    position: relative;

    display: flex;

    min-height: 230px;

    flex-direction: column;
    justify-content: space-between;

    overflow: hidden;

    padding: 24px;

    border: 1px solid rgba(255,255,255,.07);
    border-radius: 20px;

    color: white;

    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(74,222,128,.055),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        rgba(255,255,255,.045),
        rgba(255,255,255,.012)
      );

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.035);

    transition:
      transform 400ms cubic-bezier(.2,.8,.2,1),
      border-color 300ms ease,
      box-shadow 400ms ease,
      background 400ms ease;
  }

  .note-card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(74,222,128,.35),
        transparent
      );

    opacity: 0;

    transition: opacity 300ms ease;
  }

  .note-card:hover {
    transform: translateY(-6px);

    border-color: rgba(74,222,128,.2);

    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(74,222,128,.1),
        transparent 40%
      ),
      linear-gradient(
        145deg,
        rgba(255,255,255,.055),
        rgba(255,255,255,.018)
      );

    box-shadow:
      0 25px 60px rgba(0,0,0,.22),
      0 0 35px rgba(74,222,128,.035);
  }

  .note-card:hover::before {
    opacity: 1;
  }

  .note-number {
    margin-bottom: 2.5rem;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: .65rem;

    letter-spacing: .16em;

    color: rgba(255,255,255,.2);
  }

  .note-label {
    display: block;

    font-size: .65rem;
    font-weight: 500;

    text-transform: uppercase;
    letter-spacing: .16em;

    color: rgba(74,222,128,.7);
  }

  .note-card h3 {
    max-width: 90%;

    margin-top: .75rem;

    font-size: 1.05rem;
    font-weight: 500;

    line-height: 1.35;
    letter-spacing: -.015em;

    color: rgba(255,255,255,.84);
  }

  .note-footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-top: 2rem;

    font-size: .68rem;

    text-transform: uppercase;
    letter-spacing: .12em;

    color: rgba(255,255,255,.25);
  }

  .note-arrow {
    font-size: 1.1rem;

    color: rgba(255,255,255,.3);

    transition:
      color 300ms ease,
      transform 300ms ease;
  }

  .note-card:hover .note-arrow {
    color: #86efac;

    transform:
      translate(3px,-3px);
  }

  /* ============================================================= */
  /* TALK BUTTON */
  /* ============================================================= */

  .talk-button {
    color: #bbf7d0;

    border: 1px solid rgba(74,222,128,.25);

    background:
      linear-gradient(
        135deg,
        rgba(74,222,128,.13),
        rgba(74,222,128,.035)
      );

    box-shadow:
      0 0 25px rgba(74,222,128,.07),
      inset 0 1px 0 rgba(255,255,255,.04);

    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background 300ms ease,
      box-shadow 300ms ease;
  }

  .talk-button:hover {
    transform: translateY(-3px);

    border-color: rgba(74,222,128,.55);

    background:
      linear-gradient(
        135deg,
        rgba(74,222,128,.2),
        rgba(74,222,128,.06)
      );

    box-shadow:
      0 0 15px rgba(74,222,128,.16),
      0 0 45px rgba(74,222,128,.08);
  }

