     NOTES
     ============================================================ */

  .note-card {
    position:
      relative;

    display:
      flex;

    min-height:
      250px;

    flex-direction:
      column;

    justify-content:
      space-between;

    overflow:
      hidden;

    border:
      1px solid
      rgba(255,255,255,.07);

    border-radius:
      20px;

    padding:
      24px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.055),
