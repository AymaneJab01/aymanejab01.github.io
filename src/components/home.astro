  .terminal-body::before {
    content:
      "";

    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;

    background:
      linear-gradient(
        transparent 50%,
        rgba(255,255,255,.008) 50%
      );

    background-size:
      100% 4px;

    opacity:
      .4;
