&#x20;       rgba(255, 255, 255, 0.018)
&#x20;     );

&#x20;   box-shadow:
&#x20;     0 35px 80px rgba(0, 0, 0, 0.35),
&#x20;     inset 0 1px 0 rgba(255, 255, 255, 0.06);

&#x20;   backdrop-filter: blur(20px);

