<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --container: #151515;
  }

  html {
    background: var(--background);
    color: var(--white);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    padding: 0 36px;
    background: var(--background);
    color: var(--white);
    overflow-x: hidden;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    font-family:
      "Montserrat Variable",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      system-ui,
      sans-serif;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 15px;
    height: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border: 3px solid var(--container);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--sec) var(--background);
  }

  :focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    body {
      padding-left: 112px;
      padding-right: 112px;
    }
  }

  @media (min-width: 1024px) {
    body {
      padding-left: 80px;
      padding-right: 80px;
    }
  }

  @media (max-width: 639px) {
    body {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
