```astro
---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{title} | Software Developer</title>

    <meta
      name="description"
      content="Aymane Jabrane - Software Developer building interactive and seamless digital experiences."
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="icon" type="image/png" href="/icon.png" />

    <link
      rel="canonical"
      href="https://aymanejab01.github.io/"
    />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Aymane Jabrane | Software Developer"
    />

    <meta
      property="og:description"
      content="Portfolio of Aymane Jabrane, Software Developer interested in frontend development, machine learning, hardware, software, and computer architecture."
    />

    <meta
      property="og:image"
      content="https://aymanejab01.github.io/aj2.png"
    />

    <meta
      property="og:url"
      content="https://aymanejab01.github.io"
    />

    <meta property="og:type" content="website" />

    <meta
      property="og:site_name"
      content="Aymane Jabrane Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Aymane Jabrane",
        "url": "https://aymanejab01.github.io",
        "image": "https://aymanejab01.github.io/og.image.png",
        "sameAs": [
          "https://github.com/AymaneJab01",
          "https://www.linkedin.com/in/aymane-jabrane-73025726a/"
        ],
        "jobTitle": "Software Developer",
        "description": "Software Developer interested in frontend development, machine learning, hardware, software, and computer architecture."
      }
    </script>
  </head>

  <body class="bg-[var(--background)] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  /* ========================================================= */
  /* FONT */
  /* ========================================================= */

  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }


  /* ========================================================= */
  /* GLOBAL VARIABLES */
  /* ========================================================= */

  :root {
    --background: #101010;

    /* Main portfolio accent */
    --sec: #a476ff;

    --white: #dfdfdf;

    --white-icon: #f3f3f398;

    --white-icon-tr: #f3f3f310;

    /* Used by scrollbar and other UI elements */
    --container: #151515;
  }


  /* ========================================================= */
  /* GLOBAL RESET */
  /* ========================================================= */

  * {
    box-sizing: border-box;

    padding: 0;

    margin: 0;

    font-family:
      "Montserrat Variable",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      system-ui,
      sans-serif;
  }


  html {
    background:
      var(--background);

    color:
      var(--white);

    scroll-behavior:
      smooth;
  }


  body {
    min-height:
      100vh;

    background:
      var(--background);

    color:
      var(--white);

    overflow-x:
      hidden;
  }


  /* ========================================================= */
  /* TEXT SELECTION */
  /* ========================================================= */

  *::selection {
    background-color:
      var(--sec);

    color:
      var(--background);
  }


  /* ========================================================= */
  /* SCROLLBAR - CHROMIUM / WEBKIT */
  /* ========================================================= */

  ::-webkit-scrollbar {
    width:
      15px;

    height:
      15px;
  }


  ::-webkit-scrollbar-track {
    background:
      var(--container);

    border-radius:
      30px;
  }


  ::-webkit-scrollbar-thumb {
    background:
      var(--background);

    border:
      3px solid
      var(--container);

    border-radius:
      10px;
  }


  ::-webkit-scrollbar-thumb:hover {
    background:
      var(--sec);
  }


  /* ========================================================= */
  /* FIREFOX SCROLLBAR */
  /* ========================================================= */

  * {
    scrollbar-width:
      thin;

    scrollbar-color:
      var(--sec)
      var(--background);
  }


  /* ========================================================= */
  /* ACCESSIBILITY */
  /* ========================================================= */

  :focus-visible {
    outline:
      2px solid
      var(--sec);

    outline-offset:
      4px;
  }


  /* ========================================================= */
  /* REDUCED MOTION */
  /* ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior:
        auto;
    }
  }
</style>
```
