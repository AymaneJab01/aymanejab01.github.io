{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "astro/client",
      "node"
    ],
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.ts"
  ],
  "exclude": [
    "dist"
  ]
}